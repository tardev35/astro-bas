---
const {
  message = "TUNJAI123 เว็บตรงอันดับ 1 ลิขสิทธิ์แท้ 100% • ศูนย์รวมทุกค่ายในเว็ปเดียว PG Soft Pragmatic Play JILI ครบจบในบัญชีเดียว • ระบบออโต้ AI ปรับยอดเครดิตเองในไม่กี่วินาที รวดเร็วดั่งใจนึก โอนไว • การันตี จ่ายจริงทุกบิล ไม่หักค่าธรรมเนียมแอบแฝง • เข้าสู่ระบบผ่าน Secure Transition Popup ปลอดภัยขั้นสุด • อ่านเงื่อนไขทุกครั้งก่อนกดรับสิทธิ์",
} = Astro.props;
---

<div class="mx-auto w-full max-w-7xl px-4 py-4 font-sans">
  <div
    class="relative flex overflow-hidden rounded-full border border-[#dab563]/35 bg-[#100d08]/92 shadow-[0_8px_20px_rgba(218,181,99,0.18)] backdrop-blur-lg transition-shadow duration-300 hover:shadow-[0_8px_25px_rgba(218,181,99,0.30)]">
    <div
      class="relative z-10 flex shrink-0 items-center justify-center rounded-full bg-gradient-to-r from-[#f5eb8b] via-[#dab563] to-[#a97f28] px-8 py-2.5 font-black text-[#120c04] shadow-[4px_0_15px_rgba(218,181,99,0.25)]">
      <span aria-hidden="true" class="mr-2 text-lg">👑</span> ประกาศ
    </div>

    <div class="marquee-container relative flex-1 overflow-hidden py-2.5 pr-6">
      <div class="pointer-events-none absolute top-0 left-0 z-10 h-full w-12 bg-gradient-to-r from-[#100d08] to-transparent"></div>

      <div class="marquee-content inline-block pl-4 text-sm font-medium tracking-wide whitespace-nowrap text-[#ece3cf]">
        <span class="mr-10 inline-flex items-center gap-3"><span class="h-2 w-2 rounded-full bg-[#dab563] shadow-[0_0_8px_rgba(218,181,99,0.6)]"></span>{message}</span>
        <span class="mr-10 inline-flex items-center gap-3"><span class="h-2 w-2 rounded-full bg-[#dfe4e7] shadow-[0_0_8px_rgba(223,228,231,0.6)]"></span>{message}</span>
      </div>
    </div>
  </div>
</div>

<style>
  .marquee-content {
    animation: marquee 25s linear infinite;
  }
  .marquee-container:hover .marquee-content {
    animation-play-state: paused;
  }
  @media (prefers-reduced-motion: reduce) {
    .marquee-content {
      animation: none;
    }
  }
  @keyframes marquee {
    0% {
      transform: translateX(0);
    }
    100% {
      transform: translateX(-50%);
    }
  }
</style>
