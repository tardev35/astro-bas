---
// Every page except index calls this bare, so the default IS this brand's copy —
// a variant's default message is the single most reliable way an old brand's
// slogan survives a rebrand. No leading emoji: the marquee renders `message`
// twice, an emoji inside a text prop cannot be marked aria-hidden, and a screen
// reader would announce it on every repeat.
const {
  message = "TT1BET คาสิโนออนไลน์ครบวงจร ลิขสิทธิ์แท้ 100% • รวมเกมแตกง่าย จากค่ายระดับโลก Thunderkick Playtech Habanero ครบจบในบัญชีเดียว • การันตี จ่ายจริง ครบทุกยอดบิล โอนไว ไม่หักค่าธรรมเนียม • สมัครง่าย ผ่านระบบ AI อัตโนมัติ ใช้เวลาไม่ถึงนาที • เข้าสู่ระบบผ่าน Secure Popup Loader ปลอดภัยขั้นสุด • อ่านเงื่อนไขทุกครั้งก่อนกดรับสิทธิ์",
} = Astro.props;
---

<div class="mx-auto w-full max-w-7xl px-4 py-4 font-sans">
  <div
    class="relative flex overflow-hidden rounded-full border border-[#f3c43c]/40 bg-[#0a0704]/92 shadow-[0_8px_20px_rgba(243,196,60,0.18)] backdrop-blur-lg transition-shadow duration-300 hover:shadow-[0_8px_25px_rgba(243,196,60,0.32)]">
    <div
      class="relative z-10 flex shrink-0 items-center justify-center rounded-full bg-gradient-to-r from-[#fcf6ab] via-[#f3c43c] to-[#a8790f] px-8 py-2.5 font-black text-[#1a1204] shadow-[4px_0_15px_rgba(243,196,60,0.3)]">
      <span aria-hidden="true" class="mr-2 text-lg">👑</span> ประกาศ
    </div>

    <div class="marquee-container relative flex-1 overflow-hidden py-2.5 pr-6">
      <div aria-hidden="true" class="pointer-events-none absolute top-0 left-0 z-10 h-full w-12 bg-gradient-to-r from-[#0a0704] to-transparent"></div>

      <div class="marquee-content inline-block pl-4 text-sm font-medium tracking-wide whitespace-nowrap text-[#f0e6cc]">
        <span class="mr-10 inline-flex items-center gap-3"
          ><span aria-hidden="true" class="h-2 w-2 rounded-full bg-[#f3c43c] shadow-[0_0_8px_rgba(243,196,60,0.7)]"></span>{message}</span
        >
        <span class="mr-10 inline-flex items-center gap-3"
          ><span aria-hidden="true" class="h-2 w-2 rounded-full bg-[#dfe4e7] shadow-[0_0_8px_rgba(223,228,231,0.7)]"></span>{message}</span
        >
      </div>
    </div>
  </div>
</div>

<style>
  .marquee-content {
    animation: marquee 25s linear infinite;
  }
  .marquee-container:hover .marquee-content {
    animation-play-state: paused;
  }
  @media (prefers-reduced-motion: reduce) {
    .marquee-content {
      animation: none;
    }
  }
  @keyframes marquee {
    0% {
      transform: translateX(0);
    }
    100% {
      transform: translateX(-50%);
    }
  }
</style>
