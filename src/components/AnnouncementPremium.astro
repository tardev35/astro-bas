---
// Every page except index calls this bare, so the default IS this brand's copy —
// a variant's default message is the single most reliable way an old brand's
// slogan survives a rebrand. No leading emoji: the marquee renders `message`
// twice, an emoji inside a text prop cannot be marked aria-hidden, and a screen
// reader would announce it on every repeat.
const {
  message = "LUCKYGAME689 เว็บสล็อตเจ้าใหญ่ ลิขสิทธิ์แท้ 100% • รวมค่ายเกมระดับโลก Hacksaw Gaming Nolimit City Relax Gaming ครบจบในบัญชีเดียว • คัดสรร โปรโมชั่นเด็ด สุดคุ้มค่า กดรับสิทธิ์เองได้ผ่านระบบออโต้ • ดูแลทุกการใช้งานด้วย บริการระดับ VVIP แท้ 100% ตลอด 24 ชั่วโมง • เข้าสู่ระบบผ่าน Secure Transition Popup ปลอดภัยขั้นสุด • อ่านเงื่อนไขทุกครั้งก่อนกดรับสิทธิ์",
} = Astro.props;
---

<div class="mx-auto w-full max-w-7xl px-4 py-4 font-sans">
  <div
    class="relative flex overflow-hidden rounded-full border border-[#faad23]/40 bg-[#2b0204]/92 shadow-[0_8px_20px_rgba(250,173,35,0.18)] backdrop-blur-lg transition-shadow duration-300 hover:shadow-[0_8px_25px_rgba(250,173,35,0.32)]">
    <div
      class="relative z-10 flex shrink-0 items-center justify-center rounded-full bg-gradient-to-r from-[#ffd84d] via-[#faad23] to-[#b8760f] px-8 py-2.5 font-black text-[#2b0204] shadow-[4px_0_15px_rgba(250,173,35,0.3)]">
      <span aria-hidden="true" class="mr-2 text-lg">👑</span> ประกาศ
    </div>

    <div class="marquee-container relative flex-1 overflow-hidden py-2.5 pr-6">
      <div aria-hidden="true" class="pointer-events-none absolute top-0 left-0 z-10 h-full w-12 bg-gradient-to-r from-[#2b0204] to-transparent"></div>

      <div class="marquee-content inline-block pl-4 text-sm font-medium tracking-wide whitespace-nowrap text-[#ffe9c4]">
        <span class="mr-10 inline-flex items-center gap-3"
          ><span aria-hidden="true" class="h-2 w-2 rounded-full bg-[#faad23] shadow-[0_0_8px_rgba(250,173,35,0.7)]"></span>{message}</span
        >
        <span class="mr-10 inline-flex items-center gap-3"
          ><span aria-hidden="true" class="h-2 w-2 rounded-full bg-[#ff3d8a] shadow-[0_0_8px_rgba(224,27,93,0.7)]"></span>{message}</span
        >
      </div>
    </div>
  </div>
</div>

<style>
  .marquee-content {
    animation: marquee 25s linear infinite;
  }
  .marquee-container:hover .marquee-content {
    animation-play-state: paused;
  }
  @media (prefers-reduced-motion: reduce) {
    .marquee-content {
      animation: none;
    }
  }
  @keyframes marquee {
    0% {
      transform: translateX(0);
    }
    100% {
      transform: translateX(-50%);
    }
  }
</style>
