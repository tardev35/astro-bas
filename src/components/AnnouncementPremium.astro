---
const {
  message = "💎 WINUP888 คาสิโนบนมือถือระบบ HTML5 รวมสล็อต PG Soft • Pragmatic Play • NetEnt • Betsoft พร้อมบาคาร่า รูเล็ต แบล็คแจ็ค และเกม Live สดจาก Evolution • SA Gaming เปิดให้เข้าเล่นตลอด 24 ชม.",
} = Astro.props;
---

<div class="mx-auto w-full max-w-7xl px-4 py-4 font-sans">
  <div
    class="relative flex overflow-hidden rounded-full border border-amber-600/25 bg-[#fffdf7]/92 shadow-[0_8px_20px_rgba(168,132,44,0.18)] backdrop-blur-lg transition-shadow duration-300 hover:shadow-[0_8px_25px_rgba(168,132,44,0.30)]">
    <div
      class="relative z-10 flex shrink-0 items-center justify-center rounded-full bg-gradient-to-r from-[#f4dfa3] via-[#d9b45c] to-[#a97f2a] px-8 py-2.5 font-black text-[#231a06] shadow-[4px_0_15px_rgba(168,132,44,0.25)]">
      <span class="mr-2 text-lg">💎</span> ประกาศ
    </div>

    <div class="marquee-container relative flex-1 overflow-hidden py-2.5 pr-6">
      <div class="pointer-events-none absolute top-0 left-0 z-10 h-full w-12 bg-gradient-to-r from-[#fffdf7] to-transparent"></div>

      <div class="marquee-content inline-block pl-4 text-sm font-medium tracking-wide whitespace-nowrap text-[#3a2e18]">
        <span class="mr-10 inline-flex items-center gap-3"><span class="h-2 w-2 rounded-full bg-[#c9a227] shadow-[0_0_8px_rgba(201,162,39,0.6)]"></span>{message}</span>
        <span class="mr-10 inline-flex items-center gap-3"><span class="h-2 w-2 rounded-full bg-[#c9a227] shadow-[0_0_8px_rgba(201,162,39,0.6)]"></span>{message}</span>
      </div>
    </div>
  </div>
</div>

<style>
  .font-sans {
    font-family: var(--font-sans);
  }
  .marquee-content {
    animation: marquee 25s linear infinite;
  }
  .marquee-container:hover .marquee-content {
    animation-play-state: paused;
  }
  @keyframes marquee {
    0% {
      transform: translateX(0);
    }
    100% {
      transform: translateX(-50%);
    }
  }
</style>
