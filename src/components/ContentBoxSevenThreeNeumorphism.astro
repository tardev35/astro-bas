---
export interface Props {
  title?: string;
  titleleft?: string;
  titleright?: string;
}
const { title, titleleft, titleright } = Astro.props;
const rightHeading = titleright ?? title;
---

<section class="relative z-10 mx-auto mb-8 w-full max-w-[1400px] px-4 font-sans">
  <div
    class="w-full rounded-[25px] border border-[#4a412e]/70 bg-[#191712] p-8 shadow-[10px_10px_20px_#050403,-10px_-10px_20px_#262218] transition-all duration-300 hover:shadow-[15px_15px_30px_#030302,-15px_-15px_30px_#2e2920]">
    <div class="grid grid-cols-1 gap-8 md:grid-cols-[3fr_7fr] md:items-center">
      <article class="flex flex-col gap-4 text-left text-base leading-relaxed text-[#efeade]">
        {titleleft && <h2 class="text-2xl leading-normal font-black text-[#e5c375]">{titleleft}</h2>}
        <slot name="left" />
      </article>

      <article class="flex flex-col gap-4 text-left text-base leading-relaxed text-[#efeade] md:border-l md:border-[#4a412e] md:pl-8">
        {rightHeading && <h2 class="text-2xl leading-normal font-black text-[#e5c375]">{rightHeading}</h2>}
        <slot name="right" />
      </article>
    </div>
  </div>
</section>

<style>
  .font-sans {
    font-family: var(--font-sans);
  }
</style>
