---
export interface Props {
  title?: string;
  titleleft?: string;
  titleright?: string;
}
const { title, titleleft, titleright } = Astro.props;
const rightHeading = titleright ?? title;

// BOTH `titleleft` and the resolved right heading render as <h2>. Pass exactly
// ONE of them per block, or a single docx heading becomes two page headings.
// `title` is an alias for `titleright`, not a third slot.
//
// The neumorphic pair is derived from this brand's card surface (#160a2b): the
// dark side is a shade below it and the light side is the raised panel colour,
// so the extrusion reads on PHANTOM569's near-black violet background instead
// of the previous brand's forest-green one.
---

<section class="relative z-10 mx-auto mb-8 w-full max-w-[1400px] px-4 font-sans">
  <div
    class="w-full rounded-[25px] border border-[#4c1d95]/50 bg-[#160a2b] p-8 shadow-[10px_10px_20px_#0b0518,-10px_-10px_20px_#22103f] transition-all duration-300 hover:shadow-[15px_15px_30px_#060310,-15px_-15px_30px_#2e1554]">
    <div class="grid grid-cols-1 gap-8 md:grid-cols-[3fr_7fr] md:items-center">
      <article class="flex flex-col gap-4 text-left text-base leading-relaxed text-[#e4dcf7]">
        {titleleft && <h2 class="text-2xl leading-normal font-black text-[#b662ff]">{titleleft}</h2>}
        <slot name="left" />
      </article>

      <article class="flex flex-col gap-4 text-left text-base leading-relaxed text-[#e4dcf7] md:border-l md:border-[#4c1d95]/60 md:pl-8">
        {rightHeading && <h2 class="text-2xl leading-normal font-black text-[#b662ff]">{rightHeading}</h2>}
        <slot name="right" />
      </article>
    </div>
  </div>
</section>
