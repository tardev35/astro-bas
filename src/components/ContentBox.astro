---
export interface Props {
  title?: string;
  as?: "h1" | "h2" | "h3" | "h4" | "h5" | "h6";
}
const { title, as: HeadingTag = "h1" } = Astro.props;
---

<section class="relative z-10 my-8 flex w-full justify-center px-4 font-sans">
  <div
    class="group relative isolate w-full max-w-[1400px] overflow-hidden rounded-3xl border border-[#faad23]/25 bg-[#2b0204]/92 p-8 text-left text-base leading-relaxed text-[#ffe9c4] shadow-[0_10px_30px_rgba(250,173,35,0.14)] backdrop-blur-xl transition-all duration-500 hover:border-[#faad23]/50 hover:shadow-[0_15px_40px_rgba(250,173,35,0.24)] md:p-10">
    <div class="pointer-events-none absolute -top-20 -left-20 -z-10 h-40 w-40 rounded-full bg-[#faad23]/22 blur-[60px] transition-all duration-500 group-hover:bg-[#ffd84d]/30"></div>
    <div class="pointer-events-none absolute -right-20 -bottom-20 -z-10 h-40 w-40 rounded-full bg-[#e01b5d]/28 blur-[60px] transition-all duration-500 group-hover:bg-[#ff3d8a]/32"></div>

    {
      title && (
        <header class="mb-6 flex items-center gap-4 border-b border-[#faad23]/25 pb-4">
          <div class="h-8 w-1.5 shrink-0 rounded-full bg-gradient-to-b from-[#ffd84d] to-[#b8760f] shadow-[0_0_10px_rgba(250,173,35,0.5)]" />
          <HeadingTag class="bg-gradient-to-r from-[#ffd84d] via-[#faad23] to-[#ff3d8a] bg-clip-text text-2xl leading-normal font-black tracking-widest text-transparent uppercase">{title}</HeadingTag>
        </header>
      )
    }
    <slot />
  </div>
</section>
