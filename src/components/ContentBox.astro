---
export interface Props {
  title?: string;
  as?: "h1" | "h2" | "h3" | "h4" | "h5" | "h6";
}
const { title, as: HeadingTag = "h1" } = Astro.props;
---

<section class="relative z-10 my-8 flex w-full justify-center px-4 font-sans">
  <div
    class="group relative isolate w-full max-w-[1400px] overflow-hidden rounded-3xl border border-[#dcb96b]/25 bg-[#100f0c]/92 p-8 text-left text-base leading-relaxed text-[#efeade] shadow-[0_10px_30px_rgba(220,185,107,0.14)] backdrop-blur-xl transition-all duration-500 hover:border-[#dcb96b]/50 hover:shadow-[0_15px_40px_rgba(220,185,107,0.24)] md:p-10">
    <div class="pointer-events-none absolute -top-20 -left-20 -z-10 h-40 w-40 rounded-full bg-[#dcb96b]/20 blur-[60px] transition-all duration-500 group-hover:bg-[#dcb96b]/30"></div>
    <div class="pointer-events-none absolute -right-20 -bottom-20 -z-10 h-40 w-40 rounded-full bg-[#b9bcc4]/25 blur-[60px] transition-all duration-500 group-hover:bg-[#d7dae1]/35"></div>

    {
      title && (
        <header class="mb-6 flex items-center gap-4 border-b border-[#dcb96b]/25 pb-4">
          <div class="h-8 w-1.5 shrink-0 rounded-full bg-gradient-to-b from-[#f2dca4] to-[#ac893a] shadow-[0_0_10px_rgba(220,185,107,0.45)]" />
          <HeadingTag class="bg-gradient-to-r from-[#f2dca4] via-[#dcb96b] to-[#ac893a] bg-clip-text text-2xl leading-normal font-black tracking-widest text-transparent uppercase">{title}</HeadingTag>
        </header>
      )
    }
    <slot />
  </div>
</section>
