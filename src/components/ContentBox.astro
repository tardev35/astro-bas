---
export interface Props {
  title?: string;
  as?: "h1" | "h2" | "h3" | "h4" | "h5" | "h6";
}
const { title, as: HeadingTag = "h1" } = Astro.props;
---

<section class="relative z-10 my-8 flex w-full justify-center px-4 font-sans">
  <div
    class="group relative isolate w-full max-w-[1400px] overflow-hidden rounded-3xl border border-[#f5c53d]/25 bg-[#140d06]/92 p-8 text-left text-base leading-relaxed text-[#ece2cc] shadow-[0_10px_30px_rgba(245,197,61,0.14)] backdrop-blur-xl transition-all duration-500 hover:border-[#f5c53d]/50 hover:shadow-[0_15px_40px_rgba(245,197,61,0.24)] md:p-10">
    <div class="pointer-events-none absolute -top-20 -left-20 -z-10 h-40 w-40 rounded-full bg-[#f5c53d]/20 blur-[60px] transition-all duration-500 group-hover:bg-[#f5c53d]/30"></div>
    <div class="pointer-events-none absolute -right-20 -bottom-20 -z-10 h-40 w-40 rounded-full bg-[#c8121f]/45 blur-[60px] transition-all duration-500 group-hover:bg-[#e4222a]/60"></div>

    {
      title && (
        <header class="mb-6 flex items-center gap-4 border-b border-[#f5c53d]/25 pb-4">
          <div class="h-8 w-1.5 shrink-0 rounded-full bg-gradient-to-b from-[#ffe9a8] to-[#c8921e] shadow-[0_0_10px_rgba(245,197,61,0.45)]" />
          <HeadingTag class="bg-gradient-to-r from-[#ffe9a8] via-[#f5c53d] to-[#c8921e] bg-clip-text text-2xl leading-normal font-black tracking-widest text-transparent uppercase">{title}</HeadingTag>
        </header>
      )
    }
    <slot />
  </div>
</section>
<style>
  .font-sans {
    font-family: var(--font-sans);
  }
</style>
