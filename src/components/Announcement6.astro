---
const { message = "🎰 GSYBET รีวิวเว็บเกมคาสิโน แตกง่าย ทดลองใช้งานจริง 72 ชั่วโมง ระบบฝากถอนอัตโนมัติ ทางเข้าเว็บตรงครบวงจร gsybet-guideline.com" } = Astro.props;
---

<div class="mx-auto max-w-[900px] p-2">
  <div
    class="group relative flex h-[50px] items-center overflow-hidden rounded-full border border-amber-400/40 bg-gradient-to-b from-[#1a1204] via-[#080602] to-[#1a1204] p-1 shadow-[0_5px_20px_rgba(234,179,8,0.18),inset_0_1px_1px_rgba(255,255,255,0.08)]">
    <div class="pointer-events-none absolute -top-6 left-10 h-16 w-16 rounded-full bg-amber-400/20 blur-[30px]"></div>
    <div class="pointer-events-none absolute right-16 -bottom-6 h-16 w-16 rounded-full bg-orange-400/15 blur-[30px]"></div>

    <div
      class="relative z-10 flex h-full shrink-0 items-center gap-1.5 rounded-full border border-amber-300/40 bg-gradient-to-b from-yellow-300 via-amber-400 to-amber-600 px-3.5 shadow-[inset_0_1px_1px_rgba(255,255,255,0.6)] md:px-4">
      <span class="h-1.5 w-1.5 animate-pulse rounded-full bg-[#1a1204] shadow-[0_0_6px_rgba(26,18,4,0.8)]"></span>
      <span class="text-xs font-black tracking-wider text-[#1a1204] uppercase md:text-sm">🎰 GSYBET</span>
    </div>

    <div class="relative z-10 flex-1 overflow-hidden px-4">
      <div class="flex w-max animate-[scroll_18s_linear_infinite] gap-10 text-sm font-bold whitespace-nowrap text-amber-200/90">
        <span>{message}</span>
        <span class="text-orange-400/80">✨</span>
        <span>{message}</span>
        <span class="text-orange-400/80">✨</span>
        <span>{message}</span>
      </div>
    </div>

    <div class="pointer-events-none absolute inset-x-0 bottom-0 h-[2px] bg-gradient-to-r from-transparent via-amber-400/70 to-transparent opacity-70"></div>
  </div>
</div>

<style>
  @keyframes scroll {
    from {
      transform: translateX(0);
    }
    to {
      transform: translateX(calc(-33.33% - 13.33px));
    }
  }
</style>
