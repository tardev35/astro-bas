---
export interface Props {
  title?: string;
  as?: "h1" | "h2" | "h3" | "h4" | "h5" | "h6";
}
const { title, as: HeadingTag = "h2" } = Astro.props;
---

<section class="relative z-10 mx-auto mb-10 w-full max-w-[1400px] px-4 font-sans">
  <div
    class="group relative isolate w-full overflow-hidden rounded-3xl border border-amber-400/30 bg-[#0a0714]/85 p-6 text-white/90 shadow-[0_10px_30px_rgba(0,0,0,0.8)] backdrop-blur-xl transition-all duration-500 hover:border-amber-300/50 md:p-10">
    <div
      class="pointer-events-none absolute top-0 left-1/2 -z-10 h-[2px] w-1/2 -translate-x-1/2 bg-gradient-to-r from-transparent via-amber-300 to-transparent opacity-50 shadow-[0_0_15px_rgba(212,162,74,0.8)] transition-opacity duration-500 group-hover:opacity-100">
    </div>

    {
      title && (
        <header class="mb-8 flex items-center gap-4 border-b border-amber-400/40 pb-4">
          <div class="h-8 w-1.5 shrink-0 rounded-full bg-gradient-to-b from-amber-200 to-violet-600 shadow-[0_0_15px_rgba(212,162,74,0.6)]" />
          <HeadingTag class="bg-gradient-to-r from-white via-amber-100 to-amber-300 bg-clip-text text-2xl leading-normal font-black tracking-widest text-transparent uppercase drop-shadow-sm">
            {title}
          </HeadingTag>
        </header>
      )
    }

    <div class="grid grid-cols-1 gap-6 lg:grid-cols-2 lg:gap-10">
      <article
        class="relative flex gap-4 rounded-2xl border border-amber-400/15 bg-[#150a24]/70 p-6 transition-all duration-300 hover:-translate-y-2 hover:border-amber-300/50 hover:bg-[#241040]/70 hover:shadow-[0_15px_30px_rgba(212,162,74,0.18)]">
        <div
          class="flex h-12 w-12 shrink-0 items-center justify-center rounded-xl border border-amber-200/40 bg-gradient-to-br from-[#e0b877] to-[#b8823a] text-2xl shadow-[0_0_10px_rgba(212,162,74,0.5)]">
          💰
        </div>
        <div class="text-left text-base leading-relaxed text-amber-50/85">
          <slot name="left" />
        </div>
      </article>

      <article
        class="relative flex gap-4 rounded-2xl border border-amber-400/15 bg-[#150a24]/70 p-6 transition-all duration-300 hover:-translate-y-2 hover:border-amber-300/50 hover:bg-[#241040]/70 hover:shadow-[0_15px_30px_rgba(212,162,74,0.18)]">
        <div
          class="flex h-12 w-12 shrink-0 items-center justify-center rounded-xl border border-violet-300/50 bg-gradient-to-br from-[#7c3aed] to-[#4c1d95] text-2xl shadow-[0_0_10px_rgba(124,58,237,0.55)]">
          ⏳
        </div>
        <div class="text-left text-base leading-relaxed text-amber-50/85">
          <slot name="right" />
        </div>
      </article>
    </div>
  </div>
</section>
<style>
  .font-sans {
    font-family: var(--font-sans);
  }
</style>
