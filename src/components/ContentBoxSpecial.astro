---
export interface Props {
  title?: string;
  as?: "h1" | "h2" | "h3" | "h4" | "h5" | "h6";
  label?: string;
}
const { title, as: HeadingTag = "h2", label } = Astro.props;

// Two halves, two accents: the left one carries the brand's primary lime, the
// right one the gold that echoes the coins in the artwork. The consumer passes
// exactly ONE element per slot — each <slot> is a flex sibling of its icon box,
// so two block children would sit beside the icon as separate flex items.
---

<section aria-label={title ? undefined : label} class="relative z-10 mx-auto mb-10 w-full max-w-[1400px] px-4 font-sans">
  <div
    class="group relative isolate w-full overflow-hidden rounded-3xl border border-[#7bbb0b]/25 bg-[#0a1c04]/92 p-6 text-[#dcefc2] shadow-[0_10px_30px_rgba(123,187,11,0.16)] backdrop-blur-xl transition-all duration-500 hover:border-[#7bbb0b]/50 md:p-10">
    <div
      aria-hidden="true"
      class="pointer-events-none absolute top-0 left-1/2 -z-10 h-[2px] w-1/2 -translate-x-1/2 bg-gradient-to-r from-transparent via-[#7bbb0b] to-transparent opacity-60 transition-opacity duration-500 group-hover:opacity-100">
    </div>

    {
      title && (
        <header class="mb-8 flex items-center gap-4 border-b border-[#7bbb0b]/25 pb-4">
          <div class="h-8 w-1.5 shrink-0 rounded-full bg-gradient-to-b from-[#a8e81c] to-[#3c6b07] shadow-[0_0_10px_rgba(123,187,11,0.5)]" />
          <HeadingTag class="bg-gradient-to-r from-[#a8e81c] via-[#7bbb0b] to-[#e9f8cf] bg-clip-text text-2xl leading-normal font-black tracking-widest text-transparent uppercase">{title}</HeadingTag>
        </header>
      )
    }

    <div class="grid grid-cols-1 gap-6 lg:grid-cols-2 lg:gap-10">
      <article
        class="relative flex gap-4 rounded-2xl border border-[#7bbb0b]/20 bg-[#0d2606]/95 p-6 text-left text-base leading-relaxed text-[#dcefc2] transition-all duration-300 hover:-translate-y-2 hover:border-[#7bbb0b]/50 hover:bg-[#0a1c04]/90 hover:shadow-[0_15px_40px_rgba(123,187,11,0.28)]">
        <div
          aria-hidden="true"
          class="flex h-12 w-12 shrink-0 items-center justify-center rounded-xl border border-[#7bbb0b]/30 bg-gradient-to-br from-[#a8e81c] via-[#7bbb0b] to-[#3c6b07] text-2xl shadow-[0_5px_15px_rgba(123,187,11,0.3)]">
          🔐
        </div>
        <slot name="left" />
      </article>

      <article
        class="relative flex gap-4 rounded-2xl border border-[#f5c518]/20 bg-[#0d2606]/95 p-6 text-left text-base leading-relaxed text-[#dcefc2] transition-all duration-300 hover:-translate-y-2 hover:border-[#f5c518]/50 hover:bg-[#0a1c04]/90 hover:shadow-[0_15px_40px_rgba(245,197,24,0.24)]">
        <div
          aria-hidden="true"
          class="flex h-12 w-12 shrink-0 items-center justify-center rounded-xl border border-[#f5c518]/40 bg-gradient-to-br from-[#ffe27a] via-[#f5c518] to-[#a87c05] text-2xl shadow-[0_5px_15px_rgba(245,197,24,0.3)]">
          🛡️
        </div>
        <slot name="right" />
      </article>
    </div>
  </div>
</section>
