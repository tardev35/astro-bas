---
const providers = [
  { name: "Hacksaw Gaming", desc: "มินิมอลสไตล์ที่ฉีกกฎเดิม อัตราคูณเงินรางวัลสูงลิ่ว", tag: "โบนัสแตกหนัก", icon: "💥" },
  { name: "Nolimit City", desc: "ฟีเจอร์แปลกใหม่ จ่ายหนักจัดเต็มในทุกการหมุน", tag: "ขีดสุดแห่งฟีเจอร์", icon: "🔥" },
  { name: "Relax Gaming", desc: "กราฟิกอลังการ ซอฟต์แวร์เบาและเสถียรทุกอุปกรณ์", tag: "แอนิเมชันลื่นไหล", icon: "🎬" },
  { name: "คัดกรองมาตรฐานสากล", desc: "ทุกตัวเกมผ่านการคัดกรองก่อนต่อเข้าเซิร์ฟเวอร์หลัก", tag: "เว็บสล็อตเจ้าใหญ่", icon: "🌐" },
  { name: "แดชบอร์ดรับสิทธิ์เอง", desc: "โบนัสต้อนรับและแคมเปญประจำวัน กดรับได้จากหน้าเดียว", tag: "โปรโมชั่นเด็ด", icon: "🎁" },
  { name: "ทีมผู้เชี่ยวชาญ 24 ชม.", desc: "ให้คำปรึกษาและแก้ปัญหาตรงจุดตลอดทั้งวัน", tag: "บริการระดับ VVIP", icon: "👑" },
  { name: "Secure Transition Popup", desc: "โหลดไว ลื่นไหล ป้องกันการรีเฟรชหน้าเว็บซ้ำซ้อน", tag: "Premium Loader", icon: "🛡️" },
];
---

<section aria-label="ค่ายเกมระดับโลกและระบบที่ LUCKYGAME689 รวบรวมไว้ในเว็บเดียว" class="relative z-10 mx-auto mb-10 w-full max-w-[1400px] px-4 font-sans">
  <div class="mb-8 flex w-full flex-col items-center justify-center gap-2 text-center">
    <p class="bg-gradient-to-r from-[#ffd84d] via-[#faad23] to-[#ff3d8a] bg-clip-text text-3xl font-black tracking-widest text-transparent uppercase">
      ค่ายเกมระดับโลกและระบบที่ <span class="text-[#ff3d8a]">LUCKYGAME689</span> รวบรวมไว้ในเว็บเดียว
    </p>
    <div class="mt-2 h-[4px] w-24 rounded-full bg-gradient-to-r from-transparent via-[#faad23] to-transparent"></div>
  </div>

  <div class="grid grid-cols-2 gap-4 sm:grid-cols-3 lg:grid-cols-4 lg:gap-5 xl:grid-cols-7">
    {
      providers.map((provider) => (
        <a
          href="/register"
          class="group relative flex flex-col items-center justify-center overflow-hidden rounded-2xl border border-[#faad23]/25 bg-[#2b0204]/92 p-5 shadow-[0_10px_30px_rgba(250,173,35,0.18)] backdrop-blur-md transition-all duration-300 hover:-translate-y-2 hover:border-[#faad23]/50 hover:bg-[#3d0410]/95 hover:shadow-[0_15px_40px_rgba(224,27,93,0.3)]">
          <div class="pointer-events-none absolute inset-0 bg-[#e01b5d]/12 opacity-0 transition-opacity duration-300 group-hover:opacity-100" />

          <div class="absolute top-2 right-2 z-10 rounded-full bg-gradient-to-r from-[#ffd84d] via-[#faad23] to-[#b8760f] px-2 py-0.5 text-[9px] font-black tracking-wide whitespace-nowrap text-[#2b0204] shadow-sm transition-transform duration-300 group-hover:scale-110">
            {provider.tag}
          </div>

          <div aria-hidden="true" class="mb-3 text-4xl transition-transform duration-300 group-hover:scale-125 group-hover:rotate-3">
            {provider.icon}
          </div>
          <p class="text-center text-sm font-black text-[#ffe9c4] transition-colors group-hover:text-[#ffd84d]">{provider.name}</p>
          <p class="mt-1 text-center text-[10px] text-[#e0a6b5]">{provider.desc}</p>

          <span class="relative z-10 mt-4 block w-full rounded-full border border-[#faad23]/25 bg-[#1a0106] py-1.5 text-center text-[11px] font-bold text-[#faad23] shadow-inner transition-colors duration-300 group-hover:border-[#faad23]/50 group-hover:bg-gradient-to-r group-hover:from-[#ffd84d] group-hover:via-[#faad23] group-hover:to-[#b8760f] group-hover:text-[#2b0204]">
            เข้าดูเกม
          </span>
        </a>
      ))
    }
  </div>
</section>
