---
// The first three tiles are the camps the docx names by hand, in the same order
// it lists them, so the grid and the prose above it cannot disagree. The rest
// are this brand's four system claims. There is no logo artwork for these camps
// in src/assets/providers/ (that folder holds six camp illustrations used by
// GameRankingBoard), so the tiles stay icon-led.
const providers = [
  { name: "Microgaming", desc: "เสถียรภาพสูง เครือข่ายแจ็กพอตเปลี่ยนคุณเป็นมหาเศรษฐีข้ามคืน", tag: "ตำนานแห่งวงการ", icon: "👑" },
  { name: "NetEnt", desc: "แอนิเมชันพรีเมียม กลไกแยบยล ลุ้นรอบโบนัสต่อเนื่องคุ้มค่า", tag: "กราฟิกอลังการ", icon: "💎" },
  { name: "Novomatic", desc: "เกมเพลย์คลาสสิกทรงพลัง อัตราคูณสูง โหลดไวทุกอุปกรณ์", tag: "ทำกำไรต่อเนื่อง", icon: "🎰" },
  { name: "ค่ายใหญ่ลิขสิทธิ์แท้", desc: "ซอฟต์แวร์มาตรฐานสากล ผ่านการรับรองความโปร่งใสทุกเกม", tag: "จ่ายยุติธรรม", icon: "🛡️" },
  { name: "รองรับทรูวอเลท", desc: "เชื่อมกระเป๋าเงินดิจิทัลตรง ฝากถอนอิสระ ไม่ต้องใช้บัญชีธนาคาร", tag: "ไวในเสี้ยววินาที", icon: "👛" },
  { name: "ทางเข้าหลักเว็บตรง", desc: "รากฐานเซิร์ฟเวอร์มั่นคง ให้บริการตรง ไม่ผ่านตัวแทนใดๆ", tag: "โปร่งใสมั่นคง", icon: "🏛️" },
  { name: "Secure Popup", desc: "เข้ารหัสขั้นสูง ป้องกันการรีเฟรชหน้าเว็บซ้ำซ้อน เป็นส่วนตัว", tag: "ปลอดภัย 100%", icon: "🔒" },
];
---

<section aria-label="ค่ายเกมลิขสิทธิ์แท้และระบบที่ ROMAN555 รวมไว้ในเว็บเดียว" class="relative z-10 mx-auto mb-10 w-full max-w-[1400px] px-4 font-sans">
  <div class="mb-8 flex w-full flex-col items-center justify-center gap-2 text-center">
    <p class="bg-gradient-to-r from-[#fbeab0] via-[#d99a1c] to-[#f6cf6a] bg-clip-text text-3xl font-black tracking-widest text-transparent uppercase">
      ค่ายเกมลิขสิทธิ์แท้และระบบที่ <span class="text-[#f6cf6a]">ROMAN555</span> รวมไว้ในเว็บเดียว
    </p>
    <div class="mt-2 h-[4px] w-24 rounded-full bg-gradient-to-r from-transparent via-[#a8690a] to-transparent"></div>
  </div>

  <div class="grid grid-cols-2 gap-4 sm:grid-cols-3 lg:grid-cols-4 lg:gap-5 xl:grid-cols-7">
    {
      providers.map((provider) => (
        <a
          href="/register"
          class="group relative flex flex-col items-center justify-center overflow-hidden rounded-2xl border border-[#a8690a]/25 bg-[#1a0f04]/92 p-5 shadow-[0_10px_30px_rgba(168,105,10,0.18)] backdrop-blur-md transition-all duration-300 hover:-translate-y-2 hover:border-[#d99a1c]/50 hover:bg-[#241505]/95 hover:shadow-[0_15px_40px_rgba(217,154,28,0.32)]">
          <div class="pointer-events-none absolute inset-0 bg-[#d99a1c]/12 opacity-0 transition-opacity duration-300 group-hover:opacity-100" />

          <div class="absolute top-2 right-2 z-10 rounded-full bg-gradient-to-r from-[#fbeab0] via-[#d99a1c] to-[#7a4405] px-2 py-0.5 text-[9px] font-black tracking-wide whitespace-nowrap text-[#1a1002] shadow-sm transition-transform duration-300 group-hover:scale-110">
            {provider.tag}
          </div>

          <div aria-hidden="true" class="mb-3 text-4xl transition-transform duration-300 group-hover:scale-125 group-hover:rotate-3">
            {provider.icon}
          </div>
          <p class="text-center text-sm font-black text-[#f2e4c4] transition-colors group-hover:text-[#f6cf6a]">{provider.name}</p>
          <p class="mt-1 text-center text-[10px] text-[#e8c9a0]">{provider.desc}</p>

          <span class="relative z-10 mt-4 block w-full rounded-full border border-[#a8690a]/25 bg-[#120a02] py-1.5 text-center text-[11px] font-bold text-[#d99a1c] shadow-inner transition-colors duration-300 group-hover:border-[#d99a1c]/50 group-hover:bg-gradient-to-r group-hover:from-[#fbeab0] group-hover:via-[#d99a1c] group-hover:to-[#7a4405] group-hover:text-[#1a1002]">
            เข้าดูเกม
          </span>
        </a>
      ))
    }
  </div>
</section>
