---
const providers = [
  { name: "สล็อตออนไลน์", desc: "เล่นตามรอบสปินจากหลายค่ายเกม", tag: "สล็อต", icon: "🎰", color: "from-[#1c1609] to-[#0b0906]" },
  { name: "คาสิโนสด", desc: "บาคาร่า รูเล็ต เสือมังกร ตามรอบโต๊ะจริง", tag: "ไลฟ์สด", icon: "🃏", color: "from-[#241a09] to-[#0b0906]" },
  { name: "ค่า RTP และ Volatility", desc: "ดูอัตราจ่ายคืนระยะยาวก่อนเลือกเกม", tag: "ข้อมูลเกม", icon: "📊", color: "from-[#1c1609] to-[#050403]" },
  { name: "ฝากขั้นต่ำ 1 บาท", desc: "ระบบออโต้ ตรวจยอดและเลขบัญชีก่อนโอน", tag: "ฝากถอน", icon: "💰", color: "from-[#241a09] to-[#050403]" },
  { name: "ธนาคาร และ TrueMoney Wallet", desc: "รองรับหลายช่องทางผ่านระบบอัตโนมัติ", tag: "ช่องทาง", icon: "🏦", color: "from-[#2a2110] to-[#0b0906]" },
  { name: "โปรโมชั่นและทางเข้า", desc: "อ่านเทิร์นโอเวอร์ และตรวจโดเมนก่อนล็อกอิน", tag: "ก่อนใช้งาน", icon: "🛡️", color: "from-[#1c1609] to-[#12100a]" },
];
---

<div class="relative z-10 mx-auto mb-10 w-full max-w-[1400px] px-4 font-sans">
  <div class="mb-8 flex w-full flex-col items-center justify-center gap-2 text-center">
    <p class="bg-gradient-to-r from-white via-amber-100 to-amber-400 bg-clip-text text-3xl font-black tracking-widest text-transparent uppercase drop-shadow-[0_2px_10px_rgba(212,175,90,0.35)]">
      หมวดเกมและบริการภายใน <span class="text-amber-200">LAPDEE88</span>
    </p>
    <div class="mt-2 h-[4px] w-24 rounded-full bg-gradient-to-r from-transparent via-amber-400 to-transparent"></div>
  </div>

  <div class="grid grid-cols-2 gap-4 sm:grid-cols-3 lg:grid-cols-6 lg:gap-5">
    {
      providers.map((game) => (
        <a
          href="/register"
          class={`group relative flex flex-col items-center justify-center overflow-hidden rounded-2xl border border-amber-400/30 bg-gradient-to-b ${game.color} p-5 shadow-lg backdrop-blur-md transition-all duration-300 hover:-translate-y-2 hover:border-amber-300/60 hover:shadow-[0_10px_30px_rgba(212,175,90,0.45)]`}>
          <div class="pointer-events-none absolute inset-0 bg-white/5 opacity-0 transition-opacity duration-300 group-hover:opacity-100" />

          <div class="absolute top-2 right-2 z-10 rounded-full bg-gradient-to-r from-[#f6e4b4] via-[#e0bd72] to-[#b1873a] px-2 py-0.5 text-[9px] font-black tracking-wide whitespace-nowrap text-[#140f05] shadow-sm transition-transform duration-300 group-hover:scale-110">
            {game.tag}
          </div>

          <div class="mb-3 text-4xl drop-shadow-[0_0_15px_rgba(255,255,255,0.3)] transition-transform duration-300 group-hover:scale-125 group-hover:rotate-3">{game.icon}</div>
          <p class="text-center text-sm font-black text-white transition-colors group-hover:text-amber-200">{game.name}</p>
          <p class="mt-1 text-center text-[10px] text-amber-100/70 group-hover:text-white">{game.desc}</p>

          {/* ทั้งการ์ดเป็นลิงก์แล้ว ตัวนี้จึงเป็น span ไม่ใช่ <a> — <a> ซ้อน <a> เป็น HTML ที่ไม่ถูกต้อง
              เบราว์เซอร์จะแยกออกจากกันเอง แล้วครึ่งล่างของการ์ดจะหลุดออกไปกดไม่ได้ */}
          <span class="relative z-10 mt-4 block w-full rounded-full border border-amber-400/30 bg-black/40 py-1.5 text-center text-[11px] font-bold text-amber-200 shadow-inner transition-colors duration-300 group-hover:border-amber-200 group-hover:bg-[#b1873a] group-hover:text-[#140f05]">
            เข้าเล่นเกม
          </span>
        </a>
      ))
    }
  </div>
</div>
<style>
  .font-sans {
    font-family: var(--font-sans);
  }
</style>
