---
// The first three tiles are the camps the docx names by hand, in the same order
// it lists them, so the grid and the prose above it cannot disagree. The rest
// are this brand's four system claims. There is no logo artwork for these camps
// in src/assets/providers/ (that folder holds six camp illustrations used by
// GameRankingBoard), so the tiles stay icon-led.
const providers = [
  { name: "AvatarUX", desc: "กลไก PopWins ขยายเพย์ไลน์ ทวีคูณรางวัลไม่รู้จบ", tag: "นวัตกรรม PopWins", icon: "🪶" },
  { name: "Spinomenal", desc: "ภาพแอนิเมชันตระการตา ฟีเจอร์เข้าถึงรอบแจ็กพอตไว", tag: "โบนัสเข้าไว", icon: "🎆" },
  { name: "Relax Gaming", desc: "สถาปัตยกรรมซอฟต์แวร์แข็งแกร่ง โหลดไว ไม่มีสะดุด", tag: "เสถียรภาพยอดเยี่ยม", icon: "🧩" },
  { name: "เกมลิขสิทธิ์แท้", desc: "ทุกเกมทำงานบนเซิร์ฟเวอร์หลักโดยตรง อัตราจ่ายโปร่งใส", tag: "สล็อตเว็บใหญ่", icon: "🛡️" },
  { name: "ระบบ AI อัจฉริยะ", desc: "ประมวลผลเครดิตเสร็จสิ้นภายในเสี้ยววินาที", tag: "ระบบออโต้", icon: "⚡" },
  { name: "เว็บตรงไม่ผ่านเอเย่นต์", desc: "เชื่อมต่อเซิร์ฟเวอร์หลักตรง มั่นคงระดับองค์กร", tag: "ทำเงินได้จริง", icon: "🏦" },
  { name: "เมนูรับสิทธิ์อัตโนมัติ", desc: "เลือกรับแคมเปญเสริมเองได้จากหน้าแดชบอร์ด", tag: "โปรจัดเต็ม", icon: "🎁" },
];
---

<section aria-label="ค่ายเกมลิขสิทธิ์แท้และระบบที่ GARUDA369 รวมไว้ในเว็บเดียว" class="relative z-10 mx-auto mb-10 w-full max-w-[1400px] px-4 font-sans">
  <div class="mb-8 flex w-full flex-col items-center justify-center gap-2 text-center">
    <p class="bg-gradient-to-r from-[#a8e81c] via-[#7bbb0b] to-[#f5c518] bg-clip-text text-3xl font-black tracking-widest text-transparent uppercase">
      ค่ายเกมลิขสิทธิ์แท้และระบบที่ <span class="text-[#a8e81c]">GARUDA369</span> รวมไว้ในเว็บเดียว
    </p>
    <div class="mt-2 h-[4px] w-24 rounded-full bg-gradient-to-r from-transparent via-[#7bbb0b] to-transparent"></div>
  </div>

  <div class="grid grid-cols-2 gap-4 sm:grid-cols-3 lg:grid-cols-4 lg:gap-5 xl:grid-cols-7">
    {
      providers.map((provider) => (
        <a
          href="/register"
          class="group relative flex flex-col items-center justify-center overflow-hidden rounded-2xl border border-[#7bbb0b]/25 bg-[#0a1c04]/92 p-5 shadow-[0_10px_30px_rgba(123,187,11,0.18)] backdrop-blur-md transition-all duration-300 hover:-translate-y-2 hover:border-[#7bbb0b]/50 hover:bg-[#0d2606]/95 hover:shadow-[0_15px_40px_rgba(99,163,12,0.32)]">
          <div class="pointer-events-none absolute inset-0 bg-[#63a30c]/12 opacity-0 transition-opacity duration-300 group-hover:opacity-100" />

          <div class="absolute top-2 right-2 z-10 rounded-full bg-gradient-to-r from-[#a8e81c] via-[#7bbb0b] to-[#3c6b07] px-2 py-0.5 text-[9px] font-black tracking-wide whitespace-nowrap text-[#061405] shadow-sm transition-transform duration-300 group-hover:scale-110">
            {provider.tag}
          </div>

          <div aria-hidden="true" class="mb-3 text-4xl transition-transform duration-300 group-hover:scale-125 group-hover:rotate-3">
            {provider.icon}
          </div>
          <p class="text-center text-sm font-black text-[#dcefc2] transition-colors group-hover:text-[#a8e81c]">{provider.name}</p>
          <p class="mt-1 text-center text-[10px] text-[#a3c974]">{provider.desc}</p>

          <span class="relative z-10 mt-4 block w-full rounded-full border border-[#7bbb0b]/25 bg-[#061405] py-1.5 text-center text-[11px] font-bold text-[#7bbb0b] shadow-inner transition-colors duration-300 group-hover:border-[#7bbb0b]/50 group-hover:bg-gradient-to-r group-hover:from-[#a8e81c] group-hover:via-[#7bbb0b] group-hover:to-[#3c6b07] group-hover:text-[#061405]">
            เข้าดูเกม
          </span>
        </a>
      ))
    }
  </div>
</section>
