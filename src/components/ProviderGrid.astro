---
const providers = [
  { name: "PG Soft", desc: "สล็อตแนวตั้งเล่นบนมือถือ มีเกมยอดนิยมให้เลือกหลายเกม", tag: "สล็อต", icon: "🎰" },
  { name: "Pragmatic Play", desc: "มีทั้งสล็อตและโต๊ะ Live สดอยู่ในค่ายเดียวกัน", tag: "สล็อต + Live", icon: "🎲" },
  { name: "Microgaming", desc: "ค่ายเกมเก่าแก่ ฟีเจอร์และรูปแบบเกมหลากหลาย", tag: "สล็อต", icon: "🕹️" },
  { name: "NetEnt", desc: "สล็อตกราฟิกเรียบ อ่านปุ่มเดิมพันง่ายบนจอมือถือ", tag: "สล็อต", icon: "💠" },
  { name: "Red Tiger", desc: "เกมจังหวะเร็ว มีเกมใหม่เข้าหมวดอยู่เรื่อย ๆ", tag: "เกมใหม่", icon: "🐯" },
  { name: "Betsoft", desc: "สล็อตสไตล์ภาพสามมิติ ดูฟีเจอร์ได้จากโหมดทดลอง", tag: "โหมดทดลอง", icon: "🎬" },
  { name: "Yggdrasil", desc: "รูปแบบเกมแปลกตา เหมาะกับคนอยากลองของใหม่", tag: "สล็อต", icon: "🌿" },
];
---

<div class="relative z-10 mx-auto mb-10 w-full max-w-[1400px] px-4 font-sans">
  <div class="mb-8 flex w-full flex-col items-center justify-center gap-2 text-center">
    <p class="bg-gradient-to-r from-[#7a5a12] via-[#b8912f] to-[#8a6a1f] bg-clip-text text-3xl font-black tracking-widest text-transparent uppercase">
      ค่ายสล็อตที่แสดงบนหน้า <span class="text-[#a07c1f]">WINUP888</span>
    </p>
    <div class="mt-2 h-[4px] w-24 rounded-full bg-gradient-to-r from-transparent via-[#c9a227] to-transparent"></div>
  </div>

  <div class="grid grid-cols-2 gap-4 sm:grid-cols-3 lg:grid-cols-4 lg:gap-5 xl:grid-cols-7">
    {
      providers.map((game) => (
        <a
          href="/register"
          class="group relative flex flex-col items-center justify-center overflow-hidden rounded-2xl border border-amber-600/25 bg-[#fffdf7]/92 p-5 shadow-[0_10px_30px_rgba(168,132,44,0.18)] backdrop-blur-md transition-all duration-300 hover:-translate-y-2 hover:border-amber-600/50 hover:bg-[#faf4e6]/95 hover:shadow-[0_15px_40px_rgba(168,132,44,0.30)]">
          <div class="pointer-events-none absolute inset-0 bg-amber-300/10 opacity-0 transition-opacity duration-300 group-hover:opacity-100" />

          <div class="absolute top-2 right-2 z-10 rounded-full bg-gradient-to-r from-[#f4dfa3] via-[#d9b45c] to-[#a97f2a] px-2 py-0.5 text-[9px] font-black tracking-wide whitespace-nowrap text-[#231a06] shadow-sm transition-transform duration-300 group-hover:scale-110">
            {game.tag}
          </div>

          <div class="mb-3 text-4xl transition-transform duration-300 group-hover:scale-125 group-hover:rotate-3">{game.icon}</div>
          <p class="text-center text-sm font-black text-[#3a2e18] transition-colors group-hover:text-[#8a6410]">{game.name}</p>
          <p class="mt-1 text-center text-[10px] text-[#6b5836]">{game.desc}</p>

          <span class="relative z-10 mt-4 block w-full rounded-full border border-amber-600/25 bg-[#faf4e6] py-1.5 text-center text-[11px] font-bold text-[#8a6410] shadow-inner transition-colors duration-300 group-hover:border-amber-600/50 group-hover:bg-gradient-to-r group-hover:from-[#f4dfa3] group-hover:via-[#d9b45c] group-hover:to-[#a97f2a] group-hover:text-[#231a06]">
            เข้าดูเกม
          </span>
        </a>
      ))
    }
  </div>
</div>
<style>
  .font-sans {
    font-family: var(--font-sans);
  }
</style>
