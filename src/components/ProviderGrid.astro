---
const providers = [
  { name: "PG Soft", desc: "กราฟิก 3D สมจริง ฟีเจอร์ไหลลื่น เข้าถึงรอบโบนัสแจ็กพอตได้ไว", tag: "โบนัสแตกไว", icon: "🐉" },
  { name: "Pragmatic Play", desc: "กลไกออกรางวัลโปร่งใส ตอบสนองฉับไว จ่ายผลตอบแทนก้อนโต", tag: "แจกรางวัลรัว", icon: "⚡" },
  { name: "Nolimit City", desc: "ฟีเจอร์ดุดัน ทวีคูณเงินรางวัลแบบก้าวกระโดด โหลดไวไม่ค้าง", tag: "ตัวคูณมหาศาล", icon: "🔥" },
  { name: "ระบบออโต้ไม่มีขั้นต่ำ", desc: "ประมวลผลด้วย AI อัจฉริยะ บริหารทุนได้อิสระ ไร้เงื่อนไขผูกมัด", tag: "ไม่มีขั้นต่ำ", icon: "🤖" },
  { name: "ฝาก-ถอนอัตโนมัติ", desc: "ทำรายการเสร็จสิ้นภายในไม่กี่วินาที แม่นยำ ตลอด 24 ชั่วโมง", tag: "รวดเร็วทันใจ", icon: "💸" },
  { name: "โปรลุ้นรับรางวัลเยอะ", desc: "โบนัสต้อนรับ แคมเปญประจำวัน และคืนยอดเสีย 15% กดรับเองได้", tag: "แจกหนักทุกวัน", icon: "🎁" },
  { name: "Secure Transition Popup", desc: "เข้ารหัสระดับสถาบันการเงิน ป้องกันการรีเฟรชหน้าเว็บซ้ำซ้อน", tag: "ปลอดภัย 100%", icon: "🛡️" },
];
---

<section aria-label="ค่ายเกมระดับโลกและระบบที่ PGW44 รวมไว้ในบัญชีเดียว" class="relative z-10 mx-auto mb-10 w-full max-w-[1400px] px-4 font-sans">
  <div class="mb-8 flex w-full flex-col items-center justify-center gap-2 text-center">
    <p class="bg-gradient-to-r from-[#ffd54a] via-[#ecab03] to-[#8fd633] bg-clip-text text-3xl font-black tracking-widest text-transparent uppercase">
      ค่ายเกมระดับโลกและระบบที่ <span class="text-[#8fd633]">PGW44</span> รวมไว้ในบัญชีเดียว
    </p>
    <div class="mt-2 h-[4px] w-24 rounded-full bg-gradient-to-r from-transparent via-[#ecab03] to-transparent"></div>
  </div>

  <div class="grid grid-cols-2 gap-4 sm:grid-cols-3 lg:grid-cols-4 lg:gap-5 xl:grid-cols-7">
    {
      providers.map((provider) => (
        <a
          href="/register"
          class="group relative flex flex-col items-center justify-center overflow-hidden rounded-2xl border border-[#ecab03]/25 bg-[#111a0a]/92 p-5 shadow-[0_10px_30px_rgba(236,171,3,0.18)] backdrop-blur-md transition-all duration-300 hover:-translate-y-2 hover:border-[#ecab03]/50 hover:bg-[#1a2610]/95 hover:shadow-[0_15px_40px_rgba(236,171,3,0.3)]">
          <div class="pointer-events-none absolute inset-0 bg-[#ecab03]/10 opacity-0 transition-opacity duration-300 group-hover:opacity-100" />

          <div class="absolute top-2 right-2 z-10 rounded-full bg-gradient-to-r from-[#ffd54a] via-[#ecab03] to-[#a9760a] px-2 py-0.5 text-[9px] font-black tracking-wide whitespace-nowrap text-[#0a0f06] shadow-sm transition-transform duration-300 group-hover:scale-110">
            {provider.tag}
          </div>

          <div aria-hidden="true" class="mb-3 text-4xl transition-transform duration-300 group-hover:scale-125 group-hover:rotate-3">
            {provider.icon}
          </div>
          <p class="text-center text-sm font-black text-[#e8efd8] transition-colors group-hover:text-[#ffd54a]">{provider.name}</p>
          <p class="mt-1 text-center text-[10px] text-[#b9c4a6]">{provider.desc}</p>

          <span class="relative z-10 mt-4 block w-full rounded-full border border-[#ecab03]/25 bg-[#0a0f06] py-1.5 text-center text-[11px] font-bold text-[#ecab03] shadow-inner transition-colors duration-300 group-hover:border-[#ecab03]/50 group-hover:bg-gradient-to-r group-hover:from-[#ffd54a] group-hover:via-[#ecab03] group-hover:to-[#a9760a] group-hover:text-[#0a0f06]">
            เข้าดูเกม
          </span>
        </a>
      ))
    }
  </div>
</section>
