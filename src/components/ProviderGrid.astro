---
// The first three tiles are the camps the docx names by hand, in the same order
// it lists them, so the grid and the prose above it cannot disagree. The rest
// are this brand's four system claims. There is no logo artwork for these camps
// in src/assets/providers/ (that folder holds six camp illustrations used by
// GameRankingBoard), so the tiles stay icon-led.
const providers = [
  { name: "Quickspin", desc: "เล่าเรื่องผ่านกราฟิกพรีเมียม กลไกโบนัสแยบยล", tag: "กราฟิกเหนือระดับ", icon: "🎨" },
  { name: "Evoplay", desc: "อินเทอร์เฟซเกม 3D ที่ฉีกกรอบการเดิมพันเดิมๆ", tag: "นวัตกรรม 3D", icon: "🕹️" },
  { name: "CQ9", desc: "ระบบเสถียร ฟีเจอร์คูณเงินรางวัลจัดจ้าน", tag: "ตอบสนองไว", icon: "💥" },
  { name: "เกมลิขสิทธิ์แท้", desc: "ตรวจสอบคุณภาพเข้มงวด โปร่งใส จ่ายผลตอบแทนแม่นยำ", tag: "เว็บสล็อตใหม่ล่าสุด", icon: "🛡️" },
  { name: "เทคโนโลยี AI เฉพาะทาง", desc: "เครดิตอัปเดตเข้าแดชบอร์ดภายในเสี้ยววินาที", tag: "ระบบออโต้", icon: "⚡" },
  { name: "อิสระทางการเงิน", desc: "บริหารเงินทุนได้เสรี ไร้ข้อผูกมัดหรือเงื่อนไขอึดอัด", tag: "ฝากถอนไม่มีขั้นต่ำ", icon: "💳" },
  { name: "เมนูรับสิทธิ์อัตโนมัติ", desc: "เลือกรับแคมเปญด้วยตนเอง เสริมความแข็งแกร่งให้ฐานทุน", tag: "โปรเด็ด", icon: "🎁" },
];
---

<section aria-label="ค่ายเกมระดับโลกและระบบที่ PGW44 คัดสรรไว้ในเว็บเดียว" class="relative z-10 mx-auto mb-10 w-full max-w-[1400px] px-4 font-sans">
  <div class="mb-8 flex w-full flex-col items-center justify-center gap-2 text-center">
    <p class="bg-gradient-to-r from-[#cdf76b] via-[#7fdc16] to-[#f2b40b] bg-clip-text text-3xl font-black tracking-widest text-transparent uppercase">
      ค่ายเกมระดับโลกและระบบที่ <span class="text-[#7fdc16]">PGW44</span> คัดสรรไว้ในเว็บเดียว
    </p>
    <div class="mt-2 h-[4px] w-24 rounded-full bg-gradient-to-r from-transparent via-[#7fdc16] to-transparent"></div>
  </div>

  <div class="grid grid-cols-2 gap-4 sm:grid-cols-3 lg:grid-cols-4 lg:gap-5 xl:grid-cols-7">
    {
      providers.map((provider) => (
        <a
          href="/register"
          class="group relative flex flex-col items-center justify-center overflow-hidden rounded-2xl border border-[#7fdc16]/25 bg-[#07120a]/92 p-5 shadow-[0_10px_30px_rgba(127,220,22,0.18)] backdrop-blur-md transition-all duration-300 hover:-translate-y-2 hover:border-[#7fdc16]/50 hover:bg-[#0e2410]/95 hover:shadow-[0_15px_40px_rgba(99,184,15,0.32)]">
          <div class="pointer-events-none absolute inset-0 bg-[#63b80f]/12 opacity-0 transition-opacity duration-300 group-hover:opacity-100" />

          <div class="absolute top-2 right-2 z-10 rounded-full bg-gradient-to-r from-[#cdf76b] via-[#7fdc16] to-[#3d7509] px-2 py-0.5 text-[9px] font-black tracking-wide whitespace-nowrap text-[#07120a] shadow-sm transition-transform duration-300 group-hover:scale-110">
            {provider.tag}
          </div>

          <div aria-hidden="true" class="mb-3 text-4xl transition-transform duration-300 group-hover:scale-125 group-hover:rotate-3">
            {provider.icon}
          </div>
          <p class="text-center text-sm font-black text-[#dff5c8] transition-colors group-hover:text-[#cdf76b]">{provider.name}</p>
          <p class="mt-1 text-center text-[10px] text-[#a6cf7a]">{provider.desc}</p>

          <span class="relative z-10 mt-4 block w-full rounded-full border border-[#7fdc16]/25 bg-[#050d07] py-1.5 text-center text-[11px] font-bold text-[#7fdc16] shadow-inner transition-colors duration-300 group-hover:border-[#7fdc16]/50 group-hover:bg-gradient-to-r group-hover:from-[#cdf76b] group-hover:via-[#7fdc16] group-hover:to-[#3d7509] group-hover:text-[#07120a]">
            เข้าดูเกม
          </span>
        </a>
      ))
    }
  </div>
</section>
