---
const providers = [
  { name: "PG Soft", desc: "กราฟิกเหนือชั้น แอนิเมชันสมจริง ฟีเจอร์ตัวคูณและฟรีสปินแตกไว", tag: "โบนัสแตกไว", icon: "🐉" },
  { name: "Pragmatic Play", desc: "ฟีเจอร์ทันสมัย เกมเพลย์ทรงพลัง ลุ้นแจ็กพอตก้อนโตทุกสปิน", tag: "แจกรางวัลรัว", icon: "⚡" },
  { name: "JILI", desc: "เอฟเฟกต์อลังการ ตัวเกมเบาและเสถียร เล่นสมูทบนสมาร์ทโฟน", tag: "ทะลุพิกัด", icon: "👑" },
  { name: "ระบบออโต้ AI อัจฉริยะ", desc: "ตรวจสอบและปรับยอดเครดิตเอง ไม่ต้องส่งสลิปหรือรอยืนยัน", tag: "รวดเร็วดั่งใจนึก", icon: "🤖" },
  { name: "ฝาก-ถอนไม่ผ่านคนกลาง", desc: "ทำธุรกรรมเสร็จภายในเสี้ยววินาที แม่นยำ ตลอด 24 ชั่วโมง", tag: "โอนไว", icon: "💸" },
  { name: "สิทธิพิเศษสมาชิก", desc: "ฝากแรกลุ้นรับทอง 1 บาท คืนยอดเสีย 15% แนะนำเพื่อนรับ 0.8%", tag: "จ่ายจริง", icon: "🎁" },
  { name: "Secure Transition Popup", desc: "เข้ารหัสระดับองค์กร ป้องกันการโหลดเว็บซ้ำซ้อน เป็นส่วนตัว 100%", tag: "ปลอดภัยขั้นสุด", icon: "🛡️" },
];
---

<section aria-label="ค่ายเกมลิขสิทธิ์แท้และระบบที่ TUNJAI123 รวมไว้ในเว็ปเดียว" class="relative z-10 mx-auto mb-10 w-full max-w-[1400px] px-4 font-sans">
  <div class="mb-8 flex w-full flex-col items-center justify-center gap-2 text-center">
    <p class="bg-gradient-to-r from-[#f5eb8b] via-[#dab563] to-[#dfe4e7] bg-clip-text text-3xl font-black tracking-widest text-transparent uppercase">
      ค่ายเกมลิขสิทธิ์แท้และระบบที่ <span class="text-[#dfe4e7]">TUNJAI123</span> รวมไว้ในเว็ปเดียว
    </p>
    <div class="mt-2 h-[4px] w-24 rounded-full bg-gradient-to-r from-transparent via-[#dab563] to-transparent"></div>
  </div>

  <div class="grid grid-cols-2 gap-4 sm:grid-cols-3 lg:grid-cols-4 lg:gap-5 xl:grid-cols-7">
    {
      providers.map((provider) => (
        <a
          href="/register"
          class="group relative flex flex-col items-center justify-center overflow-hidden rounded-2xl border border-[#dab563]/25 bg-[#100d08]/92 p-5 shadow-[0_10px_30px_rgba(218,181,99,0.18)] backdrop-blur-md transition-all duration-300 hover:-translate-y-2 hover:border-[#dab563]/50 hover:bg-[#1a1510]/95 hover:shadow-[0_15px_40px_rgba(218,181,99,0.3)]">
          <div class="pointer-events-none absolute inset-0 bg-[#dab563]/10 opacity-0 transition-opacity duration-300 group-hover:opacity-100" />

          <div class="absolute top-2 right-2 z-10 rounded-full bg-gradient-to-r from-[#f5eb8b] via-[#dab563] to-[#a97f28] px-2 py-0.5 text-[9px] font-black tracking-wide whitespace-nowrap text-[#120c04] shadow-sm transition-transform duration-300 group-hover:scale-110">
            {provider.tag}
          </div>

          <div aria-hidden="true" class="mb-3 text-4xl transition-transform duration-300 group-hover:scale-125 group-hover:rotate-3">
            {provider.icon}
          </div>
          <p class="text-center text-sm font-black text-[#ece3cf] transition-colors group-hover:text-[#f5eb8b]">{provider.name}</p>
          <p class="mt-1 text-center text-[10px] text-[#b5bbbc]">{provider.desc}</p>

          <span class="relative z-10 mt-4 block w-full rounded-full border border-[#dab563]/25 bg-[#050403] py-1.5 text-center text-[11px] font-bold text-[#dab563] shadow-inner transition-colors duration-300 group-hover:border-[#dab563]/50 group-hover:bg-gradient-to-r group-hover:from-[#f5eb8b] group-hover:via-[#dab563] group-hover:to-[#a97f28] group-hover:text-[#120c04]">
            เข้าดูเกม
          </span>
        </a>
      ))
    }
  </div>
</section>
