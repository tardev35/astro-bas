---
const providers = [
  { name: "สล็อตออนไลน์", desc: "เล่นตามรอบสปินจากหลายค่ายเกม", tag: "สล็อต", icon: "🎰", color: "from-[#241040] to-[#0a0714]" },
  { name: "กีฬา / แทงบอล", desc: "ดูค่าน้ำ ตลาดเดิมพัน และเวลาปิดรับก่อนกด", tag: "กีฬา", icon: "⚽", color: "from-[#2e1065] to-[#0a0714]" },
  { name: "เกม Live สด", desc: "เล่นตามรอบโต๊ะพร้อมภาพถ่ายทอดเรียลไทม์", tag: "ไลฟ์สด", icon: "🃏", color: "from-[#1a1130] to-[#050308]" },
  { name: "เดิมพันด้านการเงิน", desc: "อิงความเคลื่อนไหวของราคาในแต่ละช่วงเวลา", tag: "การเงิน", icon: "📈", color: "from-[#241040] to-[#050308]" },
  { name: "เปิดกล่อง เปิดดวง", desc: "กิจกรรมบนหน้าเว็บที่มีสิทธิ์และวันหมดอายุกำกับ", tag: "กิจกรรม", icon: "🎁", color: "from-[#4c1d95] to-[#0a0714]" },
  { name: "ล่า Hidden และเครดิตฟรี", desc: "กดรับเองผ่านหน้าเว็บ ตรวจยอดเทิร์นก่อนทุกครั้ง", tag: "ล่ารางวัล", icon: "🏆", color: "from-[#2e1065] to-[#150a24]" },
];
---

<div class="relative z-10 mx-auto mb-10 w-full max-w-[1400px] px-4 font-sans">
  <div class="mb-8 flex w-full flex-col items-center justify-center gap-2 text-center">
    <p class="bg-gradient-to-r from-white via-amber-100 to-amber-300 bg-clip-text text-3xl font-black tracking-widest text-transparent uppercase drop-shadow-[0_2px_10px_rgba(212,162,74,0.35)]">
      หมวดเกมและกิจกรรมภายใน <span class="text-amber-200">PAY69</span>
    </p>
    <div class="mt-2 h-[4px] w-24 rounded-full bg-gradient-to-r from-transparent via-amber-400 to-transparent"></div>
  </div>

  <div class="grid grid-cols-2 gap-4 sm:grid-cols-3 lg:grid-cols-6 lg:gap-5">
    {
      providers.map((game) => (
        <a
          href="/register"
          class={`group relative flex flex-col items-center justify-center overflow-hidden rounded-2xl border border-amber-400/25 bg-gradient-to-b ${game.color} p-5 shadow-lg backdrop-blur-md transition-all duration-300 hover:-translate-y-2 hover:border-amber-300 hover:shadow-[0_10px_30px_rgba(212,162,74,0.45)]`}>
          <div class="pointer-events-none absolute inset-0 bg-white/5 opacity-0 transition-opacity duration-300 group-hover:opacity-100" />

          <div class="absolute top-2 right-2 z-10 rounded-full bg-gradient-to-r from-[#f7e3bd] to-[#b8823a] px-2 py-0.5 text-[9px] font-black tracking-wide whitespace-nowrap text-[#1a1130] shadow-sm transition-transform duration-300 group-hover:scale-110">
            {game.tag}
          </div>

          <div class="mb-3 text-4xl drop-shadow-[0_0_15px_rgba(255,255,255,0.3)] transition-transform duration-300 group-hover:scale-125 group-hover:rotate-3">{game.icon}</div>
          <p class="text-center text-sm font-black text-white transition-colors group-hover:text-amber-200">{game.name}</p>
          <p class="mt-1 text-center text-[10px] text-amber-100/70 group-hover:text-white">{game.desc}</p>

          {/* ทั้งการ์ดเป็นลิงก์แล้ว ตัวนี้จึงเป็น span ไม่ใช่ <a> — <a> ซ้อน <a> เป็น HTML ที่ไม่ถูกต้อง
              เบราว์เซอร์จะแยกออกจากกันเอง แล้วครึ่งล่างของการ์ดจะหลุดออกไปกดไม่ได้ */}
          <span class="relative z-10 mt-4 block w-full rounded-full border border-amber-400/30 bg-black/40 py-1.5 text-center text-[11px] font-bold text-amber-200 shadow-inner transition-colors duration-300 group-hover:border-amber-200 group-hover:bg-[#7c3aed] group-hover:text-white">
            เข้าเล่นเกม
          </span>
        </a>
      ))
    }
  </div>
</div>
<style>
  .font-sans {
    font-family: var(--font-sans);
  }
  .font-mono {
    font-family: monospace;
  }
</style>
