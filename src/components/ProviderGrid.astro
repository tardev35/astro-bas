---
const providers = [
  { name: "PG Soft", desc: "แอนิเมชันลื่นไหล กราฟิกสดใส โบนัสแตกไว", tag: "ค่ายเกม", icon: "🎨", color: "from-[#3a1122] to-[#0a0305]" },
  { name: "Pragmatic Play", desc: "แจกรางวัลรัว ฟีเจอร์ทันสมัย ตอบสนองฉับไว", tag: "ค่ายเกม", icon: "⚡", color: "from-[#4c0519] to-[#0a0305]" },
  { name: "JOKER Gaming", desc: "นวัตกรรมคลาสสิก อัปเกรดใหม่ ไหลลื่นทุกอุปกรณ์", tag: "ค่ายเกม", icon: "🃏", color: "from-[#241019] to-[#050203]" },
  { name: "สล็อตออนไลน์รวมค่าย", desc: "ซอฟต์แวร์คุณภาพจากทั่วโลกรวมไว้ในที่เดียว", tag: "สล็อต", icon: "🎰", color: "from-[#3a1122] to-[#050203]" },
  { name: "ทดลองเล่นฟรี", desc: "เรียนรู้ฟีเจอร์เกมล้ำสมัยก่อนใคร ไม่มีค่าใช้จ่าย", tag: "ทดลองเล่น", icon: "🕹️", color: "from-[#881337] to-[#0a0305]" },
  { name: "โปรโมชั่นระบบออโต้", desc: "กดรับสิทธิ์ได้ด้วยตนเอง สะดวกและโปร่งใส", tag: "โปรโมชั่น", icon: "🎁", color: "from-[#4c0519] to-[#1c0b12]" },
];
---

<div class="relative z-10 mx-auto mb-10 w-full max-w-[1400px] px-4 font-sans">
  <div class="mb-8 flex w-full flex-col items-center justify-center gap-2 text-center">
    <p class="bg-gradient-to-r from-white via-pink-100 to-pink-300 bg-clip-text text-3xl font-black tracking-widest text-transparent uppercase drop-shadow-[0_2px_10px_rgba(236,72,153,0.35)]">
      ค่ายเกมชั้นนำและบริการภายใน <span class="text-pink-200">BUNNY555</span>
    </p>
    <div class="mt-2 h-[4px] w-24 rounded-full bg-gradient-to-r from-transparent via-pink-400 to-transparent"></div>
  </div>

  <div class="grid grid-cols-2 gap-4 sm:grid-cols-3 lg:grid-cols-6 lg:gap-5">
    {
      providers.map((game) => (
        <a
          href="/register"
          class={`group relative flex flex-col items-center justify-center overflow-hidden rounded-2xl border border-pink-400/25 bg-gradient-to-b ${game.color} p-5 shadow-lg backdrop-blur-md transition-all duration-300 hover:-translate-y-2 hover:border-pink-300 hover:shadow-[0_10px_30px_rgba(236,72,153,0.45)]`}>
          <div class="pointer-events-none absolute inset-0 bg-white/5 opacity-0 transition-opacity duration-300 group-hover:opacity-100" />

          <div class="absolute top-2 right-2 z-10 rounded-full bg-gradient-to-r from-[#fce7f3] to-[#db2777] px-2 py-0.5 text-[9px] font-black tracking-wide whitespace-nowrap text-[#241019] shadow-sm transition-transform duration-300 group-hover:scale-110">
            {game.tag}
          </div>

          <div class="mb-3 text-4xl drop-shadow-[0_0_15px_rgba(255,255,255,0.3)] transition-transform duration-300 group-hover:scale-125 group-hover:rotate-3">{game.icon}</div>
          <p class="text-center text-sm font-black text-white transition-colors group-hover:text-pink-200">{game.name}</p>
          <p class="mt-1 text-center text-[10px] text-pink-100/70 group-hover:text-white">{game.desc}</p>

          {/* ทั้งการ์ดเป็นลิงก์แล้ว ตัวนี้จึงเป็น span ไม่ใช่ <a> — <a> ซ้อน <a> เป็น HTML ที่ไม่ถูกต้อง
              เบราว์เซอร์จะแยกออกจากกันเอง แล้วครึ่งล่างของการ์ดจะหลุดออกไปกดไม่ได้ */}
          <span class="relative z-10 mt-4 block w-full rounded-full border border-pink-400/30 bg-black/40 py-1.5 text-center text-[11px] font-bold text-pink-200 shadow-inner transition-colors duration-300 group-hover:border-pink-200 group-hover:bg-[#be185d] group-hover:text-white">
            เข้าเล่นเกม
          </span>
        </a>
      ))
    }
  </div>
</div>
<style>
  .font-sans {
    font-family: var(--font-sans);
  }
  .font-mono {
    font-family: monospace;
  }
</style>
