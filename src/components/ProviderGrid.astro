---
// The first three tiles are the camps the docx names by hand, in the same order
// it lists them, so the grid and the prose above it cannot disagree. The rest
// are this brand's four system claims. There is no logo artwork for these camps
// in src/assets/providers/ (that folder holds six camp illustrations used by
// GameRankingBoard), so the tiles stay icon-led.
const providers = [
  { name: "Play'n GO", desc: "เนื้อเรื่องน่าติดตาม กลไกการจ่ายเงินหลากหลาย", tag: "โบนัสแตกหนัก", icon: "🧭" },
  { name: "Red Tiger", desc: "แอนิเมชันลื่นไหล แจ็กพอตแตกง่ายและแตกบ่อย", tag: "ตัวคูณสุดคุ้ม", icon: "🐯" },
  { name: "Blueprint Gaming", desc: "กลไก Megaways เส้นทางการจ่ายเงินมหาศาล", tag: "กำไรทวีคูณ", icon: "⚙️" },
  { name: "คัดสรรมาตรฐานสากล", desc: "ทุกซอฟต์แวร์โปร่งใส ยุติธรรม อัตราการจ่ายแม่นยำ", tag: "ลิขสิทธิ์แท้", icon: "🌐" },
  { name: "อินเทอร์เฟซใช้งานง่าย", desc: "ลดความซับซ้อนในทุกขั้นตอนของการเดิมพัน", tag: "เล่นง่าย", icon: "🖱️" },
  { name: "ระบบออโต้ด้วย AI", desc: "ฝากถอนอัปเดตเข้าบัญชีในเสี้ยววินาที", tag: "ได้เงินไว", icon: "⚡" },
  { name: "ทีมงานสแตนด์บาย", desc: "แก้ไขปัญหาและให้คำปรึกษาได้ตลอดเวลา", tag: "บริการ 24 ชม.", icon: "🎧" },
];
---

<section aria-label="ค่ายเกมชั้นนำและระบบที่ BUNNY555 รวบรวมไว้ในเว็บเดียว" class="relative z-10 mx-auto mb-10 w-full max-w-[1400px] px-4 font-sans">
  <div class="mb-8 flex w-full flex-col items-center justify-center gap-2 text-center">
    <p class="bg-gradient-to-r from-[#ffc2da] via-[#ff4d9d] to-[#ffcf5c] bg-clip-text text-3xl font-black tracking-widest text-transparent uppercase">
      ค่ายเกมชั้นนำและระบบที่ <span class="text-[#ff4d9d]">BUNNY555</span> รวบรวมไว้ในเว็บเดียว
    </p>
    <div class="mt-2 h-[4px] w-24 rounded-full bg-gradient-to-r from-transparent via-[#ff4d9d] to-transparent"></div>
  </div>

  <div class="grid grid-cols-2 gap-4 sm:grid-cols-3 lg:grid-cols-4 lg:gap-5 xl:grid-cols-7">
    {
      providers.map((provider) => (
        <a
          href="/register"
          class="group relative flex flex-col items-center justify-center overflow-hidden rounded-2xl border border-[#ff4d9d]/25 bg-[#26050f]/92 p-5 shadow-[0_10px_30px_rgba(255,77,157,0.18)] backdrop-blur-md transition-all duration-300 hover:-translate-y-2 hover:border-[#ff4d9d]/50 hover:bg-[#3a0818]/95 hover:shadow-[0_15px_40px_rgba(240,46,127,0.32)]">
          <div class="pointer-events-none absolute inset-0 bg-[#f02e7f]/12 opacity-0 transition-opacity duration-300 group-hover:opacity-100" />

          <div class="absolute top-2 right-2 z-10 rounded-full bg-gradient-to-r from-[#ffc2da] via-[#ff4d9d] to-[#a3134f] px-2 py-0.5 text-[9px] font-black tracking-wide whitespace-nowrap text-[#26050f] shadow-sm transition-transform duration-300 group-hover:scale-110">
            {provider.tag}
          </div>

          <div aria-hidden="true" class="mb-3 text-4xl transition-transform duration-300 group-hover:scale-125 group-hover:rotate-3">
            {provider.icon}
          </div>
          <p class="text-center text-sm font-black text-[#ffdcea] transition-colors group-hover:text-[#ffc2da]">{provider.name}</p>
          <p class="mt-1 text-center text-[10px] text-[#e0a5bd]">{provider.desc}</p>

          <span class="relative z-10 mt-4 block w-full rounded-full border border-[#ff4d9d]/25 bg-[#150207] py-1.5 text-center text-[11px] font-bold text-[#ff4d9d] shadow-inner transition-colors duration-300 group-hover:border-[#ff4d9d]/50 group-hover:bg-gradient-to-r group-hover:from-[#ffc2da] group-hover:via-[#ff4d9d] group-hover:to-[#a3134f] group-hover:text-[#26050f]">
            เข้าดูเกม
          </span>
        </a>
      ))
    }
  </div>
</section>
