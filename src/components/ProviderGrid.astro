---
const providers = [
  { name: "PG Soft", desc: "3D แอนิเมชันสวยงาม ฟีเจอร์แจกรางวัลต่อเนื่อง กอบโกยได้ไว", tag: "โบนัสแตกไว", icon: "🐉" },
  { name: "Pragmatic Play", desc: "กลไกออกรางวัลโปร่งใสและหนักหน่วง เข้าถึงรอบแจ็กพอตได้ไว", tag: "แจกรางวัลรัว", icon: "⚡" },
  { name: "JILI", desc: "ตัวเกมเบาและเสถียร เข้าใช้งานสมูทบนสมาร์ทโฟนทุกรุ่น", tag: "ทำกำไรง่าย", icon: "👑" },
  { name: "สถาปัตยกรรมการเงิน AI", desc: "ประมวลผลเครดิตอัตโนมัติ อัปเดตเข้ากระเป๋าอย่างแม่นยำ", tag: "ออโต้ไว 3 วิ", icon: "🤖" },
  { name: "กระเป๋าเงินดิจิทัล", desc: "โอนถ่ายเครดิตได้ทุกที่ทุกเวลา ลดขั้นตอนที่ซับซ้อน", tag: "รองรับทรูวอเลท", icon: "👛" },
  { name: "ทำธุรกรรมเต็มยอด", desc: "ให้บริการฟรีทุกการเชื่อมต่อ ไม่มีการหักค่าธรรมเนียมใดๆ", tag: "ไม่มีค่าธรรมเนียม", icon: "💸" },
  { name: "Premium Secure Popup", desc: "เข้ารหัสขั้นสูง ป้องกันหน้าเว็บโหลดซ้ำ ข้อมูลไม่รั่วไหล", tag: "ปลอดภัย 100%", icon: "🛡️" },
];
---

<section aria-label="ค่ายเกมระดับโลกและระบบที่ DEVA555 รวบรวมไว้ในเว็บเดียว" class="relative z-10 mx-auto mb-10 w-full max-w-[1400px] px-4 font-sans">
  <div class="mb-8 flex w-full flex-col items-center justify-center gap-2 text-center">
    <p class="bg-gradient-to-r from-[#fded9a] via-[#dfb85f] to-[#dfe4e7] bg-clip-text text-3xl font-black tracking-widest text-transparent uppercase">
      ค่ายเกมระดับโลกและระบบที่ <span class="text-[#dfe4e7]">DEVA555</span> รวบรวมไว้ในเว็บเดียว
    </p>
    <div class="mt-2 h-[4px] w-24 rounded-full bg-gradient-to-r from-transparent via-[#dfb85f] to-transparent"></div>
  </div>

  <div class="grid grid-cols-2 gap-4 sm:grid-cols-3 lg:grid-cols-4 lg:gap-5 xl:grid-cols-7">
    {
      providers.map((provider) => (
        <a
          href="/register"
          class="group relative flex flex-col items-center justify-center overflow-hidden rounded-2xl border border-[#dfb85f]/25 bg-[#140d04]/92 p-5 shadow-[0_10px_30px_rgba(223,184,95,0.18)] backdrop-blur-md transition-all duration-300 hover:-translate-y-2 hover:border-[#dfb85f]/50 hover:bg-[#1e1408]/95 hover:shadow-[0_15px_40px_rgba(223,184,95,0.3)]">
          <div class="pointer-events-none absolute inset-0 bg-[#dfb85f]/10 opacity-0 transition-opacity duration-300 group-hover:opacity-100" />

          <div class="absolute top-2 right-2 z-10 rounded-full bg-gradient-to-r from-[#fded9a] via-[#dfb85f] to-[#a57a32] px-2 py-0.5 text-[9px] font-black tracking-wide whitespace-nowrap text-[#140d04] shadow-sm transition-transform duration-300 group-hover:scale-110">
            {provider.tag}
          </div>

          <div aria-hidden="true" class="mb-3 text-4xl transition-transform duration-300 group-hover:scale-125 group-hover:rotate-3">
            {provider.icon}
          </div>
          <p class="text-center text-sm font-black text-[#e9ddbe] transition-colors group-hover:text-[#fded9a]">{provider.name}</p>
          <p class="mt-1 text-center text-[10px] text-[#b6a582]">{provider.desc}</p>

          <span class="relative z-10 mt-4 block w-full rounded-full border border-[#dfb85f]/25 bg-[#070502] py-1.5 text-center text-[11px] font-bold text-[#dfb85f] shadow-inner transition-colors duration-300 group-hover:border-[#dfb85f]/50 group-hover:bg-gradient-to-r group-hover:from-[#fded9a] group-hover:via-[#dfb85f] group-hover:to-[#a57a32] group-hover:text-[#140d04]">
            เข้าดูเกม
          </span>
        </a>
      ))
    }
  </div>
</section>
