---
const providers = [
  { name: "แทงบอล / กีฬา", desc: "รองรับการแข่งขันและตลาดเดิมพันหลากหลาย", tag: "กีฬา", icon: "⚽", color: "from-red-700 to-[#140202]" },
  { name: "คาสิโนสด", desc: "ถ่ายทอดสดพร้อมดีลเลอร์จริงตามรอบของแต่ละโต๊ะ", tag: "คาสิโนสด", icon: "🃏", color: "from-red-600 to-[#240404]" },
  { name: "สล็อตออนไลน์", desc: "เชื่อมต่อเกมสล็อตจากหลายผู้ให้บริการ", tag: "สล็อต", icon: "🎰", color: "from-rose-700 to-[#100202]" },
  { name: "หวยออนไลน์", desc: "เปิดรับตามรอบเวลาของแต่ละตลาด", tag: "หวย", icon: "🔢", color: "from-red-800 to-[#0a0101]" },
  { name: "บาคาร่า", desc: "หมวดบาคาร่าภายในบัญชีเดียวกัน", tag: "บาคาร่า", icon: "♠️", color: "from-red-700 to-[#240404]" },
  { name: "รูเล็ต และไฮโล", desc: "เกมยอดนิยมอื่นในส่วนคาสิโนสด", tag: "รวมทุกหมวด", icon: "🎲", color: "from-rose-600 to-[#140202]" },
];
---

<div class="relative z-10 mx-auto mb-10 w-full max-w-[1400px] px-4 font-sans">
  <div class="mb-8 flex w-full flex-col items-center justify-center gap-2 text-center">
    <p class="bg-gradient-to-r from-white via-red-200 to-red-400 bg-clip-text text-3xl font-black tracking-widest text-transparent uppercase drop-shadow-[0_2px_10px_rgba(220,38,38,0.35)]">
      หมวดเดิมพันและค่ายเกมภายใน <span class="text-red-300">UFAYES</span>
    </p>
    <div class="mt-2 h-[4px] w-24 rounded-full bg-gradient-to-r from-transparent via-red-500 to-transparent"></div>
  </div>

  <div class="grid grid-cols-2 gap-4 sm:grid-cols-3 lg:grid-cols-6 lg:gap-5">
    {
      providers.map((game) => (
        <div
          class={`group relative flex cursor-pointer flex-col items-center justify-center overflow-hidden rounded-2xl border border-red-500/25 bg-gradient-to-b ${game.color} p-5 shadow-lg backdrop-blur-md transition-all duration-300 hover:-translate-y-2 hover:border-red-400 hover:shadow-[0_10px_30px_rgba(220,38,38,0.45)]`}>
          <div class="absolute inset-0 bg-white/5 opacity-0 transition-opacity duration-300 group-hover:opacity-100" />

          <div class="absolute top-2 right-2 z-10 rounded-full bg-gradient-to-r from-red-400 to-red-600 px-2 py-0.5 text-[9px] font-black tracking-wide whitespace-nowrap text-white shadow-sm transition-transform duration-300 group-hover:scale-110">
            {game.tag}
          </div>

          <div class="mb-3 text-4xl drop-shadow-[0_0_15px_rgba(255,255,255,0.3)] transition-transform duration-300 group-hover:scale-125 group-hover:rotate-3">{game.icon}</div>
          <p class="text-center text-sm font-black text-white transition-colors group-hover:text-red-300">{game.name}</p>
          <p class="mt-1 text-center text-[10px] text-red-100/70 group-hover:text-white">{game.desc}</p>

          <a
            href="/login"
            class="mt-4 block w-full rounded-full border border-red-500/30 bg-black/40 py-1.5 text-center text-[11px] font-bold text-red-300 shadow-inner transition-colors duration-300 group-hover:border-red-300 group-hover:bg-red-600 group-hover:text-white">
            เข้าเล่นเกม
          </a>
        </div>
      ))
    }
  </div>
</div>
<style>
  .font-sans {
    font-family: "Kanit", sans-serif;
  }
  .font-mono {
    font-family: monospace;
  }
</style>
