---
const providers = [
  { name: "PG Soft", desc: "สล็อตฟีเจอร์โบนัสเยอะ เดิมพันขั้นต่ำเริ่มหลักบาท เหมาะกับงบน้อย", tag: "ค่ายยอดนิยม", icon: "🎰" },
  { name: "Joker Gaming", desc: "มีทั้งสล็อตคลาสสิกและวิดีโอสล็อต รูปแบบการจ่ายให้เลือกหลายแบบ", tag: "ค่ายยอดนิยม", icon: "🃏" },
  { name: "Pragmatic Play", desc: "เกมความผันผวนสูง รอบโบนัสมาไม่ถี่แต่จ่ายเป็นก้อน", tag: "ค่ายสากล", icon: "🎲" },
  { name: "ค่ายอื่นในระบบ", desc: "ผู้ให้บริการกลุ่มอื่นที่รวมไว้ในบัญชีเดียว ไม่ต้องสมัครแยก", tag: "รวมหลายค่าย", icon: "🧩" },
  { name: "คาสิโนสด", desc: "บาคาร่า รูเล็ต และเกมโต๊ะ ถ่ายทอดรอบเกมแบบเรียลไทม์", tag: "เกมโต๊ะ", icon: "🎴" },
  { name: "เดิมพันขั้นต่ำ", desc: "เกมงบน้อยอยู่ราว 1–10 บาทต่อรอบ ตรวจซ้ำจากหน้าเกมจริง", tag: "ตรวจก่อนเล่น", icon: "🪙" },
  { name: "ฟีเจอร์โบนัสในเกม", desc: "ฟรีสปิน ตัวคูณ และเงื่อนไขการจ่ายที่ต่างกันในแต่ละเกม", tag: "อ่านกติกา", icon: "🎁" },
];
---

<section aria-label="ค่ายสล็อตและหมวดเกมที่รวมไว้ในบัญชีเดียว" class="relative z-10 mx-auto mb-10 w-full max-w-[1400px] px-4 font-sans">
  <div class="mb-8 flex w-full flex-col items-center justify-center gap-2 text-center">
    <p class="bg-gradient-to-r from-[#ffa6d2] via-[#ff3d9a] to-[#c21a70] bg-clip-text text-3xl font-black tracking-widest text-transparent uppercase">
      ค่ายสล็อตและหมวดเกมที่ <span class="text-[#22d3ee]">ตังค์มา168</span> รวมไว้ในบัญชีเดียว
    </p>
    <div class="mt-2 h-[4px] w-24 rounded-full bg-gradient-to-r from-transparent via-[#ff3d9a] to-transparent"></div>
  </div>

  <div class="grid grid-cols-2 gap-4 sm:grid-cols-3 lg:grid-cols-4 lg:gap-5 xl:grid-cols-7">
    {
      providers.map((provider) => (
        <a
          href="/register"
          class="group relative flex flex-col items-center justify-center overflow-hidden rounded-2xl border border-[#ff3d9a]/25 bg-[#16050f]/92 p-5 shadow-[0_10px_30px_rgba(255,61,154,0.18)] backdrop-blur-md transition-all duration-300 hover:-translate-y-2 hover:border-[#ff3d9a]/50 hover:bg-[#230a19]/95 hover:shadow-[0_15px_40px_rgba(255,61,154,0.3)]">
          <div class="pointer-events-none absolute inset-0 bg-[#ff3d9a]/10 opacity-0 transition-opacity duration-300 group-hover:opacity-100" />

          <div class="absolute top-2 right-2 z-10 rounded-full bg-gradient-to-r from-[#ffa6d2] via-[#ff3d9a] to-[#c21a70] px-2 py-0.5 text-[9px] font-black tracking-wide whitespace-nowrap text-[#16050f] shadow-sm transition-transform duration-300 group-hover:scale-110">
            {provider.tag}
          </div>

          <div aria-hidden="true" class="mb-3 text-4xl transition-transform duration-300 group-hover:scale-125 group-hover:rotate-3">
            {provider.icon}
          </div>
          <p class="text-center text-sm font-black text-[#fdeaf4] transition-colors group-hover:text-[#ffa6d2]">{provider.name}</p>
          <p class="mt-1 text-center text-[10px] text-[#d9a7c4]">{provider.desc}</p>

          <span class="relative z-10 mt-4 block w-full rounded-full border border-[#ff3d9a]/25 bg-[#230a19] py-1.5 text-center text-[11px] font-bold text-[#ff3d9a] shadow-inner transition-colors duration-300 group-hover:border-[#ff3d9a]/50 group-hover:bg-gradient-to-r group-hover:from-[#ffa6d2] group-hover:via-[#ff3d9a] group-hover:to-[#c21a70] group-hover:text-[#16050f]">
            เข้าดูเกม
          </span>
        </a>
      ))
    }
  </div>
</section>
