---
const { title, as: HeadingTag = "h1" } = Astro.props;
const headingSize = HeadingTag === "h1" ? "text-3xl" : "text-2xl";
---

<section class="my-6 flex w-full justify-center px-4 font-sans">
  <div class="w-full max-w-[1400px] rounded-[25px] bg-[#12100a] p-8 text-left text-base leading-relaxed text-amber-50/85 shadow-[10px_10px_20px_#050403,-10px_-10px_20px_#1c1609]">
    {
      title && (
        <header class="mb-8 text-center">
          <HeadingTag class={`bg-gradient-to-r from-white via-amber-100 to-amber-400 bg-clip-text ${headingSize} leading-normal font-black text-transparent drop-shadow-md`}>{title}</HeadingTag>
        </header>
      )
    }
    <slot />
  </div>
</section>
<style>
  .font-sans {
    font-family: var(--font-sans);
  }
</style>
