---
export interface Props {
  title?: string;
  as?: "h1" | "h2" | "h3" | "h4" | "h5" | "h6";
}
const { title, as: HeadingTag = "h1" } = Astro.props;
const headingSize = HeadingTag === "h1" ? "text-3xl" : "text-2xl";

// text-center lives on the <header>, never on the card or the <section>: an
// ancestor's centering inherits straight into the slot and centers the body
// paragraph too, which is the bug this file shipped before 2026-07-26.
//
// The neumorphic pair is derived from this brand's card surface (#0d2606):
// the dark side (#050f02) is a shade below it and the light side (#153a09) is
// the raised panel colour, so the extrusion reads on the deep forest-green
// background instead of the previous brand's maroon one.
---

<section class="relative z-10 my-6 flex w-full justify-center px-4 font-sans">
  <div
    class="w-full max-w-[1400px] rounded-[25px] border border-[#7bbb0b]/25 bg-[#0d2606] p-8 text-left text-base leading-relaxed text-[#dcefc2] shadow-[10px_10px_20px_#050f02,-10px_-10px_20px_#153a09]">
    {
      title && (
        <header class="mb-8 border-b border-[#7bbb0b]/25 pb-4 text-center">
          <HeadingTag class={`bg-gradient-to-r from-[#a8e81c] via-[#7bbb0b] to-[#f5c518] bg-clip-text ${headingSize} leading-normal font-black tracking-wide text-transparent`}>{title}</HeadingTag>
        </header>
      )
    }
    <slot />
  </div>
</section>
