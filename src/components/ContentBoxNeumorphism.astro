---
export interface Props {
  title?: string;
  as?: "h1" | "h2" | "h3" | "h4" | "h5" | "h6";
}
const { title, as: HeadingTag = "h1" } = Astro.props;
const headingSize = HeadingTag === "h1" ? "text-3xl" : "text-2xl";

// text-center lives on the <header>, never on the card or the <section>: an
// ancestor's centering inherits straight into the slot and centers the body
// paragraph too, which is the bug this file shipped before 2026-07-26.
//
// The neumorphic pair is derived from this brand's card surface (#160a2b):
// the dark side (#0b0518) is a shade below it and the light side (#22103f) is
// the raised panel colour, so the extrusion reads on PHANTOM569's near-black
// violet background instead of the previous brand's forest-green one.
---

<section class="relative z-10 my-6 flex w-full justify-center px-4 font-sans">
  <div
    class="w-full max-w-[1400px] rounded-[25px] border border-[#8b3fe0]/25 bg-[#160a2b] p-8 text-left text-base leading-relaxed text-[#e4dcf7] shadow-[10px_10px_20px_#0b0518,-10px_-10px_20px_#22103f]">
    {
      title && (
        <header class="mb-8 border-b border-[#8b3fe0]/25 pb-4 text-center">
          <HeadingTag class={`bg-gradient-to-r from-[#b662ff] via-[#8b3fe0] to-[#c084fc] bg-clip-text ${headingSize} leading-normal font-black tracking-wide text-transparent`}>{title}</HeadingTag>
        </header>
      )
    }
    <slot />
  </div>
</section>
