---
const { title, as: HeadingTag = "h1" } = Astro.props;
const headingSize = HeadingTag === "h1" ? "text-3xl" : "text-2xl";
---

<section class="my-6 flex w-full justify-center px-4 font-sans">
  <div class="w-full max-w-[1400px] rounded-[25px] bg-[#140202] p-8 text-left text-base leading-relaxed text-red-100/75 shadow-[10px_10px_20px_#080101,-10px_-10px_20px_#240404]">
    {
      title && (
        <header class="mb-8 text-center">
          <HeadingTag class={`bg-gradient-to-r from-white via-red-100 to-red-400 bg-clip-text ${headingSize} leading-normal font-black text-transparent drop-shadow-md`}>{title}</HeadingTag>
        </header>
      )
    }
    <slot />
  </div>
</section>
<style>
  .font-sans {
    font-family: var(--font-sans);
  }
</style>
