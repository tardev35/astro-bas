---
// No leading emoji in this string: the marquee renders `message` twice, and an
// emoji baked into a text prop cannot be wrapped in aria-hidden — a screen
// reader would read it out on every repeat. The decorative 🔔 below is markup,
// so it can be (and is) hidden properly.
const {
  message = "BUNNY555 เว็บสล็อตลิขสิทธิ์แท้ 100% รวมค่ายดังระดับโลก Play'n GO Red Tiger Blueprint Gaming ฝาก-ถอนออโต้ด้วยระบบ AI ได้เงินไว ในเสี้ยววินาที คืนยอดเสีย 15% ทุกสัปดาห์ ฝากแรกลุ้นรับทองคำ 1 บาท พร้อมทีมงานดูแล บริการ 24 ชม. ไม่มีวันหยุด",
} = Astro.props;
---

<div class="mx-auto w-full max-w-7xl px-4 py-3 font-sans">
  <div class="relative overflow-hidden rounded-md border border-[#ff4d9d]/45 bg-[#26050f] shadow-[0_0_15px_rgba(255,77,157,0.18)]">
    <div class="absolute top-0 -left-4 h-full w-8 -skew-x-12 bg-gradient-to-b from-[#f02e7f] to-[#a3134f]"></div>
    <div class="absolute top-0 -right-4 h-full w-8 -skew-x-12 bg-[#ffc2da]/20"></div>

    <div class="flex items-center">
      <div class="relative z-10 flex w-12 shrink-0 items-center justify-center bg-gradient-to-b from-[#f02e7f] to-[#a3134f] py-2.5">
        <span aria-hidden="true" class="animate-pulse text-lg drop-shadow-[0_0_5px_rgba(255,240,246,0.85)]">🔔</span>
      </div>

      <div class="marquee-container relative flex-1 overflow-hidden py-2.5 pr-6">
        <div class="pointer-events-none absolute top-0 left-0 z-10 h-full w-8 bg-gradient-to-r from-[#26050f] to-transparent"></div>
        <div class="pointer-events-none absolute top-0 right-0 z-10 h-full w-12 bg-gradient-to-l from-[#26050f] to-transparent"></div>

        <div class="marquee-content inline-block pl-4 text-sm font-bold tracking-wide whitespace-nowrap text-[#ffc2da]">
          <span class="mr-8 inline-flex items-center gap-2"><span class="h-1.5 w-1.5 rounded-full bg-[#fff0f6] shadow-[0_0_5px_rgba(255,240,246,0.85)]"></span>{message}</span>
          <span class="mr-8 inline-flex items-center gap-2"><span class="h-1.5 w-1.5 rounded-full bg-[#fff0f6] shadow-[0_0_5px_rgba(255,240,246,0.85)]"></span>{message}</span>
        </div>
      </div>
    </div>
  </div>
</div>

<style>
  /* No `.font-sans { font-family: var(--font-sans) }` rule here: Tailwind
     already generates that exact rule from the theme variable, so it was dead
     CSS shipped on every page this ticker appears on. */
  .marquee-content {
    animation: marquee 25s linear infinite;
  }
  .marquee-container:hover .marquee-content {
    animation-play-state: paused;
  }
  @keyframes marquee {
    0% {
      transform: translateX(0);
    }
    100% {
      transform: translateX(-50%);
    }
  }
</style>
