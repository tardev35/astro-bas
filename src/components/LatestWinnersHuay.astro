---
import kbankLogo from "../assets/banks/kbank.png";
import scbLogo from "../assets/banks/scb.png";
import krungsriLogo from "../assets/banks/krungsri.png";
import ktbLogo from "../assets/banks/ktb.png";

const bankPool = [
  { name: "KBank", color: "bg-[#1155cc]", icon: kbankLogo.src },
  { name: "SCB", color: "bg-[#4e1c80]", icon: scbLogo.src },
  { name: "Krungsri", color: "bg-[#fcd34d]", icon: krungsriLogo.src },
  { name: "KTB", color: "bg-[#0ea5e9]", icon: ktbLogo.src },
];

const marketPool = [
  { name: "หวยรัฐบาลไทย", type: "3 ตัวบน" },
  { name: "หวยฮานอย", type: "2 ตัวล่าง" },
  { name: "หวยลาวพัฒนา", type: "3 ตัวโต๊ด" },
  { name: "หวยยี่กี", type: "2 ตัวบน" },
  { name: "หวยหุ้นไทย", type: "3 ตัวบน" },
  { name: "หวยมาเลย์", type: "2 ตัวล่าง" },
];
---

<div class="relative z-10 mx-auto mb-10 w-full max-w-[1400px] px-4 font-sans">
  <div class="relative rounded-3xl border border-amber-500/30 bg-[#5f0914]/60 px-4 py-8 shadow-[0_10px_30px_rgba(0,0,0,0.5)] backdrop-blur-xl md:p-8">
    <div class="relative z-10 mb-6 flex items-center justify-between border-b border-amber-500/30 pb-4">
      <div class="flex items-center gap-3">
        <span aria-hidden="true" class="text-2xl drop-shadow-[0_0_8px_rgba(251,191,36,0.8)]">🎉</span>
        <h2 class="text-xl leading-normal font-black tracking-widest text-white drop-shadow-sm">รายการถูกรางวัลล่าสุด</h2>
      </div>
      <span class="animate-pulse rounded-full border border-green-400/50 bg-green-900/40 px-3 py-1 text-[10px] font-bold tracking-widest text-green-400 shadow-[0_0_10px_rgba(74,222,128,0.2)]">
        REAL-TIME
      </span>
    </div>

    <div id="lotto-winner-feed" class="relative z-10 flex flex-col gap-3"></div>
  </div>
</div>

<script define:vars={{ bankPool, marketPool }}>
  const feed = document.getElementById("lotto-winner-feed");
  const getRandomStr = (len, chars) =>
    Array.from({ length: len })
      .map(() => chars.charAt(Math.floor(Math.random() * chars.length)))
      .join("");
  const getAmount = () => (Math.floor(Math.random() * (150000 - 5000 + 1)) + 5000).toLocaleString("en-US");

  const createHTML = () => {
    const bank = bankPool[Math.floor(Math.random() * bankPool.length)];
    const market = marketPool[Math.floor(Math.random() * marketPool.length)];
    const user = `0${getRandomStr(1, "89")}***${getRandomStr(4, "0123456789")}`;
    const isPending = Math.random() > 0.7;

    const statusClass = isPending ? "text-amber-300 animate-pulse" : "text-green-400";
    const statusText = isPending ? "กำลังตรวจโพย" : "โอนเงินรางวัลแล้ว";

    return `
      <div class="winner-row origin-bottom transform translate-y-4 opacity-0 transition-all duration-500 ease-out">
        <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-4 rounded-xl border border-amber-500/10 bg-black/30 p-4 shadow-sm backdrop-blur-sm transition-all duration-300 hover:border-amber-400/40 hover:bg-black/50">
          <div class="flex items-center gap-4">
            <div class="flex h-10 w-10 shrink-0 items-center justify-center rounded-full border border-white/10 ${bank.color} shadow-inner">
              <img src="${bank.icon}" alt="ธนาคารที่รับเงินรางวัลหวยออนไลน์" class="h-6 w-6 object-contain grayscale" />
            </div>
            <div class="flex flex-col">
              <span class="text-[10px] font-medium tracking-widest text-white/60">เบอร์สมาชิก</span>
              <span class="font-mono text-sm font-bold text-white">${user}</span>
              <span class="text-[10px] tracking-wide text-amber-100/70">${market.name} · ${market.type}</span>
            </div>
          </div>
          <div class="flex items-center justify-between sm:justify-end gap-6 border-t border-amber-500/25 pt-3 sm:border-none sm:pt-0">
            <div class="text-[11px] font-medium tracking-wider ${statusClass}">${statusText}</div>
            <div class="font-sans text-xl font-black text-amber-300 drop-shadow-[0_2px_5px_rgba(251,191,36,0.35)]">
              ${getAmount()} <span class="text-xs font-bold text-amber-500">บาท</span>
            </div>
          </div>
        </div>
      </div>
    `;
  };

  const trigger = () => {
    const tempDiv = document.createElement("div");
    tempDiv.innerHTML = createHTML();
    const newEl = tempDiv.firstElementChild;
    feed.prepend(newEl);
    setTimeout(() => {
      newEl.classList.remove("translate-y-4", "opacity-0");
      newEl.classList.add("translate-y-0", "opacity-100");
    }, 50);
    if (feed.children.length > 5) {
      const last = feed.lastElementChild;
      last.classList.remove("translate-y-0", "opacity-100");
      last.classList.add("-translate-y-4", "opacity-0");
      setTimeout(() => last.remove(), 500);
    }
  };
  for (let i = 0; i < 5; i++) {
    trigger();
  }
  setInterval(trigger, 3000);
</script>
<style>
  .font-sans {
    font-family: var(--font-sans);
  }
  .font-mono {
    font-family: monospace;
  }
</style>
