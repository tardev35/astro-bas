---
export interface Props {
  title?: string;
  as?: "h1" | "h2" | "h3" | "h4" | "h5" | "h6";
}
const { title, as: HeadingTag = "h1" } = Astro.props;
const headingSize = HeadingTag === "h1" ? "text-3xl" : "text-2xl";

// The heading gradient runs silver -> gold on purpose: the wordmark reads "TT1"
// in chrome and "BET" in gold, so the page title echoes the logo instead of
// being a flat single hue.
---

<section class="relative z-10 my-8 flex w-full justify-center px-4 font-sans">
  <div
    class="group relative isolate w-full max-w-[1400px] overflow-hidden rounded-3xl border border-[#f3c43c]/30 bg-gradient-to-br from-[#241a08]/92 to-[#0a0704]/90 p-8 text-left text-base leading-relaxed text-[#f0e6cc] shadow-[0_10px_30px_rgba(243,196,60,0.16)] backdrop-blur-xl transition-all duration-500 hover:border-[#f3c43c]/60 hover:shadow-[0_15px_40px_rgba(243,196,60,0.3)] md:p-10">
    <div class="pointer-events-none absolute -top-20 -left-20 -z-10 h-40 w-40 rounded-full bg-[#f3c43c]/22 blur-[55px] transition-all duration-500 group-hover:bg-[#fcf6ab]/32"></div>
    <div class="pointer-events-none absolute -right-20 -bottom-20 -z-10 h-40 w-40 rounded-full bg-[#a8790f]/30 blur-[55px] transition-all duration-500 group-hover:bg-[#d4b433]/35"></div>

    {
      title && (
        <header class="mb-8 flex items-center gap-4 border-b border-[#f3c43c]/30 pb-4">
          <div class="h-8 w-1.5 shrink-0 rounded-full bg-gradient-to-b from-[#dfe4e7] via-[#fcf6ab] to-[#a8790f] shadow-[0_0_10px_rgba(243,196,60,0.5)]" />
          <HeadingTag
            class={`bg-gradient-to-r from-[#dfe4e7] via-[#fcf6ab] to-[#f3c43c] bg-clip-text ${headingSize} leading-normal font-black tracking-widest text-transparent uppercase`}>
            {title}
          </HeadingTag>
        </header>
      )
    }
    <slot />
  </div>
</section>
