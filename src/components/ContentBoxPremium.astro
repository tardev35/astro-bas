---
export interface Props {
  title?: string;
  as?: "h1" | "h2" | "h3" | "h4" | "h5" | "h6";
}
const { title, as: HeadingTag = "h1" } = Astro.props;
const headingSize = HeadingTag === "h1" ? "text-3xl" : "text-2xl";
---

<section class="relative z-10 my-8 flex w-full justify-center px-4 font-sans">
  <div
    class="group relative isolate w-full max-w-[1400px] overflow-hidden rounded-3xl border border-[#dfb85f]/30 bg-gradient-to-br from-[#1e1408]/92 to-[#140d04]/88 p-8 text-left text-base leading-relaxed text-[#e9ddbe] shadow-[0_10px_30px_rgba(223,184,95,0.16)] backdrop-blur-xl transition-all duration-500 hover:border-[#dfb85f]/60 hover:shadow-[0_15px_40px_rgba(223,184,95,0.28)] md:p-10">
    <div class="pointer-events-none absolute -top-20 -left-20 -z-10 h-40 w-40 rounded-full bg-[#dfb85f]/20 blur-[55px] transition-all duration-500 group-hover:bg-[#fded9a]/30"></div>
    <div class="pointer-events-none absolute -right-20 -bottom-20 -z-10 h-40 w-40 rounded-full bg-[#a57a32]/25 blur-[55px] transition-all duration-500 group-hover:bg-[#dfb85f]/30"></div>

    {
      title && (
        <header class="mb-8 flex items-center gap-4 border-b border-[#dfb85f]/30 pb-4">
          <div class="h-8 w-1.5 shrink-0 rounded-full bg-gradient-to-b from-[#fded9a] via-[#dfb85f] to-[#a57a32] shadow-[0_0_10px_rgba(223,184,95,0.45)]" />
          <HeadingTag
            class={`bg-gradient-to-r from-[#fded9a] via-[#dfb85f] to-[#a57a32] bg-clip-text ${headingSize} leading-normal font-black tracking-widest text-transparent uppercase`}>
            {title}
          </HeadingTag>
        </header>
      )
    }
    <slot />
  </div>
</section>
