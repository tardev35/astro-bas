---
export interface Props {
  title?: string;
  as?: "h1" | "h2" | "h3" | "h4" | "h5" | "h6";
}
const { title, as: HeadingTag = "h1" } = Astro.props;
const headingSize = HeadingTag === "h1" ? "text-3xl" : "text-2xl";
---

<section class="relative z-10 my-8 flex w-full justify-center px-4 font-sans">
  <div
    class="group relative isolate w-full max-w-[1400px] overflow-hidden rounded-3xl border border-[#faad23]/30 bg-gradient-to-br from-[#3d0410]/92 to-[#1a0106]/90 p-8 text-left text-base leading-relaxed text-[#ffe9c4] shadow-[0_10px_30px_rgba(250,173,35,0.16)] backdrop-blur-xl transition-all duration-500 hover:border-[#faad23]/60 hover:shadow-[0_15px_40px_rgba(250,173,35,0.3)] md:p-10">
    <div class="pointer-events-none absolute -top-20 -left-20 -z-10 h-40 w-40 rounded-full bg-[#faad23]/22 blur-[55px] transition-all duration-500 group-hover:bg-[#ffd84d]/32"></div>
    <div class="pointer-events-none absolute -right-20 -bottom-20 -z-10 h-40 w-40 rounded-full bg-[#e01b5d]/30 blur-[55px] transition-all duration-500 group-hover:bg-[#ff3d8a]/35"></div>

    {
      title && (
        <header class="mb-8 flex items-center gap-4 border-b border-[#faad23]/30 pb-4">
          <div class="h-8 w-1.5 shrink-0 rounded-full bg-gradient-to-b from-[#ffd84d] via-[#faad23] to-[#ff3d8a] shadow-[0_0_10px_rgba(250,173,35,0.5)]" />
          <HeadingTag
            class={`bg-gradient-to-r from-[#ffd84d] via-[#faad23] to-[#ff3d8a] bg-clip-text ${headingSize} leading-normal font-black tracking-widest text-transparent uppercase`}>
            {title}
          </HeadingTag>
        </header>
      )
    }
    <slot />
  </div>
</section>
