---
export interface Props {
  title?: string;
  as?: "h1" | "h2" | "h3" | "h4" | "h5" | "h6";
}
const { title, as: HeadingTag = "h1" } = Astro.props;
const headingSize = HeadingTag === "h1" ? "text-3xl" : "text-2xl";

// The heading gradient runs pale gold -> deep gold: the wordmark is a single
// gold hue over the joker's wheel, so the page title echoes the logo rather
// than introducing a second colour the artwork never uses.
---

<section class="relative z-10 my-8 flex w-full justify-center px-4 font-sans">
  <div
    class="group relative isolate w-full max-w-[1400px] overflow-hidden rounded-3xl border border-[#d99a1c]/30 bg-gradient-to-br from-[#241505]/92 to-[#120a02]/90 p-8 text-left text-base leading-relaxed text-[#f2e4c4] shadow-[0_10px_30px_rgba(217,154,28,0.16)] backdrop-blur-xl transition-all duration-500 hover:border-[#d99a1c]/60 hover:shadow-[0_15px_40px_rgba(217,154,28,0.3)] md:p-10">
    <div class="pointer-events-none absolute -top-20 -left-20 -z-10 h-40 w-40 rounded-full bg-[#d99a1c]/22 blur-[55px] transition-all duration-500 group-hover:bg-[#fbeab0]/32"></div>
    <div class="pointer-events-none absolute -right-20 -bottom-20 -z-10 h-40 w-40 rounded-full bg-[#a8690a]/30 blur-[55px] transition-all duration-500 group-hover:bg-[#f6cf6a]/35"></div>

    {
      title && (
        <header class="mb-8 flex items-center gap-4 border-b border-[#d99a1c]/30 pb-4">
          <div class="h-8 w-1.5 shrink-0 rounded-full bg-gradient-to-b from-[#fff6e0] via-[#fbeab0] to-[#a8690a] shadow-[0_0_10px_rgba(217,154,28,0.5)]" />
          <HeadingTag
            class={`bg-gradient-to-r from-[#fff6e0] via-[#fbeab0] to-[#d99a1c] bg-clip-text ${headingSize} leading-normal font-black tracking-widest text-transparent uppercase`}>
            {title}
          </HeadingTag>
        </header>
      )
    }
    <slot />
  </div>
</section>
