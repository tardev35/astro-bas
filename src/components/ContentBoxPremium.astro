---
export interface Props {
  title?: string;
  as?: "h1" | "h2" | "h3" | "h4" | "h5" | "h6";
}
const { title, as: HeadingTag = "h1" } = Astro.props;
const headingSize = HeadingTag === "h1" ? "text-3xl" : "text-2xl";
---

<section class="my-8 flex w-full justify-center px-4 font-sans">
  <div
    class="group relative isolate w-full max-w-[1400px] overflow-hidden rounded-3xl border border-amber-500/30 bg-gradient-to-br from-[#12100a]/85 to-[#0b0906]/80 p-8 text-left text-base leading-relaxed text-amber-50/85 shadow-[0_10px_30px_rgba(212,175,90,0.35)] backdrop-blur-xl transition-all duration-500 hover:border-amber-300/60 hover:shadow-[0_15px_40px_rgba(212,175,90,0.5)] md:p-10">
    <div class="pointer-events-none absolute -top-20 -left-20 -z-10 h-40 w-40 rounded-full bg-amber-500/20 blur-[50px] transition-all duration-500 group-hover:bg-amber-400/30"></div>
    <div class="pointer-events-none absolute -right-20 -bottom-20 -z-10 h-40 w-40 rounded-full bg-amber-700/15 blur-[50px] transition-all duration-500 group-hover:bg-amber-600/25"></div>

    {
      title && (
        <header class="mb-8 flex items-center gap-4 border-b border-amber-400/35 pb-4">
          <div class="h-8 w-1.5 rounded-full bg-gradient-to-b from-[#f6e4b4] via-[#e0bd72] to-[#b1873a] shadow-[0_0_10px_rgba(212,175,90,0.5)]" />
          <HeadingTag class={`bg-gradient-to-r from-white via-amber-100 to-amber-400 bg-clip-text ${headingSize} leading-normal font-black tracking-widest text-transparent uppercase drop-shadow-sm`}>
            {title}
          </HeadingTag>
        </header>
      )
    }
    <slot />
  </div>
</section>
<style>
  .font-sans {
    font-family: var(--font-sans);
  }
</style>
