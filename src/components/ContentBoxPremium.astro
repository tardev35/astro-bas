---
export interface Props {
  title?: string;
  as?: "h1" | "h2" | "h3" | "h4" | "h5" | "h6";
}
const { title, as: HeadingTag = "h1" } = Astro.props;
const headingSize = HeadingTag === "h1" ? "text-3xl" : "text-2xl";
---

<section class="relative z-10 my-8 flex w-full justify-center px-4 font-sans">
  <div
    class="group relative isolate w-full max-w-[1400px] overflow-hidden rounded-3xl border border-[#ff3d9a]/30 bg-gradient-to-br from-[#2a0a1d]/92 to-[#12040c]/88 p-8 text-left text-base leading-relaxed text-[#fdeaf4] shadow-[0_10px_30px_rgba(255,61,154,0.16)] backdrop-blur-xl transition-all duration-500 hover:border-[#ff3d9a]/60 hover:shadow-[0_15px_40px_rgba(255,61,154,0.28)] md:p-10">
    <div class="pointer-events-none absolute -top-20 -left-20 -z-10 h-40 w-40 rounded-full bg-[#ff3d9a]/20 blur-[55px] transition-all duration-500 group-hover:bg-[#ffa6d2]/30"></div>
    <div class="pointer-events-none absolute -right-20 -bottom-20 -z-10 h-40 w-40 rounded-full bg-[#4a8f9c]/45 blur-[55px] transition-all duration-500 group-hover:bg-[#22d3ee]/40"></div>

    {
      title && (
        <header class="mb-8 flex items-center gap-4 border-b border-[#ff3d9a]/30 pb-4">
          <div class="h-8 w-1.5 shrink-0 rounded-full bg-gradient-to-b from-[#ffa6d2] via-[#ff3d9a] to-[#c21a70] shadow-[0_0_10px_rgba(255,61,154,0.45)]" />
          <HeadingTag
            class={`bg-gradient-to-r from-[#ffa6d2] via-[#ff3d9a] to-[#c21a70] bg-clip-text ${headingSize} leading-normal font-black tracking-widest text-transparent uppercase`}>
            {title}
          </HeadingTag>
        </header>
      )
    }
    <slot />
  </div>
</section>
