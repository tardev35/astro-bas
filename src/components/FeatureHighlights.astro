---
export interface FeatureItem {
  icon: string;
  title: string;
  description: string;
  accent?: "pink" | "rose";
}

export interface Props {
  items: FeatureItem[];
}

const { items } = Astro.props;
---

<div class="mt-6 flex flex-col gap-5">
  {
    items.map((item) => {
      const isPink = item.accent !== "rose";
      return (
        <div
          class={`group flex flex-col items-start gap-4 rounded-2xl border border-rose-900/40 bg-[#1c0b12]/60 p-6 transition-all duration-300 hover:-translate-y-1 sm:flex-row ${
            isPink
              ? "hover:border-pink-500/50 hover:bg-[#241019] hover:shadow-[0_10px_20px_rgba(236,72,153,0.18)]"
              : "hover:border-rose-500/60 hover:bg-[#241019] hover:shadow-[0_10px_20px_rgba(190,24,93,0.22)]"
          }`}>
          <div
            class={`flex h-14 w-14 shrink-0 items-center justify-center rounded-xl text-3xl transition-transform duration-300 group-hover:scale-110 ${
              isPink
                ? "border border-pink-300/50 bg-gradient-to-br from-pink-400 to-pink-600 shadow-[0_0_15px_rgba(236,72,153,0.5)] group-hover:rotate-3"
                : "border border-rose-500/50 bg-gradient-to-br from-rose-600 to-rose-900 shadow-[0_0_15px_rgba(190,24,93,0.45)]"
            }`}>
            {item.icon}
          </div>
          <div class="flex flex-col gap-2 text-left">
            <h3
              class={`text-xl font-black tracking-wide drop-shadow-sm ${
                isPink
                  ? "bg-gradient-to-r from-pink-200 to-pink-500 bg-clip-text text-transparent"
                  : "bg-gradient-to-r from-rose-200 to-rose-400 bg-clip-text text-transparent transition-colors group-hover:text-rose-300"
              }`}>
              {item.title}
            </h3>
            <p class="text-base leading-relaxed text-pink-50/75 transition-colors group-hover:text-pink-50/95">{item.description}</p>
          </div>
        </div>
      );
    })
  }
</div>
