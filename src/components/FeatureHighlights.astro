---
export interface FeatureItem {
  icon: string;
  title: string;
  description: string;
  accent?: "gold" | "silver";
}

export interface Props {
  items: FeatureItem[];
}

const { items } = Astro.props;

// The <h3> below is the ONLY h3 a docx-driven page is allowed to have: it is
// the sanctioned "short sub-points under one H2 section" shape. Its text comes
// from the caller, never from this file.
//
// The accent union follows the current brand's two colours. This brand's
// primary is gold (#ebdd65 / #f3c43c) and chrome-silver (#dfe4e7) is the
// secondary the wordmark uses for "TT1", so the union is "gold" | "silver" and
// anything that is not explicitly "silver" renders gold.
---

<div class="mt-4 flex flex-col gap-5">
  {
    items.map((item) => {
      const isSilver = item.accent === "silver";
      return (
        <div
          class={`group flex flex-col items-start gap-4 rounded-2xl border border-[#ebdd65]/25 bg-[#0a0704]/70 p-6 transition-all duration-300 hover:-translate-y-1 sm:flex-row ${
            isSilver
              ? "hover:border-[#dfe4e7]/60 hover:bg-[#241a08] hover:shadow-[0_10px_20px_rgba(223,228,231,0.22)]"
              : "hover:border-[#ebdd65]/60 hover:bg-[#241a08] hover:shadow-[0_10px_20px_rgba(235,221,101,0.26)]"
          }`}>
          <div
            aria-hidden="true"
            class={`flex h-14 w-14 shrink-0 items-center justify-center rounded-xl text-3xl transition-transform duration-300 group-hover:scale-110 ${
              isSilver
                ? "border border-[#dfe4e7]/50 bg-gradient-to-br from-[#dfe4e7] to-[#b5bbbc] shadow-[0_0_15px_rgba(223,228,231,0.4)] group-hover:rotate-3"
                : "border border-[#ebdd65]/50 bg-gradient-to-br from-[#fcf6ab] via-[#ebdd65] to-[#a8790f] shadow-[0_0_15px_rgba(235,221,101,0.45)]"
            }`}>
            {item.icon}
          </div>
          <div class="flex flex-col gap-2 text-left">
            <h3
              class={`text-xl leading-normal font-black tracking-wide drop-shadow-sm ${
                isSilver ? "bg-gradient-to-r from-[#dfe4e7] to-[#b5bbbc] bg-clip-text text-transparent" : "bg-gradient-to-r from-[#fcf6ab] to-[#d4b433] bg-clip-text text-transparent"
              }`}>
              {item.title}
            </h3>
            <p class="text-left text-base leading-relaxed text-[#c9bb96] transition-colors group-hover:text-[#f0e6cc]">{item.description}</p>
          </div>
        </div>
      );
    })
  }
</div>
