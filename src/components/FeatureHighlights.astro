---
export interface FeatureItem {
  icon: string;
  title: string;
  description: string;
  accent?: "pink" | "gold";
}

export interface Props {
  items: FeatureItem[];
}

const { items } = Astro.props;

// The <h3> below is the ONLY h3 a docx-driven page is allowed to have: it is
// the sanctioned "short sub-points under one H2 section" shape. Its text comes
// from the caller, never from this file.
//
// The accent union was "gold" | "magenta" for the previous brand, whose primary
// hue was gold. This brand's primary is pink (#ff4d9d) and gold (#ffcf5c) is
// the secondary that echoes the coins in the artwork, so the union is
// "pink" | "gold" and anything that is not explicitly "gold" renders pink.
---

<div class="mt-4 flex flex-col gap-5">
  {
    items.map((item) => {
      const isGold = item.accent === "gold";
      return (
        <div
          class={`group flex flex-col items-start gap-4 rounded-2xl border border-[#ff4d9d]/25 bg-[#26050f]/70 p-6 transition-all duration-300 hover:-translate-y-1 sm:flex-row ${
            isGold
              ? "hover:border-[#ffcf5c]/60 hover:bg-[#3a0818] hover:shadow-[0_10px_20px_rgba(255,207,92,0.24)]"
              : "hover:border-[#ff4d9d]/60 hover:bg-[#3a0818] hover:shadow-[0_10px_20px_rgba(255,77,157,0.26)]"
          }`}>
          <div
            aria-hidden="true"
            class={`flex h-14 w-14 shrink-0 items-center justify-center rounded-xl text-3xl transition-transform duration-300 group-hover:scale-110 ${
              isGold
                ? "border border-[#ffcf5c]/50 bg-gradient-to-br from-[#ffcf5c] to-[#c98a1c] shadow-[0_0_15px_rgba(255,207,92,0.45)] group-hover:rotate-3"
                : "border border-[#ff4d9d]/50 bg-gradient-to-br from-[#ffc2da] via-[#ff4d9d] to-[#a3134f] shadow-[0_0_15px_rgba(255,77,157,0.45)]"
            }`}>
            {item.icon}
          </div>
          <div class="flex flex-col gap-2 text-left">
            <h3
              class={`text-xl leading-normal font-black tracking-wide drop-shadow-sm ${
                isGold ? "bg-gradient-to-r from-[#ffcf5c] to-[#c98a1c] bg-clip-text text-transparent" : "bg-gradient-to-r from-[#ffc2da] to-[#ff4d9d] bg-clip-text text-transparent"
              }`}>
              {item.title}
            </h3>
            <p class="text-left text-base leading-relaxed text-[#e0a5bd] transition-colors group-hover:text-[#ffdcea]">{item.description}</p>
          </div>
        </div>
      );
    })
  }
</div>
