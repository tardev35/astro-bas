---
export interface FeatureItem {
  icon: string;
  title: string;
  description: string;
  accent?: "green" | "gold";
}

export interface Props {
  items: FeatureItem[];
}

const { items } = Astro.props;

// The <h3> below is the ONLY h3 a docx-driven page is allowed to have: it is
// the sanctioned "short sub-points under one H2 section" shape. Its text comes
// from the caller, never from this file.
//
// The accent union follows the current brand's two colours. This brand's
// primary is neon lime (#7bbb0b) and gold (#f5c518) is the secondary that
// echoes the coins in the artwork, so the union is "green" | "gold" and
// anything that is not explicitly "gold" renders green.
---

<div class="mt-4 flex flex-col gap-5">
  {
    items.map((item) => {
      const isGold = item.accent === "gold";
      return (
        <div
          class={`group flex flex-col items-start gap-4 rounded-2xl border border-[#7bbb0b]/25 bg-[#061405]/70 p-6 transition-all duration-300 hover:-translate-y-1 sm:flex-row ${
            isGold
              ? "hover:border-[#f5c518]/60 hover:bg-[#0d2606] hover:shadow-[0_10px_20px_rgba(245,197,24,0.24)]"
              : "hover:border-[#7bbb0b]/60 hover:bg-[#0d2606] hover:shadow-[0_10px_20px_rgba(123,187,11,0.26)]"
          }`}>
          <div
            aria-hidden="true"
            class={`flex h-14 w-14 shrink-0 items-center justify-center rounded-xl text-3xl transition-transform duration-300 group-hover:scale-110 ${
              isGold
                ? "border border-[#f5c518]/50 bg-gradient-to-br from-[#f5c518] to-[#a87c05] shadow-[0_0_15px_rgba(245,197,24,0.45)] group-hover:rotate-3"
                : "border border-[#7bbb0b]/50 bg-gradient-to-br from-[#a8e81c] via-[#7bbb0b] to-[#3c6b07] shadow-[0_0_15px_rgba(123,187,11,0.45)]"
            }`}>
            {item.icon}
          </div>
          <div class="flex flex-col gap-2 text-left">
            <h3
              class={`text-xl leading-normal font-black tracking-wide drop-shadow-sm ${
                isGold ? "bg-gradient-to-r from-[#ffe27a] to-[#a87c05] bg-clip-text text-transparent" : "bg-gradient-to-r from-[#a8e81c] to-[#7bbb0b] bg-clip-text text-transparent"
              }`}>
              {item.title}
            </h3>
            <p class="text-left text-base leading-relaxed text-[#a3c974] transition-colors group-hover:text-[#dcefc2]">{item.description}</p>
          </div>
        </div>
      );
    })
  }
</div>
