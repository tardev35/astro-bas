---
export interface FeatureItem {
  icon: string;
  title: string;
  description: string;
  accent?: "gold" | "lime";
}

export interface Props {
  items: FeatureItem[];
}

const { items } = Astro.props;
---

<div class="mt-4 flex flex-col gap-5">
  {
    items.map((item) => {
      const isGold = item.accent !== "lime";
      return (
        <div
          class={`group flex flex-col items-start gap-4 rounded-2xl border border-[#4a8d14]/35 bg-[#0a0f06]/60 p-6 transition-all duration-300 hover:-translate-y-1 sm:flex-row ${
            isGold
              ? "hover:border-[#ecab03]/60 hover:bg-[#1a2610] hover:shadow-[0_10px_20px_rgba(236,171,3,0.16)]"
              : "hover:border-[#8fd633]/60 hover:bg-[#1a2610] hover:shadow-[0_10px_20px_rgba(143,214,51,0.22)]"
          }`}>
          <div
            aria-hidden="true"
            class={`flex h-14 w-14 shrink-0 items-center justify-center rounded-xl text-3xl transition-transform duration-300 group-hover:scale-110 ${
              isGold
                ? "border border-[#ffd54a]/50 bg-gradient-to-br from-[#ffd54a] to-[#a9760a] shadow-[0_0_15px_rgba(236,171,3,0.45)] group-hover:rotate-3"
                : "border border-[#8fd633]/50 bg-gradient-to-br from-[#8fd633] to-[#2c5a0d] shadow-[0_0_15px_rgba(143,214,51,0.4)]"
            }`}>
            {item.icon}
          </div>
          <div class="flex flex-col gap-2 text-left">
            <h3
              class={`text-xl leading-normal font-black tracking-wide drop-shadow-sm ${
                isGold
                  ? "bg-gradient-to-r from-[#ffd54a] to-[#ecab03] bg-clip-text text-transparent"
                  : "bg-gradient-to-r from-[#8fd633] to-[#4a8d14] bg-clip-text text-transparent"
              }`}>
              {item.title}
            </h3>
            <p class="text-left text-base leading-relaxed text-[#b9c4a6] transition-colors group-hover:text-[#e8efd8]">{item.description}</p>
          </div>
        </div>
      );
    })
  }
</div>
