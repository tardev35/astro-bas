---
export interface FeatureItem {
  icon: string;
  title: string;
  description: string;
  accent?: "green" | "gold";
}

export interface Props {
  items: FeatureItem[];
}

const { items } = Astro.props;

// The <h3> below is the ONLY h3 a docx-driven page is allowed to have: it is
// the sanctioned "short sub-points under one H2 section" shape. Its text comes
// from the caller, never from this file.
//
// The accent union follows the current brand's two colours. This brand's
// primary is neon green (#7fdc16) and gold (#f2b40b) is the secondary that
// echoes the coins in the artwork, so the union is "green" | "gold" and
// anything that is not explicitly "gold" renders green.
---

<div class="mt-4 flex flex-col gap-5">
  {
    items.map((item) => {
      const isGold = item.accent === "gold";
      return (
        <div
          class={`group flex flex-col items-start gap-4 rounded-2xl border border-[#7fdc16]/25 bg-[#07120a]/70 p-6 transition-all duration-300 hover:-translate-y-1 sm:flex-row ${
            isGold
              ? "hover:border-[#f2b40b]/60 hover:bg-[#0e2410] hover:shadow-[0_10px_20px_rgba(242,180,11,0.24)]"
              : "hover:border-[#7fdc16]/60 hover:bg-[#0e2410] hover:shadow-[0_10px_20px_rgba(127,220,22,0.26)]"
          }`}>
          <div
            aria-hidden="true"
            class={`flex h-14 w-14 shrink-0 items-center justify-center rounded-xl text-3xl transition-transform duration-300 group-hover:scale-110 ${
              isGold
                ? "border border-[#f2b40b]/50 bg-gradient-to-br from-[#f2b40b] to-[#9c7304] shadow-[0_0_15px_rgba(242,180,11,0.45)] group-hover:rotate-3"
                : "border border-[#7fdc16]/50 bg-gradient-to-br from-[#cdf76b] via-[#7fdc16] to-[#3d7509] shadow-[0_0_15px_rgba(127,220,22,0.45)]"
            }`}>
            {item.icon}
          </div>
          <div class="flex flex-col gap-2 text-left">
            <h3
              class={`text-xl leading-normal font-black tracking-wide drop-shadow-sm ${
                isGold ? "bg-gradient-to-r from-[#ffe08a] to-[#9c7304] bg-clip-text text-transparent" : "bg-gradient-to-r from-[#cdf76b] to-[#7fdc16] bg-clip-text text-transparent"
              }`}>
              {item.title}
            </h3>
            <p class="text-left text-base leading-relaxed text-[#a6cf7a] transition-colors group-hover:text-[#dff5c8]">{item.description}</p>
          </div>
        </div>
      );
    })
  }
</div>
