---
import { Picture } from "astro:assets";
import BankStrip from "./BankStrip.astro";
import { BRAND_ADDRESS } from "../lib/brandProfile";
const images = import.meta.glob<{ default: ImageMetadata }>("../assets/logo.{png,webp,jpg}", { eager: true });
const imagePaths = Object.keys(images);
const mainLogo = imagePaths.length > 0 ? images[imagePaths[0]].default : null;

// Every label in here is a <p>, never a heading. The footer renders on every
// page, so one <h2> here is an <h2> sitewide and the docx heading diff in
// Phase 5 stops meaning anything.
const directory = [
  { name: "หน้าแรก", path: "/" },
  { name: "โปรโมชั่น", path: "/promotion" },
  { name: "สมัครสมาชิก", path: "/register" },
  { name: "เข้าสู่ระบบ", path: "/login" },
  { name: "ทางเข้า", path: "/ทางเข้า" },
  { name: "ทดลองเล่น", path: "/ทดลองเล่น" },
  { name: "เกี่ยวกับเรา", path: "/about-us" },
  { name: "ติดต่อเรา", path: "/contact-us" },
];
---

<footer
  class="relative mt-10 w-full overflow-hidden border-t border-[#7fdc16]/30 bg-[#07120a] pt-16 pb-8 font-sans text-[#dff5c8]"
  style="clip-path: polygon(0 30px, 50vw 0, 100% 30px, 100% 100%, 0 100%);">
  <div
    aria-hidden="true"
    class="pointer-events-none absolute inset-0 opacity-[0.14]"
    style="background-image: linear-gradient(#7fdc16 1px, transparent 1px), linear-gradient(90deg, #f2b40b 1px, transparent 1px); background-size: 30px 30px;">
  </div>

  <div class="relative z-10 mx-auto w-full max-w-[1200px] px-6">
    <div class="mb-12 grid grid-cols-1 gap-10 md:grid-cols-12">
      <div class="flex flex-col gap-5 md:col-span-5">
        <a href="/" class="inline-block transition-transform hover:scale-105">
          {
            mainLogo ? (
              <Picture
                src={mainLogo}
                alt="โลโก้ PGW44 มังกรดำพ่นไฟเหนือตัวอักษร PGW44 ไล่สีเขียวนีออนไปทอง"
                widths={[130, 260, 390]}
                sizes="130px"
                class="h-[60px] w-auto drop-shadow-[0_4px_12px_rgba(127,220,22,0.35)]"
                formats={["avif", "webp"]}
                fallbackFormat="webp"
              />
            ) : (
              <p class="text-3xl font-black tracking-widest text-[#7fdc16]">PGW44</p>
            )
          }
        </a>
        <p class="border-l-2 border-[#7fdc16] pl-4 text-sm leading-relaxed text-[#b8d9a0]">
          PGW44 เว็บสล็อตใหม่ล่าสุด รวมค่ายเกมลิขสิทธิ์แท้ระดับโลกไว้ในบัญชีเดียว ขับเคลื่อนด้วย ระบบออโต้ อัจฉริยะ ฝากถอนไม่มีขั้นต่ำ พร้อม โปรเด็ด และทีมงานดูแลตลอด 24 ชม.
        </p>
        <div class="mt-4 flex gap-3">
          <span class="border border-[#7fdc16]/40 bg-[#0e2410] px-3 py-1 font-mono text-xs text-[#cdf76b]">AUTO_SYSTEM</span>
          <span class="border border-[#f2b40b]/40 bg-[#0e2410] px-3 py-1 font-mono text-xs text-[#ffe08a]">LIVE_24H</span>
        </div>
      </div>

      <nav class="flex flex-col gap-4 md:col-span-3 lg:pl-8">
        <p class="text-lg font-black tracking-widest text-[#7fdc16] uppercase">/// DIRECTORY</p>
        <ul class="flex flex-col gap-3 font-mono text-sm text-[#b8d9a0]">
          {
            directory.map((item) => (
              <li>
                <a href={item.path} class="transition-colors hover:text-[#cdf76b]">
                  &gt; {item.name}
                </a>
              </li>
            ))
          }
        </ul>
      </nav>

      <div class="flex flex-col gap-5 md:col-span-4">
        <p class="text-lg font-black tracking-widest text-[#7fdc16] uppercase">/// SUPPORT_LINK</p>

        <a
          href="/line"
          class="flex w-full items-center justify-center gap-2 bg-[#00B900] py-3 font-bold text-white transition-all hover:bg-[#009900]"
          style="clip-path: polygon(10px 0, 100% 0, 100% calc(100% - 10px), calc(100% - 10px) 100%, 0 100%, 0 10px);">
          LINE CONNECT
        </a>

        {
          BRAND_ADDRESS.lines.length > 0 && (
            <address aria-label={BRAND_ADDRESS.label} class="mt-2 rounded-xl border border-white/15 bg-black/20 p-4 text-xs leading-relaxed not-italic opacity-90">
              <p class="mb-2 flex items-center gap-2 text-[11px] font-bold tracking-wider uppercase opacity-80">
                <span aria-hidden="true" class="text-sm">
                  📍
                </span>
                {BRAND_ADDRESS.label}
              </p>
              {BRAND_ADDRESS.lines.map((line) => (
                <span class="block">{line}</span>
              ))}
              {BRAND_ADDRESS.email && (
                <a href={`mailto:${BRAND_ADDRESS.email}`} class="mt-3 inline-flex items-center gap-2 font-bold underline decoration-current/40 underline-offset-4 opacity-90 transition-opacity hover:opacity-100">
                  <span aria-hidden="true" class="text-sm">
                    ✉️
                  </span>
                  {BRAND_ADDRESS.email}
                </a>
              )}
            </address>
          )
        }

        <p class="mt-2 font-mono text-xs text-[#8fae76]">ACCEPTED_PAYMENTS</p>
        <BankStrip size={28} />
      </div>
    </div>

    <div class="flex flex-col items-center justify-between border-t border-[#7fdc16]/25 pt-6 font-mono text-xs text-[#8fae76] md:flex-row">
      <p>SYSTEM_COPYRIGHT &copy; {new Date().getFullYear()} PGW44</p>
      <div class="mt-4 flex gap-4 md:mt-0">
        <a href="/terms/" class="hover:text-[#cdf76b]">TERMS_OF_SERVICE</a>
        <a href="/privacy/" class="hover:text-[#cdf76b]">PRIVACY_POLICY</a>
        <a href="#top" class="hover:text-[#cdf76b]">BACK_TO_TOP</a>
      </div>
    </div>
  </div>
</footer>

<style>
  footer a {
    text-decoration: none;
    font-family: var(--font-sans);
  }
  .font-mono {
    font-family: monospace;
  }
</style>
