---
export interface Props {
  title?: string;
  as?: "h1" | "h2" | "h3" | "h4" | "h5" | "h6";
}
const { title, as: HeadingTag = "h1" } = Astro.props;
---

<section class="my-6 flex w-full justify-center px-4 font-sans">
  <div
    class="relative isolate w-full max-w-7xl border border-amber-400/35 bg-[#150a24]/90 p-8 text-left text-base leading-relaxed text-amber-50/85 shadow-[0_0_20px_rgba(212,162,74,0.18)] backdrop-blur-md"
    style="clip-path: polygon(40px 0, 100% 0, 100% calc(100% - 40px), calc(100% - 40px) 100%, 0 100%, 0 40px);">
    <div class="absolute top-0 left-0 -z-10 h-1 w-32 bg-gradient-to-r from-amber-200 to-transparent"></div>
    <div class="absolute right-0 bottom-0 -z-10 h-1 w-32 bg-gradient-to-l from-violet-500 to-transparent"></div>
    <div class="absolute top-0 left-0 -z-10 h-32 w-1 bg-gradient-to-b from-amber-200 to-transparent"></div>
    <div class="absolute right-0 bottom-0 -z-10 h-32 w-1 bg-gradient-to-t from-violet-500 to-transparent"></div>

    {
      title && (
        <header class="mb-8 border-l-4 border-amber-400 pl-6">
          <HeadingTag class="text-2xl leading-normal font-black tracking-[0.15em] text-amber-200 uppercase drop-shadow-[0_0_10px_rgba(212,162,74,0.55)] md:text-3xl md:tracking-[0.2em]">
            {title}
          </HeadingTag>
        </header>
      )
    }
    <slot />
  </div>
</section>
<style>
  .font-sans {
    font-family: var(--font-sans);
  }
</style>
