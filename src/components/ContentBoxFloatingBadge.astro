---
export interface Props {
  title?: string;
  as?: "h1" | "h2" | "h3" | "h4" | "h5" | "h6";
}
const { title, as: HeadingTag = "h1" } = Astro.props;
const headingSize = HeadingTag === "h1" ? "text-xl sm:text-2xl md:text-3xl" : "text-lg sm:text-xl md:text-2xl";

// pt-40/md:pt-32, redone 2026-08-09 for PHANTOM569. The badge is anchored at
// -top-6 (24px above the card), so its bottom edge sits at
// (badge height − 24px) below the card's top. A full-sentence Thai heading
// wraps the badge to four or five lines at phone widths, and without enough
// top padding the badge's last line lands on the first line of body copy.
//
// The badge carries an H2, not the page's H1 (the H1 hero is
// ContentBoxNeumorphism), so `headingSize` is one step smaller at every
// breakpoint.
// Title: "PHANTOM569 ศูนย์รวมเกมชั้นนำ เว็บตรงไม่ผ่านเอเย่นต์ ระดับพรีเมียม"
// (65 characters) — 10 longer than the previous brand's, which is why the old
// pt-32/md:pt-24 went UP rather than staying put.
//   320px viewport — card 288px wide, badge w-[92%] ≈ 265px; minus px-4, the
//   2px borders and the two ✦ spans with their gap-2 leaves ~173px of text at
//   text-lg/18px, leading-normal = 27px per line. The title measures ≈650px at
//   18px, and "เว็บตรงไม่ผ่านเอเย่นต์" alone overruns the line box, so budget a
//   5-line wrap = 135px + py-2.5 (20px) + border (4px) = 159px. Bottom edge at
//   159 − 24 = 135px, inside pt-40 (160px) → 25px clear. A 4-line wrap leaves
//   52px.
//   md — badge max-w-2xl (672px), sm:px-8, ~544px of text at md:text-2xl/24px,
//   leading 36px. 650px at 18px scales to ≈867px at 24px → 2 lines = 72px +
//   24px = 96px; bottom edge at 72px. md:pt-32 (128px) also absorbs a
//   pessimistic 3-line wrap (bottom edge 108px, 20px clear).
// Do NOT copy this number to ContentBoxSevenThreeFloatingBadge — that file
// holds a different title at a different card width and does its own sum.
//
// The badge itself is w-[92%] max-w-2xl + text-center, NOT whitespace-nowrap:
// a real docx sentence in a nowrap badge blew past the viewport on mobile and
// forced the whole page into horizontal scroll.
---

<section class="my-10 flex w-full justify-center px-4 font-sans">
  <div
    class="relative isolate w-full max-w-[1400px] rounded-2xl border-2 border-[#8b3fe0]/25 bg-gradient-to-b from-[#160a2b]/95 to-[#0b0518]/95 p-8 pt-40 text-left text-base leading-relaxed text-[#e4dcf7] shadow-[0_10px_30px_rgba(139,63,224,0.18)] md:pt-32">
    <div class="pointer-events-none absolute -top-16 -right-10 -z-10 h-40 w-40 rounded-full bg-[#8b3fe0]/25 blur-[60px]"></div>
    <div class="pointer-events-none absolute -bottom-16 -left-10 -z-10 h-40 w-40 rounded-full bg-[#4c1d95]/35 blur-[60px]"></div>

    {
      title && (
        <div class="absolute -top-6 left-1/2 flex w-[92%] max-w-2xl -translate-x-1/2 items-center justify-center gap-2 rounded-lg border-2 border-[#8b3fe0]/35 bg-[#160a2b] px-4 py-2.5 text-center shadow-[0_10px_30px_rgba(139,63,224,0.26)] sm:px-8">
          <span aria-hidden="true" class="shrink-0 text-[#f3ecff]">
            ✦
          </span>
          <HeadingTag class={`bg-gradient-to-r from-[#b662ff] via-[#8b3fe0] to-[#4c1d95] bg-clip-text ${headingSize} leading-normal font-black tracking-tight text-transparent uppercase`}>
            {title}
          </HeadingTag>
          <span aria-hidden="true" class="shrink-0 text-[#f3ecff]">
            ✦
          </span>
        </div>
      )
    }

    <slot />
  </div>
</section>
