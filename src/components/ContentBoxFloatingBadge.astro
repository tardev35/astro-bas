---
export interface Props {
  title?: string;
  as?: "h1" | "h2" | "h3" | "h4" | "h5" | "h6";
}
const { title, as: HeadingTag = "h1" } = Astro.props;
const headingSize = HeadingTag === "h1" ? "text-xl sm:text-2xl md:text-3xl" : "text-lg sm:text-xl md:text-2xl";
---

<section class="my-10 flex w-full justify-center px-4 font-sans">
  <div
    class="relative isolate w-full max-w-[1400px] rounded-2xl border-2 border-amber-500/40 bg-gradient-to-b from-[#1a0409] to-[#0f0206] p-8 pt-32 text-left text-base leading-relaxed text-amber-50/90 shadow-[0_10px_40px_rgba(0,0,0,0.5)]">
    <div class="pointer-events-none absolute -top-16 -right-10 -z-10 h-40 w-40 rounded-full bg-amber-500/12 blur-[60px]"></div>
    <div class="pointer-events-none absolute -bottom-16 -left-10 -z-10 h-40 w-40 rounded-full bg-[#7f1d1d]/35 blur-[60px]"></div>

    {
      title && (
        <div class="absolute -top-6 left-1/2 flex w-[92%] max-w-2xl -translate-x-1/2 items-center justify-center gap-2 rounded-lg border-2 border-amber-500/50 bg-[#0f0206] px-4 py-2.5 text-center shadow-[0_5px_15px_rgba(251,191,36,0.3)] sm:px-8">
          <span aria-hidden="true" class="shrink-0 text-amber-400">
            ✦
          </span>
          <HeadingTag class={`bg-gradient-to-r from-amber-200 via-amber-300 to-amber-500 bg-clip-text ${headingSize} leading-normal font-black tracking-tight text-transparent uppercase`}>{title}</HeadingTag>
          <span aria-hidden="true" class="shrink-0 text-amber-400">
            ✦
          </span>
        </div>
      )
    }

    <slot />
  </div>
</section>

<style>
  .font-sans {
    font-family: "Kanit", sans-serif;
  }
</style>
