---
export interface Props {
  title?: string;
  as?: "h1" | "h2" | "h3" | "h4" | "h5" | "h6";
}
const { title, as: HeadingTag = "h1" } = Astro.props;
const headingSize = HeadingTag === "h1" ? "text-xl sm:text-2xl md:text-3xl" : "text-lg sm:text-xl md:text-2xl";
---

<section class="my-10 flex w-full justify-center px-4 font-sans">
  <div
    class="relative isolate w-full max-w-[1400px] rounded-2xl border-2 border-amber-600/25 bg-gradient-to-b from-[#fffdf7]/95 to-[#faf4e6]/95 p-8 pt-28 text-left text-base leading-relaxed text-[#3a2e18] shadow-[0_10px_30px_rgba(168,132,44,0.18)] md:pt-24">
    <div class="pointer-events-none absolute -top-16 -right-10 -z-10 h-40 w-40 rounded-full bg-amber-300/25 blur-[60px]"></div>
    <div class="pointer-events-none absolute -bottom-16 -left-10 -z-10 h-40 w-40 rounded-full bg-[#cfd0d2]/50 blur-[60px]"></div>

    {
      title && (
        <div class="absolute -top-6 left-1/2 flex w-[92%] max-w-2xl -translate-x-1/2 items-center justify-center gap-2 rounded-lg border-2 border-amber-600/30 bg-[#fffdf7] px-4 py-2.5 text-center shadow-[0_10px_30px_rgba(168,132,44,0.18)] sm:px-8">
          <span aria-hidden="true" class="shrink-0 text-[#c9a227]">
            ✦
          </span>
          <HeadingTag class={`bg-gradient-to-r from-[#7a5a12] via-[#b8912f] to-[#8a6a1f] bg-clip-text ${headingSize} leading-normal font-black tracking-tight text-transparent uppercase`}>{title}</HeadingTag>
          <span aria-hidden="true" class="shrink-0 text-[#c9a227]">
            ✦
          </span>
        </div>
      )
    }

    <slot />
  </div>
</section>

<style>
  .font-sans {
    font-family: var(--font-sans);
  }
</style>
