---
export interface Props {
  title?: string;
  as?: "h1" | "h2" | "h3" | "h4" | "h5" | "h6";
}
const { title, as: HeadingTag = "h1" } = Astro.props;
const headingSize = HeadingTag === "h1" ? "text-xl sm:text-2xl md:text-3xl" : "text-lg sm:text-xl md:text-2xl";

// pt-32/md:pt-24, redone 2026-08-08 for GARUDA369. The badge is anchored at
// -top-6 (24px above the card), so its bottom edge sits at
// (badge height − 24px) below the card's top. A full-sentence Thai heading
// wraps the badge to three or four lines at phone widths, and without enough
// top padding the badge's last line lands on the first line of body copy.
//
// This round the badge carries an H2, not the page's H1 (the H1 hero is
// ContentBoxNeumorphism), so `headingSize` is one step smaller at every
// breakpoint than it was for BUNNY555 — which is why the previous pt-40/
// md:pt-32 no longer applies and the number came down rather than up.
// Title: "GARUDA369 ศูนย์รวมเกมลิขสิทธิ์แท้ สล็อตเว็บใหญ่ ระดับโลก" (55 characters).
//   320px viewport — card 288px wide, badge w-[92%] ≈ 265px; minus px-4, the
//   2px borders and the two ✦ spans with their gap-2 leaves ~173px of text at
//   text-lg/18px, leading-normal = 27px per line. The title measures ≈550px at
//   18px, so it wraps to 4 lines = 108px + py-2.5 (20px) + border (4px) =
//   132px. Bottom edge at 132 − 24 = 108px, inside pt-32 (128px) → 20px clear.
//   At 360px the line box grows to ~210px, the wrap drops to 3 lines and the
//   clearance rises to 47px.
//   md — badge max-w-2xl (672px), sm:px-8, ~544px of text at md:text-2xl/24px,
//   leading 36px. 550px at 18px scales to ≈726px at 24px → 2 lines = 72px +
//   24px = 96px; bottom edge at 72px, inside md:pt-24 (96px). 24px clear.
// Do NOT copy this number to ContentBoxSevenThreeFloatingBadge — that file
// holds a different title at a different card width and does its own sum.
//
// The badge itself is w-[92%] max-w-2xl + text-center, NOT whitespace-nowrap:
// a real docx sentence in a nowrap badge blew past the viewport on mobile and
// forced the whole page into horizontal scroll.
---

<section class="my-10 flex w-full justify-center px-4 font-sans">
  <div
    class="relative isolate w-full max-w-[1400px] rounded-2xl border-2 border-[#7bbb0b]/25 bg-gradient-to-b from-[#0d2606]/95 to-[#061405]/95 p-8 pt-32 text-left text-base leading-relaxed text-[#dcefc2] shadow-[0_10px_30px_rgba(123,187,11,0.18)] md:pt-24">
    <div class="pointer-events-none absolute -top-16 -right-10 -z-10 h-40 w-40 rounded-full bg-[#7bbb0b]/25 blur-[60px]"></div>
    <div class="pointer-events-none absolute -bottom-16 -left-10 -z-10 h-40 w-40 rounded-full bg-[#3c6b07]/35 blur-[60px]"></div>

    {
      title && (
        <div class="absolute -top-6 left-1/2 flex w-[92%] max-w-2xl -translate-x-1/2 items-center justify-center gap-2 rounded-lg border-2 border-[#7bbb0b]/35 bg-[#0d2606] px-4 py-2.5 text-center shadow-[0_10px_30px_rgba(123,187,11,0.26)] sm:px-8">
          <span aria-hidden="true" class="shrink-0 text-[#e9f8cf]">
            ✦
          </span>
          <HeadingTag class={`bg-gradient-to-r from-[#a8e81c] via-[#7bbb0b] to-[#3c6b07] bg-clip-text ${headingSize} leading-normal font-black tracking-tight text-transparent uppercase`}>
            {title}
          </HeadingTag>
          <span aria-hidden="true" class="shrink-0 text-[#e9f8cf]">
            ✦
          </span>
        </div>
      )
    }

    <slot />
  </div>
</section>
