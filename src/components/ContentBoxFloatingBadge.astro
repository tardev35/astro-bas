---
export interface Props {
  title?: string;
  as?: "h1" | "h2" | "h3" | "h4" | "h5" | "h6";
}
const { title, as: HeadingTag = "h1" } = Astro.props;
const headingSize = HeadingTag === "h1" ? "text-xl sm:text-2xl md:text-3xl" : "text-lg sm:text-xl md:text-2xl";
---

<section class="my-10 flex w-full justify-center px-4 font-sans">
  <div
    class="relative isolate w-full max-w-[1400px] rounded-2xl border-2 border-amber-500/40 bg-gradient-to-b from-[#1a1204] to-[#0a0703] p-8 pt-32 text-left text-base leading-relaxed text-amber-50/90 shadow-[0_10px_40px_rgba(0,0,0,0.5)]">
    <div class="pointer-events-none absolute -top-16 -right-10 -z-10 h-40 w-40 rounded-full bg-amber-500/10 blur-[60px]"></div>
    <div class="pointer-events-none absolute -bottom-16 -left-10 -z-10 h-40 w-40 rounded-full bg-orange-500/10 blur-[60px]"></div>

    {
      title && (
        <div class="absolute -top-6 left-1/2 w-[92%] max-w-2xl -translate-x-1/2 rounded-lg border-2 border-orange-500/50 bg-[#0a0703] px-4 py-2.5 text-center shadow-[0_5px_15px_rgba(249,115,22,0.3)] sm:px-8">
          <HeadingTag class={`bg-gradient-to-r from-amber-200 via-amber-300 to-orange-400 bg-clip-text ${headingSize} leading-normal font-black tracking-tight text-transparent uppercase`}>
            ✦ {title} ✦
          </HeadingTag>
        </div>
      )
    }

    <slot />
  </div>
</section>

<style>
  .font-sans {
    font-family: "Kanit", sans-serif;
  }
</style>
