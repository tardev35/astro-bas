---
const { title, titleleft, titleright } = Astro.props;
---

<section class="my-10 flex w-full justify-center px-4 font-sans">
  <div
    class="relative isolate w-full max-w-7xl rounded-2xl border-2 border-amber-600/25 bg-gradient-to-b from-[#fffdf7]/95 to-[#faf4e6]/95 p-8 pt-28 shadow-[0_10px_30px_rgba(168,132,44,0.18)] md:pt-24">
    <div class="pointer-events-none absolute -right-10 -bottom-16 -z-10 h-40 w-40 rounded-full bg-[#cfd0d2]/50 blur-[60px]"></div>
    <div class="pointer-events-none absolute -top-16 -left-10 -z-10 h-40 w-40 rounded-full bg-amber-300/25 blur-[60px]"></div>

    {
      title && (
        <div class="absolute -top-6 left-1/2 w-[92%] max-w-2xl -translate-x-1/2 rounded-lg border-2 border-amber-600/30 bg-[#fffdf7] px-4 py-2.5 text-center shadow-[0_10px_30px_rgba(168,132,44,0.18)] sm:px-8">
          <h2 class="bg-gradient-to-r from-[#7a5a12] via-[#b8912f] to-[#8a6a1f] bg-clip-text text-base leading-normal font-black tracking-widest text-transparent uppercase sm:text-xl md:text-2xl">
            {title}
          </h2>
        </div>
      )
    }

    <div class="grid grid-cols-1 gap-10 md:grid-cols-[3fr_7fr] md:items-center">
      <article class="flex flex-col gap-4 text-left text-base leading-relaxed text-[#3a2e18]">
        {titleleft && <h2 class="text-2xl leading-normal font-bold text-[#8a6410]">{titleleft}</h2>}
        <slot name="left" />
      </article>

      <article class="flex flex-col gap-4 text-left text-base leading-relaxed text-[#3a2e18] md:border-l md:border-amber-600/25 md:pl-10">
        {titleright && <h2 class="text-2xl leading-normal font-bold text-[#8a6410]">{titleright}</h2>}
        <slot name="right" />
      </article>
    </div>
  </div>
</section>

<style>
  .font-sans {
    font-family: var(--font-sans);
  }
</style>
