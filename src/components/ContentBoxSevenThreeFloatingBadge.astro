---
const { title, titleleft, titleright } = Astro.props;
---

<section class="my-10 flex w-full justify-center px-4 font-sans">
  <div
    class="relative isolate w-full max-w-7xl rounded-2xl border-2 border-[#f5c53d]/25 bg-gradient-to-b from-[#140d06]/95 to-[#0d0804]/95 p-8 pt-28 shadow-[0_10px_30px_rgba(245,197,61,0.16)] md:pt-24">
    <div class="pointer-events-none absolute -right-10 -bottom-16 -z-10 h-40 w-40 rounded-full bg-[#c8121f]/45 blur-[60px]"></div>
    <div class="pointer-events-none absolute -top-16 -left-10 -z-10 h-40 w-40 rounded-full bg-[#f5c53d]/25 blur-[60px]"></div>

    {
      title && (
        <div class="absolute -top-6 left-1/2 w-[92%] max-w-2xl -translate-x-1/2 rounded-lg border-2 border-[#f5c53d]/35 bg-[#140d06] px-4 py-2.5 text-center shadow-[0_10px_30px_rgba(245,197,61,0.22)] sm:px-8">
          <h2 class="bg-gradient-to-r from-[#ffe9a8] via-[#f5c53d] to-[#c8921e] bg-clip-text text-base leading-normal font-black tracking-widest text-transparent uppercase sm:text-xl md:text-2xl">
            {title}
          </h2>
        </div>
      )
    }

    <div class="grid grid-cols-1 gap-10 md:grid-cols-[3fr_7fr] md:items-center">
      <article class="flex flex-col gap-4 text-left text-base leading-relaxed text-[#ece2cc]">
        {titleleft && <h2 class="text-2xl leading-normal font-bold text-[#f5c53d]">{titleleft}</h2>}
        <slot name="left" />
      </article>

      <article class="flex flex-col gap-4 text-left text-base leading-relaxed text-[#ece2cc] md:border-l md:border-[#f5c53d]/25 md:pl-10">
        {titleright && <h2 class="text-2xl leading-normal font-bold text-[#f5c53d]">{titleright}</h2>}
        <slot name="right" />
      </article>
    </div>
  </div>
</section>

<style>
  .font-sans {
    font-family: var(--font-sans);
  }
</style>
