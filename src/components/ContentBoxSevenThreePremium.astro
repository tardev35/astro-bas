---
export interface Props {
  title?: string;
  titleleft?: string;
  titleright?: string;
}
const { title, titleleft, titleright } = Astro.props;
const rightHeading = titleright ?? title;

// Both column titles render as <h2>. The left column carries the image on this
// brand, so index.astro passes only `titleright` — passing `titleleft` too would
// put a second heading on the page for the same docx section.
---

<section class="relative z-10 mx-auto mb-8 w-full max-w-7xl px-4 font-sans">
  <div
    class="group relative isolate w-full overflow-hidden rounded-3xl border border-[#f2b40b]/30 bg-gradient-to-br from-[#0e2410]/92 to-[#07120a]/88 p-8 text-[#dff5c8] shadow-[0_10px_30px_rgba(242,180,11,0.16)] backdrop-blur-xl transition-all duration-500 hover:border-[#f2b40b]/60 hover:shadow-[0_15px_40px_rgba(242,180,11,0.28)] md:p-10">
    <div class="pointer-events-none absolute -top-24 -left-24 -z-10 h-48 w-48 rounded-full bg-[#f2b40b]/20 blur-[60px] transition-all duration-500 group-hover:bg-[#ffe08a]/30"></div>
    <div class="pointer-events-none absolute -right-24 -bottom-24 -z-10 h-48 w-48 rounded-full bg-[#63b80f]/28 blur-[60px] transition-all duration-500 group-hover:bg-[#7fdc16]/32"></div>

    <div class="grid grid-cols-1 gap-10 md:grid-cols-[3fr_7fr] md:items-center">
      <article class="flex flex-col gap-4 text-left text-base leading-relaxed text-[#dff5c8]">
        {
          titleleft && (
            <h2 class="bg-gradient-to-r from-[#ffe08a] via-[#f2b40b] to-[#7fdc16] bg-clip-text text-center text-xl leading-normal font-black tracking-widest text-transparent uppercase md:text-left">
              {titleleft}
            </h2>
          )
        }
        <slot name="left" />
      </article>

      <article class="flex flex-col gap-4 text-left text-base leading-relaxed text-[#dff5c8] md:border-l md:border-[#1e4a14] md:pl-10">
        {
          rightHeading && (
            <h2 class="mb-2 bg-gradient-to-r from-[#ffe08a] via-[#f2b40b] to-[#7fdc16] bg-clip-text text-2xl leading-normal font-black tracking-widest text-transparent uppercase">
              {rightHeading}
            </h2>
          )
        }
        <slot name="right" />
      </article>
    </div>
  </div>
</section>
