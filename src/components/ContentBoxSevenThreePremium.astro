---
export interface Props {
  title?: string;
  titleleft?: string;
  titleright?: string;
}
const { title, titleleft, titleright } = Astro.props;
const rightHeading = titleright ?? title;

// Both column titles render as <h2>. The left column carries the image on this
// brand, so index.astro passes only `titleright` — passing `titleleft` too would
// put a second heading on the page for the same docx section.
---

<section class="relative z-10 mx-auto mb-8 w-full max-w-7xl px-4 font-sans">
  <div
    class="group relative isolate w-full overflow-hidden rounded-3xl border border-[#faad23]/30 bg-gradient-to-br from-[#3d0410]/92 to-[#1a0106]/88 p-8 text-[#ffe9c4] shadow-[0_10px_30px_rgba(250,173,35,0.16)] backdrop-blur-xl transition-all duration-500 hover:border-[#faad23]/60 hover:shadow-[0_15px_40px_rgba(250,173,35,0.28)] md:p-10">
    <div class="pointer-events-none absolute -top-24 -left-24 -z-10 h-48 w-48 rounded-full bg-[#faad23]/20 blur-[60px] transition-all duration-500 group-hover:bg-[#ffd84d]/30"></div>
    <div class="pointer-events-none absolute -right-24 -bottom-24 -z-10 h-48 w-48 rounded-full bg-[#e01b5d]/28 blur-[60px] transition-all duration-500 group-hover:bg-[#ff3d8a]/32"></div>

    <div class="grid grid-cols-1 gap-10 md:grid-cols-[3fr_7fr] md:items-center">
      <article class="flex flex-col gap-4 text-left text-base leading-relaxed text-[#ffe9c4]">
        {
          titleleft && (
            <h2 class="bg-gradient-to-r from-[#ffd84d] via-[#faad23] to-[#ff3d8a] bg-clip-text text-center text-xl leading-normal font-black tracking-widest text-transparent uppercase md:text-left">
              {titleleft}
            </h2>
          )
        }
        <slot name="left" />
      </article>

      <article class="flex flex-col gap-4 text-left text-base leading-relaxed text-[#ffe9c4] md:border-l md:border-[#7a0426] md:pl-10">
        {
          rightHeading && (
            <h2 class="mb-2 bg-gradient-to-r from-[#ffd84d] via-[#faad23] to-[#ff3d8a] bg-clip-text text-2xl leading-normal font-black tracking-widest text-transparent uppercase">
              {rightHeading}
            </h2>
          )
        }
        <slot name="right" />
      </article>
    </div>
  </div>
</section>
