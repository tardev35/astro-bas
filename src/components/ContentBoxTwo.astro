---
export interface Props {
  titleleft?: string;
  titleright?: string;
}
const { titleleft, titleright } = Astro.props;
---

<section class="relative z-10 mx-auto mb-10 w-full max-w-[1400px] px-4 font-sans">
  <div class="grid grid-cols-1 gap-6 md:grid-cols-2 lg:gap-8">
    <article class="flex flex-col gap-4 text-left text-base leading-relaxed text-[#ece2cc]">
      {
        titleleft && (
          <p class="flex items-center gap-3 border-b border-[#f5c53d]/25 pb-3 text-xl leading-normal font-black tracking-widest text-[#f5c53d] uppercase">
            <span class="flex h-9 w-9 shrink-0 items-center justify-center rounded-lg border border-[#f5c53d]/40 bg-gradient-to-br from-[#ffe9a8] via-[#f5c53d] to-[#c8921e] text-sm text-[#140d06] shadow-[0_5px_15px_rgba(245,197,61,0.3)]">
              🔐
            </span>
            {titleleft}
          </p>
        )
      }
      <slot name="left" />
    </article>

    <article class="flex flex-col gap-4 text-left text-base leading-relaxed text-[#ece2cc]">
      {
        titleright && (
          <p class="flex items-center gap-3 border-b border-[#f5c53d]/25 pb-3 text-xl leading-normal font-black tracking-widest text-[#f5c53d] uppercase">
            <span class="flex h-9 w-9 shrink-0 items-center justify-center rounded-lg border border-[#c8121f]/50 bg-gradient-to-br from-[#e4222a] via-[#c8121f] to-[#7d0b12] text-sm text-[#ffe9a8] shadow-[0_5px_15px_rgba(200,18,31,0.4)]">
              🎲
            </span>
            {titleright}
          </p>
        )
      }
      <slot name="right" />
    </article>
  </div>
</section>
<style>
  .font-sans {
    font-family: var(--font-sans);
  }
</style>
