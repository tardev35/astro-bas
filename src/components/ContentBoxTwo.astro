---
const { titleleft, titleright } = Astro.props;
---

<section class="relative z-10 mx-auto mb-10 w-full max-w-[1400px] px-4 font-sans">
  <div class="grid grid-cols-1 gap-6 md:grid-cols-2 lg:gap-8">
    <article class="flex flex-col gap-4 text-left text-base leading-relaxed text-white/90">
      {
        titleleft && (
          <p class="flex items-center gap-3 border-b border-pink-400/40 pb-3 text-xl leading-normal font-black tracking-widest text-white uppercase drop-shadow-md">
            <span class="flex h-9 w-9 shrink-0 items-center justify-center rounded-lg border border-pink-300/40 bg-gradient-to-br from-[#ec4899] to-[#881337] text-sm text-white shadow-[0_0_10px_rgba(236,72,153,0.5)]">
              🔐
            </span>
            {titleleft}
          </p>
        )
      }
      <slot name="left" />
    </article>

    <article class="flex flex-col gap-4 text-left text-base leading-relaxed text-white/90">
      {
        titleright && (
          <p class="flex items-center gap-3 border-b border-pink-400/40 pb-3 text-xl leading-normal font-black tracking-widest text-white uppercase drop-shadow-md">
            <span class="flex h-9 w-9 shrink-0 items-center justify-center rounded-lg border border-pink-200/50 bg-gradient-to-br from-[#fce7f3] to-[#db2777] text-sm text-[#241019] shadow-[0_0_10px_rgba(236,72,153,0.5)]">
              💰
            </span>
            {titleright}
          </p>
        )
      }
      <slot name="right" />
    </article>
  </div>
</section>
<style>
  .font-sans {
    font-family: var(--font-sans);
  }
</style>
