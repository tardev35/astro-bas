---
export interface Props {
  titleleft?: string;
  titleright?: string;
}
const { titleleft, titleright } = Astro.props;
---

<section class="relative z-10 mx-auto mb-10 w-full max-w-[1400px] px-4 font-sans">
  <div class="grid grid-cols-1 gap-6 md:grid-cols-2 lg:gap-8">
    <article class="flex flex-col gap-4 text-left text-base leading-relaxed text-[#efeade]">
      {
        titleleft && (
          <p class="flex items-center gap-3 border-b border-[#dcb96b]/25 pb-3 text-xl leading-normal font-black tracking-widest text-[#dcb96b] uppercase">
            <span class="flex h-9 w-9 shrink-0 items-center justify-center rounded-lg border border-[#dcb96b]/40 bg-gradient-to-br from-[#f2dca4] via-[#dcb96b] to-[#ac893a] text-sm text-[#141210] shadow-[0_5px_15px_rgba(220,185,107,0.3)]">
              🔐
            </span>
            {titleleft}
          </p>
        )
      }
      <slot name="left" />
    </article>

    <article class="flex flex-col gap-4 text-left text-base leading-relaxed text-[#efeade]">
      {
        titleright && (
          <p class="flex items-center gap-3 border-b border-[#dcb96b]/25 pb-3 text-xl leading-normal font-black tracking-widest text-[#dcb96b] uppercase">
            <span class="flex h-9 w-9 shrink-0 items-center justify-center rounded-lg border border-[#b9bcc4]/50 bg-gradient-to-br from-[#d7dae1] via-[#b9bcc4] to-[#6f7480] text-sm text-[#141210] shadow-[0_5px_15px_rgba(185,188,196,0.4)]">
              ⚽
            </span>
            {titleright}
          </p>
        )
      }
      <slot name="right" />
    </article>
  </div>
</section>
<style>
  .font-sans {
    font-family: var(--font-sans);
  }
</style>
