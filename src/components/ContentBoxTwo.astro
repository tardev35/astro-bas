---
export interface Props {
  titleleft?: string;
  titleright?: string;
  label?: string;
}
const { titleleft, titleright, label } = Astro.props;

// Both column titles are deliberately <p>, not headings: they label UI panels
// (a login form, a reference table), not docx sections, so promoting them would
// add heading levels the brief never asked for. The section carries its own
// accessible name instead, which is what `label` is for.
const sectionLabel = label ?? titleleft ?? titleright ?? "ข้อมูลประกอบ";
---

<section aria-label={sectionLabel} class="relative z-10 mx-auto mb-10 w-full max-w-[1400px] px-4 font-sans">
  <div class="grid grid-cols-1 gap-6 md:grid-cols-2 lg:gap-8">
    <article class="flex flex-col gap-4 text-left text-base leading-relaxed text-[#e8efd8]">
      {
        titleleft && (
          <p class="flex items-center gap-3 border-b border-[#ecab03]/25 pb-3 text-xl leading-normal font-black tracking-widest text-[#ecab03] uppercase">
            <span aria-hidden="true" class="flex h-9 w-9 shrink-0 items-center justify-center rounded-lg border border-[#ecab03]/40 bg-gradient-to-br from-[#ffd54a] via-[#ecab03] to-[#a9760a] text-sm text-[#0a0f06] shadow-[0_5px_15px_rgba(236,171,3,0.32)]">
              🔐
            </span>
            {titleleft}
          </p>
        )
      }
      <slot name="left" />
    </article>

    <article class="flex flex-col gap-4 text-left text-base leading-relaxed text-[#e8efd8]">
      {
        titleright && (
          <p class="flex items-center gap-3 border-b border-[#ecab03]/25 pb-3 text-xl leading-normal font-black tracking-widest text-[#ecab03] uppercase">
            <span aria-hidden="true" class="flex h-9 w-9 shrink-0 items-center justify-center rounded-lg border border-[#8fd633]/50 bg-gradient-to-br from-[#8fd633] via-[#4a8d14] to-[#2c5a0d] text-sm text-[#0a0f06] shadow-[0_5px_15px_rgba(143,214,51,0.35)]">
              🎰
            </span>
            {titleright}
          </p>
        )
      }
      <slot name="right" />
    </article>
  </div>
</section>
