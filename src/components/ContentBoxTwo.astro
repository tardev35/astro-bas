---
export interface Props {
  titleleft?: string;
  titleright?: string;
  label?: string;
}
const { titleleft, titleright, label } = Astro.props;

// Both column titles are deliberately <p>, not headings: they label UI panels
// (a login form, a reference table), not docx sections, so promoting them would
// add heading levels the brief never asked for. The section carries its own
// accessible name instead, which is what `label` is for.
const sectionLabel = label ?? titleleft ?? titleright ?? "ข้อมูลประกอบ";
---

<section aria-label={sectionLabel} class="relative z-10 mx-auto mb-10 w-full max-w-[1400px] px-4 font-sans">
  <div class="grid grid-cols-1 gap-6 md:grid-cols-2 lg:gap-8">
    <article class="flex flex-col gap-4 text-left text-base leading-relaxed text-[#ece3cf]">
      {
        titleleft && (
          <p class="flex items-center gap-3 border-b border-[#dab563]/25 pb-3 text-xl leading-normal font-black tracking-widest text-[#dab563] uppercase">
            <span
              aria-hidden="true"
              class="flex h-9 w-9 shrink-0 items-center justify-center rounded-lg border border-[#dab563]/40 bg-gradient-to-br from-[#f5eb8b] via-[#dab563] to-[#a97f28] text-sm text-[#120c04] shadow-[0_5px_15px_rgba(218,181,99,0.32)]">
              🔐
            </span>
            {titleleft}
          </p>
        )
      }
      <slot name="left" />
    </article>

    <article class="flex flex-col gap-4 text-left text-base leading-relaxed text-[#ece3cf]">
      {
        titleright && (
          <p class="flex items-center gap-3 border-b border-[#dab563]/25 pb-3 text-xl leading-normal font-black tracking-widest text-[#dab563] uppercase">
            <span
              aria-hidden="true"
              class="flex h-9 w-9 shrink-0 items-center justify-center rounded-lg border border-[#dfe4e7]/50 bg-gradient-to-br from-[#f4f7f8] via-[#dfe4e7] to-[#b5bbbc] text-sm text-[#120c04] shadow-[0_5px_15px_rgba(223,228,231,0.3)]">
              🎰
            </span>
            {titleright}
          </p>
        )
      }
      <slot name="right" />
    </article>
  </div>
</section>
