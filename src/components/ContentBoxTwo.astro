---
const { titleleft, titleright } = Astro.props;
---

<section class="relative z-10 mx-auto mb-10 w-full max-w-[1400px] px-4 font-sans">
  <div class="grid grid-cols-1 gap-6 md:grid-cols-2 lg:gap-8">
    <article class="flex flex-col gap-4 text-left text-base leading-relaxed text-[#3a2e18]">
      {
        titleleft && (
          <p class="flex items-center gap-3 border-b border-amber-600/25 pb-3 text-xl leading-normal font-black tracking-widest text-[#8a6410] uppercase">
            <span class="flex h-9 w-9 shrink-0 items-center justify-center rounded-lg border border-amber-600/30 bg-gradient-to-br from-[#f4dfa3] via-[#d9b45c] to-[#a97f2a] text-sm text-[#231a06] shadow-[0_5px_15px_rgba(168,132,44,0.25)]">
              🔐
            </span>
            {titleleft}
          </p>
        )
      }
      <slot name="left" />
    </article>

    <article class="flex flex-col gap-4 text-left text-base leading-relaxed text-[#3a2e18]">
      {
        titleright && (
          <p class="flex items-center gap-3 border-b border-amber-600/25 pb-3 text-xl leading-normal font-black tracking-widest text-[#8a6410] uppercase">
            <span class="flex h-9 w-9 shrink-0 items-center justify-center rounded-lg border border-[#cfd0d2] bg-gradient-to-br from-[#e9eaec] via-[#c6c8cb] to-[#9a9da1] text-sm text-[#2b2b2d] shadow-[0_5px_15px_rgba(168,132,44,0.25)]">
              🎲
            </span>
            {titleright}
          </p>
        )
      }
      <slot name="right" />
    </article>
  </div>
</section>
<style>
  .font-sans {
    font-family: var(--font-sans);
  }
</style>
