---
import kbankLogo from "../assets/banks/kbank.png";
import scbLogo from "../assets/banks/scb.png";
import krungsriLogo from "../assets/banks/krungsri.png";
import ktbLogo from "../assets/banks/ktb.png";
import ttbLogo from "../assets/banks/ttb.png";

const bankPool = [
  { name: "KBank", color: "bg-[#1155cc]", icon: kbankLogo.src },
  { name: "SCB", color: "bg-[#4e1c80]", icon: scbLogo.src },
  { name: "Krungsri", color: "bg-[#fcd34d]", icon: krungsriLogo.src },
  { name: "KTB", color: "bg-[#0ea5e9]", icon: ktbLogo.src },
  { name: "TTB", color: "bg-[#ca8a04]", icon: ttbLogo.src },
];
---

<div class="mx-auto w-full max-w-[1300px] p-4 font-sans">
  <div class="relative overflow-hidden rounded-[30px] border-2 border-amber-600/25 bg-[#fffdf7]/92 px-4 py-8 shadow-[0_10px_30px_rgba(168,132,44,0.18)] backdrop-blur-md md:p-10">
    <div class="pointer-events-none absolute -top-10 left-1/2 h-32 w-64 -translate-x-1/2 rounded-full bg-amber-300/25 blur-[50px]"></div>

    <div class="relative z-10 mb-8 flex items-center justify-center gap-3">
      <span class="text-2xl">🏆</span>
      <p class="bg-gradient-to-r from-[#7a5a12] via-[#b8912f] to-[#8a6a1f] bg-clip-text text-xl font-black tracking-wide text-transparent md:text-3xl">รายการถอนเงินล่าสุดของสมาชิก WINUP888</p>
      <span class="text-2xl">🏆</span>
    </div>

    <div id="feed-grid" class="relative z-10 grid grid-cols-1 gap-4 md:grid-cols-2"></div>

    <p class="relative z-10 mt-6 text-center text-[11px] tracking-wide text-[#8a7550]">
      ก่อนฝากหรือถอนควรตรวจยอด ช่องทาง และชื่อบัญชีรับเงินให้ตรงกับข้อมูลสมาชิก หากรายการยังประมวลผลอยู่ไม่ควรกดซ้ำทันที
    </p>
  </div>
</div>

<script define:vars={{ bankPool }}>
  const feed = document.getElementById("feed-grid");
  const getRandomStr = (len, chars) =>
    Array.from({ length: len })
      .map(() => chars.charAt(Math.floor(Math.random() * chars.length)))
      .join("");
  const getAmount = () => (Math.floor(Math.random() * (95000 - 15000 + 1)) + 15000).toLocaleString("en-US");

  const createHTML = () => {
    const bank = bankPool[Math.floor(Math.random() * bankPool.length)];
    const user = `${getRandomStr(2, "abcdefghijklmnopqrstuvwxyz")}***${getRandomStr(4, "0123456789")}`;
    const isPending = Math.random() > 0.6;

    const statusClass = isPending ? "text-[#6b5836] bg-[#f4ecd8] animate-pulse" : "text-[#231a06] bg-gradient-to-r from-[#f4dfa3] via-[#d9b45c] to-[#a97f2a] font-black shadow-md";
    const statusText = isPending ? "กำลังดำเนินการ" : "ถอนสำเร็จแล้ว";

    return `
      <div class="winner-card transform scale-95 opacity-0 transition-all duration-500 ease-out">
        <div class="flex flex-col rounded-[20px] border border-amber-600/25 bg-[#faf4e6]/95 p-5 shadow-sm transition-all hover:border-amber-600/50 hover:bg-[#f4ecd8]/90">
          <div class="flex justify-between items-start mb-4">
            <div class="flex h-10 w-10 items-center justify-center rounded-full ${bank.color} shadow-inner border border-black/10">
              <img src="${bank.icon}" alt="โลโก้ธนาคาร ${bank.name} รายการถอนเงินของสมาชิก WINUP888" class="h-6 w-6 object-contain" />
            </div>
            <div class="rounded-full px-3 py-1 text-[10px] ${statusClass}">${statusText}</div>
          </div>
          <div>
            <div class="text-sm text-[#6b5836]">ยูสเซอร์: <span class="font-bold text-[#3a2e18]">${user}</span></div>
            <div class="mt-1 text-2xl font-black text-[#a07c1f]">${getAmount()} <span class="text-xs text-[#8a7550]">THB</span></div>
          </div>
        </div>
      </div>
    `;
  };

  const trigger = () => {
    const tempDiv = document.createElement("div");
    tempDiv.innerHTML = createHTML();
    const newEl = tempDiv.firstElementChild;
    feed.prepend(newEl);
    setTimeout(() => {
      newEl.classList.remove("scale-95", "opacity-0");
      newEl.classList.add("scale-100", "opacity-100");
    }, 50);
    if (feed.children.length > 4) {
      const last = feed.lastElementChild;
      last.classList.remove("scale-100", "opacity-100");
      last.classList.add("scale-95", "opacity-0");
      setTimeout(() => last.remove(), 500);
    }
  };
  for (let i = 0; i < 4; i++) {
    trigger();
  }
  setInterval(trigger, 5000);
</script>
<style>
  .font-sans {
    font-family: var(--font-sans);
  }
</style>
