---
import { isActivePath } from "../lib/nav";
import { Picture } from "astro:assets";
const images = import.meta.glob<{ default: ImageMetadata }>("../assets/logo.{png,webp,jpg}", { eager: true });

const imagePaths = Object.keys(images);
const mainLogo = imagePaths.length > 0 ? images[imagePaths[0]].default : null;

const currentPath = Astro.url.pathname;

const isActive = (path: string) => isActivePath(currentPath, path);

// One array, rendered twice (rail + drawer). Icons live beside the label and
// are emitted in their own aria-hidden span, never concatenated into the text —
// otherwise a screen reader announces the menu as "house หน้าแรก".
const links = [
  { name: "หน้าแรก", path: "/", icon: "🏠" },
  { name: "โปรโมชั่น", path: "/promotion", icon: "🎁" },
  { name: "ทดลองเล่น", path: "/ทดลองเล่น", icon: "🎰" },
  { name: "ทางเข้า", path: "/ทางเข้า", icon: "🐰" },
  { name: "เกี่ยวกับเรา", path: "/about-us", icon: "💗" },
  { name: "ติดต่อเรา", path: "/contact-us", icon: "📞" },
];

const logoAlt = "โลโก้ BUNNY555 ตัวอักษรอวบสีชมพูหวานไล่เฉดขาว คำว่า BUNNY ต่อด้วยเลข 555 สีขาวมุกขอบชมพู";
---

<header class="sticky top-0 z-50 w-full font-sans shadow-lg">
  <div class="pointer-events-none absolute top-0 left-0 z-50 hidden h-0 w-full items-start justify-center lg:flex">
    <div
      class="pointer-events-auto flex h-[65px] w-[120px] items-center justify-center rounded-b-3xl border-x border-b border-[#ff4d9d] bg-gradient-to-b from-[#3a0818] to-[#150207] shadow-[0_5px_15px_rgba(255,77,157,0.35)]">
      <a href="/" class="drop-shadow-[0_0_8px_rgba(255,194,218,0.45)] transition-transform hover:scale-110">
        <Picture
          src={mainLogo!}
          alt={logoAlt}
          loading="eager"
          fetchpriority="high"
          widths={[100, 200, 300]}
          sizes="100px"
          class="h-[35px] w-auto"
          formats={["avif", "webp"]}
          fallbackFormat="webp"
        />
      </a>
    </div>
  </div>

  <aside
    class="fixed top-1/2 left-3 z-40 hidden h-[500px] w-[90px] -translate-y-1/2 flex-col items-center justify-center rounded-2xl border border-[#ff4d9d]/40 bg-[#26050f]/95 p-2 shadow-[5px_0_20px_rgba(0,0,0,0.6)] backdrop-blur-md lg:flex"
    aria-label="เมนูหลัก">
    <div class="relative flex h-full w-full flex-col gap-2 overflow-hidden rounded-xl">
      {
        links.map((link) => (
          <a
            href={link.path}
            class={`group relative flex h-full w-full flex-col items-center justify-center rounded-lg transition-all ${isActive(link.path) ? "bg-[#3a0818]" : "hover:bg-[#3a0818]/70"}`}>
            <span aria-hidden="true" class="mb-1 text-3xl drop-shadow-md transition-transform group-hover:scale-110">
              {link.icon ?? "🔗"}
            </span>
            <span class={`text-xs font-bold transition-colors ${isActive(link.path) ? "text-[#ffc2da]" : "text-[#e0a5bd] group-hover:text-[#ffc2da]"}`}>{link.name}</span>
            <div
              aria-hidden="true"
              class={`absolute top-0 left-0 h-full w-[3px] origin-top bg-[#ff4d9d] transition-transform duration-300 ${isActive(link.path) ? "scale-y-100" : "scale-y-0 group-hover:scale-y-100"}`}
            />
          </a>
        ))
      }
    </div>
  </aside>

  <nav class="relative z-40 flex h-[60px] items-center justify-between border-b border-[#ff4d9d]/35 bg-[#150207] px-3 shadow-xl lg:hidden">
    <button id="hamburger-btn" class="flex flex-col items-center justify-center space-y-1.5 p-2" aria-label="เปิดเมนู">
      <span class="hamburger-line h-0.5 w-6 origin-center bg-[#ffc2da] transition-all duration-300"></span>
      <span class="hamburger-line h-0.5 w-6 bg-[#ffc2da] transition-all duration-300"></span>
      <span class="hamburger-line h-0.5 w-6 origin-center bg-[#ffc2da] transition-all duration-300"></span>
    </button>

    <a href="/" class="flex-shrink-0 transition-transform hover:scale-105">
      <Picture
        src={mainLogo!}
        alt={logoAlt}
        loading="eager"
        fetchpriority="high"
        widths={[85, 170, 255]}
        sizes="85px"
        class="h-[30px] w-auto drop-shadow-md"
        formats={["avif", "webp"]}
        fallbackFormat="webp"
      />
    </a>

    <a
      href="/login"
      class="flex h-[32px] items-center justify-center rounded border border-[#ff4d9d]/60 bg-gradient-to-r from-[#ffc2da] to-[#f02e7f] px-4 text-xs font-bold text-[#26050f] shadow-[0_0_12px_rgba(255,77,157,0.35)] transition-transform active:scale-95">
      เข้าสู่ระบบ
    </a>
  </nav>

  <div id="mobile-overlay" class="pointer-events-none fixed inset-0 z-30 bg-black/80 opacity-0 backdrop-blur-sm transition-opacity duration-300 lg:hidden"></div>

  <div
    id="mobile-sidebar"
    class="fixed top-0 left-0 z-50 h-screen w-[260px] -translate-x-full transform overflow-y-auto border-r border-[#ff4d9d]/30 bg-[#150207] shadow-[10px_0_30px_rgba(0,0,0,0.8)] transition-transform duration-300 ease-out lg:hidden">
    <div class="flex flex-col space-y-2.5 px-4 pt-16 pb-8">
      {
        links.map((link) => (
          <a
            href={link.path}
            class={`sidebar-item flex items-center rounded-lg border px-4 py-3 transition-all ${isActive(link.path) ? "border-[#ff4d9d] bg-[#3a0818] text-[#ffc2da] shadow-inner" : "border-transparent bg-white/5 text-[#e0a5bd] hover:bg-white/10 hover:text-[#ffc2da]"}`}>
            <span aria-hidden="true" class="mr-3 text-xl">
              {link.icon ?? "🔗"}
            </span>
            <span class="text-sm font-bold">{link.name}</span>
          </a>
        ))
      }

      <div class="mt-5 flex flex-col gap-2 border-t border-[#ff4d9d]/25 pt-5">
        <a
          href="/register"
          class="sidebar-item flex justify-center gap-1.5 rounded border border-[#ff4d9d]/60 bg-gradient-to-r from-[#ffc2da] via-[#ff4d9d] to-[#a3134f] py-3 text-sm font-bold text-[#26050f] shadow-md transition-transform active:scale-95">
          <span aria-hidden="true">🐰</span> สมัครสมาชิกใหม่
        </a>
      </div>
    </div>
  </div>

  <div class="fixed top-4 right-6 z-50 hidden items-center gap-3 lg:flex">
    <a
      href="/login"
      class="group flex items-center gap-1.5 rounded border border-[#ff4d9d]/60 bg-[#26050f]/90 px-6 py-2 text-sm font-bold text-[#ffc2da] shadow-md backdrop-blur-sm transition-all hover:border-[#ff4d9d] hover:bg-[#3a0818]/90">
      <span aria-hidden="true">🔒</span> เข้าสู่ระบบ
    </a>
    <a
      href="/register"
      class="group flex items-center gap-1.5 rounded border border-[#ff4d9d]/60 bg-gradient-to-r from-[#ffc2da] via-[#ff4d9d] to-[#a3134f] px-6 py-2 text-sm font-bold text-[#26050f] shadow-[0_0_15px_rgba(255,77,157,0.35)] transition-all hover:scale-105">
      <span aria-hidden="true">👤</span> สมัครสมาชิก
    </a>
  </div>
</header>

<div class="hidden h-[15px] w-full lg:block"></div>

<style is:global>
  /* Hamburger กลายเป็น X */
  #hamburger-btn.active .hamburger-line:nth-child(1) {
    transform: translateY(8px) rotate(45deg);
  }
  #hamburger-btn.active .hamburger-line:nth-child(2) {
    opacity: 0;
    transform: scaleX(0);
  }
  #hamburger-btn.active .hamburger-line:nth-child(3) {
    transform: translateY(-8px) rotate(-45deg);
  }

  /* อนิเมชั่นเด้งไล่ระดับของเมนูใน Sidebar */
  .sidebar-item {
    opacity: 0;
    transform: translateX(-20px);
    transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
  }
  .sidebar-item.item-show {
    opacity: 1;
    transform: translateX(0);
  }

  .sidebar-item:nth-child(1) {
    transition-delay: 0.1s;
  }
  .sidebar-item:nth-child(2) {
    transition-delay: 0.15s;
  }
  .sidebar-item:nth-child(3) {
    transition-delay: 0.2s;
  }
  .sidebar-item:nth-child(4) {
    transition-delay: 0.25s;
  }
  .sidebar-item:nth-child(5) {
    transition-delay: 0.3s;
  }
  .sidebar-item:nth-child(6) {
    transition-delay: 0.35s;
  }
  .sidebar-item:nth-child(7) {
    transition-delay: 0.4s;
  }

  @media (prefers-reduced-motion: reduce) {
    .sidebar-item {
      opacity: 1;
      transform: none;
      transition: none;
    }
  }
</style>

<script>
  const hamburgerBtn = document.getElementById("hamburger-btn");
  const overlay = document.getElementById("mobile-overlay");
  const sidebar = document.getElementById("mobile-sidebar");
  const sidebarItems = document.querySelectorAll(".sidebar-item");

  const toggleSidebar = () => {
    hamburgerBtn?.classList.toggle("active");
    sidebar?.classList.toggle("-translate-x-full");
    sidebar?.classList.toggle("translate-x-0");
    overlay?.classList.toggle("opacity-0");
    overlay?.classList.toggle("opacity-100");
    overlay?.classList.toggle("pointer-events-none");
    overlay?.classList.toggle("pointer-events-auto");

    if (sidebar?.classList.contains("translate-x-0")) {
      document.body.style.overflow = "hidden";
      sidebarItems.forEach((item) => item.classList.add("item-show"));
    } else {
      document.body.style.overflow = "";
      sidebarItems.forEach((item) => item.classList.remove("item-show"));
    }
  };

  hamburgerBtn?.addEventListener("click", toggleSidebar);
  overlay?.addEventListener("click", toggleSidebar);

  sidebarItems.forEach((item) => {
    item.addEventListener("click", () => {
      if (sidebar?.classList.contains("translate-x-0")) {
        toggleSidebar();
      }
    });
  });
</script>
