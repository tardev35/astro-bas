---
export interface FaqItem {
  q: string;
  a: string;
}

export interface Props {
  title?: string;
  faqs?: FaqItem[];
}

const { title = "คำถามที่พบบ่อยเกี่ยวกับ BUNNY555", faqs = [] } = Astro.props;
---

<div class="mx-auto max-w-[1000px] px-4 py-10 font-sans">
  <div
    class="mb-8 flex items-center gap-3 border-l-4 border-pink-500 bg-gradient-to-r from-rose-900/40 via-rose-900/10 to-transparent px-4 py-2.5"
    style="clip-path: polygon(0 0, 100% 0, calc(100% - 15px) 100%, 0 100%);">
    <h2 class="text-xl font-black tracking-widest text-pink-300 uppercase drop-shadow-[0_0_8px_rgba(236,72,153,0.35)] md:text-2xl">{title}</h2>
  </div>

  <div class="space-y-4">
    {
      faqs.map((faq) => (
        <div
          class="faq-item group relative overflow-hidden border border-pink-500/30 bg-[#170a10]/80 backdrop-blur-sm transition-all duration-300 hover:border-pink-400 hover:shadow-[0_0_20px_rgba(236,72,153,0.2)]"
          style="clip-path: polygon(15px 0, 100% 0, 100% calc(100% - 15px), calc(100% - 15px) 100%, 0 100%, 0 15px);">
          <div class="absolute top-0 left-0 h-[2px] w-16 bg-gradient-to-r from-pink-500 to-transparent" />

          <button class="faq-trigger flex w-full items-center justify-between p-5 text-left transition-all">
            <span class="flex items-center gap-2 text-sm font-bold text-white/90 transition-colors group-hover:text-pink-300 md:text-lg">
              <span class="font-mono text-pink-400" aria-hidden="true">&gt;_</span> {faq.q}
            </span>

            <span
              class="icon ml-4 flex h-8 w-8 shrink-0 items-center justify-center border border-pink-500/40 bg-[#881337]/50 text-pink-400 transition-all duration-300 group-hover:border-pink-200 group-hover:text-pink-200 group-hover:shadow-[0_0_10px_rgba(236,72,153,0.5)]"
              style="clip-path: polygon(25% 0, 100% 0, 100% 75%, 75% 100%, 0 100%, 0 25%);">
              <i class="fa-solid fa-plus text-xs" />
            </span>
          </button>

          <div class="faq-content max-h-0 overflow-hidden transition-all duration-300 ease-in-out">
            <div class="border-t border-pink-500/20 p-5 pt-0 text-left text-base leading-relaxed text-pink-50/75">{faq.a}</div>
          </div>
        </div>
      ))
    }
  </div>
</div>

<script>
  const triggers = document.querySelectorAll(".faq-trigger");
  triggers.forEach((trigger) => {
    trigger.addEventListener("click", () => {
      const parent = trigger.parentElement;
      const content = trigger.nextElementSibling;
      const icon = trigger.querySelector(".icon");

      document.querySelectorAll(".faq-item").forEach((item) => {
        if (item !== parent) {
          item.classList.remove("active");
          (item.querySelector(".faq-content") as HTMLElement).style.maxHeight = "0";
          item.querySelector(".icon")?.classList.remove("rotate-45");
        }
      });

      parent?.classList.toggle("active");
      if (parent?.classList.contains("active")) {
        (content as HTMLElement).style.maxHeight = content?.scrollHeight + "px";
        icon?.classList.add("rotate-45");
      } else {
        (content as HTMLElement).style.maxHeight = "0";
        icon?.classList.remove("rotate-45");
      }
    });
  });
</script>

<style>
  .font-sans {
    font-family: var(--font-sans);
  }
  .font-mono {
    font-family: var(--font-sans);
  }
  .rotate-45 {
    transform: rotate(45deg);
    border-color: #ec4899 !important;
    color: #ec4899 !important;
  }
  .faq-item.active {
    border-color: rgba(236, 72, 153, 0.6);
    box-shadow: 0 0 20px rgba(236, 72, 153, 0.5);
  }
</style>
