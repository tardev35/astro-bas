---
import kbankLogo from "../assets/banks/kbank.png";
import scbLogo from "../assets/banks/scb.png";
import krungsriLogo from "../assets/banks/krungsri.png";
import ktbLogo from "../assets/banks/ktb.png";

const bankPool = [
  { name: "KBank", color: "bg-[#1155cc]", icon: kbankLogo.src },
  { name: "SCB", color: "bg-[#4e1c80]", icon: scbLogo.src },
  { name: "Krungsri", color: "bg-[#fcd34d]", icon: krungsriLogo.src },
  { name: "KTB", color: "bg-[#0ea5e9]", icon: ktbLogo.src },
];
---

<div class="relative z-10 mx-auto mb-10 w-full max-w-[1400px] px-4 font-sans">
  <div class="relative overflow-hidden rounded-3xl border border-[#f5c53d]/35 bg-[#0d0804]/88 shadow-[0_10px_40px_rgba(8,5,3,0.85)] backdrop-blur-xl">
    <div class="relative z-10 flex flex-col gap-4 border-b border-[#f5c53d]/30 px-5 py-5 sm:flex-row sm:items-center sm:justify-between md:px-8">
      <div class="flex items-center gap-3">
        <span class="flex h-10 w-10 items-center justify-center rounded-full border border-[#f5c53d]/35 bg-[#240709] text-2xl text-[#f5c53d]">🏆</span>
        <div class="flex flex-col">
          <p class="text-2xl font-black tracking-widest text-[#ece2cc] drop-shadow-sm">
            รายการถอนเงินล่าสุด SUDYOD<span class="text-[#f5c53d]">888</span>
          </p>
          <span class="text-[11px] font-medium tracking-wide text-[#b8ab92]">อัปเดตอัตโนมัติจากระบบฝากถอนออโต้ ผ่าน Mobile Banking และ True Wallet</span>
        </div>
      </div>
      <div class="flex items-center gap-2 self-start rounded-full border border-green-500/40 bg-green-900/20 px-3 py-1.5 sm:self-auto">
        <span class="h-1.5 w-1.5 animate-pulse rounded-full bg-green-400 shadow-[0_0_8px_rgba(74,222,128,0.8)]"></span>
        <span class="text-[10px] font-bold tracking-widest text-green-400 uppercase">Live</span>
      </div>
    </div>

    <div class="relative z-10 grid grid-cols-2 gap-px overflow-hidden border-b border-[#f5c53d]/20 bg-[#1e1409]/40 sm:grid-cols-3">
      <div class="flex flex-col items-center gap-1 bg-[#0d0804] px-4 py-4">
        <span class="text-[11px] font-medium tracking-wide text-[#b8ab92]">ยอดถอนรวมวันนี้</span>
        <span id="hud-total" class="bg-gradient-to-r from-[#ffe9a8] to-[#c8921e] bg-clip-text font-mono text-lg font-black text-transparent sm:text-xl">฿0</span>
      </div>
      <div class="flex flex-col items-center gap-1 bg-[#0d0804] px-4 py-4">
        <span class="text-[11px] font-medium tracking-wide text-[#b8ab92]">รายการสำเร็จวันนี้</span>
        <span id="hud-count" class="font-mono text-lg font-black text-[#ece2cc] sm:text-xl">0</span>
      </div>
      <div class="col-span-2 flex flex-col items-center gap-1 bg-[#0d0804] px-4 py-4 sm:col-span-1">
        <span class="text-[11px] font-medium tracking-wide text-[#b8ab92]">ถอนได้ต่อรายการ</span>
        <span class="font-mono text-lg font-black text-[#ece2cc] sm:text-xl">฿100–49,000</span>
      </div>
    </div>

    <div class="relative z-10 hidden grid-cols-[2fr_1.3fr_1fr_0.8fr] gap-4 px-8 pt-4 text-[11px] font-bold tracking-widest text-[#8f7f63] uppercase sm:grid">
      <span>ผู้ใช้งาน</span>
      <span>สถานะ</span>
      <span class="text-right">จำนวนเงิน</span>
      <span class="text-right">เวลา</span>
    </div>

    <div id="feed-sumo-hud" class="relative z-10 flex h-[380px] flex-col gap-2 overflow-hidden px-4 py-4 md:px-8"></div>
  </div>
</div>

<script define:vars={{ bankPool }}>
  const feed = document.getElementById("feed-sumo-hud");
  const hudTotal = document.getElementById("hud-total");
  const hudCount = document.getElementById("hud-count");

  const getRandomStr = (len, chars) =>
    Array.from({ length: len })
      .map(() => chars.charAt(Math.floor(Math.random() * chars.length)))
      .join("");
  const getAmount = () => Math.floor(Math.random() * (49000 - 100 + 1)) + 100;

  let runningTotal = 0;
  let runningCount = 0;

  const createRow = () => {
    const bank = bankPool[Math.floor(Math.random() * bankPool.length)];
    const user = `0${getRandomStr(1, "89")}***${getRandomStr(4, "0123456789")}`;
    const amount = getAmount();
    const isBigWin = amount > 40000;

    runningTotal += amount;
    runningCount += 1;

    const statusClass = isBigWin ? "text-[#f5c53d] font-black" : "text-green-400 font-bold";
    const statusText = isBigWin ? "🔥 ถอนยอดใหญ่สำเร็จ" : "✓ ถอนสำเร็จ";
    const rowBorder = isBigWin ? "border-[#f5c53d]/50 shadow-[0_0_15px_rgba(245,197,61,0.2)]" : "border-[#f5c53d]/15";

    return `
      <div class="winner-row origin-top -translate-y-3 transform opacity-0 transition-all duration-500 ease-out">
        <div class="grid grid-cols-[auto_1fr] items-center gap-4 rounded-xl border ${rowBorder} bg-[#140d06]/88 p-3.5 shadow-sm transition-colors duration-300 hover:border-[#f5c53d]/60 hover:bg-[#1e1409] sm:grid-cols-[2fr_1.3fr_1fr_0.8fr]">
          <div class="col-span-2 flex items-center gap-3 sm:col-span-1">
            <div class="flex h-9 w-9 shrink-0 items-center justify-center rounded-full border border-white/10 ${bank.color} shadow-inner">
              <img src="${bank.icon}" alt="${bank.name}" class="h-5 w-5 object-contain grayscale" />
            </div>
            <span class="font-mono text-sm font-bold text-[#ece2cc]">${user}</span>
          </div>
          <div class="text-[11px] tracking-wide ${statusClass} sm:text-xs">${statusText}</div>
          <div class="text-right font-mono text-base font-black text-transparent bg-clip-text bg-gradient-to-r from-[#ffe9a8] to-[#c8921e] sm:text-lg">
            ฿${amount.toLocaleString("en-US")}
          </div>
          <div class="text-right text-[11px] font-medium text-[#8f7f63] sm:text-xs">เมื่อสักครู่</div>
        </div>
      </div>
    `;
  };

  const trigger = () => {
    if (!feed) return;
    const tempDiv = document.createElement("div");
    tempDiv.innerHTML = createRow();
    const newEl = tempDiv.firstElementChild;
    feed.prepend(newEl);

    if (hudTotal) hudTotal.textContent = `฿${runningTotal.toLocaleString("en-US")}`;
    if (hudCount) hudCount.textContent = runningCount.toLocaleString("en-US");

    requestAnimationFrame(() => {
      newEl.classList.remove("-translate-y-3", "opacity-0");
      newEl.classList.add("translate-y-0", "opacity-100");
    });

    if (feed.children.length > 5) {
      const last = feed.lastElementChild;
      last.classList.add("opacity-0");
      setTimeout(() => last.remove(), 400);
    }
  };

  for (let i = 0; i < 5; i++) trigger();
  setInterval(trigger, 3500);
</script>
<style>
  .font-sans {
    font-family: var(--font-sans);
  }
  .font-mono {
    font-family: var(--font-sans);
  }
</style>
