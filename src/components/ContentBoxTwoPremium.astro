---
export interface Props {
  titleleft?: string;
  titleright?: string;
  label?: string;
}
const { titleleft, titleright, label } = Astro.props;

// `label` is the escape hatch for a chrome use of this box. The login/register
// CTA pair is furniture, not a docx section, so index.astro passes NO title
// props and puts each column's label inside the slot as a <p> carrying these
// same classes — the section gets its accessible name from `label` instead of
// from a heading it is not entitled to.
const sectionLabel = label ?? titleleft ?? titleright;
---

<section aria-label={sectionLabel} class="relative z-10 mx-auto mb-8 w-full max-w-7xl px-4 font-sans">
  <div
    class="group relative isolate w-full overflow-hidden rounded-3xl border border-[#faad23]/30 bg-[#2b0204]/92 p-8 text-[#ffe9c4] shadow-[0_10px_30px_rgba(26,1,6,0.85)] backdrop-blur-xl transition-all duration-500 hover:border-[#faad23]/55 hover:shadow-[0_15px_40px_rgba(250,173,35,0.24)] md:p-10">
    <div class="pointer-events-none absolute inset-0 -z-10 bg-gradient-to-br from-[#7a0426]/45 to-transparent opacity-70"></div>

    <div class="grid grid-cols-1 gap-10 md:grid-cols-2">
      <article class="flex flex-col gap-4 text-left text-base leading-relaxed text-[#ffe9c4]">
        {
          titleleft && (
            <h2 class="flex items-center gap-3 border-b border-[#faad23]/30 pb-3 text-xl leading-normal font-black tracking-widest text-[#ffd84d] uppercase">
              <span aria-hidden="true" class="h-6 w-1.5 shrink-0 rounded-full bg-gradient-to-b from-[#ffd84d] via-[#faad23] to-[#b8760f] shadow-[0_0_10px_rgba(250,173,35,0.45)]" />
              {titleleft}
            </h2>
          )
        }
        <slot name="left" />
      </article>

      <article class="flex flex-col gap-4 text-left text-base leading-relaxed text-[#ffe9c4] md:border-l md:border-[#7a0426] md:pl-10">
        {
          titleright && (
            <h2 class="flex items-center gap-3 border-b border-[#ff3d8a]/35 pb-3 text-xl leading-normal font-black tracking-widest text-[#ff3d8a] uppercase">
              <span aria-hidden="true" class="h-6 w-1.5 shrink-0 rounded-full bg-gradient-to-b from-[#ff3d8a] via-[#e01b5d] to-[#7a0426] shadow-[0_0_10px_rgba(224,27,93,0.5)]" />
              {titleright}
            </h2>
          )
        }
        <slot name="right" />
      </article>
    </div>
  </div>
</section>
