---
const { titleleft, titleright } = Astro.props;
---

<section class="mx-auto mb-8 w-full max-w-7xl px-4 font-sans">
  <div
    class="group relative isolate w-full overflow-hidden rounded-3xl border border-amber-400/35 bg-[#12100a]/85 p-8 text-amber-50/85 shadow-[0_10px_30px_rgba(0,0,0,0.8)] backdrop-blur-xl transition-all duration-500 hover:border-amber-300/60 hover:shadow-[0_15px_40px_rgba(212,175,90,0.35)] md:p-10">
    <div class="pointer-events-none absolute inset-0 -z-10 bg-gradient-to-br from-amber-700/12 to-transparent opacity-60"></div>

    <div class="grid grid-cols-1 gap-10 md:grid-cols-2">
      <article class="flex flex-col gap-4 text-left text-base leading-relaxed text-amber-50/85">
        {
          titleleft && (
            <h2 class="flex items-center gap-3 border-b border-amber-400/35 pb-3 text-xl leading-normal font-black tracking-widest text-amber-200 uppercase">
              <span aria-hidden="true" class="h-6 w-1.5 shrink-0 rounded-full bg-gradient-to-b from-[#f6e4b4] via-[#e0bd72] to-[#b1873a] shadow-[0_0_10px_rgba(212,175,90,0.5)]" />
              {titleleft}
            </h2>
          )
        }
        <slot name="left" />
      </article>

      <article class="flex flex-col gap-4 text-left text-base leading-relaxed text-amber-50/85 md:border-l md:border-amber-400/30 md:pl-10">
        {
          titleright && (
            <h2 class="flex items-center gap-3 border-b border-amber-400/35 pb-3 text-xl leading-normal font-black tracking-widest text-amber-200 uppercase">
              <span aria-hidden="true" class="h-6 w-1.5 shrink-0 rounded-full bg-gradient-to-b from-[#f6e4b4] via-[#e0bd72] to-[#b1873a] shadow-[0_0_10px_rgba(212,175,90,0.5)]" />
              {titleright}
            </h2>
          )
        }
        <slot name="right" />
      </article>
    </div>
  </div>
</section>

<style>
  .font-sans {
    font-family: var(--font-sans);
  }
</style>
