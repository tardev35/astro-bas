---
export interface Props {
  titleleft?: string;
  titleright?: string;
  label?: string;
}
const { titleleft, titleright, label } = Astro.props;

// `label` is the escape hatch for a chrome use of this box. The login/register
// CTA pair is furniture, not a docx section, so index.astro passes NO title
// props and puts each column's label inside the slot as a <p> carrying these
// same classes — the section gets its accessible name from `label` instead of
// from a heading it is not entitled to.
const sectionLabel = label ?? titleleft ?? titleright;
---

<section aria-label={sectionLabel} class="relative z-10 mx-auto mb-8 w-full max-w-7xl px-4 font-sans">
  <div
    class="group relative isolate w-full overflow-hidden rounded-3xl border border-[#f3c43c]/30 bg-[#171106]/92 p-8 text-[#f0e6cc] shadow-[0_10px_30px_rgba(10,7,4,0.85)] backdrop-blur-xl transition-all duration-500 hover:border-[#f3c43c]/55 hover:shadow-[0_15px_40px_rgba(243,196,60,0.24)] md:p-10">
    <div class="pointer-events-none absolute inset-0 -z-10 bg-gradient-to-br from-[#34230b]/45 to-transparent opacity-70"></div>

    <div class="grid grid-cols-1 gap-10 md:grid-cols-2">
      <article class="flex flex-col gap-4 text-left text-base leading-relaxed text-[#f0e6cc]">
        {
          titleleft && (
            <h2 class="flex items-center gap-3 border-b border-[#f3c43c]/30 pb-3 text-xl leading-normal font-black tracking-widest text-[#fcf6ab] uppercase">
              <span aria-hidden="true" class="h-6 w-1.5 shrink-0 rounded-full bg-gradient-to-b from-[#fcf6ab] via-[#f3c43c] to-[#a8790f] shadow-[0_0_10px_rgba(243,196,60,0.45)]" />
              {titleleft}
            </h2>
          )
        }
        <slot name="left" />
      </article>

      <article class="flex flex-col gap-4 text-left text-base leading-relaxed text-[#f0e6cc] md:border-l md:border-[#34230b] md:pl-10">
        {
          titleright && (
            <h2 class="flex items-center gap-3 border-b border-[#dfe4e7]/35 pb-3 text-xl leading-normal font-black tracking-widest text-[#dfe4e7] uppercase">
              <span aria-hidden="true" class="h-6 w-1.5 shrink-0 rounded-full bg-gradient-to-b from-[#dfe4e7] via-[#b5bbbc] to-[#34230b] shadow-[0_0_10px_rgba(181,187,188,0.5)]" />
              {titleright}
            </h2>
          )
        }
        <slot name="right" />
      </article>
    </div>
  </div>
</section>
