---
export interface FAQ {
  q: string;
  a: string;
}
export interface Props {
  title?: string;
  faqs?: FAQ[];
}

const {
  title = "คำถามที่พบบ่อย (FAQ)",
  faqs = [
    {
      q: "อัตราจ่ายของหวยแต่ละตลาดดูได้ที่ไหน",
      a: "อัตราจ่ายของทุกประเภทการแทงจะแสดงอยู่ในหน้าของแต่ละตลาดหวย และระบบจะแสดงอัตราจ่ายจริงอีกครั้งบนหน้ายืนยันโพยก่อนกดส่งเสมอ",
    },
    { q: "แทงหวยขั้นต่ำกี่บาท", a: "ระบบรองรับการส่งโพยตั้งแต่จำนวนเงินขั้นต่ำที่กำหนดไว้ในแต่ละตลาด สมาชิกสามารถตรวจสอบจำนวนเงินขั้นต่ำและสูงสุดได้จากหน้ารายละเอียดของตลาดนั้นก่อนส่งโพย" },
    {
      q: "มีเลขอั้นหรือเลขเต็มหรือไม่",
      a: "มีตามรอบที่ยอดแทงเข้ามามาก เลขอั้นจะถูกปรับลดอัตราจ่ายลง ส่วนเลขเต็มจะปิดรับในรอบนั้น ทั้งสองรายการแสดงอยู่ในหน้าตลาดหวยและระบบจะแจ้งให้ทราบก่อนยืนยันโพย",
    },
  ],
} = Astro.props;
---

<section class="mx-auto mb-12 w-full max-w-4xl px-4 font-sans">
  <div class="mb-6 text-center">
    <h2 class="bg-gradient-to-r from-amber-200 via-amber-300 to-amber-500 bg-clip-text text-2xl leading-normal font-black tracking-widest text-transparent uppercase drop-shadow-sm">{title}</h2>
  </div>

  <div class="flex flex-col gap-3">
    {
      faqs.map((faq) => (
        <div class="faq-item group overflow-hidden rounded-xl border border-amber-500/25 bg-[#1a0409]/85 backdrop-blur-md transition-all duration-300 hover:border-amber-400/60 hover:shadow-[0_10px_25px_rgba(251,191,36,0.15)]">
          <button class="faq-btn flex w-full items-center justify-between gap-4 p-5 text-left outline-none">
            <h3 class="text-base leading-normal font-bold text-white transition-colors group-hover:text-amber-300">{faq.q}</h3>
            <span class="icon flex h-6 w-6 shrink-0 items-center justify-center rounded-md border border-amber-500/40 bg-[#5f0914] text-sm font-bold text-amber-200 transition-all duration-300 group-hover:bg-[#fbbf24] group-hover:text-[#1a0409]">
              +
            </span>
          </button>
          <div class="faq-content grid grid-rows-[0fr] transition-[grid-template-rows] duration-300 ease-in-out">
            <div class="overflow-hidden">
              <p class="border-t border-amber-500/20 bg-[#0f0206]/70 p-5 text-left text-base leading-relaxed text-amber-50/85">{faq.a}</p>
            </div>
          </div>
        </div>
      ))
    }
  </div>
</section>

<script>
  const faqItems = document.querySelectorAll(".faq-item");
  faqItems.forEach((item) => {
    const btn = item.querySelector(".faq-btn");
    const content = item.querySelector(".faq-content");
    const icon = item.querySelector(".icon");

    btn?.addEventListener("click", () => {
      const isOpen = content?.classList.contains("grid-rows-[1fr]");
      document.querySelectorAll(".faq-content").forEach((c) => c.classList.remove("grid-rows-[1fr]"));
      document.querySelectorAll(".icon").forEach((i) => {
        i.classList.remove("rotate-45", "bg-[#fbbf24]", "text-[#1a0409]");
        i.textContent = "+";
      });
      document.querySelectorAll(".faq-item").forEach((i) => i.classList.remove("border-amber-400/60", "shadow-md"));

      if (!isOpen) {
        content?.classList.add("grid-rows-[1fr]");
        icon?.classList.add("rotate-45", "bg-[#fbbf24]", "text-[#1a0409]");
        item.classList.add("border-amber-400/60", "shadow-md");
      }
    });
  });
</script>
