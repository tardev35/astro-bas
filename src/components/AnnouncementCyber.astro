---
const {
  message = "PHANTOM569 เว็บตรงไม่ผ่านเอเย่นต์ ศูนย์รวมเกมลิขสิทธิ์แท้ Yggdrasil Push Gaming Big Time Gaming • ระบบเสถียร เซิร์ฟเวอร์ความเร็วสูง ไม่มีเกมค้าง ไม่หลุดกลางเกม • จ่ายจริงทุกยอด โอนเต็มจำนวนไม่มีหัก แม้ยอดหลักล้าน • เข้าสู่ระบบผ่าน Secure Transition Popup เข้ารหัสระดับองค์กร ไร้ร่องรอย 100% • ตรวจเงื่อนไขทุกครั้งก่อนกดรับสิทธิ์",
} = Astro.props;
---

<div class="mx-auto w-full max-w-7xl px-4 py-3 font-sans">
  <div
    class="relative flex overflow-hidden border border-[#c084fc]/50 bg-[#080414]/90 shadow-[0_0_15px_rgba(192,132,252,0.3)] backdrop-blur-md"
    style="clip-path: polygon(15px 0, 100% 0, calc(100% - 15px) 100%, 0 100%);">
    <div
      class="relative z-10 flex shrink-0 items-center justify-center bg-gradient-to-r from-[#6b21a8] to-[#c084fc] px-6 py-2.5 font-black text-[#080414]"
      style="clip-path: polygon(0 0, 100% 0, calc(100% - 10px) 100%, 0 100%);">
      ประกาศ
    </div>

    <div class="marquee-container relative flex-1 overflow-hidden py-2.5 pr-6">
      <div class="pointer-events-none absolute top-0 left-0 z-10 h-full w-8 bg-gradient-to-r from-[#080414] to-transparent"></div>

      <div class="marquee-content inline-block pl-4 text-sm font-bold tracking-widest whitespace-nowrap text-[#e4dcf7]">
        <span class="mr-8 inline-flex items-center gap-2"><span class="h-2 w-2 bg-[#a855f7] shadow-[0_0_8px_rgba(168,85,247,1)]"></span>{message}</span>
        <span class="mr-8 inline-flex items-center gap-2"><span class="h-2 w-2 bg-[#a855f7] shadow-[0_0_8px_rgba(168,85,247,1)]"></span>{message}</span>
      </div>
    </div>
  </div>
</div>

<style>
  .marquee-content {
    animation: marquee 20s linear infinite;
  }
  .marquee-container:hover .marquee-content {
    animation-play-state: paused;
  }
  @keyframes marquee {
    0% {
      transform: translateX(0);
    }
    100% {
      transform: translateX(-50%);
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .marquee-content {
      animation: none;
    }
  }
</style>
