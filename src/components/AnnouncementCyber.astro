---
const {
  message = "PGW44 เว็บสล็อตใหม่ล่าสุด ศูนย์รวมค่ายเกมลิขสิทธิ์แท้ Quickspin Evoplay CQ9 • ระบบออโต้ ประมวลผลด้วย AI ฝากถอนไม่มีขั้นต่ำ เสร็จในเสี้ยววินาที • โปรเด็ด กดรับเองผ่านเมนูอัตโนมัติ คืนยอดเสีย 30% ทุกวัน • แนะนำเพื่อนรับค่าคอม 0.8% ไม่อั้นทุกยอด • ปลอดภัยทุกการเชื่อมต่อด้วย Secure Transition Popup • ตรวจเงื่อนไขทุกครั้งก่อนกดรับสิทธิ์",
} = Astro.props;
---

<div class="mx-auto w-full max-w-7xl px-4 py-3 font-sans">
  <div
    class="relative flex overflow-hidden border border-[#f2b40b]/50 bg-[#07120a]/90 shadow-[0_0_15px_rgba(242,180,11,0.3)] backdrop-blur-md"
    style="clip-path: polygon(15px 0, 100% 0, calc(100% - 15px) 100%, 0 100%);">
    <div
      class="relative z-10 flex shrink-0 items-center justify-center bg-gradient-to-r from-[#9c7304] to-[#f2b40b] px-6 py-2.5 font-black text-[#07120a]"
      style="clip-path: polygon(0 0, 100% 0, calc(100% - 10px) 100%, 0 100%);">
      ประกาศ
    </div>

    <div class="marquee-container relative flex-1 overflow-hidden py-2.5 pr-6">
      <div class="pointer-events-none absolute top-0 left-0 z-10 h-full w-8 bg-gradient-to-r from-[#07120a] to-transparent"></div>

      <div class="marquee-content inline-block pl-4 text-sm font-bold tracking-widest whitespace-nowrap text-[#dff5c8]">
        <span class="mr-8 inline-flex items-center gap-2"><span class="h-2 w-2 bg-[#7fdc16] shadow-[0_0_8px_rgba(127,220,22,1)]"></span>{message}</span>
        <span class="mr-8 inline-flex items-center gap-2"><span class="h-2 w-2 bg-[#7fdc16] shadow-[0_0_8px_rgba(127,220,22,1)]"></span>{message}</span>
      </div>
    </div>
  </div>
</div>

<style>
  .marquee-content {
    animation: marquee 20s linear infinite;
  }
  .marquee-container:hover .marquee-content {
    animation-play-state: paused;
  }
  @keyframes marquee {
    0% {
      transform: translateX(0);
    }
    100% {
      transform: translateX(-50%);
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .marquee-content {
      animation: none;
    }
  }
</style>
