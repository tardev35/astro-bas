---
import { Picture } from "astro:assets";

import slide1 from "../assets/slide1.png";
import slide2 from "../assets/slide2.png";

// This used to be Swiper: 158,890 bytes of JavaScript (86,801 of it modules the
// config never touched) to slide four pictures sideways forever. It is a CSS
// animation now — the same technique the announcement ticker already uses — and
// the component ships no JavaScript at all.
//
// Three things improved along with the byte count:
//   * it can be paused. Swiper ran with `delay: 0` and
//     `disableOnInteraction: false`, so nothing a visitor did stopped it.
//   * it respects prefers-reduced-motion, which Swiper's JS-driven transform
//     could not.
//   * the slides are plain markup, so a crawler and a screen reader see all of
//     them instead of whatever Swiper's cloned-slide DOM happened to expose.
// Each banner is described by what it actually says, not by its position in the
// list. "…ภาพที่ 1", "…ภาพที่ 2" told a screen-reader user nothing except that
// there were more pictures; these are promo banners whose whole content IS the
// text printed on them, so that text is the alt.
//
// TWO slides, not three or four: slide3.png (2026-08-06, still carrying the
// TUNJAI123 wordmark) and slide4.png (2026-08-01) predate this brand's asset
// drop (slide1/slide2, 2026-08-07 07:06). Importing either would both ship a
// stale picture and emit its asset into dist/, because an import IS an emit. If
// a future brand uploads a real slide3, add it back here AND redo the --shift
// arithmetic below for N=3.
const images = [
  {
    src: slide1,
    alt: "แบนเนอร์โปรโมชั่น BUNNY555 คืนยอดเสีย 15% ตัวเลขสีขาวขอบชมพูบนพื้นดำโรยเหรียญทอง สาวชุดกระต่ายสีชมพูข้างตู้สล็อต JACKPOT ข้อความ เสียเท่าไหร่ เราคืนให้ 15% พร้อมไอคอนสี่ช่อง ระบบปลอดภัยมาตรฐานสากล คืนยอดเสียอัตโนมัติ เล่นได้ทุกเกมไม่จำกัด บริการลูกค้า 24 ชม. และแถบ เล่นสนุก มั่นใจ ได้เงินจริง",
  },
  {
    src: slide2,
    alt: "แบนเนอร์โปรโมชั่น BUNNY555 ฝากแรกลุ้นรับทอง 1 บาท ตัวอักษรสีชมพูบนพื้นดำโรยเหรียญทอง สาวชุดกระต่ายสีชมพูข้างตู้สล็อต JACKPOT มีทองคำแท่งและสร้อยทองด้านขวา ข้อความ ลุ้นง่าย จ่ายจริง ฟรีทุกยูสเซอร์ พร้อมไอคอนสี่ช่อง ระบบปลอดภัยมาตรฐานสากล ฝาก-ถอนรวดเร็วทันใจ โบนัสจัดเต็มทุกวัน บริการลูกค้า 24 ชม. และแถบ สมัครวันนี้ รับสิทธิ์ลุ้นทองทันที",
  },
];

// Three copies: one on screen, one scrolling in, one covering the reset. The
// animation shifts by exactly one copy, so the loop has no visible seam.
const COPIES = 3;
const slides = Array.from({ length: COPIES }, () => images).flat();

// The pause control below costs nothing visually: the checkbox is reachable by
// keyboard and announced by screen readers, and its label only becomes visible
// once it has focus. Mouse users get the :hover pause in the stylesheet.
// (The note lives in frontmatter because an HTML comment in the template is
// shipped verbatim to every built page.)
//
// Every picture here is lazy/low priority on purpose: the LCP image is the hero
// banner in MainLayout, and a second eager fetchpriority="high" image competes
// with it for the same early bandwidth.
//
// The last two copies are the same two pictures again — decorative repeats that
// exist only so the loop has no seam. alt="" plus aria-hidden on the wrapper
// keeps them out of the accessibility tree; without it the same sentence is
// announced three times.
---

<div class="marquee mx-auto w-full max-w-[1301px] overflow-hidden px-4 py-5">
  <input id="carousel-pause" type="checkbox" class="peer sr-only" />
  <label
    for="carousel-pause"
    class="sr-only cursor-pointer peer-focus-visible:not-sr-only peer-focus-visible:mb-3 peer-focus-visible:inline-block peer-focus-visible:rounded-full peer-focus-visible:border peer-focus-visible:border-[#ff4d9d]/60 peer-focus-visible:px-4 peer-focus-visible:py-2 peer-focus-visible:text-sm peer-focus-visible:font-bold peer-focus-visible:text-[#ffc2da]">
    หยุด / เล่นสไลด์ภาพ
  </label>

  <div class="marquee-track flex">
    {
      slides.map((slide, index) => {
        const isDuplicate = index >= images.length;
        return (
          <div class="marquee-slide" aria-hidden={isDuplicate ? "true" : undefined}>
            <Picture
              src={slide.src}
              alt={isDuplicate ? "" : slide.alt}
              class="block w-full rounded-xl border border-[#ff4d9d]/25 object-cover shadow-[0_10px_30px_rgba(255,77,157,0.22)]"
              width={slide.src.width}
              height={slide.src.height}
              loading="lazy"
              fetchpriority="low"
              decoding="async"
              widths={[200, 400, 600]}
              sizes="(max-width: 768px) 50vw, 33vw"
              formats={["avif", "webp"]}
              fallbackFormat="webp"
              quality={60}
            />
          </div>
        );
      })
    }
  </div>
</div>

<style>
  /* --shift is one full copy of the image set: the slides in one copy plus the
     gaps that follow them, measured against the track's width (which is the
     container's width — the slides overflow it, which is the point). Getting
     this wrong by a pixel is what makes a marquee visibly jump on every loop.

     With N slides per copy, P per view and gap g:
       copy width = N * (100% - (P-1)*g) / P + N*g
     This brand ships N=2 (slide1 + slide2; slide3/slide4 belong to previous
     brands — see the frontmatter note):
     mobile  N=2 P=2 g=12px -> 100% + 12px
     desktop N=2 P=3 g=16px -> 200%/3 + 32px/3 */
  .marquee {
    --gap: 12px;
    --per-view: 2;
    --shift: calc(-100% - 12px);
  }

  @media (min-width: 768px) {
    .marquee {
      --gap: 16px;
      --per-view: 3;
      --shift: calc(-200% / 3 - 32px / 3);
    }
  }

  .marquee-track {
    gap: var(--gap);
    width: 100%;
    animation: carousel-scroll 32s linear infinite;
    will-change: transform;
  }

  .marquee-slide {
    flex: 0 0 calc((100% - (var(--per-view) - 1) * var(--gap)) / var(--per-view));
  }

  @keyframes carousel-scroll {
    from {
      transform: translateX(0);
    }
    to {
      transform: translateX(var(--shift));
    }
  }

  .marquee:hover .marquee-track,
  .marquee:focus-within .marquee-track,
  .marquee > input:checked ~ .marquee-track {
    animation-play-state: paused;
  }

  /* `animation: none` rather than a paused state, and not just the global
     reduced-motion rule in global.css: that rule collapses the duration to
     0.01ms, which would snap the strip to its END position instead of leaving
     it where it started. Killing the animation outright is the correct
     behaviour here. */
  @media (prefers-reduced-motion: reduce) {
    .marquee-track {
      animation: none;
    }
  }
</style>
