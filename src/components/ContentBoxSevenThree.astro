---
export interface Props {
  titleleft?: string;
  titleright?: string;
}
const { titleleft, titleright } = Astro.props;
---

<section class="relative z-10 mx-auto mb-10 w-full max-w-[1400px] px-4 font-sans">
  <div
    class="group relative isolate w-full overflow-hidden rounded-3xl border border-[#dfb85f]/30 bg-[#070502]/85 p-8 text-[#e9ddbe] shadow-[0_10px_30px_rgba(7,5,2,0.8)] backdrop-blur-xl transition-all duration-500 hover:border-[#fded9a]/50 md:p-10">
    <div class="grid grid-cols-1 gap-8 md:grid-cols-[3fr_7fr] md:items-center">
      <article class="flex flex-col gap-4 border-b border-[#6b4c17]/70 pb-6 text-left text-base leading-relaxed text-[#e9ddbe] md:border-r md:border-b-0 md:pr-6 md:pb-0">
        {titleleft && <h2 class="text-center text-4xl leading-normal font-black tracking-wider text-[#fded9a] uppercase drop-shadow-[0_2px_10px_rgba(223,184,95,0.35)] md:text-left">{titleleft}</h2>}
        <slot name="left" />
      </article>

      <article class="flex flex-col gap-3 text-left text-base leading-relaxed text-[#e9ddbe] md:pl-6">
        {titleright && <h2 class="flex items-center gap-2 text-2xl leading-normal font-black text-[#dfb85f] drop-shadow-[0_0_8px_rgba(223,184,95,0.35)]">{titleright}</h2>}
        <slot name="right" />
      </article>
    </div>
  </div>
</section>
