---
import { isActivePath } from "../lib/nav";
import { Picture } from "astro:assets";
const images = import.meta.glob<{ default: ImageMetadata }>("../assets/logo.{png,webp,jpg}", { eager: true });

const imagePaths = Object.keys(images);
const mainLogo = imagePaths.length > 0 ? images[imagePaths[0]].default : null;

const currentPath = Astro.url.pathname;

const isActive = (path: string) => isActivePath(currentPath, path);

// เมนูชุดเดียว ใช้ทั้งฝั่งเดสก์ท็อปและลิ้นชักมือถือ — เดิมประกาศไว้สองที่แล้ว
// แก้ที่เดียวลืมอีกที่ได้ง่ายมาก ไอคอนอยู่ในอ็อบเจกต์เดียวกับ name/path และ
// เรนเดอร์เป็น <span aria-hidden> แยกจากตัวหนังสือเสมอ ถ้าเอาไปต่อกับ name
// ตรงๆ โปรแกรมอ่านหน้าจอจะอ่านว่า "house หน้าแรก"
const links = [
  { name: "หน้าแรก", path: "/", icon: "🏠" },
  { name: "โปรโมชั่น", path: "/promotion", icon: "🎁" },
  { name: "ทดลองเล่น", path: "/ทดลองเล่น", icon: "🎰" },
  { name: "ทางเข้า", path: "/ทางเข้า", icon: "🐉" },
  { name: "เกี่ยวกับเรา", path: "/about-us", icon: "🛡️" },
  { name: "ติดต่อเรา", path: "/contact-us", icon: "💬" },
];
---

<nav class="sticky top-0 z-50 w-full border-b border-[#ecab03]/30 bg-[#0a0f06] font-sans shadow-[0_4px_20px_rgba(236,171,3,0.15)] backdrop-blur-md">
  <div class="flex h-[75px] w-full items-center justify-between px-4 xl:px-8">
    <div class="z-50 flex items-center">
      <a href="/" class="group relative flex items-center">
        <div class="absolute inset-0 scale-0 rounded-full bg-[#8fd633]/20 blur-xl transition-transform duration-500 group-hover:scale-150"></div>
        {
          mainLogo ? (
            <Picture
              src={mainLogo}
              alt="PGW44 สล็อตเว็บใหญ่"
              loading="eager"
              fetchpriority="high"
              widths={[110, 220, 330]}
              sizes="110px"
              class="relative h-[40px] w-auto drop-shadow-[0_0_12px_rgba(236,171,3,0.45)] transition-transform group-hover:scale-105 xl:h-[45px]"
              formats={["avif", "webp"]}
              fallbackFormat="webp"
            />
          ) : (
            <p class="relative bg-gradient-to-r from-[#ffd54a] via-[#ecab03] to-[#8fd633] bg-clip-text text-2xl font-black tracking-widest text-transparent uppercase">PGW44</p>
          )
        }
      </a>
    </div>

    <div class="z-10 hidden items-center gap-2 lg:gap-3 xl:flex">
      {
        links.map((item) => (
          <a
            href={item.path}
            class={`group relative skew-x-[-15deg] overflow-hidden border px-5 py-2 transition-all duration-300 ${isActive(item.path) ? "border-[#ecab03] bg-[#4a8d14]/25 shadow-[0_0_15px_rgba(236,171,3,0.35)]" : "border-white/10 bg-white/5 hover:border-[#8fd633]/50"}`}>
            <div
              class={`absolute inset-0 translate-y-full bg-gradient-to-r from-[#2c5a0d] to-[#ecab03] transition-transform duration-300 ${isActive(item.path) ? "translate-y-0 opacity-20" : "opacity-40 group-hover:translate-y-0"}`}
            />
            <span
              class={`relative z-10 block skew-x-[15deg] text-sm font-bold tracking-wide transition-colors ${isActive(item.path) ? "text-[#ffd54a] drop-shadow-[0_0_5px_rgba(236,171,3,0.55)]" : "text-[#b9c4a6] group-hover:text-white"}`}>
              <span aria-hidden="true" class="mr-1">
                {item.icon}
              </span>
              {item.name}
            </span>
          </a>
        ))
      }
    </div>

    <div class="z-50 flex items-center gap-2">
      <button
        id="hamburger-btn"
        class="relative flex h-[45px] w-[45px] flex-col items-center justify-center space-y-1.5 rounded-lg border border-[#ecab03]/30 bg-[#1a2610]/60 p-2 shadow-[0_0_10px_rgba(236,171,3,0.2)] transition-all hover:bg-[#1a2610] xl:hidden"
        aria-label="เปิด/ปิดเมนู">
        <span class="hamburger-line h-[2px] w-6 origin-center bg-[#ffd54a] transition-all duration-300"></span>
        <span class="hamburger-line h-[2px] w-6 bg-[#ffd54a] transition-all duration-300"></span>
        <span class="hamburger-line h-[2px] w-6 origin-center bg-[#ffd54a] transition-all duration-300"></span>
      </button>
    </div>
  </div>

  <div id="mobile-overlay" class="pointer-events-none fixed inset-0 z-30 bg-black/80 opacity-0 backdrop-blur-sm transition-opacity duration-300 xl:hidden"></div>

  <div
    id="mobile-sidebar"
    class="fixed top-0 right-0 z-40 h-screen w-[280px] translate-x-full transform overflow-y-auto border-l border-[#4a8d14]/50 bg-[#0a0f06] shadow-[-10px_0_30px_rgba(0,0,0,0.8)] transition-transform duration-300 ease-out xl:hidden">
    <div class="flex flex-col space-y-3 px-6 pt-24 pb-10">
      {
        links.map((item) => (
          <a
            href={item.path}
            class={`sidebar-item flex items-center rounded-xl border px-4 py-3.5 transition-all ${isActive(item.path) ? "border-[#ecab03] bg-[#4a8d14]/25 text-[#ffd54a] shadow-[inset_4px_0_0_#8fd633]" : "border-transparent bg-white/5 text-[#b9c4a6] hover:bg-white/10 hover:text-white"}`}>
            <span aria-hidden="true" class="mr-3 text-xl">
              {item.icon}
            </span>
            <span class="text-sm font-bold">{item.name}</span>
          </a>
        ))
      }
    </div>
  </div>
</nav>

<style is:global>
  a {
    font-family: var(--font-sans) !important;
  }

  #hamburger-btn.active .hamburger-line:nth-child(1) {
    transform: translateY(8px) rotate(45deg);
    background-color: #8fd633;
  }
  #hamburger-btn.active .hamburger-line:nth-child(2) {
    opacity: 0;
    transform: scaleX(0);
  }
  #hamburger-btn.active .hamburger-line:nth-child(3) {
    transform: translateY(-8px) rotate(-45deg);
    background-color: #8fd633;
  }

  .sidebar-item {
    opacity: 0;
    transform: translateX(20px);
    transition: all 0.4s cubic-bezier(0.4, 0, 0.2, 1);
  }
  .sidebar-item.item-show {
    opacity: 1;
    transform: translateX(0);
  }

  .sidebar-item:nth-child(1) {
    transition-delay: 0.1s;
  }
  .sidebar-item:nth-child(2) {
    transition-delay: 0.15s;
  }
  .sidebar-item:nth-child(3) {
    transition-delay: 0.2s;
  }
  .sidebar-item:nth-child(4) {
    transition-delay: 0.25s;
  }
  .sidebar-item:nth-child(5) {
    transition-delay: 0.3s;
  }
  .sidebar-item:nth-child(6) {
    transition-delay: 0.35s;
  }

  @media (prefers-reduced-motion: reduce) {
    .sidebar-item {
      transition: none;
    }
  }
</style>

<script>
  const hamburgerBtn = document.getElementById("hamburger-btn");
  const overlay = document.getElementById("mobile-overlay");
  const sidebar = document.getElementById("mobile-sidebar");
  const sidebarItems = document.querySelectorAll(".sidebar-item");

  const toggleMenu = () => {
    hamburgerBtn?.classList.toggle("active");
    sidebar?.classList.toggle("translate-x-full");
    sidebar?.classList.toggle("translate-x-0");
    overlay?.classList.toggle("opacity-0");
    overlay?.classList.toggle("opacity-100");
    overlay?.classList.toggle("pointer-events-none");
    overlay?.classList.toggle("pointer-events-auto");

    if (sidebar?.classList.contains("translate-x-0")) {
      document.body.style.overflow = "hidden";
      sidebarItems.forEach((item) => item.classList.add("item-show"));
    } else {
      document.body.style.overflow = "";
      sidebarItems.forEach((item) => item.classList.remove("item-show"));
    }
  };

  hamburgerBtn?.addEventListener("click", toggleMenu);
  overlay?.addEventListener("click", toggleMenu);

  sidebarItems.forEach((item) => {
    item.addEventListener("click", () => {
      if (sidebar?.classList.contains("translate-x-0")) {
        toggleMenu();
      }
    });
  });
</script>
