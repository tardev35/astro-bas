---
import { Picture } from "astro:assets";
import BankStrip from "./BankStrip.astro";
import { BRAND_ADDRESS } from "../lib/brandProfile";
const images = import.meta.glob<{ default: ImageMetadata }>("../assets/logo.{png,webp,jpg}", { eager: true });
const imagePaths = Object.keys(images);
const mainLogo = imagePaths.length > 0 ? images[imagePaths[0]].default : null;

// The address/email block below is pasted verbatim from the skill and carries no
// brand colour on purpose — border-white/15 + bg-black/20 + opacity over the
// footer's inherited text colour land correctly on every footer variant in the
// library, so the next rebrand does not inherit this brand's hex.
//
// Its label is a <p>, never a heading: the footer renders on every page, so one
// <h2> here would be an <h2> sitewide and would break the docx heading diff.
const logoAlt = "โลโก้ ROMAN555 รูปโจ๊กเกอร์สวมหมวกตัวตลกสีม่วงแดงอยู่กลางวงล้อคาสิโนสีทอง ถือไพ่โพดำและโพแดง มีกองเหรียญทอง เหนือตัวอักษร ROMAN555 สีทองขอบเงิน";
---

<footer
  class="relative mt-16 w-full overflow-hidden rounded-t-[3rem] border-t border-[#d99a1c]/40 bg-[#1a0f04] pt-16 pb-8 font-sans text-[#f2e4c4] shadow-[0_-15px_40px_rgba(217,154,28,0.22)]">
  <div aria-hidden="true" class="pointer-events-none absolute inset-x-0 -top-20 mx-auto h-[250px] w-full max-w-4xl rounded-full bg-[#d99a1c]/25 blur-[100px]"></div>

  <div class="relative z-10 mx-auto w-full max-w-[1200px] px-6">
    <div class="mb-12 grid grid-cols-1 gap-12 md:grid-cols-12">
      <div class="flex flex-col gap-5 md:col-span-5">
        <a href="/" class="inline-block transition-transform duration-300 hover:scale-105">
          {
            mainLogo ? (
              <Picture
                src={mainLogo}
                alt={logoAlt}
                widths={[150, 300, 450]}
                sizes="150px"
                class="h-[65px] w-auto drop-shadow-[0_5px_15px_rgba(217,154,28,0.45)]"
                formats={["avif", "webp"]}
                fallbackFormat="webp"
              />
            ) : (
              <span class="bg-gradient-to-r from-[#fbeab0] to-[#7a4405] bg-clip-text text-4xl font-black tracking-widest text-transparent">
                ROMAN<span class="bg-gradient-to-r from-[#f6cf6a] to-[#c02133] bg-clip-text text-transparent">555</span>
              </span>
            )
          }
        </a>
        <p class="border-l-2 border-[#d99a1c]/50 pl-4 text-sm leading-relaxed text-[#f2e4c4]/70">
          ROMAN555 ทางเข้าหลักเว็บตรง สู่อาณาจักรความมั่งคั่งระดับตำนาน รวมเกมจาก ค่ายใหญ่ลิขสิทธิ์แท้ ระดับโลกไว้ในบัญชีเดียว ระบบการเงิน รองรับทรูวอเลท
          เต็มรูปแบบ ฝากถอนอิสระไม่ต้องพึ่งบัญชีธนาคาร ยอดอัปเดตไวในเสี้ยววินาที ดูแลตลอด 24 ชั่วโมง
        </p>
        <div class="mt-4 flex flex-wrap gap-3">
          <span class="rounded-full border border-[#d99a1c]/35 bg-[#241505]/60 px-4 py-1 text-xs font-medium text-[#f6cf6a] backdrop-blur-sm">TRUE WALLET AUTO</span>
          <span class="rounded-full border border-[#c02133]/45 bg-[#241505]/60 px-4 py-1 text-xs font-medium text-[#f0556a] backdrop-blur-sm">SECURE POPUP</span>
        </div>
      </div>

      <nav class="flex flex-col gap-4 md:col-span-3 lg:pl-8" aria-label="ทางลัดหน้าเว็บ">
        <p class="text-lg font-black tracking-widest text-[#fbeab0] uppercase drop-shadow-sm">QUICK LINKS</p>
        <div aria-hidden="true" class="h-[1px] w-12 bg-gradient-to-r from-[#d99a1c] to-[#c02133]"></div>
        <ul class="flex flex-col gap-3 text-sm font-medium text-[#f2e4c4]/70">
          <li><a href="/" class="transition-colors hover:text-[#f6cf6a]">หน้าหลัก (Home)</a></li>
          <li><a href="/promotion" class="transition-colors hover:text-[#f6cf6a]">โปรโมชั่น (Promotions)</a></li>
          <li><a href="/ทางเข้า" class="transition-colors hover:text-[#f6cf6a]">ทางเข้า (Access)</a></li>
          <li><a href="/ทดลองเล่น" class="transition-colors hover:text-[#f6cf6a]">ทดลองเล่น (Demo)</a></li>
          <li><a href="/register" class="transition-colors hover:text-[#f6cf6a]">สมัครสมาชิก (Join Us)</a></li>
          <li><a href="/login" class="transition-colors hover:text-[#f6cf6a]">เข้าสู่ระบบ (Login)</a></li>
          <li><a href="/about-us" class="transition-colors hover:text-[#f6cf6a]">เกี่ยวกับเรา</a></li>
        </ul>
      </nav>

      <div class="flex flex-col gap-5 md:col-span-4">
        <p class="text-lg font-black tracking-widest text-[#fbeab0] uppercase drop-shadow-sm">CUSTOMER SUPPORT</p>
        <div aria-hidden="true" class="h-[1px] w-12 bg-gradient-to-r from-[#c02133] to-[#d99a1c]"></div>

        <a
          href="/line"
          class="flex w-full items-center justify-center gap-2 rounded-xl bg-gradient-to-r from-[#00B900] to-[#009900] py-3.5 font-bold text-white shadow-[0_5px_15px_rgba(0,185,0,0.3)] transition-all hover:-translate-y-1 hover:shadow-[0_8px_20px_rgba(0,185,0,0.4)]">
          ติดต่อแอดมิน LINE
        </a>

        {
          BRAND_ADDRESS.lines.length > 0 && (
            <address aria-label={BRAND_ADDRESS.label} class="mt-2 rounded-xl border border-white/15 bg-black/20 p-4 text-xs leading-relaxed not-italic opacity-90">
              <p class="mb-2 flex items-center gap-2 text-[11px] font-bold tracking-wider uppercase opacity-80">
                <span aria-hidden="true" class="text-sm">
                  📍
                </span>
                {BRAND_ADDRESS.label}
              </p>
              {BRAND_ADDRESS.lines.map((line) => (
                <span class="block">{line}</span>
              ))}
              {BRAND_ADDRESS.email && (
                <a
                  href={`mailto:${BRAND_ADDRESS.email}`}
                  class="mt-3 inline-flex items-center gap-2 font-bold underline decoration-current/40 underline-offset-4 opacity-90 transition-opacity hover:opacity-100">
                  <span aria-hidden="true" class="text-sm">
                    ✉️
                  </span>
                  {BRAND_ADDRESS.email}
                </a>
              )}
            </address>
          )
        }

        <div class="mt-4 text-xs font-medium tracking-widest text-[#f6cf6a]/60 uppercase">Supported Payments</div>
        <BankStrip size={30} />
      </div>
    </div>

    <div class="flex flex-col items-center justify-between border-t border-[#7a4405]/60 pt-8 text-xs font-medium tracking-wide text-[#f2e4c4]/50 md:flex-row">
      <p>COPYRIGHT &copy; {new Date().getFullYear()} ROMAN555. ALL RIGHTS RESERVED.</p>
      <div class="mt-4 flex gap-4 md:mt-0">
        <a href="/terms/" class="transition-colors hover:text-[#f6cf6a]">TERMS &amp; CONDITIONS</a>
        <a href="/privacy/" class="transition-colors hover:text-[#f6cf6a]">PRIVACY POLICY</a>
        <a href="#top" class="transition-colors hover:text-[#f6cf6a]">กลับขึ้นบน</a>
      </div>
    </div>
  </div>
</footer>

<style>
  footer a {
    text-decoration: none;
  }
</style>
