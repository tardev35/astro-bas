---
import ContentBoxTwo from "./ContentBoxTwo.astro";

const menus = [
  { icon: "💥", name: "Hacksaw Gaming", detail: "เกมเพลย์มินิมอลที่ฉีกกฎเดิม อัตราการคูณเงินรางวัลสูงลิ่ว", tag: "โบนัสแตกหนัก" },
  { icon: "🔥", name: "Nolimit City", detail: "ฟีเจอร์แปลกใหม่และจ่ายหนักจัดเต็มในทุกการหมุน", tag: "ขีดสุดแห่งฟีเจอร์" },
  { icon: "🎬", name: "Relax Gaming", detail: "กราฟิกอลังการ ซอฟต์แวร์เบาและเสถียรบนทุกอุปกรณ์", tag: "แอนิเมชันลื่นไหล" },
  { icon: "🌐", name: "คัดกรองมาตรฐานระดับสากล", detail: "ทุกตัวเกมผ่านการคัดกรองก่อนเชื่อมกับเซิร์ฟเวอร์หลัก", tag: "เว็บสล็อตเจ้าใหญ่" },
  { icon: "🎁", name: "แดชบอร์ดกดรับสิทธิ์เอง", detail: "โบนัสต้อนรับและแคมเปญประจำวัน กดรับได้จากหน้าเดียว", tag: "โปรโมชั่นเด็ด" },
  { icon: "👑", name: "ทีมผู้เชี่ยวชาญสแตนด์บาย", detail: "ให้คำปรึกษาและแก้ปัญหาตรงจุดตลอด 24 ชั่วโมง", tag: "บริการระดับ VVIP" },
  { icon: "🛡️", name: "Secure Transition Popup", detail: "โหลดไว ลื่นไหล ป้องกันการรีเฟรชหน้าเว็บซ้ำซ้อน", tag: "Premium Loader" },
];

const chips = ["Hacksaw Gaming", "Nolimit City", "Relax Gaming", "เว็บสล็อตเจ้าใหญ่", "โปรโมชั่นเด็ด", "บริการระดับ VVIP", "Premium Loader"];
---

<ContentBoxTwo
  titleleft="เข้าสู่ระบบ LUCKYGAME689"
  titleright="ค่ายเกมระดับโลกและระบบที่ใช้ได้ทั้งบนมือถือและคอมพิวเตอร์"
  label="เข้าสู่ระบบ LUCKYGAME689 และค่ายเกมระดับโลกที่รวมไว้ในบัญชีเดียว">
  <div slot="left" class="flex h-full flex-col gap-4">
    <div class="relative overflow-hidden rounded-2xl border border-[#faad23]/25 bg-[#2b0204]/92 p-6 shadow-[0_10px_30px_rgba(250,173,35,0.16)] backdrop-blur-md">
      <div class="pointer-events-none absolute -top-10 -right-10 h-32 w-32 rounded-full bg-[#e01b5d]/25 blur-[50px]"></div>

      <div class="relative z-10 mb-5 flex items-center gap-3">
        <span
          aria-hidden="true"
          class="flex h-11 w-11 shrink-0 items-center justify-center rounded-xl border border-[#faad23]/40 bg-gradient-to-br from-[#ffd84d] via-[#faad23] to-[#b8760f] text-xl shadow-inner">
          👑
        </span>
        <div class="flex flex-col">
          <p class="text-base font-black text-[#faad23]">ยินดีต้อนรับกลับ</p>
          <span class="text-[11px] text-[#e0a6b5]">บัญชีเดียวใช้เลือกค่ายเกมระดับโลก กดรับ โปรโมชั่นเด็ด และทำรายการฝากถอนของ LUCKYGAME689 ได้จากจุดเดียว</span>
        </div>
      </div>

      <div class="relative z-10 flex flex-col gap-3.5">
        <div class="relative">
          <span aria-hidden="true" class="absolute top-3.5 left-4 text-[#b8760f]">👤</span>
          <input
            type="text"
            aria-label="เบอร์โทรศัพท์ หรือ ยูสเซอร์เนม"
            placeholder="เบอร์โทรศัพท์ / ยูสเซอร์เนม"
            class="w-full rounded-xl border border-[#7a0426] bg-[#3d0410]/95 py-3 pr-4 pl-12 text-[#ffe9c4] transition-all outline-none placeholder:text-[#e0a6b5]/70 focus:border-[#faad23] focus:ring-1 focus:ring-[#faad23]/50"
          />
        </div>
        <div class="relative">
          <span aria-hidden="true" class="absolute top-3.5 left-4 text-[#b8760f]">🔑</span>
          <input
            type="password"
            aria-label="รหัสผ่าน"
            placeholder="รหัสผ่าน"
            class="w-full rounded-xl border border-[#7a0426] bg-[#3d0410]/95 py-3 pr-4 pl-12 text-[#ffe9c4] transition-all outline-none placeholder:text-[#e0a6b5]/70 focus:border-[#faad23] focus:ring-1 focus:ring-[#faad23]/50"
          />
        </div>

        <div class="flex items-center justify-between px-1 text-xs">
          <label class="flex items-center gap-2 text-[#e0a6b5]">
            <input type="checkbox" class="h-3.5 w-3.5 rounded border-[#7a0426] bg-[#3d0410] accent-[#faad23]" />
            จดจำฉันไว้
          </label>
          <a href="/login" class="text-[#e0a6b5] transition-colors hover:text-[#ffd84d]">ลืมรหัสผ่าน?</a>
        </div>

        <button
          class="mt-1 w-full rounded-xl border border-[#faad23]/40 bg-gradient-to-r from-[#ffd84d] via-[#faad23] to-[#b8760f] p-3.5 font-black text-[#2b0204] shadow-[0_10px_30px_rgba(250,173,35,0.28)] transition-all hover:scale-[1.02] hover:shadow-[0_15px_40px_rgba(250,173,35,0.38)]">
          เข้าสู่ระบบ
        </button>

        <div class="flex items-center gap-3 py-1 text-[11px] text-[#e0a6b5]/70">
          <span class="h-px flex-1 bg-[#7a0426]"></span>
          หรือ
          <span class="h-px flex-1 bg-[#7a0426]"></span>
        </div>

        <a
          href="/line"
          class="flex w-full items-center justify-center gap-2 rounded-xl bg-gradient-to-r from-[#00B900] to-[#009900] p-3 text-sm font-bold text-white shadow-md transition-all hover:scale-[1.02]">
          <span aria-hidden="true">💬</span> ติดต่อแอดมิน LINE
        </a>

        <div class="mt-1 flex items-center justify-between px-1">
          <div class="flex gap-2">
            <span class="rounded-full border border-[#faad23]/25 bg-[#3d0410] px-2.5 py-1 text-[10px] font-bold text-[#faad23]"><span aria-hidden="true">🔒</span> Secure Popup</span>
            <span class="rounded-full border border-[#ff3d8a]/40 bg-[#3d0410]/80 px-2.5 py-1 text-[10px] font-bold text-[#ff3d8a]"><span aria-hidden="true">🕐</span> ดูแล 24 ชั่วโมง</span>
          </div>
          <a href="/register" class="text-xs font-bold text-[#b8760f] transition-colors hover:text-[#ffd84d]">สมัครสมาชิกใหม่</a>
        </div>
      </div>
    </div>
  </div>

  <div slot="right" class="h-full">
    <div class="flex h-full flex-col rounded-2xl border border-[#faad23]/25 bg-[#2b0204]/92 p-5 shadow-[0_10px_30px_rgba(250,173,35,0.16)] backdrop-blur-md">
      <div class="mb-5 flex items-center justify-between gap-3">
        <div>
          <span class="text-xs font-bold tracking-wide text-[#e0a6b5]">ตารางอ้างอิงค่ายเกมและบริการภายในบัญชีเดียวของ LUCKYGAME689</span>
          <div class="bg-gradient-to-r from-[#ffd84d] via-[#faad23] to-[#ff3d8a] bg-clip-text text-3xl font-black text-transparent sm:text-4xl">รวมค่ายชั้นนำไว้ในที่เดียว</div>
        </div>
        <span class="flex items-center gap-1.5 self-start rounded-full border border-green-500/40 bg-green-900/40 px-2.5 py-1">
          <span class="h-1.5 w-1.5 animate-pulse rounded-full bg-green-500 shadow-[0_0_8px_rgba(34,197,94,0.7)]"></span>
          <span class="text-[10px] font-bold tracking-widest text-green-300 uppercase">Live</span>
        </span>
      </div>

      <div class="mb-2 flex items-center justify-between text-[11px] font-bold tracking-widest text-[#e0a6b5]/70 uppercase">
        <span>ค่ายเกม / บริการในระบบ</span>
        <span>จุดเด่น</span>
      </div>

      <div class="flex flex-1 flex-col gap-2.5">
        {
          menus.map((m) => (
            <div class="rounded-xl border border-[#7a0426] bg-[#3d0410]/95 px-3.5 py-2.5 transition-colors hover:border-[#faad23]/50 hover:bg-[#2b0204]">
              <div class="flex items-center justify-between gap-2 text-sm">
                <span class="flex min-w-0 items-center gap-2 font-bold text-[#ffe9c4]">
                  <span aria-hidden="true" class="w-5 shrink-0 text-center">
                    {m.icon}
                  </span>{" "}
                  <span class="truncate">{m.name}</span>
                </span>
                <span class="shrink-0 rounded-full border border-[#faad23]/30 bg-[#1a0106] px-2.5 py-0.5 text-[10px] font-bold text-[#ffd84d]">{m.tag}</span>
              </div>
              <div class="mt-1.5 text-[11px] tracking-wide text-[#e0a6b5]">{m.detail}</div>
            </div>
          ))
        }
      </div>

      <div class="mt-4 flex flex-wrap items-center justify-center gap-2">
        {chips.map((c) => <span class="rounded-full border border-[#faad23]/25 bg-[#3d0410] px-3 py-1 text-[10px] font-bold text-[#faad23]">{c}</span>)}
      </div>

      <div class="mt-3 text-center text-[10px] tracking-wide text-[#b57a8c]">
        รายละเอียดค่ายเกมและสิทธิพิเศษอาจปรับเปลี่ยนตามช่วงเวลา ควรตรวจเงื่อนไขของแต่ละแคมเปญจากหน้าโปรโมชั่นจริงก่อนกดรับสิทธิ์ทุกครั้ง
      </div>
    </div>
  </div>
</ContentBoxTwo>
