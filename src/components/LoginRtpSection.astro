---
import ContentBoxTwo from "./ContentBoxTwo.astro";

const menus = [
  { icon: "🐉", name: "PG Soft", detail: "กราฟิก 3D แอนิเมชันคมชัด ฟีเจอร์ไหลลื่น เข้าถึงรอบโบนัสได้ไว", tag: "โบนัสแตกไว" },
  { icon: "⚡", name: "Pragmatic Play", detail: "กลไกออกรางวัลโปร่งใส ตอบสนองฉับไว จ่ายผลตอบแทนก้อนโต", tag: "แจกรางวัลรัว" },
  { icon: "🔥", name: "Nolimit City", detail: "ฟีเจอร์ดุดัน เน้นทวีคูณเงินรางวัลแบบก้าวกระโดด โหลดไวไม่ค้าง", tag: "ตัวคูณมหาศาล" },
  { icon: "🤖", name: "ระบบออโต้ไม่มีขั้นต่ำ", detail: "ประมวลผลด้วย AI อัจฉริยะ บริหารทุนได้อิสระ ไร้เงื่อนไขผูกมัด", tag: "ไม่มีขั้นต่ำ" },
  { icon: "💸", name: "ฝาก-ถอนอัตโนมัติ", detail: "ทำรายการเสร็จสิ้นภายในไม่กี่วินาที แม่นยำ ตลอด 24 ชั่วโมง", tag: "เสร็จในไม่กี่วินาที" },
  { icon: "🎁", name: "โปรลุ้นรับรางวัลเยอะ", detail: "โบนัสต้อนรับ แคมเปญประจำวัน และคืนยอดเสีย 15% กดรับเองได้", tag: "แจกหนักทุกวัน" },
  { icon: "🛡️", name: "Secure Transition Popup", detail: "เข้ารหัสระดับสถาบันการเงิน ป้องกันการรีเฟรชหน้าเว็บซ้ำซ้อน", tag: "ปลอดภัย 100%" },
];

const chips = ["PG Soft", "Pragmatic Play", "Nolimit City", "ระบบออโต้", "ไม่มีขั้นต่ำ", "คืนยอดเสีย 15%", "Secure Popup"];
---

<ContentBoxTwo
  titleleft="เข้าสู่ระบบ PGW44"
  titleright="ค่ายเกมและระบบที่ใช้ได้ทั้งบนมือถือและคอมพิวเตอร์"
  label="เข้าสู่ระบบ PGW44 และค่ายเกมระดับโลกที่รวมไว้ในบัญชีเดียว">
  <div slot="left" class="flex h-full flex-col gap-4">
    <div class="relative overflow-hidden rounded-2xl border border-[#ecab03]/25 bg-[#0a0f06]/92 p-6 shadow-[0_10px_30px_rgba(236,171,3,0.16)] backdrop-blur-md">
      <div class="pointer-events-none absolute -top-10 -right-10 h-32 w-32 rounded-full bg-[#ecab03]/20 blur-[50px]"></div>

      <div class="relative z-10 mb-5 flex items-center gap-3">
        <span aria-hidden="true" class="flex h-11 w-11 shrink-0 items-center justify-center rounded-xl border border-[#ecab03]/40 bg-gradient-to-br from-[#ffd54a] via-[#ecab03] to-[#a9760a] text-xl shadow-inner">🐉</span>
        <div class="flex flex-col">
          <p class="text-base font-black text-[#ecab03]">ยินดีต้อนรับกลับ</p>
          <span class="text-[11px] text-[#b9c4a6]">บัญชีเดียวใช้เลือกค่ายเกม กดรับสิทธิพิเศษ และทำรายการฝากถอนของ PGW44 ได้จากจุดเดียว</span>
        </div>
      </div>

      <div class="relative z-10 flex flex-col gap-3.5">
        <div class="relative">
          <span aria-hidden="true" class="absolute top-3.5 left-4 text-[#a9760a]">👤</span>
          <input
            type="text"
            placeholder="เบอร์โทรศัพท์ / ยูสเซอร์เนม"
            class="w-full rounded-xl border border-[#2c5a0d] bg-[#111a0a]/95 py-3 pr-4 pl-12 text-[#e8efd8] transition-all outline-none placeholder:text-[#b9c4a6]/70 focus:border-[#ecab03] focus:ring-1 focus:ring-[#ecab03]/50"
          />
        </div>
        <div class="relative">
          <span aria-hidden="true" class="absolute top-3.5 left-4 text-[#a9760a]">🔑</span>
          <input
            type="password"
            placeholder="รหัสผ่าน"
            class="w-full rounded-xl border border-[#2c5a0d] bg-[#111a0a]/95 py-3 pr-4 pl-12 text-[#e8efd8] transition-all outline-none placeholder:text-[#b9c4a6]/70 focus:border-[#ecab03] focus:ring-1 focus:ring-[#ecab03]/50"
          />
        </div>

        <div class="flex items-center justify-between px-1 text-xs">
          <label class="flex items-center gap-2 text-[#b9c4a6]">
            <input type="checkbox" class="h-3.5 w-3.5 rounded border-[#2c5a0d] bg-[#111a0a] accent-[#ecab03]" />
            จดจำฉันไว้
          </label>
          <a href="/login" class="text-[#b9c4a6] transition-colors hover:text-[#ffd54a]">ลืมรหัสผ่าน?</a>
        </div>

        <button
          class="mt-1 w-full rounded-xl border border-[#ecab03]/40 bg-gradient-to-r from-[#ffd54a] via-[#ecab03] to-[#a9760a] p-3.5 font-black text-[#0a0f06] shadow-[0_10px_30px_rgba(236,171,3,0.28)] transition-all hover:scale-[1.02] hover:shadow-[0_15px_40px_rgba(236,171,3,0.38)]">
          เข้าสู่ระบบ
        </button>

        <div class="flex items-center gap-3 py-1 text-[11px] text-[#b9c4a6]/70">
          <span class="h-px flex-1 bg-[#2c5a0d]"></span>
          หรือ
          <span class="h-px flex-1 bg-[#2c5a0d]"></span>
        </div>

        <a
          href="/line"
          class="flex w-full items-center justify-center gap-2 rounded-xl bg-gradient-to-r from-[#00B900] to-[#009900] p-3 text-sm font-bold text-white shadow-md transition-all hover:scale-[1.02]">
          <span aria-hidden="true">💬</span> ติดต่อแอดมิน LINE
        </a>

        <div class="mt-1 flex items-center justify-between px-1">
          <div class="flex gap-2">
            <span class="rounded-full border border-[#ecab03]/25 bg-[#111a0a] px-2.5 py-1 text-[10px] font-bold text-[#ecab03]"><span aria-hidden="true">🔒</span> Secure Popup</span>
            <span class="rounded-full border border-[#4a8d14]/60 bg-[#111a0a]/80 px-2.5 py-1 text-[10px] font-bold text-[#8fd633]"><span aria-hidden="true">🕐</span> ออโต้ 24 ชั่วโมง</span>
          </div>
          <a href="/register" class="text-xs font-bold text-[#a9760a] transition-colors hover:text-[#ffd54a]">สมัครสมาชิกใหม่</a>
        </div>
      </div>
    </div>
  </div>

  <div slot="right" class="h-full">
    <div class="flex h-full flex-col rounded-2xl border border-[#ecab03]/25 bg-[#0a0f06]/92 p-5 shadow-[0_10px_30px_rgba(236,171,3,0.16)] backdrop-blur-md">
      <div class="mb-5 flex items-center justify-between gap-3">
        <div>
          <span class="text-xs font-bold tracking-wide text-[#b9c4a6]">ตารางอ้างอิงค่ายเกมและระบบธุรกรรมภายในบัญชีเดียวของ PGW44</span>
          <div class="bg-gradient-to-r from-[#ffd54a] via-[#ecab03] to-[#8fd633] bg-clip-text text-3xl font-black text-transparent sm:text-4xl">ฝาก-ถอนเสร็จในไม่กี่วินาที</div>
        </div>
        <span class="flex items-center gap-1.5 self-start rounded-full border border-green-500/40 bg-green-900/40 px-2.5 py-1">
          <span class="h-1.5 w-1.5 animate-pulse rounded-full bg-green-500 shadow-[0_0_8px_rgba(34,197,94,0.7)]"></span>
          <span class="text-[10px] font-bold tracking-widest text-green-300 uppercase">Live</span>
        </span>
      </div>

      <div class="mb-2 flex items-center justify-between text-[11px] font-bold tracking-widest text-[#b9c4a6]/70 uppercase">
        <span>ค่ายเกม / บริการในระบบ</span>
        <span>จุดเด่น</span>
      </div>

      <div class="flex flex-1 flex-col gap-2.5">
        {
          menus.map((m) => (
            <div class="rounded-xl border border-[#2c5a0d] bg-[#111a0a]/95 px-3.5 py-2.5 transition-colors hover:border-[#ecab03]/50 hover:bg-[#1a2610]">
              <div class="flex items-center justify-between gap-2 text-sm">
                <span class="flex min-w-0 items-center gap-2 font-bold text-[#e8efd8]">
                  <span aria-hidden="true" class="w-5 shrink-0 text-center">{m.icon}</span> <span class="truncate">{m.name}</span>
                </span>
                <span class="shrink-0 rounded-full border border-[#ecab03]/30 bg-[#0a0f06] px-2.5 py-0.5 text-[10px] font-bold text-[#ffd54a]">{m.tag}</span>
              </div>
              <div class="mt-1.5 text-[11px] tracking-wide text-[#b9c4a6]">{m.detail}</div>
            </div>
          ))
        }
      </div>

      <div class="mt-4 flex flex-wrap items-center justify-center gap-2">
        {chips.map((c) => <span class="rounded-full border border-[#ecab03]/25 bg-[#111a0a] px-3 py-1 text-[10px] font-bold text-[#ecab03]">{c}</span>)}
      </div>

      <div class="mt-3 text-center text-[10px] tracking-wide text-[#b9c4a6]/70">
        รายละเอียดค่ายเกมและสิทธิพิเศษอาจปรับเปลี่ยนตามช่วงเวลา ควรตรวจเงื่อนไขของแต่ละแคมเปญจากหน้าโปรโมชั่นจริงก่อนกดรับสิทธิ์ทุกครั้ง
      </div>
    </div>
  </div>
</ContentBoxTwo>
