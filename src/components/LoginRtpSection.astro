---
import ContentBoxTwo from "./ContentBoxTwo.astro";

// Everything named here is this brand's own: the three camps the docx calls out
// (AvatarUX, Spinomenal, Relax Gaming) plus the four system claims it makes, so
// the table cannot contradict the prose the page sets above it.
const menus = [
  { icon: "🪶", name: "AvatarUX", detail: "กลไก PopWins ขยายกระดานทุกครั้งที่ชนะ ทวีคูณรางวัลต่อเนื่อง", tag: "นวัตกรรม PopWins" },
  { icon: "🎆", name: "Spinomenal", detail: "ภาพแอนิเมชันตระการตา ปรับจูนให้เข้าถึงรอบแจ็กพอตได้ไว", tag: "โบนัสเข้าไว" },
  { icon: "🧩", name: "Relax Gaming", detail: "ซอฟต์แวร์แข็งแกร่ง โหลดไว ตอบสนองฉับไวบนทุกอุปกรณ์", tag: "เสถียรภาพยอดเยี่ยม" },
  { icon: "🛡️", name: "เกมลิขสิทธิ์แท้จากค่ายดังทั่วโลก", detail: "ทุกเกมทำงานบนเซิร์ฟเวอร์หลักโดยตรง กราฟิกคมชัด อัตราจ่ายโปร่งใส", tag: "สล็อตเว็บใหญ่" },
  { icon: "⚡", name: "ระบบ AI อัจฉริยะของแพลตฟอร์ม", detail: "จัดการยอดฝากถอนได้เอง ประมวลผลเครดิตเสร็จในเสี้ยววินาที", tag: "ระบบออโต้" },
  { icon: "🔒", name: "เข้ารหัสข้อมูลระดับองค์กร", detail: "เข้าสู่ระบบผ่าน Secure Popup ทุกการเชื่อมต่อเป็นส่วนตัว", tag: "ปลอดภัย 100%" },
  { icon: "🎁", name: "เมนูรับสิทธิ์อัตโนมัติ", detail: "เลือกรับแคมเปญเสริมเองได้ เพิ่มขีดความสามารถในการเดิมพัน", tag: "โปรจัดเต็ม" },
];

const chips = ["AvatarUX", "Spinomenal", "Relax Gaming", "สล็อตเว็บใหญ่", "ระบบออโต้", "โปรจัดเต็ม", "ทำเงินได้จริง"];
---

<ContentBoxTwo titleleft="เข้าสู่ระบบ GARUDA369" titleright="ค่ายเกมลิขสิทธิ์แท้และระบบที่ใช้ได้ทั้งบนมือถือและคอมพิวเตอร์" label="เข้าสู่ระบบ GARUDA369 และค่ายเกมลิขสิทธิ์แท้ที่รวมไว้ในบัญชีเดียว">
  <div slot="left" class="flex h-full flex-col gap-4">
    <div class="relative overflow-hidden rounded-2xl border border-[#7bbb0b]/25 bg-[#0a1c04]/92 p-6 shadow-[0_10px_30px_rgba(123,187,11,0.16)] backdrop-blur-md">
      <div class="pointer-events-none absolute -top-10 -right-10 h-32 w-32 rounded-full bg-[#63a30c]/25 blur-[50px]"></div>

      <div class="relative z-10 mb-5 flex items-center gap-3">
        <span
          aria-hidden="true"
          class="flex h-11 w-11 shrink-0 items-center justify-center rounded-xl border border-[#7bbb0b]/40 bg-gradient-to-br from-[#a8e81c] via-[#7bbb0b] to-[#3c6b07] text-xl shadow-inner">
          🦅
        </span>
        <div class="flex flex-col">
          <p class="text-base font-black text-[#a8e81c]">ยินดีต้อนรับกลับ</p>
          <span class="text-[11px] text-[#a3c974]">บัญชีเดียวใช้เลือกค่ายเกมลิขสิทธิ์แท้ กดรับโปรจัดเต็ม และทำรายการผ่านระบบออโต้ของ GARUDA369 ได้จากจุดเดียว</span>
        </div>
      </div>

      <div class="relative z-10 flex flex-col gap-3.5">
        <div class="relative">
          <span aria-hidden="true" class="absolute top-3.5 left-4 text-[#a8e81c]">👤</span>
          <input
            type="text"
            aria-label="เบอร์โทรศัพท์ หรือ ยูสเซอร์เนม"
            placeholder="เบอร์โทรศัพท์ / ยูสเซอร์เนม"
            class="w-full rounded-xl border border-[#3c6b07] bg-[#0d2606]/95 py-3 pr-4 pl-12 text-[#dcefc2] transition-all outline-none placeholder:text-[#a3c974]/70 focus:border-[#7bbb0b] focus:ring-1 focus:ring-[#7bbb0b]/50"
          />
        </div>
        <div class="relative">
          <span aria-hidden="true" class="absolute top-3.5 left-4 text-[#a8e81c]">🔑</span>
          <input
            type="password"
            aria-label="รหัสผ่าน"
            placeholder="รหัสผ่าน"
            class="w-full rounded-xl border border-[#3c6b07] bg-[#0d2606]/95 py-3 pr-4 pl-12 text-[#dcefc2] transition-all outline-none placeholder:text-[#a3c974]/70 focus:border-[#7bbb0b] focus:ring-1 focus:ring-[#7bbb0b]/50"
          />
        </div>

        <div class="flex items-center justify-between px-1 text-xs">
          <label class="flex items-center gap-2 text-[#a3c974]">
            <input type="checkbox" class="h-3.5 w-3.5 rounded border-[#3c6b07] bg-[#0d2606] accent-[#7bbb0b]" />
            จดจำฉันไว้
          </label>
          <a href="/login" class="text-[#a3c974] transition-colors hover:text-[#a8e81c]">ลืมรหัสผ่าน?</a>
        </div>

        <button
          class="mt-1 w-full rounded-xl border border-[#7bbb0b]/40 bg-gradient-to-r from-[#a8e81c] via-[#7bbb0b] to-[#3c6b07] p-3.5 font-black text-[#061405] shadow-[0_10px_30px_rgba(123,187,11,0.28)] transition-all hover:scale-[1.02] hover:shadow-[0_15px_40px_rgba(123,187,11,0.4)]">
          เข้าสู่ระบบ
        </button>

        <div class="flex items-center gap-3 py-1 text-[11px] text-[#a3c974]/70">
          <span class="h-px flex-1 bg-[#3c6b07]"></span>
          หรือ
          <span class="h-px flex-1 bg-[#3c6b07]"></span>
        </div>

        <a
          href="/line"
          class="flex w-full items-center justify-center gap-2 rounded-xl bg-gradient-to-r from-[#00B900] to-[#009900] p-3 text-sm font-bold text-white shadow-md transition-all hover:scale-[1.02]">
          <span aria-hidden="true">💬</span> ติดต่อแอดมิน LINE
        </a>

        <div class="mt-1 flex items-center justify-between px-1">
          <div class="flex gap-2">
            <span class="rounded-full border border-[#7bbb0b]/25 bg-[#0d2606] px-2.5 py-1 text-[10px] font-bold text-[#7bbb0b]"><span aria-hidden="true">🔒</span> Secure Popup</span>
            <span class="rounded-full border border-[#f5c518]/40 bg-[#0d2606]/80 px-2.5 py-1 text-[10px] font-bold text-[#f5c518]"><span aria-hidden="true">⚡</span> ระบบออโต้</span>
          </div>
          <a href="/register" class="text-xs font-bold text-[#a8e81c] transition-colors hover:text-[#7bbb0b]">สมัครสมาชิกใหม่</a>
        </div>
      </div>
    </div>
  </div>

  <div slot="right" class="h-full">
    <div class="flex h-full flex-col rounded-2xl border border-[#7bbb0b]/25 bg-[#0a1c04]/92 p-5 shadow-[0_10px_30px_rgba(123,187,11,0.16)] backdrop-blur-md">
      <div class="mb-5 flex items-center justify-between gap-3">
        <div>
          <span class="text-xs font-bold tracking-wide text-[#a3c974]">ตารางอ้างอิงค่ายเกมและระบบภายในบัญชีเดียวของ GARUDA369</span>
          <div class="bg-gradient-to-r from-[#a8e81c] via-[#7bbb0b] to-[#f5c518] bg-clip-text text-3xl font-black text-transparent sm:text-4xl">รวมค่ายลิขสิทธิ์แท้ไว้ในที่เดียว</div>
        </div>
        <span class="flex items-center gap-1.5 self-start rounded-full border border-green-500/40 bg-green-900/40 px-2.5 py-1">
          <span class="h-1.5 w-1.5 animate-pulse rounded-full bg-green-500 shadow-[0_0_8px_rgba(34,197,94,0.7)]"></span>
          <span class="text-[10px] font-bold tracking-widest text-green-300 uppercase">Live</span>
        </span>
      </div>

      <div class="mb-2 flex items-center justify-between text-[11px] font-bold tracking-widest text-[#a3c974]/70 uppercase">
        <span>ค่ายเกม / ระบบในเว็บ</span>
        <span>จุดเด่น</span>
      </div>

      <div class="flex flex-1 flex-col gap-2.5">
        {
          menus.map((m) => (
            <div class="rounded-xl border border-[#3c6b07] bg-[#0d2606]/95 px-3.5 py-2.5 transition-colors hover:border-[#7bbb0b]/50 hover:bg-[#0a1c04]">
              <div class="flex items-center justify-between gap-2 text-sm">
                <span class="flex min-w-0 items-center gap-2 font-bold text-[#dcefc2]">
                  <span aria-hidden="true" class="w-5 shrink-0 text-center">
                    {m.icon}
                  </span>{" "}
                  <span class="truncate">{m.name}</span>
                </span>
                <span class="shrink-0 rounded-full border border-[#7bbb0b]/30 bg-[#061405] px-2.5 py-0.5 text-[10px] font-bold text-[#a8e81c]">{m.tag}</span>
              </div>
              <div class="mt-1.5 text-[11px] tracking-wide text-[#a3c974]">{m.detail}</div>
            </div>
          ))
        }
      </div>

      <div class="mt-4 flex flex-wrap items-center justify-center gap-2">
        {chips.map((c) => <span class="rounded-full border border-[#7bbb0b]/25 bg-[#0d2606] px-3 py-1 text-[10px] font-bold text-[#7bbb0b]">{c}</span>)}
      </div>

      <div class="mt-3 text-center text-[10px] tracking-wide text-[#7d9c55]">
        รายละเอียดค่ายเกมและสิทธิพิเศษอาจปรับเปลี่ยนตามช่วงเวลา ควรตรวจเงื่อนไขของแต่ละแคมเปญจากหน้าโปรโมชั่นจริงก่อนกดรับสิทธิ์ทุกครั้ง
      </div>
    </div>
  </div>
</ContentBoxTwo>
