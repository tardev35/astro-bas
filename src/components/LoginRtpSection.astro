---
import ContentBoxTwo from "./ContentBoxTwo.astro";

const lottoRates = [
  { rank: "🥇", name: "หวยรัฐบาลไทย 3 ตัวบน", rate: 900, unit: "บาทละ", note: "ปิดรับ 15:00 น." },
  { rank: "🥈", name: "หวยฮานอย 3 ตัวบน", rate: 850, unit: "บาทละ", note: "ปิดรับ 18:00 น." },
  { rank: "🥉", name: "หวยลาวพัฒนา 3 ตัวบน", rate: 850, unit: "บาทละ", note: "ปิดรับ 20:00 น." },
  { rank: "4", name: "หวยยี่กี 3 ตัวบน", rate: 800, unit: "บาทละ", note: "เปิดรับทุก 15 นาที" },
  { rank: "5", name: "หวยหุ้นไทย 3 ตัวบน", rate: 800, unit: "บาทละ", note: "ปิดรับ 16:40 น." },
];

const maxRate = Math.max(...lottoRates.map((r) => r.rate));
const marketCount = lottoRates.length;
---

<ContentBoxTwo titleleft="เข้าสู่ระบบ MAHORANLOTTO" titleright="อัตราจ่ายและเวลาปิดรับแต่ละตลาดหวย">
  <div slot="left" class="flex h-full flex-col gap-4">
    <div class="relative overflow-hidden rounded-2xl border border-amber-500/30 bg-gradient-to-br from-[#1a0409]/85 to-[#0f0206]/70 p-6 shadow-[0_0_20px_rgba(251,191,36,0.15)] backdrop-blur-md">
      <div class="pointer-events-none absolute -top-10 -right-10 h-32 w-32 rounded-full bg-amber-500/12 blur-[50px]"></div>

      <div class="relative z-10 mb-5 flex items-center gap-3">
        <span class="flex h-11 w-11 shrink-0 items-center justify-center rounded-xl border border-amber-400/40 bg-gradient-to-br from-[#7f1d1d] to-[#0f0206] text-xl shadow-inner">🎟️</span>
        <div class="flex flex-col">
          <p class="text-base font-black text-white">ยินดีต้อนรับกลับ</p>
          <span class="text-[11px] text-amber-100/65">บัญชีเดียว ส่งโพยได้ครบทุกตลาดหวยของ MAHORANLOTTO</span>
        </div>
      </div>

      <div class="relative z-10 flex flex-col gap-3.5">
        <div class="relative">
          <span class="absolute top-3.5 left-4 text-amber-300">👤</span>
          <input
            type="text"
            placeholder="ยูสเซอร์เนม / เบอร์โทรศัพท์"
            class="w-full rounded-xl border border-amber-500/50 bg-black/60 py-3 pr-4 pl-12 text-white transition-all outline-none focus:border-amber-300 focus:ring-1 focus:ring-amber-400/50"
          />
        </div>
        <div class="relative">
          <span class="absolute top-3.5 left-4 text-amber-300">🔑</span>
          <input
            type="password"
            placeholder="รหัสผ่าน"
            class="w-full rounded-xl border border-amber-500/50 bg-black/60 py-3 pr-4 pl-12 text-white transition-all outline-none focus:border-amber-300 focus:ring-1 focus:ring-amber-400/50"
          />
        </div>

        <div class="flex items-center justify-between px-1 text-xs">
          <label class="flex items-center gap-2 text-amber-100/65">
            <input type="checkbox" class="h-3.5 w-3.5 rounded border-amber-500/50 bg-black/60 accent-amber-500" />
            จดจำฉันไว้
          </label>
          <a href="#" class="text-amber-100/65 transition-colors hover:text-white">ลืมรหัสผ่าน?</a>
        </div>

        <button
          class="mt-1 w-full rounded-xl border border-amber-200/50 bg-gradient-to-r from-amber-300 via-amber-400 to-amber-600 p-3.5 font-black text-[#1a0409] shadow-[0_5px_15px_rgba(251,191,36,0.5)] transition-all hover:scale-[1.02] hover:shadow-[0_8px_25px_rgba(251,191,36,0.7)]">
          เข้าสู่ระบบ
        </button>

        <div class="flex items-center gap-3 py-1 text-[11px] text-amber-100/50">
          <span class="h-px flex-1 bg-white/10"></span>
          หรือ
          <span class="h-px flex-1 bg-white/10"></span>
        </div>

        <a
          href="/line"
          class="flex w-full items-center justify-center gap-2 rounded-xl bg-gradient-to-r from-[#00B900] to-[#009900] p-3 text-sm font-bold text-white shadow-md transition-all hover:scale-[1.02]">
          💬 ติดต่อแอดมิน LINE
        </a>

        <div class="mt-1 flex items-center justify-between px-1">
          <div class="flex gap-2">
            <span class="rounded-full border border-amber-500/30 bg-[#5f0914]/60 px-2.5 py-1 text-[10px] font-bold text-amber-200">🔒 HTTPS + SSL</span>
            <span class="rounded-full border border-amber-400/30 bg-[#7f1d1d]/25 px-2.5 py-1 text-[10px] font-bold text-amber-300">⚡ ส่งโพยอัตโนมัติ</span>
          </div>
          <a href="/register" class="animate-pulse text-xs font-bold text-amber-300 transition-colors hover:text-amber-200">สมัครสมาชิกใหม่</a>
        </div>
      </div>
    </div>
  </div>

  <div slot="right" class="h-full">
    <div class="flex h-full flex-col rounded-2xl border border-amber-500/30 bg-gradient-to-br from-[#1a0409]/85 to-[#0f0206]/70 p-5 backdrop-blur-md">
      <div class="mb-5 flex items-center justify-between">
        <div>
          <span class="text-xs font-bold tracking-wide text-amber-100/65">อัตราจ่ายสูงสุดที่ประกาศไว้ในหน้าตลาดหวย (บาทละ)</span>
          <div class="bg-gradient-to-r from-white via-amber-200 to-amber-400 bg-clip-text text-3xl font-black text-transparent drop-shadow-[0_2px_10px_rgba(251,191,36,0.4)] sm:text-4xl">
            สูงสุด {maxRate} บาท
          </div>
        </div>
        <span class="flex items-center gap-1.5 self-start rounded-full border border-green-500/40 bg-green-900/20 px-2.5 py-1">
          <span class="h-1.5 w-1.5 animate-pulse rounded-full bg-green-400 shadow-[0_0_8px_rgba(74,222,128,0.8)]"></span>
          <span class="text-[10px] font-bold tracking-widest text-green-400 uppercase">Live</span>
        </span>
      </div>

      <div class="mb-2 flex items-center justify-between text-[11px] font-bold tracking-widest text-amber-100/50 uppercase">
        <span>ตลาดหวย / ประเภทการแทง</span>
        <span>อัตราจ่าย</span>
      </div>

      <div class="flex flex-1 flex-col gap-2.5">
        {
          lottoRates.map((r) => (
            <div class="rounded-xl border border-amber-500/10 bg-white/5 px-3.5 py-2.5 transition-colors hover:border-amber-400/50 hover:bg-white/10">
              <div class="flex items-center justify-between gap-2 text-sm">
                <span class="flex min-w-0 items-center gap-2 font-bold text-white">
                  <span class="w-5 shrink-0 text-center">{r.rank}</span> <span class="truncate">{r.name}</span>
                </span>
                <span class="shrink-0 font-black text-amber-300">
                  {r.unit} {r.rate}
                </span>
              </div>
              <div class="mt-1.5 h-1.5 w-full overflow-hidden rounded-full bg-black/40">
                <div class="h-full rounded-full bg-gradient-to-r from-[#7f1d1d] to-amber-300" style={`width:${(r.rate / maxRate) * 100}%`} />
              </div>
              <div class="mt-1.5 text-[10px] tracking-wide text-amber-100/55">{r.note}</div>
            </div>
          ))
        }
      </div>

      <div class="mt-4 text-center text-[10px] tracking-wide text-amber-100/50">
        อัตราจ่ายและเวลาปิดรับของทั้ง {marketCount} รายการอาจปรับเปลี่ยนตามยอดแทงและเลขอั้นในแต่ละรอบ ควรตรวจสอบหน้ายืนยันโพยก่อนส่งทุกครั้ง
      </div>
    </div>
  </div>
</ContentBoxTwo>
