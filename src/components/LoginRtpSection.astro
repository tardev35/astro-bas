---
import ContentBoxTwo from "./ContentBoxTwo.astro";

const gameCategories = [
  { icon: "🎰", name: "สล็อตออนไลน์", providers: "PG Soft • Pragmatic Play • Microgaming", tag: "โหมดทดลอง" },
  { icon: "🎰", name: "สล็อตค่ายเสริม", providers: "NetEnt • Red Tiger • Betsoft • Yggdrasil", tag: "เกมใหม่" },
  { icon: "🃏", name: "บาคาร่า Live สด", providers: "Evolution • SA Gaming • Sexy Gaming", tag: "24 ชม." },
  { icon: "🎡", name: "รูเล็ต Live สด", providers: "Evolution • Pragmatic Play", tag: "24 ชม." },
  { icon: "🂡", name: "แบล็คแจ็ค Live สด", providers: "Evolution • SA Gaming", tag: "24 ชม." },
];

const memberMenus = ["ยอดนิยม", "เกมใหม่", "รายการโปรด", "เล่นล่าสุด"];
---

<ContentBoxTwo titleleft="เข้าสู่ระบบ WINUP888" titleright="หมวดเกมและโต๊ะ Live สดบนมือถือ">
  <div slot="left" class="flex h-full flex-col gap-4">
    <div class="relative overflow-hidden rounded-2xl border border-amber-600/25 bg-[#fffdf7]/92 p-6 shadow-[0_10px_30px_rgba(168,132,44,0.18)] backdrop-blur-md">
      <div class="pointer-events-none absolute -top-10 -right-10 h-32 w-32 rounded-full bg-amber-300/25 blur-[50px]"></div>

      <div class="relative z-10 mb-5 flex items-center gap-3">
        <span class="flex h-11 w-11 shrink-0 items-center justify-center rounded-xl border border-amber-600/30 bg-gradient-to-br from-[#f4dfa3] via-[#d9b45c] to-[#a97f2a] text-xl shadow-inner">🎮</span>
        <div class="flex flex-col">
          <p class="text-base font-black text-[#3a2e18]">ยินดีต้อนรับกลับ</p>
          <span class="text-[11px] text-[#8a7550]">บัญชีเดียวใช้ได้ทั้งสล็อต บาคาร่า และเกม Live สดของ WINUP888</span>
        </div>
      </div>

      <div class="relative z-10 flex flex-col gap-3.5">
        <div class="relative">
          <span class="absolute top-3.5 left-4 text-[#a07c1f]">👤</span>
          <input
            type="text"
            placeholder="ยูสเซอร์เนม / เบอร์โทรศัพท์"
            class="w-full rounded-xl border border-amber-600/30 bg-[#faf4e6]/95 py-3 pr-4 pl-12 text-[#3a2e18] transition-all outline-none placeholder:text-[#8a7550] focus:border-[#c9a227] focus:ring-1 focus:ring-[#c9a227]/50"
          />
        </div>
        <div class="relative">
          <span class="absolute top-3.5 left-4 text-[#a07c1f]">🔑</span>
          <input
            type="password"
            placeholder="รหัสผ่าน"
            class="w-full rounded-xl border border-amber-600/30 bg-[#faf4e6]/95 py-3 pr-4 pl-12 text-[#3a2e18] transition-all outline-none placeholder:text-[#8a7550] focus:border-[#c9a227] focus:ring-1 focus:ring-[#c9a227]/50"
          />
        </div>

        <div class="flex items-center justify-between px-1 text-xs">
          <label class="flex items-center gap-2 text-[#6b5836]">
            <input type="checkbox" class="h-3.5 w-3.5 rounded border-amber-600/40 bg-[#faf4e6] accent-[#c9a227]" />
            จดจำฉันไว้
          </label>
          <a href="/login" class="text-[#6b5836] transition-colors hover:text-[#8a6410]">ลืมรหัสผ่าน?</a>
        </div>

        <button
          class="mt-1 w-full rounded-xl border border-amber-600/30 bg-gradient-to-r from-[#f4dfa3] via-[#d9b45c] to-[#a97f2a] p-3.5 font-black text-[#231a06] shadow-[0_10px_30px_rgba(168,132,44,0.18)] transition-all hover:scale-[1.02] hover:shadow-[0_15px_40px_rgba(168,132,44,0.30)]">
          เข้าสู่ระบบ
        </button>

        <div class="flex items-center gap-3 py-1 text-[11px] text-[#8a7550]">
          <span class="h-px flex-1 bg-[#e7d5a3]"></span>
          หรือ
          <span class="h-px flex-1 bg-[#e7d5a3]"></span>
        </div>

        <a
          href="/line"
          class="flex w-full items-center justify-center gap-2 rounded-xl bg-gradient-to-r from-[#00B900] to-[#009900] p-3 text-sm font-bold text-white shadow-md transition-all hover:scale-[1.02]">
          💬 ติดต่อแอดมิน LINE
        </a>

        <div class="mt-1 flex items-center justify-between px-1">
          <div class="flex gap-2">
            <span class="rounded-full border border-amber-600/25 bg-[#faf4e6] px-2.5 py-1 text-[10px] font-bold text-[#8a6410]">🔒 HTTPS + SSL</span>
            <span class="rounded-full bg-[#241c0c] px-2.5 py-1 text-[10px] font-bold text-amber-100">📱 HTML5 บนมือถือ</span>
          </div>
          <a href="/register" class="text-xs font-bold text-[#a07c1f] transition-colors hover:text-[#8a6410]">สมัครสมาชิกใหม่</a>
        </div>
      </div>
    </div>
  </div>

  <div slot="right" class="h-full">
    <div class="flex h-full flex-col rounded-2xl border border-amber-600/25 bg-[#fffdf7]/92 p-5 shadow-[0_10px_30px_rgba(168,132,44,0.18)] backdrop-blur-md">
      <div class="mb-5 flex items-center justify-between gap-3">
        <div>
          <span class="text-xs font-bold tracking-wide text-[#6b5836]">หมวดเกมที่เปิดให้เลือกภายในระบบเดียว</span>
          <div class="bg-gradient-to-r from-[#7a5a12] via-[#b8912f] to-[#8a6a1f] bg-clip-text text-3xl font-black text-transparent sm:text-4xl">
            สล็อต • บาคาร่า • Live สด
          </div>
        </div>
        <span class="flex items-center gap-1.5 self-start rounded-full border border-green-600/40 bg-green-100/70 px-2.5 py-1">
          <span class="h-1.5 w-1.5 animate-pulse rounded-full bg-green-500 shadow-[0_0_8px_rgba(34,197,94,0.7)]"></span>
          <span class="text-[10px] font-bold tracking-widest text-green-700 uppercase">Live</span>
        </span>
      </div>

      <div class="mb-2 flex items-center justify-between text-[11px] font-bold tracking-widest text-[#8a7550] uppercase">
        <span>หมวดเกม / ผู้ให้บริการ</span>
        <span>สถานะ</span>
      </div>

      <div class="flex flex-1 flex-col gap-2.5">
        {
          gameCategories.map((c) => (
            <div class="rounded-xl border border-[#e7d5a3] bg-[#faf4e6]/95 px-3.5 py-2.5 transition-colors hover:border-amber-600/50 hover:bg-[#f4ecd8]/90">
              <div class="flex items-center justify-between gap-2 text-sm">
                <span class="flex min-w-0 items-center gap-2 font-bold text-[#3a2e18]">
                  <span class="w-5 shrink-0 text-center">{c.icon}</span> <span class="truncate">{c.name}</span>
                </span>
                <span class="shrink-0 rounded-full bg-[#241c0c] px-2.5 py-0.5 text-[10px] font-bold text-amber-100">{c.tag}</span>
              </div>
              <div class="mt-1.5 text-[11px] tracking-wide text-[#6b5836]">{c.providers}</div>
            </div>
          ))
        }
      </div>

      <div class="mt-4 flex flex-wrap items-center justify-center gap-2">
        {memberMenus.map((m) => <span class="rounded-full border border-amber-600/25 bg-[#fffdf7] px-3 py-1 text-[10px] font-bold text-[#8a6410]">{m}</span>)}
      </div>

      <div class="mt-3 text-center text-[10px] tracking-wide text-[#8a7550]">รายชื่อค่ายเกมและโต๊ะที่เปิดให้บริการอาจเปลี่ยนแปลงตามช่วงเวลา ควรตรวจขั้นต่ำโต๊ะและกติกาบนหน้าเกมก่อนเข้าเล่นทุกครั้ง</div>
    </div>
  </div>
</ContentBoxTwo>
