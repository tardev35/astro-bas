---
import ContentBoxTwo from "./ContentBoxTwo.astro";

const jackpotProviders = [
  { rank: "🥇", name: "PG SLOT", rtp: 98.8, vol: "ปานกลาง" },
  { rank: "🥈", name: "XOSLOT", rtp: 98.2, vol: "ปานกลาง–สูง" },
  { rank: "🥉", name: "Pragmatic Play", rtp: 97.9, vol: "สูง" },
  { rank: "4", name: "JILI", rtp: 97.4, vol: "ปานกลาง" },
  { rank: "5", name: "คาสิโนสด / บาคาร่า", rtp: 96.9, vol: "ต่ำ" },
];

const averageRtp = (jackpotProviders.reduce((sum, p) => sum + p.rtp, 0) / jackpotProviders.length).toFixed(1);
---

<ContentBoxTwo titleleft="เข้าสู่ระบบ UFAYES" titleright="RTP และ Volatility แยกตามค่าย">
  <div slot="left" class="flex h-full flex-col gap-4">
    <div class="relative overflow-hidden rounded-2xl border border-red-500/30 bg-gradient-to-br from-[#140202]/80 to-black/60 p-6 shadow-[0_0_20px_rgba(220,38,38,0.15)] backdrop-blur-md">
      <div class="pointer-events-none absolute -top-10 -right-10 h-32 w-32 rounded-full bg-red-600/15 blur-[50px]"></div>

      <div class="relative z-10 mb-5 flex items-center gap-3">
        <span class="flex h-11 w-11 shrink-0 items-center justify-center rounded-xl border border-red-400/40 bg-gradient-to-br from-red-700 to-[#0a0101] text-xl shadow-inner">⚽</span>
        <div class="flex flex-col">
          <p class="text-base font-black text-white">ยินดีต้อนรับกลับ</p>
          <span class="text-[11px] text-red-100/60">บัญชีเดียว ใช้งานได้ทุกหมวดเกมของ UFAYES</span>
        </div>
      </div>

      <div class="relative z-10 flex flex-col gap-3.5">
        <div class="relative">
          <span class="absolute top-3.5 left-4 text-red-400">👤</span>
          <input
            type="text"
            placeholder="ยูสเซอร์เนม / เบอร์โทรศัพท์"
            class="w-full rounded-xl border border-red-500/50 bg-black/60 py-3 pr-4 pl-12 text-white transition-all outline-none focus:border-red-300 focus:ring-1 focus:ring-red-400/50"
          />
        </div>
        <div class="relative">
          <span class="absolute top-3.5 left-4 text-red-400">🔑</span>
          <input
            type="password"
            placeholder="รหัสผ่าน"
            class="w-full rounded-xl border border-red-500/50 bg-black/60 py-3 pr-4 pl-12 text-white transition-all outline-none focus:border-red-300 focus:ring-1 focus:ring-red-400/50"
          />
        </div>

        <div class="flex items-center justify-between px-1 text-xs">
          <label class="flex items-center gap-2 text-red-100/60">
            <input type="checkbox" class="h-3.5 w-3.5 rounded border-red-500/50 bg-black/60 accent-red-500" />
            จดจำฉันไว้
          </label>
          <a href="#" class="text-red-100/60 transition-colors hover:text-white">ลืมรหัสผ่าน?</a>
        </div>

        <button
          class="mt-1 w-full rounded-xl border border-red-300/50 bg-gradient-to-r from-red-500 via-red-600 to-red-700 p-3.5 font-black text-white shadow-[0_5px_15px_rgba(220,38,38,0.5)] transition-all hover:scale-[1.02] hover:shadow-[0_8px_25px_rgba(220,38,38,0.7)]">
          เข้าสู่ระบบ
        </button>

        <div class="flex items-center gap-3 py-1 text-[11px] text-red-100/45">
          <span class="h-px flex-1 bg-white/10"></span>
          หรือ
          <span class="h-px flex-1 bg-white/10"></span>
        </div>

        <a
          href="/line"
          class="flex w-full items-center justify-center gap-2 rounded-xl bg-gradient-to-r from-[#00B900] to-[#009900] p-3 text-sm font-bold text-white shadow-md transition-all hover:scale-[1.02]">
          💬 ติดต่อแอดมิน LINE
        </a>

        <div class="mt-1 flex items-center justify-between px-1">
          <div class="flex gap-2">
            <span class="rounded-full border border-red-500/30 bg-[#240404]/60 px-2.5 py-1 text-[10px] font-bold text-red-200">🔒 HTTPS + SSL</span>
            <span class="rounded-full border border-red-400/30 bg-red-900/20 px-2.5 py-1 text-[10px] font-bold text-red-400">⚡ เว็บตรง UFABET</span>
          </div>
          <a href="/register" class="animate-pulse text-xs font-bold text-red-400 transition-colors hover:text-red-300">สมัครสมาชิกใหม่</a>
        </div>
      </div>
    </div>
  </div>

  <div slot="right" class="h-full">
    <div class="flex h-full flex-col rounded-2xl border border-red-500/30 bg-gradient-to-br from-[#140202]/80 to-black/60 p-5 backdrop-blur-md">
      <div class="mb-5 flex items-center justify-between">
        <div>
          <span class="text-xs font-bold tracking-wide text-red-100/60">RTP เฉลี่ยจากข้อมูลที่แต่ละค่ายเปิดเผย (%)</span>
          <div class="bg-gradient-to-r from-white via-red-200 to-red-400 bg-clip-text text-3xl font-black text-transparent drop-shadow-[0_2px_10px_rgba(239,68,68,0.4)] sm:text-4xl">
            {averageRtp}% RTP รวม
          </div>
        </div>
        <span class="flex items-center gap-1.5 self-start rounded-full border border-green-500/40 bg-green-900/20 px-2.5 py-1">
          <span class="h-1.5 w-1.5 animate-pulse rounded-full bg-green-400 shadow-[0_0_8px_rgba(74,222,128,0.8)]"></span>
          <span class="text-[10px] font-bold tracking-widest text-green-400 uppercase">Live</span>
        </span>
      </div>

      <div class="mb-2 flex items-center justify-between text-[11px] font-bold tracking-widest text-red-100/45 uppercase">
        <span>ค่ายเกม / หมวดเกม</span>
        <span>RTP</span>
      </div>

      <div class="flex flex-1 flex-col gap-2.5">
        {
          jackpotProviders.map((p) => (
            <div class="rounded-xl border border-white/5 bg-white/5 px-3.5 py-2.5 transition-colors hover:border-red-400/50 hover:bg-white/10">
              <div class="flex items-center justify-between gap-2 text-sm">
                <span class="flex min-w-0 items-center gap-2 font-bold text-white">
                  <span class="w-5 shrink-0 text-center">{p.rank}</span> <span class="truncate">{p.name}</span>
                </span>
                <span class="shrink-0 font-black text-red-400">{p.rtp}%</span>
              </div>
              <div class="mt-1.5 h-1.5 w-full overflow-hidden rounded-full bg-black/40">
                <div class="h-full rounded-full bg-gradient-to-r from-red-700 to-red-300" style={`width:${p.rtp}%`} />
              </div>
              <div class="mt-1.5 text-[10px] tracking-wide text-red-100/50">ความผันผวน (Volatility): {p.vol}</div>
            </div>
          ))
        }
      </div>

      <div class="mt-4 text-center text-[10px] tracking-wide text-red-100/45">ค่า RTP และ Volatility แตกต่างกันตามมาตรฐานของแต่ละค่าย ควรศึกษารายละเอียดของเกมก่อนเลือกเล่นทุกครั้ง</div>
    </div>
  </div>
</ContentBoxTwo>
