---
import ContentBoxTwo from "./ContentBoxTwo.astro";

const markets = [
  { icon: "⚖️", name: "ตลาดแฮนดิแคป", detail: "ต่อ–รองระหว่างสองทีม ตัดสินจากผลหลังคิดแฮนดิแคป", tag: "ดูฝั่งเดิมพัน" },
  { icon: "📈", name: "ตลาดสูง–ต่ำ", detail: "วัดจากจำนวนประตูรวมเทียบกับเส้นที่ระบบแสดง", tag: "ดูเส้นราคา" },
  { icon: "🔢", name: "ตลาด 1X2", detail: "เลือกทีมเหย้าชนะ เสมอ หรือทีมเยือนชนะ", tag: "เงื่อนไขต่างกัน" },
  { icon: "🗓️", name: "บอลก่อนแข่ง", detail: "มีเวลาตรวจฟอร์ม รายชื่อผู้เล่น และสถิติย้อนหลัง", tag: "ตรวจก่อนกด" },
  { icon: "⏱️", name: "บอลสด", detail: "ราคาขยับตามสกอร์ เวลา ใบแดง และจังหวะในสนาม", tag: "ตัดสินใจเร็ว" },
  { icon: "🎫", name: "บิลเดี่ยว", detail: "ผูกผลไว้กับการแข่งขันหนึ่งคู่ ตรวจเงื่อนไขได้ง่าย", tag: "หนึ่งคู่" },
  { icon: "🧾", name: "บิลสเต็ป", detail: "รวมหลายคู่ในรายการเดียว ทุกคู่ต้องผ่านตามที่เลือก", tag: "ตรวจให้ครบ" },
];

const marketChips = ["แฮนดิแคป", "สูง–ต่ำ", "1X2", "บอลก่อนแข่ง", "บอลสด", "บิลเดี่ยว", "บิลสเต็ป"];
---

<ContentBoxTwo titleleft="เข้าสู่ระบบ UFAG8" titleright="ตลาดบอลและรูปแบบบิลที่ควรอ่านก่อนกด">
  <div slot="left" class="flex h-full flex-col gap-4">
    <div class="relative overflow-hidden rounded-2xl border border-[#dcb96b]/25 bg-[#0c0b09]/92 p-6 shadow-[0_10px_30px_rgba(220,185,107,0.14)] backdrop-blur-md">
      <div class="pointer-events-none absolute -top-10 -right-10 h-32 w-32 rounded-full bg-[#dcb96b]/20 blur-[50px]"></div>

      <div class="relative z-10 mb-5 flex items-center gap-3">
        <span aria-hidden="true" class="flex h-11 w-11 shrink-0 items-center justify-center rounded-xl border border-[#dcb96b]/40 bg-gradient-to-br from-[#f2dca4] via-[#dcb96b] to-[#ac893a] text-xl shadow-inner">⚽</span>
        <div class="flex flex-col">
          <p class="text-base font-black text-[#dcb96b]">ยินดีต้อนรับกลับ</p>
          <span class="text-[11px] text-[#bcb6a6]">บัญชีเดียวใช้เลือกตลาด ตรวจบิล และจัดการข้อมูลของ UFAG8 ได้ในช่องทางเดียว</span>
        </div>
      </div>

      <div class="relative z-10 flex flex-col gap-3.5">
        <div class="relative">
          <span aria-hidden="true" class="absolute top-3.5 left-4 text-[#ac893a]">👤</span>
          <input
            type="text"
            placeholder="เบอร์โทรศัพท์ / ยูสเซอร์เนม"
            class="w-full rounded-xl border border-[#7a5f22] bg-[#191712]/95 py-3 pr-4 pl-12 text-[#efeade] transition-all outline-none placeholder:text-[#8b8578] focus:border-[#dcb96b] focus:ring-1 focus:ring-[#dcb96b]/50"
          />
        </div>
        <div class="relative">
          <span aria-hidden="true" class="absolute top-3.5 left-4 text-[#ac893a]">🔑</span>
          <input
            type="password"
            placeholder="รหัสผ่าน"
            class="w-full rounded-xl border border-[#7a5f22] bg-[#191712]/95 py-3 pr-4 pl-12 text-[#efeade] transition-all outline-none placeholder:text-[#8b8578] focus:border-[#dcb96b] focus:ring-1 focus:ring-[#dcb96b]/50"
          />
        </div>

        <div class="flex items-center justify-between px-1 text-xs">
          <label class="flex items-center gap-2 text-[#bcb6a6]">
            <input type="checkbox" class="h-3.5 w-3.5 rounded border-[#7a5f22] bg-[#191712] accent-[#dcb96b]" />
            จดจำฉันไว้
          </label>
          <a href="/login" class="text-[#bcb6a6] transition-colors hover:text-[#f2dca4]">ลืมรหัสผ่าน?</a>
        </div>

        <button
          class="mt-1 w-full rounded-xl border border-[#dcb96b]/40 bg-gradient-to-r from-[#f2dca4] via-[#dcb96b] to-[#ac893a] p-3.5 font-black text-[#141210] shadow-[0_10px_30px_rgba(220,185,107,0.26)] transition-all hover:scale-[1.02] hover:shadow-[0_15px_40px_rgba(220,185,107,0.36)]">
          เข้าสู่ระบบ
        </button>

        <div class="flex items-center gap-3 py-1 text-[11px] text-[#8b8578]">
          <span class="h-px flex-1 bg-[#7a5f22]"></span>
          หรือ
          <span class="h-px flex-1 bg-[#7a5f22]"></span>
        </div>

        <a
          href="/line"
          class="flex w-full items-center justify-center gap-2 rounded-xl bg-gradient-to-r from-[#00B900] to-[#009900] p-3 text-sm font-bold text-white shadow-md transition-all hover:scale-[1.02]">
          <span aria-hidden="true">💬</span> ติดต่อแอดมิน LINE
        </a>

        <div class="mt-1 flex items-center justify-between px-1">
          <div class="flex gap-2">
            <span class="rounded-full border border-[#dcb96b]/25 bg-[#191712] px-2.5 py-1 text-[10px] font-bold text-[#dcb96b]"><span aria-hidden="true">🔒</span> HTTPS + SSL</span>
            <span class="rounded-full border border-[#b9bcc4]/45 bg-[#15171c]/80 px-2.5 py-1 text-[10px] font-bold text-[#d7dae1]"><span aria-hidden="true">⚽</span> ตลาดบอลก่อนแข่งและบอลสด</span>
          </div>
          <a href="/register" class="text-xs font-bold text-[#ac893a] transition-colors hover:text-[#f2dca4]">สมัครสมาชิกใหม่</a>
        </div>
      </div>
    </div>
  </div>

  <div slot="right" class="h-full">
    <div class="flex h-full flex-col rounded-2xl border border-[#dcb96b]/25 bg-[#0c0b09]/92 p-5 shadow-[0_10px_30px_rgba(220,185,107,0.14)] backdrop-blur-md">
      <div class="mb-5 flex items-center justify-between gap-3">
        <div>
          <span class="text-xs font-bold tracking-wide text-[#bcb6a6]">ตารางอ้างอิงตลาดเดิมพันฟุตบอลภายในบัญชีเดียว</span>
          <div class="bg-gradient-to-r from-[#f2dca4] via-[#dcb96b] to-[#ac893a] bg-clip-text text-3xl font-black text-transparent sm:text-4xl">
            แฮนดิแคป • สูง–ต่ำ • 1X2
          </div>
        </div>
        <span class="flex items-center gap-1.5 self-start rounded-full border border-green-500/40 bg-green-900/40 px-2.5 py-1">
          <span class="h-1.5 w-1.5 animate-pulse rounded-full bg-green-500 shadow-[0_0_8px_rgba(34,197,94,0.7)]"></span>
          <span class="text-[10px] font-bold tracking-widest text-green-300 uppercase">Live</span>
        </span>
      </div>

      <div class="mb-2 flex items-center justify-between text-[11px] font-bold tracking-widest text-[#8b8578] uppercase">
        <span>ตลาด / เงื่อนไขตัดสิน</span>
        <span>จุดที่ต้องดู</span>
      </div>

      <div class="flex flex-1 flex-col gap-2.5">
        {
          markets.map((m) => (
            <div class="rounded-xl border border-[#7a5f22] bg-[#191712]/95 px-3.5 py-2.5 transition-colors hover:border-[#dcb96b]/50 hover:bg-[#22262e]">
              <div class="flex items-center justify-between gap-2 text-sm">
                <span class="flex min-w-0 items-center gap-2 font-bold text-[#efeade]">
                  <span aria-hidden="true" class="w-5 shrink-0 text-center">{m.icon}</span> <span class="truncate">{m.name}</span>
                </span>
                <span class="shrink-0 rounded-full border border-[#dcb96b]/30 bg-[#0c0b09] px-2.5 py-0.5 text-[10px] font-bold text-[#f2dca4]">{m.tag}</span>
              </div>
              <div class="mt-1.5 text-[11px] tracking-wide text-[#bcb6a6]">{m.detail}</div>
            </div>
          ))
        }
      </div>

      <div class="mt-4 flex flex-wrap items-center justify-center gap-2">
        {marketChips.map((c) => <span class="rounded-full border border-[#dcb96b]/25 bg-[#191712] px-3 py-1 text-[10px] font-bold text-[#dcb96b]">{c}</span>)}
      </div>

      <div class="mt-3 text-center text-[10px] tracking-wide text-[#8b8578]">
        ราคาบอลเปลี่ยนได้ตามเวลา ข่าวผู้เล่น และสถานการณ์ก่อนแข่ง ก่อนยืนยันบิลควรตรวจคู่แข่งขัน ตลาด ราคา ยอดเดิมพัน และผลตอบแทนที่ระบบแสดงให้ตรงกันทุกครั้ง
      </div>
    </div>
  </div>
</ContentBoxTwo>
