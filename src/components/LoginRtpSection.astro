---
import ContentBoxTwo from "./ContentBoxTwo.astro";

// Everything named here is this brand's own: the three camps the docx calls out
// (Thunderkick, Playtech, Habanero) plus the four system claims it makes, so
// the table cannot contradict the prose the page sets above it.
const menus = [
  { icon: "⚡", name: "Thunderkick", detail: "กลไกการเล่นแหวกแนว ทวีคูณเงินรางวัลได้อย่างมหาศาล", tag: "นวัตกรรมสุดล้ำ" },
  { icon: "🏛️", name: "Playtech", detail: "ซอฟต์แวร์ระดับโกลบอล รองรับการใช้งานลื่นไหล แจ็กพอตจ่ายหนัก", tag: "ระบบเสถียร" },
  { icon: "🌶️", name: "Habanero", detail: "เล่นง่าย เข้าใจง่าย ออกรางวัลโบนัสต่อเนื่อง กอบโกยกำไรได้ไว", tag: "อัตราจ่ายสูง" },
  { icon: "🛡️", name: "ซอฟต์แวร์ลิขสิทธิ์แท้จากผู้พัฒนาชั้นนำทั่วโลก", detail: "ทุกเกมผ่านการทดสอบมาตรฐานว่าเสถียรและจ่ายรางวัลอย่างเป็นธรรม", tag: "คาสิโนออนไลน์ครบวงจร" },
  { icon: "📈", name: "โครงสร้างอัลกอริทึมที่เอื้อต่อการทำกำไร", detail: "ทุกจังหวะการเดิมพันเต็มไปด้วยโอกาสทอง ไม่มีอาการค้างหรือหลุด", tag: "รวมเกมแตกง่าย" },
  { icon: "💰", name: "ระบบออโต้โอนเข้ากระเป๋าทันที", detail: "ครบทุกบาททุกสตางค์ ไม่มีการหักค่าธรรมเนียมหรือเปอร์เซ็นต์ใดๆ", tag: "จ่ายจริง 100%" },
  { icon: "🔒", name: "Secure Popup Loader", detail: "ปกป้องข้อมูลด้วยระบบความปลอดภัยขั้นสูงในทุกครั้งที่เข้าใช้งาน", tag: "สมัครง่าย" },
];

const chips = ["Thunderkick", "Playtech", "Habanero", "คาสิโนออนไลน์ครบวงจร", "รวมเกมแตกง่าย", "จ่ายจริง", "สมัครง่าย"];
---

<ContentBoxTwo titleleft="เข้าสู่ระบบ TT1BET" titleright="ค่ายเกมลิขสิทธิ์แท้และระบบที่ใช้ได้ทั้งบนมือถือและคอมพิวเตอร์" label="เข้าสู่ระบบ TT1BET และค่ายเกมลิขสิทธิ์แท้ที่รวมไว้ในบัญชีเดียว">
  <div slot="left" class="flex h-full flex-col gap-4">
    <div class="relative overflow-hidden rounded-2xl border border-[#ebdd65]/25 bg-[#171106]/92 p-6 shadow-[0_10px_30px_rgba(235,221,101,0.16)] backdrop-blur-md">
      <div class="pointer-events-none absolute -top-10 -right-10 h-32 w-32 rounded-full bg-[#d4b433]/25 blur-[50px]"></div>

      <div class="relative z-10 mb-5 flex items-center gap-3">
        <span
          aria-hidden="true"
          class="flex h-11 w-11 shrink-0 items-center justify-center rounded-xl border border-[#ebdd65]/40 bg-gradient-to-br from-[#fcf6ab] via-[#ebdd65] to-[#a8790f] text-xl shadow-inner">
          👑
        </span>
        <div class="flex flex-col">
          <p class="text-base font-black text-[#fcf6ab]">ยินดีต้อนรับกลับ</p>
          <span class="text-[11px] text-[#c9bb96]">บัญชีเดียวเข้าถึงเกมลิขสิทธิ์แท้ทุกค่าย กดรับสิทธิพิเศษ และทำรายการผ่านระบบออโต้ของ TT1BET ได้จากจุดเดียว</span>
        </div>
      </div>

      <div class="relative z-10 flex flex-col gap-3.5">
        <div class="relative">
          <span aria-hidden="true" class="absolute top-3.5 left-4 text-[#fcf6ab]">👤</span>
          <input
            type="text"
            aria-label="เบอร์โทรศัพท์ หรือ ยูสเซอร์เนม"
            placeholder="เบอร์โทรศัพท์ / ยูสเซอร์เนม"
            class="w-full rounded-xl border border-[#34230b] bg-[#241a08]/95 py-3 pr-4 pl-12 text-[#f0e6cc] transition-all outline-none placeholder:text-[#c9bb96]/70 focus:border-[#ebdd65] focus:ring-1 focus:ring-[#ebdd65]/50"
          />
        </div>
        <div class="relative">
          <span aria-hidden="true" class="absolute top-3.5 left-4 text-[#fcf6ab]">🔑</span>
          <input
            type="password"
            aria-label="รหัสผ่าน"
            placeholder="รหัสผ่าน"
            class="w-full rounded-xl border border-[#34230b] bg-[#241a08]/95 py-3 pr-4 pl-12 text-[#f0e6cc] transition-all outline-none placeholder:text-[#c9bb96]/70 focus:border-[#ebdd65] focus:ring-1 focus:ring-[#ebdd65]/50"
          />
        </div>

        <div class="flex items-center justify-between px-1 text-xs">
          <label class="flex items-center gap-2 text-[#c9bb96]">
            <input type="checkbox" class="h-3.5 w-3.5 rounded border-[#34230b] bg-[#241a08] accent-[#ebdd65]" />
            จดจำฉันไว้
          </label>
          <a href="/login" class="text-[#c9bb96] transition-colors hover:text-[#fcf6ab]">ลืมรหัสผ่าน?</a>
        </div>

        <button
          class="mt-1 w-full rounded-xl border border-[#ebdd65]/40 bg-gradient-to-r from-[#fcf6ab] via-[#ebdd65] to-[#a8790f] p-3.5 font-black text-[#1a1204] shadow-[0_10px_30px_rgba(235,221,101,0.28)] transition-all hover:scale-[1.02] hover:shadow-[0_15px_40px_rgba(235,221,101,0.4)]">
          เข้าสู่ระบบ
        </button>

        <div class="flex items-center gap-3 py-1 text-[11px] text-[#c9bb96]/70">
          <span class="h-px flex-1 bg-[#34230b]"></span>
          หรือ
          <span class="h-px flex-1 bg-[#34230b]"></span>
        </div>

        <a
          href="/line"
          class="flex w-full items-center justify-center gap-2 rounded-xl bg-gradient-to-r from-[#00B900] to-[#009900] p-3 text-sm font-bold text-white shadow-md transition-all hover:scale-[1.02]">
          <span aria-hidden="true">💬</span> ติดต่อแอดมิน LINE
        </a>

        <div class="mt-1 flex items-center justify-between px-1">
          <div class="flex gap-2">
            <span class="rounded-full border border-[#ebdd65]/25 bg-[#241a08] px-2.5 py-1 text-[10px] font-bold text-[#ebdd65]"><span aria-hidden="true">🔒</span> Secure Popup Loader</span>
            <span class="rounded-full border border-[#f3c43c]/40 bg-[#241a08]/80 px-2.5 py-1 text-[10px] font-bold text-[#f3c43c]"><span aria-hidden="true">⚡</span> ระบบออโต้</span>
          </div>
          <a href="/register" class="text-xs font-bold text-[#fcf6ab] transition-colors hover:text-[#ebdd65]">สมัครสมาชิกใหม่</a>
        </div>
      </div>
    </div>
  </div>

  <div slot="right" class="h-full">
    <div class="flex h-full flex-col rounded-2xl border border-[#ebdd65]/25 bg-[#171106]/92 p-5 shadow-[0_10px_30px_rgba(235,221,101,0.16)] backdrop-blur-md">
      <div class="mb-5 flex items-center justify-between gap-3">
        <div>
          <span class="text-xs font-bold tracking-wide text-[#c9bb96]">ตารางอ้างอิงค่ายเกมและระบบภายในบัญชีเดียวของ TT1BET</span>
          <div class="bg-gradient-to-r from-[#dfe4e7] via-[#fcf6ab] to-[#f3c43c] bg-clip-text text-3xl font-black text-transparent sm:text-4xl">รวมเกมระดับโลกไว้ในที่เดียว</div>
        </div>
        <span class="flex items-center gap-1.5 self-start rounded-full border border-green-500/40 bg-green-900/40 px-2.5 py-1">
          <span class="h-1.5 w-1.5 animate-pulse rounded-full bg-green-500 shadow-[0_0_8px_rgba(34,197,94,0.7)]"></span>
          <span class="text-[10px] font-bold tracking-widest text-green-300 uppercase">Live</span>
        </span>
      </div>

      <div class="mb-2 flex items-center justify-between text-[11px] font-bold tracking-widest text-[#c9bb96]/70 uppercase">
        <span>ค่ายเกม / ระบบในเว็บ</span>
        <span>จุดเด่น</span>
      </div>

      <div class="flex flex-1 flex-col gap-2.5">
        {
          menus.map((m) => (
            <div class="rounded-xl border border-[#34230b] bg-[#241a08]/95 px-3.5 py-2.5 transition-colors hover:border-[#ebdd65]/50 hover:bg-[#171106]">
              <div class="flex items-center justify-between gap-2 text-sm">
                <span class="flex min-w-0 items-center gap-2 font-bold text-[#f0e6cc]">
                  <span aria-hidden="true" class="w-5 shrink-0 text-center">
                    {m.icon}
                  </span>{" "}
                  <span class="truncate">{m.name}</span>
                </span>
                <span class="shrink-0 rounded-full border border-[#ebdd65]/30 bg-[#0a0704] px-2.5 py-0.5 text-[10px] font-bold text-[#fcf6ab]">{m.tag}</span>
              </div>
              <div class="mt-1.5 text-[11px] tracking-wide text-[#c9bb96]">{m.detail}</div>
            </div>
          ))
        }
      </div>

      <div class="mt-4 flex flex-wrap items-center justify-center gap-2">
        {chips.map((c) => <span class="rounded-full border border-[#ebdd65]/25 bg-[#241a08] px-3 py-1 text-[10px] font-bold text-[#ebdd65]">{c}</span>)}
      </div>

      <div class="mt-3 text-center text-[10px] tracking-wide text-[#a3936a]">
        รายละเอียดค่ายเกมและสิทธิพิเศษอาจปรับเปลี่ยนตามช่วงเวลา ควรตรวจเงื่อนไขของแต่ละแคมเปญจากหน้าโปรโมชั่นจริงก่อนกดรับสิทธิ์ทุกครั้ง
      </div>
    </div>
  </div>
</ContentBoxTwo>
