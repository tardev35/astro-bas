---
import ContentBoxTwo from "./ContentBoxTwo.astro";

const menus = [
  { icon: "🐉", name: "PG Soft", detail: "กราฟิก 3D เหนือชั้น แอนิเมชันสมจริง ตอบสนองฉับไว โบนัสแตกไว", tag: "โบนัสแตกไว" },
  { icon: "⚡", name: "Pragmatic Play", detail: "ฟีเจอร์ทันสมัย เกมเพลย์รวดเร็วทรงพลัง ลุ้นแจ็กพอตก้อนโต", tag: "แจกรางวัลรัว" },
  { icon: "👑", name: "JILI", detail: "เอฟเฟกต์อลังการ ตัวเกมเบาและเสถียร สมูทบนสมาร์ทโฟนทุกรุ่น", tag: "ทำกำไรทะลุพิกัด" },
  { icon: "🤖", name: "ระบบออโต้ AI อัจฉริยะ", detail: "ตรวจสอบและปรับยอดเครดิตอัตโนมัติ ไม่ต้องส่งสลิปให้เสียเวลา", tag: "รวดเร็วดั่งใจนึก" },
  { icon: "💸", name: "ฝาก-ถอนไม่ผ่านคนกลาง", detail: "ธุรกรรมเสร็จภายในเสี้ยววินาที โอนไว ครบทุกบิล ตลอด 24 ชั่วโมง", tag: "โอนไว" },
  { icon: "🎁", name: "สิทธิพิเศษสมาชิก", detail: "ฝากแรกลุ้นรับทอง 1 บาท คืนยอดเสีย 15% และแนะนำเพื่อนรับ 0.8%", tag: "จ่ายจริง ไม่มีกั๊ก" },
  { icon: "🛡️", name: "Secure Transition Popup", detail: "เข้ารหัสระดับองค์กร ป้องกันการโหลดเว็บซ้ำซ้อน รักษาความเป็นส่วนตัว", tag: "ปลอดภัยขั้นสุด" },
];

const chips = ["PG Soft", "Pragmatic Play", "JILI", "ลิขสิทธิ์แท้ 100%", "ระบบออโต้", "โอนไว", "Premium Popup"];
---

<ContentBoxTwo
  titleleft="เข้าสู่ระบบ TUNJAI123"
  titleright="ค่ายเกมลิขสิทธิ์แท้และระบบที่ใช้ได้ทั้งบนมือถือและคอมพิวเตอร์"
  label="เข้าสู่ระบบ TUNJAI123 และค่ายเกมลิขสิทธิ์แท้ที่รวมไว้ในบัญชีเดียว">
  <div slot="left" class="flex h-full flex-col gap-4">
    <div class="relative overflow-hidden rounded-2xl border border-[#dab563]/25 bg-[#100d08]/92 p-6 shadow-[0_10px_30px_rgba(218,181,99,0.16)] backdrop-blur-md">
      <div class="pointer-events-none absolute -top-10 -right-10 h-32 w-32 rounded-full bg-[#dab563]/20 blur-[50px]"></div>

      <div class="relative z-10 mb-5 flex items-center gap-3">
        <span
          aria-hidden="true"
          class="flex h-11 w-11 shrink-0 items-center justify-center rounded-xl border border-[#dab563]/40 bg-gradient-to-br from-[#f5eb8b] via-[#dab563] to-[#a97f28] text-xl shadow-inner">👑</span>
        <div class="flex flex-col">
          <p class="text-base font-black text-[#dab563]">ยินดีต้อนรับกลับ</p>
          <span class="text-[11px] text-[#b5bbbc]">บัญชีเดียวใช้เลือกค่ายเกมลิขสิทธิ์แท้ กดรับสิทธิพิเศษ และทำรายการฝากถอนของ TUNJAI123 ได้จากจุดเดียว</span>
        </div>
      </div>

      <div class="relative z-10 flex flex-col gap-3.5">
        <div class="relative">
          <span aria-hidden="true" class="absolute top-3.5 left-4 text-[#a97f28]">👤</span>
          <input
            type="text"
            aria-label="เบอร์โทรศัพท์ หรือ ยูสเซอร์เนม"
            placeholder="เบอร์โทรศัพท์ / ยูสเซอร์เนม"
            class="w-full rounded-xl border border-[#3a2f1e] bg-[#1a1510]/95 py-3 pr-4 pl-12 text-[#ece3cf] transition-all outline-none placeholder:text-[#b5bbbc]/70 focus:border-[#dab563] focus:ring-1 focus:ring-[#dab563]/50"
          />
        </div>
        <div class="relative">
          <span aria-hidden="true" class="absolute top-3.5 left-4 text-[#a97f28]">🔑</span>
          <input
            type="password"
            aria-label="รหัสผ่าน"
            placeholder="รหัสผ่าน"
            class="w-full rounded-xl border border-[#3a2f1e] bg-[#1a1510]/95 py-3 pr-4 pl-12 text-[#ece3cf] transition-all outline-none placeholder:text-[#b5bbbc]/70 focus:border-[#dab563] focus:ring-1 focus:ring-[#dab563]/50"
          />
        </div>

        <div class="flex items-center justify-between px-1 text-xs">
          <label class="flex items-center gap-2 text-[#b5bbbc]">
            <input type="checkbox" class="h-3.5 w-3.5 rounded border-[#3a2f1e] bg-[#1a1510] accent-[#dab563]" />
            จดจำฉันไว้
          </label>
          <a href="/login" class="text-[#b5bbbc] transition-colors hover:text-[#f5eb8b]">ลืมรหัสผ่าน?</a>
        </div>

        <button
          class="mt-1 w-full rounded-xl border border-[#dab563]/40 bg-gradient-to-r from-[#f5eb8b] via-[#dab563] to-[#a97f28] p-3.5 font-black text-[#120c04] shadow-[0_10px_30px_rgba(218,181,99,0.28)] transition-all hover:scale-[1.02] hover:shadow-[0_15px_40px_rgba(218,181,99,0.38)]">
          เข้าสู่ระบบ
        </button>

        <div class="flex items-center gap-3 py-1 text-[11px] text-[#b5bbbc]/70">
          <span class="h-px flex-1 bg-[#3a2f1e]"></span>
          หรือ
          <span class="h-px flex-1 bg-[#3a2f1e]"></span>
        </div>

        <a
          href="/line"
          class="flex w-full items-center justify-center gap-2 rounded-xl bg-gradient-to-r from-[#00B900] to-[#009900] p-3 text-sm font-bold text-white shadow-md transition-all hover:scale-[1.02]">
          <span aria-hidden="true">💬</span> ติดต่อแอดมิน LINE
        </a>

        <div class="mt-1 flex items-center justify-between px-1">
          <div class="flex gap-2">
            <span class="rounded-full border border-[#dab563]/25 bg-[#1a1510] px-2.5 py-1 text-[10px] font-bold text-[#dab563]"><span aria-hidden="true">🔒</span> Premium Popup</span>
            <span class="rounded-full border border-[#dfe4e7]/40 bg-[#1a1510]/80 px-2.5 py-1 text-[10px] font-bold text-[#dfe4e7]"><span aria-hidden="true">🕐</span> ออโต้ 24 ชั่วโมง</span>
          </div>
          <a href="/register" class="text-xs font-bold text-[#a97f28] transition-colors hover:text-[#f5eb8b]">สมัครสมาชิกใหม่</a>
        </div>
      </div>
    </div>
  </div>

  <div slot="right" class="h-full">
    <div class="flex h-full flex-col rounded-2xl border border-[#dab563]/25 bg-[#100d08]/92 p-5 shadow-[0_10px_30px_rgba(218,181,99,0.16)] backdrop-blur-md">
      <div class="mb-5 flex items-center justify-between gap-3">
        <div>
          <span class="text-xs font-bold tracking-wide text-[#b5bbbc]">ตารางอ้างอิงค่ายเกมและระบบธุรกรรมภายในบัญชีเดียวของ TUNJAI123</span>
          <div class="bg-gradient-to-r from-[#f5eb8b] via-[#dab563] to-[#dfe4e7] bg-clip-text text-3xl font-black text-transparent sm:text-4xl">ปรับยอดเครดิตในไม่กี่วินาที</div>
        </div>
        <span class="flex items-center gap-1.5 self-start rounded-full border border-green-500/40 bg-green-900/40 px-2.5 py-1">
          <span class="h-1.5 w-1.5 animate-pulse rounded-full bg-green-500 shadow-[0_0_8px_rgba(34,197,94,0.7)]"></span>
          <span class="text-[10px] font-bold tracking-widest text-green-300 uppercase">Live</span>
        </span>
      </div>

      <div class="mb-2 flex items-center justify-between text-[11px] font-bold tracking-widest text-[#b5bbbc]/70 uppercase">
        <span>ค่ายเกม / บริการในระบบ</span>
        <span>จุดเด่น</span>
      </div>

      <div class="flex flex-1 flex-col gap-2.5">
        {
          menus.map((m) => (
            <div class="rounded-xl border border-[#3a2f1e] bg-[#1a1510]/95 px-3.5 py-2.5 transition-colors hover:border-[#dab563]/50 hover:bg-[#100d08]">
              <div class="flex items-center justify-between gap-2 text-sm">
                <span class="flex min-w-0 items-center gap-2 font-bold text-[#ece3cf]">
                  <span aria-hidden="true" class="w-5 shrink-0 text-center">{m.icon}</span> <span class="truncate">{m.name}</span>
                </span>
                <span class="shrink-0 rounded-full border border-[#dab563]/30 bg-[#050403] px-2.5 py-0.5 text-[10px] font-bold text-[#f5eb8b]">{m.tag}</span>
              </div>
              <div class="mt-1.5 text-[11px] tracking-wide text-[#b5bbbc]">{m.detail}</div>
            </div>
          ))
        }
      </div>

      <div class="mt-4 flex flex-wrap items-center justify-center gap-2">
        {chips.map((c) => <span class="rounded-full border border-[#dab563]/25 bg-[#1a1510] px-3 py-1 text-[10px] font-bold text-[#dab563]">{c}</span>)}
      </div>

      <div class="mt-3 text-center text-[10px] tracking-wide text-[#b5bbbc]/70">
        รายละเอียดค่ายเกมและสิทธิพิเศษอาจปรับเปลี่ยนตามช่วงเวลา ควรตรวจเงื่อนไขของแต่ละแคมเปญจากหน้าโปรโมชั่นจริงก่อนกดรับสิทธิ์ทุกครั้ง
      </div>
    </div>
  </div>
</ContentBoxTwo>
