---
import ContentBoxTwo from "./ContentBoxTwo.astro";

const menus = [
  { icon: "🐉", name: "PG Soft", detail: "3D แอนิเมชันสวยงามดึงดูดสายตา ฟีเจอร์แจกรางวัลต่อเนื่อง", tag: "โบนัสแตกไวระดับเทพ" },
  { icon: "⚡", name: "Pragmatic Play", detail: "กลไกออกรางวัลโปร่งใสและหนักหน่วง เข้าถึงรอบแจ็กพอตได้ไว", tag: "แจกรางวัลรัว" },
  { icon: "👑", name: "JILI", detail: "ตัวเกมเบาและเสถียร เข้าใช้งานสมูทบนสมาร์ทโฟนทุกรุ่น", tag: "ทำกำไรง่าย" },
  { icon: "🤖", name: "สถาปัตยกรรมการเงิน AI อัจฉริยะ", detail: "ประมวลผลและอัปเดตยอดเครดิตเข้ากระเป๋าอย่างแม่นยำ", tag: "ฝากถอนออโต้ไว 3 วิ" },
  { icon: "👛", name: "เชื่อมต่อกระเป๋าเงินดิจิทัล", detail: "โอนถ่ายเครดิตได้ทุกที่ทุกเวลา ลดขั้นตอนที่ซับซ้อน", tag: "รองรับทรูวอเลท" },
  { icon: "💸", name: "ทำธุรกรรมได้เต็มยอด", detail: "ให้บริการฟรีทุกการเชื่อมต่อ ไม่มีการหักค่าธรรมเนียมใดๆ", tag: "ไม่มีค่าธรรมเนียม" },
  { icon: "🛡️", name: "Premium Secure Popup", detail: "เข้ารหัสขั้นสูง ป้องกันหน้าเว็บโหลดซ้ำ ข้อมูลไม่รั่วไหล", tag: "ปลอดภัย 100%" },
];

const chips = ["PG Soft", "Pragmatic Play", "JILI", "สล็อตเว็บตรงอันดับ 1", "ฝากถอนออโต้ไว 3 วิ", "รองรับทรูวอเลท", "Secure Popup"];
---

<ContentBoxTwo titleleft="เข้าสู่ระบบ DEVA555" titleright="ค่ายเกมระดับโลกและระบบที่ใช้ได้ทั้งบนมือถือและคอมพิวเตอร์" label="เข้าสู่ระบบ DEVA555 และค่ายเกมระดับโลกที่รวมไว้ในบัญชีเดียว">
  <div slot="left" class="flex h-full flex-col gap-4">
    <div class="relative overflow-hidden rounded-2xl border border-[#dfb85f]/25 bg-[#140d04]/92 p-6 shadow-[0_10px_30px_rgba(223,184,95,0.16)] backdrop-blur-md">
      <div class="pointer-events-none absolute -top-10 -right-10 h-32 w-32 rounded-full bg-[#dfb85f]/20 blur-[50px]"></div>

      <div class="relative z-10 mb-5 flex items-center gap-3">
        <span
          aria-hidden="true"
          class="flex h-11 w-11 shrink-0 items-center justify-center rounded-xl border border-[#dfb85f]/40 bg-gradient-to-br from-[#fded9a] via-[#dfb85f] to-[#a57a32] text-xl shadow-inner">
          👑
        </span>
        <div class="flex flex-col">
          <p class="text-base font-black text-[#dfb85f]">ยินดีต้อนรับกลับ</p>
          <span class="text-[11px] text-[#b6a582]">บัญชีเดียวใช้เลือกค่ายเกมระดับโลก กดรับสิทธิพิเศษ และทำรายการ ฝากถอนออโต้ไว 3 วิ ของ DEVA555 ได้จากจุดเดียว</span>
        </div>
      </div>

      <div class="relative z-10 flex flex-col gap-3.5">
        <div class="relative">
          <span aria-hidden="true" class="absolute top-3.5 left-4 text-[#a57a32]">👤</span>
          <input
            type="text"
            aria-label="เบอร์โทรศัพท์ หรือ ยูสเซอร์เนม"
            placeholder="เบอร์โทรศัพท์ / ยูสเซอร์เนม"
            class="w-full rounded-xl border border-[#6b4c17] bg-[#1e1408]/95 py-3 pr-4 pl-12 text-[#e9ddbe] transition-all outline-none placeholder:text-[#b6a582]/70 focus:border-[#dfb85f] focus:ring-1 focus:ring-[#dfb85f]/50"
          />
        </div>
        <div class="relative">
          <span aria-hidden="true" class="absolute top-3.5 left-4 text-[#a57a32]">🔑</span>
          <input
            type="password"
            aria-label="รหัสผ่าน"
            placeholder="รหัสผ่าน"
            class="w-full rounded-xl border border-[#6b4c17] bg-[#1e1408]/95 py-3 pr-4 pl-12 text-[#e9ddbe] transition-all outline-none placeholder:text-[#b6a582]/70 focus:border-[#dfb85f] focus:ring-1 focus:ring-[#dfb85f]/50"
          />
        </div>

        <div class="flex items-center justify-between px-1 text-xs">
          <label class="flex items-center gap-2 text-[#b6a582]">
            <input type="checkbox" class="h-3.5 w-3.5 rounded border-[#6b4c17] bg-[#1e1408] accent-[#dfb85f]" />
            จดจำฉันไว้
          </label>
          <a href="/login" class="text-[#b6a582] transition-colors hover:text-[#fded9a]">ลืมรหัสผ่าน?</a>
        </div>

        <button
          class="mt-1 w-full rounded-xl border border-[#dfb85f]/40 bg-gradient-to-r from-[#fded9a] via-[#dfb85f] to-[#a57a32] p-3.5 font-black text-[#140d04] shadow-[0_10px_30px_rgba(223,184,95,0.28)] transition-all hover:scale-[1.02] hover:shadow-[0_15px_40px_rgba(223,184,95,0.38)]">
          เข้าสู่ระบบ
        </button>

        <div class="flex items-center gap-3 py-1 text-[11px] text-[#b6a582]/70">
          <span class="h-px flex-1 bg-[#6b4c17]"></span>
          หรือ
          <span class="h-px flex-1 bg-[#6b4c17]"></span>
        </div>

        <a
          href="/line"
          class="flex w-full items-center justify-center gap-2 rounded-xl bg-gradient-to-r from-[#00B900] to-[#009900] p-3 text-sm font-bold text-white shadow-md transition-all hover:scale-[1.02]">
          <span aria-hidden="true">💬</span> ติดต่อแอดมิน LINE
        </a>

        <div class="mt-1 flex items-center justify-between px-1">
          <div class="flex gap-2">
            <span class="rounded-full border border-[#dfb85f]/25 bg-[#1e1408] px-2.5 py-1 text-[10px] font-bold text-[#dfb85f]"><span aria-hidden="true">🔒</span> Secure Popup</span>
            <span class="rounded-full border border-[#dfe4e7]/40 bg-[#1e1408]/80 px-2.5 py-1 text-[10px] font-bold text-[#dfe4e7]"><span aria-hidden="true">🕐</span> ออโต้ 24 ชั่วโมง</span>
          </div>
          <a href="/register" class="text-xs font-bold text-[#a57a32] transition-colors hover:text-[#fded9a]">สมัครสมาชิกใหม่</a>
        </div>
      </div>
    </div>
  </div>

  <div slot="right" class="h-full">
    <div class="flex h-full flex-col rounded-2xl border border-[#dfb85f]/25 bg-[#140d04]/92 p-5 shadow-[0_10px_30px_rgba(223,184,95,0.16)] backdrop-blur-md">
      <div class="mb-5 flex items-center justify-between gap-3">
        <div>
          <span class="text-xs font-bold tracking-wide text-[#b6a582]">ตารางอ้างอิงค่ายเกมและระบบธุรกรรมภายในบัญชีเดียวของ DEVA555</span>
          <div class="bg-gradient-to-r from-[#fded9a] via-[#dfb85f] to-[#dfe4e7] bg-clip-text text-3xl font-black text-transparent sm:text-4xl">ปรับยอดเครดิตภายใน 3 วินาที</div>
        </div>
        <span class="flex items-center gap-1.5 self-start rounded-full border border-green-500/40 bg-green-900/40 px-2.5 py-1">
          <span class="h-1.5 w-1.5 animate-pulse rounded-full bg-green-500 shadow-[0_0_8px_rgba(34,197,94,0.7)]"></span>
          <span class="text-[10px] font-bold tracking-widest text-green-300 uppercase">Live</span>
        </span>
      </div>

      <div class="mb-2 flex items-center justify-between text-[11px] font-bold tracking-widest text-[#b6a582]/70 uppercase">
        <span>ค่ายเกม / บริการในระบบ</span>
        <span>จุดเด่น</span>
      </div>

      <div class="flex flex-1 flex-col gap-2.5">
        {
          menus.map((m) => (
            <div class="rounded-xl border border-[#6b4c17] bg-[#1e1408]/95 px-3.5 py-2.5 transition-colors hover:border-[#dfb85f]/50 hover:bg-[#140d04]">
              <div class="flex items-center justify-between gap-2 text-sm">
                <span class="flex min-w-0 items-center gap-2 font-bold text-[#e9ddbe]">
                  <span aria-hidden="true" class="w-5 shrink-0 text-center">
                    {m.icon}
                  </span>{" "}
                  <span class="truncate">{m.name}</span>
                </span>
                <span class="shrink-0 rounded-full border border-[#dfb85f]/30 bg-[#070502] px-2.5 py-0.5 text-[10px] font-bold text-[#fded9a]">{m.tag}</span>
              </div>
              <div class="mt-1.5 text-[11px] tracking-wide text-[#b6a582]">{m.detail}</div>
            </div>
          ))
        }
      </div>

      <div class="mt-4 flex flex-wrap items-center justify-center gap-2">
        {chips.map((c) => <span class="rounded-full border border-[#dfb85f]/25 bg-[#1e1408] px-3 py-1 text-[10px] font-bold text-[#dfb85f]">{c}</span>)}
      </div>

      <div class="mt-3 text-center text-[10px] tracking-wide text-[#8a7a5c]">
        รายละเอียดค่ายเกมและสิทธิพิเศษอาจปรับเปลี่ยนตามช่วงเวลา ควรตรวจเงื่อนไขของแต่ละแคมเปญจากหน้าโปรโมชั่นจริงก่อนกดรับสิทธิ์ทุกครั้ง
      </div>
    </div>
  </div>
</ContentBoxTwo>
