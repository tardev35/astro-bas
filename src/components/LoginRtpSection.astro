---
import ContentBoxTwo from "./ContentBoxTwoCyberCut.astro";

const menus = [
  { icon: "🎰", name: "สล็อตหลายค่าย", detail: "PG, Joker, Pragmatic และผู้ให้บริการกลุ่มอื่นในบัญชีเดียว", tag: "ดูเดิมพันขั้นต่ำ" },
  { icon: "🎴", name: "คาสิโนสด", detail: "บาคาร่า รูเล็ต และเกมโต๊ะที่เดินรอบแบบเรียลไทม์", tag: "ตรวจวงเงินโต๊ะ" },
  { icon: "🎁", name: "โบนัสบิลแรกสูงสุด 200%", detail: "เพิ่มเครดิตเริ่มต้น แต่ละยอดฝากได้รับไม่เท่ากัน", tag: "ดูเทิร์นและเพดานถอน" },
  { icon: "🪙", name: "เครดิตฟรีสมาชิกใหม่", detail: "ตัวเลขร่างประมาณ 50 บาท ตรวจซ้ำจากหน้าสมัครจริง", tag: "มีเงื่อนไขถอน" },
  { icon: "⏱️", name: "ฝากออโต้", detail: "ตัวเลขร่างประมาณ 10–30 วินาที ขึ้นกับธนาคารและสถานะระบบ", tag: "ยังไม่เข้าอย่าเพิ่งกดซ้ำ" },
  { icon: "💸", name: "ถอนออโต้", detail: "ตัวเลขร่างประมาณ 1–3 นาที ทำรายการเองได้ตลอด 24 ชั่วโมง", tag: "ตรวจชื่อบัญชี" },
  { icon: "📱", name: "เล่นผ่านเบราว์เซอร์", detail: "มือถือ แท็บเล็ต และคอมพิวเตอร์ ใช้บัญชีเดิมไม่ต้องย้ายข้อมูล", tag: "ไม่ต้องลงหลายแอป" },
];

const chips = ["สล็อต", "คาสิโนสด", "โบนัส 200%", "เครดิตฟรี", "ฝากออโต้", "ถอนออโต้", "มือถือ"];
---

<ContentBoxTwo titleleft="เข้าสู่ระบบ ตังค์มา168" titleright="หมวดเกมและระบบออโต้ที่ใช้ได้ทั้งบนมือถือและคอมพิวเตอร์" label="เข้าสู่ระบบ ตังค์มา168 และหมวดเกมที่ใช้ได้ทุกอุปกรณ์">
  <div slot="left" class="flex h-full flex-col gap-4">
    <div class="relative overflow-hidden rounded-2xl border border-[#ff3d9a]/25 bg-[#12040c]/92 p-6 shadow-[0_10px_30px_rgba(255,61,154,0.14)] backdrop-blur-md">
      <div class="pointer-events-none absolute -top-10 -right-10 h-32 w-32 rounded-full bg-[#ff3d9a]/20 blur-[50px]"></div>

      <div class="relative z-10 mb-5 flex items-center gap-3">
        <span aria-hidden="true" class="flex h-11 w-11 shrink-0 items-center justify-center rounded-xl border border-[#ff3d9a]/40 bg-gradient-to-br from-[#ffa6d2] via-[#ff3d9a] to-[#c21a70] text-xl shadow-inner">🎰</span>
        <div class="flex flex-col">
          <p class="text-base font-black text-[#ff3d9a]">ยินดีต้อนรับกลับ</p>
          <span class="text-[11px] text-[#d9a7c4]">บัญชีเดียวใช้เลือกเกม รับโปร และทำรายการฝากถอนของ TUNGMA168 ได้ในเส้นทางเดียว</span>
        </div>
      </div>

      <div class="relative z-10 flex flex-col gap-3.5">
        <div class="relative">
          <span aria-hidden="true" class="absolute top-3.5 left-4 text-[#c21a70]">👤</span>
          <input
            type="text"
            placeholder="เบอร์โทรศัพท์ / ยูสเซอร์เนม"
            class="w-full rounded-xl border border-[#7d0f46] bg-[#230a19]/95 py-3 pr-4 pl-12 text-[#fdeaf4] transition-all outline-none placeholder:text-[#a97b96] focus:border-[#ff3d9a] focus:ring-1 focus:ring-[#ff3d9a]/50"
          />
        </div>
        <div class="relative">
          <span aria-hidden="true" class="absolute top-3.5 left-4 text-[#c21a70]">🔑</span>
          <input
            type="password"
            placeholder="รหัสผ่าน"
            class="w-full rounded-xl border border-[#7d0f46] bg-[#230a19]/95 py-3 pr-4 pl-12 text-[#fdeaf4] transition-all outline-none placeholder:text-[#a97b96] focus:border-[#ff3d9a] focus:ring-1 focus:ring-[#ff3d9a]/50"
          />
        </div>

        <div class="flex items-center justify-between px-1 text-xs">
          <label class="flex items-center gap-2 text-[#d9a7c4]">
            <input type="checkbox" class="h-3.5 w-3.5 rounded border-[#7d0f46] bg-[#230a19] accent-[#ff3d9a]" />
            จดจำฉันไว้
          </label>
          <a href="/login" class="text-[#d9a7c4] transition-colors hover:text-[#ffa6d2]">ลืมรหัสผ่าน?</a>
        </div>

        <button
          class="mt-1 w-full rounded-xl border border-[#ff3d9a]/40 bg-gradient-to-r from-[#ffa6d2] via-[#ff3d9a] to-[#c21a70] p-3.5 font-black text-[#16050f] shadow-[0_10px_30px_rgba(255,61,154,0.26)] transition-all hover:scale-[1.02] hover:shadow-[0_15px_40px_rgba(255,61,154,0.36)]">
          เข้าสู่ระบบ
        </button>

        <div class="flex items-center gap-3 py-1 text-[11px] text-[#a97b96]">
          <span class="h-px flex-1 bg-[#4a1b36]"></span>
          หรือ
          <span class="h-px flex-1 bg-[#4a1b36]"></span>
        </div>

        <a
          href="/line"
          class="flex w-full items-center justify-center gap-2 rounded-xl bg-gradient-to-r from-[#00B900] to-[#009900] p-3 text-sm font-bold text-white shadow-md transition-all hover:scale-[1.02]">
          <span aria-hidden="true">💬</span> ติดต่อแอดมิน LINE
        </a>

        <div class="mt-1 flex items-center justify-between px-1">
          <div class="flex gap-2">
            <span class="rounded-full border border-[#ff3d9a]/25 bg-[#230a19] px-2.5 py-1 text-[10px] font-bold text-[#ff3d9a]"><span aria-hidden="true">🔒</span> HTTPS + SSL</span>
            <span class="rounded-full border border-[#22d3ee]/45 bg-[#1c0614]/80 px-2.5 py-1 text-[10px] font-bold text-[#8fe8f2]"><span aria-hidden="true">🕐</span> ระบบออโต้ 24 ชั่วโมง</span>
          </div>
          <a href="/register" class="text-xs font-bold text-[#c21a70] transition-colors hover:text-[#ffa6d2]">สมัครสมาชิกใหม่</a>
        </div>
      </div>
    </div>
  </div>

  <div slot="right" class="h-full">
    <div class="flex h-full flex-col rounded-2xl border border-[#ff3d9a]/25 bg-[#12040c]/92 p-5 shadow-[0_10px_30px_rgba(255,61,154,0.14)] backdrop-blur-md">
      <div class="mb-5 flex items-center justify-between gap-3">
        <div>
          <span class="text-xs font-bold tracking-wide text-[#d9a7c4]">ตารางอ้างอิงหมวดเกมและเวลาทำรายการภายในบัญชีเดียว</span>
          <div class="bg-gradient-to-r from-[#ffa6d2] via-[#ff3d9a] to-[#c21a70] bg-clip-text text-3xl font-black text-transparent sm:text-4xl">ฝาก 10–30 วิ • ถอน 1–3 นาที</div>
        </div>
        <span class="flex items-center gap-1.5 self-start rounded-full border border-green-500/40 bg-green-900/40 px-2.5 py-1">
          <span class="h-1.5 w-1.5 animate-pulse rounded-full bg-green-500 shadow-[0_0_8px_rgba(34,197,94,0.7)]"></span>
          <span class="text-[10px] font-bold tracking-widest text-green-300 uppercase">Live</span>
        </span>
      </div>

      <div class="mb-2 flex items-center justify-between text-[11px] font-bold tracking-widest text-[#a97b96] uppercase">
        <span>หมวดเกม / บริการในระบบ</span>
        <span>จุดที่ต้องดู</span>
      </div>

      <div class="flex flex-1 flex-col gap-2.5">
        {
          menus.map((m) => (
            <div class="rounded-xl border border-[#4a1b36] bg-[#230a19]/95 px-3.5 py-2.5 transition-colors hover:border-[#ff3d9a]/50 hover:bg-[#3a1229]">
              <div class="flex items-center justify-between gap-2 text-sm">
                <span class="flex min-w-0 items-center gap-2 font-bold text-[#fdeaf4]">
                  <span aria-hidden="true" class="w-5 shrink-0 text-center">{m.icon}</span> <span class="truncate">{m.name}</span>
                </span>
                <span class="shrink-0 rounded-full border border-[#ff3d9a]/30 bg-[#12040c] px-2.5 py-0.5 text-[10px] font-bold text-[#ffa6d2]">{m.tag}</span>
              </div>
              <div class="mt-1.5 text-[11px] tracking-wide text-[#d9a7c4]">{m.detail}</div>
            </div>
          ))
        }
      </div>

      <div class="mt-4 flex flex-wrap items-center justify-center gap-2">
        {chips.map((c) => <span class="rounded-full border border-[#ff3d9a]/25 bg-[#230a19] px-3 py-1 text-[10px] font-bold text-[#ff3d9a]">{c}</span>)}
      </div>

      <div class="mt-3 text-center text-[10px] tracking-wide text-[#a97b96]">
        ตัวเลขทั้งหมดเป็นข้อมูลร่างสำหรับอ้างอิง ควรตรวจยอดขั้นต่ำ จำนวนเทิร์น เกมที่ร่วมรายการ และเพดานถอนจากหน้าโปรโมชั่นจริงก่อนกดรับทุกครั้ง
      </div>
    </div>
  </div>
</ContentBoxTwo>
