---
import ContentBoxTwo from "./ContentBoxTwo.astro";

// Everything named here is this brand's own: the three camps the docx calls out
// (Microgaming, NetEnt, Novomatic) plus the four system claims it makes, so the
// table cannot contradict the prose the page sets above it.
const menus = [
  { icon: "👑", name: "Microgaming", detail: "ผู้บุกเบิกซอฟต์แวร์ เสถียรภาพสูง เครือข่ายแจ็กพอตเปลี่ยนคุณเป็นมหาเศรษฐี", tag: "ตำนานแห่งวงการ" },
  { icon: "💎", name: "NetEnt", detail: "แอนิเมชันระดับพรีเมียม กลไกออกรางวัลแยบยล ลุ้นรอบโบนัสต่อเนื่อง", tag: "กราฟิกอลังการ" },
  { icon: "🎰", name: "Novomatic", detail: "เกมเพลย์คลาสสิกทรงพลัง อัตราคูณเงินรางวัลสูง โหลดไวทุกอุปกรณ์", tag: "ทำกำไรต่อเนื่อง" },
  { icon: "🛡️", name: "ซอฟต์แวร์เกมมาตรฐานสากล", detail: "ทุกเกมผ่านการรับรองความโปร่งใส อัตราการจ่ายผลตอบแทนยุติธรรม", tag: "ค่ายใหญ่ลิขสิทธิ์แท้" },
  { icon: "👛", name: "เชื่อมต่อกระเป๋าเงินดิจิทัลโดยตรง", detail: "ฝากถอนอิสระเสรี ไม่ต้องพึ่งบัญชีธนาคารแบบเดิมๆ ยอดอัปเดตไวในเสี้ยววินาที", tag: "รองรับทรูวอเลท" },
  { icon: "🔒", name: "Secure Transition Popup Modal", detail: "เข้ารหัสขั้นสูง ป้องกันการรีเฟรชหน้าเว็บซ้ำซ้อน เป็นส่วนตัว 100%", tag: "ทางเข้าหลักเว็บตรง" },
  { icon: "🎁", name: "แคมเปญและโบนัสสนับสนุนเงินทุน", detail: "กดยอมรับสิทธิพิเศษได้ด้วยตนเองผ่านเมนูอัตโนมัติ ต่อยอดขีดความสามารถ", tag: "ระบบออโต้" },
];

const chips = ["Microgaming", "NetEnt", "Novomatic", "ทางเข้าหลักเว็บตรง", "ค่ายใหญ่ลิขสิทธิ์แท้", "รองรับทรูวอเลท", "Secure Popup"];
---

<ContentBoxTwo
  titleleft="เข้าสู่ระบบ ROMAN555"
  titleright="ค่ายเกมลิขสิทธิ์แท้และระบบที่ใช้ได้ทั้งบนมือถือและคอมพิวเตอร์"
  label="เข้าสู่ระบบ ROMAN555 และค่ายเกมลิขสิทธิ์แท้ที่รวมไว้ในบัญชีเดียว">
  <div slot="left" class="flex h-full flex-col gap-4">
    <div class="relative overflow-hidden rounded-2xl border border-[#d99a1c]/25 bg-[#1a0f04]/92 p-6 shadow-[0_10px_30px_rgba(217,154,28,0.16)] backdrop-blur-md">
      <div class="pointer-events-none absolute -top-10 -right-10 h-32 w-32 rounded-full bg-[#a8690a]/25 blur-[50px]"></div>

      <div class="relative z-10 mb-5 flex items-center gap-3">
        <span
          aria-hidden="true"
          class="flex h-11 w-11 shrink-0 items-center justify-center rounded-xl border border-[#d99a1c]/40 bg-gradient-to-br from-[#fbeab0] via-[#d99a1c] to-[#7a4405] text-xl shadow-inner">
          🃏
        </span>
        <div class="flex flex-col">
          <p class="text-base font-black text-[#fbeab0]">ยินดีต้อนรับกลับ</p>
          <span class="text-[11px] text-[#e8c9a0]">บัญชีเดียวเข้าถึงเกมลิขสิทธิ์แท้ทุกค่าย กดรับสิทธิพิเศษ และทำรายการผ่านระบบออโต้ของ ROMAN555 ได้จากจุดเดียว</span>
        </div>
      </div>

      <div class="relative z-10 flex flex-col gap-3.5">
        <div class="relative">
          <span aria-hidden="true" class="absolute top-3.5 left-4 text-[#fbeab0]">👤</span>
          <input
            type="text"
            aria-label="เบอร์โทรศัพท์ หรือ ยูสเซอร์เนม"
            placeholder="เบอร์โทรศัพท์ / ยูสเซอร์เนม"
            class="w-full rounded-xl border border-[#4a2503] bg-[#241505]/95 py-3 pr-4 pl-12 text-[#f2e4c4] transition-all outline-none placeholder:text-[#e8c9a0]/70 focus:border-[#d99a1c] focus:ring-1 focus:ring-[#d99a1c]/50"
          />
        </div>
        <div class="relative">
          <span aria-hidden="true" class="absolute top-3.5 left-4 text-[#fbeab0]">🔑</span>
          <input
            type="password"
            aria-label="รหัสผ่าน"
            placeholder="รหัสผ่าน"
            class="w-full rounded-xl border border-[#4a2503] bg-[#241505]/95 py-3 pr-4 pl-12 text-[#f2e4c4] transition-all outline-none placeholder:text-[#e8c9a0]/70 focus:border-[#d99a1c] focus:ring-1 focus:ring-[#d99a1c]/50"
          />
        </div>

        <div class="flex items-center justify-between px-1 text-xs">
          <label class="flex items-center gap-2 text-[#e8c9a0]">
            <input type="checkbox" class="h-3.5 w-3.5 rounded border-[#4a2503] bg-[#241505] accent-[#d99a1c]" />
            จดจำฉันไว้
          </label>
          <a href="/login" class="text-[#e8c9a0] transition-colors hover:text-[#fbeab0]">ลืมรหัสผ่าน?</a>
        </div>

        <button
          class="mt-1 w-full rounded-xl border border-[#d99a1c]/40 bg-gradient-to-r from-[#fbeab0] via-[#f6cf6a] to-[#a8690a] p-3.5 font-black text-[#1a1002] shadow-[0_10px_30px_rgba(246,207,106,0.28)] transition-all hover:scale-[1.02] hover:shadow-[0_15px_40px_rgba(246,207,106,0.4)]">
          เข้าสู่ระบบ
        </button>

        <div class="flex items-center gap-3 py-1 text-[11px] text-[#e8c9a0]/70">
          <span class="h-px flex-1 bg-[#4a2503]"></span>
          หรือ
          <span class="h-px flex-1 bg-[#4a2503]"></span>
        </div>

        <a
          href="/line"
          class="flex w-full items-center justify-center gap-2 rounded-xl bg-gradient-to-r from-[#00B900] to-[#009900] p-3 text-sm font-bold text-white shadow-md transition-all hover:scale-[1.02]">
          <span aria-hidden="true">💬</span> ติดต่อแอดมิน LINE
        </a>

        <div class="mt-1 flex items-center justify-between px-1">
          <div class="flex gap-2">
            <span class="rounded-full border border-[#d99a1c]/25 bg-[#241505] px-2.5 py-1 text-[10px] font-bold text-[#f6cf6a]"><span aria-hidden="true">🔒</span> Secure Transition Popup</span>
            <span class="rounded-full border border-[#d99a1c]/40 bg-[#241505]/80 px-2.5 py-1 text-[10px] font-bold text-[#d99a1c]"><span aria-hidden="true">⚡</span> ระบบออโต้</span>
          </div>
          <a href="/register" class="text-xs font-bold text-[#fbeab0] transition-colors hover:text-[#f6cf6a]">สมัครสมาชิกใหม่</a>
        </div>
      </div>
    </div>
  </div>

  <div slot="right" class="h-full">
    <div class="flex h-full flex-col rounded-2xl border border-[#d99a1c]/25 bg-[#1a0f04]/92 p-5 shadow-[0_10px_30px_rgba(217,154,28,0.16)] backdrop-blur-md">
      <div class="mb-5 flex items-center justify-between gap-3">
        <div>
          <span class="text-xs font-bold tracking-wide text-[#e8c9a0]">ตารางอ้างอิงค่ายเกมและระบบภายในบัญชีเดียวของ ROMAN555</span>
          <div class="bg-gradient-to-r from-[#fff6e0] via-[#fbeab0] to-[#d99a1c] bg-clip-text text-3xl font-black text-transparent sm:text-4xl">รวมค่ายใหญ่ไว้ในที่เดียว</div>
        </div>
        <span class="flex items-center gap-1.5 self-start rounded-full border border-green-500/40 bg-green-900/40 px-2.5 py-1">
          <span class="h-1.5 w-1.5 animate-pulse rounded-full bg-green-500 shadow-[0_0_8px_rgba(34,197,94,0.7)]"></span>
          <span class="text-[10px] font-bold tracking-widest text-green-300 uppercase">Live</span>
        </span>
      </div>

      <div class="mb-2 flex items-center justify-between text-[11px] font-bold tracking-widest text-[#e8c9a0]/70 uppercase">
        <span>ค่ายเกม / ระบบในเว็บ</span>
        <span>จุดเด่น</span>
      </div>

      <div class="flex flex-1 flex-col gap-2.5">
        {
          menus.map((m) => (
            <div class="rounded-xl border border-[#4a2503] bg-[#241505]/95 px-3.5 py-2.5 transition-colors hover:border-[#d99a1c]/50 hover:bg-[#33200a]">
              <div class="flex items-center justify-between gap-2 text-sm">
                <span class="flex min-w-0 items-center gap-2 font-bold text-[#f2e4c4]">
                  <span aria-hidden="true" class="w-5 shrink-0 text-center">
                    {m.icon}
                  </span>{" "}
                  <span class="truncate">{m.name}</span>
                </span>
                <span class="shrink-0 rounded-full border border-[#d99a1c]/30 bg-[#120a02] px-2.5 py-0.5 text-[10px] font-bold text-[#fbeab0]">{m.tag}</span>
              </div>
              <div class="mt-1.5 text-[11px] tracking-wide text-[#e8c9a0]">{m.detail}</div>
            </div>
          ))
        }
      </div>

      <div class="mt-4 flex flex-wrap items-center justify-center gap-2">
        {chips.map((c) => <span class="rounded-full border border-[#d99a1c]/25 bg-[#241505] px-3 py-1 text-[10px] font-bold text-[#f6cf6a]">{c}</span>)}
      </div>

      <div class="mt-3 text-center text-[10px] tracking-wide text-[#e8c9a0]/80">
        รายละเอียดค่ายเกมและสิทธิพิเศษอาจปรับเปลี่ยนตามช่วงเวลา ควรตรวจเงื่อนไขของแต่ละแคมเปญจากหน้าโปรโมชั่นจริงก่อนกดรับสิทธิ์ทุกครั้ง
      </div>
    </div>
  </div>
</ContentBoxTwo>
