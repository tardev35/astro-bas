---
import { Picture } from "astro:assets";
import img1 from "../assets/providers/game1.avif";
import img2 from "../assets/providers/game2.avif";
import img3 from "../assets/providers/game3.avif";
import img4 from "../assets/providers/game4.avif";
import img5 from "../assets/providers/game5.avif";
import img6 from "../assets/providers/game6.avif";

const games = [
  { rank: 1, name: "Mahjong Ways 2", type: "PG Soft • สล็อต 3D", menus: ["ยอดนิยม", "เล่นล่าสุด"], players: 5124, img: img1 },
  { rank: 2, name: "Gates of Olympus", type: "Pragmatic Play • สล็อต", menus: ["ยอดนิยม", "รายการโปรด"], players: 3842, img: img2 },
  { rank: 3, name: "San Quentin xWays", type: "Nolimit City • สล็อต", menus: ["ตัวคูณสูง", "รายการโปรด"], players: 3517, img: img3 },
  { rank: 4, name: "Treasures of Aztec", type: "PG Soft • สล็อต 3D", menus: ["เกมใหม่", "เล่นล่าสุด"], players: 2905, img: img4 },
  { rank: 5, name: "Sweet Bonanza", type: "Pragmatic Play • สล็อต", menus: ["เกมใหม่", "รายการโปรด"], players: 2431, img: img5 },
  { rank: 6, name: "Fire in the Hole xBonus", type: "Nolimit City • สล็อต", menus: ["ตัวคูณสูง", "เล่นล่าสุด"], players: 2108, img: img6 },
];

const medal = (rank: number) => (rank === 1 ? "🥇" : rank === 2 ? "🥈" : rank === 3 ? "🥉" : null);
---

<section aria-label="เกมยอดนิยมจากค่ายระดับโลกบน PGW44" class="mx-auto w-full max-w-[1300px] px-4 py-8 font-sans">
  <div class="mb-8 flex w-full flex-col items-center justify-center gap-2 text-center">
    <span aria-hidden="true" class="text-2xl">🏆</span>
    <p class="bg-gradient-to-r from-[#ffd54a] via-[#ecab03] to-[#8fd633] bg-clip-text text-2xl font-black tracking-widest text-transparent uppercase">
      เกมยอดนิยมจากค่ายระดับโลกบน PGW44
    </p>
    <p class="max-w-3xl text-base leading-relaxed text-[#b9c4a6]">
      ทุกเกมบนระบบผ่านการตรวจสอบเสถียรภาพก่อนเปิดให้บริการ กราฟิกจึงแสดงผลได้คมชัดและมีอัตราการจ่ายที่ยุติธรรม
      รายชื่อในกระดานนี้เปลี่ยนแปลงได้ตามช่วงเวลา และควรตรวจรายละเอียดจากหน้าเกมจริงอีกครั้งก่อนเริ่มเล่น
    </p>
    <div class="mt-2 h-[3px] w-24 rounded-full bg-gradient-to-r from-transparent via-[#ecab03] to-transparent"></div>
  </div>

  <div class="flex flex-col gap-3">
    {
      games.map((g) => {
        const top = g.rank === 1;
        return (
          <article
            class={`group relative flex items-center gap-3 overflow-hidden rounded-2xl border p-3 backdrop-blur-md transition-all duration-300 hover:-translate-y-0.5 sm:gap-5 sm:p-4 ${
              top
                ? "border-[#ecab03]/50 bg-gradient-to-r from-[#1a2610]/95 via-[#111a0a]/92 to-[#111a0a]/92 shadow-[0_15px_40px_rgba(236,171,3,0.3)]"
                : "border-[#ecab03]/25 bg-[#111a0a]/92 shadow-[0_10px_30px_rgba(236,171,3,0.18)] hover:border-[#ecab03]/50 hover:shadow-[0_15px_40px_rgba(236,171,3,0.3)]"
            }`}>
            <div class="pointer-events-none absolute top-1/2 -left-10 h-24 w-24 -translate-y-1/2 rounded-full bg-[#ecab03]/25 blur-[40px] transition-all duration-500 group-hover:bg-[#8fd633]/35" />

            <div class="relative z-10 flex w-8 shrink-0 flex-col items-center justify-center sm:w-12">
              {/* Ranks 1–3 show a medal INSTEAD of the number, so hiding the
                  emoji on its own would leave those three rows with no rank at
                  all. The visually-hidden text puts it back. */}
              {
                medal(g.rank) ? (
                  <span class="text-2xl sm:text-3xl">
                    <span aria-hidden="true">{medal(g.rank)}</span>
                    <span class="sr-only">อันดับ {g.rank}</span>
                  </span>
                ) : (
                  <span class="text-xl font-black text-[#a9760a] sm:text-2xl">#{g.rank}</span>
                )
              }
            </div>

            <div class={`relative z-10 h-14 w-14 shrink-0 overflow-hidden rounded-xl border sm:h-16 sm:w-16 ${top ? "border-[#ecab03]/50" : "border-[#ecab03]/25"}`}>
              <Picture
                src={g.img}
                alt={`ภาพหน้าปกเกม ${g.name} ในกระดานเกมยอดนิยมของ PGW44`}
                formats={["avif", "webp"]}
                fallbackFormat="webp"
                loading="lazy"
                fetchpriority="low"
                widths={[100, 200]}
                sizes="(max-width: 640px) 56px, 64px"
                decoding="async"
                class="h-full w-full object-cover transition-transform duration-500 group-hover:scale-110"
              />
            </div>

            <div class="relative z-10 min-w-0 flex-1">
              <div class="flex items-center gap-2">
                <p class="truncate text-base font-black text-[#e8efd8] sm:text-lg">{g.name}</p>
                {top && <span class="hidden shrink-0 rounded-full border border-[#8fd633]/60 bg-[#0a0f06] px-2 py-0.5 text-[9px] font-black tracking-wider text-[#8fd633] sm:inline">ยอดนิยมสูงสุด</span>}
              </div>
              <p class="truncate text-[11px] text-[#b9c4a6] sm:text-xs">{g.type}</p>

              <div class="mt-2 flex flex-wrap items-center gap-1.5">
                {g.menus.map((m) => (
                  <span class="rounded-full border border-[#ecab03]/25 bg-[#0a0f06] px-2.5 py-0.5 text-[10px] font-bold text-[#ecab03]">{m}</span>
                ))}
              </div>
            </div>

            <div class="relative z-10 hidden shrink-0 flex-col items-end gap-1 sm:flex">
              <span class="flex items-center gap-1.5 text-[11px] text-[#b9c4a6]">
                <span class="h-1.5 w-1.5 animate-pulse rounded-full bg-green-500 shadow-[0_0_6px_rgba(34,197,94,0.6)]" />
                <span class="tabular-nums" data-players data-base={g.players}>
                  {g.players.toLocaleString("en-US")}
                </span>{" "}
                ออนไลน์
              </span>
              <a
                href="/register"
                class={`rounded-full px-4 py-1.5 text-xs font-black transition-transform hover:scale-105 ${
                  top
                    ? "bg-gradient-to-r from-[#ffd54a] via-[#ecab03] to-[#a9760a] text-[#0a0f06] shadow-[0_10px_30px_rgba(236,171,3,0.24)]"
                    : "border border-[#ecab03]/60 bg-[#0a0f06] text-[#ecab03] hover:border-[#ecab03] hover:bg-[#1a2610]"
                }`}>
                เข้าดูเกม
              </a>
            </div>
          </article>
        );
      })
    }
  </div>
</section>

<script>
  // Guards for visibility, background tabs and reduced-motion live in
  // src/lib/liveCounter.ts — a file no rebrand rewrites. Do not reinstate a
  // bare setTimeout loop here; the counters sit inside a `hidden sm:flex`
  // container, so an unguarded one wakes the main thread on every phone to
  // update text nobody can see.
  import { startLiveCounters } from "../lib/liveCounter";

  startLiveCounters();
</script>
