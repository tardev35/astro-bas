---
import { Picture } from "astro:assets";
import img1 from "../assets/providers/game1.avif";
import img2 from "../assets/providers/game2.avif";
import img3 from "../assets/providers/game3.avif";
import img4 from "../assets/providers/game4.avif";
import img5 from "../assets/providers/game5.avif";
import img6 from "../assets/providers/game6.avif";

const games = [
  { rank: 1, name: "Mahjong Ways 2", type: "PG Soft • สล็อต", menus: ["ยอดนิยม", "รายการโปรด"], players: 5124, img: img1 },
  { rank: 2, name: "Gates of Olympus", type: "Pragmatic Play • สล็อต", menus: ["ยอดนิยม", "เล่นล่าสุด"], players: 3842, img: img2 },
  { rank: 3, name: "Immortal Romance", type: "Microgaming • สล็อต", menus: ["ยอดนิยม", "เกมใหม่"], players: 3517, img: img3 },
  { rank: 4, name: "Fortune Gems", type: "JILI • สล็อต", menus: ["เกมใหม่", "รายการโปรด"], players: 2905, img: img4 },
  { rank: 5, name: "Super Ace", type: "JILI • สล็อต", menus: ["เกมใหม่", "เล่นล่าสุด"], players: 2431, img: img5 },
  { rank: 6, name: "บาคาร่า ห้อง Live สด", type: "Evolution • คาสิโนสด", menus: ["ยอดนิยม", "เล่นล่าสุด"], players: 2108, img: img6 },
];

const medal = (rank: number) => (rank === 1 ? "🥇" : rank === 2 ? "🥈" : rank === 3 ? "🥉" : null);
---

<section class="mx-auto w-full max-w-[1300px] px-4 py-8 font-sans">
  <div class="mb-8 flex w-full flex-col items-center justify-center gap-2 text-center">
    <span class="text-2xl">🏆</span>
    <p class="bg-gradient-to-r from-[#f2dca4] via-[#dcb96b] to-[#ac893a] bg-clip-text text-2xl font-black tracking-widest text-transparent uppercase">
      เมนูเกมยอดนิยมของ UFAG8 นอกเหนือจากตลาดกีฬา
    </p>
    <p class="max-w-2xl text-base leading-relaxed text-[#bcb6a6]">
      แกนหลักของ UFAG8 อยู่ที่ฟุตบอลและการเดิมพันกีฬา ส่วนหมวดคาสิโนสดและสล็อตเป็นตัวเลือกเสริมที่ใช้บัญชีเดียวกัน เมนูยอดนิยม เกมใหม่ รายการโปรด และเล่นล่าสุด
      ช่วยให้กลับไปหารายการเดิมได้เร็วขึ้น รายชื่อในแต่ละหมวดเปลี่ยนแปลงได้ตามช่วงเวลา
    </p>
    <div class="mt-2 h-[3px] w-24 rounded-full bg-gradient-to-r from-transparent via-[#dcb96b] to-transparent"></div>
  </div>

  <div class="flex flex-col gap-3">
    {
      games.map((g) => {
        const top = g.rank === 1;
        return (
          <article
            class={`group relative flex items-center gap-3 overflow-hidden rounded-2xl border p-3 backdrop-blur-md transition-all duration-300 hover:-translate-y-0.5 sm:gap-5 sm:p-4 ${
              top
                ? "border-[#dcb96b]/50 bg-gradient-to-r from-[#191712]/95 via-[#100f0c]/92 to-[#100f0c]/92 shadow-[0_15px_40px_rgba(220,185,107,0.3)]"
                : "border-[#dcb96b]/25 bg-[#100f0c]/92 shadow-[0_10px_30px_rgba(220,185,107,0.18)] hover:border-[#dcb96b]/50 hover:shadow-[0_15px_40px_rgba(220,185,107,0.3)]"
            }`}>
            <div class="pointer-events-none absolute top-1/2 -left-10 h-24 w-24 -translate-y-1/2 rounded-full bg-[#dcb96b]/25 blur-[40px] transition-all duration-500 group-hover:bg-[#dcb96b]/35" />

            <div class="relative z-10 flex w-8 shrink-0 flex-col items-center justify-center sm:w-12">
              {medal(g.rank) ? <span class="text-2xl sm:text-3xl">{medal(g.rank)}</span> : <span class="text-xl font-black text-[#ac893a] sm:text-2xl">#{g.rank}</span>}
            </div>

            <div class={`relative z-10 h-14 w-14 shrink-0 overflow-hidden rounded-xl border sm:h-16 sm:w-16 ${top ? "border-[#dcb96b]/50" : "border-[#dcb96b]/25"}`}>
              <Picture
                src={g.img}
                alt={`${g.name} รายการในเมนูยอดนิยมของ UFAG8`}
                formats={["avif", "webp"]}
                fallbackFormat="webp"
                loading="lazy"
                fetchpriority="low"
                widths={[100, 200]}
                decoding="async"
                class="h-full w-full object-cover transition-transform duration-500 group-hover:scale-110"
              />
            </div>

            <div class="relative z-10 min-w-0 flex-1">
              <div class="flex items-center gap-2">
                <p class="truncate text-base font-black text-[#efeade] sm:text-lg">{g.name}</p>
                {top && <span class="hidden shrink-0 rounded-full border border-[#b9bcc4]/50 bg-[#15171c] px-2 py-0.5 text-[9px] font-black tracking-wider text-[#d7dae1] sm:inline">ยอดนิยมสูงสุด</span>}
              </div>
              <p class="truncate text-[11px] text-[#bcb6a6] sm:text-xs">{g.type}</p>

              <div class="mt-2 flex flex-wrap items-center gap-1.5">
                {g.menus.map((m) => (
                  <span class="rounded-full border border-[#dcb96b]/25 bg-[#191712] px-2.5 py-0.5 text-[10px] font-bold text-[#dcb96b]">{m}</span>
                ))}
              </div>
            </div>

            <div class="relative z-10 hidden shrink-0 flex-col items-end gap-1 sm:flex">
              <span class="flex items-center gap-1.5 text-[11px] text-[#bcb6a6]">
                <span class="h-1.5 w-1.5 animate-pulse rounded-full bg-green-500 shadow-[0_0_6px_rgba(34,197,94,0.6)]" />
                <span class="tabular-nums" data-players data-base={g.players}>
                  {g.players.toLocaleString("en-US")}
                </span>{" "}
                ออนไลน์
              </span>
              <a
                href="/register"
                class={`rounded-full px-4 py-1.5 text-xs font-black transition-transform hover:scale-105 ${
                  top
                    ? "bg-gradient-to-r from-[#f2dca4] via-[#dcb96b] to-[#ac893a] text-[#141210] shadow-[0_10px_30px_rgba(220,185,107,0.22)]"
                    : "border border-[#dcb96b]/60 bg-[#0c0b09] text-[#dcb96b] hover:border-[#dcb96b] hover:bg-[#191712]"
                }`}>
                เข้าดูรายการ
              </a>
            </div>
          </article>
        );
      })
    }
  </div>
</section>

<style>
  .font-sans {
    font-family: var(--font-sans);
  }
</style>

<script>
  const nf = new Intl.NumberFormat("en-US");

  document.querySelectorAll<HTMLElement>("[data-players]").forEach((el) => {
    const base = Number(el.dataset.base) || 0;
    let current = base;

    const tick = () => {
      const drift = Math.round((Math.random() - 0.5) * base * 0.02);
      const pull = Math.round((base - current) * 0.15);
      current = Math.max(1, current + drift + pull);
      el.textContent = nf.format(current);

      setTimeout(tick, 1500 + Math.random() * 2000);
    };

    setTimeout(tick, Math.random() * 2000);
  });
</script>
