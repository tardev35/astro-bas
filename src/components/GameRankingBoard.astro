---
import { Picture } from "astro:assets";
import img1 from "../assets/providers/game1.avif";
import img2 from "../assets/providers/game2.avif";
import img3 from "../assets/providers/game3.avif";
import img4 from "../assets/providers/game4.avif";
import img5 from "../assets/providers/game5.avif";
import img6 from "../assets/providers/game6.avif";

const games = [
  { rank: 1, name: "Mahjong Ways 2", type: "PG Soft • ความผันผวนปานกลาง", rtp: 98.7, players: 5124, img: img1 },
  { rank: 2, name: "Fortune Tiger", type: "PG Soft • ความผันผวนปานกลาง", rtp: 98.1, players: 3842, img: img2 },
  { rank: 3, name: "Gates of Olympus", type: "Pragmatic Play • ความผันผวนสูง", rtp: 97.8, players: 3517, img: img3 },
  { rank: 4, name: "Sweet Bonanza", type: "Pragmatic Play • ความผันผวนปานกลาง–สูง", rtp: 97.3, players: 2905, img: img4 },
  { rank: 5, name: "Roma Deluxe", type: "JOKER Gaming • ความผันผวนปานกลาง", rtp: 96.9, players: 2431, img: img5 },
  { rank: 6, name: "Golden Dragon", type: "JOKER Gaming • ความผันผวนต่ำ", rtp: 96.5, players: 2108, img: img6 },
];

const medal = (rank: number) => (rank === 1 ? "🥇" : rank === 2 ? "🥈" : rank === 3 ? "🥉" : null);
---

<section class="mx-auto w-full max-w-[1300px] px-4 py-8 font-sans">
  <div class="mb-8 flex w-full flex-col items-center justify-center gap-2 text-center">
    <span class="text-2xl drop-shadow-[0_0_10px_rgba(236,72,153,0.7)]">🏆</span>
    <p class="bg-gradient-to-r from-white via-pink-100 to-pink-300 bg-clip-text text-2xl font-black tracking-widest text-transparent uppercase drop-shadow-sm">เกมยอดนิยมประจำสัปดาห์ของ BUNNY555</p>
    <p class="max-w-2xl text-sm text-pink-50/60">ค่า RTP และความผันผวนแตกต่างกันตามมาตรฐานของแต่ละค่าย ข้อมูลนี้ใช้ประกอบการเลือกเกมของผู้เริ่มต้นเท่านั้น</p>
    <div class="mt-2 h-[3px] w-24 rounded-full bg-gradient-to-r from-transparent via-pink-400 to-transparent"></div>
  </div>

  <div class="flex flex-col gap-3">
    {
      games.map((g) => {
        const top = g.rank === 1;
        return (
          <article
            class={`group relative flex items-center gap-3 overflow-hidden rounded-2xl border p-3 backdrop-blur-md transition-all duration-300 hover:-translate-y-0.5 sm:gap-5 sm:p-4 ${
              top
                ? "border-pink-300/50 bg-gradient-to-r from-[#3a1122]/90 via-[#1c0b12]/90 to-[#1c0b12]/90 shadow-[0_10px_30px_rgba(236,72,153,0.18)]"
                : "border-pink-400/25 bg-[#1c0b12]/80 shadow-[0_5px_20px_rgba(0,0,0,0.4)] hover:border-pink-300/50 hover:shadow-[0_10px_30px_rgba(236,72,153,0.25)]"
            }`}>
            <div class="pointer-events-none absolute top-1/2 -left-10 h-24 w-24 -translate-y-1/2 rounded-full bg-rose-500/15 blur-[40px] transition-all duration-500 group-hover:bg-pink-400/20" />

            <div class="relative z-10 flex w-8 shrink-0 flex-col items-center justify-center sm:w-12">
              {medal(g.rank) ? (
                <span class="text-2xl drop-shadow-[0_0_8px_rgba(236,72,153,0.55)] sm:text-3xl">{medal(g.rank)}</span>
              ) : (
                <span class="text-xl font-black text-pink-200/70 sm:text-2xl">#{g.rank}</span>
              )}
            </div>

            <div class={`relative z-10 h-14 w-14 shrink-0 overflow-hidden rounded-xl border sm:h-16 sm:w-16 ${top ? "border-pink-300/50" : "border-pink-400/30"}`}>
              <Picture
                src={g.img}
                alt={`${g.name} เกมยอดนิยมภายใน BUNNY555`}
                formats={["avif", "webp"]}
                fallbackFormat="webp"
                loading="lazy"
                fetchpriority="low"
                widths={[100, 200]}
                decoding="async"
                class="h-full w-full object-cover transition-transform duration-500 group-hover:scale-110"
              />
            </div>

            <div class="relative z-10 min-w-0 flex-1">
              <div class="flex items-center gap-2">
                <p class="truncate text-base font-black text-white sm:text-lg">{g.name}</p>
                {top && <span class="hidden shrink-0 rounded-full border border-pink-300/40 bg-pink-300/10 px-2 py-0.5 text-[9px] font-black tracking-wider text-pink-200 sm:inline">TOP RTP</span>}
              </div>
              <p class="truncate text-[11px] text-pink-50/50 sm:text-xs">{g.type}</p>

              <div class="mt-2 flex items-center gap-2">
                <div class="h-1.5 flex-1 overflow-hidden rounded-full bg-[#050203]">
                  <div class={`h-full rounded-full ${top ? "bg-gradient-to-r from-[#fce7f3] to-[#ec4899]" : "bg-gradient-to-r from-[#be185d] to-[#f9a8d4]"}`} style={`width:${g.rtp}%`} />
                </div>
                <span class={`shrink-0 text-xs font-black tabular-nums ${top ? "text-pink-200" : "text-pink-100"}`}>{g.rtp}%</span>
              </div>
            </div>

            <div class="relative z-10 hidden shrink-0 flex-col items-end gap-1 sm:flex">
              <span class="flex items-center gap-1.5 text-[11px] text-pink-50/50">
                <span class="h-1.5 w-1.5 animate-pulse rounded-full bg-green-400 shadow-[0_0_6px_rgba(74,222,128,0.7)]" />
                <span class="tabular-nums" data-players data-base={g.players}>
                  {g.players.toLocaleString("en-US")}
                </span>{" "}
                ออนไลน์
              </span>
              <a
                href="/register"
                class={`rounded-full px-4 py-1.5 text-xs font-black transition-transform hover:scale-105 ${
                  top
                    ? "bg-gradient-to-r from-[#fce7f3] via-[#f9a8d4] to-[#db2777] text-[#241019] shadow-[0_4px_15px_rgba(236,72,153,0.45)]"
                    : "border border-pink-400/50 bg-[#3a1122]/60 text-pink-100 hover:border-pink-200 hover:text-white"
                }`}>
                เล่นเลย
              </a>
            </div>
          </article>
        );
      })
    }
  </div>
</section>

<style>
  .font-sans {
    font-family: var(--font-sans);
  }
</style>

<script>
  const nf = new Intl.NumberFormat("en-US");

  document.querySelectorAll<HTMLElement>("[data-players]").forEach((el) => {
    const base = Number(el.dataset.base) || 0;
    let current = base;

    const tick = () => {
      const drift = Math.round((Math.random() - 0.5) * base * 0.02);
      const pull = Math.round((base - current) * 0.15);
      current = Math.max(1, current + drift + pull);
      el.textContent = nf.format(current);

      setTimeout(tick, 1500 + Math.random() * 2000);
    };

    setTimeout(tick, Math.random() * 2000);
  });
</script>
