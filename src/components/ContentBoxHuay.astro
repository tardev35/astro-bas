---
export interface Props {
  title?: string;
  as?: "h1" | "h2" | "h3" | "h4" | "h5" | "h6";
}
const { title, as: HeadingTag = "h1" } = Astro.props;
---

<section class="relative z-10 my-8 flex w-full justify-center px-4 font-sans">
  <div
    class="group relative isolate w-full max-w-[1400px] overflow-hidden rounded-3xl border border-amber-600/30 bg-[#faf4e6]/95 p-8 text-left text-base leading-relaxed text-[#3a2e18] shadow-[0_10px_30px_rgba(168,132,44,0.18)] backdrop-blur-xl transition-all duration-500 hover:border-amber-600/55 hover:shadow-[0_15px_40px_rgba(168,132,44,0.30)] md:p-10">
    <div class="pointer-events-none absolute -top-20 -left-20 -z-10 h-40 w-40 rounded-full bg-amber-400/30 blur-[50px] transition-all duration-500 group-hover:bg-amber-500/40"></div>
    <div class="pointer-events-none absolute -right-20 -bottom-20 -z-10 h-40 w-40 rounded-full bg-[#cfd0d2]/45 blur-[50px] transition-all duration-500 group-hover:bg-[#c6c8cb]/60"></div>

    {
      title && (
        <header class="mb-6 flex items-center gap-4 border-b border-amber-600/30 pb-4">
          <div class="h-8 w-1.5 shrink-0 rounded-full bg-gradient-to-b from-[#e8cf8b] to-[#a97f2a] shadow-[0_0_10px_rgba(201,162,39,0.45)]" />
          <HeadingTag class="bg-gradient-to-r from-[#7a5a12] via-[#b8912f] to-[#8a6a1f] bg-clip-text text-2xl leading-normal font-black tracking-widest text-transparent uppercase">{title}</HeadingTag>
        </header>
      )
    }
    <slot />
  </div>
</section>
<style>
  .font-sans {
    font-family: var(--font-sans);
  }
</style>
