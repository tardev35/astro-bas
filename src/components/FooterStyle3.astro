---
import { BRAND_ADDRESS } from "../lib/brandProfile";
import { Picture } from "astro:assets";
import BankStrip from "./BankStrip.astro";
const images = import.meta.glob<{ default: ImageMetadata }>("../assets/logo.{png,webp,jpg}", { eager: true });

const imagePaths = Object.keys(images);
const mainLogo = imagePaths.length > 0 ? images[imagePaths[0]].default : null;

const logoAlt = "โลโก้ BUNNY555 ตัวอักษรอวบสีชมพูหวานไล่เฉดขาว คำว่า BUNNY ต่อด้วยเลข 555 สีขาวมุกขอบชมพู";
---

<footer
  class="relative mt-32 w-full border-t border-[#ff4d9d]/30 bg-[#150207] pt-64 pb-6 font-sans text-[#ffdcea] shadow-[0_-10px_30px_rgba(255,77,157,0.15)] md:pt-40">
  <div
    class="absolute -top-14 left-1/2 z-20 flex w-[92%] max-w-5xl -translate-x-1/2 flex-col items-center justify-between rounded-2xl border border-[#ff4d9d]/35 bg-gradient-to-r from-[#26050f] via-[#3a0818] to-[#26050f] p-6 shadow-[0_15px_40px_rgba(255,77,157,0.22)] md:-top-16 md:flex-row md:p-8">
    <div class="mb-5 flex flex-col text-center md:mb-0 md:text-left">
      <p class="text-xl font-black tracking-wide text-[#ffc2da] uppercase italic drop-shadow-[0_2px_4px_rgba(0,0,0,0.5)] md:text-3xl"><span aria-hidden="true">🐰</span> พร้อมทำกำไรแบบ เล่นง่าย ได้เงินไว กับ BUNNY555 แล้วหรือยัง?</p>
      <p class="mt-2 text-sm font-medium text-[#e0a5bd] md:text-base">
        สมัคร BUNNY555 ด้วยเบอร์โทรภายในไม่กี่นาที แล้วเข้าเล่นเว็บสล็อตลิขสิทธิ์แท้จากค่ายชั้นนำได้ในบัญชีเดียว ฝากถอนออโต้ด้วยระบบ AI รองรับทรูวอเลท ตรวจเงื่อนไขทุกครั้งก่อนกดรับสิทธิ์
      </p>
    </div>

    <a
      href="/register"
      class="group relative flex items-center justify-center overflow-hidden rounded-full border border-[#ffc2da] bg-gradient-to-b from-[#ffc2da] to-[#a3134f] px-8 py-3.5 text-sm font-extrabold whitespace-nowrap text-[#26050f] shadow-[0_0_15px_rgba(255,77,157,0.4)] transition-all hover:scale-105 md:text-base">
      <span class="relative z-10">สมัครสมาชิกเลย <span aria-hidden="true">🚀</span></span>
      <div class="absolute inset-0 translate-y-full bg-[#ffc2da] transition-transform duration-300 group-hover:translate-y-0"></div>
    </a>
  </div>

  <div class="relative z-10 mx-auto max-w-[1200px] px-6">
    <div class="mb-10 grid grid-cols-1 gap-10 md:grid-cols-12 lg:gap-12">
      <div class="flex flex-col gap-6 md:col-span-12 lg:col-span-4">
        <a href="/" class="inline-block origin-left transition-transform hover:scale-105">
          {
            mainLogo ? (
              <Picture
                src={mainLogo}
                alt={logoAlt}
                widths={[100, 200, 300]}
                sizes="100px"
                height={45}
                loading="lazy"
                decoding="async"
                class="h-[45px] w-auto drop-shadow-[0_0_12px_rgba(255,77,157,0.6)]"
                formats={["avif", "webp"]}
                fallbackFormat="webp"
              />
            ) : (
              <p class="bg-gradient-to-b from-[#ffc2da] to-[#a3134f] bg-clip-text text-3xl font-black text-transparent drop-shadow-[0_0_8px_rgba(255,77,157,0.5)]">BUNNY555</p>
            )
          }
        </a>
        <p class="text-sm leading-relaxed text-[#e0a5bd]">
          BUNNY555 เว็บสล็อตลิขสิทธิ์แท้ ที่รวมซอฟต์แวร์จากผู้พัฒนาชั้นนำอย่าง Play'n GO, Red Tiger และ Blueprint Gaming ไว้ในบัญชีเดียว ขับเคลื่อนด้วยระบบออโต้ที่ ได้เงินไว ในเสี้ยววินาที รองรับทรูวอเลท
          พร้อมเข้าสู่แดชบอร์ดผ่าน Secure Transition Popup ที่เข้ารหัสทุกการเชื่อมต่อ
        </p>

        <div class="mt-2 flex flex-wrap gap-3">
          <a
            href="/line"
            class="flex items-center gap-2 rounded-full border border-[#00B900]/30 bg-[#00B900]/10 px-4 py-2 text-xs font-bold text-[#00B900] shadow-[0_0_10px_rgba(0,185,0,0.1)] transition-colors hover:bg-[#00B900] hover:text-white">
            <span aria-hidden="true" class="text-base">💬</span> LINE OFFICIAL
          </a>

          {
            BRAND_ADDRESS.lines.length > 0 && (
              <address aria-label={BRAND_ADDRESS.label} class="mt-2 rounded-xl border border-white/15 bg-black/20 p-4 text-xs leading-relaxed not-italic opacity-90">
                <p class="mb-2 flex items-center gap-2 text-[11px] font-bold tracking-wider uppercase opacity-80">
                  <span aria-hidden="true" class="text-sm">📍</span>
                  {BRAND_ADDRESS.label}
                </p>
                {BRAND_ADDRESS.lines.map((line) => (
                  <span class="block">{line}</span>
                ))}
                {BRAND_ADDRESS.email && (
                  <a href={`mailto:${BRAND_ADDRESS.email}`} class="mt-3 inline-flex items-center gap-2 font-bold underline decoration-current/40 underline-offset-4 opacity-90 transition-opacity hover:opacity-100">
                    <span aria-hidden="true" class="text-sm">✉️</span>
                    {BRAND_ADDRESS.email}
                  </a>
                )}
              </address>
            )
          }
          {/* A YOUTUBE button pointing at href="#" used to sit here. There is
              no YouTube channel to point it at, and a link that goes nowhere
              costs a visitor a tap to find that out. If a brand ever has one,
              add the button back with its real URL. */}
        </div>
      </div>

      <div class="md:col-span-6 lg:col-span-5">
        <p class="relative mb-5 inline-block text-lg font-bold tracking-wider text-[#ffdcea] uppercase">
          ลิงก์ด่วน (Quick Links)
          <span class="absolute -bottom-2 left-0 h-1 w-1/2 rounded-full bg-gradient-to-r from-[#a3134f] to-[#ffc2da] shadow-[0_0_8px_rgba(255,77,157,0.6)]"></span>
        </p>

        <div class="grid grid-cols-2 gap-x-4 gap-y-3 text-sm">
          <a href="/" class="group flex items-center text-[#e0a5bd] transition-colors hover:text-[#ffc2da]">
            <span class="mr-2 h-1.5 w-1.5 rounded-sm bg-[#ff4d9d] transition-transform group-hover:rotate-45"></span> หน้าแรก
          </a>
          <a href="/ทดลองเล่น" class="group flex items-center text-[#e0a5bd] transition-colors hover:text-[#ffc2da]">
            <span class="mr-2 h-1.5 w-1.5 rounded-sm bg-[#ff4d9d] transition-transform group-hover:rotate-45"></span> ทดลองเล่นฟรี
          </a>
          <a href="/promotion" class="group flex items-center text-[#e0a5bd] transition-colors hover:text-[#ffc2da]">
            <span class="mr-2 h-1.5 w-1.5 rounded-sm bg-[#ff4d9d] transition-transform group-hover:rotate-45"></span> โปรโมชั่นและโบนัส
          </a>
          <a href="/ทางเข้า" class="group flex items-center text-[#e0a5bd] transition-colors hover:text-[#ffc2da]">
            <span class="mr-2 h-1.5 w-1.5 rounded-sm bg-[#ff4d9d] transition-transform group-hover:rotate-45"></span> ทางเข้าล่าสุด
          </a>
          <a href="/about-us" class="group flex items-center text-[#e0a5bd] transition-colors hover:text-[#ffc2da]">
            <span class="mr-2 h-1.5 w-1.5 rounded-sm bg-[#ff4d9d] transition-transform group-hover:rotate-45"></span> เกี่ยวกับเรา
          </a>
          <a href="/contact-us" class="group flex items-center text-[#e0a5bd] transition-colors hover:text-[#ffc2da]">
            <span class="mr-2 h-1.5 w-1.5 rounded-sm bg-[#ff4d9d] transition-transform group-hover:rotate-45"></span> ติดต่อแอดมิน
          </a>
        </div>
      </div>

      <div class="md:col-span-6 lg:col-span-3">
        <p class="relative mb-5 inline-block text-lg font-bold tracking-wider text-[#ffdcea] uppercase">
          ระบบการเงิน
          <span class="absolute -bottom-2 left-0 h-1 w-1/2 rounded-full bg-gradient-to-r from-[#a3134f] to-[#ffc2da] shadow-[0_0_8px_rgba(255,77,157,0.6)]"></span>
        </p>

        <p class="mb-4 text-xs text-[#e0a5bd]">รองรับการฝาก-ถอนผ่านแอปธนาคารชั้นนำและทรูวอเลท โดยควรใช้บัญชีชื่อเดียวกับข้อมูลที่สมัครไว้</p>

        <BankStrip size={30} />

        <div class="mt-3 flex h-10 items-center justify-center rounded border border-white/5 bg-[#26050f] transition-colors hover:border-[#ff4d9d]/50" title="ตรวจบิลย้อนหลัง">
          <span class="flex items-center gap-1 text-xs font-bold text-[#e0a5bd]"><span aria-hidden="true" class="text-lg text-[#ff4d9d]">🧾</span> เก็บเลขรายการไว้ตรวจสอบได้</span>
        </div>
      </div>
    </div>

    <hr class="mb-6 border-[#ff4d9d]/25" />

    <div class="mb-6 hidden text-justify text-[10px] leading-relaxed text-[#a8788b] md:block">
      เว็บสล็อตลิขสิทธิ์แท้ เล่นง่าย ได้เงินไว บริการ 24 ชม. ปลอดภัย 100% เกมสล็อตออนไลน์ Play'n GO Red Tiger Blueprint Gaming กลไก Megaways ฟีเจอร์ตัวคูณ โบนัสแตกหนัก ฝาก-ถอนออโต้ด้วยระบบ AI
      PromptPay TrueMoney Wallet ทางเข้าเว็บหลักล่าสุด ทดลองเล่นฟรี Secure Transition Popup สมัครสมาชิกใหม่ BUNNY555
    </div>

    <div class="flex flex-col items-center justify-between gap-4 border-t border-white/5 pt-6 text-xs text-[#a8788b] md:flex-row">
      <p>&copy; {new Date().getFullYear()} <span class="font-bold tracking-wider text-[#ffc2da] uppercase">BUNNY555</span>. All Rights Reserved.</p>

      <div class="flex items-center gap-6">
        <a href="/terms/" class="transition-colors hover:text-[#ffdcea]">เงื่อนไขและข้อตกลง</a>
        <a href="/privacy/" class="transition-colors hover:text-[#ffdcea]">นโยบายความเป็นส่วนตัว</a>

        {/* An anchor, not a button with onclick. Smooth scrolling comes from
            `scroll-behavior` in global.css, which the reduced-motion block
            there already overrides — the inline handler hardcoded
            behavior:'smooth' and ignored that preference. The label is Thai
            because the rest of this footer is. */}
        <a
          href="#top"
          class="flex h-8 w-8 items-center justify-center rounded border border-white/10 bg-white/5 text-[#ffdcea] transition-all hover:border-[#ffc2da] hover:bg-[#3a0818] hover:shadow-[0_0_15px_rgba(255,77,157,0.5)]"
          aria-label="กลับขึ้นด้านบนสุดของหน้า">
          <span aria-hidden="true">↑</span>
        </a>
      </div>
    </div>
  </div>
</footer>

<style>
  footer a {
    text-decoration: none;
    color: inherit;
    transition: all 0.3s ease;
  }
  footer {
    font-family: var(--font-sans);
  }
</style>
