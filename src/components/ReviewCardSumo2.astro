---
const reviews = [
  {
    name: "สมาชิกสายหวยรัฐบาลและหวยหุ้น",
    role: "ส่งโพยประจำทุกงวด",
    stars: 5,
    tag: "ตลาดหวย",
    content: "เลือกซื้อหวยได้ทั้งหวยรัฐบาล หวยลาว หวยฮานอย หวยหุ้น และหวยยี่กี จากบัญชีเดียว ไม่ต้องสลับหลายเว็บไซต์ ดูรอบที่เปิดรับและเวลาปิดรับของแต่ละตลาดได้จากหน้าเดียว พร้อมย้อนดูโพยเก่าได้ตลอด",
    avatar: "🎟️",
  },
  {
    name: "สมาชิกที่เช็กเลขอั้นก่อนแทงทุกครั้ง",
    role: "เปรียบเทียบอัตราจ่ายรายตลาด",
    stars: 5,
    tag: "เลขอั้น และอัตราจ่าย",
    content: "หน้าตลาดหวยแสดงเลขอั้นและเลขเต็มไว้ชัดเจน ทำให้รู้ก่อนว่าเลขไหนถูกปรับลดอัตราจ่ายหรือปิดรับไปแล้ว และหน้ายืนยันโพยยังแจ้งอัตราจ่ายจริงอีกครั้งก่อนกดส่ง จึงตรวจทานได้ทันก่อนตัดสินใจ",
    avatar: "🔢",
  },
  {
    name: "สมาชิกที่เพิ่งได้รับเงินรางวัล",
    role: "ทดสอบขั้นตอนหลังประกาศผล",
    stars: 4,
    tag: "ระบบจ่ายไว และการติดต่อ",
    content: "หลังประกาศผล ระบบตรวจโพยและอัปเดตสถานะรายการให้เห็นในบัญชีผู้ใช้งาน ตรวจประวัติการถูกรางวัลย้อนหลังได้ หากติดปัญหามีช่องทาง LINE ให้ติดต่อ แต่ควรตรวจชื่อบัญชีและจำนวนเงินก่อนยืนยันเสมอ",
    avatar: "💰",
  },
];

const totalStars = reviews.reduce((sum, r) => sum + r.stars, 0);
const average = (totalStars / reviews.length).toFixed(1);
---

<section class="relative z-10 mx-auto mb-12 w-full max-w-[1400px] px-4 font-sans">
  <div class="mb-8 flex w-full flex-col items-center justify-center gap-2 text-center">
    <h2
      class="bg-gradient-to-r from-white via-amber-200 to-amber-500 bg-clip-text text-3xl leading-normal font-black tracking-widest text-transparent uppercase drop-shadow-[0_2px_10px_rgba(251,191,36,0.35)]">
      เสียงจาก <span class="text-amber-300">สมาชิก MAHORANLOTTO</span>
    </h2>
    <div class="mt-2 h-[4px] w-24 rounded-full bg-gradient-to-r from-transparent via-amber-400 to-transparent"></div>
  </div>

  <div
    class="mx-auto mb-8 flex max-w-md items-center justify-center gap-5 rounded-2xl border border-amber-500/30 bg-[#1a0409]/85 px-6 py-4 shadow-[0_10px_30px_rgba(251,191,36,0.18)] backdrop-blur-xl">
    <div class="flex flex-col items-center">
      <span class="bg-gradient-to-b from-white to-amber-500 bg-clip-text text-4xl leading-none font-black text-transparent">{average}</span>
      <span class="mt-1 text-[10px] font-bold tracking-widest text-amber-100/65 uppercase">คะแนนเฉลี่ย</span>
    </div>
    <div class="h-12 w-px bg-amber-500/25"></div>
    <div class="flex flex-col gap-1.5">
      <div class="flex gap-1 text-lg">
        {Array.from({ length: 5 }).map((_, i) => <span class={i < Math.round(Number(average)) ? "text-amber-300 drop-shadow-[0_0_6px_rgba(251,191,36,0.7)]" : "text-[#7f1d1d]"}>★</span>)}
      </div>
      <span class="text-xs font-bold text-amber-100/75">จากการใช้งานจริงของสมาชิก {reviews.length} ด้าน</span>
    </div>
  </div>

  <div class="grid grid-cols-1 gap-6 md:grid-cols-3">
    {
      reviews.map((review) => (
        <article class="group relative isolate flex flex-col gap-4 overflow-hidden rounded-2xl border border-amber-500/25 bg-[#1a0409]/85 p-6 text-left shadow-[0_10px_30px_rgba(0,0,0,0.6)] backdrop-blur-xl transition-all duration-300 hover:-translate-y-1 hover:border-amber-400/60 hover:shadow-[0_18px_40px_rgba(251,191,36,0.25)]">
          <span class="absolute inset-y-0 left-0 -z-10 w-1 bg-gradient-to-b from-amber-300 via-amber-500 to-[#7f1d1d] opacity-70 transition-opacity duration-300 group-hover:opacity-100" />
          <span class="pointer-events-none absolute -top-14 -right-14 -z-10 h-32 w-32 rounded-full bg-[#7f1d1d]/35 blur-[50px] transition-all duration-300 group-hover:bg-amber-500/20" />

          <div class="flex items-center justify-between gap-3">
            <span class="inline-flex items-center gap-1.5 rounded-full border border-amber-400/35 bg-amber-400/10 px-3 py-1 text-[10px] font-bold tracking-widest text-amber-300 uppercase">
              <span class="h-1.5 w-1.5 animate-pulse rounded-full bg-amber-400" />
              {review.tag}
            </span>
            <div class="flex gap-0.5 text-sm">
              {Array.from({ length: 5 }).map((_, i) => (
                <span class={i < review.stars ? "text-amber-300 drop-shadow-[0_0_5px_rgba(251,191,36,0.7)]" : "text-[#7f1d1d]"}>★</span>
              ))}
            </div>
          </div>

          <p class="text-left text-base leading-relaxed text-amber-50/85">{review.content}</p>

          <div class="mt-auto flex items-center gap-3 border-t border-amber-500/20 pt-4">
            <span class="flex h-11 w-11 shrink-0 items-center justify-center rounded-xl border border-amber-400/30 bg-gradient-to-br from-[#7f1d1d] to-[#0f0206] text-xl shadow-inner transition-transform duration-300 group-hover:scale-110">
              {review.avatar}
            </span>
            <span class="flex flex-col">
              <span class="text-sm font-black text-white transition-colors group-hover:text-amber-300">{review.name}</span>
              <span class="text-[10px] font-bold tracking-wider text-amber-200/65 uppercase">{review.role}</span>
            </span>
          </div>
        </article>
      ))
    }
  </div>
</section>
<style>
  .font-sans {
    font-family: "Kanit", sans-serif;
  }
</style>
