---
const reviews = [
  {
    name: "สมาชิกสายค่ายเกมชั้นนำ",
    role: "เลือกเกมจากฟีเจอร์และอัตราการจ่ายของแต่ละค่ายก่อนกดเล่น",
    stars: 5,
    tag: "Play'n GO • Red Tiger • Blueprint",
    content:
      "ชอบที่ BUNNY555 คัดสรรเฉพาะซอฟต์แวร์ที่ได้มาตรฐานระดับสากลมาไว้ที่เดียว Play'n GO เนื้อเรื่องน่าติดตามและกลไกการจ่ายหลากหลาย Red Tiger แอนิเมชันลื่นไหลจนแจ็กพอตแตกบ่อย ส่วน Blueprint Gaming กลไก Megaways ทำให้เส้นทางการจ่ายเงินมหาศาลจริง สลับค่ายได้โดยไม่ต้องย้ายเงินหรือสมัครบัญชีใหม่",
    avatar: "🧭",
  },
  {
    name: "สมาชิกที่เพิ่งเริ่มเล่น",
    role: "ใช้เมนูบนหน้าเว็บเองทั้งหมดโดยไม่ต้องถามแอดมิน",
    stars: 5,
    tag: "เล่นง่าย",
    content:
      "อินเทอร์เฟซถูกออกแบบมาเป็นสัดส่วนและเป็นมิตรกับมือใหม่จริง ลดความซับซ้อนในทุกขั้นตอนของการเดิมพัน กดเข้าค่ายเกม ตั้งวงเงิน แล้วหมุนได้เลยโดยไม่ต้องไล่หาเมนู ทำให้โฟกัสกับการกอบโกยรางวัลได้เต็มที่ตั้งแต่วันแรก",
    avatar: "🖱️",
  },
  {
    name: "สมาชิกที่ทำรายการทุกวัน",
    role: "ใช้ทั้งบนมือถือและคอมพิวเตอร์สลับกันตลอดสัปดาห์",
    stars: 4,
    tag: "ได้เงินไว • บริการ 24 ชม.",
    content:
      "ระบบประมวลผลด้วย AI ทำให้เครดิตอัปเดตเข้าบัญชีทันทีทั้งฝากและถอน ไม่ต้องรอรอบเหมือนที่อื่น ส่วนทีมซัพพอร์ตสแตนด์บายจริงตลอดเวลา ถามอะไรไปก็ตอบไวและแก้ได้ตรงจุด ข้อแนะนำเดียวคือควรอ่านเงื่อนไขของแต่ละแคมเปญให้ครบก่อนกดรับสิทธิ์",
    avatar: "⚡",
  },
];

const totalStars = reviews.reduce((sum, r) => sum + r.stars, 0);
const average = (totalStars / reviews.length).toFixed(1);
---

<section aria-label="เสียงจากสมาชิก BUNNY555" class="relative z-10 mx-auto mb-12 w-full max-w-[1400px] px-4 font-sans">
  <div class="mb-8 flex w-full flex-col items-center justify-center gap-2 text-center">
    <p class="bg-gradient-to-r from-[#ffc2da] via-[#ff4d9d] to-[#ffcf5c] bg-clip-text text-3xl font-black tracking-widest text-transparent uppercase">
      เสียงจากสมาชิก <span class="text-[#ff4d9d]">BUNNY555</span>
    </p>
    <div class="mt-2 h-[4px] w-24 rounded-full bg-gradient-to-r from-transparent via-[#ff4d9d] to-transparent"></div>
  </div>

  <div
    class="mx-auto mb-8 flex max-w-md items-center justify-center gap-5 rounded-2xl border border-[#ff4d9d]/25 bg-[#26050f]/92 px-6 py-4 shadow-[0_10px_30px_rgba(255,77,157,0.18)] backdrop-blur-xl">
    <div class="flex flex-col items-center">
      <span class="bg-gradient-to-b from-[#ffc2da] to-[#a3134f] bg-clip-text text-4xl leading-none font-black text-transparent">{average}</span>
      <span class="mt-1 text-[10px] font-bold tracking-widest text-[#e0a5bd] uppercase">คะแนนเฉลี่ย</span>
    </div>
    <div class="h-12 w-px bg-[#a3134f]"></div>
    <div class="flex flex-col gap-1.5">
      <div aria-hidden="true" class="flex gap-1 text-lg">
        {Array.from({ length: 5 }).map((_, i) => <span class={i < Math.round(Number(average)) ? "text-[#ffcf5c]" : "text-[#a3134f]"}>★</span>)}
      </div>
      <span class="text-xs font-bold text-[#e0a5bd]">คะแนนเฉลี่ย {average} จาก 5 ดาว จากการใช้งานจริงของสมาชิก {reviews.length} ด้าน</span>
    </div>
  </div>

  <div class="grid grid-cols-1 gap-6 md:grid-cols-3">
    {
      reviews.map((review) => (
        <article class="group relative isolate flex flex-col gap-4 overflow-hidden rounded-2xl border border-[#ff4d9d]/25 bg-[#26050f]/92 p-6 text-left shadow-[0_10px_30px_rgba(255,77,157,0.18)] backdrop-blur-xl transition-all duration-300 hover:-translate-y-1 hover:border-[#ff4d9d]/50 hover:shadow-[0_15px_40px_rgba(240,46,127,0.3)]">
          <span class="absolute inset-y-0 left-0 -z-10 w-1 bg-gradient-to-b from-[#ffc2da] to-[#a3134f] opacity-80 transition-opacity duration-300 group-hover:opacity-100" />
          <span class="pointer-events-none absolute -top-14 -right-14 -z-10 h-32 w-32 rounded-full bg-[#f02e7f]/22 blur-[50px] transition-all duration-300 group-hover:bg-[#ff4d9d]/30" />

          <div class="flex items-center justify-between gap-3">
            <span class="inline-flex items-center gap-1.5 rounded-full border border-[#ff4d9d]/25 bg-[#150207] px-3 py-1 text-[10px] font-bold tracking-widest text-[#ff4d9d] uppercase">
              <span class="h-1.5 w-1.5 animate-pulse rounded-full bg-[#ffc2da]" />
              {review.tag}
            </span>
            <span class="flex gap-0.5 text-sm">
              <span aria-hidden="true" class="flex gap-0.5">
                {Array.from({ length: 5 }).map((_, i) => (
                  <span class={i < review.stars ? "text-[#ffcf5c]" : "text-[#a3134f]"}>★</span>
                ))}
              </span>
              <span class="sr-only">ให้คะแนน {review.stars} จาก 5 ดาว</span>
            </span>
          </div>

          <p class="text-left text-base leading-relaxed text-[#ffdcea]">{review.content}</p>

          <div class="mt-auto flex items-center gap-3 border-t border-[#a3134f] pt-4">
            <span
              aria-hidden="true"
              class="flex h-11 w-11 shrink-0 items-center justify-center rounded-xl border border-[#ff4d9d]/30 bg-gradient-to-br from-[#ffc2da] via-[#ff4d9d] to-[#a3134f] text-xl shadow-inner transition-transform duration-300 group-hover:scale-110">
              {review.avatar}
            </span>
            <span class="flex flex-col">
              <span class="text-sm font-black text-[#ffdcea] transition-colors group-hover:text-[#ffc2da]">{review.name}</span>
              <span class="text-[10px] font-bold tracking-wider text-[#e0a5bd] uppercase">{review.role}</span>
            </span>
          </div>
        </article>
      ))
    }
  </div>
</section>
