---
const reviews = [
  {
    name: "สมาชิกฝั่งกีฬาและคาสิโนสด",
    role: "ใช้งานหมวดแทงบอลและโต๊ะไลฟ์",
    stars: 5,
    tag: "หมวดเดิมพัน",
    content: "เลือกเดิมพันได้ทั้งกีฬา คาสิโนสด สล็อต และหวยออนไลน์จากบัญชีเดียว ไม่ต้องสมัครหลายเว็บไซต์ สลับหมวดจากเมนูหลักได้ต่อเนื่อง และตรวจสอบประวัติรายการย้อนหลังได้จากหน้าสมาชิกเดียวกัน",
    avatar: "⚽",
  },
  {
    name: "สมาชิกฝั่งสล็อตและเกมยอดนิยม",
    role: "เปรียบเทียบเกมจากหลายค่าย",
    stars: 5,
    tag: "เกมยอดนิยม",
    content: "ส่วนเกมยอดนิยมรวมสล็อต บาคาร่า รูเล็ต และไฮโลไว้ พร้อมแยกหมวดค่ายเกมให้ค้นหาตามประเภทหรือผู้ให้บริการได้ง่ายขึ้น ก่อนเล่นยังตรวจสอบกติกา อัตราจ่าย และวงเงินของแต่ละเกมได้จากหน้าเกม",
    avatar: "🎰",
  },
  {
    name: "สมาชิกฝั่งฝากถอนและติดต่อทีมงาน",
    role: "ทดสอบรายการผ่านระบบออโต้",
    stars: 4,
    tag: "ฝากถอนออโต้ และการติดต่อ",
    content:
      "ระบบฝากถอนออโต้ช่วยลดขั้นตอนการแจ้งรายการกับเจ้าหน้าที่ แต่ยังควรตรวจสอบชื่อบัญชีและจำนวนเงินก่อนยืนยันทุกครั้ง หากติดปัญหามีช่องทาง Line Official และ Telegram ที่ระบุว่าดูแลตลอด 24 ชั่วโมง",
    avatar: "💳",
  },
];

const totalStars = reviews.reduce((sum, r) => sum + r.stars, 0);
const average = (totalStars / reviews.length).toFixed(1);
---

<section class="relative z-10 mx-auto mb-12 w-full max-w-[1400px] px-4 font-sans">
  <div class="mb-8 flex w-full flex-col items-center justify-center gap-2 text-center">
    <p class="bg-gradient-to-r from-white via-red-200 to-red-500 bg-clip-text text-3xl font-black tracking-widest text-transparent uppercase drop-shadow-[0_2px_10px_rgba(220,38,38,0.35)]">
      เสียงจาก <span class="text-rose-400">สมาชิก UFAYES</span>
    </p>
    <div class="mt-2 h-[4px] w-24 rounded-full bg-gradient-to-r from-transparent via-red-500 to-transparent"></div>
  </div>

  <div class="mx-auto mb-8 flex max-w-md items-center justify-center gap-5 rounded-2xl border border-red-500/30 bg-[#140202]/80 px-6 py-4 shadow-[0_10px_30px_rgba(220,38,38,0.2)] backdrop-blur-xl">
    <div class="flex flex-col items-center">
      <span class="bg-gradient-to-b from-white to-red-500 bg-clip-text text-4xl leading-none font-black text-transparent">{average}</span>
      <span class="mt-1 text-[10px] font-bold tracking-widest text-red-100/60 uppercase">คะแนนเฉลี่ย</span>
    </div>
    <div class="h-12 w-px bg-red-500/25"></div>
    <div class="flex flex-col gap-1.5">
      <div class="flex gap-1 text-lg">
        {Array.from({ length: 5 }).map((_, i) => <span class={i < Math.round(Number(average)) ? "text-red-400 drop-shadow-[0_0_6px_rgba(239,68,68,0.7)]" : "text-red-900/70"}>★</span>)}
      </div>
      <span class="text-xs font-bold text-red-100/70">จากการใช้งานจริงของสมาชิก {reviews.length} ด้าน</span>
    </div>
  </div>

  <div class="grid grid-cols-1 gap-6 md:grid-cols-3">
    {
      reviews.map((review) => (
        <article class="group relative isolate flex flex-col gap-4 overflow-hidden rounded-2xl border border-red-500/25 bg-[#140202]/80 p-6 text-left shadow-[0_10px_30px_rgba(0,0,0,0.6)] backdrop-blur-xl transition-all duration-300 hover:-translate-y-1 hover:border-red-400/50 hover:shadow-[0_18px_40px_rgba(220,38,38,0.3)]">
          <span class="absolute inset-y-0 left-0 -z-10 w-1 bg-gradient-to-b from-red-500 via-red-300 to-red-800 opacity-70 transition-opacity duration-300 group-hover:opacity-100" />
          <span class="pointer-events-none absolute -top-14 -right-14 -z-10 h-32 w-32 rounded-full bg-red-600/20 blur-[50px] transition-all duration-300 group-hover:bg-rose-500/20" />

          <div class="flex items-center justify-between gap-3">
            <span class="inline-flex items-center gap-1.5 rounded-full border border-red-400/35 bg-red-400/10 px-3 py-1 text-[10px] font-bold tracking-widest text-red-300 uppercase">
              <span class="h-1.5 w-1.5 animate-pulse rounded-full bg-red-400" />
              {review.tag}
            </span>
            <div class="flex gap-0.5 text-sm">
              {Array.from({ length: 5 }).map((_, i) => (
                <span class={i < review.stars ? "text-red-400 drop-shadow-[0_0_5px_rgba(239,68,68,0.7)]" : "text-red-900/70"}>★</span>
              ))}
            </div>
          </div>

          <p class="text-base leading-relaxed text-red-50/85">{review.content}</p>

          <div class="mt-auto flex items-center gap-3 border-t border-red-500/20 pt-4">
            <span class="flex h-11 w-11 shrink-0 items-center justify-center rounded-xl border border-red-400/30 bg-gradient-to-br from-red-700 to-[#0a0101] text-xl shadow-inner transition-transform duration-300 group-hover:scale-110">
              {review.avatar}
            </span>
            <span class="flex flex-col">
              <span class="text-sm font-black text-white transition-colors group-hover:text-red-300">{review.name}</span>
              <span class="text-[10px] font-bold tracking-wider text-red-200/60 uppercase">{review.role}</span>
            </span>
          </div>
        </article>
      ))
    }
  </div>
</section>
<style>
  .font-sans {
    font-family: "Kanit", sans-serif;
  }
</style>
