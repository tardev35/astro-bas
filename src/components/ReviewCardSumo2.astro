---
const reviews = [
  {
    name: "สมาชิกสายสล็อตหลายค่าย",
    role: "เลือกเกมจากเดิมพันขั้นต่ำและฟีเจอร์โบนัสก่อนกดเล่น",
    stars: 5,
    tag: "สล็อตหลายค่าย",
    content:
      "หมวดสล็อตมีทั้ง PG, Joker, Pragmatic และผู้ให้บริการกลุ่มอื่นรวมอยู่ในบัญชีเดียว จึงเลือกเกมได้โดยไม่ต้องสมัครแยกทีละค่าย เวลาเลือกจริงจะเริ่มจากเดิมพันขั้นต่ำ ฟีเจอร์โบนัส ความผันผวน และรูปแบบการจ่าย มากกว่าดูว่าหน้าปกเกมตัวไหนใช้ทองเยอะที่สุด",
    avatar: "🎰",
  },
  {
    name: "สมาชิกที่เล่นคาสิโนสดเป็นหลัก",
    role: "ดูค่าย วงเงินโต๊ะ และเวลาปิดรับก่อนลงเดิมพัน",
    stars: 5,
    tag: "คาสิโนสดและเกมโต๊ะ",
    content:
      "คาสิโนเหมาะกับคนที่ชอบกติกาชัดและรอบเกมแบบเรียลไทม์ อย่างบาคาร่า รูเล็ต หรือเกมโต๊ะอื่น ก่อนเลือกควรตรวจค่าย วงเงินโต๊ะ เวลาปิดรับ และยอดเดิมพันที่ระบบแสดงให้ครบ ผู้เล่นใหม่เริ่มจากโต๊ะวงเงินต่ำประมาณ 10–100 บาทแล้วค่อยปรับตามงบจริงจะปลอดภัยกว่า",
    avatar: "🎴",
  },
  {
    name: "สมาชิกที่รับโบนัสและใช้ระบบออโต้",
    role: "ตรวจเทิร์นและเพดานถอนก่อนกดรับโปรทุกครั้ง",
    stars: 4,
    tag: "โบนัส 200% และฝากถอนออโต้",
    content:
      "โบนัสสูงสุด 200% ช่วยเพิ่มเครดิตเริ่มต้นได้จริง แต่คำว่าสูงสุดแปลว่าแต่ละยอดฝากได้รับไม่เท่ากัน จึงต้องดูยอดขั้นต่ำ จำนวนเทิร์น เกมที่ร่วมรายการ และเพดานถอนก่อนรับ ส่วนระบบออโต้ทำรายการได้เองตลอด 24 ชั่วโมง ฝากราว 10–30 วินาที ถอนราว 1–3 นาที ถ้ายอดยังไม่ขยับก็ไม่ควรกดซ้ำทันที",
    avatar: "🪙",
  },
];

const totalStars = reviews.reduce((sum, r) => sum + r.stars, 0);
const average = (totalStars / reviews.length).toFixed(1);
---

<section aria-label="เสียงจากสมาชิก ตังค์มา168" class="relative z-10 mx-auto mb-12 w-full max-w-[1400px] px-4 font-sans">
  <div class="mb-8 flex w-full flex-col items-center justify-center gap-2 text-center">
    <p class="bg-gradient-to-r from-[#ffa6d2] via-[#ff3d9a] to-[#c21a70] bg-clip-text text-3xl font-black tracking-widest text-transparent uppercase">
      เสียงจากสมาชิก <span class="text-[#22d3ee]">ตังค์มา168</span>
    </p>
    <div class="mt-2 h-[4px] w-24 rounded-full bg-gradient-to-r from-transparent via-[#ff3d9a] to-transparent"></div>
  </div>

  <div class="mx-auto mb-8 flex max-w-md items-center justify-center gap-5 rounded-2xl border border-[#ff3d9a]/25 bg-[#16050f]/92 px-6 py-4 shadow-[0_10px_30px_rgba(255,61,154,0.18)] backdrop-blur-xl">
    <div class="flex flex-col items-center">
      <span class="bg-gradient-to-b from-[#ffa6d2] to-[#c21a70] bg-clip-text text-4xl leading-none font-black text-transparent">{average}</span>
      <span class="mt-1 text-[10px] font-bold tracking-widest text-[#d9a7c4] uppercase">คะแนนเฉลี่ย</span>
    </div>
    <div class="h-12 w-px bg-[#4a1b36]"></div>
    <div class="flex flex-col gap-1.5">
      <div aria-hidden="true" class="flex gap-1 text-lg">
        {Array.from({ length: 5 }).map((_, i) => <span class={i < Math.round(Number(average)) ? "text-[#ffc94d]" : "text-[#4a1b36]"}>★</span>)}
      </div>
      <span class="text-xs font-bold text-[#d9a7c4]">คะแนนเฉลี่ย {average} จาก 5 ดาว จากการใช้งานจริงของสมาชิก {reviews.length} ด้าน</span>
    </div>
  </div>

  <div class="grid grid-cols-1 gap-6 md:grid-cols-3">
    {
      reviews.map((review) => (
        <article class="group relative isolate flex flex-col gap-4 overflow-hidden rounded-2xl border border-[#ff3d9a]/25 bg-[#16050f]/92 p-6 text-left shadow-[0_10px_30px_rgba(255,61,154,0.18)] backdrop-blur-xl transition-all duration-300 hover:-translate-y-1 hover:border-[#ff3d9a]/50 hover:shadow-[0_15px_40px_rgba(255,61,154,0.3)]">
          <span class="absolute inset-y-0 left-0 -z-10 w-1 bg-gradient-to-b from-[#ffa6d2] to-[#c21a70] opacity-80 transition-opacity duration-300 group-hover:opacity-100" />
          <span class="pointer-events-none absolute -top-14 -right-14 -z-10 h-32 w-32 rounded-full bg-[#4a8f9c]/40 blur-[50px] transition-all duration-300 group-hover:bg-[#22d3ee]/35" />

          <div class="flex items-center justify-between gap-3">
            <span class="inline-flex items-center gap-1.5 rounded-full border border-[#ff3d9a]/25 bg-[#230a19] px-3 py-1 text-[10px] font-bold tracking-widest text-[#ff3d9a] uppercase">
              <span class="h-1.5 w-1.5 animate-pulse rounded-full bg-[#ff3d9a]" />
              {review.tag}
            </span>
            <span class="flex gap-0.5 text-sm">
              <span aria-hidden="true" class="flex gap-0.5">
                {Array.from({ length: 5 }).map((_, i) => (
                  <span class={i < review.stars ? "text-[#ffc94d]" : "text-[#4a1b36]"}>★</span>
                ))}
              </span>
              <span class="sr-only">ให้คะแนน {review.stars} จาก 5 ดาว</span>
            </span>
          </div>

          <p class="text-left text-base leading-relaxed text-[#fdeaf4]">{review.content}</p>

          <div class="mt-auto flex items-center gap-3 border-t border-[#4a1b36] pt-4">
            <span aria-hidden="true" class="flex h-11 w-11 shrink-0 items-center justify-center rounded-xl border border-[#ff3d9a]/30 bg-gradient-to-br from-[#ffa6d2] via-[#ff3d9a] to-[#c21a70] text-xl shadow-inner transition-transform duration-300 group-hover:scale-110">
              {review.avatar}
            </span>
            <span class="flex flex-col">
              <span class="text-sm font-black text-[#fdeaf4] transition-colors group-hover:text-[#ffa6d2]">{review.name}</span>
              <span class="text-[10px] font-bold tracking-wider text-[#d9a7c4] uppercase">{review.role}</span>
            </span>
          </div>
        </article>
      ))
    }
  </div>
</section>
