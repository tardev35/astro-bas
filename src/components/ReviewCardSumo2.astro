---
const reviews = [
  {
    name: "สมาชิกสายค่ายเกมลิขสิทธิ์แท้",
    role: "เลือกเกมจากฟีเจอร์และอัตราการจ่ายของแต่ละค่ายก่อนกดเล่น",
    stars: 5,
    tag: "AvatarUX • Spinomenal • Relax Gaming",
    content:
      "ชอบที่ GARUDA369 รวบรวมซอฟต์แวร์คุณภาพจากค่ายดังทั่วโลกมาไว้ในที่เดียว AvatarUX ขยายกระดานทุกครั้งที่ชนะจนรางวัลทวีคูณต่อเนื่อง Spinomenal ภาพแอนิเมชันตระการตาและเข้าถึงรอบแจ็กพอตได้ไว ส่วน Relax Gaming โหลดไวและตอบสนองฉับไวบนทุกอุปกรณ์ สลับค่ายได้โดยไม่ต้องย้ายเงินหรือสมัครบัญชีใหม่",
    avatar: "🪶",
  },
  {
    name: "สมาชิกที่ทำรายการทุกวัน",
    role: "ใช้ทั้งบนมือถือและคอมพิวเตอร์สลับกันตลอดสัปดาห์",
    stars: 5,
    tag: "ระบบออโต้",
    content:
      "จัดการยอดฝากและถอนได้เองผ่านระบบ AI อัจฉริยะ การประมวลผลเครดิตเสร็จสิ้นภายในเสี้ยววินาที ไม่ต้องรอรอบและไม่ต้องแจ้งสลิปให้เสียเวลา ลดขั้นตอนที่ยุ่งยากไปได้เกือบทั้งหมด ทำรายการวันละหลายครั้งก็ยังมีสภาพคล่องเดินหน้าทำกำไรต่อได้",
    avatar: "⚡",
  },
  {
    name: "สมาชิกที่บริหารทุนเอง",
    role: "ตั้งงบต่อวันแล้วเติมทีละน้อยตามจังหวะของตัวเอง",
    stars: 4,
    tag: "โปรจัดเต็ม • ปลอดภัย 100%",
    content:
      "เลือกรับแคมเปญเสริมได้ด้วยตนเองผ่านเมนูอัตโนมัติ ไม่ต้องรอแอดมินอนุมัติ ช่วยเพิ่มขีดความสามารถในการเดิมพันและลดความเสี่ยงได้จริง ส่วนการเข้าสู่ระบบผ่าน Secure Popup ทำให้ทุกการเชื่อมต่อเป็นส่วนตัว ข้อแนะนำเดียวคือควรอ่านเงื่อนไขของแต่ละแคมเปญให้ครบก่อนกดรับสิทธิ์",
    avatar: "🎁",
  },
];

const totalStars = reviews.reduce((sum, r) => sum + r.stars, 0);
const average = (totalStars / reviews.length).toFixed(1);
---

<section aria-label="เสียงจากสมาชิก GARUDA369" class="relative z-10 mx-auto mb-12 w-full max-w-[1400px] px-4 font-sans">
  <div class="mb-8 flex w-full flex-col items-center justify-center gap-2 text-center">
    <p class="bg-gradient-to-r from-[#a8e81c] via-[#7bbb0b] to-[#f5c518] bg-clip-text text-3xl font-black tracking-widest text-transparent uppercase">
      เสียงจากสมาชิก <span class="text-[#a8e81c]">GARUDA369</span>
    </p>
    <div class="mt-2 h-[4px] w-24 rounded-full bg-gradient-to-r from-transparent via-[#7bbb0b] to-transparent"></div>
  </div>

  <div
    class="mx-auto mb-8 flex max-w-md items-center justify-center gap-5 rounded-2xl border border-[#7bbb0b]/25 bg-[#0a1c04]/92 px-6 py-4 shadow-[0_10px_30px_rgba(123,187,11,0.18)] backdrop-blur-xl">
    <div class="flex flex-col items-center">
      <span class="bg-gradient-to-b from-[#a8e81c] to-[#3c6b07] bg-clip-text text-4xl leading-none font-black text-transparent">{average}</span>
      <span class="mt-1 text-[10px] font-bold tracking-widest text-[#a3c974] uppercase">คะแนนเฉลี่ย</span>
    </div>
    <div class="h-12 w-px bg-[#3c6b07]"></div>
    <div class="flex flex-col gap-1.5">
      <div aria-hidden="true" class="flex gap-1 text-lg">
        {Array.from({ length: 5 }).map((_, i) => <span class={i < Math.round(Number(average)) ? "text-[#f5c518]" : "text-[#3c6b07]"}>★</span>)}
      </div>
      <span class="text-xs font-bold text-[#a3c974]">คะแนนเฉลี่ย {average} จาก 5 ดาว จากการใช้งานจริงของสมาชิก {reviews.length} ด้าน</span>
    </div>
  </div>

  <div class="grid grid-cols-1 gap-6 md:grid-cols-3">
    {
      reviews.map((review) => (
        <article class="group relative isolate flex flex-col gap-4 overflow-hidden rounded-2xl border border-[#7bbb0b]/25 bg-[#0a1c04]/92 p-6 text-left shadow-[0_10px_30px_rgba(123,187,11,0.18)] backdrop-blur-xl transition-all duration-300 hover:-translate-y-1 hover:border-[#7bbb0b]/50 hover:shadow-[0_15px_40px_rgba(99,163,12,0.3)]">
          <span class="absolute inset-y-0 left-0 -z-10 w-1 bg-gradient-to-b from-[#a8e81c] to-[#3c6b07] opacity-80 transition-opacity duration-300 group-hover:opacity-100" />
          <span class="pointer-events-none absolute -top-14 -right-14 -z-10 h-32 w-32 rounded-full bg-[#63a30c]/22 blur-[50px] transition-all duration-300 group-hover:bg-[#7bbb0b]/30" />

          <div class="flex items-center justify-between gap-3">
            <span class="inline-flex items-center gap-1.5 rounded-full border border-[#7bbb0b]/25 bg-[#061405] px-3 py-1 text-[10px] font-bold tracking-widest text-[#7bbb0b] uppercase">
              <span class="h-1.5 w-1.5 animate-pulse rounded-full bg-[#a8e81c]" />
              {review.tag}
            </span>
            <span class="flex gap-0.5 text-sm">
              <span aria-hidden="true" class="flex gap-0.5">
                {Array.from({ length: 5 }).map((_, i) => (
                  <span class={i < review.stars ? "text-[#f5c518]" : "text-[#3c6b07]"}>★</span>
                ))}
              </span>
              <span class="sr-only">ให้คะแนน {review.stars} จาก 5 ดาว</span>
            </span>
          </div>

          <p class="text-left text-base leading-relaxed text-[#dcefc2]">{review.content}</p>

          <div class="mt-auto flex items-center gap-3 border-t border-[#3c6b07] pt-4">
            <span
              aria-hidden="true"
              class="flex h-11 w-11 shrink-0 items-center justify-center rounded-xl border border-[#7bbb0b]/30 bg-gradient-to-br from-[#a8e81c] via-[#7bbb0b] to-[#3c6b07] text-xl shadow-inner transition-transform duration-300 group-hover:scale-110">
              {review.avatar}
            </span>
            <span class="flex flex-col">
              <span class="text-sm font-black text-[#dcefc2] transition-colors group-hover:text-[#a8e81c]">{review.name}</span>
              <span class="text-[10px] font-bold tracking-wider text-[#a3c974] uppercase">{review.role}</span>
            </span>
          </div>
        </article>
      ))
    }
  </div>
</section>
