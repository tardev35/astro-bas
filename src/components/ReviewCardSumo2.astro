---
const reviews = [
  {
    name: "สมาชิกสายเลือกค่ายเกม",
    role: "ดูฟีเจอร์และกลไกของแต่ละค่ายก่อนกดเล่นทุกครั้ง",
    stars: 5,
    tag: "Microgaming • NetEnt • Novomatic",
    content:
      "ชอบที่ ROMAN555 รวบรวมซอฟต์แวร์เกมมาตรฐานสากลมาไว้ในที่เดียว Microgaming เสถียรจริงและเครือข่ายแจ็กพอตใหญ่มาก NetEnt แอนิเมชันระดับพรีเมียมลุ้นรอบโบนัสได้ต่อเนื่อง ส่วน Novomatic เกมเพลย์คลาสสิกแต่อัตราคูณสูงและโหลดไว สลับค่ายได้โดยไม่ต้องย้ายเงินหรือสมัครบัญชีใหม่",
    avatar: "🎰",
  },
  {
    name: "สมาชิกที่ทำรายการทุกวัน",
    role: "ใช้ทั้งบนมือถือและคอมพิวเตอร์สลับกันตลอดสัปดาห์",
    stars: 5,
    tag: "รองรับทรูวอเลท",
    content:
      "ผูกกระเป๋าเงินดิจิทัลไว้ตรงๆ ฝากถอนได้อิสระโดยไม่ต้องพึ่งบัญชีธนาคารแบบเดิม ยอดเครดิตอัปเดตไวในเสี้ยววินาทีจริงตามที่บอกไว้ ทำให้จังหวะเข้าออกเกมไม่สะดุดและบริหารสภาพคล่องได้เต็มที่",
    avatar: "👛",
  },
  {
    name: "สมาชิกที่บริหารทุนเอง",
    role: "ตั้งงบต่อวันแล้วเติมทีละน้อยตามจังหวะของตัวเอง",
    stars: 4,
    tag: "ทางเข้าหลักเว็บตรง • Secure Popup",
    content:
      "เข้าใช้งานผ่านเซิร์ฟเวอร์ที่มั่นคงและไม่ผ่านตัวแทนใดๆ ข้อมูลส่วนบุคคลกับยอดเครดิตถูกปกป้องด้วยระบบเข้ารหัสขั้นสูง ทุกครั้งที่เข้าสู่ระบบมี Secure Transition Popup ป้องกันการรีเฟรชหน้าเว็บซ้ำซ้อนให้อีกชั้น ข้อแนะนำเดียวคือควรอ่านเงื่อนไขของแต่ละแคมเปญให้ครบก่อนกดรับสิทธิ์",
    avatar: "🔒",
  },
];

const totalStars = reviews.reduce((sum, r) => sum + r.stars, 0);
const average = (totalStars / reviews.length).toFixed(1);
---

<section aria-label="เสียงจากสมาชิก ROMAN555" class="relative z-10 mx-auto mb-12 w-full max-w-[1400px] px-4 font-sans">
  <div class="mb-8 flex w-full flex-col items-center justify-center gap-2 text-center">
    <p class="bg-gradient-to-r from-[#fff6e0] via-[#fbeab0] to-[#d99a1c] bg-clip-text text-3xl font-black tracking-widest text-transparent uppercase">
      เสียงจากสมาชิก <span class="text-[#fbeab0]">ROMAN555</span>
    </p>
    <div class="mt-2 h-[4px] w-24 rounded-full bg-gradient-to-r from-transparent via-[#d99a1c] to-transparent"></div>
  </div>

  <div
    class="mx-auto mb-8 flex max-w-md items-center justify-center gap-5 rounded-2xl border border-[#d99a1c]/25 bg-[#1a0f04]/92 px-6 py-4 shadow-[0_10px_30px_rgba(217,154,28,0.18)] backdrop-blur-xl">
    <div class="flex flex-col items-center">
      <span class="bg-gradient-to-b from-[#fbeab0] to-[#7a4405] bg-clip-text text-4xl leading-none font-black text-transparent">{average}</span>
      <span class="mt-1 text-[10px] font-bold tracking-widest text-[#e8c9a0] uppercase">คะแนนเฉลี่ย</span>
    </div>
    <div class="h-12 w-px bg-[#4a2503]"></div>
    <div class="flex flex-col gap-1.5">
      <div aria-hidden="true" class="flex gap-1 text-lg">
        {Array.from({ length: 5 }).map((_, i) => <span class={i < Math.round(Number(average)) ? "text-[#d99a1c]" : "text-[#4a2503]"}>★</span>)}
      </div>
      <span class="text-xs font-bold text-[#e8c9a0]">คะแนนเฉลี่ย {average} จาก 5 ดาว จากการใช้งานจริงของสมาชิก {reviews.length} ด้าน</span>
    </div>
  </div>

  <div class="grid grid-cols-1 gap-6 md:grid-cols-3">
    {
      reviews.map((review) => (
        <article class="group relative isolate flex flex-col gap-4 overflow-hidden rounded-2xl border border-[#d99a1c]/25 bg-[#1a0f04]/92 p-6 text-left shadow-[0_10px_30px_rgba(217,154,28,0.18)] backdrop-blur-xl transition-all duration-300 hover:-translate-y-1 hover:border-[#d99a1c]/50 hover:shadow-[0_15px_40px_rgba(168,105,10,0.3)]">
          <span class="absolute inset-y-0 left-0 -z-10 w-1 bg-gradient-to-b from-[#fbeab0] to-[#7a4405] opacity-80 transition-opacity duration-300 group-hover:opacity-100" />
          <span class="pointer-events-none absolute -top-14 -right-14 -z-10 h-32 w-32 rounded-full bg-[#a8690a]/22 blur-[50px] transition-all duration-300 group-hover:bg-[#d99a1c]/30" />

          <div class="flex items-center justify-between gap-3">
            <span class="inline-flex items-center gap-1.5 rounded-full border border-[#d99a1c]/25 bg-[#120a02] px-3 py-1 text-[10px] font-bold tracking-widest text-[#f6cf6a] uppercase">
              <span aria-hidden="true" class="h-1.5 w-1.5 animate-pulse rounded-full bg-[#fbeab0]" />
              {review.tag}
            </span>
            <span class="flex gap-0.5 text-sm">
              <span aria-hidden="true" class="flex gap-0.5">
                {Array.from({ length: 5 }).map((_, i) => (
                  <span class={i < review.stars ? "text-[#d99a1c]" : "text-[#4a2503]"}>★</span>
                ))}
              </span>
              <span class="sr-only">ให้คะแนน {review.stars} จาก 5 ดาว</span>
            </span>
          </div>

          <p class="text-left text-base leading-relaxed text-[#f2e4c4]">{review.content}</p>

          <div class="mt-auto flex items-center gap-3 border-t border-[#4a2503] pt-4">
            <span
              aria-hidden="true"
              class="flex h-11 w-11 shrink-0 items-center justify-center rounded-xl border border-[#d99a1c]/30 bg-gradient-to-br from-[#fbeab0] via-[#d99a1c] to-[#7a4405] text-xl shadow-inner transition-transform duration-300 group-hover:scale-110">
              {review.avatar}
            </span>
            <span class="flex flex-col">
              <span class="text-sm font-black text-[#f2e4c4] transition-colors group-hover:text-[#fbeab0]">{review.name}</span>
              <span class="text-[10px] font-bold tracking-wider text-[#e8c9a0] uppercase">{review.role}</span>
            </span>
          </div>
        </article>
      ))
    }
  </div>
</section>
