---
const reviews = [
  {
    name: "ทีมทดสอบ ฝั่งประสิทธิภาพ",
    role: "วัดความเร็วผ่าน Google Chrome",
    stars: 5,
    tag: "ความเร็วเว็บไซต์",
    content:
      "ทดสอบต่อเนื่อง 72 ชั่วโมง วัดความเร็วในการโหลดหน้าเว็บไซต์เฉลี่ยประมาณ 2.2 วินาที ทั้งบน Wi-Fi และเครือข่ายมือถือ การค้นหาเกมและการสลับหน้าทำได้ค่อนข้างต่อเนื่อง ไม่พบปัญหาการแสดงผลที่ผิดปกติในการทดสอบ",
    avatar: "⚡",
  },
  {
    name: "ทีมทดสอบ ฝั่งอุปกรณ์",
    role: "Windows, Android, iPhone และ Samsung Galaxy A17",
    stars: 5,
    tag: "การรองรับอุปกรณ์",
    content:
      "แบ่งการทดลองใช้งานบน Windows, Android และ iPhone พร้อมทดสอบเพิ่มบน Samsung Galaxy A17 ซึ่งเป็นสมาร์ตโฟนระดับเริ่มต้น พบว่าเข้าสู่ระบบ เปิดหน้าเกม และสลับหมวดหมู่ได้ตามปกติ แม้ใช้อุปกรณ์ที่ไม่ได้มีประสิทธิภาพสูง",
    avatar: "📱",
  },
  {
    name: "ทีมตรวจสอบ ฝั่งระบบสมาชิก",
    role: "ตรวจธุรกรรมอัตโนมัติและการเชื่อมต่อ",
    stars: 4,
    tag: "ฝากถอน และความปลอดภัย",
    content:
      "ระบบสมาชิกรองรับธุรกรรมผ่านบัญชีธนาคาร Wallet และ P2P ภายในระบบเดียว ขั้นตอนสมัคร ฝาก และถอนดำเนินการผ่านระบบอัตโนมัติ ลดการติดต่อเจ้าหน้าที่ในกรณีทั่วไป การเข้าใช้งานเป็นแบบ HTTPS พร้อมระบบ SSL เข้ารหัสข้อมูล",
    avatar: "🔒",
  },
];

const totalStars = reviews.reduce((sum, r) => sum + r.stars, 0);
const average = (totalStars / reviews.length).toFixed(1);
---

<section class="relative z-10 mx-auto mb-12 w-full max-w-[1400px] px-4 font-sans">
  <div class="mb-8 flex w-full flex-col items-center justify-center gap-2 text-center">
    <p
      class="bg-gradient-to-r from-amber-200 via-amber-400 to-amber-600 bg-clip-text text-3xl font-black tracking-widest text-transparent uppercase drop-shadow-[0_2px_10px_rgba(234,179,8,0.35)]">
      ผลการทดสอบจาก <span class="text-orange-400">ทีมงาน GSYBET</span>
    </p>
    <div class="mt-2 h-[4px] w-24 rounded-full bg-gradient-to-r from-transparent via-amber-500 to-transparent"></div>
  </div>

  <div
    class="mx-auto mb-8 flex max-w-md items-center justify-center gap-5 rounded-2xl border border-amber-500/30 bg-[#1a1204]/80 px-6 py-4 shadow-[0_10px_30px_rgba(234,179,8,0.2)] backdrop-blur-xl">
    <div class="flex flex-col items-center">
      <span class="bg-gradient-to-b from-amber-200 to-amber-500 bg-clip-text text-4xl leading-none font-black text-transparent">{average}</span>
      <span class="mt-1 text-[10px] font-bold tracking-widest text-amber-100/60 uppercase">คะแนนเฉลี่ย</span>
    </div>
    <div class="h-12 w-px bg-amber-500/25"></div>
    <div class="flex flex-col gap-1.5">
      <div class="flex gap-1 text-lg">
        {
          Array.from({ length: 5 }).map((_, i) => (
            <span class={i < Math.round(Number(average)) ? "text-amber-400 drop-shadow-[0_0_6px_rgba(245,158,11,0.7)]" : "text-amber-900/70"}>★</span>
          ))
        }
      </div>
      <span class="text-xs font-bold text-amber-100/70">จากการทดลองใช้งานจริง 72 ชั่วโมง {reviews.length} ด้าน</span>
    </div>
  </div>

  <div class="grid grid-cols-1 gap-6 md:grid-cols-3">
    {
      reviews.map((review) => (
        <article class="group relative isolate flex flex-col gap-4 overflow-hidden rounded-2xl border border-amber-500/25 bg-[#1a1204]/80 p-6 text-left shadow-[0_10px_30px_rgba(0,0,0,0.6)] backdrop-blur-xl transition-all duration-300 hover:-translate-y-1 hover:border-amber-400/50 hover:shadow-[0_18px_40px_rgba(234,179,8,0.3)]">
          <span class="absolute inset-y-0 left-0 -z-10 w-1 bg-gradient-to-b from-amber-500 via-yellow-300 to-amber-700 opacity-70 transition-opacity duration-300 group-hover:opacity-100" />
          <span class="pointer-events-none absolute -top-14 -right-14 -z-10 h-32 w-32 rounded-full bg-amber-600/20 blur-[50px] transition-all duration-300 group-hover:bg-orange-500/20" />

          <div class="flex items-center justify-between gap-3">
            <span class="inline-flex items-center gap-1.5 rounded-full border border-amber-400/35 bg-amber-400/10 px-3 py-1 text-[10px] font-bold tracking-widest text-amber-300 uppercase">
              <span class="h-1.5 w-1.5 animate-pulse rounded-full bg-amber-400" />
              {review.tag}
            </span>
            <div class="flex gap-0.5 text-sm">
              {Array.from({ length: 5 }).map((_, i) => (
                <span class={i < review.stars ? "text-amber-400 drop-shadow-[0_0_5px_rgba(245,158,11,0.7)]" : "text-amber-900/70"}>★</span>
              ))}
            </div>
          </div>

          <p class="text-base leading-relaxed text-amber-50/85">{review.content}</p>

          <div class="mt-auto flex items-center gap-3 border-t border-amber-500/20 pt-4">
            <span class="flex h-11 w-11 shrink-0 items-center justify-center rounded-xl border border-amber-400/30 bg-gradient-to-br from-amber-700 to-[#0a0703] text-xl shadow-inner transition-transform duration-300 group-hover:scale-110">
              {review.avatar}
            </span>
            <span class="flex flex-col">
              <span class="text-sm font-black text-white transition-colors group-hover:text-amber-300">{review.name}</span>
              <span class="text-[10px] font-bold tracking-wider text-amber-200/60 uppercase">{review.role}</span>
            </span>
          </div>
        </article>
      ))
    }
  </div>
</section>
<style>
  .font-sans {
    font-family: "Kanit", sans-serif;
  }
</style>
