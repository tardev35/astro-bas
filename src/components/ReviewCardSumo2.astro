---
const reviews = [
  {
    name: "สมาชิกสายค่ายเกมลิขสิทธิ์แท้",
    role: "เลือกเกมจากฟีเจอร์และอัตราการจ่ายของแต่ละค่ายก่อนกดเล่น",
    stars: 5,
    tag: "PG Soft • Pragmatic Play • JILI",
    content:
      "ชอบที่ TUNJAI123 เชื่อมต่อ API ลิขสิทธิ์แท้ไว้ในที่เดียวจบ PG Soft กราฟิก 3D คมชัดและเข้าถึงรอบโบนัสได้ไว Pragmatic Play ตอบสนองฉับไวและจ่ายก้อนโต ส่วน JILI ตัวเกมเบาจนเล่นบนมือถือได้ลื่นทั้งวัน สลับค่ายได้โดยไม่ต้องย้ายเงินหรือสมัครบัญชีใหม่",
    avatar: "🐉",
  },
  {
    name: "สมาชิกที่ใช้ระบบออโต้เป็นประจำ",
    role: "ทำธุรกรรมเองผ่านแดชบอร์ด ไม่ต้องส่งสลิปให้ใครตรวจ",
    stars: 5,
    tag: "รวดเร็วดั่งใจนึก โอนไว",
    content:
      "จุดที่ต่างจากที่อื่นคือความไวระดับเสี้ยววินาที กดฝากแล้วระบบ AI ตรวจสอบและปรับยอดเครดิตให้เองทันที ไม่ต้องส่งสลิปหรือรอเจ้าหน้าที่ยืนยันทีละราย ถอนออกก็เข้าบัญชีตรงตามจำนวนทุกครั้ง ทำให้บริหารทุนได้คล่องตัวจริงตามที่เว็บบอกไว้",
    avatar: "🤖",
  },
  {
    name: "สมาชิกที่กดรับสิทธิพิเศษเป็นประจำ",
    role: "อ่านเงื่อนไขแคมเปญจากหน้าแดชบอร์ดก่อนกดยอมรับ",
    stars: 4,
    tag: "การันตี จ่ายจริง ไม่มีกั๊ก",
    content:
      "ทำกำไรได้ยอดใหญ่แล้วระบบก็โอนให้ครบเต็มจำนวน ไม่มีการหักค่าธรรมเนียมหรือเปอร์เซ็นต์แอบแฝงอย่างที่ประกาศไว้ สิทธิพิเศษอย่างฝากแรกลุ้นรับทอง 1 บาท และคืนยอดเสีย 15% กดรับเองได้จากแดชบอร์ด ข้อแนะนำเดียวคือควรอ่านเงื่อนไขของแต่ละแคมเปญก่อนกดยอมรับ",
    avatar: "🎁",
  },
];

const totalStars = reviews.reduce((sum, r) => sum + r.stars, 0);
const average = (totalStars / reviews.length).toFixed(1);
---

<section aria-label="เสียงจากสมาชิก TUNJAI123" class="relative z-10 mx-auto mb-12 w-full max-w-[1400px] px-4 font-sans">
  <div class="mb-8 flex w-full flex-col items-center justify-center gap-2 text-center">
    <p class="bg-gradient-to-r from-[#f5eb8b] via-[#dab563] to-[#dfe4e7] bg-clip-text text-3xl font-black tracking-widest text-transparent uppercase">
      เสียงจากสมาชิก <span class="text-[#dfe4e7]">TUNJAI123</span>
    </p>
    <div class="mt-2 h-[4px] w-24 rounded-full bg-gradient-to-r from-transparent via-[#dab563] to-transparent"></div>
  </div>

  <div class="mx-auto mb-8 flex max-w-md items-center justify-center gap-5 rounded-2xl border border-[#dab563]/25 bg-[#100d08]/92 px-6 py-4 shadow-[0_10px_30px_rgba(218,181,99,0.18)] backdrop-blur-xl">
    <div class="flex flex-col items-center">
      <span class="bg-gradient-to-b from-[#f5eb8b] to-[#a97f28] bg-clip-text text-4xl leading-none font-black text-transparent">{average}</span>
      <span class="mt-1 text-[10px] font-bold tracking-widest text-[#b5bbbc] uppercase">คะแนนเฉลี่ย</span>
    </div>
    <div class="h-12 w-px bg-[#3a2f1e]"></div>
    <div class="flex flex-col gap-1.5">
      <div aria-hidden="true" class="flex gap-1 text-lg">
        {Array.from({ length: 5 }).map((_, i) => <span class={i < Math.round(Number(average)) ? "text-[#f5eb8b]" : "text-[#3a2f1e]"}>★</span>)}
      </div>
      <span class="text-xs font-bold text-[#b5bbbc]">คะแนนเฉลี่ย {average} จาก 5 ดาว จากการใช้งานจริงของสมาชิก {reviews.length} ด้าน</span>
    </div>
  </div>

  <div class="grid grid-cols-1 gap-6 md:grid-cols-3">
    {
      reviews.map((review) => (
        <article class="group relative isolate flex flex-col gap-4 overflow-hidden rounded-2xl border border-[#dab563]/25 bg-[#100d08]/92 p-6 text-left shadow-[0_10px_30px_rgba(218,181,99,0.18)] backdrop-blur-xl transition-all duration-300 hover:-translate-y-1 hover:border-[#dab563]/50 hover:shadow-[0_15px_40px_rgba(218,181,99,0.3)]">
          <span class="absolute inset-y-0 left-0 -z-10 w-1 bg-gradient-to-b from-[#f5eb8b] to-[#a97f28] opacity-80 transition-opacity duration-300 group-hover:opacity-100" />
          <span class="pointer-events-none absolute -top-14 -right-14 -z-10 h-32 w-32 rounded-full bg-[#b5bbbc]/20 blur-[50px] transition-all duration-300 group-hover:bg-[#dfe4e7]/25" />

          <div class="flex items-center justify-between gap-3">
            <span class="inline-flex items-center gap-1.5 rounded-full border border-[#dab563]/25 bg-[#050403] px-3 py-1 text-[10px] font-bold tracking-widest text-[#dab563] uppercase">
              <span class="h-1.5 w-1.5 animate-pulse rounded-full bg-[#dfe4e7]" />
              {review.tag}
            </span>
            <span class="flex gap-0.5 text-sm">
              <span aria-hidden="true" class="flex gap-0.5">
                {Array.from({ length: 5 }).map((_, i) => (
                  <span class={i < review.stars ? "text-[#f5eb8b]" : "text-[#3a2f1e]"}>★</span>
                ))}
              </span>
              <span class="sr-only">ให้คะแนน {review.stars} จาก 5 ดาว</span>
            </span>
          </div>

          <p class="text-left text-base leading-relaxed text-[#ece3cf]">{review.content}</p>

          <div class="mt-auto flex items-center gap-3 border-t border-[#3a2f1e] pt-4">
            <span aria-hidden="true" class="flex h-11 w-11 shrink-0 items-center justify-center rounded-xl border border-[#dab563]/30 bg-gradient-to-br from-[#f5eb8b] via-[#dab563] to-[#a97f28] text-xl shadow-inner transition-transform duration-300 group-hover:scale-110">
              {review.avatar}
            </span>
            <span class="flex flex-col">
              <span class="text-sm font-black text-[#ece3cf] transition-colors group-hover:text-[#f5eb8b]">{review.name}</span>
              <span class="text-[10px] font-bold tracking-wider text-[#b5bbbc] uppercase">{review.role}</span>
            </span>
          </div>
        </article>
      ))
    }
  </div>
</section>
