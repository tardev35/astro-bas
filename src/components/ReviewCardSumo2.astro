---
const reviews = [
  {
    name: "สมาชิกสายค่ายเกมระดับโลก",
    role: "เลือกเกมจากฟีเจอร์และอัตราการจ่ายของแต่ละค่ายก่อนกดเล่น",
    stars: 5,
    tag: "PG Soft • Pragmatic Play • JILI",
    content:
      "ชอบที่ DEVA555 คัดสรรซอฟต์แวร์เกมชั้นนำจากทั่วทุกมุมโลกมาไว้ที่เดียว PG Soft ให้ 3D แอนิเมชันที่สวยงามและเข้าถึงรอบโบนัสได้ไว Pragmatic Play กลไกออกรางวัลโปร่งใสและหนักหน่วง ส่วน JILI ตัวเกมเบาจนเล่นบนมือถือได้ลื่นทั้งวัน สลับค่ายได้โดยไม่ต้องย้ายเงินหรือสมัครบัญชีใหม่",
    avatar: "🐉",
  },
  {
    name: "สมาชิกที่ใช้ระบบออโต้เป็นประจำ",
    role: "ทำธุรกรรมเองผ่านแดชบอร์ด ไม่ต้องส่งสลิปให้ใครตรวจ",
    stars: 5,
    tag: "ฝากถอนออโต้ไว 3 วิ",
    content:
      "จุดที่ต่างจากที่อื่นคือสถาปัตยกรรมทางการเงินที่ทำงานด้วย AI อัจฉริยะ กดฝากแล้วยอดเครดิตอัปเดตเข้ากระเป๋าภายในไม่กี่วินาที ไม่ต้องส่งสลิปหรือรอเจ้าหน้าที่ยืนยันทีละราย ถอนออกก็เข้าบัญชีตรงตามจำนวนทุกครั้ง ทำให้เดินหน้าคว้าโอกาสได้ต่อเนื่องไม่มีสะดุด",
    avatar: "🤖",
  },
  {
    name: "สมาชิกที่ผูกกระเป๋าเงินดิจิทัล",
    role: "อ่านเงื่อนไขแคมเปญจากหน้าแดชบอร์ดก่อนกดยอมรับ",
    stars: 4,
    tag: "รองรับทรูวอเลท ปลอดภัย 100%",
    content:
      "เชื่อมกระเป๋าเงินดิจิทัลแล้วโอนถ่ายเครดิตได้ทุกที่ทุกเวลา ทำธุรกรรมได้เต็มยอดโดยไม่มีการหักค่าธรรมเนียมอย่างที่ประกาศไว้ การเข้าสู่ระบบยังผ่าน Premium Secure Popup ที่ไม่ทำให้หน้าเว็บโหลดซ้ำ ข้อแนะนำเดียวคือควรอ่านเงื่อนไขของแต่ละแคมเปญก่อนกดยอมรับ",
    avatar: "👛",
  },
];

const totalStars = reviews.reduce((sum, r) => sum + r.stars, 0);
const average = (totalStars / reviews.length).toFixed(1);
---

<section aria-label="เสียงจากสมาชิก DEVA555" class="relative z-10 mx-auto mb-12 w-full max-w-[1400px] px-4 font-sans">
  <div class="mb-8 flex w-full flex-col items-center justify-center gap-2 text-center">
    <p class="bg-gradient-to-r from-[#fded9a] via-[#dfb85f] to-[#dfe4e7] bg-clip-text text-3xl font-black tracking-widest text-transparent uppercase">
      เสียงจากสมาชิก <span class="text-[#dfe4e7]">DEVA555</span>
    </p>
    <div class="mt-2 h-[4px] w-24 rounded-full bg-gradient-to-r from-transparent via-[#dfb85f] to-transparent"></div>
  </div>

  <div
    class="mx-auto mb-8 flex max-w-md items-center justify-center gap-5 rounded-2xl border border-[#dfb85f]/25 bg-[#140d04]/92 px-6 py-4 shadow-[0_10px_30px_rgba(223,184,95,0.18)] backdrop-blur-xl">
    <div class="flex flex-col items-center">
      <span class="bg-gradient-to-b from-[#fded9a] to-[#a57a32] bg-clip-text text-4xl leading-none font-black text-transparent">{average}</span>
      <span class="mt-1 text-[10px] font-bold tracking-widest text-[#b6a582] uppercase">คะแนนเฉลี่ย</span>
    </div>
    <div class="h-12 w-px bg-[#6b4c17]"></div>
    <div class="flex flex-col gap-1.5">
      <div aria-hidden="true" class="flex gap-1 text-lg">
        {Array.from({ length: 5 }).map((_, i) => <span class={i < Math.round(Number(average)) ? "text-[#fded9a]" : "text-[#6b4c17]"}>★</span>)}
      </div>
      <span class="text-xs font-bold text-[#b6a582]">คะแนนเฉลี่ย {average} จาก 5 ดาว จากการใช้งานจริงของสมาชิก {reviews.length} ด้าน</span>
    </div>
  </div>

  <div class="grid grid-cols-1 gap-6 md:grid-cols-3">
    {
      reviews.map((review) => (
        <article class="group relative isolate flex flex-col gap-4 overflow-hidden rounded-2xl border border-[#dfb85f]/25 bg-[#140d04]/92 p-6 text-left shadow-[0_10px_30px_rgba(223,184,95,0.18)] backdrop-blur-xl transition-all duration-300 hover:-translate-y-1 hover:border-[#dfb85f]/50 hover:shadow-[0_15px_40px_rgba(223,184,95,0.3)]">
          <span class="absolute inset-y-0 left-0 -z-10 w-1 bg-gradient-to-b from-[#fded9a] to-[#a57a32] opacity-80 transition-opacity duration-300 group-hover:opacity-100" />
          <span class="pointer-events-none absolute -top-14 -right-14 -z-10 h-32 w-32 rounded-full bg-[#b6a582]/20 blur-[50px] transition-all duration-300 group-hover:bg-[#dfe4e7]/25" />

          <div class="flex items-center justify-between gap-3">
            <span class="inline-flex items-center gap-1.5 rounded-full border border-[#dfb85f]/25 bg-[#070502] px-3 py-1 text-[10px] font-bold tracking-widest text-[#dfb85f] uppercase">
              <span class="h-1.5 w-1.5 animate-pulse rounded-full bg-[#dfe4e7]" />
              {review.tag}
            </span>
            <span class="flex gap-0.5 text-sm">
              <span aria-hidden="true" class="flex gap-0.5">
                {Array.from({ length: 5 }).map((_, i) => (
                  <span class={i < review.stars ? "text-[#fded9a]" : "text-[#6b4c17]"}>★</span>
                ))}
              </span>
              <span class="sr-only">ให้คะแนน {review.stars} จาก 5 ดาว</span>
            </span>
          </div>

          <p class="text-left text-base leading-relaxed text-[#e9ddbe]">{review.content}</p>

          <div class="mt-auto flex items-center gap-3 border-t border-[#6b4c17] pt-4">
            <span
              aria-hidden="true"
              class="flex h-11 w-11 shrink-0 items-center justify-center rounded-xl border border-[#dfb85f]/30 bg-gradient-to-br from-[#fded9a] via-[#dfb85f] to-[#a57a32] text-xl shadow-inner transition-transform duration-300 group-hover:scale-110">
              {review.avatar}
            </span>
            <span class="flex flex-col">
              <span class="text-sm font-black text-[#e9ddbe] transition-colors group-hover:text-[#fded9a]">{review.name}</span>
              <span class="text-[10px] font-bold tracking-wider text-[#b6a582] uppercase">{review.role}</span>
            </span>
          </div>
        </article>
      ))
    }
  </div>
</section>
