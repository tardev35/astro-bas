---
const reviews = [
  {
    name: "สมาชิกสายบอลก่อนแข่ง",
    role: "ตรวจฟอร์ม รายชื่อผู้เล่น และสถิติย้อนหลังก่อนกด",
    stars: 5,
    tag: "แทงบอลก่อนแข่ง",
    content:
      "รายการฟุตบอลแบ่งตามลีก คู่แข่งขัน และช่วงเวลา จึงเลือกดูเฉพาะแมตช์ที่สนใจได้โดยไม่ต้องไล่ค้นจากทุกหมวด ก่อนเลือกคู่ยังมีเวลาตรวจชื่อทีม เวลาแข่ง และสถานะตลาดให้ตรงกัน เพราะทีมชื่อคล้ายและลีกใกล้กันพาบิลไปผิดสนามได้ง่าย",
    avatar: "⚽",
  },
  {
    name: "สมาชิกสายบอลสด",
    role: "ดูสกอร์ เวลา และจังหวะในสนามก่อนตัดสินใจ",
    stars: 5,
    tag: "ราคาบอลและตลาดเดิมพัน",
    content:
      "ตลาดฟุตบอลมีทั้งแฮนดิแคป สูง–ต่ำ และ 1X2 ซึ่งใช้เงื่อนไขตัดสินต่างกัน จึงต้องดูทั้งราคา ฝั่งเดิมพัน และประเภทตลาดก่อนยืนยัน ราคาบอลสดขยับตามสกอร์ เวลา ใบแดง และจังหวะในสนาม เห็นราคาแล้ววางทิ้งไว้นาน พอกดจริงอาจไม่ใช่เลขเดิม",
    avatar: "⏱️",
  },
  {
    name: "สมาชิกที่เล่นบิลสเต็ปเป็นหลัก",
    role: "เช็กจำนวนคู่ ราคา และวันแข่งขันให้ครบก่อนส่งบิล",
    stars: 4,
    tag: "บิลเดี่ยวและบิลสเต็ป",
    content:
      "บิลเดี่ยวผูกผลไว้กับการแข่งขันหนึ่งคู่ จึงตรวจตลาดและเงื่อนไขได้ง่ายกว่า ส่วนบิลสเต็ปรวมหลายคู่ไว้ในรายการเดียวและทุกคู่ต้องผ่านตามที่เลือก ก่อนกดยืนยันควรตรวจคู่แข่งขัน ตลาด ราคา ยอดเดิมพัน และผลตอบแทนที่ระบบแสดง แล้วเก็บเลขรายการหรือภาพหน้าจอไว้ตรวจภายหลัง",
    avatar: "🧾",
  },
];

const totalStars = reviews.reduce((sum, r) => sum + r.stars, 0);
const average = (totalStars / reviews.length).toFixed(1);
---

<section class="relative z-10 mx-auto mb-12 w-full max-w-[1400px] px-4 font-sans">
  <div class="mb-8 flex w-full flex-col items-center justify-center gap-2 text-center">
    <p class="bg-gradient-to-r from-[#f2dca4] via-[#dcb96b] to-[#ac893a] bg-clip-text text-3xl font-black tracking-widest text-transparent uppercase">
      เสียงจากสมาชิก <span class="text-[#dcb96b]">UFAG8</span>
    </p>
    <div class="mt-2 h-[4px] w-24 rounded-full bg-gradient-to-r from-transparent via-[#dcb96b] to-transparent"></div>
  </div>

  <div class="mx-auto mb-8 flex max-w-md items-center justify-center gap-5 rounded-2xl border border-[#dcb96b]/25 bg-[#100f0c]/92 px-6 py-4 shadow-[0_10px_30px_rgba(220,185,107,0.18)] backdrop-blur-xl">
    <div class="flex flex-col items-center">
      <span class="bg-gradient-to-b from-[#f2dca4] to-[#ac893a] bg-clip-text text-4xl leading-none font-black text-transparent">{average}</span>
      <span class="mt-1 text-[10px] font-bold tracking-widest text-[#bcb6a6] uppercase">คะแนนเฉลี่ย</span>
    </div>
    <div class="h-12 w-px bg-[#7a5f22]"></div>
    <div class="flex flex-col gap-1.5">
      <div class="flex gap-1 text-lg">
        {Array.from({ length: 5 }).map((_, i) => <span class={i < Math.round(Number(average)) ? "text-[#dcb96b]" : "text-[#4a412e]"}>★</span>)}
      </div>
      <span class="text-xs font-bold text-[#bcb6a6]">จากการใช้งานจริงของสมาชิก {reviews.length} ด้าน</span>
    </div>
  </div>

  <div class="grid grid-cols-1 gap-6 md:grid-cols-3">
    {
      reviews.map((review) => (
        <article class="group relative isolate flex flex-col gap-4 overflow-hidden rounded-2xl border border-[#dcb96b]/25 bg-[#100f0c]/92 p-6 text-left shadow-[0_10px_30px_rgba(220,185,107,0.18)] backdrop-blur-xl transition-all duration-300 hover:-translate-y-1 hover:border-[#dcb96b]/50 hover:shadow-[0_15px_40px_rgba(220,185,107,0.3)]">
          <span class="absolute inset-y-0 left-0 -z-10 w-1 bg-gradient-to-b from-[#f2dca4] to-[#ac893a] opacity-80 transition-opacity duration-300 group-hover:opacity-100" />
          <span class="pointer-events-none absolute -top-14 -right-14 -z-10 h-32 w-32 rounded-full bg-[#6f7480]/40 blur-[50px] transition-all duration-300 group-hover:bg-[#b9bcc4]/35" />

          <div class="flex items-center justify-between gap-3">
            <span class="inline-flex items-center gap-1.5 rounded-full border border-[#dcb96b]/25 bg-[#191712] px-3 py-1 text-[10px] font-bold tracking-widest text-[#dcb96b] uppercase">
              <span class="h-1.5 w-1.5 animate-pulse rounded-full bg-[#dcb96b]" />
              {review.tag}
            </span>
            <div class="flex gap-0.5 text-sm">
              {Array.from({ length: 5 }).map((_, i) => (
                <span class={i < review.stars ? "text-[#dcb96b]" : "text-[#4a412e]"}>★</span>
              ))}
            </div>
          </div>

          <p class="text-left text-base leading-relaxed text-[#efeade]">{review.content}</p>

          <div class="mt-auto flex items-center gap-3 border-t border-[#7a5f22] pt-4">
            <span class="flex h-11 w-11 shrink-0 items-center justify-center rounded-xl border border-[#dcb96b]/30 bg-gradient-to-br from-[#f2dca4] via-[#dcb96b] to-[#ac893a] text-xl shadow-inner transition-transform duration-300 group-hover:scale-110">
              {review.avatar}
            </span>
            <span class="flex flex-col">
              <span class="text-sm font-black text-[#efeade] transition-colors group-hover:text-[#f2dca4]">{review.name}</span>
              <span class="text-[10px] font-bold tracking-wider text-[#bcb6a6] uppercase">{review.role}</span>
            </span>
          </div>
        </article>
      ))
    }
  </div>
</section>
<style>
  .font-sans {
    font-family: var(--font-sans);
  }
</style>
