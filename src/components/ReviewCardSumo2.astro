---
const reviews = [
  {
    name: "สมาชิกที่เพิ่งสมัครผ่านมือถือ",
    role: "สมัครด้วยเบอร์โทร ไม่ต้องถ่ายเอกสาร",
    stars: 5,
    tag: "สมัครสมาชิก",
    content: "ขั้นตอนสมัครใช้เบอร์โทรศัพท์ไทยและใช้เวลาราว 2–3 นาที ควรใช้เบอร์จริงที่รับข้อความได้ เพราะต้องใช้ยืนยันบัญชีหรือกู้รหัสผ่านภายหลัง และไม่ควรส่ง OTP ให้ผู้อื่นไม่ว่ากรณีใด",
    avatar: "📱",
  },
  {
    name: "สมาชิกสายฝากถอนออโต้",
    role: "ตรวจยอดและเลขบัญชีก่อนโอนทุกครั้ง",
    stars: 5,
    tag: "ฝากขั้นต่ำ 1 บาท",
    content: "ฝากขั้นต่ำเริ่มที่ 1 บาท รองรับทั้งธนาคารและ TrueMoney Wallet ผ่านระบบอัตโนมัติ หากเครดิตไม่เข้าให้เช็กสถานะรายการและหลักฐานก่อน อย่ารีบโอนซ้ำจนยอดซ้อน ส่วนการถอนควรดูขั้นต่ำและชื่อบัญชีให้ตรงกัน",
    avatar: "💰",
  },
  {
    name: "สมาชิกที่เล่นทั้งสล็อตและคาสิโนสด",
    role: "ดูค่า RTP และความผันผวนก่อนเลือกเกม",
    stars: 4,
    tag: "สล็อตและคาสิโนสด",
    content: "เลือกเกมโดยดูทั้งผู้ให้บริการ ค่า RTP และ Volatility ส่วนคาสิโนสดมีบาคาร่า รูเล็ต และเสือมังกร เล่นตามรอบโต๊ะพร้อมภาพถ่ายทอดสด มือใหม่ควรเริ่มจากโต๊ะเดิมพันต่ำและกำหนดวงเงินก่อนเล่น",
    avatar: "🎰",
  },
];

const totalStars = reviews.reduce((sum, r) => sum + r.stars, 0);
const average = (totalStars / reviews.length).toFixed(1);
---

<section class="relative z-10 mx-auto mb-12 w-full max-w-[1400px] px-4 font-sans">
  <div class="mb-8 flex w-full flex-col items-center justify-center gap-2 text-center">
    <p class="bg-gradient-to-r from-white via-amber-100 to-amber-400 bg-clip-text text-3xl font-black tracking-widest text-transparent uppercase drop-shadow-[0_2px_10px_rgba(212,175,90,0.35)]">
      เสียงจาก <span class="text-amber-200">สมาชิก LAPDEE88</span>
    </p>
    <div class="mt-2 h-[4px] w-24 rounded-full bg-gradient-to-r from-transparent via-amber-400 to-transparent"></div>
  </div>

  <div class="mx-auto mb-8 flex max-w-md items-center justify-center gap-5 rounded-2xl border border-amber-400/35 bg-[#12100a]/85 px-6 py-4 shadow-[0_10px_30px_rgba(212,175,90,0.22)] backdrop-blur-xl">
    <div class="flex flex-col items-center">
      <span class="bg-gradient-to-b from-white to-[#e0bd72] bg-clip-text text-4xl leading-none font-black text-transparent">{average}</span>
      <span class="mt-1 text-[10px] font-bold tracking-widest text-amber-100/60 uppercase">คะแนนเฉลี่ย</span>
    </div>
    <div class="h-12 w-px bg-amber-400/25"></div>
    <div class="flex flex-col gap-1.5">
      <div class="flex gap-1 text-lg">
        {Array.from({ length: 5 }).map((_, i) => <span class={i < Math.round(Number(average)) ? "text-amber-300 drop-shadow-[0_0_6px_rgba(212,175,90,0.7)]" : "text-amber-900/70"}>★</span>)}
      </div>
      <span class="text-xs font-bold text-amber-100/70">จากการใช้งานจริงของสมาชิก {reviews.length} ด้าน</span>
    </div>
  </div>

  <div class="grid grid-cols-1 gap-6 md:grid-cols-3">
    {
      reviews.map((review) => (
        <article class="group relative isolate flex flex-col gap-4 overflow-hidden rounded-2xl border border-amber-400/30 bg-[#12100a]/85 p-6 text-left shadow-[0_10px_30px_rgba(0,0,0,0.8)] backdrop-blur-xl transition-all duration-300 hover:-translate-y-1 hover:border-amber-300/60 hover:shadow-[0_18px_40px_rgba(212,175,90,0.3)]">
          <span class="absolute inset-y-0 left-0 -z-10 w-1 bg-gradient-to-b from-[#f1e6cf] via-[#e0bd72] to-[#b1873a] opacity-70 transition-opacity duration-300 group-hover:opacity-100" />
          <span class="pointer-events-none absolute -top-14 -right-14 -z-10 h-32 w-32 rounded-full bg-amber-600/25 blur-[50px] transition-all duration-300 group-hover:bg-amber-500/30" />

          <div class="flex items-center justify-between gap-3">
            <span class="inline-flex items-center gap-1.5 rounded-full border border-amber-300/35 bg-amber-300/10 px-3 py-1 text-[10px] font-bold tracking-widest text-amber-200 uppercase">
              <span class="h-1.5 w-1.5 animate-pulse rounded-full bg-amber-300" />
              {review.tag}
            </span>
            <div class="flex gap-0.5 text-sm">
              {Array.from({ length: 5 }).map((_, i) => (
                <span class={i < review.stars ? "text-amber-300 drop-shadow-[0_0_5px_rgba(212,175,90,0.7)]" : "text-amber-900/70"}>★</span>
              ))}
            </div>
          </div>

          <p class="text-base leading-relaxed text-amber-50/85">{review.content}</p>

          <div class="mt-auto flex items-center gap-3 border-t border-amber-400/20 pt-4">
            <span class="flex h-11 w-11 shrink-0 items-center justify-center rounded-xl border border-amber-300/30 bg-gradient-to-br from-[#1c1609] to-[#0b0906] text-xl shadow-inner transition-transform duration-300 group-hover:scale-110">
              {review.avatar}
            </span>
            <span class="flex flex-col">
              <span class="text-sm font-black text-white transition-colors group-hover:text-amber-200">{review.name}</span>
              <span class="text-[10px] font-bold tracking-wider text-amber-200/60 uppercase">{review.role}</span>
            </span>
          </div>
        </article>
      ))
    }
  </div>
</section>
<style>
  .font-sans {
    font-family: var(--font-sans);
  }
</style>
