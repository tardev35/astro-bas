---
const reviews = [
  {
    name: "สมาชิกที่เล่นผ่านมือถือเป็นหลัก",
    role: "เปิดผ่านเบราว์เซอร์ระบบ HTML5",
    stars: 5,
    tag: "ใช้งานบนมือถือ",
    content: "หน้าเกมเปิดผ่านเบราว์เซอร์บน Android และ iOS ได้เลย เมนูเกมและฟังก์ชันสมาชิกใกล้เคียงกับหน้าเว็บบนคอมพิวเตอร์ แต่ควรใช้อินเทอร์เน็ตที่เสถียร โดยเฉพาะตอนเข้าเกม Live สดและตอนทำธุรกรรม",
    avatar: "📱",
  },
  {
    name: "สมาชิกสายสล็อตที่ชอบลองก่อน",
    role: "ดูฟีเจอร์จากโหมดทดลองก่อนใช้เงินจริง",
    stars: 5,
    tag: "สล็อตและโหมดทดลอง",
    content:
      "หน้าสล็อตแยกค่ายไว้ให้ ทั้ง PG Soft, JILI, Pragmatic Play และ Microgaming รวมเกมกว่า 1,000 รายการ บางเกมมีโหมดทดลองให้ดูปุ่มเดิมพันและจังหวะเกมก่อน แต่ผลจากโหมดทดลองไม่ได้บอกว่าเกมจริงจะออกเหมือนกัน",
    avatar: "🎰",
  },
  {
    name: "สมาชิกที่เล่นบาคาร่าและโต๊ะ Live สด",
    role: "ตรวจขั้นต่ำโต๊ะและกติกาก่อนเข้าเล่น",
    stars: 4,
    tag: "บาคาร่าและเกม Live สด",
    content:
      "หมวด Live สดมีบาคาร่า รูเล็ต และแบล็คแจ็คจากหลายผู้ให้บริการ เช่น Evolution, SA Gaming, Sexy Gaming และ Dream Gaming แต่ละค่ายหน้าตาโต๊ะไม่เหมือนกัน ควรอ่านกติกาของแต่ละเวอร์ชันก่อนลงเดิมพัน",
    avatar: "🃏",
  },
];

const totalStars = reviews.reduce((sum, r) => sum + r.stars, 0);
const average = (totalStars / reviews.length).toFixed(1);
---

<section class="relative z-10 mx-auto mb-12 w-full max-w-[1400px] px-4 font-sans">
  <div class="mb-8 flex w-full flex-col items-center justify-center gap-2 text-center">
    <p class="bg-gradient-to-r from-[#f7e3a4] via-[#e2c05f] to-[#c39a34] bg-clip-text text-3xl font-black tracking-widest text-transparent uppercase">
      เสียงจากสมาชิก <span class="text-[#d8b558]">PRODED888</span>
    </p>
    <div class="mt-2 h-[4px] w-24 rounded-full bg-gradient-to-r from-transparent via-[#e2c05f] to-transparent"></div>
  </div>

  <div class="mx-auto mb-8 flex max-w-md items-center justify-center gap-5 rounded-2xl border border-amber-400/25 bg-[#0b1330]/92 px-6 py-4 shadow-[0_10px_30px_rgba(226,192,95,0.18)] backdrop-blur-xl">
    <div class="flex flex-col items-center">
      <span class="bg-gradient-to-b from-[#f7e3a4] to-[#c39a34] bg-clip-text text-4xl leading-none font-black text-transparent">{average}</span>
      <span class="mt-1 text-[10px] font-bold tracking-widest text-white/60 uppercase">คะแนนเฉลี่ย</span>
    </div>
    <div class="h-12 w-px bg-[#2b3a6f]"></div>
    <div class="flex flex-col gap-1.5">
      <div class="flex gap-1 text-lg">
        {Array.from({ length: 5 }).map((_, i) => <span class={i < Math.round(Number(average)) ? "text-[#e2c05f]" : "text-[#3b4a80]"}>★</span>)}
      </div>
      <span class="text-xs font-bold text-white/70">จากการใช้งานจริงของสมาชิก {reviews.length} ด้าน</span>
    </div>
  </div>

  <div class="grid grid-cols-1 gap-6 md:grid-cols-3">
    {
      reviews.map((review) => (
        <article class="group relative isolate flex flex-col gap-4 overflow-hidden rounded-2xl border border-amber-400/25 bg-[#0b1330]/92 p-6 text-left shadow-[0_10px_30px_rgba(226,192,95,0.18)] backdrop-blur-xl transition-all duration-300 hover:-translate-y-1 hover:border-amber-400/50 hover:shadow-[0_15px_40px_rgba(226,192,95,0.30)]">
          <span class="absolute inset-y-0 left-0 -z-10 w-1 bg-gradient-to-b from-[#f7e3a4] to-[#c39a34] opacity-80 transition-opacity duration-300 group-hover:opacity-100" />
          <span class="pointer-events-none absolute -top-14 -right-14 -z-10 h-32 w-32 rounded-full bg-amber-300/25 blur-[50px] transition-all duration-300 group-hover:bg-amber-400/30" />

          <div class="flex items-center justify-between gap-3">
            <span class="inline-flex items-center gap-1.5 rounded-full border border-amber-400/25 bg-[#111c45] px-3 py-1 text-[10px] font-bold tracking-widest text-[#f0d68c] uppercase">
              <span class="h-1.5 w-1.5 animate-pulse rounded-full bg-[#e2c05f]" />
              {review.tag}
            </span>
            <div class="flex gap-0.5 text-sm">
              {Array.from({ length: 5 }).map((_, i) => (
                <span class={i < review.stars ? "text-[#e2c05f]" : "text-[#3b4a80]"}>★</span>
              ))}
            </div>
          </div>

          <p class="text-left text-base leading-relaxed text-[#e6e3d8]">{review.content}</p>

          <div class="mt-auto flex items-center gap-3 border-t border-[#2b3a6f] pt-4">
            <span class="flex h-11 w-11 shrink-0 items-center justify-center rounded-xl border border-amber-400/30 bg-gradient-to-br from-[#f7e3a4] via-[#e2c05f] to-[#c39a34] text-xl shadow-inner transition-transform duration-300 group-hover:scale-110">
              {review.avatar}
            </span>
            <span class="flex flex-col">
              <span class="text-sm font-black text-[#e6e3d8] transition-colors group-hover:text-[#f0d68c]">{review.name}</span>
              <span class="text-[10px] font-bold tracking-wider text-white/60 uppercase">{review.role}</span>
            </span>
          </div>
        </article>
      ))
    }
  </div>
</section>
<style>
  .font-sans {
    font-family: var(--font-sans);
  }
</style>
