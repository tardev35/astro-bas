---
const reviews = [
  {
    name: "สมาชิกสายค่ายเกมระดับโลก",
    role: "เลือกเกมจากฟีเจอร์และอัตราการจ่ายของแต่ละค่ายก่อนกดเล่น",
    stars: 5,
    tag: "Hacksaw • Nolimit City • Relax",
    content:
      "ชอบที่ LUCKYGAME689 รวบรวมซอฟต์แวร์เกมชั้นนำจากทั่วทุกมุมโลกมาไว้ที่เดียว Hacksaw Gaming เรียบง่ายแต่คูณเงินรางวัลได้สูงลิ่ว Nolimit City ฟีเจอร์แปลกใหม่และจ่ายหนักจัดเต็ม ส่วน Relax Gaming แอนิเมชันลื่นจนเล่นบนมือถือได้ทั้งวัน สลับค่ายได้โดยไม่ต้องย้ายเงินหรือสมัครบัญชีใหม่",
    avatar: "💥",
  },
  {
    name: "สมาชิกที่กดรับโปรเองทุกวัน",
    role: "อ่านเงื่อนไขแคมเปญจากแดชบอร์ดก่อนกดยอมรับทุกครั้ง",
    stars: 5,
    tag: "โปรโมชั่นเด็ด",
    content:
      "จุดที่ต่างจากที่อื่นคือทุนสนับสนุนที่อัปเดตต่อเนื่อง ทั้งโบนัสต้อนรับและแคมเปญประจำวัน กดรับสิทธิ์เองได้จากแดชบอร์ดส่วนตัวผ่านระบบออโต้ ไม่ต้องทักไปขอกับแอดมินทีละรอบ ทำให้เอาทุนไปต่อยอดได้ทันทีโดยไม่เสียจังหวะ",
    avatar: "🎁",
  },
  {
    name: "สมาชิกที่เข้าใช้งานทุกวัน",
    role: "ใช้ทั้งบนมือถือและคอมพิวเตอร์สลับกันตลอดสัปดาห์",
    stars: 4,
    tag: "บริการระดับ VVIP • Premium Loader",
    content:
      "ทีมงานสแตนด์บายจริงตลอด 24 ชั่วโมง ถามอะไรไปก็ตอบไวและแก้ได้ตรงจุด ส่วนการล็อกอินทำงานผ่าน Secure Transition Popup ที่โหลดไวและไม่ทำให้หน้าเว็บรีเฟรชซ้ำซ้อน ข้อแนะนำเดียวคือควรอ่านเงื่อนไขของแต่ละแคมเปญให้ครบก่อนกดรับสิทธิ์",
    avatar: "👑",
  },
];

const totalStars = reviews.reduce((sum, r) => sum + r.stars, 0);
const average = (totalStars / reviews.length).toFixed(1);
---

<section aria-label="เสียงจากสมาชิก LUCKYGAME689" class="relative z-10 mx-auto mb-12 w-full max-w-[1400px] px-4 font-sans">
  <div class="mb-8 flex w-full flex-col items-center justify-center gap-2 text-center">
    <p class="bg-gradient-to-r from-[#ffd84d] via-[#faad23] to-[#ff3d8a] bg-clip-text text-3xl font-black tracking-widest text-transparent uppercase">
      เสียงจากสมาชิก <span class="text-[#ff3d8a]">LUCKYGAME689</span>
    </p>
    <div class="mt-2 h-[4px] w-24 rounded-full bg-gradient-to-r from-transparent via-[#faad23] to-transparent"></div>
  </div>

  <div
    class="mx-auto mb-8 flex max-w-md items-center justify-center gap-5 rounded-2xl border border-[#faad23]/25 bg-[#2b0204]/92 px-6 py-4 shadow-[0_10px_30px_rgba(250,173,35,0.18)] backdrop-blur-xl">
    <div class="flex flex-col items-center">
      <span class="bg-gradient-to-b from-[#ffd84d] to-[#b8760f] bg-clip-text text-4xl leading-none font-black text-transparent">{average}</span>
      <span class="mt-1 text-[10px] font-bold tracking-widest text-[#e0a6b5] uppercase">คะแนนเฉลี่ย</span>
    </div>
    <div class="h-12 w-px bg-[#7a0426]"></div>
    <div class="flex flex-col gap-1.5">
      <div aria-hidden="true" class="flex gap-1 text-lg">
        {Array.from({ length: 5 }).map((_, i) => <span class={i < Math.round(Number(average)) ? "text-[#ffd84d]" : "text-[#7a0426]"}>★</span>)}
      </div>
      <span class="text-xs font-bold text-[#e0a6b5]">คะแนนเฉลี่ย {average} จาก 5 ดาว จากการใช้งานจริงของสมาชิก {reviews.length} ด้าน</span>
    </div>
  </div>

  <div class="grid grid-cols-1 gap-6 md:grid-cols-3">
    {
      reviews.map((review) => (
        <article class="group relative isolate flex flex-col gap-4 overflow-hidden rounded-2xl border border-[#faad23]/25 bg-[#2b0204]/92 p-6 text-left shadow-[0_10px_30px_rgba(250,173,35,0.18)] backdrop-blur-xl transition-all duration-300 hover:-translate-y-1 hover:border-[#faad23]/50 hover:shadow-[0_15px_40px_rgba(224,27,93,0.28)]">
          <span class="absolute inset-y-0 left-0 -z-10 w-1 bg-gradient-to-b from-[#ffd84d] to-[#b8760f] opacity-80 transition-opacity duration-300 group-hover:opacity-100" />
          <span class="pointer-events-none absolute -top-14 -right-14 -z-10 h-32 w-32 rounded-full bg-[#e01b5d]/22 blur-[50px] transition-all duration-300 group-hover:bg-[#ff3d8a]/28" />

          <div class="flex items-center justify-between gap-3">
            <span class="inline-flex items-center gap-1.5 rounded-full border border-[#faad23]/25 bg-[#1a0106] px-3 py-1 text-[10px] font-bold tracking-widest text-[#faad23] uppercase">
              <span class="h-1.5 w-1.5 animate-pulse rounded-full bg-[#ff3d8a]" />
              {review.tag}
            </span>
            <span class="flex gap-0.5 text-sm">
              <span aria-hidden="true" class="flex gap-0.5">
                {Array.from({ length: 5 }).map((_, i) => (
                  <span class={i < review.stars ? "text-[#ffd84d]" : "text-[#7a0426]"}>★</span>
                ))}
              </span>
              <span class="sr-only">ให้คะแนน {review.stars} จาก 5 ดาว</span>
            </span>
          </div>

          <p class="text-left text-base leading-relaxed text-[#ffe9c4]">{review.content}</p>

          <div class="mt-auto flex items-center gap-3 border-t border-[#7a0426] pt-4">
            <span
              aria-hidden="true"
              class="flex h-11 w-11 shrink-0 items-center justify-center rounded-xl border border-[#faad23]/30 bg-gradient-to-br from-[#ffd84d] via-[#faad23] to-[#b8760f] text-xl shadow-inner transition-transform duration-300 group-hover:scale-110">
              {review.avatar}
            </span>
            <span class="flex flex-col">
              <span class="text-sm font-black text-[#ffe9c4] transition-colors group-hover:text-[#ffd84d]">{review.name}</span>
              <span class="text-[10px] font-bold tracking-wider text-[#e0a6b5] uppercase">{review.role}</span>
            </span>
          </div>
        </article>
      ))
    }
  </div>
</section>
