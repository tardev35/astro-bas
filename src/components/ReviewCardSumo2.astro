---
const reviews = [
  {
    name: "สมาชิกฝั่งกีฬาและเกม Live สด",
    role: "ดูค่าน้ำก่อนกดยืนยันบิลทุกครั้ง",
    stars: 5,
    tag: "หมวดเดิมพัน",
    content: "สลับระหว่างสล็อต กีฬา เกม Live สด และเดิมพันด้านการเงินได้จากบัญชีเดียว ฝั่งกีฬาดูได้ทั้งค่าน้ำ ตลาดเดิมพัน เวลาปิดรับ และประเภทบิล ทั้งเต็มเวลา ครึ่งแรก และสเต็ป ก่อนตัดสินใจ",
    avatar: "⚽",
  },
  {
    name: "สมาชิกสายกิจกรรมล่ารางวัล",
    role: "ตามเปิดกล่อง เปิดดวง และล่า Hidden",
    stars: 5,
    tag: "กิจกรรมบนหน้าเว็บ",
    content: "กิจกรรมเปิดกล่อง เปิดดวง ล่า Hidden และเครดิตฟรีแบบกดรับเอง ทำให้มีเหตุผลกลับมาเช็กหน้าเว็บ แต่ก่อนกดรับยังต้องดูจำนวนสิทธิ์ วันหมดอายุ ยอดเทิร์น และเกมที่รองรับให้ครบก่อน",
    avatar: "🎁",
  },
  {
    name: "สมาชิกที่ใช้งานผ่านมือถือ",
    role: "สมัครและติดตามกิจกรรมผ่านแอป",
    stars: 4,
    tag: "PAY69 App และคู่มือภาพ",
    content: "PAY69 App ใช้ได้ตั้งแต่สมัคร เข้าระบบ ติดตามกิจกรรม ไปจนถึงจัดการบัญชี ส่วน Beginner Guide อธิบายด้วยภาพตั้งแต่กดสมัคร ตั้งชื่อผู้ใช้ และกำหนดรหัสผ่าน ก่อนติดตั้งควรตรวจแหล่งดาวน์โหลดและเวอร์ชันอุปกรณ์",
    avatar: "📱",
  },
];

const totalStars = reviews.reduce((sum, r) => sum + r.stars, 0);
const average = (totalStars / reviews.length).toFixed(1);
---

<section class="relative z-10 mx-auto mb-12 w-full max-w-[1400px] px-4 font-sans">
  <div class="mb-8 flex w-full flex-col items-center justify-center gap-2 text-center">
    <p class="bg-gradient-to-r from-white via-amber-100 to-amber-400 bg-clip-text text-3xl font-black tracking-widest text-transparent uppercase drop-shadow-[0_2px_10px_rgba(212,162,74,0.35)]">
      เสียงจาก <span class="text-amber-200">สมาชิก PAY69</span>
    </p>
    <div class="mt-2 h-[4px] w-24 rounded-full bg-gradient-to-r from-transparent via-amber-400 to-transparent"></div>
  </div>

  <div class="mx-auto mb-8 flex max-w-md items-center justify-center gap-5 rounded-2xl border border-amber-400/30 bg-[#150a24]/80 px-6 py-4 shadow-[0_10px_30px_rgba(212,162,74,0.22)] backdrop-blur-xl">
    <div class="flex flex-col items-center">
      <span class="bg-gradient-to-b from-white to-[#d4a24a] bg-clip-text text-4xl leading-none font-black text-transparent">{average}</span>
      <span class="mt-1 text-[10px] font-bold tracking-widest text-amber-100/60 uppercase">คะแนนเฉลี่ย</span>
    </div>
    <div class="h-12 w-px bg-amber-400/25"></div>
    <div class="flex flex-col gap-1.5">
      <div class="flex gap-1 text-lg">
        {Array.from({ length: 5 }).map((_, i) => <span class={i < Math.round(Number(average)) ? "text-amber-300 drop-shadow-[0_0_6px_rgba(212,162,74,0.7)]" : "text-violet-900/70"}>★</span>)}
      </div>
      <span class="text-xs font-bold text-amber-100/70">จากการใช้งานจริงของสมาชิก {reviews.length} ด้าน</span>
    </div>
  </div>

  <div class="grid grid-cols-1 gap-6 md:grid-cols-3">
    {
      reviews.map((review) => (
        <article class="group relative isolate flex flex-col gap-4 overflow-hidden rounded-2xl border border-amber-400/25 bg-[#150a24]/80 p-6 text-left shadow-[0_10px_30px_rgba(0,0,0,0.6)] backdrop-blur-xl transition-all duration-300 hover:-translate-y-1 hover:border-amber-300/50 hover:shadow-[0_18px_40px_rgba(212,162,74,0.3)]">
          <span class="absolute inset-y-0 left-0 -z-10 w-1 bg-gradient-to-b from-[#f2dbb4] via-[#d4a24a] to-[#4c1d95] opacity-70 transition-opacity duration-300 group-hover:opacity-100" />
          <span class="pointer-events-none absolute -top-14 -right-14 -z-10 h-32 w-32 rounded-full bg-violet-600/25 blur-[50px] transition-all duration-300 group-hover:bg-amber-500/20" />

          <div class="flex items-center justify-between gap-3">
            <span class="inline-flex items-center gap-1.5 rounded-full border border-amber-300/35 bg-amber-300/10 px-3 py-1 text-[10px] font-bold tracking-widest text-amber-200 uppercase">
              <span class="h-1.5 w-1.5 animate-pulse rounded-full bg-amber-300" />
              {review.tag}
            </span>
            <div class="flex gap-0.5 text-sm">
              {Array.from({ length: 5 }).map((_, i) => (
                <span class={i < review.stars ? "text-amber-300 drop-shadow-[0_0_5px_rgba(212,162,74,0.7)]" : "text-violet-900/70"}>★</span>
              ))}
            </div>
          </div>

          <p class="text-base leading-relaxed text-amber-50/85">{review.content}</p>

          <div class="mt-auto flex items-center gap-3 border-t border-amber-400/20 pt-4">
            <span class="flex h-11 w-11 shrink-0 items-center justify-center rounded-xl border border-amber-300/30 bg-gradient-to-br from-[#4c1d95] to-[#0a0714] text-xl shadow-inner transition-transform duration-300 group-hover:scale-110">
              {review.avatar}
            </span>
            <span class="flex flex-col">
              <span class="text-sm font-black text-white transition-colors group-hover:text-amber-200">{review.name}</span>
              <span class="text-[10px] font-bold tracking-wider text-amber-200/60 uppercase">{review.role}</span>
            </span>
          </div>
        </article>
      ))
    }
  </div>
</section>
<style>
  .font-sans {
    font-family: var(--font-sans);
  }
</style>
