---
const reviews = [
  {
    name: "สมาชิกสายค่ายเกมลิขสิทธิ์แท้",
    role: "เลือกเกมจากฟีเจอร์และอัตราการจ่ายของแต่ละค่ายก่อนกดเล่น",
    stars: 5,
    tag: "Thunderkick • Playtech • Habanero",
    content:
      "ชอบที่ TT1BET คัดสรรซอฟต์แวร์ลิขสิทธิ์แท้จากผู้พัฒนาชั้นนำทั่วโลกมาไว้ในที่เดียว Thunderkick มีกลไกการเล่นที่แหวกแนวจนทวีคูณเงินรางวัลได้จริง Playtech ระบบเสถียรและฟีเจอร์แจ็กพอตจ่ายหนักจัดเต็ม ส่วน Habanero เล่นง่ายเข้าใจง่ายและออกรางวัลโบนัสต่อเนื่อง สลับค่ายได้โดยไม่ต้องย้ายเงินหรือสมัครบัญชีใหม่",
    avatar: "🎰",
  },
  {
    name: "สมาชิกที่ทำรายการทุกวัน",
    role: "ใช้ทั้งบนมือถือและคอมพิวเตอร์สลับกันตลอดสัปดาห์",
    stars: 5,
    tag: "จ่ายจริง ทุกยอดบิล",
    content:
      "พอทำกำไรได้ตามเป้าหมาย ระบบออโต้ประมวลผลและโอนเข้ากระเป๋าให้ทันที ครบทุกบาททุกสตางค์ ไม่มีการหักค่าธรรมเนียมหรือเปอร์เซ็นต์ใดๆ ยอดหลักแสนก็ยังโอนไวเท่าเดิม ไม่เจอการอั้นยอดหรือให้รอรอบเหมือนที่เคยเจอมาก่อน",
    avatar: "💰",
  },
  {
    name: "สมาชิกที่บริหารทุนเอง",
    role: "ตั้งงบต่อวันแล้วเติมทีละน้อยตามจังหวะของตัวเอง",
    stars: 4,
    tag: "สมัครง่าย • ปลอดภัย 100%",
    content:
      "ลงทะเบียนผ่านระบบ AI อัตโนมัติใช้เวลาไม่ถึงนาทีก็เข้าแดชบอร์ดส่วนตัวได้เลย ทุกครั้งที่เข้าใช้งานมี Secure Popup Loader ปกป้องข้อมูลให้อีกชั้น ข้อแนะนำเดียวคือควรอ่านเงื่อนไขของแต่ละแคมเปญให้ครบก่อนกดรับสิทธิ์",
    avatar: "🔒",
  },
];

const totalStars = reviews.reduce((sum, r) => sum + r.stars, 0);
const average = (totalStars / reviews.length).toFixed(1);
---

<section aria-label="เสียงจากสมาชิก TT1BET" class="relative z-10 mx-auto mb-12 w-full max-w-[1400px] px-4 font-sans">
  <div class="mb-8 flex w-full flex-col items-center justify-center gap-2 text-center">
    <p class="bg-gradient-to-r from-[#dfe4e7] via-[#fcf6ab] to-[#f3c43c] bg-clip-text text-3xl font-black tracking-widest text-transparent uppercase">
      เสียงจากสมาชิก <span class="text-[#fcf6ab]">TT1BET</span>
    </p>
    <div class="mt-2 h-[4px] w-24 rounded-full bg-gradient-to-r from-transparent via-[#ebdd65] to-transparent"></div>
  </div>

  <div
    class="mx-auto mb-8 flex max-w-md items-center justify-center gap-5 rounded-2xl border border-[#ebdd65]/25 bg-[#171106]/92 px-6 py-4 shadow-[0_10px_30px_rgba(235,221,101,0.18)] backdrop-blur-xl">
    <div class="flex flex-col items-center">
      <span class="bg-gradient-to-b from-[#fcf6ab] to-[#a8790f] bg-clip-text text-4xl leading-none font-black text-transparent">{average}</span>
      <span class="mt-1 text-[10px] font-bold tracking-widest text-[#c9bb96] uppercase">คะแนนเฉลี่ย</span>
    </div>
    <div class="h-12 w-px bg-[#34230b]"></div>
    <div class="flex flex-col gap-1.5">
      <div aria-hidden="true" class="flex gap-1 text-lg">
        {Array.from({ length: 5 }).map((_, i) => <span class={i < Math.round(Number(average)) ? "text-[#f3c43c]" : "text-[#34230b]"}>★</span>)}
      </div>
      <span class="text-xs font-bold text-[#c9bb96]">คะแนนเฉลี่ย {average} จาก 5 ดาว จากการใช้งานจริงของสมาชิก {reviews.length} ด้าน</span>
    </div>
  </div>

  <div class="grid grid-cols-1 gap-6 md:grid-cols-3">
    {
      reviews.map((review) => (
        <article class="group relative isolate flex flex-col gap-4 overflow-hidden rounded-2xl border border-[#ebdd65]/25 bg-[#171106]/92 p-6 text-left shadow-[0_10px_30px_rgba(235,221,101,0.18)] backdrop-blur-xl transition-all duration-300 hover:-translate-y-1 hover:border-[#ebdd65]/50 hover:shadow-[0_15px_40px_rgba(212,180,51,0.3)]">
          <span class="absolute inset-y-0 left-0 -z-10 w-1 bg-gradient-to-b from-[#fcf6ab] to-[#a8790f] opacity-80 transition-opacity duration-300 group-hover:opacity-100" />
          <span class="pointer-events-none absolute -top-14 -right-14 -z-10 h-32 w-32 rounded-full bg-[#d4b433]/22 blur-[50px] transition-all duration-300 group-hover:bg-[#ebdd65]/30" />

          <div class="flex items-center justify-between gap-3">
            <span class="inline-flex items-center gap-1.5 rounded-full border border-[#ebdd65]/25 bg-[#0a0704] px-3 py-1 text-[10px] font-bold tracking-widest text-[#ebdd65] uppercase">
              <span aria-hidden="true" class="h-1.5 w-1.5 animate-pulse rounded-full bg-[#fcf6ab]" />
              {review.tag}
            </span>
            <span class="flex gap-0.5 text-sm">
              <span aria-hidden="true" class="flex gap-0.5">
                {Array.from({ length: 5 }).map((_, i) => (
                  <span class={i < review.stars ? "text-[#f3c43c]" : "text-[#34230b]"}>★</span>
                ))}
              </span>
              <span class="sr-only">ให้คะแนน {review.stars} จาก 5 ดาว</span>
            </span>
          </div>

          <p class="text-left text-base leading-relaxed text-[#f0e6cc]">{review.content}</p>

          <div class="mt-auto flex items-center gap-3 border-t border-[#34230b] pt-4">
            <span
              aria-hidden="true"
              class="flex h-11 w-11 shrink-0 items-center justify-center rounded-xl border border-[#ebdd65]/30 bg-gradient-to-br from-[#fcf6ab] via-[#ebdd65] to-[#a8790f] text-xl shadow-inner transition-transform duration-300 group-hover:scale-110">
              {review.avatar}
            </span>
            <span class="flex flex-col">
              <span class="text-sm font-black text-[#f0e6cc] transition-colors group-hover:text-[#fcf6ab]">{review.name}</span>
              <span class="text-[10px] font-bold tracking-wider text-[#c9bb96] uppercase">{review.role}</span>
            </span>
          </div>
        </article>
      ))
    }
  </div>
</section>
