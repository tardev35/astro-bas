---
const reviews = [
  {
    name: "สมาชิกสายค่ายเกมระดับโลก",
    role: "เลือกเกมจากฟีเจอร์และอัตราการจ่ายของแต่ละค่ายก่อนกดเล่น",
    stars: 5,
    tag: "PG Soft • Pragmatic Play • Nolimit City",
    content:
      "ชอบที่ PGW44 รวมผู้พัฒนาชั้นนำไว้ในบัญชีเดียว PG Soft กราฟิก 3D คมชัดและเข้าถึงรอบโบนัสได้ไว Pragmatic Play ตอบสนองฉับไวและจ่ายก้อนโต ส่วน Nolimit City เน้นตัวคูณแบบก้าวกระโดด สลับค่ายได้โดยไม่ต้องสมัครใหม่ ทุกเกมโหลดไว ไม่มีอาการค้างระหว่างสปิน",
    avatar: "🐉",
  },
  {
    name: "สมาชิกที่ใช้ระบบออโต้ไม่มีขั้นต่ำ",
    role: "บริหารทุนของตัวเองแบบไม่มีเงื่อนไขผูกมัด",
    stars: 5,
    tag: "ระบบออโต้ไม่มีขั้นต่ำ",
    content:
      "จุดที่ต่างจากที่อื่นคือไม่ต้องกังวลเรื่องยอดขั้นต่ำ จะฝากหรือถอนเท่าไหร่ก็จัดการได้เอง ระบบประมวลผลผ่าน AI จึงตัดขั้นตอนที่ซับซ้อนออกไปเกือบทั้งหมด ทำรายการเสร็จภายในไม่กี่วินาทีและยอดเข้าตรงตามจำนวนทุกครั้ง ไม่ต้องรอเจ้าหน้าที่รับเรื่องทีละราย",
    avatar: "🤖",
  },
  {
    name: "สมาชิกที่กดรับสิทธิพิเศษเป็นประจำ",
    role: "อ่านเงื่อนไขแคมเปญจากหน้าแดชบอร์ดก่อนกดยอมรับ",
    stars: 4,
    tag: "โปรลุ้นรับรางวัลเยอะ",
    content:
      "แคมเปญของ PGW44 กดรับเองได้จากหน้าแดชบอร์ดอัตโนมัติ ไม่ต้องทักแอดมินให้เสียเวลา ทั้งโบนัสต้อนรับ กิจกรรมประจำวัน และคืนยอดเสีย 15% ที่ช่วยต่อทุนได้จริง ข้อแนะนำเดียวคือควรอ่านเงื่อนไขของแต่ละสิทธิ์ก่อนกดยอมรับ เพราะแต่ละแคมเปญใช้กติกาคนละชุดกัน",
    avatar: "🎁",
  },
];

const totalStars = reviews.reduce((sum, r) => sum + r.stars, 0);
const average = (totalStars / reviews.length).toFixed(1);
---

<section aria-label="เสียงจากสมาชิก PGW44" class="relative z-10 mx-auto mb-12 w-full max-w-[1400px] px-4 font-sans">
  <div class="mb-8 flex w-full flex-col items-center justify-center gap-2 text-center">
    <p class="bg-gradient-to-r from-[#ffd54a] via-[#ecab03] to-[#8fd633] bg-clip-text text-3xl font-black tracking-widest text-transparent uppercase">
      เสียงจากสมาชิก <span class="text-[#8fd633]">PGW44</span>
    </p>
    <div class="mt-2 h-[4px] w-24 rounded-full bg-gradient-to-r from-transparent via-[#ecab03] to-transparent"></div>
  </div>

  <div class="mx-auto mb-8 flex max-w-md items-center justify-center gap-5 rounded-2xl border border-[#ecab03]/25 bg-[#111a0a]/92 px-6 py-4 shadow-[0_10px_30px_rgba(236,171,3,0.18)] backdrop-blur-xl">
    <div class="flex flex-col items-center">
      <span class="bg-gradient-to-b from-[#ffd54a] to-[#a9760a] bg-clip-text text-4xl leading-none font-black text-transparent">{average}</span>
      <span class="mt-1 text-[10px] font-bold tracking-widest text-[#b9c4a6] uppercase">คะแนนเฉลี่ย</span>
    </div>
    <div class="h-12 w-px bg-[#2c5a0d]"></div>
    <div class="flex flex-col gap-1.5">
      <div aria-hidden="true" class="flex gap-1 text-lg">
        {Array.from({ length: 5 }).map((_, i) => <span class={i < Math.round(Number(average)) ? "text-[#ffd54a]" : "text-[#2c5a0d]"}>★</span>)}
      </div>
      <span class="text-xs font-bold text-[#b9c4a6]">คะแนนเฉลี่ย {average} จาก 5 ดาว จากการใช้งานจริงของสมาชิก {reviews.length} ด้าน</span>
    </div>
  </div>

  <div class="grid grid-cols-1 gap-6 md:grid-cols-3">
    {
      reviews.map((review) => (
        <article class="group relative isolate flex flex-col gap-4 overflow-hidden rounded-2xl border border-[#ecab03]/25 bg-[#111a0a]/92 p-6 text-left shadow-[0_10px_30px_rgba(236,171,3,0.18)] backdrop-blur-xl transition-all duration-300 hover:-translate-y-1 hover:border-[#ecab03]/50 hover:shadow-[0_15px_40px_rgba(236,171,3,0.3)]">
          <span class="absolute inset-y-0 left-0 -z-10 w-1 bg-gradient-to-b from-[#ffd54a] to-[#a9760a] opacity-80 transition-opacity duration-300 group-hover:opacity-100" />
          <span class="pointer-events-none absolute -top-14 -right-14 -z-10 h-32 w-32 rounded-full bg-[#2c5a0d]/50 blur-[50px] transition-all duration-300 group-hover:bg-[#4a8d14]/45" />

          <div class="flex items-center justify-between gap-3">
            <span class="inline-flex items-center gap-1.5 rounded-full border border-[#ecab03]/25 bg-[#0a0f06] px-3 py-1 text-[10px] font-bold tracking-widest text-[#ecab03] uppercase">
              <span class="h-1.5 w-1.5 animate-pulse rounded-full bg-[#8fd633]" />
              {review.tag}
            </span>
            <span class="flex gap-0.5 text-sm">
              <span aria-hidden="true" class="flex gap-0.5">
                {Array.from({ length: 5 }).map((_, i) => (
                  <span class={i < review.stars ? "text-[#ffd54a]" : "text-[#2c5a0d]"}>★</span>
                ))}
              </span>
              <span class="sr-only">ให้คะแนน {review.stars} จาก 5 ดาว</span>
            </span>
          </div>

          <p class="text-left text-base leading-relaxed text-[#e8efd8]">{review.content}</p>

          <div class="mt-auto flex items-center gap-3 border-t border-[#2c5a0d] pt-4">
            <span aria-hidden="true" class="flex h-11 w-11 shrink-0 items-center justify-center rounded-xl border border-[#ecab03]/30 bg-gradient-to-br from-[#ffd54a] via-[#ecab03] to-[#a9760a] text-xl shadow-inner transition-transform duration-300 group-hover:scale-110">
              {review.avatar}
            </span>
            <span class="flex flex-col">
              <span class="text-sm font-black text-[#e8efd8] transition-colors group-hover:text-[#ffd54a]">{review.name}</span>
              <span class="text-[10px] font-bold tracking-wider text-[#b9c4a6] uppercase">{review.role}</span>
            </span>
          </div>
        </article>
      ))
    }
  </div>
</section>
