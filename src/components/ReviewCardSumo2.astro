---
const reviews = [
  {
    name: "สมาชิกสายค่ายเกมชั้นนำ",
    role: "เล่นสลับค่ายในบัญชีเดียว",
    stars: 5,
    tag: "รวมค่ายเกม",
    content: "รวมซอฟต์แวร์คุณภาพจากทั่วโลกไว้ที่เดียว ทั้ง PG Soft, Pragmatic Play และ JOKER Gaming ภาพกราฟิกคมชัดและตอบสนองไว สลับค่ายได้ต่อเนื่องโดยไม่เจอปัญหาภาพค้างหรือระบบหน่วง",
    avatar: "🎨",
  },
  {
    name: "สมาชิกที่ให้ความสำคัญกับความเสถียร",
    role: "ใช้งานต่อเนื่องในช่วงคนเล่นหนาแน่น",
    stars: 5,
    tag: "ระบบเสถียรขั้นสุด",
    content: "สถาปัตยกรรมบน Cloud Server ทำให้การเชื่อมต่อราบรื่นทุกวินาที ต่อให้มีผู้ใช้งานพร้อมกันจำนวนมาก การทำงานก็ยังลื่นไหลและรักษาประสิทธิภาพไว้ได้ ไม่มีหลุดหรือกระตุกระหว่างเล่น",
    avatar: "⚡",
  },
  {
    name: "สมาชิกใหม่ที่เพิ่งเริ่มใช้งาน",
    role: "สมัครและกดรับสิทธิ์ด้วยตนเอง",
    stars: 5,
    tag: "สมัครง่าย และโปรโมชั่น",
    content: "ขั้นตอนสมัครจบในไม่กี่ขั้นตอนก็เข้าถึงแดชบอร์ดส่วนตัวได้ทันที โบนัสและแคมเปญกดรับเองได้ผ่านระบบอัตโนมัติ ไม่มีเงื่อนไขแอบแฝง ใช้งานได้สมบูรณ์ทั้งบน iOS และ Android",
    avatar: "🐰",
  },
];

const totalStars = reviews.reduce((sum, r) => sum + r.stars, 0);
const average = (totalStars / reviews.length).toFixed(1);
---

<section class="relative z-10 mx-auto mb-12 w-full max-w-[1400px] px-4 font-sans">
  <div class="mb-8 flex w-full flex-col items-center justify-center gap-2 text-center">
    <p class="bg-gradient-to-r from-white via-pink-100 to-pink-400 bg-clip-text text-3xl font-black tracking-widest text-transparent uppercase drop-shadow-[0_2px_10px_rgba(236,72,153,0.35)]">
      เสียงจาก <span class="text-pink-200">สมาชิก BUNNY555</span>
    </p>
    <div class="mt-2 h-[4px] w-24 rounded-full bg-gradient-to-r from-transparent via-pink-400 to-transparent"></div>
  </div>

  <div class="mx-auto mb-8 flex max-w-md items-center justify-center gap-5 rounded-2xl border border-pink-400/30 bg-[#1c0b12]/80 px-6 py-4 shadow-[0_10px_30px_rgba(236,72,153,0.22)] backdrop-blur-xl">
    <div class="flex flex-col items-center">
      <span class="bg-gradient-to-b from-white to-[#ec4899] bg-clip-text text-4xl leading-none font-black text-transparent">{average}</span>
      <span class="mt-1 text-[10px] font-bold tracking-widest text-pink-100/60 uppercase">คะแนนเฉลี่ย</span>
    </div>
    <div class="h-12 w-px bg-pink-400/25"></div>
    <div class="flex flex-col gap-1.5">
      <div class="flex gap-1 text-lg">
        {Array.from({ length: 5 }).map((_, i) => <span class={i < Math.round(Number(average)) ? "text-pink-300 drop-shadow-[0_0_6px_rgba(236,72,153,0.7)]" : "text-rose-900/70"}>★</span>)}
      </div>
      <span class="text-xs font-bold text-pink-100/70">จากการใช้งานจริงของสมาชิก {reviews.length} ด้าน</span>
    </div>
  </div>

  <div class="grid grid-cols-1 gap-6 md:grid-cols-3">
    {
      reviews.map((review) => (
        <article class="group relative isolate flex flex-col gap-4 overflow-hidden rounded-2xl border border-pink-400/25 bg-[#1c0b12]/80 p-6 text-left shadow-[0_10px_30px_rgba(0,0,0,0.6)] backdrop-blur-xl transition-all duration-300 hover:-translate-y-1 hover:border-pink-300/50 hover:shadow-[0_18px_40px_rgba(236,72,153,0.3)]">
          <span class="absolute inset-y-0 left-0 -z-10 w-1 bg-gradient-to-b from-[#fbcfe8] via-[#ec4899] to-[#881337] opacity-70 transition-opacity duration-300 group-hover:opacity-100" />
          <span class="pointer-events-none absolute -top-14 -right-14 -z-10 h-32 w-32 rounded-full bg-rose-600/25 blur-[50px] transition-all duration-300 group-hover:bg-pink-500/20" />

          <div class="flex items-center justify-between gap-3">
            <span class="inline-flex items-center gap-1.5 rounded-full border border-pink-300/35 bg-pink-300/10 px-3 py-1 text-[10px] font-bold tracking-widest text-pink-200 uppercase">
              <span class="h-1.5 w-1.5 animate-pulse rounded-full bg-pink-300" />
              {review.tag}
            </span>
            <div class="flex gap-0.5 text-sm">
              {Array.from({ length: 5 }).map((_, i) => (
                <span class={i < review.stars ? "text-pink-300 drop-shadow-[0_0_5px_rgba(236,72,153,0.7)]" : "text-rose-900/70"}>★</span>
              ))}
            </div>
          </div>

          <p class="text-base leading-relaxed text-pink-50/85">{review.content}</p>

          <div class="mt-auto flex items-center gap-3 border-t border-pink-400/20 pt-4">
            <span class="flex h-11 w-11 shrink-0 items-center justify-center rounded-xl border border-pink-300/30 bg-gradient-to-br from-[#881337] to-[#0a0305] text-xl shadow-inner transition-transform duration-300 group-hover:scale-110">
              {review.avatar}
            </span>
            <span class="flex flex-col">
              <span class="text-sm font-black text-white transition-colors group-hover:text-pink-200">{review.name}</span>
              <span class="text-[10px] font-bold tracking-wider text-pink-200/60 uppercase">{review.role}</span>
            </span>
          </div>
        </article>
      ))
    }
  </div>
</section>
<style>
  .font-sans {
    font-family: var(--font-sans);
  }
</style>
