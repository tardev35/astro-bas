---
import MainLayout from "../layouts/MainLayout.astro";
import Announcement from "../components/AnnouncementCyber.astro";
import ContentBox from "../components/ContentBox.astro";
import ContentBoxCyberCut from "../components/ContentBoxCyberCut.astro";
import ContentBoxFloatingBadge from "../components/ContentBoxFloatingBadge.astro";
import ContentBoxSevenThreeCyberCut from "../components/ContentBoxSevenThreeCyberCut.astro";
import FeatureHighlights from "../components/FeatureHighlights.astro";
import LoginRtpSection from "../components/LoginRtpSection.astro";
import ProviderGrid from "../components/ProviderGrid.astro";
import GameRankingBoard from "../components/GameRankingBoard.astro";
import ReviewCardSumo2 from "../components/ReviewCardSumo2.astro";
import LatestWinners from "../components/LatestWinnersPremium.astro";
import SmoothCarousel from "../components/SmoothCarousel.astro";
import Faq from "../components/Faq4.astro";
import Navfoot from "../components/Navfoot.astro";

import { Picture } from "astro:assets";
import { pageGraph } from "../lib/schema";
import imgCashback from "../assets/slide1.png";

const pageTitle = "PGW44 สล็อตเว็บใหญ่ ระบบออโต้ไม่มีขั้นต่ำ โปรลุ้นรับรางวัลเยอะ";

// The docx supplies this sentence up to "ทุกวัน" (146 characters). The build
// gate in tools/verify-build.mjs requires 150–160 characters, so the factual
// tail below closes the four-character gap without altering the brief's wording.
const pageDescription =
  "PGW44 สล็อตเว็บใหญ่ อาณาจักรความบันเทิงที่มั่นคงที่สุด มอบอิสระด้วย ระบบออโต้ไม่มีขั้นต่ำ ลื่นไหล ปลอดภัย พร้อมจัดเต็ม โปรลุ้นรับรางวัลเยอะ ทุกวัน ตลอด 24 ชม.";

// Docx headings #3, #4 and #5 — the three provider sub-points that sit under
// heading #2. FeatureHighlights renders each `title` as an <h3>, which is the
// only place this page is allowed to have one.
const providerPoints = [
  {
    icon: "🐉",
    title: "PG Soft อาณาจักรแห่ง 3D แอนิเมชัน โบนัสแตกไว",
    description:
      "ส่งมอบความบันเทิงผ่านกราฟิกที่สวยงามสมจริง ผสานกับฟีเจอร์เกมที่ไหลลื่น ช่วยให้คุณเข้าถึงรอบโบนัสแจ็กพอตได้อย่างรวดเร็วและต่อเนื่อง",
    accent: "gold" as const,
  },
  {
    icon: "⚡",
    title: "Pragmatic Play แจกรางวัลรัว ฟีเจอร์ทันสมัย ตอบสนองฉับไว",
    description: "ตอบสนองนักลงทุนที่ชอบความรวดเร็ว ด้วยกลไกการออกรางวัลที่โปร่งใสและจ่ายผลตอบแทนก้อนโตได้อย่างสะใจในทุกจังหวะ",
    accent: "lime" as const,
  },
  {
    icon: "🔥",
    title: "Nolimit City ท้าทายทุกขีดจำกัด ตัวคูณมหาศาล",
    description: "ฉีกกฎเกณฑ์เดิมๆ ด้วยฟีเจอร์การเล่นที่ดุดันและเน้นการทวีคูณเงินรางวัลแบบก้าวกระโดด โหลดไว ไร้ปัญหาอาการค้าง",
    accent: "gold" as const,
  },
];

const faqs = [
  {
    q: "การใช้งานผ่าน ระบบออโต้ไม่มีขั้นต่ำ มีข้อดีอย่างไร?",
    a: "ช่วยให้ผู้ใช้งานแพลตฟอร์ม PGW44 สามารถบริหารทุนของตนเองได้อย่างอิสระ ไร้ข้อผูกมัด และประมวลผลรวดเร็วทันใจ",
  },
  {
    q: "ทำไมจึงควรเลือกใช้งานแพลตฟอร์ม สล็อตเว็บใหญ่ ?",
    a: "เพราะมีความมั่นคงทางการเงินสูง การันตีการจ่ายผลตอบแทนที่ยุติธรรม และมีเสถียรภาพในการให้บริการที่ยอดเยี่ยม",
  },
  {
    q: "เงื่อนไขการรับ โปรลุ้นรับรางวัลเยอะ ยุ่งยากหรือไม่?",
    a: "ไม่ยุ่งยาก สมาชิกสามารถกดยอมรับสิทธิพิเศษและโบนัสต่างๆ ได้ด้วยตนเองผ่านหน้าแดชบอร์ดอัตโนมัติ",
  },
  {
    q: "ข้อมูลส่วนบุคคลจะได้รับการปกป้องอย่างไร?",
    a: "ระบบใช้การเข้ารหัสฐานข้อมูลขั้นสูง ทำให้ทุกการเชื่อมต่อมีความ ลื่นไหล ปลอดภัย ป้องกันการเข้าถึงจากบุคคลภายนอก 100%",
  },
];

const graph = pageGraph(Astro, {
  name: pageTitle,
  description: pageDescription,
  faqs,
});
---

<MainLayout title={pageTitle} description={pageDescription}>
  <script type="application/ld+json" set:html={graph} />

  <Announcement
    message="PGW44 สล็อตเว็บใหญ่ ศูนย์รวมค่ายเกมระดับโลก PG Soft Pragmatic Play Nolimit City • ระบบออโต้ไม่มีขั้นต่ำ ฝาก-ถอนเสร็จในไม่กี่วินาที • โปรลุ้นรับรางวัลเยอะ แจกหนักทุกวัน คืนยอดเสีย 15% • ปลอดภัย 100% ผ่าน Secure Transition Popup • ตรวจเงื่อนไขทุกครั้งก่อนกดรับสิทธิ์"
  />

  <ContentBoxCyberCut as="h1" title="PGW44 สล็อตเว็บใหญ่ ระบบออโต้ไม่มีขั้นต่ำ โปรลุ้นรับรางวัลเยอะ">
    <p class="text-left text-base leading-relaxed text-[#e8efd8]">
      <strong class="text-[#ffd54a]">PGW44</strong> สล็อตเว็บใหญ่ ที่ถูกสร้างขึ้นมาเพื่อรองรับผู้เล่นทุกระดับด้วยมาตรฐานความมั่นคงระดับสากล เราพร้อมมอบอิสระทางการเงินอย่างแท้จริงผ่านเทคโนโลยี ระบบออโต้ไม่มีขั้นต่ำ
      ที่ประมวลผลได้อย่างรวดเร็วและแม่นยำ ทุกการเชื่อมต่อของคุณจะเต็มไปด้วยความลื่นไหล ปลอดภัยขั้นสุด พร้อมยกระดับความคุ้มค่าด้วยแคมเปญและ โปรลุ้นรับรางวัลเยอะ ที่จัดเตรียมไว้ซัพพอร์ตสมาชิกเพื่อต่อยอดผลกำไรในทุกๆ วัน
    </p>
  </ContentBoxCyberCut>

  <ContentBoxFloatingBadge as="h2" title="PGW44 สล็อตเว็บใหญ่ ศูนย์รวมค่ายเกมระดับโลก ลื่นไหล">
    <p class="text-left text-base leading-relaxed text-[#e8efd8]">
      อาณาจักรของ PGW44 ถูกออกแบบมาเพื่อเป็นศูนย์กลางของซอฟต์แวร์คุณภาพเยี่ยม โดยเราได้เชื่อมต่อกับผู้พัฒนาชั้นนำเพื่อนำเสนอประสบการณ์ที่สมบูรณ์แบบที่สุด ทุกเกมบนระบบผ่านการตรวจสอบเสถียรภาพ
      เพื่อให้กราฟิกแสดงผลได้คมชัดและมีอัตราการจ่ายที่ยุติธรรม ตอบโจทย์นักลงทุนที่ต้องการความมั่นใจในทุกการกดสปิน
    </p>
    <FeatureHighlights items={providerPoints} />
  </ContentBoxFloatingBadge>

  <ProviderGrid />

  <GameRankingBoard />

  <ContentBox as="h2" title="PGW44 ขับเคลื่อนด้วย ระบบออโต้ไม่มีขั้นต่ำ รวดเร็วที่สุด">
    <p class="text-left text-base leading-relaxed text-[#e8efd8]">
      สัมผัสนวัตกรรมการเงินที่ล้ำหน้าไปอีกขั้นบนระบบของ PGW44 ด้วยสถาปัตยกรรมการประมวลผลที่ให้คุณจัดการงบประมาณได้อย่างอิสระเสรี การทำธุรกรรมทั้งหมดทำงานผ่าน AI อัจฉริยะที่ช่วยตัดความซับซ้อนออกไป
      มอบความคล่องตัวแบบไม่มีเงื่อนไขผูกมัด ไม่ว่าจะเป็นยอดฝากหรือถอนก็สามารถดำเนินการเสร็จสิ้นภายในไม่กี่วินาทีอย่างแม่นยำ
    </p>
  </ContentBox>

  <LoginRtpSection />

  <LatestWinners />

  <ContentBoxSevenThreeCyberCut titleright="โปรลุ้นรับรางวัลเยอะ แจกหนักทุกวัน รับความคุ้มค่าเต็มพิกัด">
    <Picture
      slot="left"
      src={imgCashback}
      loading="lazy"
      fetchpriority="low"
      widths={[200, 400, 600]}
      sizes="(max-width: 768px) 100vw, 30vw"
      decoding="async"
      formats={["avif", "webp"]}
      fallbackFormat="webp"
      quality={80}
      alt="แบนเนอร์โปรโมชั่น PGW44 คืนยอดเสีย 15% เสียเท่าไหร่ เราคืนให้! พร้อมข้อความ เล่นได้ทุกเกม สล็อต บาคาร่า ยิงปลา มั่นคง ปลอดภัย มาตรฐานระดับสากล และ ฝาก-ถอน AUTO รวดเร็ว ทันใจ 10 วินาที"
      class="mx-auto h-auto w-full rounded-2xl border border-[#ecab03]/30 shadow-[0_10px_30px_rgba(236,171,3,0.20)]"
    />
    <p slot="right" class="text-left text-base leading-relaxed text-[#e8efd8]">
      เพื่อเป็นการตอบแทนความไว้วางใจ ทางทีมงาน PGW44 ได้จัดเตรียมสิทธิพิเศษมากมายเพื่อเป็นทุนต่อยอดความสำเร็จให้กับสมาชิกทุกคน ไม่ว่าจะเป็นโบนัสต้อนรับหรือแคมเปญประจำวัน
      คุณสามารถกดรับสิทธิ์เพื่อเพิ่มโอกาสในการทำกำไรได้อย่างง่ายดาย กิจกรรมต่างๆ ถูกออกแบบมาให้เข้าร่วมง่ายและแจกจริง เพื่อให้คุณกวาดผลตอบแทนกลับไปได้มากที่สุด
    </p>
  </ContentBoxSevenThreeCyberCut>

  <SmoothCarousel />

  <ContentBoxCyberCut as="h2" title="PGW44 บริการพรีเมียม ปลอดภัย 100% ผ่าน Secure Popup">
    <p class="text-left text-base leading-relaxed text-[#e8efd8]">
      ความปลอดภัยคือเสาหลักที่ PGW44 ให้ความสำคัญสูงสุด ฐานข้อมูลและการเชื่อมต่อทั้งหมดถูกเข้ารหัสด้วยเทคโนโลยีที่เทียบเท่าสถาบันการเงิน นอกจากนี้ การเข้าสู่แดชบอร์ดส่วนตัวจะแสดงผลผ่าน Secure Transition Popup
      Modal ที่ถูกออกแบบมาเพื่อป้องกันการรีเฟรชหน้าเว็บซ้ำซ้อน ทำให้การใช้งานลื่นไหลและปกป้องข้อมูลของคุณให้เป็นความลับในทุกมิติ
    </p>
  </ContentBoxCyberCut>

  <div class="relative z-10 mx-auto mb-10 flex flex-nowrap justify-center gap-3 px-4 sm:gap-6">
    <a
      href="/login"
      class="group relative flex flex-1 items-center justify-center rounded-full bg-gradient-to-r from-[#ffd54a] via-[#ecab03] to-[#a9760a] px-4 py-3 text-sm font-black whitespace-nowrap text-[#0a0f06] shadow-[0_10px_30px_rgba(236,171,3,0.28)] transition-all duration-300 hover:-translate-y-1 hover:scale-105 hover:shadow-[0_15px_40px_rgba(236,171,3,0.42)] sm:flex-none sm:px-10 sm:py-3.5 sm:text-base">
      เข้าสู่ระบบ
    </a>

    <a
      href="/register"
      class="group relative flex flex-1 items-center justify-center rounded-full border border-[#4a8d14]/70 bg-[#111a0a]/85 px-4 py-3 text-sm font-black whitespace-nowrap text-[#b9c4a6] backdrop-blur-sm transition-all duration-300 hover:scale-105 hover:border-[#8fd633] hover:bg-[#1a2610]/85 hover:shadow-[0_15px_40px_rgba(143,214,51,0.35)] sm:flex-none sm:px-10 sm:py-3.5 sm:text-base">
      สมัครสมาชิก
    </a>
  </div>

  <Faq title="FAQ คำถามที่พบบ่อย เกี่ยวกับ PGW44 สล็อตเว็บใหญ่" faqs={faqs} />

  <ReviewCardSumo2 />

  <Navfoot />
</MainLayout>
