---
import MainLayout from "../layouts/MainLayout.astro";
import Announcement from "../components/AnnouncementPremium.astro";
import ContentBox from "../components/ContentBox.astro";
import ContentBoxPremium from "../components/ContentBoxPremium.astro";
import ContentBoxNeumorphism from "../components/ContentBoxNeumorphism.astro";
import ContentBoxSpecial from "../components/ContentBoxSpecial.astro";
import ContentBoxSevenThreePremium from "../components/ContentBoxSevenThreePremium.astro";
import FeatureHighlights from "../components/FeatureHighlights.astro";
import LoginRtpSection from "../components/LoginRtpSection.astro";
import ProviderGrid from "../components/ProviderGrid.astro";
import GameRankingBoard from "../components/GameRankingBoard.astro";
import ReviewCardSumo2 from "../components/ReviewCardSumo2.astro";
import LatestWinners from "../components/LatestWinnersCyber.astro";
import SmoothCarousel from "../components/SmoothCarousel.astro";
import Faq from "../components/Faq2.astro";
import Navfoot from "../components/Navfoot.astro";

import { Picture } from "astro:assets";
import { pageGraph } from "../lib/schema";
import imgFirstDeposit from "../assets/slide2.png";
import imgCashback from "../assets/slide1.png";

const pageTitle = "TUNJAI123 เว็บตรงอันดับ 1 ลิขสิทธิ์แท้ จ่ายจริง รวมทุกค่ายในเว็ปเดียว";

// The docx meta stops at "ปลอดภัยขั้นสุด" (143 characters). tools/verify-build.mjs
// requires 150–160, so the brief's wording is kept verbatim and a short factual
// tail closes the gap.
const pageDescription =
  "TUNJAI123 เว็บตรงอันดับ 1 ลิขสิทธิ์แท้ 100% สัมผัสความรวดเร็วดั่งใจนึก ศูนย์ รวมทุกค่ายในเว็ปเดียว มั่นคง การันตี จ่ายจริง โอนไว ปลอดภัยขั้นสุด ตลอด 24 ชม.";

// The three provider sub-points that sit under docx heading #2.
// FeatureHighlights renders each `title` as an <h3>, which is the only place
// this page is allowed to have one.
const providerPoints = [
  {
    icon: "🐉",
    title: "PG Soft กราฟิกเหนือชั้น แอนิเมชันสมจริง โบนัสแตกไว",
    description:
      "ส่งมอบความบันเทิงผ่านเทคโนโลยี 3D ที่ตอบสนองฉับไว ฟีเจอร์ตัวคูณและฟรีสปินถูกออกแบบมาให้ผู้เล่นกอบโกยผลตอบแทนได้อย่างรวดเร็ว",
    accent: "gold" as const,
  },
  {
    icon: "⚡",
    title: "Pragmatic Play ฟีเจอร์ทันสมัย แจกรางวัลรัว ไม่มีสะดุด",
    description: "เอาใจสายทำกำไรด้วยระบบเกมเพลย์ที่รวดเร็วและทรงพลัง สปินแต่ละรอบเต็มไปด้วยโอกาสลุ้นแจ็กพอตก้อนโตที่พร้อมแตกตลอดเวลา",
    accent: "silver" as const,
  },
  {
    icon: "👑",
    title: "JILI เอฟเฟกต์อลังการ ทำกำไรทะลุพิกัด รองรับทุกอุปกรณ์",
    description: "นวัตกรรมเกมที่พัฒนามาเพื่อความเบาและเสถียร เข้าใช้งานได้อย่างสมูทบนสมาร์ทโฟน ช่วยให้คุณต่อยอดทุนได้อย่างไร้ข้อจำกัด",
    accent: "gold" as const,
  },
];

const faqs = [
  {
    q: "ทำไมแพลตฟอร์มนี้ถึงเป็น เว็บตรงอันดับ 1 ที่ได้รับความนิยม?",
    a: "เพราะเราคือศูนย์ รวมทุกค่ายในเว็ปเดียว ที่ให้บริการด้วย ลิขสิทธิ์แท้ 100% มีความมั่นคง และเชื่อถือได้ในทุกการใช้งาน",
  },
  {
    q: "ระบบการฝากถอนเงินของ TUNJAI123 มีความเร็วระดับไหน?",
    a: "ขับเคลื่อนด้วยระบบออโต้ที่ให้ความรวดเร็วดั่งใจนึก โอนไว และปรับยอดเครดิตสำเร็จภายในเวลาเพียงไม่กี่วินาที",
  },
  {
    q: "หากทำกำไรได้ยอดใหญ่ แพลตฟอร์มจะ จ่ายจริง หรือไม่?",
    a: "การันตี จ่ายจริง ทุกยอดบิล ไม่ว่ายอดจะสูงแค่ไหน ทางระบบก็พร้อมโอนให้คุณเต็มจำนวนอย่างไร้เงื่อนไข",
  },
  {
    q: "ข้อมูลส่วนตัวของผู้ใช้งานจะ ปลอดภัยขั้นสุด ได้อย่างไร?",
    a: "เราใช้เทคโนโลยีปกป้องข้อมูลระดับองค์กร และเข้าใช้งานผ่าน Secure Popup Loader เพื่อความปลอดภัยและเป็นส่วนตัวสูงสุด",
  },
];

const graph = pageGraph(Astro, {
  name: pageTitle,
  description: pageDescription,
  faqs,
});
---

<MainLayout title={pageTitle} description={pageDescription}>
  <script type="application/ld+json" set:html={graph} />

  <Announcement />

  <ContentBoxPremium as="h1" title="TUNJAI123 เว็บตรงอันดับ 1 ลิขสิทธิ์แท้ จ่ายจริง รวมทุกค่ายในเว็ปเดียว">
    <p class="text-left text-base leading-relaxed text-[#ece3cf]">
      <strong class="text-[#f5eb8b]">TUNJAI123</strong> เว็บตรงอันดับ 1 ลิขสิทธิ์แท้ ที่ออกแบบระบบโครงสร้างมาเพื่อตอบสนองความต้องการของผู้เล่นยุคใหม่ สัมผัสประสบการณ์ความสนุกแบบไร้รอยต่อและมีความรวดเร็วดั่งใจนึก
      แพลตฟอร์มของเรามีความมั่นคงสูง การันตี จ่ายจริง ทุกยอดการทำรายการ พร้อมเปิดศูนย์ รวมทุกค่ายในเว็ปเดียว ให้คุณเข้าถึงความบันเทิงระดับโกลบอลได้อย่างปลอดภัยขั้นสุดในทุกๆ คลิก
    </p>
  </ContentBoxPremium>

  <ContentBoxNeumorphism as="h2" title="TUNJAI123 ศูนย์ รวมทุกค่ายในเว็ปเดียว ลิขสิทธิ์แท้ 100%">
    <p class="text-left text-base leading-relaxed text-[#ece3cf]">
      เพื่อความสะดวกสบายสูงสุด แพลตฟอร์ม TUNJAI123 ได้ทำการเชื่อมต่อ API ลิขสิทธิ์แท้จากผู้พัฒนาซอฟต์แวร์ระดับโลกมาไว้ในที่เดียวจบ คุณจะไม่ต้องเสียเวลาย้ายเงินหรือสลับบัญชีให้ยุ่งยากอีกต่อไป
      ทุกเกมบนระบบผ่านการตรวจสอบมาตรฐานความโปร่งใส มอบอัตราการจ่ายรางวัลที่ยุติธรรมและภาพกราฟิกที่ไหลลื่นที่สุด
    </p>
    <FeatureHighlights items={providerPoints} />
  </ContentBoxNeumorphism>

  <ProviderGrid />

  <ContentBoxSevenThreePremium titleright="เทคโนโลยีออโต้สุดล้ำ สัมผัสความรวดเร็วดั่งใจนึก โอนไว">
    <Picture
      slot="left"
      src={imgFirstDeposit}
      loading="lazy"
      fetchpriority="low"
      widths={[200, 400, 600]}
      sizes="(max-width: 768px) 100vw, 30vw"
      decoding="async"
      formats={["avif", "webp"]}
      fallbackFormat="webp"
      quality={80}
      alt="แบนเนอร์โปรโมชั่น TUNJAI123 ฝากแรก ลุ้นรับทอง 1 บาท ง่ายๆ เพียงฝากครั้งแรกก็มีสิทธิ์ลุ้น พร้อมข้อความ ลุ้นรับทอง 1 บาท ทุกยอดฝากแรก โปรดีๆ จัดเต็มเฉพาะสมาชิกใหม่ มั่นคงปลอดภัย เชื่อถือได้ 100% และ ฝาก-ถอนรวดเร็ว ทันใจ 24 ชั่วโมง"
      class="mx-auto h-auto w-full rounded-2xl border border-[#dab563]/30 shadow-[0_10px_30px_rgba(218,181,99,0.20)]"
    />
    <p slot="right" class="text-left text-base leading-relaxed text-[#ece3cf]">
      หัวใจสำคัญที่ทำให้ระบบของเราเหนือกว่าคือความไวระดับเสี้ยววินาที เมื่อคุณทำธุรกรรมทางการเงิน เทคโนโลยี AI อัจฉริยะจะทำการตรวจสอบและปรับยอดเครดิตให้คุณโดยอัตโนมัติ ไม่ต้องส่งสลิปหรือรอการยืนยันให้เสียเวลา
      มอบอิสระทางการเงินที่คล่องตัวและตอบโจทย์ไลฟ์สไตล์ของคนที่รักความเร็วอย่างแท้จริง
    </p>
  </ContentBoxSevenThreePremium>

  <ContentBoxSevenThreePremium titleright="TUNJAI123 เว็บตรงอันดับ 1 การันตี จ่ายจริง ไม่มีกั๊ก">
    <Picture
      slot="left"
      src={imgCashback}
      loading="lazy"
      fetchpriority="low"
      widths={[200, 400, 600]}
      sizes="(max-width: 768px) 100vw, 30vw"
      decoding="async"
      formats={["avif", "webp"]}
      fallbackFormat="webp"
      quality={80}
      alt="แบนเนอร์โปรโมชั่น TUNJAI123 คืนยอดเสีย 15% เสียเท่าไหร่ เราคืนให้มากกว่าเดิม รับคืนทุกยอดเสีย ไม่มีเงื่อนไข พร้อมข้อความ มั่นคง ปลอดภัย มาตรฐานสากล ฝาก-ถอน ออโต้ รวดเร็วทันใจ โบนัสจัดเต็มทุกวัน และบริการลูกค้าตลอด 24 ชั่วโมง"
      class="mx-auto h-auto w-full rounded-2xl border border-[#dab563]/30 shadow-[0_10px_30px_rgba(218,181,99,0.20)]"
    />
    <p slot="right" class="text-left text-base leading-relaxed text-[#ece3cf]">
      รากฐานของความน่าเชื่อถือคือสภาพคล่องทางการเงินที่แข็งแกร่ง สมาชิกของ TUNJAI123 สามารถวางใจได้เลยว่าทุกความสำเร็จของคุณจะได้รับผลตอบแทนอย่างเต็มเม็ดเต็มหน่วย ไม่ว่าคุณจะทำกำไรได้ในระดับใด
      ระบบก็พร้อมโอนไวและจ่ายจริงครบถ้วนทุกบิล โดยไม่มีการหักค่าธรรมเนียมหรือเปอร์เซ็นต์แอบแฝง
    </p>
  </ContentBoxSevenThreePremium>

  <LatestWinners />

  <ContentBox as="h2" title="TUNJAI123 มั่นคง ปลอดภัยขั้นสุด ผ่านระบบ Premium Popup">
    <p class="text-left text-base leading-relaxed text-[#ece3cf]">
      เรื่องความปลอดภัยของข้อมูลคือสิ่งที่เราให้ความสำคัญเป็นลำดับต้นๆ ฐานข้อมูลทั้งหมดของ TUNJAI123 ถูกเข้ารหัสด้วยเทคโนโลยีความปลอดภัยขั้นสูง นอกจากนี้ การเชื่อมต่อเข้าสู่แดชบอร์ดส่วนตัวจะแสดงผลผ่าน Premium
      Loader ในรูปแบบ Secure Transition Popup ซึ่งช่วยป้องกันการโหลดเว็บซ้ำซ้อนและรักษาความเป็นส่วนตัวของคุณให้ปลอดภัย 100%
    </p>
  </ContentBox>

  <Faq title="FAQ คำถามที่พบบ่อย เกี่ยวกับ TUNJAI123 เว็บตรงอันดับ 1" faqs={faqs} />

  <LoginRtpSection />

  <GameRankingBoard />

  <SmoothCarousel />

  <ContentBoxSpecial label="เข้าสู่ระบบและสมัครสมาชิก TUNJAI123">
    <div slot="left" class="flex flex-col gap-3">
      <p class="text-base font-black tracking-wide text-[#f5eb8b]">เข้าสู่ระบบสมาชิกเดิม</p>
      <p class="text-left text-base leading-relaxed text-[#ece3cf]">
        เข้าแดชบอร์ดส่วนตัวผ่าน Secure Transition Popup เพื่อจัดการยอดฝากถอน เลือกค่ายเกม และกดรับสิทธิพิเศษได้จากจุดเดียว
      </p>
      <a
        href="/login"
        class="mt-1 inline-flex items-center justify-center rounded-full bg-gradient-to-r from-[#f5eb8b] via-[#dab563] to-[#a97f28] px-8 py-3 text-sm font-black whitespace-nowrap text-[#120c04] shadow-[0_10px_30px_rgba(218,181,99,0.28)] transition-all duration-300 hover:-translate-y-1 hover:scale-105 hover:shadow-[0_15px_40px_rgba(218,181,99,0.42)] sm:text-base">
        เข้าสู่ระบบ
      </a>
    </div>

    <div slot="right" class="flex flex-col gap-3">
      <p class="text-base font-black tracking-wide text-[#dfe4e7]">สมัครสมาชิกใหม่</p>
      <p class="text-left text-base leading-relaxed text-[#ece3cf]">
        เปิดบัญชีเดียวใช้ได้ครบทุกค่ายลิขสิทธิ์แท้ พร้อมรับสิทธิ์ฝากแรกลุ้นรับทอง 1 บาท และคืนยอดเสีย 15% ตามเงื่อนไขของแต่ละแคมเปญ
      </p>
      <a
        href="/register"
        class="mt-1 inline-flex items-center justify-center rounded-full border border-[#dfe4e7]/60 bg-[#1a1510]/85 px-8 py-3 text-sm font-black whitespace-nowrap text-[#dfe4e7] backdrop-blur-sm transition-all duration-300 hover:scale-105 hover:border-[#dfe4e7] hover:bg-[#100d08]/85 hover:shadow-[0_15px_40px_rgba(223,228,231,0.28)] sm:text-base">
        สมัครสมาชิก
      </a>
    </div>
  </ContentBoxSpecial>

  <ReviewCardSumo2 />

  <Navfoot />
</MainLayout>
