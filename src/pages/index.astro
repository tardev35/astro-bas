---
import MainLayout from "../layouts/MainLayout.astro";
import Announcement from "../components/Announcement5.astro";
import ContentBox from "../components/ContentBox.astro";
import ContentBoxPremium from "../components/ContentBoxPremium.astro";
import ContentBoxNeumorphism from "../components/ContentBoxNeumorphism.astro";
import ContentBoxSevenThreePremium from "../components/ContentBoxSevenThreePremium.astro";
import ContentBoxSevenThreeNeumorphism from "../components/ContentBoxSevenThreeNeumorphism.astro";
import FeatureHighlights from "../components/FeatureHighlights.astro";
import LoginRtpSection from "../components/LoginRtpSection.astro";
import ProviderGrid from "../components/ProviderGrid.astro";
import GameRankingBoard from "../components/GameRankingBoard.astro";
import ReviewCardSumo2 from "../components/ReviewCardSumo2.astro";
import LatestWinners from "../components/LatestWinnersPremium.astro";
import SmoothCarousel from "../components/SmoothCarousel.astro";
import Faq from "../components/Faq4.astro";
import Navfoot from "../components/Navfoot.astro";

import { Picture } from "astro:assets";
import { orderForBrand } from "../lib/brandProfile";
import imgStability from "../assets/slide2.png";
import imgPromotion from "../assets/slide1.png";

const currentPath = Astro.url.pathname;
const homePage = Astro.url.origin;
const logoUrl = homePage + "/logo.webp";

const pageTitle = "BUNNY555 เว็บตรงอันดับ 1 ระบบเสถียร สมัครง่าย รับโปรโมชั่นสุดคุ้ม";
const pageDescription = "BUNNY555 เว็บตรงอันดับ 1 ก้าวกระโดดสู่ความมั่งคั่ง ขับเคลื่อนด้วย ระบบเสถียร ขั้นสุด ลื่นไหล สมัครง่าย ในคลิกเดียว พร้อมสิทธิ์ รับโปรโมชั่นสุดคุ้ม";

const providerHighlights = [
  {
    icon: "🎨",
    title: "PG Soft แอนิเมชันลื่นไหล กราฟิกสดใส โบนัสแตกไว",
    description: "ค่ายซอฟต์แวร์ที่โดดเด่นด้านการออกแบบภาพ 3D ที่ดูมีชีวิตชีวาและไหลลื่น เข้ากับความคล่องตัวของระบบเราได้อย่างไร้ที่ติ รอบโบนัสออกแบบมาให้ก้าวเข้าสู่รางวัลใหญ่ได้อย่างรวดเร็ว",
    accent: "pink" as const,
  },
  {
    icon: "⚡",
    title: "Pragmatic Play แจกรางวัลรัว ฟีเจอร์ทันสมัย ตอบสนองฉับไว",
    description: "ส่งมอบประสบการณ์ความสนุกที่เน้นผลลัพธ์รวดเร็ว กลไกการจ่ายเงินถูกเซ็ตมาให้มีความยุติธรรมและออกรางวัลอย่างต่อเนื่อง สร้างความตื่นเต้นในทุกจังหวะของการประมวลผล",
    accent: "rose" as const,
  },
  {
    icon: "🃏",
    title: "JOKER Gaming นวัตกรรมคลาสสิก อัปเกรดใหม่ ไหลลื่นทุกอุปกรณ์",
    description: "ผสานความคลาสสิกเข้ากับเทคโนโลยีสมัยใหม่ โดดเด่นด้านเสถียรภาพของเซิร์ฟเวอร์ที่รองรับการใช้งานหนักๆ ได้สบาย ให้คุณเก็บเกี่ยวผลตอบแทนได้อย่างไร้ขีดจำกัด",
    accent: "pink" as const,
  },
];

const faqs = [
  {
    q: "การเริ่มต้นใช้งานบนแพลตฟอร์มนี้มีความรวดเร็วแค่ไหน?",
    a: "ระบบของเราออกแบบมาให้ สมัครง่าย ใช้เวลาเพียงไม่กี่วินาที คุณก็สามารถล็อกอินเข้าสู่แดชบอร์ดเพื่อเริ่มต้นใช้งานได้ทันที",
  },
  {
    q: "ทำไม สล็อตเว็บตรง ถึงมีประสิทธิภาพการเชื่อมต่อที่ดีกว่า?",
    a: "เพราะเราใช้นวัตกรรมเซิร์ฟเวอร์ระดับโลก ทำให้ ระบบเสถียร ขั้นสุด ไร้ปัญหาการหลุดหรือกระตุกระหว่างการใช้งาน",
  },
  {
    q: "โบนัสและสิทธิพิเศษต่างๆ มีเงื่อนไขที่ซับซ้อนหรือไม่?",
    a: "ไม่มีเงื่อนไขแอบแฝง BUNNY555 ให้คุณ รับโปรโมชั่นสุดคุ้ม ได้ด้วยตนเองผ่านหน้าระบบออโต้ เพื่อความสะดวกและโปร่งใส",
  },
  {
    q: "มีการรองรับการใช้งานผ่านโทรศัพท์มือถือหรือไม่?",
    a: "แพลตฟอร์มรองรับทุกอุปกรณ์อย่างสมบูรณ์แบบ ทั้ง iOS และ Android ให้คุณทำกำไรได้อย่าง ลื่นไหล ในทุกที่ทุกเวลา",
  },
];

const webPageSchema = {
  "@context": "https://schema.org",
  "@type": "WebPage",
  name: "BUNNY555",
  description: pageDescription,
  url: homePage + currentPath,
};
const webSiteSchema = {
  "@context": "https://schema.org",
  "@type": "WebSite",
  name: "BUNNY555",
  alternateName: ["BUNNY555", "BUNNY555 เว็บตรงอันดับ 1 ระบบเสถียร สมัครง่าย รับโปรโมชั่นสุดคุ้ม"],
  url: "https://bunny555-game.com/",
};
const orgSchema = {
  "@context": "https://schema.org",
  "@type": "Organization",
  name: "BUNNY555",
  logo: logoUrl,
  url: homePage,
};
// Order carries no meaning to a JSON-LD parser, so it is varied per brand —
// every launch of this template used to emit these three in the same sequence.
const allSchemas = orderForBrand([webPageSchema, orgSchema, webSiteSchema], Astro.site, "jsonld");
---

<MainLayout title={pageTitle} description={pageDescription}>
  <script type="application/ld+json" set:html={JSON.stringify(allSchemas)} />

  <Announcement />

  <ContentBoxPremium as="h1" title="BUNNY555 เว็บตรงอันดับ 1 ระบบเสถียร สมัครง่าย รับโปรโมชั่นสุดคุ้ม">
    <p>
      ทะยานสู่เป้าหมายด้วยความรวดเร็วกับ <strong class="text-pink-200">BUNNY555</strong> เว็บตรงอันดับ 1 ที่พร้อมพาคุณก้าวกระโดดสู่ความมั่งคั่งอย่างเหนือระดับ
      นำเสนอเอกลักษณ์เฉพาะตัวผ่านงานดีไซน์ สะท้อนความคล่องตัวและพรีเมียมขั้นสุด เราพัฒนานวัตกรรมที่ทำให้ ระบบเสถียร ลื่นไหลไม่มีสะดุด มอบประสบการณ์ที่ สมัครง่าย ในคลิกเดียว
      พร้อมให้คุณกอบโกยความคุ้มค่าด้วยสิทธิ์ รับโปรโมชั่นสุดคุ้ม ตลอดการใช้งาน
    </p>
  </ContentBoxPremium>

  <ContentBox as="h2" title="BUNNY555 รวมค่ายเกมชั้นนำ ก้าวกระโดดสู่ความมั่งคั่ง ลื่นไหล">
    <div>
      <p>
        แพลตฟอร์มของเราถูกพัฒนามาเพื่อผู้ที่ชื่นชอบความปราดเปรียวและแม่นยำ ด้วยการรวบรวมซอฟต์แวร์คุณภาพจากทั่วโลกมาไว้ในที่เดียว ทุกการประมวลผลถูกปรับจูนให้ตอบสนองไวที่สุด
        ให้คุณเพลิดเพลินกับภาพกราฟิกคมชัดและโอกาสกวาดรางวัลที่รวดเร็วดั่งใจ ไม่ต้องเผชิญกับปัญหาภาพค้างหรือระบบหน่วงอีกต่อไป
      </p>
      <FeatureHighlights items={providerHighlights} />
    </div>
  </ContentBox>

  <ProviderGrid />

  <ContentBoxSevenThreePremium titleright="นวัตกรรม ระบบเสถียร ขั้นสุด ประมวลผลไว ไร้การสะดุด">
    <div slot="left" class="flex h-full flex-col justify-center">
      <Picture
        src={imgStability}
        loading="lazy"
        fetchpriority="low"
        widths={[200, 400, 600, 800]}
        sizes="(max-width: 768px) 100vw, 30vw"
        decoding="async"
        formats={["avif", "webp"]}
        fallbackFormat="webp"
        quality={80}
        alt="BUNNY555 นวัตกรรม Cloud Server ระบบเสถียรขั้นสุด ประมวลผลไว ไร้การสะดุด"
        class="mx-auto h-auto w-full rounded-2xl border-2 border-pink-400/40 shadow-[0_10px_30px_rgba(236,72,153,0.35)]"
      />
    </div>
    <p slot="right">
      สถาปัตยกรรมดิจิทัลของเราถูกสร้างขึ้นด้วยเทคโนโลยี Cloud Server ที่ทันสมัยที่สุด เพื่อให้การเชื่อมต่อทุกวินาทีเป็นไปอย่างราบรื่น ไม่ว่าจะมีผู้ใช้งานพร้อมกันมากเพียงใด
      การทำงานก็ยังคงลื่นไหลและรักษาประสิทธิภาพไว้ได้อย่างสมบูรณ์แบบ นี่คือความตั้งใจที่จะมอบประสบการณ์ที่ดีที่สุดให้แก่สมาชิกทุกคนที่ก้าวเข้ามา
    </p>
  </ContentBoxSevenThreePremium>

  <ContentBoxNeumorphism as="h2" title="สมัครง่าย ในคลิกเดียวกับ BUNNY555 สะดวกรวดเร็วที่สุด">
    <p>
      ลืมขั้นตอนการลงทะเบียนที่ยุ่งยากและเสียเวลาไปได้เลย เราได้นำเทคโนโลยี AI มาช่วยจัดการระบบฐานข้อมูล ทำให้การเริ่มต้นใช้งานเป็นเรื่องง่ายดาย
      เพียงไม่กี่ขั้นตอนคุณก็สามารถเข้าถึงแดชบอร์ดส่วนตัวได้ทันที ออกแบบมาเพื่อลดทอนความซับซ้อนและตอบโจทย์ไลฟ์สไตล์ของคนยุคใหม่ที่ต้องการความคล่องตัวขั้นสุดบนแพลตฟอร์มของ
      <strong class="text-pink-200">BUNNY555</strong>
    </p>
  </ContentBoxNeumorphism>

  <LoginRtpSection />

  <div class="mx-auto mb-10 flex flex-nowrap justify-center gap-3 px-4 sm:gap-6">
    <a
      href="/login"
      class="group relative flex flex-1 items-center justify-center rounded-full bg-gradient-to-r from-[#fce7f3] via-[#f9a8d4] to-[#db2777] px-4 py-3 text-sm font-black whitespace-nowrap text-[#241019] shadow-[0_5px_20px_rgba(236,72,153,0.45)] transition-all duration-300 hover:-translate-y-1 hover:scale-105 hover:shadow-[0_8px_25px_rgba(236,72,153,0.65)] sm:flex-none sm:px-10 sm:py-3.5 sm:text-base">
      เข้าสู่ระบบ
    </a>

    <a
      href="/register"
      class="group relative flex flex-1 items-center justify-center rounded-full border border-rose-400/60 bg-[#1c0b12]/80 px-4 py-3 text-sm font-black whitespace-nowrap text-pink-200 backdrop-blur-sm transition-all duration-300 hover:scale-105 hover:border-pink-300 hover:bg-[#3a1122] hover:shadow-[0_0_15px_rgba(190,24,93,0.55)] sm:flex-none sm:px-10 sm:py-3.5 sm:text-base">
      สมัครสมาชิก
    </a>
  </div>

  <ContentBoxSevenThreeNeumorphism titleright="BUNNY555 มอบสิทธิ์ รับโปรโมชั่นสุดคุ้ม ยกระดับความสำเร็จ">
    <div slot="left" class="flex h-full flex-col justify-center">
      <Picture
        src={imgPromotion}
        loading="lazy"
        fetchpriority="low"
        widths={[200, 400, 600, 800]}
        sizes="(max-width: 768px) 100vw, 30vw"
        decoding="async"
        formats={["avif", "webp"]}
        fallbackFormat="webp"
        quality={80}
        alt="BUNNY555 มอบสิทธิ์ รับโปรโมชั่นสุดคุ้ม ผ่านระบบอัตโนมัติ"
        class="mx-auto h-auto w-full rounded-2xl border-2 border-pink-400/40 shadow-[0_10px_30px_rgba(236,72,153,0.35)]"
      />
    </div>
    <p slot="right">
      นอกเหนือจากความรวดเร็วของระบบแล้ว เรายังเตรียมสิทธิพิเศษมากมายเพื่อเป็นทุนสนับสนุนให้คุณก้าวสู่เป้าหมายได้ไวขึ้น โบนัสและแคมเปญต่างๆ ถูกคำนวณมาอย่างดีเพื่อให้มีความคุ้มค่าสูงสุด
      คุณสามารถกดรับสิทธิ์ได้ด้วยตนเองผ่านระบบอัตโนมัติ เป็นการเพิ่มศักยภาพในการทำกำไรให้ทะยานสูงขึ้นไปอีกขั้นอย่างมั่นคง
    </p>
  </ContentBoxSevenThreeNeumorphism>

  <SmoothCarousel />

  <LatestWinners />

  <Faq title="คำถามที่พบบ่อยเกี่ยวกับ BUNNY555" faqs={faqs} />

  <GameRankingBoard />

  <ReviewCardSumo2 />

  <Navfoot />
</MainLayout>
