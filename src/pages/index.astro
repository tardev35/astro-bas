---
import MainLayout from "../layouts/MainLayout.astro";
import Announcement from "../components/Announcement5.astro";
import ContentBoxFloatingBadge from "../components/ContentBoxFloatingBadge.astro";
import ContentBox from "../components/ContentBox.astro";
import ContentBoxSevenThree from "../components/ContentBoxSevenThree.astro";
import ContentBoxSevenThreeNeumorphism from "../components/ContentBoxSevenThreeNeumorphism.astro";
import ContentBoxSpecial from "../components/ContentBoxSpecial.astro";
import ContentBoxTwo from "../components/ContentBoxTwo.astro";
import FeatureHighlights from "../components/FeatureHighlights.astro";
import LoginRtpSection from "../components/LoginRtpSection.astro";
import ProviderGrid from "../components/ProviderGrid.astro";
import GameRankingBoard from "../components/GameRankingBoard.astro";
import ReviewCardSumo2 from "../components/ReviewCardSumo2.astro";
import LatestWinners from "../components/LatestWinners3.astro";
import SmoothCarousel from "../components/SmoothCarousel.astro";
import Faq from "../components/Faq2.astro";
import Navfoot from "../components/Navfoot.astro";

import { Picture } from "astro:assets";
import { pageGraph } from "../lib/schema";
import imgCashback from "../assets/slide1.png";
import imgGoldBonus from "../assets/slide2.png";

const pageTitle = "BUNNY555 เว็บสล็อตลิขสิทธิ์แท้ เล่นง่าย ได้เงินไว บริการ 24 ชม.";

// 157 characters. The docx meta stops at "บริการ 24 ชม." and is 146 — below
// tools/verify-build.mjs's DESC_MIN of 150, which is a hard error. The brief's
// sentence is kept byte-identical and the trailing " ไม่มีวันหยุด" (a phrase the
// docx already uses in its FAQ answer) closes the gap.
const pageDescription =
  "BUNNY555 เว็บสล็อตลิขสิทธิ์แท้ 100% สัมผัสประสบการณ์ทำกำไรเหนือระดับ เล่นง่าย ทะยานสู่ความมั่งคั่ง ได้เงินไว ปลอดภัย พร้อมดูแลด้วย บริการ 24 ชม. ไม่มีวันหยุด";

// The three camp sub-points that sit under docx heading #2, in the docx's own
// order. FeatureHighlights renders each `title` as an <h3>, which is the only
// place this page is allowed to have one. Its accent union is "pink" | "gold".
const providerPoints = [
  {
    icon: "🧭",
    title: "Play'n GO ผจญภัยไร้ขีดจำกัด โบนัสแตกหนัก",
    description: "โดดเด่นด้วยเนื้อเรื่องที่น่าติดตามและกลไกการจ่ายเงินที่หลากหลาย สปินแต่ละรอบมอบโอกาสในการทำกำไรแบบก้าวกระโดดผ่านฟีเจอร์สุดล้ำ",
    accent: "pink" as const,
  },
  {
    icon: "🐯",
    title: "Red Tiger กราฟิกตระการตา ฟีเจอร์ตัวคูณสุดคุ้ม",
    description: "สัมผัสความอลังการของภาพแอนิเมชันที่ลื่นไหล มาพร้อมกับระบบแจ็กพอตที่แตกง่ายและแตกบ่อย ช่วยให้คุณกอบโกยผลตอบแทนได้อย่างรวดเร็ว",
    accent: "gold" as const,
  },
  {
    icon: "⚙️",
    title: "Blueprint Gaming กลไก Megaways ลุ้นกำไรทวีคูณ",
    description: "ค่ายเกมที่ขึ้นชื่อเรื่องเส้นทางการจ่ายเงินที่มหาศาล ระบบเสถียร โหลดไว ตอบโจทย์นักลงทุนที่ต้องการผลลัพธ์แบบฉับไวและคุ้มค่าที่สุด",
    accent: "pink" as const,
  },
];

const faqs = [
  {
    q: "ทำไมแพลตฟอร์มนี้จึงเป็น เว็บสล็อตลิขสิทธิ์แท้ ที่น่าลงทุน?",
    a: "เพราะ BUNNY555 เชื่อมต่อ API โดยตรงจากค่ายเกมระดับโลก มั่นใจได้ในความโปร่งใส ปลอดภัย และไม่ถูกปรับลดอัตราการชนะ",
  },
  {
    q: "ระบบการใช้งานที่บอกว่า เล่นง่าย เหมาะกับมือใหม่หรือไม่?",
    a: "เหมาะสมอย่างยิ่ง อินเทอร์เฟซบนแพลตฟอร์ม BUNNY555 ออกแบบเมนูต่างๆ ให้เข้าใจง่าย ไม่ซับซ้อน มือใหม่ก็ทำกำไรได้ทันที",
  },
  {
    q: "การทำรายการฝากและถอนที่ว่า ได้เงินไว ใช้เวลาเท่าไหร่?",
    a: "ดำเนินการผ่านระบบ AI อัจฉริยะ ทำให้ยอดเงินโอนเข้าบัญชีของ BUNNY555 สำเร็จภายในเวลาเพียงเสี้ยววินาทีเท่านั้น",
  },
  {
    q: "หากมีข้อสงสัย สามารถติดต่อรับ บริการ 24 ชม. ได้ทางไหน?",
    a: "สมาชิกสามารถติดต่อทีมงานของ BUNNY555 ได้โดยตรงผ่านช่องทางแชทบนหน้าเว็บ หรือ LINE Official ตลอดเวลา ไม่มีวันหยุด",
  },
];

const graph = pageGraph(Astro, {
  name: pageTitle,
  description: pageDescription,
  faqs,
});
---

<MainLayout title={pageTitle} description={pageDescription}>
  <script type="application/ld+json" set:html={graph} />

  <Announcement />

  <ContentBoxFloatingBadge as="h1" title="BUNNY555 เว็บสล็อตลิขสิทธิ์แท้ เล่นง่าย ได้เงินไว บริการ 24 ชม.">
    <p class="text-left text-base leading-relaxed text-[#ffdcea]">
      เปิดประสบการณ์การทำกำไรที่เหนือระดับไปกับ <strong class="text-[#fff0f6]">BUNNY555</strong> เว็บสล็อตลิขสิทธิ์แท้ ที่ออกแบบมาเพื่อตอบโจทย์ผู้เล่นทุกกลุ่มด้วยระบบที่ทันสมัย
      เรามุ่งเน้นการพัฒนารูปแบบการเดิมพันให้ เล่นง่าย ไม่ซับซ้อน เพื่อให้คุณก้าวสู่ความมั่งคั่งได้อย่างรวดเร็ว พร้อมมอบความมั่นใจด้วยระบบการจ่ายผลตอบแทนที่ ได้เงินไว แม่นยำ
      และมีทีมงานมืออาชีพคอยดูแลคุณผ่าน บริการ 24 ชม. ให้คุณอุ่นใจในทุกครั้งที่เข้ามาทำกำไร
    </p>
  </ContentBoxFloatingBadge>

  <ContentBox as="h2" title="BUNNY555 ศูนย์รวมค่ายเกมชั้นนำ เว็บสล็อตลิขสิทธิ์แท้">
    <p class="text-left text-base leading-relaxed text-[#ffdcea]">
      แพลตฟอร์มของเราคัดสรรเฉพาะซอฟต์แวร์เกมที่ได้มาตรฐานระดับสากล การันตีว่าทุกซอฟต์แวร์บน BUNNY555 มีความโปร่งใสและยุติธรรมสูงสุด มอบอัตราการจ่ายที่แม่นยำ
      พร้อมให้คุณสัมผัสกราฟิกที่ไหลลื่นและระบบที่ตอบสนองไวในทุกอุปกรณ์
    </p>
    <FeatureHighlights items={providerPoints} />
  </ContentBox>

  <ProviderGrid />

  <ContentBoxSevenThree titleright="สร้างกำไรง่ายๆ กับระบบของ BUNNY555 เล่นง่าย ทะลุขีดจำกัด">
    <Picture
      slot="left"
      src={imgCashback}
      loading="lazy"
      fetchpriority="low"
      widths={[200, 400, 600]}
      sizes="(max-width: 768px) 100vw, 30vw"
      decoding="async"
      formats={["avif", "webp"]}
      fallbackFormat="webp"
      quality={80}
      alt="แบนเนอร์โปรโมชั่น BUNNY555 คืนยอดเสีย 15% ตัวเลขสีขาวขอบชมพูบนพื้นดำโรยเหรียญทอง สาวชุดกระต่ายสีชมพูข้างตู้สล็อต JACKPOT ข้อความ เสียเท่าไหร่ เราคืนให้ 15% พร้อมไอคอนสี่ช่อง ระบบปลอดภัยมาตรฐานสากล คืนยอดเสียอัตโนมัติ เล่นได้ทุกเกมไม่จำกัด บริการลูกค้า 24 ชม. และแถบ เล่นสนุก มั่นใจ ได้เงินจริง"
      class="mx-auto h-auto w-full rounded-2xl border border-[#ff4d9d]/30 shadow-[0_10px_30px_rgba(255,77,157,0.22)]"
    />
    <p slot="right" class="text-left text-base leading-relaxed text-[#ffdcea]">
      ไม่ว่าคุณจะเป็นมือใหม่หรือมือโปร แพลตฟอร์มของ BUNNY555 ถูกออกแบบอินเทอร์เฟซมาให้ใช้งานได้อย่างเป็นมิตรและเป็นสัดส่วน ลดความซับซ้อนในทุกขั้นตอนของการเดิมพัน
      ช่วยให้คุณโฟกัสกับการกอบโกยรางวัลได้อย่างเต็มที่ ไร้อุปสรรคขัดขวาง
    </p>
  </ContentBoxSevenThree>

  <ContentBoxSevenThreeNeumorphism titleright="เทคโนโลยีออโต้สุดล้ำ การันตี ได้เงินไว ในเสี้ยววินาที">
    <Picture
      slot="left"
      src={imgGoldBonus}
      loading="lazy"
      fetchpriority="low"
      widths={[200, 400, 600]}
      sizes="(max-width: 768px) 100vw, 30vw"
      decoding="async"
      formats={["avif", "webp"]}
      fallbackFormat="webp"
      quality={80}
      alt="แบนเนอร์โปรโมชั่น BUNNY555 ฝากแรกลุ้นรับทอง 1 บาท ตัวอักษรสีชมพูบนพื้นดำโรยเหรียญทอง สาวชุดกระต่ายสีชมพูข้างตู้สล็อต JACKPOT มีทองคำแท่งและสร้อยทองด้านขวา ข้อความ ลุ้นง่าย จ่ายจริง ฟรีทุกยูสเซอร์ พร้อมไอคอนสี่ช่อง ระบบปลอดภัยมาตรฐานสากล ฝาก-ถอนรวดเร็วทันใจ โบนัสจัดเต็มทุกวัน บริการลูกค้า 24 ชม. และแถบ สมัครวันนี้ รับสิทธิ์ลุ้นทองทันที"
      class="mx-auto h-auto w-full rounded-2xl border border-[#ff4d9d]/30 shadow-[0_10px_30px_rgba(255,77,157,0.22)]"
    />
    <p slot="right" class="text-left text-base leading-relaxed text-[#ffdcea]">
      เราเข้าใจดีว่าเวลาคือสิ่งมีค่า ระบบประมวลผลของ BUNNY555 จึงถูกพัฒนาด้วย AI ที่ล้ำสมัยที่สุด เพียงทำรายการฝากหรือถอน เครดิตของคุณจะถูกอัปเดตเข้าบัญชีทันทีโดยไม่ต้องรอนาน
      มอบความมั่นใจและสภาพคล่องทางการเงินให้คุณในทุกบิลที่ทำกำไรได้
    </p>
  </ContentBoxSevenThreeNeumorphism>

  <ContentBoxSpecial as="h2" title="ดูแลทุกการเชื่อมต่อด้วย บริการ 24 ชม. จากทีมงาน BUNNY555">
    <p slot="left" class="text-left text-base leading-relaxed text-[#ffdcea]">
      เพื่อให้คุณก้าวเดินบนเส้นทางแห่งความสำเร็จอย่างราบรื่น ทีมซัพพอร์ตของ BUNNY555 ได้ผ่านการอบรมมาอย่างดีเยี่ยม พร้อมสแตนด์บายแก้ไขปัญหาและให้คำปรึกษาตลอดเวลา
    </p>
    <p slot="right" class="text-left text-base leading-relaxed text-[#ffdcea]">
      ไม่ว่าคุณจะต้องการความช่วยเหลือเมื่อใด เราก็พร้อมเคียงข้างและดูแลคุณระดับวีไอพีเสมอ
    </p>
  </ContentBoxSpecial>

  <Faq title="FAQ คำถามที่พบบ่อย" faqs={faqs} />

  <LoginRtpSection />

  <GameRankingBoard />

  <SmoothCarousel />

  <LatestWinners />

  <ContentBoxTwo label="เข้าสู่ระบบและสมัครสมาชิก BUNNY555">
    <div slot="left" class="flex flex-col gap-4">
      <p class="flex items-center gap-3 border-b border-[#ff4d9d]/30 pb-3 text-xl leading-normal font-black tracking-widest text-[#ff4d9d] uppercase">
        <span aria-hidden="true" class="h-6 w-1.5 shrink-0 rounded-full bg-gradient-to-b from-[#ffc2da] via-[#ff4d9d] to-[#a3134f] shadow-[0_0_10px_rgba(255,77,157,0.5)]"></span>
        เข้าสู่ระบบสมาชิกเดิม
      </p>
      <p class="text-left text-base leading-relaxed text-[#ffdcea]">
        เข้าแดชบอร์ดส่วนตัวเพื่อจัดการยอดฝากถอนผ่านระบบออโต้ที่ ได้เงินไว ในเสี้ยววินาที เลือกค่ายเกมชั้นนำ และกดรับโบนัสได้จากจุดเดียว
      </p>
      <a
        href="/login"
        class="mt-1 inline-flex items-center justify-center rounded-full bg-gradient-to-r from-[#ffc2da] via-[#ff4d9d] to-[#a3134f] px-8 py-3 text-sm font-black whitespace-nowrap text-[#26050f] shadow-[0_10px_30px_rgba(255,77,157,0.3)] transition-all duration-300 hover:-translate-y-1 hover:scale-105 hover:shadow-[0_15px_40px_rgba(255,77,157,0.45)] sm:text-base">
        เข้าสู่ระบบ
      </a>
    </div>

    <div slot="right" class="flex flex-col gap-4">
      <p class="flex items-center gap-3 border-b border-[#ffcf5c]/40 pb-3 text-xl leading-normal font-black tracking-widest text-[#ffcf5c] uppercase">
        <span aria-hidden="true" class="h-6 w-1.5 shrink-0 rounded-full bg-gradient-to-b from-[#ffe7a8] via-[#ffcf5c] to-[#c98a1c] shadow-[0_0_10px_rgba(255,207,92,0.5)]"></span>
        สมัครสมาชิกใหม่
      </p>
      <p class="text-left text-base leading-relaxed text-[#ffdcea]">
        เปิดบัญชีเดียวใช้ได้ครบทุกค่ายลิขสิทธิ์แท้ ทั้ง Play'n GO Red Tiger และ Blueprint Gaming พร้อมรับการดูแลจากทีมงานด้วย บริการ 24 ชม. ตามเงื่อนไขของแต่ละแคมเปญ
      </p>
      <a
        href="/register"
        class="mt-1 inline-flex items-center justify-center rounded-full border border-[#ffcf5c]/60 bg-[#3a0818]/85 px-8 py-3 text-sm font-black whitespace-nowrap text-[#ffcf5c] backdrop-blur-sm transition-all duration-300 hover:scale-105 hover:border-[#ffcf5c] hover:bg-[#26050f]/85 hover:shadow-[0_15px_40px_rgba(255,207,92,0.3)] sm:text-base">
        สมัครสมาชิก
      </a>
    </div>
  </ContentBoxTwo>

  <ReviewCardSumo2 />

  <Navfoot />
</MainLayout>
