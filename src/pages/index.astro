---
import MainLayout from "../layouts/MainLayout.astro";
import Announcement from "../components/Announcement3.astro";
import ContentBoxNeumorphism from "../components/ContentBoxNeumorphism.astro";
import ContentBoxFloatingBadge from "../components/ContentBoxFloatingBadge.astro";
import ContentBoxSpecial from "../components/ContentBoxSpecial.astro";
import ContentBoxSevenThreeNeumorphism from "../components/ContentBoxSevenThreeNeumorphism.astro";
import ContentBoxSevenThreeFloatingBadge from "../components/ContentBoxSevenThreeFloatingBadge.astro";
import ContentBoxTwoNeumorphism from "../components/ContentBoxTwoNeumorphism.astro";
import FeatureHighlights from "../components/FeatureHighlights.astro";
import LoginRtpSection from "../components/LoginRtpSection.astro";
import ProviderGrid from "../components/ProviderGrid.astro";
import GameRankingBoard from "../components/GameRankingBoard.astro";
import ReviewCardSumo2 from "../components/ReviewCardSumo2.astro";
import LatestWinners from "../components/LatestWinners2.astro";
import SmoothCarousel from "../components/SmoothCarousel.astro";
import Faq from "../components/Faq2.astro";
import Navfoot from "../components/Navfoot.astro";

import { Picture } from "astro:assets";
import { pageGraph } from "../lib/schema";
import imgCashback from "../assets/slide1.png";
import imgGiveaway from "../assets/slide2.png";

const pageTitle = "GARUDA369 สล็อตเว็บใหญ่ ระบบออโต้ โปรจัดเต็ม ทำเงินได้จริง";

// 155 characters, inside verify-build.mjs's 150–160 window (it counts
// CHARACTERS, not bytes — Thai is 3 bytes each, so a byte count lies). The
// docx meta ends at "สำหรับนักลงทุน" and counts 148; the trailing "ยุคใหม่" is
// the docx's own wording from the H1 paragraph, so the gap closes without
// adding a claim the brief never made.
const pageDescription = "ร่วมสนุกกับ GARUDA369 สล็อตเจ้าใหญ่ เว็บตรงไม่ผ่านเอเย่นต์ ทำรายการไวด้วยระบบฝาก-ถอนออโต้ พร้อมโปรโมชั่นจัดเต็ม แหล่งทำเงินที่ดีที่สุดสำหรับนักลงทุนยุคใหม่";

// The three camp sub-points that sit under docx heading #2, in the docx's own
// order. FeatureHighlights renders each `title` as an <h3>, which is the only
// place this page is allowed to have one. Its accent union is "green" | "gold".
const providerPoints = [
  {
    icon: "🪶",
    title: "AvatarUX นวัตกรรม PopWins สุดล้ำ ทวีคูณรางวัลไม่รู้จบ",
    description: "โดดเด่นด้วยกลไกการขยายเพย์ไลน์ที่แปลกใหม่ ทุกครั้งที่ชนะรางวัล กระดานจะขยายใหญ่ขึ้นเพื่อมอบโอกาสทำกำไรที่ทวีคูณอย่างต่อเนื่อง",
    accent: "green" as const,
  },
  {
    icon: "🎆",
    title: "Spinomenal กราฟิกตระการตา ฟีเจอร์แตกหนัก โบนัสเข้าไว",
    description: "นำเสนอความบันเทิงที่ล้ำหน้าด้วยภาพแอนิเมชันสุดตระการตา ฟีเจอร์ภายในเกมถูกปรับจูนมาให้เข้าถึงรอบแจ็กพอตได้อย่างรวดเร็วและคุ้มค่า",
    accent: "gold" as const,
  },
  {
    icon: "🧩",
    title: "Relax Gaming เสถียรภาพยอดเยี่ยม ทำกำไรเพลิน ไม่มีสะดุด",
    description: "ค่ายเกมที่มุ่งเน้นการสร้างสถาปัตยกรรมซอฟต์แวร์ที่แข็งแกร่ง โหลดไว ตอบสนองฉับไวบนทุกอุปกรณ์ ให้คุณลุ้นผลตอบแทนได้อย่างราบรื่น",
    accent: "green" as const,
  },
];

const faqs = [
  {
    q: "ทำไมแพลตฟอร์มนี้จึงถูกยกย่องว่าเป็น สล็อตเว็บใหญ่ ที่ดีที่สุด?",
    a: "เพราะ GARUDA369 มีระบบที่เสถียร รวมเกมลิขสิทธิ์แท้ และมีฐานการเงินที่มั่นคงระดับองค์กร",
  },
  {
    q: "การประมวลผลผ่าน ระบบออโต้ ใช้เวลานานแค่ไหน?",
    a: "ทำงานด้วยความเร็วสูงผ่าน AI อัจฉริยะ ยอดเงินอัปเดตเข้ากระเป๋าสำเร็จภายในเวลาเพียงไม่กี่วินาที",
  },
  {
    q: "สามารถกดยอมรับสิทธิ์ โปรจัดเต็ม ได้จากช่องทางใด?",
    a: "สมาชิกสามารถรับโบนัสและสิทธิพิเศษต่างๆ ได้ด้วยตนเองผ่านหน้าแดชบอร์ดอัตโนมัติได้อย่างสะดวกรวดเร็ว",
  },
  {
    q: "มือใหม่สามารถ ทำเงินได้จริง จากแพลตฟอร์มนี้หรือไม่?",
    a: "ทำได้อย่างแน่นอน ด้วยระบบที่ใช้งานง่าย โปร่งใส และมีอัตราการจ่ายที่ยุติธรรม เปิดโอกาสให้ทุกคนเข้าถึงกำไรได้จริง",
  },
];

// No `breadcrumb` — this is the homepage, so a trail would only point at
// itself. The URL comes from Astro, never typed out here.
const graph = pageGraph(Astro, {
  name: pageTitle,
  description: pageDescription,
  faqs,
});

const altCashback =
  "แบนเนอร์โปรโมชั่น GARUDA369 คืนยอดเสีย 15% พร้อมข้อความ เล่นสนุกได้ทุกวัน เราดูแลคืนกำไรให้คุณ ป้ายมุมภาพ เสียเท่าไหร่ เราคืนให้ สูงสุด 15% ทุกวัน ตู้สล็อตขึ้นคำว่า JACKPOT และแถบด้านล่าง มั่นคง ปลอดภัย เชื่อถือได้ 100%";

const altGiveaway =
  "แบนเนอร์โปรโมชั่น GARUDA369 ฝาก29 ลุ้นรับ iPhone 17 Pro Max พร้อมข้อความ ลุ้นง่าย ได้จริง ทุกคนมีสิทธิ์ ป้ายมุมภาพ แจกจริง ทุกเดือน และแถบด้านล่าง ยิ่งฝาก ยิ่งมีสิทธิ์มาก ลุ้นรางวัลใหญ่ทุกเดือน";
---

<MainLayout title={pageTitle} description={pageDescription}>
  <script type="application/ld+json" set:html={graph} />

  <Announcement />

  <ContentBoxNeumorphism as="h1" title="GARUDA369 สล็อตเว็บใหญ่ ระบบออโต้ โปรจัดเต็ม ทำเงินได้จริง">
    <p class="text-left text-base leading-relaxed text-[#dcefc2]">
      เปิดมิติใหม่แห่งการลงทุนที่ทรงพลังและมั่นคงไปกับ <strong class="text-[#e9f8cf]">GARUDA369</strong> สล็อตเว็บใหญ่ ที่ถูกสร้างขึ้นมาเพื่อตอบสนองนักเดิมพันที่ต้องการความเป็นเลิศ แพลตฟอร์มนี้ถือเป็นแหล่งทำเงินที่ดีที่สุดสำหรับนักลงทุนยุคใหม่
      ขับเคลื่อนการทำธุรกรรมด้วยเทคโนโลยี ระบบออโต้ ที่รวดเร็วและแม่นยำ พร้อมมอบความคุ้มค่าผ่านแคมเปญและ โปรจัดเต็ม มากมาย เพื่อให้ทุกการเชื่อมต่อของคุณสามารถต่อยอดและ ทำเงินได้จริง อย่างยั่งยืนในระยะยาว
    </p>
  </ContentBoxNeumorphism>

  <ContentBoxFloatingBadge as="h2" title="GARUDA369 ศูนย์รวมเกมลิขสิทธิ์แท้ สล็อตเว็บใหญ่ ระดับโลก">
    <p class="text-left text-base leading-relaxed text-[#dcefc2]">
      การก้าวเข้ามาเป็นส่วนหนึ่งของแพลตฟอร์ม GARUDA369 คือการเปิดประตูสู่อาณาจักรเกมที่ยิ่งใหญ่ที่สุด เราได้รวบรวมซอฟต์แวร์คุณภาพจากค่ายดังทั่วโลกมาไว้ในที่เดียว ทุกเกมทำงานบนเซิร์ฟเวอร์หลักโดยตรง
      มั่นใจได้ในความลื่นไหล กราฟิกคมชัด และอัตราการจ่ายที่โปร่งใส
    </p>
    <FeatureHighlights items={providerPoints} />
  </ContentBoxFloatingBadge>

  <ProviderGrid />

  <ContentBoxSevenThreeNeumorphism titleright="ขับเคลื่อนความเร็วด้วย ระบบออโต้ นวัตกรรมล้ำสมัยจาก GARUDA369">
    <Picture
      slot="left"
      src={imgGiveaway}
      loading="lazy"
      fetchpriority="low"
      widths={[200, 400, 600]}
      sizes="(max-width: 768px) 100vw, 30vw"
      decoding="async"
      formats={["avif", "webp"]}
      fallbackFormat="webp"
      quality={80}
      alt={altGiveaway}
      class="mx-auto h-auto w-full rounded-2xl border border-[#7bbb0b]/30 shadow-[0_10px_30px_rgba(123,187,11,0.22)]"
    />
    <p slot="right" class="text-left text-base leading-relaxed text-[#dcefc2]">
      ตอบโจทย์คนรักความรวดเร็วด้วยนวัตกรรมทางการเงินที่ดีที่สุด สมาชิกของ GARUDA369 สามารถจัดการยอดฝากและถอนได้อย่างอิสระผ่านระบบ AI อัจฉริยะ การประมวลผลเครดิตจะเสร็จสิ้นภายในเสี้ยววินาที
      ลดขั้นตอนที่ยุ่งยาก เพื่อให้คุณเดินหน้าทำกำไรได้อย่างต่อเนื่องและมีสภาพคล่องทางการเงินสูงสุด
    </p>
  </ContentBoxSevenThreeNeumorphism>

  <ContentBoxSevenThreeFloatingBadge title="รับความคุ้มค่าจาก โปรจัดเต็ม ทวีคูณผลกำไรทุกยอดบิล">
    <Picture
      slot="left"
      src={imgCashback}
      loading="lazy"
      fetchpriority="low"
      widths={[200, 400, 600]}
      sizes="(max-width: 768px) 100vw, 30vw"
      decoding="async"
      formats={["avif", "webp"]}
      fallbackFormat="webp"
      quality={80}
      alt={altCashback}
      class="mx-auto h-auto w-full rounded-2xl border border-[#f5c518]/30 shadow-[0_10px_30px_rgba(245,197,24,0.22)]"
    />
    <p slot="right" class="text-left text-base leading-relaxed text-[#dcefc2]">
      เพื่อยกระดับความสำเร็จให้กับนักลงทุน ทางทีมงานได้เตรียมสิทธิพิเศษและทุนสนับสนุนเอาไว้อย่างมหาศาล คุณสามารถเลือกรับแคมเปญเสริมได้ด้วยตนเองผ่านเมนูอัตโนมัติ
      เป็นการเพิ่มขีดความสามารถในการเดิมพันให้กว้างขึ้นและลดความเสี่ยงได้อย่างมีประสิทธิภาพ ตอบโจทย์ผู้เล่นทุกระดับทุน
    </p>
  </ContentBoxSevenThreeFloatingBadge>

  <ContentBoxSpecial as="h2" title="พิสูจน์ผลลัพธ์บน GARUDA369 แพลตฟอร์มที่ ทำเงินได้จริง ปลอดภัย 100%">
    <p slot="left" class="text-left text-base leading-relaxed text-[#dcefc2]">
      รากฐานของความยิ่งใหญ่คือความน่าเชื่อถือและการรักษาความปลอดภัยระดับองค์กร ข้อมูลส่วนบุคคลและกระเป๋าเงินของคุณบน GARUDA369 จะถูกเข้ารหัสอย่างแน่นหนา
    </p>
    <p slot="right" class="text-left text-base leading-relaxed text-[#dcefc2]">
      นอกจากนี้การเข้าสู่ระบบผ่าน Secure Popup ยังช่วยให้ทุกการเชื่อมต่อเป็นส่วนตัว การันตีผลตอบแทนที่ถอนออกได้ครบทุกบาทอย่างไร้กังวล
    </p>
  </ContentBoxSpecial>

  <Faq title="FAQ คำถามที่พบบ่อย" faqs={faqs} />

  <LoginRtpSection />

  <GameRankingBoard />

  <SmoothCarousel />

  <LatestWinners />

  <ContentBoxTwoNeumorphism titleleft="เข้าสู่ระบบสมาชิกเดิม" titleright="สมัครสมาชิกใหม่" label="เข้าสู่ระบบและสมัครสมาชิก GARUDA369">
    <div slot="left" class="flex flex-col gap-4">
      <p class="text-left text-base leading-relaxed text-[#dcefc2]">
        เข้าแดชบอร์ดส่วนตัวเพื่อจัดการยอดฝากถอนผ่าน ระบบออโต้ ที่ประมวลผลเครดิตเสร็จภายในเสี้ยววินาที เลือกค่ายเกมลิขสิทธิ์แท้ และกดรับ โปรจัดเต็ม ได้จากจุดเดียว
      </p>
      <a
        href="/login"
        class="mt-1 inline-flex items-center justify-center rounded-full bg-gradient-to-r from-[#a8e81c] via-[#7bbb0b] to-[#3c6b07] px-8 py-3 text-sm font-black whitespace-nowrap text-[#061405] shadow-[0_10px_30px_rgba(123,187,11,0.3)] transition-all duration-300 hover:-translate-y-1 hover:scale-105 hover:shadow-[0_15px_40px_rgba(123,187,11,0.45)] sm:text-base">
        เข้าสู่ระบบ
      </a>
    </div>

    <div slot="right" class="flex flex-col gap-4">
      <p class="text-left text-base leading-relaxed text-[#dcefc2]">
        เปิดบัญชีเดียวใช้ได้ครบทุกค่ายลิขสิทธิ์แท้ ทั้ง AvatarUX Spinomenal และ Relax Gaming พร้อมระบบฝาก-ถอนออโต้ และการเข้าสู่ระบบที่ปกป้องด้วย Secure Popup ตามเงื่อนไขของแต่ละแคมเปญ
      </p>
      <a
        href="/register"
        class="mt-1 inline-flex items-center justify-center rounded-full border border-[#f5c518]/60 bg-[#0d2606]/85 px-8 py-3 text-sm font-black whitespace-nowrap text-[#f5c518] backdrop-blur-sm transition-all duration-300 hover:scale-105 hover:border-[#f5c518] hover:bg-[#061405]/85 hover:shadow-[0_15px_40px_rgba(245,197,24,0.3)] sm:text-base">
        สมัครสมาชิก
      </a>
    </div>
  </ContentBoxTwoNeumorphism>

  <ReviewCardSumo2 />

  <Navfoot />
</MainLayout>
