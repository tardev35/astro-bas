---
import MainLayout from "../layouts/MainLayout.astro";
import Announcement from "../components/AnnouncementHuay.astro";
import ContentBox from "../components/ContentBox.astro";
import ContentBoxHuay from "../components/ContentBoxHuay.astro";
import ContentBoxSevenThreeHuay from "../components/ContentBoxSevenThreeHuay.astro";
import ContentBoxFloatingBadge from "../components/ContentBoxFloatingBadge.astro";
import ContentBoxSevenThreeFloatingBadge from "../components/ContentBoxSevenThreeFloatingBadge.astro";
import ContentBoxCyberCut from "../components/ContentBoxCyberCut.astro";
import ContentBoxSpecial from "../components/ContentBoxSpecial.astro";
import LottoGrid from "../components/LottoGrid.astro";
import LoginRtpSection from "../components/LoginRtpSection.astro";
import ReviewCardSumo2 from "../components/ReviewCardSumo2.astro";
import LatestWinners from "../components/LatestWinnersHuay.astro";
import SmoothCarousel from "../components/SmoothCarousel.astro";
import Faq from "../components/FaqHuay.astro";
import Navfoot from "../components/Navfoot.astro";

import { Picture } from "astro:assets";
import { orderForBrand } from "../lib/brandProfile";
import imgMarkets from "../assets/slide3.png";
import imgPayout from "../assets/slide2.png";

const currentPath = Astro.url.pathname;
const homePage = Astro.url.origin;
const logoUrl = homePage + "/logo.webp";

const pageTitle = "MAHORANLOTTO เว็บเล่นหวยออนไลน์ ครบทุกตลาด ซื้อหวยง่าย จ่ายไว";
const pageDescription = "ซื้อหวยออนไลน์ ครบทุกตลาดผ่าน MAHORANLOTTO รองรับหวยรัฐบาล หวยลาว หวยฮานอย สมัครสมาชิก ทางเข้าเว็บไซต์จริง ส่งโพยอัตโนมัติ ข้อมูลเลขอั้นง่าย";

const faqs = [
  {
    q: "MAHORANLOTTO รองรับตลาดหวยอะไรบ้าง",
    a: "ระบบรวมตลาดหวยหลายประเภทไว้ในเว็บไซต์เดียว ทั้งหวยรัฐบาลไทย หวยลาว หวยฮานอย หวยหุ้น หวยยี่กี และหวยต่างประเทศ สมาชิกสามารถดูรอบที่เปิดรับ เวลาปิดรับ และอัตราจ่ายของแต่ละตลาดก่อนเลือกส่งโพยได้จากหน้าเดียว",
  },
  {
    q: "สมัครสมาชิก MAHORANLOTTO ต้องทำอย่างไร",
    a: "กรอกข้อมูลตามที่ระบบกำหนด ยืนยันบัญชี แล้วเข้าสู่ระบบ จากนั้นเติมเครดิตและเลือกตลาดหวยที่ต้องการได้ทันที ขั้นตอนเป็นระบบอัตโนมัติจึงใช้เวลาไม่นาน แต่ควรตรวจสอบชื่อบัญชีและจำนวนเงินให้ถูกต้องก่อนยืนยันทุกครั้ง",
  },
  {
    q: "เลขอั้นกับเลขเต็มต่างกันอย่างไร ตรวจสอบก่อนส่งโพยได้ที่ไหน",
    a: "เลขอั้นคือเลขที่ยอดแทงเข้ามามากจนต้องปรับลดอัตราจ่ายลงจากปกติ ส่วนเลขเต็มคือเลขที่ปิดรับแล้วและส่งโพยเพิ่มไม่ได้ในรอบนั้น ทั้งสองรายการจะแสดงอยู่ในหน้าของแต่ละตลาด และหน้ายืนยันโพยจะแจ้งอัตราจ่ายจริงให้เห็นก่อนกดยืนยันเสมอ",
  },
  {
    q: "ถูกรางวัลแล้วรับเงินรางวัลอย่างไร",
    a: "หลังประกาศผล ระบบจะตรวจโพยของสมาชิกและอัปเดตสถานะรายการให้เห็นในบัญชีผู้ใช้งาน หากเป็นรายการที่เข้าเงื่อนไขการรับรางวัล ระบบจะดำเนินการตามขั้นตอนที่กำหนด และสมาชิกสามารถย้อนดูประวัติการถูกรางวัลได้จากหน้าประวัติรายการ",
  },
  {
    q: "ตรวจสอบทางเข้า MAHORANLOTTO เว็บไซต์จริงอย่างไร",
    a: "สังเกตชื่อโดเมนให้ตรงกับแบรนด์ ตรวจสอบว่าเชื่อมต่อแบบ HTTPS และดูว่าหน้าเว็บไซต์มีเมนูสมัครสมาชิก เข้าสู่ระบบ และช่องทางติดต่อครบถ้วน หลีกเลี่ยงลิงก์จากแหล่งที่ไม่ทราบที่มาหรือเว็บไซต์ที่ตั้งชื่อเลียนแบบ",
  },
];

const webPageSchema = {
  "@context": "https://schema.org",
  "@type": "WebPage",
  name: "MAHORANLOTTO",
  description: pageDescription,
  url: homePage + currentPath,
};
const webSiteSchema = {
  "@context": "https://schema.org",
  "@type": "WebSite",
  name: "MAHORANLOTTO",
  alternateName: ["MAHORANLOTTO", "MAHORANLOTTO เว็บเล่นหวยออนไลน์ ครบทุกตลาด ซื้อหวยง่าย จ่ายไว"],
  url: "https://mahoranlotto-brand.com/",
};
const orgSchema = {
  "@context": "https://schema.org",
  "@type": "Organization",
  name: "MAHORANLOTTO",
  logo: logoUrl,
  url: homePage,
};
// Order carries no meaning to a JSON-LD parser, so it is varied per brand —
// every launch of this template used to emit these three in the same sequence.
const allSchemas = orderForBrand([webPageSchema, orgSchema, webSiteSchema], Astro.site, "jsonld");
---

<MainLayout title={pageTitle} description={pageDescription}>
  <script type="application/ld+json" set:html={JSON.stringify(allSchemas)} />

  <Announcement />

  <ContentBoxHuay as="h1" title="ซื้อหวยออนไลน์กับ MAHORANLOTTO รองรับตลาดเล่นหวยใดบ้าง">
    <p>
      <strong class="text-amber-300">MAHORANLOTTO</strong> เป็นเว็บเล่นหวยออนไลน์ที่รวบรวมตลาดหวยหลายประเภทไว้ในระบบเดียว ช่วยให้สมาชิกสามารถเลือกซื้อหวยได้สะดวกโดยไม่ต้องสลับใช้งานหลายเว็บไซต์ ไม่ว่าจะเป็นหวยรัฐบาล
      หวยลาว หวยฮานอย หวยหุ้น หรือหวยต่างประเทศ สมัครสมาชิก ฝากถอน ไปจนถึงการส่งโพยและตรวจสอบรายการย้อนหลัง ภายในหน้าเดียว ทำให้การซื้อหวยออนไลน์เป็นเรื่องง่ายมากขึ้น
    </p>
  </ContentBoxHuay>

  <ContentBoxSevenThreeHuay titleright="ซื้อหวยออนไลน์กับ MAHORANLOTTO รองรับตลาดหวยใดบ้าง">
    <div slot="left" class="flex h-full flex-col justify-center">
      <Picture
        src={imgMarkets}
        loading="lazy"
        fetchpriority="low"
        widths={[200, 400, 600, 800]}
        sizes="(max-width: 768px) 100vw, 30vw"
        decoding="async"
        formats={["avif", "webp"]}
        fallbackFormat="webp"
        quality={80}
        alt="MAHORANLOTTO ถ่ายทอดสดผลหวยฮานอย พร้อมตลาดหวยออนไลน์ครบทุกตลาดในระบบเดียว"
        class="mx-auto h-auto w-full rounded-2xl border-2 border-amber-500/30 shadow-[0_10px_30px_rgba(251,191,36,0.3)]"
      />
    </div>
    <p slot="right" class="text-left text-base leading-relaxed">
      MAHORANLOTTO รวบรวมตลาดหวยออนไลน์ หลายประเภทไว้ใน เว็บไซต์เดียว เพื่อลดขั้นตอนในการค้นหาและสลับใช้งานหลายแพลตฟอร์ม สมาชิกสามารถเลือกซื้อหวยได้ตามวันและรอบที่เปิดรับ
      พร้อมตรวจสอบอัตราจ่ายและรายละเอียดของแต่ละตลาดก่อนส่งโพยได้ทันที ไม่ว่าจะเป็นหวยรัฐบาล หวยลาว หวยฮานอย หวยหุ้น หรือหวยต่างประเทศ
    </p>
  </ContentBoxSevenThreeHuay>

  <LottoGrid />

  <ContentBoxFloatingBadge as="h2" title="สมัครสมาชิก MAHORANLOTTO อย่างไรให้เริ่มซื้อหวยได้ทันที">
    <p class="text-left text-base leading-relaxed">
      การ สมัครสมาชิก MAHORANLOTTO ไม่ซับซ้อน เพียงกรอกข้อมูลตามที่ระบบกำหนด ยืนยันบัญชี และเข้าสู่ระบบ ก็สามารถเลือกตลาดหวย เติมเครดิต และเริ่มส่งโพยได้ทันที ระบบอัตโนมัติช่วยลดระยะเวลาในการดำเนินการ
      ทำให้ผู้เล่นใหม่สามารถเริ่มซื้อหวยออนไลน์ได้ง่ายโดยไม่ต้องผ่านขั้นตอนที่ยุ่งยาก
    </p>
  </ContentBoxFloatingBadge>

  <LoginRtpSection />

  <div class="mx-auto mb-10 flex flex-nowrap justify-center gap-3 px-4 sm:gap-6">
    <a
      href="/login"
      class="group relative flex flex-1 items-center justify-center rounded-full bg-gradient-to-r from-amber-300 via-amber-400 to-amber-600 px-4 py-3 text-sm font-black whitespace-nowrap text-[#1a0409] shadow-[0_5px_20px_rgba(251,191,36,0.45)] transition-all duration-300 hover:-translate-y-1 hover:scale-105 hover:shadow-[0_8px_25px_rgba(251,191,36,0.65)] sm:flex-none sm:px-10 sm:py-3.5 sm:text-base">
      เข้าสู่ระบบ
    </a>

    <a
      href="/register"
      class="group relative flex flex-1 items-center justify-center rounded-full border border-amber-400/60 bg-[#1a0409]/80 px-4 py-3 text-sm font-black whitespace-nowrap text-amber-300 backdrop-blur-sm transition-all duration-300 hover:scale-105 hover:border-amber-300 hover:bg-[#5f0914] hover:shadow-[0_0_15px_rgba(251,191,36,0.45)] sm:flex-none sm:px-10 sm:py-3.5 sm:text-base">
      สมัครสมาชิก
    </a>
  </div>

  <ContentBoxCyberCut as="h2" title="ระบบซื้อหวยออนไลน์ของ MAHORANLOTTO ช่วยให้แทงหวยได้สะดวกขึ้นอย่างไร">
    <p class="text-left text-base leading-relaxed">
      ภายในเว็บไซต์มีระบบที่ช่วยจัดการขั้นตอนการซื้อหวยตั้งแต่การเลือกประเภทหวย กรอกหมายเลข ระบุจำนวนเงิน ไปจนถึงการยืนยันรายการในลำดับเดียว ผู้ใช้งานสามารถตรวจสอบรายละเอียดโพยก่อนส่งทุกครั้ง
      ลดความผิดพลาดจากการกรอกข้อมูล และยังสามารถดูประวัติการซื้อย้อนหลังได้ ทำให้การแทงหวยออนไลน์มีความสะดวกและจัดการข้อมูลได้ง่ายขึ้น
    </p>
  </ContentBoxCyberCut>

  <ContentBoxSpecial as="h2" title="เลขอั้น เลขเต็ม และปัญหาที่ผู้เล่นหวยออนไลน์มักพบก่อนส่งโพย">
    <div slot="left">
      <p class="text-left text-base leading-relaxed">
        เลขอั้นคือหมายเลขที่มียอดแทงเข้ามามากผิดปกติจนต้องปรับลดอัตราจ่ายลงจากเรตปกติของตลาดนั้น ส่วนเลขเต็มคือหมายเลขที่ปิดรับไปแล้วและไม่สามารถส่งโพยเพิ่มได้อีกในรอบนั้น
        ปัญหาที่ผู้เล่นหวยออนไลน์พบบ่อยที่สุดคือการกดยืนยันโพยโดยไม่ได้ดูสถานะของเลขก่อน แล้วมาพบภายหลังว่าอัตราจ่ายที่ได้รับไม่เท่ากับที่คาดไว้ หรือเลขที่ตั้งใจแทงถูกปิดรับไปก่อนหน้าแล้ว
      </p>
    </div>
    <div slot="right">
      <p class="text-left text-base leading-relaxed">
        ก่อนส่งโพยทุกครั้ง สมาชิก MAHORANLOTTO ควรเปิดดูตารางเลขอั้นและเลขเต็มของตลาดที่ต้องการ ตรวจสอบอัตราจ่ายที่ระบบแสดงบนหน้ายืนยันโพยว่าตรงกับที่ตั้งใจไว้หรือไม่
        และดูเวลาปิดรับของแต่ละตลาดให้ชัดเจน เพราะหวยรัฐบาล หวยลาว หวยฮานอย และหวยหุ้นปิดรับคนละเวลากัน การตรวจโพยให้ครบทั้งหมายเลข จำนวนเงิน และประเภทการแทงก่อนกดยืนยัน
        จะช่วยลดปัญหาที่พบบ่อยของผู้เล่นหวยออนไลน์ได้เกือบทั้งหมด
      </p>
    </div>
  </ContentBoxSpecial>

  <ContentBoxSevenThreeFloatingBadge title="ระบบจ่ายไวของ MAHORANLOTTO ทำงานอย่างไร หลังถูกรางวัล">
    <div slot="left" class="flex h-full flex-col justify-center">
      <Picture
        src={imgPayout}
        loading="lazy"
        fetchpriority="low"
        widths={[200, 400, 600, 800]}
        sizes="(max-width: 768px) 100vw, 30vw"
        decoding="async"
        formats={["avif", "webp"]}
        fallbackFormat="webp"
        quality={80}
        alt="MAHORANLOTTO ถูกตรงจ่ายจริง รับเงินรางวัลหวยออนไลน์หลักล้านผ่านระบบจ่ายไว"
        class="mx-auto h-auto w-full rounded-2xl border-2 border-amber-500/30 shadow-[0_10px_30px_rgba(251,191,36,0.3)]"
      />
    </div>
    <p slot="right" class="text-left text-base leading-relaxed">
      หลังประกาศผลรางวัล สมาชิก MAHORANLOTTO สามารถตรวจสอบผลผ่านระบบและติดตามสถานะรายการของตนเองได้ทันที หากเป็นรายการที่เข้าเงื่อนไขการรับรางวัล ระบบจะดำเนินการตามขั้นตอนที่กำหนด
      ช่วยลดระยะเวลาในการตรวจสอบและอำนวยความสะดวกในการจัดการธุรกรรม สมาชิกยังสามารถตรวจสอบประวัติการรับรางวัลและรายการย้อนหลังได้จากบัญชีผู้ใช้งาน
    </p>
  </ContentBoxSevenThreeFloatingBadge>

  <LatestWinners />

  <ContentBox as="h2" title="ทางเข้า MAHORANLOTTO เว็บไซต์จริง และวิธีหลีกเลี่ยงเว็บปลอม">
    <p class="text-left text-base leading-relaxed">
      ก่อนเข้าใช้งานควรตรวจสอบว่าเป็นทางเข้าของเว็บไซต์จริงทุกครั้ง โดยสังเกตชื่อโดเมน <strong class="text-amber-300">MAHORANLOTTO</strong> การเชื่อมต่อ HTTPS และข้อมูลความปลอดภัยของหน้าเว็บไซต์ หลีกเลี่ยงการเข้าสู่ระบบผ่านลิงก์ที่ไม่ทราบแหล่งที่มา
      หรือเว็บไซต์ที่มีการเลียนแบบชื่อแบรนด์ การใช้ทางเข้าล่าสุดจากช่องทางทางการจะช่วยลดความเสี่ยงในการพบเว็บไซต์ปลอมและทำให้ใช้งานได้อย่างต่อเนื่องและปลอดภัย
    </p>
  </ContentBox>

  <SmoothCarousel />

  <Faq title="คำถามที่พบบ่อยเกี่ยวกับ MAHORANLOTTO" faqs={faqs} />

  <ReviewCardSumo2 />

  <Navfoot />
</MainLayout>
