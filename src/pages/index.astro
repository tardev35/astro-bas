---
import MainLayout from "../layouts/MainLayout.astro";
import AnnouncementCyber from "../components/AnnouncementCyber.astro";
import ContentBox from "../components/ContentBox.astro";
import ContentBoxCyberCut from "../components/ContentBoxCyberCut.astro";
import ContentBoxPremium from "../components/ContentBoxPremium.astro";
import ContentBoxSevenThreeCyberCut from "../components/ContentBoxSevenThreeCyberCut.astro";
import ContentBoxSevenThreePremium from "../components/ContentBoxSevenThreePremium.astro";
import FeatureHighlights from "../components/FeatureHighlights.astro";
import LoginRtpSection from "../components/LoginRtpSection.astro";
import ProviderGrid from "../components/ProviderGrid.astro";
import GameRankingBoard from "../components/GameRankingBoard.astro";
import LatestWinners from "../components/LatestWinnersCyber.astro";
import SmoothCarousel from "../components/SmoothCarousel.astro";
import ReviewCardSumo from "../components/ReviewCardSumo2.astro";
import Navfoot from "../components/Navfoot.astro";
const currentPath = Astro.url.pathname;
const homePage = Astro.url.origin;
const logoUrl = homePage + "/logo.webp";

const pageTitle = "รีวิว MARINA65 เว็บคาสิโนออนไลน์ เกมสล็อต กีฬา เว็บตรงอันดับ 1";
const pageDescription = "รีวิว MARINA65 เว็บคาสิโนออนไลน์ พร้อมข้อมูลเกมสล็อต คาสิโนสด กีฬา และเว็บตรงอันดับ 1 วิเคราะห์จุดเด่น เกมที่ให้บริการ ระบบสมาชิก และการใช้งาน";

const webPageSchema = {
  "@context": "https://schema.org",
  "@type": "WebPage",
  name: pageTitle,
  description: pageDescription,
  url: currentPath,
};
const webSiteSchema = {
  "@context": "https://schema.org",
  "@type": "WebSite",
  name: "MARINA65",
  alternateName: ["MARINA65", "รีวิว MARINA65 เว็บคาสิโนออนไลน์ เว็บตรงอันดับ 1"],
  url: "https://www.marina65-review.com/",
};
const orgSchema = {
  "@context": "https://schema.org",
  "@type": "Organization",
  name: "MARINA65",
  logo: logoUrl,
  url: homePage,
};
const allSchemas = [webPageSchema, orgSchema, webSiteSchema];

const webDirectStrengths = [
  {
    icon: "🧩",
    title: "บริการครบในเว็บเดียว",
    description: "รวมสล็อต คาสิโนสด และกีฬาไว้ในบัญชีเดียว ไม่ต้องสมัครหลายเว็บหรือแยกกระเป๋าเงินให้ยุ่งยาก",
    accent: "gold" as const,
  },
  {
    icon: "⚡",
    title: "หน้าเว็บตอบสนองเร็ว",
    description: "เมนูและหน้าเกมโหลดต่อเนื่อง เข้าถึงหมวดเกมและบริการสำคัญได้รวดเร็วโดยไม่สะดุด",
    accent: "blue" as const,
  },
  {
    icon: "👤",
    title: "ระบบสมาชิกจัดการง่าย",
    description: "ตรวจสอบยอดเงิน ประวัติรายการ และข้อมูลบัญชีได้ครบจากหน้าเดียว จัดการทุกความเคลื่อนไหวได้สะดวก",
    accent: "gold" as const,
  },
  {
    icon: "📱",
    title: "เข้าเล่นได้ทั้งมือถือและคอม",
    description: "รองรับการใช้งานทั้งบนสมาร์ทโฟนและคอมพิวเตอร์ เล่นต่อเนื่องได้จากทุกอุปกรณ์",
    accent: "blue" as const,
  },
  {
    icon: "🔄",
    title: "ฝากถอนอัตโนมัติ",
    description: "ระบบฝากถอนอัตโนมัติช่วยลดขั้นตอนตั้งแต่สมัครสมาชิกจนถึงเริ่มใช้งาน ทำรายการได้รวดเร็ว",
    accent: "gold" as const,
  },
];

import { Picture } from "astro:assets";
import imgSlot from "../assets/slide1.png";
import imgSport from "../assets/slide2.png";
import imgRegister from "../assets/banner2.png";
---

<MainLayout title={pageTitle} description={pageDescription}>
  <script type="application/ld+json" set:html={JSON.stringify(allSchemas)} />

  <AnnouncementCyber message="📢 MARINA65 เว็บคาสิโนออนไลน์ รวมสล็อต คาสิโนสด และกีฬา เว็บตรงอันดับ 1 พร้อมระบบฝากถอนอัตโนมัติ อัปเดตทางเข้าล่าสุดที่ marina65-review.com" />

  <ContentBoxCyberCut as="h1" title="รีวิว MARINA65 เว็บคาสิโนออนไลน์ เกมสล็อต กีฬา เว็บตรงอันดับ 1">
    <p class="mx-auto max-w-4xl text-center leading-relaxed">
      MARINA65 เป็นเว็บคาสิโนออนไลน์ที่รวมเกมสล็อต คาสิโนออนไลน์ และการเดิมพันกีฬาไว้ในบัญชีเดียว จุดเด่นอยู่ที่หน้าเว็บใช้งานง่าย เกมแบ่งหมวดชัด
      และมีระบบสมาชิกช่วยจัดการยอดเงินกับรายการฝากถอนได้สะดวก ภาพรวมจึงตอบโจทย์คนที่ต้องการเว็บตรงอันดับ 1 ในด้านความครบ ความรวดเร็ว และการเข้าเล่นได้จากทุกอุปกรณ์
    </p>
  </ContentBoxCyberCut>

  <SmoothCarousel />

  <ContentBox as="h2" title="รีวิว MARINA65 คาสิโนออนไลน์ มีจุดเด่นอะไร">
    <p class="leading-relaxed">
      MARINA65 เด่นเรื่องการรวมเกมหลายประเภทไว้ในระบบเดียว ทั้งสล็อต โต๊ะคาสิโนสด และกีฬา เมนูไม่ซับซ้อน สามารถค้นหาเกม เช็กโปรโมชั่น และจัดการบัญชีได้จากหน้าเดียว
      เหมาะกับคนที่ไม่ต้องการสมัครหลายเว็บหรือโอนเงินแยกหลายกระเป๋า
    </p>
  </ContentBox>

  <ContentBoxPremium as="h2" title="เว็บคาสิโนตรง ส่งผลดีต่อผู้เล่น ใช้งานง่ายแค่ไหน">
    <p class="leading-relaxed">
      หน้าแรกจัดหมวดเกมและบริการสำคัญไว้ชัดเจน ผู้เล่นจึงเข้าถึงสล็อต คาสิโน กีฬา ฝากถอน และโปรโมชั่นได้โดยไม่ต้องกดผ่านหลายขั้นตอน ส่วนระบบสมาชิกแสดงยอดเงิน ประวัติรายการ และข้อมูลบัญชีครบ
      ทำให้ตรวจสอบทุกความเคลื่อนไหวได้สะดวก
    </p>
  </ContentBoxPremium>

  <ContentBoxSevenThreeCyberCut titleright="สล็อตออนไลน์และคาสิโนบน MARINA65 มีอะไรน่าเล่น">
    <div slot="left" class="flex h-full flex-col justify-center">
      <Picture
        src={imgSlot}
        loading="lazy"
        fetchpriority="low"
        widths={[200, 400, 600, 800]}
        sizes="(max-width: 768px) 100vw, 30vw"
        decoding="async"
        formats={["avif", "webp"]}
        fallbackFormat="webp"
        quality={80}
        alt="MARINA65 รวมเกมสล็อตออนไลน์และคาสิโนสดหลายค่ายไว้ในบัญชีเดียว"
        class="mx-auto h-auto w-full rounded-2xl border-2 border-red-400/30 shadow-[0_10px_30px_rgba(220,38,38,0.3)]"
      />
    </div>
    <div slot="right">
      <p class="leading-relaxed">
        หมวดเกมสล็อตมีให้เลือกหลายแนว ทั้งเกมโบนัส เกมตัวคูณ และเกมที่มีระดับความผันผวนต่างกัน ขณะที่คาสิโนสดรองรับเกมโต๊ะยอดนิยม พร้อมภาพถ่ายทอดแบบเรียลไทม์
        ผู้เล่นจึงเลือกได้ทั้งการหมุนสล็อตแบบรวดเร็วและการเล่นคาสิโนที่เน้นจังหวะตัดสินใจ
      </p>
    </div>
  </ContentBoxSevenThreeCyberCut>

  <ProviderGrid />
  <GameRankingBoard />

  <ContentBoxSevenThreePremium titleright="เดิมพันกีฬากับ MARINA65 มีประเภทกีฬาให้เลือกมากแค่ไหน">
    <div slot="left" class="flex h-full flex-col justify-center">
      <Picture
        src={imgSport}
        loading="lazy"
        fetchpriority="low"
        widths={[200, 400, 600, 800]}
        sizes="(max-width: 768px) 100vw, 30vw"
        decoding="async"
        formats={["avif", "webp"]}
        fallbackFormat="webp"
        quality={80}
        alt="MARINA65 เดิมพันกีฬา ฟุตบอล มวย บาส และ E sport ภายในบัญชีเดียว"
        class="mx-auto h-auto w-full rounded-2xl border-2 border-red-400/20 shadow-[0_10px_30px_rgba(220,38,38,0.25)]"
      />
    </div>
    <div slot="right">
      <p class="leading-relaxed">
        หมวดกีฬารองรับการแข่งขันหลายประเภท ฟุตบอล มวย บาส หรือเกมประเภท E sport โดยเฉพาะฟุตบอล MARINA65 เปิดโต๊ะแทงบอลที่มีทั้งราคาก่อนแข่งและระหว่างแข่ง
        การวางข้อมูลราคาและคู่แข่งขันเป็นหมวดช่วยให้เลือกดูรายการได้ง่าย เหมาะกับคนที่ต้องการสลับจากคาสิโนหรือสล็อตมาลุ้นเกมกีฬาภายในบัญชีเดิม
      </p>
    </div>
  </ContentBoxSevenThreePremium>

  <ContentBox as="h2" title="ทำไม MARINA65 จึงมีภาพลักษณ์เป็น เว็บตรงอันดับ 1">
    <p class="leading-relaxed">
      จุดที่ทำให้ MARINA65 มีภาพลักษณ์ของเว็บตรงอันดับ 1 คือบริการที่ครบในเว็บเดียว หน้าเว็บตอบสนองเร็ว ระบบสมาชิกจัดการง่าย และสามารถเข้าเล่นได้ทั้งมือถือกับคอมพิวเตอร์ เมื่อรวมกับระบบฝากถอนอัตโนมัติ
      จึงช่วยลดขั้นตอนตั้งแต่สมัครสมาชิกจนถึงเริ่มใช้งาน
    </p>
    <FeatureHighlights items={webDirectStrengths} />
  </ContentBox>

  <ContentBox as="h2" title="สมัครสมาชิก MARINA65 และชวนเพื่อนรับเครดิต">
    <p class="leading-relaxed">
      การสมัครสมาชิกผ่านระบบออนไลน์ ใช้เวลาเพียงไม่กี่ขั้นตอนก็เริ่มใช้งานได้ ระบบสมาชิก MARINA65 มีระบบแนะนำเพื่อน (Referral)
      สำหรับสมาชิกที่ต้องการแบ่งปันลิงก์ให้ผู้อื่นสมัครผ่านรหัสหรือบัญชีที่กำหนด โดยผู้ที่เข้าร่วมควรตรวจสอบเงื่อนไขการรับเครดิต อัตราผลตอบแทน และข้อกำหนดของแต่ละกิจกรรมก่อนใช้งานทุกครั้ง
    </p>

    <Picture
      src={imgRegister}
      loading="lazy"
      fetchpriority="low"
      widths={[320, 480, 640, 768]}
      sizes="(max-width: 768px) 100vw, 640px"
      decoding="async"
      formats={["avif", "webp"]}
      fallbackFormat="webp"
      quality={80}
      alt="MARINA65 สมัครสมาชิกและชวนเพื่อนรับเครดิตผ่านระบบแนะนำเพื่อน"
      class="mx-auto mt-8 h-auto w-full max-w-5xl rounded-2xl border border-red-400/20 shadow-[0_10px_30px_rgba(220,38,38,0.2)]"
    />

    <div class="mt-8 flex flex-wrap justify-center gap-6">
      <a
        href="/login"
        class="group relative flex items-center justify-center rounded-full border border-amber-400/50 bg-[#14040a]/80 px-10 py-3.5 font-black text-amber-300 backdrop-blur-sm transition-all duration-300 hover:scale-105 hover:bg-red-900/60 hover:shadow-[0_0_15px_rgba(251,191,36,0.4)]">
        เข้าสู่ระบบ
      </a>

      <a
        href="/register"
        class="group relative flex items-center justify-center rounded-full bg-gradient-to-r from-amber-400 via-amber-500 to-yellow-600 px-10 py-3.5 font-black text-red-950 shadow-[0_5px_20px_rgba(251,191,36,0.4)] transition-all duration-300 hover:-translate-y-1 hover:scale-105 hover:shadow-[0_8px_25px_rgba(251,191,36,0.6)]">
        สมัครสมาชิก
      </a>
    </div>
  </ContentBox>

  <LoginRtpSection />

  <ContentBox as="h2" title="สรุปผลรีวิว MARINA65 เว็บเดิมพัน เกมคาสิโน ออนไลน์">
    <p class="leading-relaxed">
      MARINA65 เหมาะกับคนที่ต้องการสล็อตออนไลน์ คาสิโนออนไลน์ และกีฬาในระบบเดียว จุดแข็งคือการจัดหมวดเกมชัด ใช้งานไม่ยุ่งยาก และบริหารบัญชีได้สะดวก ภาพรวมจึงเป็นเว็บตรงที่เน้นความครบ ความเร็ว
      และการใช้งานต่อเนื่องมากกว่าการมีเกมจำนวนมากเพียงอย่างเดียว
    </p>
  </ContentBox>

  <ReviewCardSumo />
  <LatestWinners />

  <Navfoot />
</MainLayout>
