---
import MainLayout from "../layouts/MainLayout.astro";
import ContentBox from "../components/ContentBoxHuay.astro";
import Navfoot from "../components/Navfoot.astro";
import Announcement from "../components/AnnouncementPremium.astro";

import { Picture } from "astro:assets";

import pro1 from "../assets/slide1.png";
import pro2 from "../assets/slide2.png";
import pro3 from "../assets/slide3.png";
import pro4 from "../assets/slide4.png";
---

<MainLayout
  title="โปรโมชั่น WINUP888 เงื่อนไขโบนัส เกมที่ร่วมรายการ และเพดานถอนที่ควรอ่านก่อนรับ"
  description="รวมโปรโมชั่น WINUP888 คาสิโนบนมือถือระบบ HTML5 พร้อมจุดที่ต้องอ่านก่อนกดรับสิทธิ์ ทั้งยอดฝากที่แคมเปญกำหนด เงื่อนไขการทำยอด เกมสล็อตและเกม Live สดที่ร่วมรายการ ระยะเวลาของสิทธิ์ เพดานถอน และการตรวจสถานะรายการฝากถอนให้ครบก่อนกดยืนยัน">
  <Announcement />

  <ContentBox>
    <h1 class="mb-5 bg-gradient-to-r from-[#7a5a12] via-[#b8912f] to-[#8a6a1f] bg-clip-text text-3xl font-black tracking-widest text-transparent uppercase drop-shadow-sm">โปรโมชั่น WINUP888</h1>

    <h2 class="mb-4 text-2xl leading-normal font-bold text-[#a07c1f]">โปรโมชั่น WINUP888 ต้องอ่านตรงไหนบ้างก่อนกดรับสิทธิ์</h2>

    <p class="mb-5 text-left text-base leading-relaxed text-[#3a2e18]">
      ก่อนกดรับโบนัสของ <strong class="text-[#8a6410]">WINUP888</strong> ควรอ่านเงื่อนไขให้ครบทั้งยอดฝากที่แคมเปญกำหนด เงื่อนไขการทำยอด รายชื่อเกมที่ร่วมรายการ ระยะเวลาของสิทธิ์ และเพดานถอน ตัวเลขใหญ่บนแบนเนอร์อ่านง่ายและดูดี แต่บรรทัดเล็กด้านล่างมักเป็นตัวตัดสินว่าสิทธิ์นั้นเข้ากับแผนการเล่นบนมือถือของเราจริงหรือเปล่า
    </p>

    <p class="mb-5 text-left text-base leading-relaxed text-[#3a2e18]">
      หากตั้งใจจะถอนตามยอดปกติ การไม่รับโบนัสอาจเหมาะกว่า เพราะยอดที่ยังทำไม่ครบทำให้ถอนไม่ได้จนกว่าจะเล่นจบเงื่อนไข ถ้าข้อไหนอ่านแล้วยังไม่ชัด ควรถามทีมงานผ่านช่องทางที่แสดงบนเว็บไซต์ก่อนกดรับสิทธิ์ ไม่ใช่รอให้ติดเงื่อนไขแล้วค่อยเปิดโหมดนักสืบย้อนหลัง
    </p>

    <h2 class="mt-10 mb-4 text-2xl leading-normal font-bold text-[#a07c1f]">ฝากถอนและการตรวจสถานะรายการ เกี่ยวกับโปรโมชั่นอย่างไร</h2>

    <p class="mb-5 text-left text-base leading-relaxed text-[#3a2e18]">
      ก่อนฝากหรือถอนควรตรวจยอด ช่องทางที่ระบบแสดง บัญชีรับเงิน และสถานะรายการให้ครบทุกครั้ง โดยเฉพาะชื่อบัญชีที่ควรตรงกับข้อมูลสมาชิกที่ใช้สมัคร เพราะยอดขั้นต่ำของการฝากกับยอดขั้นต่ำที่โปรโมชั่นกำหนดเป็นคนละตัวเลขกัน และรายการที่ชื่อไม่ตรงมักถูกตีกลับให้แก้ไขก่อนเสมอ
    </p>

    <p class="mb-8 text-left text-base leading-relaxed text-[#3a2e18]">
      หากรายการยังประมวลผลอยู่ ไม่ควรกดซ้ำทันที เพราะธุรกรรมเดียวอาจงอกเป็นสองรายการจนต้องตามตรวจย้อนหลัง ให้เช็กสถานะและหลักฐานก่อนแล้วค่อยแจ้งทีมงาน ส่วนเกมที่ร่วมรายการควรดูให้ตรงหมวด เพราะสล็อตกับเกม Live สดอย่างบาคาร่า รูเล็ต และแบล็คแจ็ค มักนับยอดไม่เท่ากันในแต่ละแคมเปญ
    </p>

    <div class="mx-auto grid w-full max-w-7xl grid-cols-1 gap-6 px-4 sm:grid-cols-2 lg:grid-cols-2 xl:grid-cols-2">
      <Picture
        src={pro1}
        alt="WINUP888 คาสิโนบนมือถือ รวมสล็อต บาคาร่า และเกม Live สด 24 ชม. ไว้ในระบบเดียว"
        loading="lazy"
        fetchpriority="low"
        widths={[200, 400, 600, 800]}
        sizes="(max-width: 768px) 100vw, 50vw"
        class="mx-auto h-auto w-full rounded-xl border border-amber-600/25 object-contain shadow-[0_10px_30px_rgba(168,132,44,0.18)] transition-transform duration-300 hover:-translate-y-1 hover:border-amber-600/50 hover:shadow-[0_15px_40px_rgba(168,132,44,0.30)]"
        decoding="async"
        formats={["avif", "webp"]}
        fallbackFormat="webp"
        quality={80}
      />

      <Picture
        src={pro2}
        alt="เกม Live สดของ WINUP888 ทั้งบาคาร่า รูเล็ต แบล็คแจ็ค และโต๊ะ Live Dealer บนมือถือ"
        loading="lazy"
        fetchpriority="low"
        widths={[200, 400, 600, 800]}
        sizes="(max-width: 768px) 100vw, 50vw"
        class="mx-auto h-auto w-full rounded-xl border border-amber-600/25 object-contain shadow-[0_10px_30px_rgba(168,132,44,0.18)] transition-transform duration-300 hover:-translate-y-1 hover:border-amber-600/50 hover:shadow-[0_15px_40px_rgba(168,132,44,0.30)]"
        decoding="async"
        formats={["avif", "webp"]}
        fallbackFormat="webp"
        quality={80}
      />

      <Picture
        src={pro3}
        alt="รวมหมวดเกมยอดนิยมของ WINUP888 ทั้ง KENO E-Games และเกม Live สดที่เลือกเล่นผ่านมือถือได้"
        loading="lazy"
        fetchpriority="low"
        widths={[200, 400, 600, 800]}
        sizes="(max-width: 768px) 100vw, 50vw"
        class="mx-auto h-auto w-full rounded-xl border border-amber-600/25 object-contain shadow-[0_10px_30px_rgba(168,132,44,0.18)] transition-transform duration-300 hover:-translate-y-1 hover:border-amber-600/50 hover:shadow-[0_15px_40px_rgba(168,132,44,0.30)]"
        decoding="async"
        formats={["avif", "webp"]}
        fallbackFormat="webp"
        quality={80}
      />

      <Picture
        src={pro4}
        alt="สล็อตหลายค่ายของ WINUP888 พร้อมโหมดทดลองและเกมใหม่ที่เลือกเล่นบนมือถือได้ในระบบเดียว"
        loading="lazy"
        fetchpriority="low"
        widths={[200, 400, 600, 800]}
        sizes="(max-width: 768px) 100vw, 50vw"
        class="mx-auto h-auto w-full rounded-xl border border-amber-600/25 object-contain shadow-[0_10px_30px_rgba(168,132,44,0.18)] transition-transform duration-300 hover:-translate-y-1 hover:border-amber-600/50 hover:shadow-[0_15px_40px_rgba(168,132,44,0.30)]"
        decoding="async"
        formats={["avif", "webp"]}
        fallbackFormat="webp"
        quality={80}
      />
    </div>
    <div class="mt-12 flex justify-center pb-4">
      <a
        href="/register"
        class="flex items-center justify-center rounded-lg border border-[#c9a227]/60 bg-gradient-to-r from-[#f4dfa3] via-[#d9b45c] to-[#a97f2a] px-10 py-3.5 text-lg font-black text-[#231a06] shadow-[0_10px_30px_rgba(168,132,44,0.18)] transition-transform hover:scale-105 hover:shadow-[0_15px_40px_rgba(168,132,44,0.30)]">
        รับโปรโมชั่นทันที
      </a>
    </div>
  </ContentBox>

  <Navfoot />
</MainLayout>
