---
import MainLayout from "../layouts/MainLayout.astro";
import ContentBox from "../components/ContentBoxHuay.astro";
import Navfoot from "../components/Navfoot.astro";
import Announcement from "../components/Announcement5.astro";

import { Picture } from "astro:assets";

import pro1 from "../assets/slide1.png";
import pro2 from "../assets/slide2.png";
import pro3 from "../assets/slide3.png";
import pro4 from "../assets/slide4.png";
---

<MainLayout
  title="โปรโมชั่น CASHOT123 เว็บออนไลน์คาสิโน สิทธิประโยชน์เว็บตรงครบวงจร"
  description="อัปเดตโปรโมชั่น CASHOT123 เว็บออนไลน์คาสิโน เว็บตรงครบวงจร รวมสิทธิประโยชน์และกิจกรรมสำหรับสมาชิก พร้อมระบบฝากถอนอัตโนมัติ ตลอด 24 ชั่วโมง">
  <Announcement />

  <ContentBox>
    <h1 class="mb-5 bg-gradient-to-r from-amber-300 to-amber-500 bg-clip-text text-3xl font-black tracking-widest text-transparent uppercase drop-shadow-sm">โปรโมชั่น CASHOT123</h1>

    <p class="mb-8 text-red-50/80">
      สมาชิกสามารถติดตาม <strong class="text-amber-300">โปรโมชั่น CASHOT123</strong> กิจกรรม และสิทธิประโยชน์ที่เว็บไซต์จัดเตรียมไว้ในแต่ละช่วงเวลา เพื่อเลือกใช้งานให้เหมาะกับรูปแบบการเล่นและความสนใจของตนเอง ทั้งเกมสล็อต คาสิโนสด กีฬา และหวย
      ภายใต้โครงสร้างแบบเว็บตรงครบวงจรที่เชื่อมทุกฟังก์ชันเข้าด้วยกัน พร้อมระบบฝากถอนอัตโนมัติที่ใช้งานได้ด้วยตนเองตลอด 24 ชั่วโมง
    </p>

    <div class="mx-auto grid w-full max-w-7xl grid-cols-1 gap-6 px-4 sm:grid-cols-2 lg:grid-cols-2 xl:grid-cols-2">
      <Picture
        src={pro1}
        alt="โปรโมชั่น CASHOT123 มาตรฐานความปลอดภัย HTTPS เข้ารหัส SSL/TLS 256-bit"
        loading="lazy"
        fetchpriority="low"
        widths={[200, 400, 600, 800]}
        sizes="(max-width: 768px) 100vw, 50vw"
        class="mx-auto h-auto w-full rounded-xl border border-red-500/40 object-contain shadow-[0_10px_30px_rgba(220,38,38,0.35)] transition-transform duration-300 hover:-translate-y-1 hover:border-red-500 hover:shadow-[0_10px_30px_rgba(220,38,38,0.5)]"
        decoding="async"
        formats={["avif", "webp"]}
        fallbackFormat="webp"
        quality={80}
      />

      <Picture
        src={pro2}
        alt="โปรโมชั่น CASHOT123 ระบบฝากถอนอัตโนมัติ ใช้งานได้ตลอด 24 ชั่วโมง"
        loading="lazy"
        fetchpriority="low"
        widths={[200, 400, 600, 800]}
        sizes="(max-width: 768px) 100vw, 50vw"
        class="mx-auto h-auto w-full rounded-xl border border-red-500/40 object-contain shadow-[0_10px_30px_rgba(220,38,38,0.35)] transition-transform duration-300 hover:-translate-y-1 hover:border-red-500 hover:shadow-[0_10px_30px_rgba(220,38,38,0.5)]"
        decoding="async"
        formats={["avif", "webp"]}
        fallbackFormat="webp"
        quality={80}
      />

      <Picture
        src={pro3}
        alt="โปรโมชั่น CASHOT123 รีวิวเว็บตรงครบวงจร จากการทดลองใช้งานจริง"
        loading="lazy"
        fetchpriority="low"
        widths={[200, 400, 600, 800]}
        sizes="(max-width: 768px) 100vw, 50vw"
        class="mx-auto h-auto w-full rounded-xl border border-red-500/40 object-contain shadow-[0_10px_30px_rgba(220,38,38,0.35)] transition-transform duration-300 hover:-translate-y-1 hover:border-red-500 hover:shadow-[0_10px_30px_rgba(220,38,38,0.5)]"
        decoding="async"
        formats={["avif", "webp"]}
        fallbackFormat="webp"
        quality={80}
      />

      <Picture
        src={pro4}
        alt="โปรโมชั่น CASHOT123 แพลตฟอร์มเดียว รวมสล็อต คาสิโนสด กีฬา หวย"
        loading="lazy"
        fetchpriority="low"
        widths={[200, 400, 600, 800]}
        sizes="(max-width: 768px) 100vw, 50vw"
        class="mx-auto h-auto w-full rounded-xl border border-red-500/40 object-contain shadow-[0_10px_30px_rgba(220,38,38,0.35)] transition-transform duration-300 hover:-translate-y-1 hover:border-red-500 hover:shadow-[0_10px_30px_rgba(220,38,38,0.5)]"
        decoding="async"
        formats={["avif", "webp"]}
        fallbackFormat="webp"
        quality={80}
      />
    </div>
    <div class="mt-12 flex justify-center pb-4">
      <a
        href="/register"
        class="flex items-center justify-center rounded-lg border border-amber-400/40 bg-gradient-to-r from-red-600 to-red-800 px-10 py-3.5 text-lg font-black text-amber-100 shadow-[0_10px_30px_rgba(220,38,38,0.35)] transition-transform hover:scale-105 hover:shadow-[0_10px_30px_rgba(220,38,38,0.5)]">
        รับโปรโมชั่นทันที
      </a>
    </div>
  </ContentBox>

  <Navfoot />

  <style>
    :global(.text-purple-gradient) {
      background: linear-gradient(to bottom, #fef08a 0%, #f59e0b 100%) !important;
      -webkit-background-clip: text !important;
      -webkit-text-fill-color: transparent !important;
    }
  </style>
</MainLayout>
