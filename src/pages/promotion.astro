---
import MainLayout from "../layouts/MainLayout.astro";
import ContentBox from "../components/ContentBoxHuay.astro";
import Navfoot from "../components/Navfoot.astro";
import Announcement from "../components/Announcement2.astro";

import { Picture } from "astro:assets";

import pro1 from "../assets/slide1.png";
import pro2 from "../assets/slide2.png";
import pro3 from "../assets/slide3.png";
import pro4 from "../assets/slide4.png";
---

<MainLayout
  title="โปรโมชั่น UFAYES เงื่อนไขรับสิทธิ์ ยอดเทิร์น และวงเงินถอนที่ควรตรวจสอบ"
  description="รวมข้อมูลโปรโมชั่น UFAYES เว็บตรง UFABET ตรวจสอบยอดฝากขั้นต่ำ ระยะเวลารับสิทธิ์ เกมที่ร่วมรายการ ยอดเทิร์น และวงเงินถอน ก่อนกดรับสิทธิ์ทุกแคมเปญ">
  <Announcement />

  <ContentBox>
    <h1 class="mb-5 bg-gradient-to-r from-white via-red-100 to-red-400 bg-clip-text text-3xl font-black tracking-widest text-transparent uppercase drop-shadow-sm">โปรโมชั่น UFAYES</h1>

    <h2 class="mb-4 text-2xl font-bold text-red-300">โปรโมชั่น UFAYES ต้องตรวจสอบเงื่อนไขอะไรบ้างก่อนรับสิทธิ์</h2>

    <p class="mb-5 text-left text-base leading-relaxed text-red-50/85">
      ก่อนรับโปรโมชั่น <strong class="text-red-300">UFAYES</strong> ควรตรวจสอบยอดฝากขั้นต่ำ ระยะเวลารับสิทธิ์ เกมที่ร่วมรายการ ยอดเทิร์น และวงเงินถอน เพราะแต่ละแคมเปญอาจมีเงื่อนไขแตกต่างกัน
    </p>

    <p class="mb-8 text-left text-base leading-relaxed text-red-50/85">
      ไม่ควรตัดสินใจจากจำนวนโบนัสเพียงอย่างเดียว เนื่องจากบางเกมอาจไม่นับยอดเทิร์นเต็มจำนวน หรือกำหนดให้ทำรายการภายในเวลาที่ระบุ การอ่านเงื่อนไขล่วงหน้าช่วยลดปัญหาถอนเงินไม่ได้หรือมียอดเทิร์นค้าง
    </p>

    <div class="mx-auto grid w-full max-w-7xl grid-cols-1 gap-6 px-4 sm:grid-cols-2 lg:grid-cols-2 xl:grid-cols-2">
      <Picture
        src={pro1}
        alt="โปรโมชั่น UFAYES เว็บพนันอันดับ 1 การันตีมาตรฐานสากล"
        loading="lazy"
        fetchpriority="low"
        widths={[200, 400, 600, 800]}
        sizes="(max-width: 768px) 100vw, 50vw"
        class="mx-auto h-auto w-full rounded-xl border border-red-500/40 object-contain shadow-[0_10px_30px_rgba(220,38,38,0.35)] transition-transform duration-300 hover:-translate-y-1 hover:border-red-500 hover:shadow-[0_10px_30px_rgba(220,38,38,0.5)]"
        decoding="async"
        formats={["avif", "webp"]}
        fallbackFormat="webp"
        quality={80}
      />

      <Picture
        src={pro2}
        alt="โปรโมชั่น UFAYES แจกเงินคืนทุกยอดเล่น รับโบนัส 0.4%"
        loading="lazy"
        fetchpriority="low"
        widths={[200, 400, 600, 800]}
        sizes="(max-width: 768px) 100vw, 50vw"
        class="mx-auto h-auto w-full rounded-xl border border-red-500/40 object-contain shadow-[0_10px_30px_rgba(220,38,38,0.35)] transition-transform duration-300 hover:-translate-y-1 hover:border-red-500 hover:shadow-[0_10px_30px_rgba(220,38,38,0.5)]"
        decoding="async"
        formats={["avif", "webp"]}
        fallbackFormat="webp"
        quality={80}
      />

      <Picture
        src={pro3}
        alt="โปรโมชั่น UFAYES สมัครใหม่ฝากแรก รับโบนัสฟรี 50%"
        loading="lazy"
        fetchpriority="low"
        widths={[200, 400, 600, 800]}
        sizes="(max-width: 768px) 100vw, 50vw"
        class="mx-auto h-auto w-full rounded-xl border border-red-500/40 object-contain shadow-[0_10px_30px_rgba(220,38,38,0.35)] transition-transform duration-300 hover:-translate-y-1 hover:border-red-500 hover:shadow-[0_10px_30px_rgba(220,38,38,0.5)]"
        decoding="async"
        formats={["avif", "webp"]}
        fallbackFormat="webp"
        quality={80}
      />

      <Picture
        src={pro4}
        alt="โปรโมชั่น UFAYES ระบบฝากถอนออโต้ทันใจ ตัวจริงเรื่องบอล เว็บแท้ 100%"
        loading="lazy"
        fetchpriority="low"
        widths={[200, 400, 600, 800]}
        sizes="(max-width: 768px) 100vw, 50vw"
        class="mx-auto h-auto w-full rounded-xl border border-red-500/40 object-contain shadow-[0_10px_30px_rgba(220,38,38,0.35)] transition-transform duration-300 hover:-translate-y-1 hover:border-red-500 hover:shadow-[0_10px_30px_rgba(220,38,38,0.5)]"
        decoding="async"
        formats={["avif", "webp"]}
        fallbackFormat="webp"
        quality={80}
      />
    </div>
    <div class="mt-12 flex justify-center pb-4">
      <a
        href="/register"
        class="flex items-center justify-center rounded-lg border border-red-300/60 bg-gradient-to-r from-red-400 to-red-600 px-10 py-3.5 text-lg font-black text-[#140202] shadow-[0_10px_30px_rgba(220,38,38,0.35)] transition-transform hover:scale-105 hover:shadow-[0_10px_30px_rgba(220,38,38,0.55)]">
        รับโปรโมชั่นทันที
      </a>
    </div>
  </ContentBox>

  <Navfoot />
</MainLayout>
