---
import MainLayout from "../layouts/MainLayout.astro";
import ContentBox from "../components/ContentBoxCyberCut.astro";
import Navfoot from "../components/Navfoot.astro";
import Announcement from "../components/Announcement5.astro";

import { Picture } from "astro:assets";

import pro1 from "../assets/slide1.png";
import pro2 from "../assets/slide2.png";
import pro3 from "../assets/slide3.png";
import pro4 from "../assets/slide4.png";
---

<MainLayout
  title="โปรโมชั่น SUDYOD888 โบนัสสูงสุด 400% คืนยอดเสียรายสัปดาห์ และคอมมิชชั่นแนะนำเพื่อน 3–5%"
  description="รวมโปรโมชั่น SUDYOD888 ทั้งโบนัสสูงสุด 400% คืนยอดเสียรายสัปดาห์ที่กดรับทุกวันอาทิตย์หลังเวลา 12.00 น. และคอมมิชชั่นแนะนำเพื่อน 3–5% พร้อมจุดที่ควรอ่านก่อนกดรับสิทธิ์ ทั้งยอดฝากที่ร่วมรายการ จำนวนเทิร์น เกมที่ใช้โบนัสได้ และระบบฝากถอนออโต้ผ่าน Mobile Banking กับ True Wallet ถอนขั้นต่ำ 100 บาท ไม่เกิน 49,000 บาทต่อรายการ">
  <Announcement />

  <ContentBox title="โปรโมชั่น SUDYOD888" as="h1">
    <h2 class="mb-4 text-2xl leading-normal font-bold text-[#f5c53d]">โปรเด็ด SUDYOD888 มีโปรอะไร และควรอ่านเงื่อนไขตรงไหนก่อนกดรับ</h2>

    <p class="mb-5 text-left text-base leading-relaxed text-[#ece2cc]">
      ข้อมูลต้นแบบของ <strong class="text-[#ffe9a8]">SUDYOD888</strong> วางโปรไว้หลายชั้นในบัญชีเดียว ทั้งโบนัสสูงสุด 400% คืนยอดเสียรายสัปดาห์ ระบบแนะนำเพื่อนรับคอมมิชชั่น 3–5% และสล็อตที่เริ่มเดิมพันได้ตั้งแต่ 1 บาท ซึ่งอ่านบนแบนเนอร์แล้วดูตรงไปตรงมา แต่ตัวที่ตัดสินว่าคุ้มจริงหรือไม่คือเงื่อนไขบรรทัดเล็กใต้ตัวเลขใหญ่ ไม่ใช่ตัวเลขใหญ่เอง คำว่าสูงสุดจึงหมายถึงเพดานของแคมเปญ ไม่ใช่เครดิตที่ทุกคนจะได้เท่ากัน
    </p>

    <p class="mb-5 text-left text-base leading-relaxed text-[#ece2cc]">
      ก่อนกดรับสิทธิ์ควรไล่ดูให้ครบว่าแคมเปญกำหนดยอดฝากที่ร่วมรายการเท่าไร ต้องทำเทิร์นกี่เท่า เกมหมวดไหนใช้โบนัสได้ระหว่างสล็อต เกมยิงปลา และคาสิโนสด สิทธิ์มีอายุถึงเมื่อไร และรับซ้อนกับโปรตัวอื่นได้หรือไม่ เพราะบางโบนัสเพิ่มเครดิตให้จริงแต่ตัดสิทธิ์รับเงินคืนในรอบเดียวกัน หากแผนคือเล่นจบตามกำลังแล้วถอนตามยอดปกติ การไม่รับโบนัสก็เป็นทางเลือกที่สมเหตุสมผล เงื่อนไขที่อ่านก่อนใช้เวลาไม่กี่นาที ส่วนเงื่อนไขที่อ่านทีหลังมักใช้เวลาทั้งเย็น
    </p>

    <h2 class="mt-10 mb-4 text-2xl leading-normal font-bold text-[#f5c53d]">คืนยอดเสีย SUDYOD888 คิดจากยอดส่วนไหน และฝากถอนออโต้เกี่ยวกับสิทธิ์อย่างไร</h2>

    <p class="mb-5 text-left text-base leading-relaxed text-[#ece2cc]">
      คืนยอดเสียของ SUDYOD888 เป็นสิทธิ์รายสัปดาห์ที่คำนวณจากผลได้และผลเสียในรอบที่กำหนด ไม่ได้คืนจากยอดเดิมพันทั้งหมด ดังนั้นถ้าสัปดาห์นั้นยอดได้มากกว่ายอดเสีย ระบบก็จะไม่มียอดให้รับคืน สิ่งที่ต้องตรวจต่อคือช่วงเวลากดรับ เพราะสิทธิ์เปิดให้ตรวจและกดรับทุกวันอาทิตย์หลังเวลา 12.00 น. และมีหน้าต่างเวลาจำกัด นอกจากนี้แต่ละหมวดยังนับยอดไม่เหมือนกัน สล็อตมักอิงยอดหมุน คาสิโนสดอาจยกเว้นบางโต๊ะ ส่วนเกมยิงปลานับตามรอบยิงที่ระบบบันทึก ใช้บัญชีเดียวกันจริง แต่กติกาไม่ได้เป็นฝาแฝดกัน
    </p>

    <p class="mb-8 text-left text-base leading-relaxed text-[#ece2cc]">
      ด้านการเงิน ระบบรองรับการฝากถอนแบบออโต้ผ่าน Mobile Banking และ True Wallet โดยเลือกยอดแล้วโอนเข้าบัญชีหรือสแกน QR ที่ระบบแสดง ส่วนการถอนกำหนดขั้นต่ำ 100 บาท และไม่เกิน 49,000 บาทต่อรายการ ระยะเวลาจริงเปลี่ยนได้ตามธนาคารและสถานะระบบ คำว่าออโต้จึงไม่ได้แปลว่าทุกครั้งจะเร็วเท่ากันเป๊ะ จุดที่คนพลาดบ่อยคือยอดขั้นต่ำของการฝากกับยอดขั้นต่ำที่โปรกำหนดเป็นคนละตัวเลข และบัญชีที่ใช้ทำรายการควรเป็นชื่อเดียวกับข้อมูลที่สมัครไว้ หากรายการยังประมวลผลอยู่ให้เก็บสลิปกับเลขอ้างอิงไว้แล้วเช็กสถานะก่อน การกดซ้ำไม่ได้ทำให้เร็วขึ้น มันแค่เพิ่มรายการให้ต้องตามตรวจ
    </p>

    <div class="mx-auto grid w-full max-w-7xl grid-cols-1 gap-6 px-4 sm:grid-cols-2 lg:grid-cols-2 xl:grid-cols-2">
      <Picture
        src={pro1}
        alt="SUDYOD888 รวมเกมสล็อต เกมยิงปลา และคาสิโนสดมากกว่า 200 รายการไว้ในบัญชีเดียว"
        loading="lazy"
        fetchpriority="low"
        widths={[200, 400, 600, 800]}
        sizes="(max-width: 768px) 100vw, 50vw"
        class="mx-auto h-auto w-full rounded-xl border border-[#f5c53d]/25 object-contain shadow-[0_10px_30px_rgba(245,197,61,0.18)] transition-transform duration-300 hover:-translate-y-1 hover:border-[#f5c53d]/50 hover:shadow-[0_15px_40px_rgba(245,197,61,0.30)]"
        decoding="async"
        formats={["avif", "webp"]}
        fallbackFormat="webp"
        quality={80}
      />

      <Picture
        src={pro2}
        alt="โบนัสสูงสุด 400% ของ SUDYOD888 พร้อมเงื่อนไขยอดฝากที่ร่วมรายการ จำนวนเทิร์น และเกมที่ใช้โบนัสได้"
        loading="lazy"
        fetchpriority="low"
        widths={[200, 400, 600, 800]}
        sizes="(max-width: 768px) 100vw, 50vw"
        class="mx-auto h-auto w-full rounded-xl border border-[#f5c53d]/25 object-contain shadow-[0_10px_30px_rgba(245,197,61,0.18)] transition-transform duration-300 hover:-translate-y-1 hover:border-[#f5c53d]/50 hover:shadow-[0_15px_40px_rgba(245,197,61,0.30)]"
        decoding="async"
        formats={["avif", "webp"]}
        fallbackFormat="webp"
        quality={80}
      />

      <Picture
        src={pro3}
        alt="คืนยอดเสียรายสัปดาห์ของ SUDYOD888 คิดจากผลได้และผลเสียในรอบ กดรับทุกวันอาทิตย์หลังเวลา 12.00 น."
        loading="lazy"
        fetchpriority="low"
        widths={[200, 400, 600, 800]}
        sizes="(max-width: 768px) 100vw, 50vw"
        class="mx-auto h-auto w-full rounded-xl border border-[#f5c53d]/25 object-contain shadow-[0_10px_30px_rgba(245,197,61,0.18)] transition-transform duration-300 hover:-translate-y-1 hover:border-[#f5c53d]/50 hover:shadow-[0_15px_40px_rgba(245,197,61,0.30)]"
        decoding="async"
        formats={["avif", "webp"]}
        fallbackFormat="webp"
        quality={80}
      />

      <Picture
        src={pro4}
        alt="SUDYOD888 ฝากถอนออโต้ผ่าน Mobile Banking และ True Wallet ถอนขั้นต่ำ 100 บาท ไม่เกิน 49,000 บาทต่อรายการ"
        loading="lazy"
        fetchpriority="low"
        widths={[200, 400, 600, 800]}
        sizes="(max-width: 768px) 100vw, 50vw"
        class="mx-auto h-auto w-full rounded-xl border border-[#f5c53d]/25 object-contain shadow-[0_10px_30px_rgba(245,197,61,0.18)] transition-transform duration-300 hover:-translate-y-1 hover:border-[#f5c53d]/50 hover:shadow-[0_15px_40px_rgba(245,197,61,0.30)]"
        decoding="async"
        formats={["avif", "webp"]}
        fallbackFormat="webp"
        quality={80}
      />
    </div>
    <div class="mt-12 flex justify-center pb-4">
      <a
        href="/register"
        class="flex items-center justify-center rounded-lg border border-[#f5c53d]/60 bg-gradient-to-r from-[#ffe9a8] via-[#f5c53d] to-[#c8921e] px-10 py-3.5 text-lg font-black text-[#080503] shadow-[0_10px_30px_rgba(245,197,61,0.18)] transition-transform hover:scale-105 hover:shadow-[0_15px_40px_rgba(245,197,61,0.30)]">
        รับโปรโมชั่นทันที
      </a>
    </div>
  </ContentBox>

  <Navfoot />
</MainLayout>
