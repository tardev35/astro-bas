---
import MainLayout from "../layouts/MainLayout.astro";
import ContentBox from "../components/ContentBox.astro";
import Navfoot from "../components/Navfoot.astro";
import Announcement from "../components/Announcement2.astro";

import { Picture } from "astro:assets";

import pro1 from "../assets/slide1.png";
import pro2 from "../assets/slide2.png";
import pro3 from "../assets/slide3.png";
import pro4 from "../assets/slide4.png";
---

<MainLayout title="โปรโมชั่น CHOKDEE1688 คู่มือการใช้งานเว็บ" description="รวมโปรโมชั่น CHOKDEE1688 แนะนำเพื่อนรับ 0.8% เล่นเสียมีคืนรับ 0.3% วิธีฝากถอน ขั้นตอนการสมัครสมาชิก">
  <Announcement />

  <ContentBox>
    <h1 class="mb-5 bg-gradient-to-r from-amber-200 to-emerald-500 bg-clip-text text-3xl font-black tracking-widest text-transparent uppercase drop-shadow-sm">โปรโมชั่น CHOKDEE1688</h1>

    <div class="mx-auto grid w-full max-w-7xl grid-cols-1 gap-6 px-4 sm:grid-cols-2 lg:grid-cols-2 xl:grid-cols-2">
      <Picture
        src={pro1}
        alt="CHOKDEE1688 คู่มือการใช้งานเว็บและกติกาเกม"
        loading="lazy"
        fetchpriority="low"
        widths={[200, 400, 600, 800]}
        sizes="(max-width: 768px) 100vw, 50vw"
        class="mx-auto h-auto w-full rounded-xl border border-emerald-400/50 object-contain shadow-lg transition-transform duration-300 hover:-translate-y-1 hover:border-amber-300 hover:shadow-[0_10px_20px_rgba(16,185,129,0.6)]"
        decoding="async"
        formats={["avif", "webp"]}
        fallbackFormat="webp"
        quality={80}
      />

      <Picture
        src={pro2}
        alt="CHOKDEE1688 โปรโมชั่นเล่นเสียมีคืนรับ 0.3%"
        loading="lazy"
        fetchpriority="low"
        widths={[200, 400, 600, 800]}
        sizes="(max-width: 768px) 100vw, 50vw"
        class="mx-auto h-auto w-full rounded-xl border border-emerald-400/50 object-contain shadow-lg transition-transform duration-300 hover:-translate-y-1 hover:border-amber-300 hover:shadow-[0_10px_20px_rgba(16,185,129,0.6)]"
        decoding="async"
        formats={["avif", "webp"]}
        fallbackFormat="webp"
        quality={80}
      />

      <Picture
        src={pro3}
        alt="CHOKDEE1688 โปรโมชั่นแนะนำเพื่อนรับ 0.8%"
        loading="lazy"
        fetchpriority="low"
        widths={[200, 400, 600, 800]}
        sizes="(max-width: 768px) 100vw, 50vw"
        class="mx-auto h-auto w-full rounded-xl border border-emerald-400/50 object-contain shadow-lg transition-transform duration-300 hover:-translate-y-1 hover:border-amber-300 hover:shadow-[0_10px_20px_rgba(16,185,129,0.6)]"
        decoding="async"
        formats={["avif", "webp"]}
        fallbackFormat="webp"
        quality={80}
      />

      <Picture
        src={pro4}
        alt="CHOKDEE1688 วิธีฝากถอนและขั้นตอนการสมัครสมาชิก"
        loading="lazy"
        fetchpriority="low"
        widths={[200, 400, 600, 800]}
        sizes="(max-width: 768px) 100vw, 50vw"
        class="mx-auto h-auto w-full rounded-xl border border-emerald-400/50 object-contain shadow-lg transition-transform duration-300 hover:-translate-y-1 hover:border-amber-300 hover:shadow-[0_10px_20px_rgba(16,185,129,0.6)]"
        decoding="async"
        formats={["avif", "webp"]}
        fallbackFormat="webp"
        quality={80}
      />
    </div>
    <div class="mt-12 flex justify-center pb-4">
      <a
        href="/register"
        class="flex items-center justify-center rounded-full bg-gradient-to-r from-amber-400 via-amber-500 to-yellow-600 px-10 py-3.5 text-lg font-black text-emerald-950 shadow-[0_5px_20px_rgba(251,191,36,0.4)] transition-all duration-300 hover:-translate-y-1 hover:scale-105 hover:shadow-[0_8px_25px_rgba(251,191,36,0.6)]">
        รับโปรโมชั่นทันที
      </a>
    </div>
  </ContentBox>

  <Navfoot />
</MainLayout>
