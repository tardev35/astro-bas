---
import MainLayout from "../layouts/MainLayout.astro";
import ContentBox from "../components/ContentBox.astro";
import Navfoot from "../components/Navfoot.astro";
import Announcement from "../components/Announcement3.astro";

import { Picture } from "astro:assets";

// Only the two slides below belong to THIS brand's drop (2026-08-10). The
// remaining slide files in src/assets are the previous brand's banners and
// carry its logo across the whole image, so they are neither imported nor
// rendered — an image imported without being rendered still gets emitted into
// dist/, so this list and the grid below must stay in step.
import pro1 from "../assets/slide1.png";
import pro2 from "../assets/slide2.png";
import { pageGraph } from "../lib/schema";

// This is an IMAGE page, not an article: one h1 (the ContentBox title), ONE
// short intro paragraph, the slide grid, one CTA. h2×0 by design — each slide
// already states its own offer in large type, so prose under it just re-types
// what the visitor can already read. Do not add section headings back.

// 157 CHARACTERS (not bytes — Thai is 3 bytes/char, so a byte count reads ~3x
// too long). The brief's own sentence is 138 characters, under
// verify-build.mjs's 150 floor, so the trailing clause is built from this
// brand's own vocabulary and brings it into the 150–160 window without
// changing what the brief says.
const pageDescription =
  "อัปเดตสิทธิพิเศษและแคมเปญที่ดีที่สุดจาก ROMAN555 รับโบนัสสุดคุ้มเพื่อต่อยอดเงินทุนของคุณให้เติบโตอย่างแข็งแกร่ง รับสิทธิ์ง่ายผ่านระบบออโต้ ทางเข้าหลักเว็บตรง";

// Each alt is the text PRINTED on that slide, read off the artwork itself —
// never a counter like "ภาพที่ 3".
const promos = [
  {
    src: pro1,
    alt: "แบนเนอร์โปรโมชั่น ROMAN555 คืนยอดเสีย 15% ตัวเลขสีทองขนาดใหญ่บนพื้นดำ พร้อมข้อความ เสียเท่าไหร่ เราคืนให้ 15% มีโลโก้โจ๊กเกอร์ ROMAN555 หญิงสาวชุดทอง เหรียญทองกระจายรอบภาพ แถบไอคอนด้านล่าง โปรโมชั่นจัดเต็มทุกวัน สล็อตแตกง่ายจ่ายจริง 100% คืนยอดเสียสูงสุด 15% แนะนำเพื่อนรับค่าคอม 0.8% บริการลูกค้า 24 ชั่วโมง และแถบ ฝาก-ถอน รวดเร็ว ภายใน 30 วินาที",
  },
  {
    src: pro2,
    alt: "แบนเนอร์โปรโมชั่น ROMAN555 แนะนำเพื่อน รับค่าคอม 0.8% ตัวเลขสีทองบนพื้นดำ พร้อมข้อความ ชวนเพื่อนมาสนุก รับรายได้ไม่จำกัด มีโลโก้โจ๊กเกอร์ ROMAN555 หญิงสาวชุดทอง และขั้นตอน 3 ข้อ รับลิงก์ชวนเพื่อนจากหน้าเว็บ แนะนำเพื่อนให้มาสมัคร เพื่อนเล่น คุณรับค่าคอมทันที 0.8% แถบไอคอนด้านล่าง โปรโมชั่นจัดเต็มทุกวัน สล็อตแตกง่ายจ่ายจริง 100% คืนยอดเสียสูงสุด 15% และแถบ สมัครง่าย เล่นได้ทันที",
  },
];

const graph = pageGraph(Astro, {
  name: "ROMAN555 โปรโมชั่น แจกหนักทุนเสริม ยกระดับความมั่งคั่ง",
  description: pageDescription,
  breadcrumb: [
    { name: "หน้าแรก", path: "/" },
    { name: "โปรโมชั่น", path: "/promotion" },
  ],
  primaryImagePath: pro1.src,
});
---

<MainLayout title="ROMAN555 โปรโมชั่น แจกหนักทุนเสริม ยกระดับความมั่งคั่ง" description={pageDescription}>
  <script type="application/ld+json" set:html={graph} />

  <Announcement />

  <ContentBox title="โปรโมชั่น ROMAN555 แจกหนักทุนเสริม ยกระดับความมั่งคั่ง" as="h1">
    <p class="mb-8 text-left text-base leading-relaxed text-[#f2e4c4]">
      หน้านี้คือที่รวมสิทธิพิเศษและแคมเปญเสริมทุนทุกรายการที่ <strong class="text-[#f6cf6a]">ROMAN555</strong> เปิดให้สมาชิกกดรับเองได้ผ่านเมนูอัตโนมัติบนแดชบอร์ดส่วนตัว
      รายละเอียดของแต่ละแคมเปญอยู่บนภาพด้านล่างนี้ทั้งหมด ทั้งยอดที่ได้รับ รอบการแจก และสิ่งที่ต้องทำเพื่อรับสิทธิ์ เงื่อนไขและรอบการคำนวณของแต่ละแคมเปญไม่เหมือนกัน
      จึงควรอ่านให้จบก่อนกดรับทุกครั้ง
    </p>

    <div class="grid grid-cols-1 gap-6 sm:grid-cols-2">
      {
        promos.map((promo) => (
          <Picture
            src={promo.src}
            alt={promo.alt}
            loading="lazy"
            fetchpriority="low"
            widths={[320, 640, 960]}
            sizes="(max-width: 639px) 100vw, 50vw"
            class="mx-auto h-auto w-full rounded-xl border border-[#a8690a]/35 object-contain shadow-[0_10px_30px_rgba(246,207,106,0.18)] transition-transform duration-300 hover:-translate-y-1 hover:border-[#f6cf6a]/70 hover:shadow-[0_15px_40px_rgba(168,105,10,0.32)]"
            decoding="async"
            formats={["avif", "webp"]}
            fallbackFormat="webp"
            quality={80}
          />
        ))
      }
    </div>

    <div class="mt-12 flex justify-center pb-4">
      <a
        href="/register"
        class="flex items-center justify-center rounded-lg border border-[#f6cf6a]/50 bg-gradient-to-r from-[#fbeab0] via-[#f6cf6a] to-[#7a4405] px-10 py-3.5 text-lg font-black text-[#1a1002] shadow-[0_10px_30px_rgba(246,207,106,0.22)] transition-transform hover:scale-105 hover:shadow-[0_15px_40px_rgba(168,105,10,0.35)]">
        สมัครสมาชิก ROMAN555
      </a>
    </div>
  </ContentBox>

  <Navfoot />
</MainLayout>
