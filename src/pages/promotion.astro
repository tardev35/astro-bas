---
import MainLayout from "../layouts/MainLayout.astro";
import ContentBox from "../components/ContentBoxHuay.astro";
import Navfoot from "../components/Navfoot.astro";
import Announcement from "../components/Announcement5.astro";

import { Picture } from "astro:assets";

// slide4.png is a leftover from the previous brand (its logo is burned into the
// artwork) — the file stays in src/assets as inventory but must not render.
import pro1 from "../assets/slide1.png";
import pro2 from "../assets/slide2.png";
import pro3 from "../assets/slide3.png";
---

<MainLayout
  title="BUNNY555 โปรโมชั่น รับโปรโมชั่นสุดคุ้ม ทะยานสู่ความสำเร็จ" description="อัปเดตสิทธิพิเศษล่าสุดจาก BUNNY555 จัดเต็มเพื่อสมาชิกทุกคน รับโปรโมชั่นสุดคุ้ม ได้ง่ายๆ ผ่านระบบออโต้ ยกระดับทุนของคุณให้ก้าวกระโดดไวขึ้น">
  <Announcement />

  <ContentBox title="โปรโมชั่น BUNNY555" as="h1">
    <div>
      <h2 class="mb-4 text-2xl font-bold text-pink-200">คืนยอดเสีย 15% สมาชิกใหม่รับเพิ่ม 100% และเครดิตฟรีจากฝากแรก</h2>

      <p class="mb-5 text-left text-base leading-relaxed text-pink-50/85">
        สิทธิพิเศษที่ <strong class="text-pink-200">BUNNY555</strong> จัดเต็มให้สมาชิกทุกคนถูกวางไว้ครบตั้งแต่ก้าวแรก ทั้งคืนยอดเสีย 15% ทุกวัน โบนัสสมาชิกใหม่รับเพิ่ม 100% ตั้งแต่ครั้งแรกที่สมัคร และสิทธิ์ลุ้นรับเครดิตฟรีเพิ่มจากยอดฝากแรก ทุกแคมเปญคำนวณมาเพื่อให้ทุนของคุณก้าวกระโดดไวขึ้นอย่างคุ้มค่าที่สุด
      </p>

      <p class="mb-5 text-left text-base leading-relaxed text-pink-50/85">
        ก่อนกดรับสิทธิ์ควรดูว่าเปอร์เซ็นต์คิดจากยอดใด รับได้กี่ครั้งต่อรอบ และรองรับเกมจากค่ายไหนบ้าง เพราะแต่ละแคมเปญตั้งเงื่อนไขไม่เหมือนกัน การอ่านรายละเอียดล่วงหน้าเพียงไม่กี่วินาทีช่วยให้คุณเลือกโปรที่ตรงกับสไตล์การเล่นของตัวเองได้แม่นยำและได้ความคุ้มค่าสูงสุด
      </p>

      <h2 class="mt-10 mb-4 text-2xl font-bold text-pink-200">กดรับสิทธิ์เองผ่านระบบออโต้ ยอดเทิร์นและเงื่อนไขที่ควรอ่านก่อน</h2>

      <p class="mb-5 text-left text-base leading-relaxed text-pink-50/85">
        ทุกโปรโมชั่นของ BUNNY555 กดรับได้ด้วยตนเองผ่านหน้าระบบอัตโนมัติ ไม่ต้องรอแอดมินยืนยันและไม่ต้องส่งสลิปให้เสียเวลา ระบบประมวลผลไวจนสิทธิ์เข้าแดชบอร์ดในเสี้ยววินาที ทำให้คุณกลับไปโฟกัสกับเกมที่กำลังเล่นได้ต่อเนื่อง ลื่นไหล ไม่มีจังหวะสะดุดกลางทาง
      </p>

      <p class="mb-8 text-left text-base leading-relaxed text-pink-50/85">
        ส่วนที่สำคัญกว่าตัวเลขบนแบนเนอร์คือยอดเทิร์น เพดานถอน และวันหมดอายุของสิทธิ์ เราจึงเปิดเงื่อนไขทั้งหมดไว้อย่างโปร่งใสไม่มีข้อความแอบแฝง ตรวจให้ครบก่อนกดรับทุกครั้ง แล้วคุณจะถอนได้ราบรื่นโดยไม่ต้องกังวลว่ามียอดเทิร์นค้างอยู่ในระบบ
      </p>

      <div class="mx-auto grid w-full max-w-7xl grid-cols-1 gap-6 px-4 sm:grid-cols-2 lg:grid-cols-3">
        <Picture
          src={pro1}
          alt="โปรโมชั่น BUNNY555 คืนยอดเสีย 15% ทุกวัน รับคืนอัตโนมัติ"
          loading="lazy"
          fetchpriority="low"
          widths={[200, 400, 600, 800]}
          sizes="(max-width: 768px) 100vw, 33vw"
          class="mx-auto h-auto w-full rounded-xl border border-pink-500/40 object-contain shadow-[0_10px_30px_rgba(236,72,153,0.35)] transition-transform duration-300 hover:-translate-y-1 hover:border-pink-400 hover:shadow-[0_10px_30px_rgba(236,72,153,0.5)]"
          decoding="async"
          formats={["avif", "webp"]}
          fallbackFormat="webp"
          quality={80}
        />

        <Picture
          src={pro2}
          alt="โปรโมชั่น BUNNY555 สมาชิกใหม่รับเพิ่ม 100% ตั้งแต่ครั้งแรกที่สมัคร"
          loading="lazy"
          fetchpriority="low"
          widths={[200, 400, 600, 800]}
          sizes="(max-width: 768px) 100vw, 33vw"
          class="mx-auto h-auto w-full rounded-xl border border-rose-500/40 object-contain shadow-[0_10px_30px_rgba(190,24,93,0.35)] transition-transform duration-300 hover:-translate-y-1 hover:border-rose-400 hover:shadow-[0_10px_30px_rgba(190,24,93,0.5)]"
          decoding="async"
          formats={["avif", "webp"]}
          fallbackFormat="webp"
          quality={80}
        />

        <Picture
          src={pro3}
          alt="โปรโมชั่น BUNNY555 ฝากแรกลุ้นรับเครดิตฟรีเพิ่ม ไม่จำกัดบาท"
          loading="lazy"
          fetchpriority="low"
          widths={[200, 400, 600, 800]}
          sizes="(max-width: 768px) 100vw, 33vw"
          class="mx-auto h-auto w-full rounded-xl border border-pink-500/40 object-contain shadow-[0_10px_30px_rgba(236,72,153,0.35)] transition-transform duration-300 hover:-translate-y-1 hover:border-pink-400 hover:shadow-[0_10px_30px_rgba(236,72,153,0.5)]"
          decoding="async"
          formats={["avif", "webp"]}
          fallbackFormat="webp"
          quality={80}
        />
      </div>

      <div class="mt-12 flex justify-center pb-4">
        <a
          href="/register"
          class="flex items-center justify-center rounded-lg border border-pink-200/60 bg-gradient-to-r from-[#fce7f3] via-[#f9a8d4] to-[#db2777] px-10 py-3.5 text-lg font-black text-[#241019] shadow-[0_10px_30px_rgba(236,72,153,0.35)] transition-transform hover:scale-105 hover:shadow-[0_10px_30px_rgba(190,24,93,0.55)]">
          รับโปรโมชั่นทันที
        </a>
      </div>
    </div>
  </ContentBox>

  <Navfoot />
</MainLayout>
