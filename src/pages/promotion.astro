---
import MainLayout from "../layouts/MainLayout.astro";
import ContentBox from "../components/ContentBoxHuay.astro";
import Navfoot from "../components/Navfoot.astro";
import Announcement from "../components/Announcement.astro";

import { Picture } from "astro:assets";

import pro1 from "../assets/slide1.png";
import pro2 from "../assets/slide2.png";
import pro3 from "../assets/slide3.png";
import pro4 from "../assets/slide4.png";
---

<MainLayout
  title="โปรโมชั่น LAPDEE88 เงื่อนไขโบนัส เทิร์นโอเวอร์ และเพดานถอนที่ควรอ่านก่อนรับ"
  description="รวมโปรโมชั่น LAPDEE88 พร้อมจุดที่ต้องอ่านก่อนกดรับสิทธิ์ ทั้งยอดฝากขั้นต่ำ เทิร์นโอเวอร์ เกมที่ร่วมรายการ ระยะเวลา และเพดานถอน รวมถึงการฝากขั้นต่ำ 1 บาทผ่านระบบออโต้ที่รองรับธนาคารและ TrueMoney Wallet และเงื่อนไขการถอนที่ควรตรวจให้ครบ">
  <Announcement />

  <ContentBox>
    <h1 class="mb-5 bg-gradient-to-r from-white via-amber-100 to-amber-400 bg-clip-text text-3xl font-black tracking-widest text-transparent uppercase drop-shadow-sm">โปรโมชั่น LAPDEE88</h1>

    <h2 class="mb-4 text-2xl font-bold text-amber-200">โปรโมชั่น LAPDEE88 ต้องอ่านตรงไหนบ้างก่อนกดรับสิทธิ์</h2>

    <p class="mb-5 text-left text-base leading-relaxed text-amber-50/85">
      ก่อนรับโบนัสของ <strong class="text-amber-200">LAPDEE88</strong> ควรตรวจยอดฝากขั้นต่ำ เทิร์นโอเวอร์ เกมที่ร่วมรายการ ระยะเวลา และเพดานถอนให้ครบทุกข้อ ตัวเลขใหญ่บนแบนเนอร์ดูง่ายและดูดี แต่เงื่อนไขตัวเล็กด้านล่างมักเป็นพระเอกตัวจริงที่ตัดสินว่าสิทธิ์นั้นคุ้มกับแผนการเล่นของเราหรือไม่
    </p>

    <p class="mb-5 text-left text-base leading-relaxed text-amber-50/85">
      หากต้องการถอนตามยอดปกติ การไม่รับโบนัสอาจเหมาะกว่า เพราะยอดเทิร์นที่ค้างอยู่ทำให้ถอนไม่ได้จนกว่าจะเล่นครบ ถ้าเงื่อนไขข้อไหนไม่ชัดควรถามทีมงานก่อนกดรับสิทธิ์ ไม่ใช่รอให้ติดเทิร์นแล้วค่อยเปิดโหมดนักสืบย้อนหลัง
    </p>

    <h2 class="mt-10 mb-4 text-2xl font-bold text-amber-200">ฝากขั้นต่ำ 1 บาทและระบบออโต้ เกี่ยวกับโปรโมชั่นอย่างไร</h2>

    <p class="mb-5 text-left text-base leading-relaxed text-amber-50/85">
      ข้อมูลจากเว็บไซต์ต้นแบบระบุว่า LAPDEE88 ฝากขั้นต่ำเริ่มต้นที่ 1 บาท รองรับธนาคารและ TrueMoney Wallet ผ่านระบบอัตโนมัติ แต่ยอดขั้นต่ำของ “การฝาก” กับยอดขั้นต่ำที่ “โปรโมชั่นกำหนด” เป็นคนละตัวเลขกัน ก่อนโอนจึงควรตรวจยอด เลขบัญชี และช่องทางที่ระบบแสดงทุกครั้ง
    </p>

    <p class="mb-8 text-left text-base leading-relaxed text-amber-50/85">
      หากเครดิตไม่เข้า ให้เช็กสถานะรายการและหลักฐานก่อน อย่ารีบโอนซ้ำจนยอดซ้อน ส่วนการถอนควรตรวจขั้นต่ำ เงื่อนไขโบนัสที่ยังค้างอยู่ และชื่อบัญชีรับเงินให้ตรงกับชื่อที่ใช้สมัคร เพราะรายการที่ชื่อไม่ตรงมักถูกตีกลับให้แก้ไขก่อนเสมอ
    </p>

    <div class="mx-auto grid w-full max-w-7xl grid-cols-1 gap-6 px-4 sm:grid-cols-2 lg:grid-cols-2 xl:grid-cols-2">
      <Picture
        src={pro1}
        alt="LAPDEE88 รวมหน้าแรก สล็อต คาสิโน โปรโมชั่น และฝากถอนออโต้ไว้ในระบบเดียว"
        loading="lazy"
        fetchpriority="low"
        widths={[200, 400, 600, 800]}
        sizes="(max-width: 768px) 100vw, 50vw"
        class="mx-auto h-auto w-full rounded-xl border border-amber-500/40 object-contain shadow-[0_10px_30px_rgba(212,175,90,0.35)] transition-transform duration-300 hover:-translate-y-1 hover:border-amber-300/60 hover:shadow-[0_10px_30px_rgba(212,175,90,0.5)]"
        decoding="async"
        formats={["avif", "webp"]}
        fallbackFormat="webp"
        quality={80}
      />

      <Picture
        src={pro2}
        alt="LAPDEE88 ฝากขั้นต่ำ 1 บาทผ่านระบบออโต้ รองรับธนาคารและ TrueMoney Wallet"
        loading="lazy"
        fetchpriority="low"
        widths={[200, 400, 600, 800]}
        sizes="(max-width: 768px) 100vw, 50vw"
        class="mx-auto h-auto w-full rounded-xl border border-amber-500/40 object-contain shadow-[0_10px_30px_rgba(212,175,90,0.35)] transition-transform duration-300 hover:-translate-y-1 hover:border-amber-300/60 hover:shadow-[0_10px_30px_rgba(212,175,90,0.5)]"
        decoding="async"
        formats={["avif", "webp"]}
        fallbackFormat="webp"
        quality={80}
      />

      <Picture
        src={pro3}
        alt="ขั้นตอนสมัครสมาชิก LAPDEE88 ด้วยเบอร์โทรศัพท์และรหัส OTP"
        loading="lazy"
        fetchpriority="low"
        widths={[200, 400, 600, 800]}
        sizes="(max-width: 768px) 100vw, 50vw"
        class="mx-auto h-auto w-full rounded-xl border border-amber-500/40 object-contain shadow-[0_10px_30px_rgba(212,175,90,0.35)] transition-transform duration-300 hover:-translate-y-1 hover:border-amber-300/60 hover:shadow-[0_10px_30px_rgba(212,175,90,0.5)]"
        decoding="async"
        formats={["avif", "webp"]}
        fallbackFormat="webp"
        quality={80}
      />

      <Picture
        src={pro4}
        alt="สมัคร LAPDEE88 ใช้เวลาไม่กี่นาที กรอกเบอร์ รับ OTP และตั้งรหัสผ่าน"
        loading="lazy"
        fetchpriority="low"
        widths={[200, 400, 600, 800]}
        sizes="(max-width: 768px) 100vw, 50vw"
        class="mx-auto h-auto w-full rounded-xl border border-amber-500/40 object-contain shadow-[0_10px_30px_rgba(212,175,90,0.35)] transition-transform duration-300 hover:-translate-y-1 hover:border-amber-300/60 hover:shadow-[0_10px_30px_rgba(212,175,90,0.5)]"
        decoding="async"
        formats={["avif", "webp"]}
        fallbackFormat="webp"
        quality={80}
      />
    </div>
    <div class="mt-12 flex justify-center pb-4">
      <a
        href="/register"
        class="flex items-center justify-center rounded-lg border border-amber-200/60 bg-gradient-to-r from-[#f6e4b4] via-[#e0bd72] to-[#b1873a] px-10 py-3.5 text-lg font-black text-[#140f05] shadow-[0_10px_30px_rgba(212,175,90,0.35)] transition-transform hover:scale-105 hover:shadow-[0_10px_30px_rgba(212,175,90,0.5)]">
        รับโปรโมชั่นทันที
      </a>
    </div>
  </ContentBox>

  <Navfoot />
</MainLayout>
