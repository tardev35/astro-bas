---
import MainLayout from "../layouts/MainLayout.astro";
import ContentBox from "../components/ContentBoxHuay.astro";
import Navfoot from "../components/Navfoot.astro";
import Announcement from "../components/AnnouncementHuay.astro";

import { Picture } from "astro:assets";

import pro1 from "../assets/slide1.png";
import pro2 from "../assets/slide2.png";
import pro3 from "../assets/slide3.png";
import pro4 from "../assets/slide4.png";
---

<MainLayout
  title="โปรโมชั่น MAHORANLOTTO เงื่อนไขรับสิทธิ์ ยอดซื้อหวย และวงเงินถอนที่ควรตรวจสอบ"
  description="รวมข้อมูลโปรโมชั่น MAHORANLOTTO เว็บหวยออนไลน์ ตรวจสอบยอดฝากขั้นต่ำ ระยะเวลารับสิทธิ์ ตลาดหวยที่ร่วมรายการ ยอดส่งโพย และวงเงินถอน ก่อนกดรับสิทธิ์ทุกแคมเปญ">
  <Announcement />

  <ContentBox>
    <h1 class="mb-5 bg-gradient-to-r from-white via-amber-100 to-amber-400 bg-clip-text text-3xl font-black tracking-widest text-transparent uppercase drop-shadow-sm">โปรโมชั่น MAHORANLOTTO</h1>

    <h2 class="mb-4 text-2xl font-bold text-amber-300">โปรโมชั่น MAHORANLOTTO ต้องตรวจสอบเงื่อนไขอะไรบ้างก่อนรับสิทธิ์</h2>

    <p class="mb-5 text-left text-base leading-relaxed text-amber-50/85">
      ก่อนรับโปรโมชั่น <strong class="text-amber-300">MAHORANLOTTO</strong> ควรตรวจสอบยอดฝากขั้นต่ำ ระยะเวลารับสิทธิ์ ตลาดหวยที่ร่วมรายการ ยอดส่งโพยสะสม และวงเงินถอน เพราะแต่ละแคมเปญกำหนดเงื่อนไขไว้ไม่เหมือนกัน
    </p>

    <p class="mb-8 text-left text-base leading-relaxed text-amber-50/85">
      ไม่ควรตัดสินใจจากจำนวนเครดิตที่ได้รับเพียงอย่างเดียว เนื่องจากบางตลาดหวยอาจไม่ถูกนับรวมในยอดทำรายการ หรือกำหนดให้ส่งโพยภายในรอบที่ระบุ การอ่านเงื่อนไขล่วงหน้าช่วยลดปัญหาถอนเงินไม่ได้หรือมียอดค้างในระบบ
    </p>

    <div class="mx-auto grid w-full max-w-7xl grid-cols-1 gap-6 px-4 sm:grid-cols-2 lg:grid-cols-2 xl:grid-cols-2">
      <Picture
        src={pro1}
        alt="โปรโมชั่น MAHORANLOTTO เว็บหวยออนไลน์ ครบทุกตลาด ซื้อหวยง่าย จ่ายไว"
        loading="lazy"
        fetchpriority="low"
        widths={[200, 400, 600, 800]}
        sizes="(max-width: 768px) 100vw, 50vw"
        class="mx-auto h-auto w-full rounded-xl border border-amber-500/40 object-contain shadow-[0_10px_30px_rgba(251,191,36,0.25)] transition-transform duration-300 hover:-translate-y-1 hover:border-amber-400 hover:shadow-[0_10px_30px_rgba(251,191,36,0.45)]"
        decoding="async"
        formats={["avif", "webp"]}
        fallbackFormat="webp"
        quality={80}
      />

      <Picture
        src={pro2}
        alt="โปรโมชั่น MAHORANLOTTO คืนยอดส่งโพยทุกรอบ รับเครดิตคืนอัตโนมัติ"
        loading="lazy"
        fetchpriority="low"
        widths={[200, 400, 600, 800]}
        sizes="(max-width: 768px) 100vw, 50vw"
        class="mx-auto h-auto w-full rounded-xl border border-amber-500/40 object-contain shadow-[0_10px_30px_rgba(251,191,36,0.25)] transition-transform duration-300 hover:-translate-y-1 hover:border-amber-400 hover:shadow-[0_10px_30px_rgba(251,191,36,0.45)]"
        decoding="async"
        formats={["avif", "webp"]}
        fallbackFormat="webp"
        quality={80}
      />

      <Picture
        src={pro3}
        alt="โปรโมชั่น MAHORANLOTTO สมัครใหม่ฝากแรก รับเครดิตซื้อหวยเพิ่ม"
        loading="lazy"
        fetchpriority="low"
        widths={[200, 400, 600, 800]}
        sizes="(max-width: 768px) 100vw, 50vw"
        class="mx-auto h-auto w-full rounded-xl border border-amber-500/40 object-contain shadow-[0_10px_30px_rgba(251,191,36,0.25)] transition-transform duration-300 hover:-translate-y-1 hover:border-amber-400 hover:shadow-[0_10px_30px_rgba(251,191,36,0.45)]"
        decoding="async"
        formats={["avif", "webp"]}
        fallbackFormat="webp"
        quality={80}
      />

      <Picture
        src={pro4}
        alt="โปรโมชั่น MAHORANLOTTO ระบบฝากถอนออโต้ ส่งโพยไว ตรวจผลรางวัลได้ทันที"
        loading="lazy"
        fetchpriority="low"
        widths={[200, 400, 600, 800]}
        sizes="(max-width: 768px) 100vw, 50vw"
        class="mx-auto h-auto w-full rounded-xl border border-amber-500/40 object-contain shadow-[0_10px_30px_rgba(251,191,36,0.25)] transition-transform duration-300 hover:-translate-y-1 hover:border-amber-400 hover:shadow-[0_10px_30px_rgba(251,191,36,0.45)]"
        decoding="async"
        formats={["avif", "webp"]}
        fallbackFormat="webp"
        quality={80}
      />
    </div>

    <h2 class="mt-10 mb-4 text-2xl font-bold text-amber-300">โปรโมชั่นแบบไหนเหมาะกับคนซื้อหวยออนไลน์</h2>

    <p class="text-left text-base leading-relaxed text-amber-50/85">
      โปรโมชั่นที่เหมาะกับผู้เล่นหวยมักอยู่ในรูปของส่วนลดค่าหวย อัตราจ่ายที่สูงขึ้นในบางตลาด หรือเครดิตคืนจากยอดส่งโพยสะสม ควรเทียบเงื่อนไขกับพฤติกรรมการซื้อของตัวเอง เช่น ซื้อบ่อยในตลาดหวยรัฐบาล หวยลาว หรือหวยฮานอย รอบใดที่ส่งโพยเป็นประจำ และมักแทงเลขรูปแบบไหน เพื่อเลือกแคมเปญที่ใช้สิทธิ์ได้จริงก่อนกดรับ
    </p>

    <div class="mt-12 flex justify-center pb-4">
      <a
        href="/register"
        class="flex items-center justify-center rounded-lg border border-amber-300/60 bg-gradient-to-r from-amber-400 to-amber-600 px-10 py-3.5 text-lg font-black text-[#1a0409] shadow-[0_10px_30px_rgba(251,191,36,0.35)] transition-transform hover:scale-105 hover:shadow-[0_10px_30px_rgba(251,191,36,0.55)]">
        รับโปรโมชั่นทันที
      </a>
    </div>
  </ContentBox>

  <Navfoot />
</MainLayout>
