---
import MainLayout from "../layouts/MainLayout.astro";
import ContentBox from "../components/ContentBox.astro";
import Navfoot from "../components/Navfoot.astro";
import Announcement from "../components/Announcement3.astro";

import { Picture } from "astro:assets";

// Only the TWO slides that belong to THIS brand's drop (2026-08-08) are
// imported. slide3.png (2026-08-06) and slide4.png (2026-08-01) are previous
// brands' promo art — and an image imported without being rendered still gets
// emitted into dist/, so they are dropped here rather than left as unused
// imports.
import pro1 from "../assets/slide1.png";
import pro2 from "../assets/slide2.png";
import { pageGraph } from "../lib/schema";

// 159 CHARACTERS (not bytes — Thai is 3 bytes/char, so a byte count reads ~3x
// too long). The brief's own sentence is 118 characters, under
// verify-build.mjs's 150 floor, so the trailing clause is built from this
// brand's own vocabulary and brings it into the 150–160 window without
// changing what the brief says.
const pageDescription =
  "อัปเดตสิทธิพิเศษและโบนัสล่าสุดจาก GARUDA369 คัดสรร โปรจัดเต็ม มาเพื่อต่อยอดความสำเร็จของคุณ รับสิทธิ์ง่ายผ่านระบบออโต้ บนเว็บตรงไม่ผ่านเอเย่นต์ที่ทำเงินได้จริง";

const graph = pageGraph(Astro, {
  name: "GARUDA369 โปรโมชั่น รวม โปรจัดเต็ม ยกระดับทุนทำกำไร",
  description: pageDescription,
  breadcrumb: [
    { name: "หน้าแรก", path: "/" },
    { name: "โปรโมชั่น", path: "/promotion" },
  ],
  primaryImagePath: pro1.src,
});
---

<MainLayout title="GARUDA369 โปรโมชั่น รวม โปรจัดเต็ม ยกระดับทุนทำกำไร" description={pageDescription}>
  <script type="application/ld+json" set:html={graph} />

  <Announcement />

  <ContentBox title="โปรโมชั่น GARUDA369 รวม โปรจัดเต็ม ทุกแคมเปญ" as="h1">
    <p class="mb-8 text-left text-base leading-relaxed text-[#dcefc2]">
      หน้านี้คือที่รวมสิทธิพิเศษและ <strong class="text-[#7bbb0b]">โปรจัดเต็ม</strong> ที่ GARUDA369 เปิดให้สมาชิกกดรับเองได้ผ่าน ระบบออโต้ บนแดชบอร์ดส่วนตัว
      รายละเอียดของแต่ละแคมเปญอยู่บนภาพด้านล่างนี้ทั้งหมด ทั้งยอดที่ได้รับ รอบการแจก และสิ่งที่ต้องทำเพื่อรับสิทธิ์ เงื่อนไข รอบการคำนวณ
      และยอดที่นับได้จริงของแต่ละแคมเปญไม่เหมือนกัน จึงควรอ่านให้จบก่อนกดรับทุกครั้ง
    </p>

    <div class="grid grid-cols-1 gap-6 sm:grid-cols-2">
      <Picture
        src={pro1}
        alt="แบนเนอร์โปรโมชั่น GARUDA369 คืนยอดเสีย 15% ตัวเลขสีทองบนพื้นเขียวเข้ม พร้อมข้อความ เล่นสนุกได้ทุกวัน เราดูแลคืนกำไรให้คุณ มุมภาพระบุ เสียเท่าไหร่ เราคืนให้ สูงสุด 15% ทุกวัน มีวงล้อสล็อต JACKPOT และกองเหรียญทอง ด้านล่างเป็นแถบข้อความ มั่นคง ปลอดภัย เชื่อถือได้ 100%"
        loading="lazy"
        fetchpriority="low"
        widths={[320, 640, 960]}
        sizes="(max-width: 639px) 100vw, 50vw"
        class="mx-auto h-auto w-full rounded-xl border border-[#63a30c]/35 object-contain shadow-[0_10px_30px_rgba(123,187,11,0.18)] transition-transform duration-300 hover:-translate-y-1 hover:border-[#7bbb0b]/70 hover:shadow-[0_15px_40px_rgba(99,163,12,0.32)]"
        decoding="async"
        formats={["avif", "webp"]}
        fallbackFormat="webp"
        quality={80}
      />

      <Picture
        src={pro2}
        alt="แบนเนอร์โปรโมชั่น GARUDA369 ฝาก29 ลุ้นรับ iPhone 17 Pro Max ตัวอักษรสีทองบนพื้นเขียวเข้ม พร้อมข้อความ ลุ้นง่าย ได้จริง ทุกคนมีสิทธิ์ มุมภาพระบุ แจกจริง ทุกเดือน และแถบด้านล่าง ยิ่งฝาก ยิ่งมีสิทธิ์มาก ลุ้นรางวัลใหญ่ทุกเดือน"
        loading="lazy"
        fetchpriority="low"
        widths={[320, 640, 960]}
        sizes="(max-width: 639px) 100vw, 50vw"
        class="mx-auto h-auto w-full rounded-xl border border-[#63a30c]/35 object-contain shadow-[0_10px_30px_rgba(123,187,11,0.18)] transition-transform duration-300 hover:-translate-y-1 hover:border-[#7bbb0b]/70 hover:shadow-[0_15px_40px_rgba(99,163,12,0.32)]"
        decoding="async"
        formats={["avif", "webp"]}
        fallbackFormat="webp"
        quality={80}
      />
    </div>

    <div class="mt-12 flex justify-center pb-4">
      <a
        href="/register"
        class="flex items-center justify-center rounded-lg border border-[#7bbb0b]/50 bg-gradient-to-r from-[#a8e81c] via-[#7bbb0b] to-[#3c6b07] px-10 py-3.5 text-lg font-black text-[#061405] shadow-[0_10px_30px_rgba(123,187,11,0.22)] transition-transform hover:scale-105 hover:shadow-[0_15px_40px_rgba(99,163,12,0.35)]">
        สมัครสมาชิก GARUDA369
      </a>
    </div>
  </ContentBox>

  <Navfoot />
</MainLayout>
