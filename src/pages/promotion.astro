---
import MainLayout from "../layouts/MainLayout.astro";
import ContentBox from "../components/ContentBoxHuay.astro";
import Navfoot from "../components/Navfoot.astro";
import Announcement from "../components/Announcement6.astro";

import { Picture } from "astro:assets";

import pro1 from "../assets/slide1.png";
import pro2 from "../assets/slide2.png";
import pro3 from "../assets/slide3.png";
import pro4 from "../assets/slide4.png";
---

<MainLayout
  title="โปรโมชั่น GSYBET รวมสิทธิประโยชน์เว็บเกมคาสิโน ทางเข้าเว็บตรงครบวงจร"
  description="อัปเดตโปรโมชั่น GSYBET เว็บเกมคาสิโนออนไลน์ รวมสิทธิประโยชน์และกิจกรรมสำหรับสมาชิก ครอบคลุมสล็อต คาสิโนสด บาคาร่า กีฬา พร้อมระบบฝากถอนอัตโนมัติตลอด 24 ชั่วโมง">
  <Announcement />

  <ContentBox>
    <h1 class="mb-5 bg-gradient-to-r from-amber-300 to-amber-500 bg-clip-text text-3xl font-black tracking-widest text-transparent uppercase drop-shadow-sm">โปรโมชั่น GSYBET</h1>

    <p class="mb-8 text-left text-base leading-relaxed text-amber-50/80">
      สมาชิกสามารถติดตาม <strong class="text-amber-300">โปรโมชั่น GSYBET</strong> กิจกรรม และสิทธิประโยชน์ที่เว็บไซต์จัดเตรียมไว้ในแต่ละช่วงเวลา เพื่อเลือกใช้งานให้เหมาะกับรูปแบบการเล่นและความสนใจของตนเอง ทั้งเกมสล็อต คาสิโนสด บาคาร่า กีฬา และเกมออนไลน์ประเภทอื่น
      ภายใต้โครงสร้างแบบเว็บตรงครบวงจรที่รวมทุกหมวดเกมไว้ในบัญชีสมาชิกเดียว พร้อมระบบฝากถอนอัตโนมัติที่ใช้งานได้ด้วยตนเองตลอด 24 ชั่วโมง
    </p>

    <div class="mx-auto grid w-full max-w-7xl grid-cols-1 gap-6 px-4 sm:grid-cols-2 lg:grid-cols-2 xl:grid-cols-2">
      <Picture
        src={pro1}
        alt="โปรโมชั่น GSYBET แตกง่าย วิเคราะห์ค่า RTP และระบบเกมของแต่ละค่าย"
        loading="lazy"
        fetchpriority="low"
        widths={[200, 400, 600, 800]}
        sizes="(max-width: 768px) 100vw, 50vw"
        class="mx-auto h-auto w-full rounded-xl border border-amber-500/40 object-contain shadow-[0_10px_30px_rgba(234,179,8,0.35)] transition-transform duration-300 hover:-translate-y-1 hover:border-amber-500 hover:shadow-[0_10px_30px_rgba(234,179,8,0.5)]"
        decoding="async"
        formats={["avif", "webp"]}
        fallbackFormat="webp"
        quality={80}
      />

      <Picture
        src={pro2}
        alt="โปรโมชั่น GSYBET รวมสล็อต คาสิโนสด บาคาร่า และกีฬา ไว้ในระบบเดียว"
        loading="lazy"
        fetchpriority="low"
        widths={[200, 400, 600, 800]}
        sizes="(max-width: 768px) 100vw, 50vw"
        class="mx-auto h-auto w-full rounded-xl border border-amber-500/40 object-contain shadow-[0_10px_30px_rgba(234,179,8,0.35)] transition-transform duration-300 hover:-translate-y-1 hover:border-amber-500 hover:shadow-[0_10px_30px_rgba(234,179,8,0.5)]"
        decoding="async"
        formats={["avif", "webp"]}
        fallbackFormat="webp"
        quality={80}
      />

      <Picture
        src={pro3}
        alt="โปรโมชั่น GSYBET ระบบฝากถอนอัตโนมัติ เว็บตรงครบวงจร รองรับ HTTPS และ SSL"
        loading="lazy"
        fetchpriority="low"
        widths={[200, 400, 600, 800]}
        sizes="(max-width: 768px) 100vw, 50vw"
        class="mx-auto h-auto w-full rounded-xl border border-amber-500/40 object-contain shadow-[0_10px_30px_rgba(234,179,8,0.35)] transition-transform duration-300 hover:-translate-y-1 hover:border-amber-500 hover:shadow-[0_10px_30px_rgba(234,179,8,0.5)]"
        decoding="async"
        formats={["avif", "webp"]}
        fallbackFormat="webp"
        quality={80}
      />

      <Picture
        src={pro4}
        alt="รีวิว GSYBET หลังทดลองเล่นจริง 72 ชั่วโมง บน Windows Android และ iPhone"
        loading="lazy"
        fetchpriority="low"
        widths={[200, 400, 600, 800]}
        sizes="(max-width: 768px) 100vw, 50vw"
        class="mx-auto h-auto w-full rounded-xl border border-amber-500/40 object-contain shadow-[0_10px_30px_rgba(234,179,8,0.35)] transition-transform duration-300 hover:-translate-y-1 hover:border-amber-500 hover:shadow-[0_10px_30px_rgba(234,179,8,0.5)]"
        decoding="async"
        formats={["avif", "webp"]}
        fallbackFormat="webp"
        quality={80}
      />
    </div>
    <div class="mt-12 flex justify-center pb-4">
      <a
        href="/register"
        class="flex items-center justify-center rounded-lg border border-amber-300/60 bg-gradient-to-r from-amber-400 to-amber-600 px-10 py-3.5 text-lg font-black text-[#1a1204] shadow-[0_10px_30px_rgba(234,179,8,0.35)] transition-transform hover:scale-105 hover:shadow-[0_10px_30px_rgba(234,179,8,0.55)]">
        รับโปรโมชั่นทันที
      </a>
    </div>
  </ContentBox>

  <Navfoot />

  <style>
    :global(.text-purple-gradient) {
      background: linear-gradient(to bottom, #fef08a 0%, #f59e0b 100%) !important;
      -webkit-background-clip: text !important;
      -webkit-text-fill-color: transparent !important;
    }
  </style>
</MainLayout>
