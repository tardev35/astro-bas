---
import MainLayout from "../layouts/MainLayout.astro";
import ContentBox from "../components/ContentBox.astro";
import Navfoot from "../components/Navfoot.astro";
import Announcement from "../components/AnnouncementHuay.astro";
---

<MainLayout
  title="ทางเข้า MAHORANLOTTO เว็บไซต์จริง ซื้อหวยออนไลน์ ตรวจโดเมนก่อนเข้าสู่ระบบ"
  description="ทางเข้า MAHORANLOTTO เว็บเล่นหวยออนไลน์ครบทุกตลาด หวยรัฐบาล หวยลาว หวยฮานอย หวยหุ้น แนะนำวิธีตรวจสอบชื่อโดเมนและการเชื่อมต่อ HTTPS เพื่อหลีกเลี่ยงเว็บไซต์เลียนแบบ พร้อมลิงก์เข้าสู่ระบบและสมัครสมาชิกที่ถูกต้อง">
  <Announcement />

  <ContentBox title="ทางเข้า MAHORANLOTTO เว็บไซต์จริง และวิธีหลีกเลี่ยงเว็บปลอม">
    <div>
      <p class="mb-6 text-left text-base leading-relaxed text-amber-50/85">
        ก่อนเข้าใช้งานควรตรวจสอบว่าเป็นทางเข้าของเว็บไซต์จริงทุกครั้ง โดยสังเกตชื่อโดเมน <strong class="text-amber-300">MAHORANLOTTO</strong> การเชื่อมต่อ HTTPS และข้อมูลความปลอดภัยของหน้าเว็บไซต์ พร้อมดูว่าเมนูเข้าสู่ระบบ สมัครสมาชิก โปรโมชั่น
        ตารางรอบปิดรับของแต่ละตลาดหวย และช่องทางติดต่ออยู่ครบหรือไม่ หากหน้าเว็บแสดงเลขอั้นหรืออัตราจ่ายที่ผิดไปจากปกติ ให้ตั้งข้อสังเกตไว้ก่อนเสมอ
      </p>

      <p class="mb-6 text-left text-base leading-relaxed text-amber-50/85">
        หลีกเลี่ยงการเข้าสู่ระบบผ่านลิงก์ที่ไม่ทราบแหล่งที่มา โฆษณาป๊อปอัป หรือเว็บไซต์ที่เลียนแบบชื่อแบรนด์เพื่อขอข้อมูลบัญชีของผู้เล่น หากบัญชีรับเงินฝากหรือหน้าส่งโพยเปลี่ยนรูปแบบไปจากเดิม
        ควรหยุดทำรายการแล้วตรวจสอบกับทีมงานก่อนทุกครั้ง การใช้ทางเข้าล่าสุดจากช่องทางทางการจะช่วยลดความเสี่ยงในการพบเว็บไซต์ปลอม และทำให้ซื้อหวยออนไลน์ได้อย่างต่อเนื่องและปลอดภัย
      </p>

      <p class="text-left text-base leading-relaxed text-amber-50/85">
        ผู้เล่นที่เข้าผ่านทางเข้าจริงจะเห็นตลาดหวยครบตามที่เปิดรับ ทั้งหวยรัฐบาล หวยลาว หวยฮานอย หวยหุ้น และหวยต่างประเทศ สามารถตรวจอัตราจ่าย เลขอั้น และเวลาปิดรับก่อนส่งโพย
        รวมถึงย้อนดูประวัติการซื้อและผลรางวัลของตนเองได้จากบัญชีผู้ใช้งานเดียว
      </p>
    </div>
  </ContentBox>

  <ContentBox as="h2" title="เข้าสู่ระบบและสมัครสมาชิก MAHORANLOTTO เพื่อเริ่มซื้อหวยได้ทันที">
    <div>
      <p class="mb-8 text-left text-base leading-relaxed text-amber-50/85">
        หากไม่แน่ใจว่าลิงก์ <strong class="text-amber-300">ทางเข้า MAHORANLOTTO</strong> หรือลิงก์สมัครสมาชิกใดคือของจริง เราได้เตรียมลิงก์ที่ถูกต้องไว้ให้แล้วที่ปุ่มด้านล่างนี้ สมาชิกใหม่เพียงกรอกข้อมูลตามที่ระบบกำหนด
        ยืนยันบัญชี เติมเครดิต ก็เลือกตลาดหวยและส่งโพยได้ทันที
      </p>

      <div class="mb-5 grid grid-cols-1 gap-8 md:grid-cols-2">
        <div class="flex flex-col items-center justify-center gap-4">
          <a
            href="/login"
            aria-label="เข้าสู่ระบบ MAHORANLOTTO"
            class="group relative mx-auto flex w-full max-w-[320px] items-center justify-center gap-3 overflow-hidden rounded-xl border border-amber-400/70 bg-gradient-to-b from-[#5f0914] to-[#0f0206] px-6 py-4 shadow-[0_0_20px_rgba(251,191,36,0.35),inset_0_-4px_8px_rgba(0,0,0,0.2)] transition-all duration-300 hover:scale-105 hover:shadow-[0_0_30px_rgba(251,191,36,0.6)]">
            <div class="absolute inset-x-0 top-0 h-1/2 bg-gradient-to-b from-amber-200/20 to-transparent"></div>

            <svg class="relative z-10 h-9 w-9 text-amber-200 drop-shadow-md" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg">
              <path stroke-linecap="round" stroke-linejoin="round" d="M11 16l-4-4m0 0l4-4m-4 4h14m-5 4v1a3 3 0 01-3 3H6a3 3 0 01-3-3V7a3 3 0 013-3h7a3 3 0 013 3v1"></path>
            </svg>

            <span class="relative z-10 text-3xl font-bold tracking-wide text-amber-200 [text-shadow:_0_2px_4px_rgb(0_0_0_/_60%)]">เข้าสู่ระบบ</span>
          </a>
        </div>

        <div class="flex flex-col items-center justify-center gap-4">
          <a
            href="/register"
            aria-label="สมัครสมาชิก MAHORANLOTTO"
            class="group relative mx-auto flex w-full max-w-[320px] items-center justify-center gap-3 overflow-hidden rounded-xl border border-amber-200/70 bg-gradient-to-b from-amber-300 to-amber-600 px-6 py-4 shadow-[0_0_20px_rgba(251,191,36,0.45),inset_0_-4px_8px_rgba(0,0,0,0.2)] transition-all duration-300 hover:scale-105 hover:shadow-[0_0_30px_rgba(251,191,36,0.75)]">
            <div class="absolute inset-x-0 top-0 h-1/2 bg-gradient-to-b from-white/40 to-transparent"></div>

            <svg class="relative z-10 h-9 w-9 text-[#1a0409] drop-shadow-md" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg">
              <path stroke-linecap="round" stroke-linejoin="round" d="M18 9v3m0 0v3m0-3h3m-3 0h-3m-2-5a4 4 0 11-8 0 4 4 0 018 0zM3 20a6 6 0 0112 0v1H3v-1z"></path>
            </svg>

            <span class="relative z-10 text-3xl font-bold tracking-wide text-[#1a0409]">สมัครสมาชิก</span>
          </a>
        </div>
      </div>
    </div>
  </ContentBox>

  <Navfoot />
</MainLayout>
