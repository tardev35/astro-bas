---
import MainLayout from "../layouts/MainLayout.astro";
import ContentBox from "../components/ContentBox.astro";
import Navfoot from "../components/Navfoot.astro";
import Announcement from "../components/AnnouncementCyber.astro";
import { pageGraph } from "../lib/schema";

const pageDescription =
  "ทางเข้า TUNGMA168 หรือ ตังค์มา168 เว็บสล็อตและคาสิโนออนไลน์ พร้อมวิธีตรวจชื่อโดเมน HTTPS โลโก้ และปลายทางของปุ่มสมัคร ก่อนกรอกเบอร์โทรและรหัสผ่านเข้าสู่ระบบ";

const graph = pageGraph(Astro, {
  name: "ทางเข้า TUNGMA168 ตังค์มา168 ต้องตรวจอะไรก่อนกรอกข้อมูล",
  description: pageDescription,
  breadcrumb: [
    { name: "หน้าแรก", path: "/" },
    { name: "ทางเข้า", path: "/ทางเข้า" },
  ],
});
---

<MainLayout title="ทางเข้า TUNGMA168 ตังค์มา168 ตรวจโดเมนและ HTTPS ก่อนล็อกอิน" description={pageDescription}>
  <script type="application/ld+json" set:html={graph} />

  <Announcement />

  <ContentBox title="ทางเข้า TUNGMA168 ตังค์มา168 ต้องตรวจอะไรก่อนกรอกข้อมูล" as="h1">
    <div>
      <h2 class="mb-6 bg-gradient-to-r from-[#ffa6d2] via-[#ff3d9a] to-[#c21a70] bg-clip-text text-2xl leading-normal font-bold text-transparent">ตรวจโดเมนและ HTTPS ให้ถูกต้อง ก่อนกรอกเบอร์และรหัสผ่าน</h2>

      <p class="mb-6 text-left text-base leading-relaxed text-[#fdeaf4]">
        ผลค้นหาของคำว่า TUNGMA168 และ ตังค์มา168 มีทั้งเว็บหลัก บัญชีโซเชียล และหน้ารวมลิงก์ปะปนกัน ก่อนล็อกอินจึงควรตรวจชื่อโดเมนทุกตัวอักษร ดูว่าการเชื่อมต่อเป็น HTTPS ตรวจโลโก้ และไล่ดูปลายทางของปุ่มสมัครให้ตรงกันทั้งหมด โดยเฉพาะลิงก์ที่เด้งเปลี่ยนหน้าหลายรอบก่อนพามาถึงหน้าเข้าสู่ระบบ ชื่อคล้ายกันและโลโก้คล้ายกันไม่ได้ยืนยันว่าเป็นเว็บเดียวกัน
        จากนั้นดูว่าเมนูเข้าสู่ระบบ สมัครสมาชิก สล็อต คาสิโนสด โปรโมชั่น ฝากถอนออโต้ และช่องทางติดต่ออยู่ครบตามปกติหรือเปล่า เพราะหน้าเลียนแบบมักลอกภาพได้เหมือนแต่ตกหล่นบางเมนู หรือรีบพาไปหน้ากรอกข้อมูลตั้งแต่คลิกแรก หากเว็บขอ OTP ผ่านแชต บังคับติดตั้งไฟล์ หรือเปลี่ยนชื่อแบรนด์ระหว่างทาง ควรหยุดก่อนกรอก ใช้เวลาเช็กเพิ่มสิบวินาที ดีกว่าใช้ครึ่งวันตามหาว่าบัญชีเดินทางไปกับลิงก์ไหน
      </p>

      <h2 class="mb-6 bg-gradient-to-r from-[#ffa6d2] via-[#ff3d9a] to-[#c21a70] bg-clip-text text-2xl leading-normal font-bold text-transparent">เข้าระบบแล้วใช้อะไรได้บ้าง และควรหยุดทำรายการตอนไหน</h2>

      <p class="mb-8 text-left text-base leading-relaxed text-[#fdeaf4]">
        เมื่อเข้าระบบแล้ว บัญชีเดียวเปิดใช้ได้ทั้งหมวดสล็อตจากหลายค่าย คาสิโนสด และรายการทางการเงินในเส้นทางเดียว หมวดสล็อตมีทั้ง PG, Joker, Pragmatic และผู้ให้บริการกลุ่มอื่น ซึ่งควรเลือกจากเดิมพันขั้นต่ำ ฟีเจอร์โบนัส ความผันผวน และรูปแบบการจ่ายมากกว่าดูหน้าปกเกม ส่วนคาสิโนสดอย่างบาคาร่า รูเล็ต และเกมโต๊ะอื่นเดินต่อเนื่องแบบเรียลไทม์ จึงควรดูค่าย วงเงินโต๊ะ และเวลาปิดรับก่อนลงยอด
        ด้านการเงิน ระบบออโต้เปิดให้ทำรายการด้วยบัญชีของตัวเองตลอด 24 ชั่วโมง โดยไม่ต้องส่งข้อความหาเจ้าหน้าที่ทุกครั้ง ก่อนกดยืนยันควรตรวจชื่อบัญชี ยอดเงิน และประวัติรายการให้ตรงกัน หากยอดยังไม่เปลี่ยนไม่ควรกดซ้ำทันที เพราะระบบอาจกำลังประมวลผลอยู่ และหลังทำรายการควรเก็บเลขรายการหรือภาพหน้าจอไว้ตรวจสอบภายหลัง เบอร์โทรศัพท์เป็นข้อมูลสำคัญของบัญชี จึงควรกรอกเฉพาะบนโดเมนที่ตรวจแล้ว และไม่ส่งรหัสผ่านหรือ OTP ให้บุคคลอื่นผ่านแชต หากลืมรหัสควรใช้เมนูกู้คืนจากระบบโดยตรง เจ้าหน้าที่จริงไม่จำเป็นต้องยืมรหัสเราไปลองล็อกอินแทน และถ้าไม่แน่ใจว่าลิงก์
        <strong class="text-[#ffa6d2]">ทางเข้า ตังค์มา168</strong> หรือลิงก์สมัครสมาชิกใดคือของจริง เราเตรียมลิงก์ที่ถูกต้องไว้ให้แล้วที่ปุ่มด้านล่างนี้
      </p>

      <div class="mb-5 grid grid-cols-1 gap-8 md:grid-cols-2">
        <div class="flex flex-col items-center justify-center gap-4">
          <a
            href="/login"
            aria-label="เข้าสู่ระบบ TUNGMA168"
            class="group relative mx-auto flex w-full max-w-[320px] items-center justify-center gap-3 overflow-hidden rounded-xl border border-[#ff3d9a]/60 bg-[#16050f] px-6 py-4 shadow-[0_10px_30px_rgba(255,61,154,0.18)] transition-all duration-300 hover:scale-105 hover:border-[#ff3d9a] hover:bg-[#2a0a1d] hover:shadow-[0_15px_40px_rgba(255,61,154,0.30)]">
            <div class="absolute inset-x-0 top-0 h-1/2 bg-gradient-to-b from-[#ff3d9a]/20 to-transparent"></div>

            <svg class="relative z-10 h-9 w-9 text-[#22d3ee]" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg">
              <path stroke-linecap="round" stroke-linejoin="round" d="M11 16l-4-4m0 0l4-4m-4 4h14m-5 4v1a3 3 0 01-3 3H6a3 3 0 01-3-3V7a3 3 0 013-3h7a3 3 0 013 3v1"></path>
            </svg>

            <span class="relative z-10 text-3xl font-bold tracking-wide text-[#ffa6d2]">เข้าสู่ระบบ</span>
          </a>
        </div>

        <div class="flex flex-col items-center justify-center gap-4">
          <a
            href="/register"
            aria-label="สมัครสมาชิก TUNGMA168"
            class="group relative mx-auto flex w-full max-w-[320px] items-center justify-center gap-3 overflow-hidden rounded-xl border border-[#ff3d9a]/60 bg-gradient-to-r from-[#ffa6d2] via-[#ff3d9a] to-[#c21a70] px-6 py-4 shadow-[0_10px_30px_rgba(255,61,154,0.18)] transition-all duration-300 hover:scale-105 hover:shadow-[0_15px_40px_rgba(255,61,154,0.30)]">
            <div class="absolute inset-x-0 top-0 h-1/2 bg-gradient-to-b from-white/55 to-transparent"></div>

            <svg class="relative z-10 h-9 w-9 text-[#1c0614]" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg">
              <path stroke-linecap="round" stroke-linejoin="round" d="M18 9v3m0 0v3m0-3h3m-3 0h-3m-2-5a4 4 0 11-8 0 4 4 0 018 0zM3 20a6 6 0 0112 0v1H3v-1z"></path>
            </svg>

            <span class="relative z-10 text-3xl font-bold tracking-wide text-[#1c0614]">สมัครสมาชิก</span>
          </a>
        </div>
      </div>
    </div>
  </ContentBox>

  <Navfoot />
</MainLayout>
