---
import MainLayout from "../layouts/MainLayout.astro";
import ContentBox from "../components/ContentBox.astro";
import Navfoot from "../components/Navfoot.astro";
import Announcement from "../components/Announcement4.astro";
---

<MainLayout
  title="ทางเข้า PAY69 ล่าสุด ตรวจโดเมนและ HTTPS ให้ถูกก่อนเข้าสู่ระบบ"
  description="ทางเข้า PAY69 ล่าสุด รวมสล็อต กีฬา เกม Live สด และเดิมพันด้านการเงินไว้ในบัญชีเดียว พร้อมวิธีตรวจชื่อโดเมนและการเชื่อมต่อ HTTPS ให้ถูกต้อง เลี่ยงลิงก์จากข้อความส่วนตัวและหน้าเลียนแบบ พร้อมลิงก์เข้าสู่ระบบและสมัครสมาชิกที่ถูกต้อง">
  <Announcement />

  <ContentBox title="ทางเข้า PAY69 ล่าสุด เช็กอะไรบ้างก่อนกดเข้าสู่ระบบ">
    <div>
      <h2 class="mb-6 text-2xl leading-normal font-bold text-amber-100">ตรวจโดเมนและ HTTPS ให้ถูกต้อง ก่อนกรอกชื่อผู้ใช้และรหัสผ่าน</h2>

      <p class="mb-6 text-left text-base leading-relaxed text-amber-50/85">
        ก่อนเข้าสู่ระบบควรตรวจชื่อโดเมนให้ตรงตัวอักษรทุกตัว และดูว่าการเชื่อมต่อเป็น HTTPS จริงหรือไม่ จากนั้นสังเกตรูปแบบหน้าเว็บว่าเมนูเข้าสู่ระบบ สมัครสมาชิก โปรโมชั่น กิจกรรมเปิดกล่อง เปิดดวง ล่า Hidden และช่องทางติดต่ออยู่ครบตามปกติหรือเปล่า
        หน้าเลียนแบบมักลอกภาพได้เหมือน แต่มักตกหล่นบางเมนู หรือรีบพาไปหน้ากรอกข้อมูลตั้งแต่คลิกแรก ให้หลีกเลี่ยงลิงก์จากบุคคลไม่รู้จัก โฆษณาป๊อปอัป และลิงก์ที่ส่งต่อกันมาในข้อความส่วนตัว รวมถึงไฟล์ติดตั้งแอปที่ไม่ได้มาจากหน้าเว็บจริง
      </p>

      <h2 class="mb-6 text-2xl leading-normal font-bold text-amber-100">เข้าระบบแล้วใช้อะไรได้บ้าง และควรหยุดทำรายการตอนไหน</h2>

      <p class="mb-8 text-left text-base leading-relaxed text-amber-50/85">
        เมื่อเข้าระบบแล้ว บัญชีเดียวใช้ได้ทั้งสล็อต กีฬา เกม Live สด และเดิมพันด้านการเงิน รวมถึงการกดรับสิทธิ์อย่างฝากปุ๊บเพิ่ม 5% และเครดิตฟรีกดรับเอง ซึ่งควรอ่านยอดเทิร์น เพดานถอน และวันหมดอายุก่อนกดทุกครั้ง ถ้าเปิดเว็บไม่สะดวก ยังเข้าผ่าน PAY69 App
        ที่ใช้สมัคร เข้าระบบ ติดตามกิจกรรม และจัดการบัญชีได้เหมือนกัน หากพบว่าบัญชีรับเงินเปลี่ยนไป หน้าเข้าสู่ระบบหน้าตาผิดจากเดิม หรือมีใครขอรหัสผ่านและ OTP ให้หยุดทำรายการแล้วตรวจสอบกับทีมงานก่อน หากไม่แน่ใจว่าลิงก์
        <strong class="text-amber-200">ทางเข้า PAY69</strong> หรือลิงก์สมัครสมาชิกใดคือของจริง เราเตรียมลิงก์ที่ถูกต้องไว้ให้แล้วที่ปุ่มด้านล่างนี้
      </p>

      <div class="mb-5 grid grid-cols-1 gap-8 md:grid-cols-2">
        <div class="flex flex-col items-center justify-center gap-4">
          <a
            href="/login"
            aria-label="เข้าสู่ระบบ PAY69"
            class="group relative mx-auto flex w-full max-w-[320px] items-center justify-center gap-3 overflow-hidden rounded-xl border border-violet-400/70 bg-gradient-to-b from-[#241040] to-[#0a0714] px-6 py-4 shadow-[0_0_20px_rgba(124,58,237,0.45),inset_0_-4px_8px_rgba(0,0,0,0.2)] transition-all duration-300 hover:scale-105 hover:shadow-[0_0_30px_rgba(124,58,237,0.7)]">
            <div class="absolute inset-x-0 top-0 h-1/2 bg-gradient-to-b from-violet-300/20 to-transparent"></div>

            <svg class="relative z-10 h-9 w-9 text-amber-200 drop-shadow-md" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg">
              <path stroke-linecap="round" stroke-linejoin="round" d="M11 16l-4-4m0 0l4-4m-4 4h14m-5 4v1a3 3 0 01-3 3H6a3 3 0 01-3-3V7a3 3 0 013-3h7a3 3 0 013 3v1"></path>
            </svg>

            <span class="relative z-10 text-3xl font-bold tracking-wide text-amber-200 [text-shadow:_0_2px_4px_rgb(0_0_0_/_60%)]">เข้าสู่ระบบ</span>
          </a>
        </div>

        <div class="flex flex-col items-center justify-center gap-4">
          <a
            href="/register"
            aria-label="สมัครสมาชิก PAY69"
            class="group relative mx-auto flex w-full max-w-[320px] items-center justify-center gap-3 overflow-hidden rounded-xl border border-amber-200/70 bg-gradient-to-b from-amber-300 to-amber-500 px-6 py-4 shadow-[0_0_20px_rgba(212,162,74,0.5),inset_0_-4px_8px_rgba(0,0,0,0.2)] transition-all duration-300 hover:scale-105 hover:shadow-[0_0_30px_rgba(212,162,74,0.8)]">
            <div class="absolute inset-x-0 top-0 h-1/2 bg-gradient-to-b from-white/40 to-transparent"></div>

            <svg class="relative z-10 h-9 w-9 text-[#1a1130] drop-shadow-md" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg">
              <path stroke-linecap="round" stroke-linejoin="round" d="M18 9v3m0 0v3m0-3h3m-3 0h-3m-2-5a4 4 0 11-8 0 4 4 0 018 0zM3 20a6 6 0 0112 0v1H3v-1z"></path>
            </svg>

            <span class="relative z-10 text-3xl font-bold tracking-wide text-[#1a1130]">สมัครสมาชิก</span>
          </a>
        </div>
      </div>
    </div>
  </ContentBox>

  <Navfoot />
</MainLayout>
