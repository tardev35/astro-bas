---
import MainLayout from "../layouts/MainLayout.astro";
import ContentBox from "../components/ContentBox.astro";
import Navfoot from "../components/Navfoot.astro";
import Announcement from "../components/Announcement3.astro";
import { pageGraph } from "../lib/schema";

// BUTTON PAGE, not an article: one <h1> from the ContentBox title, then the
// two-column button grid. No <h2>, no explanatory prose — the docx gives this
// page a Title and a Meta and never a body.
//
// The brief's own sentence is 122 characters, under verify-build.mjs's 150
// floor, so the trailing clause brings it into the 150–160 window without
// changing what the brief says. This one is 158 characters (not bytes).
const pageDescription =
  "หน้าเข้าสู่ระบบ ROMAN555 ปกป้องข้อมูลของคุณด้วยเทคโนโลยี Secure Transition Popup โหลดไว ลื่นไหล มั่นใจได้ในทุกการเชื่อมต่อ สู่ ทางเข้าหลักเว็บตรง ปลอดภัย 100%";

const graph = pageGraph(Astro, {
  name: "ROMAN555 เข้าสู่ระบบ ปลอดภัยขั้นสุด ผ่าน Secure Popup",
  description: pageDescription,
  breadcrumb: [
    { name: "หน้าแรก", path: "/" },
    { name: "ทางเข้า", path: "/ทางเข้า" },
  ],
});
---

<MainLayout title="ROMAN555 เข้าสู่ระบบ ปลอดภัยขั้นสุด ผ่าน Secure Popup" description={pageDescription}>
  <script type="application/ld+json" set:html={graph} />

  <Announcement />

  <ContentBox title="ทางเข้า ROMAN555 เว็บหลัก" as="h1">
    <div class="mb-5 grid grid-cols-1 gap-8 md:grid-cols-2">
      <div class="flex flex-col items-center justify-center gap-4">
        <a
          href="/login"
          aria-label="เข้าสู่ระบบ ROMAN555"
          class="group relative mx-auto flex w-full max-w-[320px] items-center justify-center gap-3 overflow-hidden rounded-xl border border-[#f6cf6a]/50 bg-[#120a02] px-6 py-4 shadow-[0_10px_30px_rgba(168,105,10,0.16)] transition-all duration-300 hover:scale-105 hover:border-[#f6cf6a] hover:bg-[#241505] hover:shadow-[0_15px_40px_rgba(168,105,10,0.28)]">
          <div class="absolute inset-x-0 top-0 h-1/2 bg-gradient-to-b from-[#f6cf6a]/20 to-transparent"></div>

          <svg class="relative z-10 h-9 w-9 text-[#f6cf6a]" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg">
            <path stroke-linecap="round" stroke-linejoin="round" d="M11 16l-4-4m0 0l4-4m-4 4h14m-5 4v1a3 3 0 01-3 3H6a3 3 0 01-3-3V7a3 3 0 013-3h7a3 3 0 013 3v1"></path>
          </svg>

          <span class="relative z-10 text-3xl font-bold tracking-wide text-[#f6cf6a]">เข้าสู่ระบบ</span>
        </a>
      </div>

      <div class="flex flex-col items-center justify-center gap-4">
        <a
          href="/register"
          aria-label="สมัครสมาชิก ROMAN555"
          class="group relative mx-auto flex w-full max-w-[320px] items-center justify-center gap-3 overflow-hidden rounded-xl border border-[#f6cf6a]/60 bg-gradient-to-r from-[#fbeab0] via-[#f6cf6a] to-[#7a4405] px-6 py-4 shadow-[0_10px_30px_rgba(246,207,106,0.20)] transition-all duration-300 hover:scale-105 hover:shadow-[0_15px_40px_rgba(246,207,106,0.32)]">
          <div class="absolute inset-x-0 top-0 h-1/2 bg-gradient-to-b from-white/55 to-transparent"></div>

          <svg class="relative z-10 h-9 w-9 text-[#120a02]" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg">
            <path stroke-linecap="round" stroke-linejoin="round" d="M18 9v3m0 0v3m0-3h3m-3 0h-3m-2-5a4 4 0 11-8 0 4 4 0 018 0zM3 20a6 6 0 0112 0v1H3v-1z"></path>
          </svg>

          <span class="relative z-10 text-3xl font-bold tracking-wide text-[#120a02]">สมัครสมาชิก</span>
        </a>
      </div>
    </div>
  </ContentBox>

  <Navfoot />
</MainLayout>
