---
import MainLayout from "../layouts/MainLayout.astro";
import ContentBox from "../components/ContentBox.astro";
import Navfoot from "../components/Navfoot.astro";
import Announcement from "../components/Announcement6.astro";
---

<MainLayout
  title="ทางเข้า GSYBET เว็บตรงครบวงจร ตรวจสอบโดเมนให้ถูกต้องทุกครั้ง"
  description="ทางเข้า GSYBET เว็บเกมคาสิโนออนไลน์ เว็บตรงครบวงจร ควรตรวจสอบชื่อโดเมนและสัญลักษณ์ HTTPS ทุกครั้งก่อนเข้าสู่ระบบ พร้อมลิงก์เข้าสู่ระบบและสมัครสมาชิกที่ถูกต้อง">
  <Announcement />

  <ContentBox title="ทางเข้า GSYBET เว็บตรงครบวงจร ควรตรวจสอบโดเมน GSYBET ทุกครั้ง">
    <p class="mb-8 text-left text-base leading-relaxed text-amber-50/80">
      ก่อนเข้าสู่ระบบ ควรตรวจสอบชื่อโดเมนของ <strong class="text-amber-300">ทางเข้า GSYBET</strong> ให้ตรงกับเว็บไซต์ที่ต้องการใช้งานทุกครั้ง เพื่อหลีกเลี่ยงเว็บไซต์ที่ใช้ชื่อใกล้เคียงหรือมีการเลียนแบบ
      นอกจากนี้ควรสังเกตว่าเว็บไซต์ใช้ HTTPS และมีสัญลักษณ์รูปกุญแจบนเบราว์เซอร์ รวมถึงตรวจสอบว่าหน้าเข้าสู่ระบบและเมนูต่าง ๆ แสดงผลได้ครบถ้วนทั้งบนคอมพิวเตอร์และสมาร์ตโฟน เพื่อให้มั่นใจว่าเข้าใช้งานผ่านเว็บไซต์ที่ถูกต้อง
      หากไม่แน่ใจว่าลิงก์ทางเข้าหรือลิงก์สมัครสมาชิกใดคือของจริง เราได้เตรียมลิงก์ที่ถูกต้องไว้ให้แล้วที่ปุ่มด้านล่างนี้
    </p>

    <div class="mb-5 grid grid-cols-1 gap-8 md:grid-cols-2">
      <div class="flex flex-col items-center justify-center gap-4">
        <a
          href="/login"
          aria-label="เข้าสู่ระบบ"
          class="group relative mx-auto flex w-full max-w-[320px] items-center justify-center gap-3 overflow-hidden rounded-xl border border-amber-400/70 bg-gradient-to-b from-[#241803] to-[#0a0703] px-6 py-4 shadow-[0_0_20px_rgba(234,179,8,0.4),inset_0_-4px_8px_rgba(0,0,0,0.2)] transition-all duration-300 hover:scale-105 hover:shadow-[0_0_30px_rgba(234,179,8,0.7)]">
          <div class="absolute inset-x-0 top-0 h-1/2 bg-gradient-to-b from-amber-200/20 to-transparent"></div>

          <svg class="relative z-10 h-9 w-9 text-amber-200 drop-shadow-md" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg">
            <path stroke-linecap="round" stroke-linejoin="round" d="M11 16l-4-4m0 0l4-4m-4 4h14m-5 4v1a3 3 0 01-3 3H6a3 3 0 01-3-3V7a3 3 0 013-3h7a3 3 0 013 3v1"></path>
          </svg>

          <span class="relative z-10 text-3xl font-bold tracking-wide text-amber-200 [text-shadow:_0_2px_4px_rgb(0_0_0_/_60%)]">เข้าสู่ระบบ</span>
        </a>
      </div>

      <div class="flex flex-col items-center justify-center gap-4">
        <a
          href="/register"
          aria-label="สมัครสมาชิก"
          class="group relative mx-auto flex w-full max-w-[320px] items-center justify-center gap-3 overflow-hidden rounded-xl border border-amber-200/70 bg-gradient-to-b from-amber-400 to-amber-600 px-6 py-4 shadow-[0_0_20px_rgba(245,158,11,0.5),inset_0_-4px_8px_rgba(0,0,0,0.2)] transition-all duration-300 hover:scale-105 hover:shadow-[0_0_30px_rgba(245,158,11,0.8)]">
          <div class="absolute inset-x-0 top-0 h-1/2 bg-gradient-to-b from-white/40 to-transparent"></div>

          <svg class="relative z-10 h-9 w-9 text-[#1a1204] drop-shadow-md" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg">
            <path stroke-linecap="round" stroke-linejoin="round" d="M18 9v3m0 0v3m0-3h3m-3 0h-3m-2-5a4 4 0 11-8 0 4 4 0 018 0zM3 20a6 6 0 0112 0v1H3v-1z"></path>
          </svg>

          <span class="relative z-10 text-3xl font-bold tracking-wide text-[#1a1204]">สมัครสมาชิก</span>
        </a>
      </div>
    </div>
  </ContentBox>

  <Navfoot />
</MainLayout>
