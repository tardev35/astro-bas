---
import MainLayout from "../layouts/MainLayout.astro";
import ContentBox from "../components/ContentBox.astro";
import Navfoot from "../components/Navfoot.astro";
import Announcement from "../components/Announcement2.astro";
---

<MainLayout
  title="ทางเข้า UFAYES เว็บตรง UFABET ตรวจสอบโดเมนจริงก่อนเข้าสู่ระบบ"
  description="ทางเข้า UFAYES เว็บตรง UFABET รวมแทงบอล คาสิโนสด สล็อต และหวยออนไลน์ไว้ในบัญชีเดียว แนะนำวิธีตรวจสอบชื่อโดเมนและการเชื่อมต่อ HTTPS เพื่อหลีกเลี่ยงเว็บไซต์เลียนแบบ พร้อมลิงก์เข้าสู่ระบบและสมัครสมาชิกที่ถูกต้อง">
  <Announcement />

  <ContentBox title="ทางเข้า UFAYES เว็บจริง ควรตรวจสอบอะไรเพื่อหลีกเลี่ยงเว็บไซต์เลียนแบบ">
    <div>
      <p class="mb-8 text-left text-base leading-relaxed text-red-50/80">
        ก่อนเข้าสู่ระบบควรตรวจชื่อโดเมนและการเชื่อมต่อ HTTPS ให้ถูกต้อง พร้อมสังเกตรูปแบบหน้าเว็บ เมนูเข้าสู่ระบบ สมัครสมาชิก โปรโมชั่น และช่องทางติดต่อว่าอยู่ครบหรือไม่ หลีกเลี่ยงลิงก์จากบุคคลไม่รู้จัก โฆษณาป๊อปอัป หรือหน้าที่ขอข้อมูลผิดปกติ
        หากบัญชีรับเงินหรือหน้าเข้าสู่ระบบเปลี่ยนไป ควรหยุดทำรายการและตรวจสอบกับทีมงานก่อน หากไม่แน่ใจว่าลิงก์ <strong class="text-red-300">ทางเข้า UFAYES</strong> หรือลิงก์สมัครสมาชิกใดคือของจริง เราได้เตรียมลิงก์ที่ถูกต้องไว้ให้แล้วที่ปุ่มด้านล่างนี้
      </p>

      <div class="mb-5 grid grid-cols-1 gap-8 md:grid-cols-2">
        <div class="flex flex-col items-center justify-center gap-4">
          <a
            href="/login"
            aria-label="เข้าสู่ระบบ UFAYES"
            class="group relative mx-auto flex w-full max-w-[320px] items-center justify-center gap-3 overflow-hidden rounded-xl border border-red-400/70 bg-gradient-to-b from-[#240404] to-[#0a0101] px-6 py-4 shadow-[0_0_20px_rgba(220,38,38,0.4),inset_0_-4px_8px_rgba(0,0,0,0.2)] transition-all duration-300 hover:scale-105 hover:shadow-[0_0_30px_rgba(220,38,38,0.7)]">
            <div class="absolute inset-x-0 top-0 h-1/2 bg-gradient-to-b from-red-200/20 to-transparent"></div>

            <svg class="relative z-10 h-9 w-9 text-red-200 drop-shadow-md" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg">
              <path stroke-linecap="round" stroke-linejoin="round" d="M11 16l-4-4m0 0l4-4m-4 4h14m-5 4v1a3 3 0 01-3 3H6a3 3 0 01-3-3V7a3 3 0 013-3h7a3 3 0 013 3v1"></path>
            </svg>

            <span class="relative z-10 text-3xl font-bold tracking-wide text-red-200 [text-shadow:_0_2px_4px_rgb(0_0_0_/_60%)]">เข้าสู่ระบบ</span>
          </a>
        </div>

        <div class="flex flex-col items-center justify-center gap-4">
          <a
            href="/register"
            aria-label="สมัครสมาชิก UFAYES"
            class="group relative mx-auto flex w-full max-w-[320px] items-center justify-center gap-3 overflow-hidden rounded-xl border border-red-200/70 bg-gradient-to-b from-red-400 to-red-600 px-6 py-4 shadow-[0_0_20px_rgba(239,68,68,0.5),inset_0_-4px_8px_rgba(0,0,0,0.2)] transition-all duration-300 hover:scale-105 hover:shadow-[0_0_30px_rgba(239,68,68,0.8)]">
            <div class="absolute inset-x-0 top-0 h-1/2 bg-gradient-to-b from-white/40 to-transparent"></div>

            <svg class="relative z-10 h-9 w-9 text-[#140202] drop-shadow-md" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg">
              <path stroke-linecap="round" stroke-linejoin="round" d="M18 9v3m0 0v3m0-3h3m-3 0h-3m-2-5a4 4 0 11-8 0 4 4 0 018 0zM3 20a6 6 0 0112 0v1H3v-1z"></path>
            </svg>

            <span class="relative z-10 text-3xl font-bold tracking-wide text-[#140202]">สมัครสมาชิก</span>
          </a>
        </div>
      </div>
    </div>
  </ContentBox>

  <Navfoot />
</MainLayout>
