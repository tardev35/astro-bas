---
import MainLayout from "../layouts/MainLayout.astro";
import ContentBox from "../components/ContentBox.astro";
import Navfoot from "../components/Navfoot.astro";
import Announcement from "../components/Announcement5.astro";
---

<MainLayout
  title="BUNNY555 เข้าสู่ระบบ ลื่นไหล ปลอดภัย ผ่าน Premium Popup" description="หน้าเข้าสู่ระบบ BUNNY555 สัมผัสการเชื่อมต่อที่ ลื่นไหล และปลอดภัยสูงสุดด้วย Secure Transition Popup เข้าถึงแดชบอร์ดของคุณได้ไวในเสี้ยววินาที">
  <Announcement />

  <ContentBox title="ทางเข้า BUNNY555 ล่าสุด เชื่อมต่อไวในเสี้ยววินาที ไม่มีสะดุด">
    <div>
      <h2 class="mb-6 text-2xl leading-normal font-bold text-pink-100">Secure Transition Popup ประตูเข้าสู่แดชบอร์ดที่ลื่นไหลและปลอดภัย</h2>

      <p class="mb-6 text-left text-base leading-relaxed text-pink-50/85">
        การเข้าสู่ระบบของ BUNNY555 ถูกออกแบบให้จบในไม่กี่วินาที ด้วย Premium Popup ที่เปิดขึ้นมาบนหน้าเว็บโดยตรง ไม่ต้องเด้งข้ามหน้าไปมาให้เสียจังหวะ เบื้องหลังคือสถาปัตยกรรม Cloud Server ที่ปรับจูนมาเพื่อรองรับผู้ใช้งานพร้อมกันจำนวนมาก
        จึงยังคงความ ลื่นไหล เอาไว้ได้แม้ในช่วงเวลาที่คนเข้าใช้งานหนาแน่นที่สุด ก่อนกรอกชื่อผู้ใช้และรหัสผ่าน ควรตรวจชื่อโดเมนให้ตรงตัวอักษรทุกตัวและดูว่าการเชื่อมต่อเป็น HTTPS จริง เพราะหน้าเลียนแบบมักลอกภาพได้เหมือนแต่ตกหล่นรายละเอียดเสมอ
      </p>

      <h2 class="mb-6 text-2xl leading-normal font-bold text-pink-100">เข้าระบบแล้วใช้อะไรได้บ้าง และควรหยุดทำรายการตอนไหน</h2>

      <p class="mb-8 text-left text-base leading-relaxed text-pink-50/85">
        เมื่อผ่านหน้าเข้าสู่ระบบแล้ว บัญชีเดียวเปิดทางไปยังทุกอย่างบนแพลตฟอร์ม ทั้งเกมจากค่ายชั้นนำอย่าง PG Soft, Pragmatic Play และ JOKER Gaming รวมถึงหน้าสิทธิพิเศษที่ให้คุณกด รับโปรโมชั่นสุดคุ้ม ได้ด้วยตัวเองผ่านระบบออโต้ โดยไม่ต้องรอทีมงานยืนยัน
        ทุกเมนูถูกจัดวางให้กดถึงได้ไวจากแดชบอร์ดเดียว หากพบว่าหน้าเข้าสู่ระบบมีหน้าตาผิดไปจากเดิม บัญชีรับเงินเปลี่ยนไป หรือมีใครทักมาขอรหัสผ่านและ OTP ให้หยุดทำรายการทันทีแล้วตรวจสอบกับทีมงานก่อน หากไม่แน่ใจว่าลิงก์
        <strong class="text-pink-200">ทางเข้า BUNNY555</strong> หรือลิงก์สมัครสมาชิกใดคือของจริง เราเตรียมลิงก์ที่ถูกต้องไว้ให้แล้วที่ปุ่มด้านล่างนี้
      </p>

      <div class="mb-5 grid grid-cols-1 gap-8 md:grid-cols-2">
        <div class="flex flex-col items-center justify-center gap-4">
          <a
            href="/login"
            aria-label="เข้าสู่ระบบ BUNNY555"
            class="group relative mx-auto flex w-full max-w-[320px] items-center justify-center gap-3 overflow-hidden rounded-xl border border-rose-400/70 bg-gradient-to-b from-[#3a1122] to-[#0a0305] px-6 py-4 shadow-[0_0_20px_rgba(190,24,93,0.45),inset_0_-4px_8px_rgba(0,0,0,0.2)] transition-all duration-300 hover:scale-105 hover:shadow-[0_0_30px_rgba(190,24,93,0.7)]">
            <div class="absolute inset-x-0 top-0 h-1/2 bg-gradient-to-b from-rose-300/20 to-transparent"></div>

            <svg class="relative z-10 h-9 w-9 text-pink-200 drop-shadow-md" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg">
              <path stroke-linecap="round" stroke-linejoin="round" d="M11 16l-4-4m0 0l4-4m-4 4h14m-5 4v1a3 3 0 01-3 3H6a3 3 0 01-3-3V7a3 3 0 013-3h7a3 3 0 013 3v1"></path>
            </svg>

            <span class="relative z-10 text-3xl font-bold tracking-wide text-pink-200 [text-shadow:_0_2px_4px_rgb(0_0_0_/_60%)]">เข้าสู่ระบบ</span>
          </a>
        </div>

        <div class="flex flex-col items-center justify-center gap-4">
          <a
            href="/register"
            aria-label="สมัครสมาชิก BUNNY555"
            class="group relative mx-auto flex w-full max-w-[320px] items-center justify-center gap-3 overflow-hidden rounded-xl border border-pink-200/70 bg-gradient-to-b from-pink-300 to-pink-500 px-6 py-4 shadow-[0_0_20px_rgba(236,72,153,0.5),inset_0_-4px_8px_rgba(0,0,0,0.2)] transition-all duration-300 hover:scale-105 hover:shadow-[0_0_30px_rgba(236,72,153,0.8)]">
            <div class="absolute inset-x-0 top-0 h-1/2 bg-gradient-to-b from-white/40 to-transparent"></div>

            <svg class="relative z-10 h-9 w-9 text-[#241019] drop-shadow-md" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg">
              <path stroke-linecap="round" stroke-linejoin="round" d="M18 9v3m0 0v3m0-3h3m-3 0h-3m-2-5a4 4 0 11-8 0 4 4 0 018 0zM3 20a6 6 0 0112 0v1H3v-1z"></path>
            </svg>

            <span class="relative z-10 text-3xl font-bold tracking-wide text-[#241019]">สมัครสมาชิก</span>
          </a>
        </div>
      </div>
    </div>
  </ContentBox>

  <Navfoot />
</MainLayout>
