---
import MainLayout from "../layouts/MainLayout.astro";
import ContentBox from "../components/ContentBox.astro";
import Navfoot from "../components/Navfoot.astro";
import Announcement from "../components/AnnouncementPremium.astro";

import { Picture } from "astro:assets";
import imgLine from "../assets/contact-line.webp";
import { pageGraph } from "../lib/schema";
import { BRAND_ADDRESS } from "../lib/brandProfile";

// This is a BUTTON PAGE, not an article: title → LINE image → address block →
// button row, and nothing else. No <h2>, no explanatory paragraphs. The docx
// gives this page a Title and a Meta and never a body; any prose found here in
// a future round was invented by a rebrand and should be deleted again.
//
// One string, used twice: MainLayout's <meta name="description"> and the
// WebPage node's description. Keeping it in a const is what stops the meta tag
// and the structured data from drifting apart. 150–160 CHARACTERS (Thai is
// 3 bytes/char, so a byte count reads ~3x too long and will send you rewriting
// a description that was fine). The brief's own sentence is 114 characters,
// under verify-build.mjs's 150 floor, so the trailing clause brings it into
// the window without changing what the brief says. This one is 152.
const pageDescription =
  "ช่องทางการติดต่อ TT1BET ศูนย์บริการลูกค้ามาตรฐานสากล ทีมงานพร้อมดูแลและให้คำปรึกษาอย่างรวดเร็วทันใจตลอด 24 ชั่วโมง แชตผ่าน LINE Official เพียงไม่กี่คลิก";

const graph = pageGraph(Astro, {
  type: "ContactPage",
  name: "TT1BET ติดต่อเรา บริการครบวงจร ทีมงานมืออาชีพดูแล 24 ชม.",
  description: pageDescription,
  breadcrumb: [
    { name: "หน้าแรก", path: "/" },
    { name: "ติดต่อเรา", path: "/contact-us" },
  ],
  org: {
    alternateName: "TT1BET คาสิโนออนไลน์ครบวงจร รวมเกมแตกง่าย จ่ายจริง สมัครง่าย",
    contactPoints: [
      {
        contactType: "customer service",
        availableLanguage: ["Thai", "English"],
        // Point at this site's own /line hop, not the short link behind it.
        // This page is indexed, and structured data is read and stored by
        // Google directly — so a shortener host here is the group's most
        // exposed shared identifier. /line forwards to the same place and
        // that redirect page is noindex.
        //
        // `contactOption: "TollFree"` used to be here. That enum describes a
        // freephone NUMBER; on a chat link it is simply false, and a
        // ContactPoint Google rejects takes the rest of the node with it.
        path: "/line",
        description: "ติดต่อแอดมินผ่าน LINE Official",
      },
    ],
  },
});
---

<MainLayout title="TT1BET ติดต่อเรา บริการครบวงจร ทีมงานมืออาชีพดูแล 24 ชม." description={pageDescription}>
  <script type="application/ld+json" set:html={graph} />

  <Announcement />

  <ContentBox title="ติดต่อทีมงาน TT1BET" as="h1">
    <Picture
      src={imgLine}
      alt="พนักงานหญิงยิ้มในชุดเลื่อมสีชมพู ยืนกอดอกอยู่หลังปุ่มสีขาวที่มีโลโก้ LINE สีเขียวและคำว่า Support ช่องทางแชตกับทีมงาน TT1BET"
      loading="lazy"
      fetchpriority="low"
      widths={[200, 400, 600]}
      sizes="(max-width: 768px) 100vw, 400px"
      class="mx-auto h-auto w-full max-w-[400px] object-contain shadow-[0_10px_30px_rgba(235,221,101,0.18)]"
      decoding="async"
      formats={["avif", "webp"]}
      fallbackFormat="webp"
      quality={60}
    />
    {
      BRAND_ADDRESS.lines.length > 0 && (
        <address
          aria-label={BRAND_ADDRESS.label}
          class="mt-8 mb-8 border-l-4 border-[#ebdd65] pl-6 text-left text-base leading-relaxed text-[#f0e6cc] not-italic">
          <p class="mb-1 font-bold text-[#fcf6ab]">{BRAND_ADDRESS.label}</p>
          {BRAND_ADDRESS.lines.map((line) => (
            <span class="block">{line}</span>
          ))}
          {BRAND_ADDRESS.email && (
            <span class="mt-3 block">
              <span aria-hidden="true" class="mr-2">✉️</span>
              <a href={`mailto:${BRAND_ADDRESS.email}`} class="font-bold text-[#ebdd65] underline decoration-current/40 underline-offset-4">
                {BRAND_ADDRESS.email}
              </a>
            </span>
          )}
        </address>
      )
    }

    <div class="flex flex-wrap justify-center gap-4">
      <a
        href="/register"
        aria-label="สมัครสมาชิก"
        class="flex items-center justify-center rounded-lg border border-[#ebdd65]/60 bg-gradient-to-b from-[#fcf6ab] via-[#ebdd65] to-[#a8790f] px-8 py-3 font-bold text-[#0a0704] shadow-[0_10px_30px_rgba(235,221,101,0.20)] transition-transform hover:scale-105 hover:shadow-[0_15px_40px_rgba(235,221,101,0.32)]">
        สมัครสมาชิก
      </a>

      <a
        href="/login"
        aria-label="เข้าสู่ระบบ"
        class="flex items-center justify-center rounded-lg border border-[#ebdd65]/50 bg-[#0a0704] px-8 py-3 font-extrabold text-[#ebdd65] shadow-[0_4px_14px_rgba(212,180,51,0.18)] transition-transform hover:scale-105 hover:border-[#ebdd65] hover:bg-[#241a08]">
        เข้าสู่ระบบ
      </a>

      <a
        href="/line"
        target="_blank"
        rel="noopener noreferrer"
        aria-label="ติดต่อทีมงานผ่าน Line Official"
        class="flex items-center justify-center rounded-lg border border-green-300 bg-gradient-to-b from-green-400 to-green-700 px-8 py-3 font-bold text-white transition-transform hover:scale-105">
        ติดต่อผ่าน Line Official
      </a>
    </div>
  </ContentBox>
  <Navfoot />
</MainLayout>
