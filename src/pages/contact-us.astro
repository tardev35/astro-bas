---
import MainLayout from "../layouts/MainLayout.astro";
import ContentBox from "../components/ContentBoxHuay.astro";
import Navfoot from "../components/Navfoot.astro";
import Announcement from "../components/Announcement.astro";

import { Picture } from "astro:assets";
import imgLine from "../assets/contact-line.webp";

const homePage = "https://lapdee88-play.com";
const logoUrl = homePage + "/logo.webp";

const contactPageSchema = {
  "@context": "https://schema.org",
  "@type": "ContactPage",
  name: "ติดต่อทีมงาน LAPDEE88 ผ่าน LINE Official",
  description: "ช่องทางติดต่อทีมงาน LAPDEE88 ผ่าน LINE Official สำหรับปัญหาสมัครสมาชิกด้วยเบอร์โทร ฝากขั้นต่ำ 1 บาท ระบบออโต้ การถอน และการเข้าเกมสล็อตหรือคาสิโนสด พร้อมข้อมูลที่ควรเตรียมก่อนแจ้งเรื่อง",
  url: homePage + "/contact-us",
  mainEntity: {
    "@type": "Organization",
    name: "LAPDEE88",
    logo: logoUrl,
    url: homePage,
    contactPoint: [
      {
        "@type": "ContactPoint",
        contactType: "customer service",
        availableLanguage: ["Thai", "English"],
        contactOption: "TollFree",
        // Point at this site's own /line hop, not the short link behind it.
        // This page is indexed, and structured data is read and stored by
        // Google directly — so a shortener host here is the group's most
        // exposed shared identifier. /line forwards to the same place and
        // that redirect page is noindex.
        url: homePage + "/line",
        description: "ติดต่อแอดมินผ่าน LINE Official",
      },
    ],
  },
};
---

<script type="application/ld+json" set:html={JSON.stringify(contactPageSchema)} />
<MainLayout
  title="ติดต่อเรา LAPDEE88 แจ้งปัญหาสมัครสมาชิก ฝากถอน และเข้าเกม ผ่าน LINE Official"
  description="ช่องทางติดต่อทีมงาน LAPDEE88 ผ่าน LINE Official สำหรับปัญหาสมัครด้วยเบอร์โทร ฝากขั้นต่ำ 1 บาท ระบบออโต้ผ่านธนาคารและ TrueMoney Wallet การถอน และการเข้าเกมสล็อตหรือคาสิโนสด พร้อมรายการข้อมูลที่ควรเตรียมให้ครบก่อนแจ้ง และคำเตือนว่าไม่ควรส่งรหัสผ่านหรือ OTP ให้ใครเด็ดขาด">
  <Announcement />

  <ContentBox>
    <h1 class="mb-5 bg-gradient-to-r from-white via-amber-100 to-amber-400 bg-clip-text text-3xl font-black tracking-widest text-transparent uppercase drop-shadow-sm">ติดต่อทีมงาน LAPDEE88</h1>

    <h2 class="mb-6 text-2xl leading-normal font-bold text-amber-100">ติดปัญหาสมัครสมาชิก ฝากถอน หรือเข้าเกมไม่ได้ ทักทีมงาน LAPDEE88 ทางไหน</h2>

    <Picture
      src={imgLine}
      alt="ติดต่อทีมงาน LAPDEE88 ผ่าน LINE Official"
      loading="lazy"
      fetchpriority="low"
      widths={[200, 400, 600]}
      sizes="(max-width: 768px) 100vw"
      class="mx-auto h-auto w-full max-w-[400px] object-contain shadow-xl"
      decoding="async"
      formats={["avif", "webp"]}
      fallbackFormat="webp"
      quality={60}
    />
    <p class="my-5 text-left text-base leading-relaxed text-amber-50/85">
      ช่องทางหลักของ <strong class="text-amber-200">LAPDEE88</strong> คือ LINE Official ที่แสดงอยู่บนหน้าเว็บ ใช้ได้ตั้งแต่การสมัครสมาชิกด้วยเบอร์โทรศัพท์ไทยที่ใช้เวลาประมาณ 2–3 นาที การตั้งรหัสผ่าน การฝากขั้นต่ำ 1 บาทผ่านระบบออโต้ที่รองรับทั้งธนาคารและ TrueMoney Wallet
      ไปจนถึงการถอนและการเข้าเกมสล็อตหลายค่ายหรือคาสิโนสด หากเครดิตยังไม่เข้าหลังโอน ให้ทักมาพร้อมสถานะรายการและหลักฐาน อย่ารีบโอนซ้ำจนยอดซ้อน เพราะรายการซ้ำต้องใช้เวลาตรวจย้อนหลังนานกว่าเดิม
    </p>

    <h2 class="mt-8 mb-6 text-2xl leading-normal font-bold text-amber-100">ควรเตรียมข้อมูลอะไรก่อนแจ้งเรื่อง และอะไรที่ห้ามส่งให้ใครเด็ดขาด</h2>

    <p class="mb-6 text-left text-base leading-relaxed text-amber-50/85">
      ก่อนทักเข้ามา ควรเตรียมเบอร์ที่ใช้สมัคร เวลาที่ทำรายการ จำนวนเงิน เลขอ้างอิงจากธนาคารหรือวอเลท ชื่อเกมที่ติดปัญหา และภาพหน้าจอที่เกี่ยวข้อง ถ้าเป็นเรื่องโบนัส ให้ระบุด้วยว่ารับสิทธิ์ตอนไหน เพราะยอดฝากขั้นต่ำ เทิร์นโอเวอร์ เกมที่ร่วมรายการ ระยะเวลา และเพดานถอนของแต่ละแคมเปญไม่เท่ากัน
      ที่สำคัญคือไม่ควรส่งรหัสผ่านหรือ OTP ให้ผู้อื่นไม่ว่ากรณีใด ทีมงานไม่มีความจำเป็นต้องขอสองอย่างนี้ ต่อให้อีกฝั่งพิมพ์มาหวานแค่ไหน รหัสนี้ก็ไม่ได้มีไว้แบ่งปัน และควรติดต่อผ่านช่องทางที่แสดงบนเว็บไซต์จริงเท่านั้น ไม่ใช่ลิงก์ที่เด้งมาจากข้อความส่วนตัว
    </p>

    <div class="flex flex-wrap justify-center gap-4">
      <a
        href="/register"
        aria-label="สมัครสมาชิก"
        class="flex items-center justify-center rounded-lg border border-amber-200/60 bg-gradient-to-b from-[#f6e4b4] via-[#e0bd72] to-[#b1873a] px-8 py-3 font-bold text-[#140f05] shadow-[0_10px_30px_rgba(212,175,90,0.35)] transition-transform hover:scale-105 hover:shadow-[0_10px_30px_rgba(212,175,90,0.5)]">
        สมัครสมาชิก
      </a>

      <a
        href="/login"
        aria-label="เข้าเล่นเกม"
        class="flex items-center justify-center rounded-lg border border-amber-400/70 bg-gradient-to-b from-[#1c1609] to-[#0b0906] px-8 py-3 font-extrabold text-amber-200 shadow-[0_0_10px_rgba(212,175,90,0.5)] transition-transform hover:scale-105">
        เข้าเล่นเกม
      </a>

      <a
        href="/line"
        target="_blank"
        rel="noopener noreferrer"
        aria-label="ติดต่อทีมงานผ่าน Line Official"
        class="flex items-center justify-center rounded-lg border border-green-300 bg-gradient-to-b from-green-400 to-green-700 px-8 py-3 font-bold text-white transition-transform hover:scale-105">
        ติดต่อผ่าน Line Official
      </a>
    </div>
  </ContentBox>
  <Navfoot />
</MainLayout>
