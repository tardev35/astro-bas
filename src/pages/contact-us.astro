---
import MainLayout from "../layouts/MainLayout.astro";
import ContentBox from "../components/ContentBoxCyberCut.astro";
import Navfoot from "../components/Navfoot.astro";
import Announcement from "../components/Announcement5.astro";

import { Picture } from "astro:assets";
import imgLine from "../assets/contact-line.webp";

const homePage = "https://sudyod888-brand.com";
const logoUrl = homePage + "/logo.webp";

const contactPageSchema = {
  "@context": "https://schema.org",
  "@type": "ContactPage",
  name: "ติดต่อทีมงาน SUDYOD888 ผ่าน LINE Official",
  description: "ช่องทางติดต่อทีมงาน SUDYOD888 ผ่าน LINE Official สำหรับปัญหาสมัครสมาชิก เข้าสู่ระบบ ลืมรหัสผ่าน การฝากถอนออโต้ สิทธิ์คืนยอดเสียรายสัปดาห์ คอมมิชชั่นแนะนำเพื่อน และการเข้าเกมสล็อต เกมยิงปลา หรือคาสิโนสด พร้อมข้อมูลที่ควรเตรียมก่อนแจ้งเรื่อง",
  url: homePage + "/contact-us",
  mainEntity: {
    "@type": "Organization",
    name: "SUDYOD888",
    alternateName: "SUDYOD888 เว็บตรงสล็อต",
    logo: logoUrl,
    url: homePage + "/",
    contactPoint: [
      {
        "@type": "ContactPoint",
        contactType: "customer service",
        availableLanguage: ["Thai", "English"],
        contactOption: "TollFree",
        // Point at this site's own /line hop, not the short link behind it.
        // This page is indexed, and structured data is read and stored by
        // Google directly — so a shortener host here is the group's most
        // exposed shared identifier. /line forwards to the same place and
        // that redirect page is noindex.
        url: homePage + "/line",
        description: "ติดต่อแอดมินผ่าน LINE Official",
      },
    ],
  },
};
---

<MainLayout
  title="ติดต่อเรา SUDYOD888 แจ้งปัญหาสมัครสมาชิก เข้าสู่ระบบ ฝากถอนออโต้ และคืนยอดเสีย ผ่าน LINE Official"
  description="ช่องทางติดต่อทีมงาน SUDYOD888 ผ่าน LINE Official สำหรับปัญหาสมัครสมาชิก เข้าสู่ระบบ ลืมรหัสผ่าน การฝากถอนออโต้ผ่าน Mobile Banking และ True Wallet สิทธิ์คืนยอดเสียรายสัปดาห์ คอมมิชชั่นแนะนำเพื่อน 3–5% และการเข้าเกมสล็อต เกมยิงปลา หรือคาสิโนสด พร้อมรายการข้อมูลที่ควรเตรียมให้ครบก่อนแจ้งเรื่อง และคำเตือนว่าไม่ควรส่งรหัสผ่านหรือ OTP ให้ใครเด็ดขาด">
  <script type="application/ld+json" set:html={JSON.stringify(contactPageSchema)} />

  <Announcement />

  <ContentBox title="ติดต่อทีมงาน SUDYOD888" as="h1">
    <h2 class="mb-6 text-2xl leading-normal font-bold text-[#f5c53d]">ติดปัญหาสมัครสมาชิก เข้าสู่ระบบ ฝากถอน หรือรับสิทธิ์คืนยอดเสีย ทักทีมงาน SUDYOD888 ทางไหน</h2>

    <Picture
      src={imgLine}
      alt="ติดต่อทีมงาน SUDYOD888 ผ่าน LINE Official"
      loading="lazy"
      fetchpriority="low"
      widths={[200, 400, 600]}
      sizes="(max-width: 768px) 100vw"
      class="mx-auto h-auto w-full max-w-[400px] object-contain shadow-[0_10px_30px_rgba(245,197,61,0.18)]"
      decoding="async"
      formats={["avif", "webp"]}
      fallbackFormat="webp"
      quality={60}
    />
    <p class="my-5 text-left text-base leading-relaxed text-[#ece2cc]">
      ช่องทางหลักของ <strong class="text-[#ffe9a8]">SUDYOD888</strong> คือ LINE Official ที่แสดงอยู่บนหน้าเว็บ ใช้ได้ตั้งแต่ขั้นตอนสมัครสมาชิกที่ต้องเตรียมเบอร์โทรศัพท์ ชื่อ–นามสกุล รหัสผ่าน และบัญชีธนาคารที่ชื่อตรงกับผู้สมัคร ไปจนถึงการเข้าสู่ระบบ การกู้คืนรหัสผ่านเมื่อเข้าบัญชีไม่ได้ การฝากถอนออโต้ผ่าน Mobile Banking หรือ True Wallet และการเข้าเกมสล็อต เกมยิงปลา และคาสิโนสดที่มีรวมกันมากกว่า 200 รายการ รวมถึงเรื่องสิทธิ์คืนยอดเสียรายสัปดาห์และคอมมิชชั่นแนะนำเพื่อน 3–5%
      การถอนกำหนดขั้นต่ำ 100 บาท และไม่เกิน 49,000 บาทต่อรายการ ส่วนระยะเวลาจริงเปลี่ยนได้ตามธนาคารและสถานะระบบ ถ้ารายการยังไม่ขึ้นสถานะ ให้ทักมาพร้อมสลิปและเลขอ้างอิงแทนการกดซ้ำ เพราะรายการซ้ำใช้เวลาตรวจย้อนหลังนานกว่าการรอรอบเดิมเสียอีก
    </p>

    <h2 class="mt-8 mb-6 text-2xl leading-normal font-bold text-[#f5c53d]">ควรเตรียมข้อมูลอะไรก่อนแจ้งเรื่อง และอะไรที่ห้ามส่งให้ใครเด็ดขาด</h2>

    <p class="mb-6 text-left text-base leading-relaxed text-[#ece2cc]">
      ก่อนทักเข้ามา ควรเตรียมข้อมูลที่ใช้สมัคร เวลาที่ทำรายการ จำนวนเงิน เลขอ้างอิงจากช่องทางที่โอน ชื่อบัญชีรับเงินที่ตรงกับข้อมูลสมาชิก ชื่อเกมและหมวดที่ติดปัญหาว่าเป็นสล็อต เกมยิงปลา หรือคาสิโนสด พร้อมภาพหน้าจอที่เกี่ยวข้อง ถ้าเป็นเรื่องโบนัสสูงสุด 400% หรือคืนยอดเสีย ให้ระบุด้วยว่ารับสิทธิ์รอบไหนและกดรับตอนกี่โมง เพราะยอดคืนคิดจากผลได้และผลเสียในรอบ เปิดให้กดรับทุกวันอาทิตย์หลังเวลา 12.00 น. ในหน้าต่างเวลาจำกัด และเงื่อนไขการทำเทิร์นกับเกมที่ร่วมรายการของแต่ละแคมเปญไม่เท่ากัน ข้อมูลครบตั้งแต่ข้อความแรกช่วยได้มากกว่าการเล่าเป็นตอน ๆ
      ที่สำคัญคือไม่ควรส่งรหัสผ่านหรือ OTP ให้ผู้อื่นไม่ว่ากรณีใด ทีมงานไม่มีความจำเป็นต้องขอสองอย่างนี้ ต่อให้อีกฝั่งพิมพ์มาสุภาพแค่ไหน รหัสชุดนี้ก็ไม่ได้มีไว้แบ่งปัน และควรติดต่อผ่านช่องทางที่แสดงบนเว็บไซต์จริงเท่านั้น ไม่ใช่ลิงก์ที่เด้งมาจากข้อความส่วนตัว
    </p>

    <div class="flex flex-wrap justify-center gap-4">
      <a
        href="/register"
        aria-label="สมัครสมาชิก"
        class="flex items-center justify-center rounded-lg border border-[#f5c53d]/60 bg-gradient-to-b from-[#ffe9a8] via-[#f5c53d] to-[#c8921e] px-8 py-3 font-bold text-[#080503] shadow-[0_10px_30px_rgba(245,197,61,0.18)] transition-transform hover:scale-105 hover:shadow-[0_15px_40px_rgba(245,197,61,0.30)]">
        สมัครสมาชิก
      </a>

      <a
        href="/login"
        aria-label="เข้าเล่นเกม"
        class="flex items-center justify-center rounded-lg border border-[#f5c53d]/60 bg-[#140d06] px-8 py-3 font-extrabold text-[#ffe9a8] shadow-[0_4px_14px_rgba(245,197,61,0.18)] transition-transform hover:scale-105 hover:bg-[#1e1409]">
        เข้าเล่นเกม
      </a>

      <a
        href="/line"
        target="_blank"
        rel="noopener noreferrer"
        aria-label="ติดต่อทีมงานผ่าน Line Official"
        class="flex items-center justify-center rounded-lg border border-green-300 bg-gradient-to-b from-green-400 to-green-700 px-8 py-3 font-bold text-white transition-transform hover:scale-105">
        ติดต่อผ่าน Line Official
      </a>
    </div>
  </ContentBox>
  <Navfoot />
</MainLayout>
