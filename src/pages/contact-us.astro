---
import MainLayout from "../layouts/MainLayout.astro";
import ContentBox from "../components/ContentBoxHuay.astro";
import Navfoot from "../components/Navfoot.astro";
import Announcement from "../components/Announcement6.astro";

import { Picture } from "astro:assets";
import imgLine from "../assets/contact-line.webp";

const homePage = "https://gsybet-guideline.com";
const logoUrl = homePage + "/logo.webp";

const contactPageSchema = {
  "@context": "https://schema.org",
  "@type": "ContactPage",
  name: "ติดต่อทีมงาน GSYBET เว็บเกมคาสิโนออนไลน์ ทางเข้าเว็บตรงครบวงจร",
  description: "ช่องทางติดต่อทีมงาน GSYBET ดูแลการใช้งานเว็บไซต์และระบบฝากถอนอัตโนมัติ ตลอด 24 ชั่วโมง",
  url: homePage + "/contact-us",
  mainEntity: {
    "@type": "Organization",
    name: "GSYBET",
    logo: logoUrl,
    url: homePage,
    contactPoint: [
      {
        "@type": "ContactPoint",
        contactType: "customer service",
        availableLanguage: ["Thai", "English"],
        contactOption: "TollFree",
        url: "https://tinyurl.com/linepigpg",
        description: "ติดต่อแอดมินผ่าน LINE Official",
      },
    ],
  },
};
---

<script type="application/ld+json" set:html={JSON.stringify(contactPageSchema)} />
<MainLayout
  title="ติดต่อเรา GSYBET เว็บเกมคาสิโนออนไลน์ ทีมงานดูแลตลอด 24 ชั่วโมง"
  description="ช่องทางติดต่อทีมงาน GSYBET เว็บเกมคาสิโนออนไลน์ ทางเข้าเว็บตรงครบวงจร สอบถามการสมัครสมาชิก ระบบฝากถอนอัตโนมัติ และการตรวจสอบโดเมนที่ถูกต้อง ได้ตลอด 24 ชั่วโมง">
  <Announcement />

  <ContentBox>
    <h1 class="mb-8 text-3xl text-amber-400">ติดต่อทีมงาน GSYBET ดูแลตลอด 24 ชั่วโมง</h1>
    <Picture
      src={imgLine}
      alt="ติดต่อทีมงาน GSYBET ผ่าน LINE Official"
      loading="lazy"
      fetchpriority="low"
      widths={[200, 400, 600]}
      sizes="(max-width: 768px) 100vw"
      class="mx-auto h-auto w-full max-w-[400px] object-contain shadow-xl"
      decoding="async"
      formats={["avif", "webp"]}
      fallbackFormat="webp"
      quality={60}
    />
    <p class="my-5 mb-8 text-left text-base leading-relaxed text-amber-50/80">
      นอกจากบริการด้านเกมแล้ว <strong class="text-amber-300">GSYBET</strong> ยังมีช่องทางติดต่อทีมงาน ข่าวสาร และข้อมูลอัปเดตของเว็บไซต์ เพื่อช่วยให้สมาชิกติดตามความเคลื่อนไหวและขอความช่วยเหลือได้เมื่อจำเป็น ไม่ว่าจะเป็นการสมัครสมาชิก การใช้งานระบบฝากถอนอัตโนมัติ
      หรือการตรวจสอบชื่อโดเมนทางเข้าให้ตรงกับเว็บไซต์จริงก่อนเข้าสู่ระบบ ทีมงานพร้อมดูแลตลอด 24 ชั่วโมง
    </p>
    <div class="flex flex-wrap justify-center gap-4">
      <a
        href="/register"
        aria-label="สมัครสมาชิก"
        class="flex items-center justify-center rounded-lg border border-amber-300/60 bg-gradient-to-b from-amber-400 to-amber-600 px-8 py-3 font-bold text-[#1a1204] shadow-[0_10px_30px_rgba(234,179,8,0.35)] transition-transform hover:scale-105 hover:shadow-[0_10px_30px_rgba(234,179,8,0.55)]">
        สมัครสมาชิก
      </a>

      <a
        href="/login"
        aria-label="เข้าเล่นเกม"
        class="flex items-center justify-center rounded-lg border border-amber-400/70 bg-gradient-to-b from-[#241803] to-[#0a0703] px-8 py-3 font-extrabold text-amber-200 shadow-[0_0_10px_rgba(245,158,11,0.5)] transition-transform hover:scale-105">
        เข้าเล่นเกม
      </a>

      <a
        href="/line"
        target="_blank"
        rel="noopener noreferrer"
        aria-label="ติดต่อเราผ่าน Line"
        class="flex items-center justify-center rounded-lg border border-green-300 bg-gradient-to-b from-green-400 to-green-700 px-8 py-3 font-bold text-white transition-transform hover:scale-105">
        ติดต่อเรา
      </a>
    </div>
  </ContentBox>
  <Navfoot />
</MainLayout>
