---
import MainLayout from "../layouts/MainLayout.astro";
import ContentBox from "../components/ContentBoxHuay.astro";
import Navfoot from "../components/Navfoot.astro";
import Announcement from "../components/Announcement4.astro";

import { Picture } from "astro:assets";
import imgLine from "../assets/contact-line.webp";

const homePage = "https://pay69-brand.com";
const logoUrl = homePage + "/logo.webp";

const contactPageSchema = {
  "@context": "https://schema.org",
  "@type": "ContactPage",
  name: "ติดต่อทีมงาน PAY69 ผ่าน LINE Official",
  description: "ช่องทางติดต่อทีมงาน PAY69 ผ่าน LINE Official สำหรับปัญหาสมัครสมาชิก ฝากถอน กิจกรรมเปิดกล่อง ล่า Hidden และการเข้าเกม พร้อมข้อมูลที่ควรเตรียมก่อนแจ้งเรื่อง",
  url: homePage + "/contact-us",
  mainEntity: {
    "@type": "Organization",
    name: "PAY69",
    logo: logoUrl,
    url: homePage,
    contactPoint: [
      {
        "@type": "ContactPoint",
        contactType: "customer service",
        availableLanguage: ["Thai", "English"],
        contactOption: "TollFree",
        // Point at this site's own /line hop, not the short link behind it.
        // This page is indexed, and structured data is read and stored by
        // Google directly — so a shortener host here is the group's most
        // exposed shared identifier. /line forwards to the same place and
        // that redirect page is noindex.
        url: homePage + "/line",
        description: "ติดต่อแอดมินผ่าน LINE Official",
      },
    ],
  },
};
---

<script type="application/ld+json" set:html={JSON.stringify(contactPageSchema)} />
<MainLayout
  title="ติดต่อทีมงาน PAY69 ผ่าน LINE Official พร้อมข้อมูลที่ควรเตรียมก่อนแจ้งเรื่อง"
  description="ช่องทางติดต่อทีมงาน PAY69 ผ่าน LINE Official สำหรับปัญหาสมัคร ฝากถอน กิจกรรมเปิดกล่อง ล่า Hidden และการเข้าเกม พร้อมรายการข้อมูลที่ควรเตรียมให้ครบก่อนแจ้ง และคำเตือนว่าไม่ควรส่งรหัสผ่านหรือ OTP ให้ใครเด็ดขาด">
  <Announcement />

  <ContentBox>
    <h1 class="mb-5 bg-gradient-to-r from-white via-amber-100 to-amber-300 bg-clip-text text-3xl font-black tracking-widest text-transparent uppercase drop-shadow-sm">ติดต่อทีมงาน PAY69</h1>

    <h2 class="mb-6 text-2xl leading-normal font-bold text-amber-100">ติดปัญหาสมัคร ฝากถอน หรือเข้าเกมไม่ได้ ทักทีมงาน PAY69 ทางไหน</h2>

    <Picture
      src={imgLine}
      alt="ติดต่อทีมงาน PAY69 ผ่าน LINE Official"
      loading="lazy"
      fetchpriority="low"
      widths={[200, 400, 600]}
      sizes="(max-width: 768px) 100vw"
      class="mx-auto h-auto w-full max-w-[400px] object-contain shadow-xl"
      decoding="async"
      formats={["avif", "webp"]}
      fallbackFormat="webp"
      quality={60}
    />
    <p class="my-5 text-left text-base leading-relaxed text-amber-50/85">
      ช่องทางหลักของ <strong class="text-amber-200">PAY69</strong> คือ LINE Official ที่แสดงอยู่บนหน้าเว็บ ใช้ได้ทั้งเรื่องสมัครสมาชิก ตั้งชื่อผู้ใช้ ฝากถอน การเข้าเกมสล็อต กีฬา เกม Live สด และเดิมพันด้านการเงิน รวมถึงกิจกรรมอย่างเปิดกล่อง เปิดดวง ล่า Hidden
      และเครดิตฟรีแบบกดรับเอง หากใช้งานผ่าน PAY69 App แล้วติดปัญหา ให้แจ้งรุ่นอุปกรณ์และเวอร์ชันแอปมาด้วย จะช่วยให้ตรวจสอบได้เร็วขึ้นกว่าการทักมาว่า “เข้าไม่ได้” เฉย ๆ
    </p>

    <h2 class="mt-8 mb-6 text-2xl leading-normal font-bold text-amber-100">ควรเตรียมข้อมูลอะไรก่อนแจ้งเรื่อง และอะไรที่ห้ามส่งให้ใครเด็ดขาด</h2>

    <p class="mb-6 text-left text-base leading-relaxed text-amber-50/85">
      ก่อนทักเข้ามา ควรเตรียมชื่อผู้ใช้ เวลาที่ทำรายการ จำนวนเงิน เลขอ้างอิง ชื่อเกมหรือชื่อกิจกรรมที่ติดปัญหา และภาพหน้าจอที่เกี่ยวข้อง ถ้าเป็นเรื่องโปรอย่างฝากปุ๊บเพิ่ม 5% หรือเครดิตฟรีกดรับเอง ให้ระบุด้วยว่ากดรับตอนไหน เพราะเงื่อนไข ยอดเทิร์น เพดานถอน
      และวันหมดอายุของแต่ละสิทธิ์ไม่เท่ากัน ที่สำคัญคือ ไม่ควรส่งรหัสผ่านหรือ OTP ให้ผู้อื่นไม่ว่ากรณีใด ทีมงานไม่มีความจำเป็นต้องขอสองอย่างนี้ และควรติดต่อผ่านช่องทางที่แสดงบนเว็บไซต์จริงเท่านั้น ไม่ใช่ลิงก์ที่เด้งมาจากข้อความส่วนตัว
    </p>

    <div class="flex flex-wrap justify-center gap-4">
      <a
        href="/register"
        aria-label="สมัครสมาชิก"
        class="flex items-center justify-center rounded-lg border border-amber-200/60 bg-gradient-to-b from-amber-300 to-amber-500 px-8 py-3 font-bold text-[#1a1130] shadow-[0_10px_30px_rgba(212,162,74,0.35)] transition-transform hover:scale-105 hover:shadow-[0_10px_30px_rgba(212,162,74,0.55)]">
        สมัครสมาชิก
      </a>

      <a
        href="/login"
        aria-label="เข้าเล่นเกม"
        class="flex items-center justify-center rounded-lg border border-violet-400/70 bg-gradient-to-b from-[#241040] to-[#0a0714] px-8 py-3 font-extrabold text-amber-200 shadow-[0_0_10px_rgba(124,58,237,0.5)] transition-transform hover:scale-105">
        เข้าเล่นเกม
      </a>

      <a
        href="/line"
        target="_blank"
        rel="noopener noreferrer"
        aria-label="ติดต่อทีมงานผ่าน Line Official"
        class="flex items-center justify-center rounded-lg border border-green-300 bg-gradient-to-b from-green-400 to-green-700 px-8 py-3 font-bold text-white transition-transform hover:scale-105">
        ติดต่อผ่าน Line Official
      </a>
    </div>
  </ContentBox>
  <Navfoot />
</MainLayout>
