---
import MainLayout from "../layouts/MainLayout.astro";
import ContentBox from "../components/ContentBoxPremium.astro";
import Navfoot from "../components/Navfoot.astro";
import Announcement from "../components/Announcement6.astro";

import { Picture } from "astro:assets";
import imgLine from "../assets/contact-line.webp";
import { pageGraph } from "../lib/schema";

const graph = pageGraph(Astro, {
  type: "ContactPage",
  name: "ติดต่อทีมงาน UFAG8 ผ่าน LINE Official",
  description: "ช่องทางติดต่อทีมงาน UFAG8 ผ่าน LINE Official สำหรับปัญหาสมัครสมาชิกด้วยเบอร์โทรศัพท์ เข้าสู่ระบบ ลืมรหัสผ่าน การอ่านราคาบอลและตลาดเดิมพัน สถานะบิลเดี่ยวและบิลสเต็ป รวมถึงการตรวจสอบทางเข้าเว็บไซต์ พร้อมข้อมูลที่ควรเตรียมก่อนแจ้งเรื่อง",
  breadcrumb: [
    { name: "หน้าแรก", path: "/" },
    { name: "ติดต่อเรา", path: "/contact-us" },
  ],
  org: {
    alternateName: "UFAG8 เว็บกีฬา แทงบอลออนไลน์",
    contactPoints: [
      {
        contactType: "customer service",
        availableLanguage: ["Thai", "English"],
        // Point at this site's own /line hop, not the short link behind it.
        // This page is indexed, and structured data is read and stored by
        // Google directly — so a shortener host here is the group's most
        // exposed shared identifier. /line forwards to the same place and
        // that redirect page is noindex.
        //
        // `contactOption: "TollFree"` used to be here. That enum describes a
        // freephone NUMBER; on a chat link it is simply false, and a
        // ContactPoint Google rejects takes the rest of the node with it.
        path: "/line",
        description: "ติดต่อแอดมินผ่าน LINE Official",
      },
    ],
  },
});
---

<MainLayout
  title="ติดต่อเรา UFAG8 แจ้งปัญหาสมัครด้วยเบอร์โทร เข้าสู่ระบบ ราคาบอล และสถานะบิล ผ่าน LINE Official"
  description="ช่องทางติดต่อทีมงาน UFAG8 ผ่าน LINE Official สำหรับปัญหาสมัครสมาชิก เข้าสู่ระบบ ลืมรหัสผ่าน การอ่านราคาบอล และสถานะบิล พร้อมข้อมูลที่ควรเตรียมก่อนแจ้งเรื่อง">
  <script type="application/ld+json" set:html={graph} />

  <Announcement />

  <ContentBox title="ติดต่อทีมงาน UFAG8" as="h1">
    <h2 class="mb-6 text-2xl leading-normal font-bold text-[#dcb96b]">ติดปัญหาสมัครด้วยเบอร์โทร เข้าสู่ระบบ ราคาบอล หรือสถานะบิล ทักทีมงาน UFAG8 ทางไหน</h2>

    <Picture
      src={imgLine}
      alt="ติดต่อทีมงาน UFAG8 ผ่าน LINE Official"
      loading="lazy"
      fetchpriority="low"
      widths={[200, 400, 600]}
      sizes="(max-width: 768px) 100vw"
      class="mx-auto h-auto w-full max-w-[400px] object-contain shadow-[0_10px_30px_rgba(220,185,107,0.18)]"
      decoding="async"
      formats={["avif", "webp"]}
      fallbackFormat="webp"
      quality={60}
    />
    <p class="my-5 text-left text-base leading-relaxed text-[#efeade]">
      ช่องทางหลักของ <strong class="text-[#f2dca4]">UFAG8</strong> คือ LINE Official ที่แสดงอยู่บนหน้าเว็บ ใช้ได้ตั้งแต่ขั้นตอนสมัครสมาชิกที่ใช้เบอร์โทรศัพท์และรหัสผ่านเป็นข้อมูลหลัก ไปจนถึงการเข้าสู่ระบบด้วยเบอร์โทร การกู้คืนรหัสผ่านเมื่อเข้าบัญชีไม่ได้ การหาคู่แข่งขันตามลีกและช่วงเวลา การอ่านตลาดแฮนดิแคป สูง–ต่ำ และ 1X2 รวมถึงการเทียบบอลก่อนแข่งกับบอลสด และการตรวจสถานะบิลเดี่ยวหรือบิลสเต็ปที่ส่งไปแล้ว
      ราคาบอลเปลี่ยนได้ตามเวลา ข่าวผู้เล่น และสถานการณ์ในสนาม ถ้าราคาที่เห็นไม่ตรงกับตอนกดยืนยัน หรือรายการยังไม่ขึ้นสถานะ ให้ทักมาพร้อมเลขรายการและภาพหน้าจอแทนการกดซ้ำ เพราะบิลซ้ำใช้เวลาตรวจย้อนหลังนานกว่าการรอรอบเดิมเสียอีก
    </p>

    <h2 class="mt-8 mb-6 text-2xl leading-normal font-bold text-[#dcb96b]">ควรเตรียมข้อมูลอะไรก่อนแจ้งเรื่อง และอะไรที่ห้ามส่งให้ใครเด็ดขาด</h2>

    <p class="mb-6 text-left text-base leading-relaxed text-[#efeade]">
      ก่อนทักเข้ามา ควรเตรียมเบอร์โทรศัพท์ที่ใช้สมัคร เวลาที่ทำรายการ ชื่อคู่แข่งขันและลีก ประเภทตลาดที่เลือกว่าเป็นแฮนดิแคป สูง–ต่ำ หรือ 1X2 ฝั่งเดิมพัน ราคาที่เห็นตอนกด ยอดเดิมพัน และเลขรายการของบิล ถ้าเป็นบิลสเต็ปให้ระบุจำนวนคู่และวันแข่งขันของทุกคู่ด้วย เพราะผิดเพียงคู่เดียวอาจกระทบทั้งบิล พร้อมแนบภาพหน้าจอที่เกี่ยวข้อง ข้อมูลครบตั้งแต่ข้อความแรกช่วยได้มากกว่าการเล่าเป็นตอน ๆ
      ที่สำคัญคือไม่ควรส่งรหัสผ่านหรือ OTP ให้ผู้อื่นไม่ว่ากรณีใด ทีมงานไม่มีความจำเป็นต้องขอสองอย่างนี้ ต่อให้อีกฝั่งพิมพ์มาสุภาพแค่ไหน รหัสชุดนี้ก็ไม่ได้มีไว้แบ่งปัน หากลืมรหัสควรใช้เมนูกู้คืนจากระบบโดยตรง และควรติดต่อผ่านช่องทางที่แสดงบนเว็บไซต์จริงเท่านั้น ไม่ใช่ลิงก์ที่เด้งมาจากข้อความส่วนตัว
    </p>

    <div class="flex flex-wrap justify-center gap-4">
      <a
        href="/register"
        aria-label="สมัครสมาชิก"
        class="flex items-center justify-center rounded-lg border border-[#dcb96b]/60 bg-gradient-to-b from-[#f2dca4] via-[#dcb96b] to-[#ac893a] px-8 py-3 font-bold text-[#0a0a09] shadow-[0_10px_30px_rgba(220,185,107,0.18)] transition-transform hover:scale-105 hover:shadow-[0_15px_40px_rgba(220,185,107,0.30)]">
        สมัครสมาชิก
      </a>

      <a
        href="/login"
        aria-label="เข้าสู่ระบบ"
        class="flex items-center justify-center rounded-lg border border-[#dcb96b]/60 bg-[#100f0c] px-8 py-3 font-extrabold text-[#f2dca4] shadow-[0_4px_14px_rgba(220,185,107,0.18)] transition-transform hover:scale-105 hover:bg-[#191712]">
        เข้าสู่ระบบ
      </a>

      <a
        href="/line"
        target="_blank"
        rel="noopener noreferrer"
        aria-label="ติดต่อทีมงานผ่าน Line Official"
        class="flex items-center justify-center rounded-lg border border-green-300 bg-gradient-to-b from-green-400 to-green-700 px-8 py-3 font-bold text-white transition-transform hover:scale-105">
        ติดต่อผ่าน Line Official
      </a>
    </div>
  </ContentBox>
  <Navfoot />
</MainLayout>
