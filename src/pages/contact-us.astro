---
import MainLayout from "../layouts/MainLayout.astro";
import ContentBox from "../components/ContentBoxHuay.astro";
import Navfoot from "../components/Navfoot.astro";
import Announcement from "../components/AnnouncementPremium.astro";

import { Picture } from "astro:assets";
import imgLine from "../assets/contact-line.webp";

const homePage = "https://winup888-brand.com";
const logoUrl = homePage + "/logo.webp";

const contactPageSchema = {
  "@context": "https://schema.org",
  "@type": "ContactPage",
  name: "ติดต่อทีมงาน WINUP888 ผ่าน LINE Official",
  description: "ช่องทางติดต่อทีมงาน WINUP888 ผ่าน LINE Official สำหรับปัญหาสมัครสมาชิก เข้าสู่ระบบ ลืมรหัสผ่าน การฝากถอน และการเข้าเกมสล็อตหรือเกม Live สดบนมือถือ พร้อมข้อมูลที่ควรเตรียมก่อนแจ้งเรื่อง",
  url: homePage + "/contact-us",
  mainEntity: {
    "@type": "Organization",
    name: "WINUP888",
    alternateName: "WINUP888 คาสิโนบนมือถือ",
    logo: logoUrl,
    url: homePage + "/",
    contactPoint: [
      {
        "@type": "ContactPoint",
        contactType: "customer service",
        availableLanguage: ["Thai", "English"],
        contactOption: "TollFree",
        // Point at this site's own /line hop, not the short link behind it.
        // This page is indexed, and structured data is read and stored by
        // Google directly — so a shortener host here is the group's most
        // exposed shared identifier. /line forwards to the same place and
        // that redirect page is noindex.
        url: homePage + "/line",
        description: "ติดต่อแอดมินผ่าน LINE Official",
      },
    ],
  },
};
---

<script type="application/ld+json" set:html={JSON.stringify(contactPageSchema)} />
<MainLayout
  title="ติดต่อเรา WINUP888 แจ้งปัญหาสมัครสมาชิก เข้าสู่ระบบ ฝากถอน และเข้าเกม ผ่าน LINE Official"
  description="ช่องทางติดต่อทีมงาน WINUP888 ผ่าน LINE Official สำหรับปัญหาสมัครสมาชิก เข้าสู่ระบบ ลืมรหัสผ่าน การฝากถอน และการเข้าเกมสล็อตหรือเกม Live สดบนมือถือ พร้อมรายการข้อมูลที่ควรเตรียมให้ครบก่อนแจ้งเรื่อง และคำเตือนว่าไม่ควรส่งรหัสผ่านหรือ OTP ให้ใครเด็ดขาด">
  <Announcement />

  <ContentBox>
    <h1 class="mb-5 bg-gradient-to-r from-[#7a5a12] via-[#b8912f] to-[#8a6a1f] bg-clip-text text-3xl font-black tracking-widest text-transparent uppercase drop-shadow-sm">ติดต่อทีมงาน WINUP888</h1>

    <h2 class="mb-6 text-2xl leading-normal font-bold text-[#a07c1f]">ติดปัญหาสมัครสมาชิก เข้าสู่ระบบ ฝากถอน หรือเข้าเกมไม่ได้ ทักทีมงาน WINUP888 ทางไหน</h2>

    <Picture
      src={imgLine}
      alt="ติดต่อทีมงาน WINUP888 ผ่าน LINE Official"
      loading="lazy"
      fetchpriority="low"
      widths={[200, 400, 600]}
      sizes="(max-width: 768px) 100vw"
      class="mx-auto h-auto w-full max-w-[400px] object-contain shadow-[0_10px_30px_rgba(168,132,44,0.18)]"
      decoding="async"
      formats={["avif", "webp"]}
      fallbackFormat="webp"
      quality={60}
    />
    <p class="my-5 text-left text-base leading-relaxed text-[#3a2e18]">
      ช่องทางหลักของ <strong class="text-[#8a6410]">WINUP888</strong> คือ LINE Official ที่แสดงอยู่บนหน้าเว็บ ใช้ได้ตั้งแต่ขั้นตอนสมัครสมาชิก การเข้าสู่ระบบ การกู้คืนรหัสผ่านเมื่อเข้าบัญชีไม่ได้ ไปจนถึงการฝากถอนและการเข้าเกมสล็อตหลายค่ายหรือเกม Live สดบนมือถือ
      หากรายการยังไม่ขึ้นสถานะหลังทำธุรกรรม ให้ทักมาพร้อมสถานะรายการและหลักฐาน อย่ารีบกดซ้ำจนกลายเป็นสองรายการ เพราะรายการซ้ำต้องใช้เวลาตรวจย้อนหลังนานกว่าเดิม
    </p>

    <h2 class="mt-8 mb-6 text-2xl leading-normal font-bold text-[#a07c1f]">ควรเตรียมข้อมูลอะไรก่อนแจ้งเรื่อง และอะไรที่ห้ามส่งให้ใครเด็ดขาด</h2>

    <p class="mb-6 text-left text-base leading-relaxed text-[#3a2e18]">
      ก่อนทักเข้ามา ควรเตรียมข้อมูลที่ใช้สมัคร เวลาที่ทำรายการ จำนวนเงิน เลขอ้างอิงจากช่องทางที่โอน ชื่อบัญชีรับเงินที่ตรงกับข้อมูลสมาชิก ชื่อเกมที่ติดปัญหา และภาพหน้าจอที่เกี่ยวข้อง ถ้าเป็นเรื่องโบนัส ให้ระบุด้วยว่ารับสิทธิ์ตอนไหน เพราะเงื่อนไขการทำยอด เกมที่ร่วมรายการ ระยะเวลา และเพดานถอนของแต่ละแคมเปญไม่เท่ากัน
      ที่สำคัญคือไม่ควรส่งรหัสผ่านหรือ OTP ให้ผู้อื่นไม่ว่ากรณีใด ทีมงานไม่มีความจำเป็นต้องขอสองอย่างนี้ ต่อให้อีกฝั่งพิมพ์มาหวานแค่ไหน รหัสนี้ก็ไม่ได้มีไว้แบ่งปัน และควรติดต่อผ่านช่องทางที่แสดงบนเว็บไซต์จริงเท่านั้น ไม่ใช่ลิงก์ที่เด้งมาจากข้อความส่วนตัว
    </p>

    <div class="flex flex-wrap justify-center gap-4">
      <a
        href="/register"
        aria-label="สมัครสมาชิก"
        class="flex items-center justify-center rounded-lg border border-[#c9a227]/60 bg-gradient-to-b from-[#f4dfa3] via-[#d9b45c] to-[#a97f2a] px-8 py-3 font-bold text-[#231a06] shadow-[0_10px_30px_rgba(168,132,44,0.18)] transition-transform hover:scale-105 hover:shadow-[0_15px_40px_rgba(168,132,44,0.30)]">
        สมัครสมาชิก
      </a>

      <a
        href="/login"
        aria-label="เข้าเล่นเกม"
        class="flex items-center justify-center rounded-lg border border-[#c9a227]/60 bg-[#fffdf7] px-8 py-3 font-extrabold text-[#8a6410] shadow-[0_4px_14px_rgba(168,132,44,0.18)] transition-transform hover:scale-105 hover:bg-[#f4ecd8]">
        เข้าเล่นเกม
      </a>

      <a
        href="/line"
        target="_blank"
        rel="noopener noreferrer"
        aria-label="ติดต่อทีมงานผ่าน Line Official"
        class="flex items-center justify-center rounded-lg border border-green-300 bg-gradient-to-b from-green-400 to-green-700 px-8 py-3 font-bold text-white transition-transform hover:scale-105">
        ติดต่อผ่าน Line Official
      </a>
    </div>
  </ContentBox>
  <Navfoot />
</MainLayout>
