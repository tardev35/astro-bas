---
import MainLayout from "../layouts/MainLayout.astro";
import ContentBox from "../components/ContentBoxHuay.astro";
import Navfoot from "../components/Navfoot.astro";
import Announcement from "../components/Announcement5.astro";

import { Picture } from "astro:assets";
import imgLine from "../assets/contact-line.webp";

const homePage = "https://bunny555-game.com";
const logoUrl = homePage + "/logo.webp";

const contactPageSchema = {
  "@context": "https://schema.org",
  "@type": "ContactPage",
  name: "ติดต่อทีมงาน BUNNY555 ผ่าน LINE Official",
  description: "ช่องทางติดต่อทีมงาน BUNNY555 ผ่าน LINE Official ดูแลตลอด 24 ชั่วโมง ทั้งการสมัครในคลิกเดียว การกดรับโปรโมชั่นผ่านระบบออโต้ และการเข้าเล่นเกมจากค่าย PG Soft Pragmatic Play และ JOKER Gaming",
  url: homePage + "/contact-us",
  mainEntity: {
    "@type": "Organization",
    name: "BUNNY555",
    logo: logoUrl,
    url: homePage,
    contactPoint: [
      {
        "@type": "ContactPoint",
        contactType: "customer service",
        availableLanguage: ["Thai", "English"],
        contactOption: "TollFree",
        // Point at this site's own /line hop, not the short link behind it.
        // This page is indexed, and structured data is read and stored by
        // Google directly — so a shortener host here is the group's most
        // exposed shared identifier. /line forwards to the same place and
        // that redirect page is noindex.
        url: homePage + "/line",
        description: "ติดต่อแอดมินผ่าน LINE Official",
      },
    ],
  },
};
---

<script type="application/ld+json" set:html={JSON.stringify(contactPageSchema)} />
<MainLayout
  title="BUNNY555 ติดต่อเรา บริการฉับไว ทีมงานดูแล 24 ชม." description="ช่องทางการติดต่อ BUNNY555 ทีมงานผู้เชี่ยวชาญพร้อมให้บริการด้วยความคล่องตัวและรวดเร็ว แอด LINE เพื่อรับคำปรึกษาและแก้ไขปัญหาได้ตลอด 24 ชั่วโมง">
  <Announcement />

  <ContentBox>
    <div>
      <h1 class="mb-5 bg-gradient-to-r from-white via-pink-100 to-pink-300 bg-clip-text text-3xl font-black tracking-widest text-transparent uppercase drop-shadow-sm">ติดต่อทีมงาน BUNNY555</h1>

      <h2 class="mb-6 text-2xl leading-normal font-bold text-pink-100">แอด LINE ทีมงาน BUNNY555 ปรึกษาได้ทุกเรื่อง ตอบไวตลอด 24 ชั่วโมง</h2>

      <Picture
        src={imgLine}
        alt="ติดต่อทีมงาน BUNNY555 ผ่าน LINE Official"
        loading="lazy"
        fetchpriority="low"
        widths={[200, 400, 600]}
        sizes="(max-width: 768px) 100vw"
        class="mx-auto h-auto w-full max-w-[400px] object-contain shadow-xl"
        decoding="async"
        formats={["avif", "webp"]}
        fallbackFormat="webp"
        quality={60}
      />
      <p class="my-5 text-left text-base leading-relaxed text-pink-50/85">
        ช่องทางหลักของ <strong class="text-pink-200">BUNNY555</strong> คือ LINE Official ที่แสดงอยู่บนหน้าเว็บนี้ ทีมงานผู้เชี่ยวชาญประจำการตลอด 24 ชั่วโมง พร้อมดูแลตั้งแต่ขั้นตอนสมัครในคลิกเดียว การเข้าสู่แดชบอร์ดส่วนตัว ไปจนถึงการกดรับสิทธิ์ผ่านระบบออโต้
        และการเข้าเล่นเกมจากค่าย PG Soft, Pragmatic Play และ JOKER Gaming ระบบของเราวางอยู่บน Cloud Server ที่ลื่นไหลไม่มีสะดุดอยู่แล้ว แต่ถ้าคุณอยากได้คำแนะนำให้ใช้งานได้เต็มประสิทธิภาพยิ่งขึ้น ทักมาคุยกับทีมงานได้ทันทีโดยไม่ต้องรอคิว
      </p>

      <h2 class="mt-8 mb-6 text-2xl leading-normal font-bold text-pink-100">เตรียมข้อมูลแบบไหนให้เรื่องจบไว และอะไรที่ไม่ควรส่งให้ใครเด็ดขาด</h2>

      <p class="mb-6 text-left text-base leading-relaxed text-pink-50/85">
        เพื่อให้การตรวจสอบเป็นไปอย่างปราดเปรียวที่สุด ควรแจ้งชื่อผู้ใช้ เวลาที่ทำรายการ จำนวนเงิน เลขอ้างอิง ชื่อเกมหรือชื่อโปรโมชั่นที่ติดปัญหา พร้อมภาพหน้าจอประกอบ ถ้าเป็นเรื่องสิทธิพิเศษที่กดรับผ่านระบบอัตโนมัติ ให้ระบุด้วยว่ากดรับตอนไหน
        เพราะเงื่อนไขของแต่ละแคมเปญถูกคำนวณมาต่างกัน ที่สำคัญคือ รหัสผ่านและ OTP เป็นข้อมูลที่ไม่ควรส่งให้ผู้อื่นไม่ว่ากรณีใด ทีมงาน BUNNY555 ไม่มีความจำเป็นต้องขอสองอย่างนี้ และควรติดต่อผ่านช่องทางที่แสดงบนเว็บไซต์จริงเท่านั้น ไม่ใช่ลิงก์ที่เด้งมาจากข้อความส่วนตัว
      </p>

      <div class="flex flex-wrap justify-center gap-4">
        <a
          href="/register"
          aria-label="สมัครสมาชิก"
          class="flex items-center justify-center rounded-lg border border-pink-200/60 bg-gradient-to-b from-pink-300 to-pink-500 px-8 py-3 font-bold text-[#241019] shadow-[0_10px_30px_rgba(236,72,153,0.35)] transition-transform hover:scale-105 hover:shadow-[0_10px_30px_rgba(236,72,153,0.55)]">
          สมัครสมาชิก
        </a>

        <a
          href="/login"
          aria-label="เข้าเล่นเกม"
          class="flex items-center justify-center rounded-lg border border-rose-400/70 bg-gradient-to-b from-[#3a1122] to-[#0a0305] px-8 py-3 font-extrabold text-pink-200 shadow-[0_0_10px_rgba(190,24,93,0.5)] transition-transform hover:scale-105">
          เข้าเล่นเกม
        </a>

        <a
          href="/line"
          target="_blank"
          rel="noopener noreferrer"
          aria-label="ติดต่อทีมงานผ่าน Line Official"
          class="flex items-center justify-center rounded-lg border border-green-300 bg-gradient-to-b from-green-400 to-green-700 px-8 py-3 font-bold text-white transition-transform hover:scale-105">
          ติดต่อผ่าน Line Official
        </a>
      </div>
    </div>
  </ContentBox>
  <Navfoot />
</MainLayout>
