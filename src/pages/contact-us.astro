---
import MainLayout from "../layouts/MainLayout.astro";
import ContentBox from "../components/ContentBoxPremium.astro";
import Navfoot from "../components/Navfoot.astro";
import Announcement from "../components/Announcement3.astro";

import { Picture } from "astro:assets";
import imgLine from "../assets/contact-line.webp";

const homePage = "https://proded888-brand.com";
const logoUrl = homePage + "/logo.webp";

const contactPageSchema = {
  "@context": "https://schema.org",
  "@type": "ContactPage",
  name: "ติดต่อทีมงาน PRODED888 ผ่าน LINE Official",
  description: "ช่องทางติดต่อทีมงาน PRODED888 ผ่าน LINE Official สำหรับปัญหาสมัครสมาชิก เข้าสู่ระบบ ลืมรหัสผ่าน การฝากถอนออโต้ สิทธิ์คืนยอดเสีย และการเข้าเกมสล็อตหรือคาสิโนสด พร้อมข้อมูลที่ควรเตรียมก่อนแจ้งเรื่อง",
  url: homePage + "/contact-us",
  mainEntity: {
    "@type": "Organization",
    name: "PRODED888",
    alternateName: "PRODED888 เว็บตรงสล็อต",
    logo: logoUrl,
    url: homePage + "/",
    contactPoint: [
      {
        "@type": "ContactPoint",
        contactType: "customer service",
        availableLanguage: ["Thai", "English"],
        contactOption: "TollFree",
        // Point at this site's own /line hop, not the short link behind it.
        // This page is indexed, and structured data is read and stored by
        // Google directly — so a shortener host here is the group's most
        // exposed shared identifier. /line forwards to the same place and
        // that redirect page is noindex.
        url: homePage + "/line",
        description: "ติดต่อแอดมินผ่าน LINE Official",
      },
    ],
  },
};
---

<MainLayout
  title="ติดต่อเรา PRODED888 แจ้งปัญหาสมัครสมาชิก เข้าสู่ระบบ ฝากถอน และคืนยอดเสีย ผ่าน LINE Official"
  description="ช่องทางติดต่อทีมงาน PRODED888 ผ่าน LINE Official สำหรับปัญหาสมัครสมาชิก เข้าสู่ระบบ ลืมรหัสผ่าน การฝากถอนออโต้ สิทธิ์คืนยอดเสีย และการเข้าเกมสล็อตหรือคาสิโนสด พร้อมรายการข้อมูลที่ควรเตรียมให้ครบก่อนแจ้งเรื่อง และคำเตือนว่าไม่ควรส่งรหัสผ่านหรือ OTP ให้ใครเด็ดขาด">
  <script type="application/ld+json" set:html={JSON.stringify(contactPageSchema)} />

  <Announcement />

  <ContentBox title="ติดต่อทีมงาน PRODED888" as="h1">
    <h2 class="mb-6 text-2xl leading-normal font-bold text-[#d8b558]">ติดปัญหาสมัครสมาชิก เข้าสู่ระบบ ฝากถอน หรือรับสิทธิ์คืนยอดเสีย ทักทีมงาน PRODED888 ทางไหน</h2>

    <Picture
      src={imgLine}
      alt="ติดต่อทีมงาน PRODED888 ผ่าน LINE Official"
      loading="lazy"
      fetchpriority="low"
      widths={[200, 400, 600]}
      sizes="(max-width: 768px) 100vw"
      class="mx-auto h-auto w-full max-w-[400px] object-contain shadow-[0_10px_30px_rgba(226,192,95,0.18)]"
      decoding="async"
      formats={["avif", "webp"]}
      fallbackFormat="webp"
      quality={60}
    />
    <p class="my-5 text-left text-base leading-relaxed text-[#e6e3d8]">
      ช่องทางหลักของ <strong class="text-[#f0d68c]">PRODED888</strong> คือ LINE Official ที่แสดงอยู่บนหน้าเว็บ ใช้ได้ตั้งแต่ขั้นตอนสมัครสมาชิกด้วยชื่อ นามสกุล เบอร์โทรศัพท์ และรหัสผ่าน ไปจนถึงการเข้าสู่ระบบ การกู้คืนรหัสผ่านเมื่อเข้าบัญชีไม่ได้ การฝากถอนออโต้ผ่าน PromptPay, TrueMoney Wallet, K PLUS หรือ SCB Easy และการเข้าเกมสล็อต คาสิโนสด กีฬา หวย ไก่ชน และโป๊กเกอร์ รวมถึงเรื่องสิทธิ์คืนยอดเสียตามระดับสมาชิก
      เว็บระบุค่าเฉลี่ยฝากราว 30 วินาทีและถอนราว 1–3 นาที ซึ่งเป็นค่าเฉลี่ยไม่ใช่เวลารับประกัน ถ้ารายการยังไม่ขึ้นสถานะ ให้ทักมาพร้อมสลิปและเลขอ้างอิงแทนการกดซ้ำ เพราะรายการซ้ำใช้เวลาตรวจย้อนหลังนานกว่าการรอรอบเดิมเสียอีก
    </p>

    <h2 class="mt-8 mb-6 text-2xl leading-normal font-bold text-[#d8b558]">ควรเตรียมข้อมูลอะไรก่อนแจ้งเรื่อง และอะไรที่ห้ามส่งให้ใครเด็ดขาด</h2>

    <p class="mb-6 text-left text-base leading-relaxed text-[#e6e3d8]">
      ก่อนทักเข้ามา ควรเตรียมข้อมูลที่ใช้สมัคร เวลาที่ทำรายการ จำนวนเงิน เลขอ้างอิงจากช่องทางที่โอน ชื่อบัญชีรับเงินที่ตรงกับข้อมูลสมาชิก ชื่อเกมและค่ายที่ติดปัญหา เช่น PG Soft, JILI, Pragmatic Play, Evolution หรือ Microgaming พร้อมภาพหน้าจอที่เกี่ยวข้อง ถ้าเป็นเรื่องโบนัสหรือคืนยอดเสีย ให้ระบุด้วยว่ารับสิทธิ์ตอนไหนและระดับสมาชิกใด เพราะฐานคำนวณ เงื่อนไขการทำยอด เกมที่ร่วมรายการ และเพดานถอนของแต่ละแคมเปญไม่เท่ากัน ข้อมูลครบตั้งแต่ข้อความแรกช่วยได้มากกว่าการเล่าเป็นตอน ๆ
      ที่สำคัญคือไม่ควรส่งรหัสผ่านหรือ OTP ให้ผู้อื่นไม่ว่ากรณีใด ทีมงานไม่มีความจำเป็นต้องขอสองอย่างนี้ ต่อให้อีกฝั่งพิมพ์มาสุภาพแค่ไหน รหัสชุดนี้ก็ไม่ได้มีไว้แบ่งปัน และควรติดต่อผ่านช่องทางที่แสดงบนเว็บไซต์จริงเท่านั้น ไม่ใช่ลิงก์ที่เด้งมาจากข้อความส่วนตัว
    </p>

    <div class="flex flex-wrap justify-center gap-4">
      <a
        href="/register"
        aria-label="สมัครสมาชิก"
        class="flex items-center justify-center rounded-lg border border-[#e2c05f]/60 bg-gradient-to-b from-[#f7e3a4] via-[#e2c05f] to-[#c39a34] px-8 py-3 font-bold text-[#0a1024] shadow-[0_10px_30px_rgba(226,192,95,0.18)] transition-transform hover:scale-105 hover:shadow-[0_15px_40px_rgba(226,192,95,0.30)]">
        สมัครสมาชิก
      </a>

      <a
        href="/login"
        aria-label="เข้าเล่นเกม"
        class="flex items-center justify-center rounded-lg border border-[#e2c05f]/60 bg-[#0b1330] px-8 py-3 font-extrabold text-[#f0d68c] shadow-[0_4px_14px_rgba(226,192,95,0.18)] transition-transform hover:scale-105 hover:bg-[#16224f]">
        เข้าเล่นเกม
      </a>

      <a
        href="/line"
        target="_blank"
        rel="noopener noreferrer"
        aria-label="ติดต่อทีมงานผ่าน Line Official"
        class="flex items-center justify-center rounded-lg border border-green-300 bg-gradient-to-b from-green-400 to-green-700 px-8 py-3 font-bold text-white transition-transform hover:scale-105">
        ติดต่อผ่าน Line Official
      </a>
    </div>
  </ContentBox>
  <Navfoot />
</MainLayout>
