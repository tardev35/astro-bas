---
import MainLayout from "../layouts/MainLayout.astro";
import ContentBox from "../components/ContentBoxHuay.astro";
import Navfoot from "../components/Navfoot.astro";
import Announcement from "../components/Announcement2.astro";

import { Picture } from "astro:assets";
import imgLine from "../assets/contact-line.webp";

const homePage = "https://ufayes-brand.com";
const logoUrl = homePage + "/logo.webp";

const contactPageSchema = {
  "@context": "https://schema.org",
  "@type": "ContactPage",
  name: "ติดต่อทีมงาน UFAYES เว็บตรง UFABET ดูแลตลอด 24 ชั่วโมง",
  description: "ช่องทางติดต่อทีมงาน UFAYES ผ่าน Line Official และ Telegram สำหรับปัญหาสมัครสมาชิก ระบบฝากถอนออโต้ และการเข้าเกม ตลอด 24 ชั่วโมง",
  url: homePage + "/contact-us",
  mainEntity: {
    "@type": "Organization",
    name: "UFAYES",
    logo: logoUrl,
    url: homePage,
    contactPoint: [
      {
        "@type": "ContactPoint",
        contactType: "customer service",
        availableLanguage: ["Thai", "English"],
        contactOption: "TollFree",
        url: "https://tinyurl.com/linepigpg",
        description: "ติดต่อแอดมินผ่าน LINE Official",
      },
    ],
  },
};
---

<script type="application/ld+json" set:html={JSON.stringify(contactPageSchema)} />
<MainLayout
  title="ติดต่อเรา UFAYES ทีมงานดูแลผ่าน Line Official และ Telegram 24 ชั่วโมง"
  description="ช่องทางติดต่อทีมงาน UFAYES ผ่าน Line Official และ Telegram สำหรับปัญหาสมัครสมาชิก ฝากถอนออโต้ และการเข้าเกม พร้อมข้อมูลที่ควรเตรียมก่อนแจ้งเรื่อง ตลอด 24 ชั่วโมง">
  <Announcement />

  <ContentBox>
    <h1 class="mb-5 bg-gradient-to-r from-white via-zinc-200 to-zinc-400 bg-clip-text text-3xl font-black tracking-widest text-transparent uppercase drop-shadow-sm">ติดต่อทีมงาน UFAYES</h1>

    <h2 class="mb-6 text-2xl font-bold text-zinc-200">พบปัญหาสมัคร ฝากถอน หรือเข้าเกม ติดต่อทีมงาน UFAYES ได้อย่างไร</h2>

    <Picture
      src={imgLine}
      alt="ติดต่อทีมงาน UFAYES ผ่าน Line Official"
      loading="lazy"
      fetchpriority="low"
      widths={[200, 400, 600]}
      sizes="(max-width: 768px) 100vw"
      class="mx-auto h-auto w-full max-w-[400px] object-contain shadow-xl"
      decoding="async"
      formats={["avif", "webp"]}
      fallbackFormat="webp"
      quality={60}
    />
    <p class="my-5 mb-8 text-left text-base leading-relaxed text-red-50/85">
      <strong class="text-red-300">UFAYES</strong> ระบุว่ามีทีมงานให้บริการตลอด 24 ชั่วโมง พร้อมช่องทางติดต่อผ่าน Line Official และ Telegram สำหรับช่วยเหลือเรื่องสมัคร ฝากถอน และปัญหาการเข้าเกม เมื่อติดต่อควรเตรียมชื่อบัญชี เวลา จำนวนเงิน เลขอ้างอิง และภาพหน้าจอที่เกี่ยวข้อง
      ไม่ควรส่งรหัสผ่านหรือ OTP ให้ผู้อื่น และควรติดต่อผ่านช่องทางที่แสดงบนเว็บไซต์จริงเท่านั้น
    </p>
    <div class="flex flex-wrap justify-center gap-4">
      <a
        href="/register"
        aria-label="สมัครสมาชิก"
        class="flex items-center justify-center rounded-lg border border-red-300/60 bg-gradient-to-b from-red-400 to-red-600 px-8 py-3 font-bold text-[#140202] shadow-[0_10px_30px_rgba(220,38,38,0.35)] transition-transform hover:scale-105 hover:shadow-[0_10px_30px_rgba(220,38,38,0.55)]">
        สมัครสมาชิก
      </a>

      <a
        href="/login"
        aria-label="เข้าเล่นเกม"
        class="flex items-center justify-center rounded-lg border border-red-400/70 bg-gradient-to-b from-[#240404] to-[#0a0101] px-8 py-3 font-extrabold text-red-200 shadow-[0_0_10px_rgba(239,68,68,0.5)] transition-transform hover:scale-105">
        เข้าเล่นเกม
      </a>

      <a
        href="/line"
        target="_blank"
        rel="noopener noreferrer"
        aria-label="ติดต่อทีมงานผ่าน Line Official"
        class="flex items-center justify-center rounded-lg border border-green-300 bg-gradient-to-b from-green-400 to-green-700 px-8 py-3 font-bold text-white transition-transform hover:scale-105">
        ติดต่อผ่าน Line Official
      </a>
    </div>
  </ContentBox>
  <Navfoot />
</MainLayout>
