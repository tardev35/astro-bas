---
import MainLayout from "../layouts/MainLayout.astro";
import { BRAND_NAME } from "../lib/brandProfile";
import { pageGraph } from "../lib/schema";

// Companion to terms.astro — see the note there about why this file is
// brand-neutral and must stay that way.
//
// Every claim below is checked against what the built site actually does. This
// is a static Astro build with no analytics, no tracking pixels, no cookie
// banner and no form that posts anywhere: the login and register buttons are
// links to an external operator. A privacy policy that described collection
// this site does not perform would be worse than none, so it describes exactly
// that arrangement instead.
//
// If a future change adds analytics, a pixel, or a real form, THIS PAGE HAS TO
// CHANGE WITH IT. That is the one maintenance obligation the file carries.
const pageDescription = `นโยบายความเป็นส่วนตัวของเว็บไซต์ ${BRAND_NAME} อธิบายว่าเว็บไซต์นี้เก็บข้อมูลอะไรบ้าง ไม่เก็บอะไร การใช้คุกกี้ ลิงก์ไปยังผู้ให้บริการภายนอก และช่องทางติดต่อสอบถาม`;

const graph = pageGraph(Astro, {
  name: `นโยบายความเป็นส่วนตัว ${BRAND_NAME}`,
  description: pageDescription,
  breadcrumb: [
    { name: "หน้าแรก", path: "/" },
    { name: "นโยบายความเป็นส่วนตัว", path: "/privacy" },
  ],
});

const sections = [
  {
    h: "ข้อมูลที่เว็บไซต์นี้เก็บ",
    p: [
      `หน้าเว็บของ ${BRAND_NAME} ชุดนี้เป็นหน้าเว็บแบบคงที่ ไม่มีระบบสมาชิก ไม่มีแบบฟอร์มที่ส่งข้อมูลกลับมาที่เรา และไม่มีการขอชื่อ เบอร์โทรศัพท์ อีเมล หรือข้อมูลบัตรใด ๆ บนหน้านี้`,
      "เมื่อท่านเปิดหน้าเว็บ ผู้ให้บริการเครือข่ายและระบบโฮสต์จะมีบันทึกทางเทคนิคตามปกติของอินเทอร์เน็ต เช่น หมายเลขไอพี ชนิดของเบราว์เซอร์ และเวลาที่เข้าถึง ซึ่งเป็นกลไกพื้นฐานของการให้บริการหน้าเว็บ ไม่ได้ถูกนำมาเชื่อมโยงกับตัวบุคคลโดยเรา",
    ],
  },
  {
    h: "คุกกี้และการติดตาม",
    p: [
      "เว็บไซต์นี้ไม่ได้ติดตั้งสคริปต์วิเคราะห์พฤติกรรม ไม่มีพิกเซลโฆษณา และไม่ได้วางคุกกี้เพื่อติดตามผู้ใช้ข้ามเว็บไซต์",
      "หากในอนาคตมีการเพิ่มเครื่องมือวัดผล เราจะปรับปรุงหน้านี้ให้ตรงกับสิ่งที่ใช้งานจริง",
    ],
  },
  {
    h: "เมื่อกดไปยังเว็บไซต์ภายนอก",
    p: [
      "ปุ่มสมัครสมาชิก เข้าสู่ระบบ และช่องทางแชตจะพาไปยังเว็บไซต์หรือแอปพลิเคชันของผู้ให้บริการภายนอก เมื่อออกจากหน้านี้ไปแล้ว การเก็บและใช้ข้อมูลจะเป็นไปตามนโยบายของปลายทาง ไม่ใช่นโยบายฉบับนี้",
      "ก่อนกรอกข้อมูลใด ๆ ที่ปลายทาง ควรตรวจชื่อโดเมนและการเชื่อมต่อ HTTPS ให้ถูกต้อง และไม่ควรส่งรหัสผ่านหรือรหัส OTP ให้บุคคลอื่นไม่ว่ากรณีใด ทีมงานที่แท้จริงไม่มีความจำเป็นต้องขอสองสิ่งนี้",
    ],
  },
  {
    h: "ข้อมูลที่ท่านส่งมาเอง",
    p: [
      "หากท่านติดต่อเข้ามาทางช่องทางแชต ข้อความและสิ่งที่แนบมาจะถูกใช้เพื่อตอบคำถามของท่านเท่านั้น ไม่นำไปขายหรือเผยแพร่ต่อ",
      "ขอให้ส่งเฉพาะข้อมูลที่จำเป็นต่อการแก้ปัญหา และหลีกเลี่ยงการส่งภาพบัตรประชาชน รหัสผ่าน หรือรหัส OTP มาในแชต",
    ],
  },
  {
    h: "ผู้เยาว์",
    p: ["เนื้อหาบนเว็บไซต์นี้จัดทำสำหรับผู้มีอายุ 20 ปีบริบูรณ์ขึ้นไป และไม่มีเจตนาเก็บข้อมูลจากผู้ที่อายุต่ำกว่าเกณฑ์"],
  },
  {
    h: "การเปลี่ยนแปลงนโยบาย",
    p: ["นโยบายนี้อาจปรับปรุงเมื่อโครงสร้างหรือเครื่องมือของเว็บไซต์เปลี่ยนไป ฉบับที่แสดงอยู่บนหน้านี้คือฉบับที่ใช้อยู่ในปัจจุบัน"],
  },
];
---

<MainLayout title={`นโยบายความเป็นส่วนตัว ${BRAND_NAME}`} description={pageDescription}>
  <script type="application/ld+json" set:html={graph} />

  <section class="mx-auto w-full max-w-3xl px-4 py-14 font-sans">
    <h1 class="text-2xl font-black tracking-wide md:text-3xl">นโยบายความเป็นส่วนตัว {BRAND_NAME}</h1>

    <p class="mt-4 text-base leading-relaxed opacity-80">
      หน้านี้อธิบายว่าเว็บไซต์เก็บข้อมูลอะไร ไม่เก็บอะไร และเกิดอะไรขึ้นเมื่อท่านกดลิงก์ออกไปยังผู้ให้บริการภายนอก
    </p>

    {
      sections.map((section) => (
        <div class="mt-10">
          <h2 class="text-xl font-bold md:text-2xl">{section.h}</h2>
          {section.p.map((text) => (
            <p class="mt-4 text-base leading-relaxed opacity-80">{text}</p>
          ))}
        </div>
      ))
    }

    <p class="mt-12 text-base leading-relaxed opacity-80">
      อ่านเพิ่มเติมได้ที่ <a href="/terms/" class="font-bold underline underline-offset-4">เงื่อนไขและข้อตกลง</a> หรือ <a
        href="/contact-us/"
        class="font-bold underline underline-offset-4">ติดต่อทีมงาน</a
      >
    </p>
  </section>
</MainLayout>
