---
import MainLayout from "../layouts/MainLayout.astro";
import { BRAND_NAME } from "../lib/brandProfile";

// wrangler.toml declares `not_found_handling = "404-page"`, which makes
// Cloudflare serve dist/404.html for any unmatched path. That file did not
// exist, so every mistyped URL fell through to Cloudflare's own bare 404.
//
// This page is deliberately BRAND-NEUTRAL: no brand hex, no per-brand copy. It
// is one of the few files a rebrand has no reason to rewrite, and the moment it
// HARDCODES a name it silently rots into the PREVIOUS brand's 404 page. Where
// the brand has to be named, it comes from BRAND_NAME — the same construction
// terms.astro and privacy.astro use, so it can never go stale. Everything else
// a visitor sees here — fonts, palette, navbar, footer, background — arrives
// through MainLayout, so it rethemes itself for free on every launch. Do not
// put a colour class on anything in this file for the same reason.
//
// noindex, follow: a 404 must never be indexed, but its links should still be
// crawled so the crawler finds its way back to the real pages.
---

<MainLayout
  title={`ไม่พบหน้าที่ต้องการ (404) ${BRAND_NAME}`}
  description={`ไม่พบหน้าที่คุณกำลังมองหาบนเว็บไซต์ ${BRAND_NAME} ลิงก์อาจหมดอายุ ถูกย้าย หรือพิมพ์ที่อยู่คลาดเคลื่อน กลับไปหน้าแรกเพื่อเข้าใช้งานเมนูทั้งหมดได้ตามปกติ`}
  robots="noindex, follow">
  <section class="mx-auto flex w-full max-w-3xl flex-col items-center px-4 py-20 text-center font-sans">
    <p class="text-6xl font-black tracking-widest opacity-40 md:text-8xl" aria-hidden="true">404</p>

    <h1 class="mt-4 text-2xl font-black tracking-wide md:text-3xl">ไม่พบหน้าที่ต้องการ</h1>

    <p class="mt-4 max-w-xl text-base leading-relaxed opacity-80">
      ลิงก์ที่เปิดมาอาจหมดอายุ ถูกย้ายไปที่อื่น หรือพิมพ์ที่อยู่คลาดเคลื่อนไปเพียงตัวอักษรเดียว
      คุณยังอยู่บนเว็บไซต์ {BRAND_NAME} ตามปกติ และเมนูทั้งหมดยังใช้งานได้จากด้านบนและด้านล่างของหน้านี้
    </p>

    <a
      href="/"
      class="mt-8 inline-flex items-center justify-center rounded-full border px-8 py-3 font-bold transition-transform hover:scale-105">
      กลับไปหน้าแรก
    </a>
  </section>
</MainLayout>
