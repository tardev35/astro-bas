---
import MainLayout from "../layouts/MainLayout.astro";
import ContentBox from "../components/ContentBox.astro";
import Navfoot from "../components/Navfoot.astro";
import Announcement from "../components/AnnouncementPremium.astro";
import { pageGraph } from "../lib/schema";

// BUTTON PAGE, not an article, and no longer an auto-forwarding interstitial:
// one <h1> from the ContentBox title and one button to the affiliate link.
// Never add an <h2>, never write body copy here.
//
// 153 characters — this page is indexed now, so verify-build holds the
// description to the 150–160 window like any other page. Count characters with
// PowerShell `"...".Length`; a byte count reads ~3x too long on Thai.
// The docx gives no Title/Meta for /login, so both are written here; they
// describe the button page this route is now, not the old auto-forward.
const pageDescription =
  "หน้าเข้าสู่ระบบ LUCKYGAME689 เว็บสล็อตเจ้าใหญ่ กดปุ่มเดียวเชื่อมต่อเข้าเว็บหลักผ่าน Secure Transition Popup โหลดไว ลื่นไหล ปลอดภัยขั้นสุด 100% ทุกอุปกรณ์";

const graph = pageGraph(Astro, {
  name: "เข้าสู่ระบบ LUCKYGAME689 เว็บหลัก ปลอดภัยขั้นสุด ผ่าน Secure Popup",
  description: pageDescription,
  breadcrumb: [
    { name: "หน้าแรก", path: "/" },
    { name: "เข้าสู่ระบบ", path: "/login" },
  ],
});

// This brand's affiliate link — carried over from the interstitial this page
// replaced. Do NOT change it during a rebrand; restyle the button only.
const targetUrl = "https://tinyurl.com/pigbas";
---

<MainLayout title="เข้าสู่ระบบ LUCKYGAME689 เว็บหลัก ปลอดภัยขั้นสุด ผ่าน Secure Popup" description={pageDescription}>
  <script type="application/ld+json" set:html={graph} />

  <Announcement />

  <ContentBox title="เข้าสู่ระบบ LUCKYGAME689" as="h1">
    <div class="flex justify-center py-8">
      <a
        href={targetUrl}
        rel="nofollow sponsored"
        aria-label="เข้าระบบเกม"
        class="group relative mx-auto flex w-full max-w-[320px] items-center justify-center gap-3 overflow-hidden rounded-xl border border-[#ff3d8a]/50 bg-[#2b0204] px-6 py-4 text-xl font-bold tracking-wide text-[#ff3d8a] shadow-[0_10px_30px_rgba(224,27,93,0.16)] transition-all duration-300 hover:scale-105 hover:border-[#ff3d8a] hover:bg-[#3d0410] hover:shadow-[0_15px_40px_rgba(224,27,93,0.28)]">
        เข้าระบบเกม
      </a>
    </div>
  </ContentBox>

  <Navfoot />
</MainLayout>
