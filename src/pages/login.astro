---
import MainLayout from "../layouts/MainLayout.astro";
import ContentBox from "../components/ContentBox.astro";
import Navfoot from "../components/Navfoot.astro";
import Announcement from "../components/Announcement3.astro";
import CtaRedirect from "../components/CtaRedirect.astro";
import { pageGraph } from "../lib/schema";

// BUTTON PAGE, not an article, and no longer an auto-forwarding interstitial:
// one <h1> from the ContentBox title and one button to the affiliate link.
// Never add an <h2>, never write body copy here.
//
// 155 characters — this page is indexed now, so verify-build holds the
// description to the 150–160 window like any other page. Count CHARACTERS
// (`node -e "console.log([...'…'].length)"`); a byte count reads ~3x too long
// on Thai. The docx gives no Title/Meta for /login, so both are written here
// from the brief's own wording for the ทางเข้า page; they describe the button
// page this route is now, not the old auto-forward.
const pageDescription =
  "กดปุ่มเดียวเข้าสู่ระบบ ROMAN555 ทางเข้าหลักเว็บตรง ประมวลผลผ่าน Secure Transition Popup ป้องกันการรีเฟรชซ้ำซ้อน ปลอดภัย มั่นคง และเป็นส่วนตัว 100% ทุกครั้ง";

const graph = pageGraph(Astro, {
  name: "เข้าสู่ระบบ ROMAN555 ทางเข้าหลักเว็บตรง กดปุ่มเดียวถึงเว็บหลัก",
  description: pageDescription,
  breadcrumb: [
    { name: "หน้าแรก", path: "/" },
    { name: "เข้าสู่ระบบ", path: "/login" },
  ],
});

// This brand's affiliate link — carried over from the interstitial this page
// replaced. Do NOT change it during a rebrand; restyle the button only.
const targetUrl = "https://tinyurl.com/pigbas";
---

<MainLayout title="เข้าสู่ระบบ ROMAN555 ทางเข้าหลักเว็บตรง กดปุ่มเดียวถึงเว็บหลัก" description={pageDescription}>
  <script type="application/ld+json" set:html={graph} />

  <Announcement />

  <ContentBox title="เข้าสู่ระบบ ROMAN555" as="h1">
    <div class="flex justify-center py-8">
      <a
        href={targetUrl}
        rel="nofollow sponsored"
        data-cta-redirect
        aria-label="เข้าสู่ระบบ ROMAN555 ที่เว็บหลัก"
        class="group relative mx-auto flex w-full max-w-[320px] items-center justify-center gap-3 overflow-hidden rounded-xl border border-[#f6cf6a]/50 bg-[#120a02] px-6 py-4 text-xl font-bold tracking-wide text-[#f6cf6a] shadow-[0_10px_30px_rgba(168,105,10,0.16)] transition-all duration-300 hover:scale-105 hover:border-[#f6cf6a] hover:bg-[#241505] hover:shadow-[0_15px_40px_rgba(168,105,10,0.28)]">
        เข้าสู่ระบบ
      </a>
    </div>
  </ContentBox>

  <Navfoot />

  <CtaRedirect label="เข้าสู่ระบบ" />
</MainLayout>
