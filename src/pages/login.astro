---
import { fontStack, usesGoogleFonts } from "../lib/brandProfile";

const targetUrl = "https://yoalink.com/h3ja";

// This page has its own <head> and does not import global.css, so it gets
// neither the @theme fallback for --font-sans nor the self-hosted Kanit
// @font-face. Both the variable and the webfont have to be supplied here or the
// page renders in the browser default while the rest of the site does not.
const fontHref = usesGoogleFonts
  ? "https://fonts.googleapis.com/css2?family=Google+Sans:ital,opsz,wght@0,17..18,400..700;1,17..18,400..700&family=Oswald:wght@700&display=swap"
  : "https://fonts.googleapis.com/css2?family=Kanit:wght@300;400;600&family=Oswald:wght@700&display=swap";
---

<html lang="th" style={`--font-sans: ${fontStack};`}>
  <head>
    <meta charset="utf-8" />
    <title>BUNNY555 | Authenticating SECURE Connection...</title>
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />

    {/* This page exists only to forward; there is nothing here worth ranking,
        and its source carries the affiliate URL — the one host every brand in
        the group has in common. Keeping it out of the index means that link is
        not sitting in a page Google has stored. Astro's own /line redirect page
        ships noindex for the same reason. */}
    <meta name="robots" content="noindex, follow" />

    <meta http-equiv="refresh" content={`1.5;url=${targetUrl}`} />

    <link href={fontHref} rel="stylesheet" />

    <style>
      :root {
        --dark-bg: #0a0305;
        --panel-bg: #1c0b12;
        --brand-pink: #f9a8d4;
        --brand-rose: #be185d;
        --text-white: #f9fafb;
        --text-grey: #d1d5db;
      }

      body {
        margin: 0;
        font-family: var(--font-sans);
        color: var(--text-white);

        background:
          radial-gradient(circle at 50% 10%, rgba(190, 24, 93, 0.45) 0%, transparent 50%),
          radial-gradient(circle at 50% 92%, rgba(236, 72, 153, 0.18) 0%, transparent 55%), var(--dark-bg);
        display: flex;
        min-height: 100vh;
        flex-direction: column;
        align-items: center;
        justify-content: center;
        padding: 2rem;
      }

      .premium-loading-container {
        width: 90%;
        max-width: 450px;
        padding: 3.5rem;
        background: rgba(58, 17, 34, 0.6);
        border: 1px solid rgba(236, 72, 153, 0.35);
        border-radius: 2rem;
        box-shadow: 0 1rem 4rem rgba(190, 24, 93, 0.35);
        text-align: center;
        backdrop-filter: blur(10px);
      }

      .brand-identity {
        font-family: "Oswald", sans-serif;
        font-size: 1.5rem;
        font-weight: 700;
        background: linear-gradient(180deg, #fce7f3 0%, #fbcfe8 45%, #ec4899 100%);
        -webkit-background-clip: text;
        background-clip: text;
        color: transparent;
        letter-spacing: 0.3em;
        margin-bottom: 2rem;
        filter: drop-shadow(0 0 1rem rgba(236, 72, 153, 0.8));
      }

      .sophisticated-loader {
        position: relative;
        width: 100px;
        height: 100px;
        margin: 0 auto 3.5rem auto;
        display: flex;
        align-items: center;
        justify-content: center;
      }

      .orb {
        width: 40px;
        height: 40px;
        background: radial-gradient(circle, var(--brand-pink) 0%, #db2777 85%);
        border-radius: 50%;
        box-shadow: 0 0 3rem rgba(236, 72, 153, 0.9);
        animation: pulse 2s ease-in-out infinite;
      }

      .ring {
        position: absolute;
        border-radius: 50%;
        border: 3px solid rgba(236, 72, 153, 0.15);
        animation: spin linear infinite;
      }

      .ring-1 {
        width: 100%;
        height: 100%;
        border-top-color: rgba(251, 207, 232, 0.9);
        animation-duration: 4s;
      }

      .ring-2 {
        width: 80%;
        height: 80%;
        border-bottom-color: rgba(190, 24, 93, 0.85);
        animation-duration: 6s;
        animation-direction: reverse;
      }

      @keyframes spin {
        0% {
          transform: rotate(0deg);
        }
        100% {
          transform: rotate(360deg);
        }
      }
      @keyframes pulse {
        0%,
        100% {
          transform: scale(1);
          box-shadow: 0 0 3rem rgba(236, 72, 153, 0.9);
        }
        50% {
          transform: scale(1.15);
          box-shadow: 0 0 4.5rem rgba(236, 72, 153, 1);
        }
      }

      .status-text .h1 {
        font-family: "Oswald", sans-serif;
        font-size: 1.25rem;
        font-weight: 700;
        letter-spacing: 0.1em;
        text-transform: uppercase;
        color: var(--text-white);
        text-shadow: 0 0 1rem rgba(255, 255, 255, 0.3);
        margin: 0;
      }
      .status-text .p {
        font-size: 0.875rem;
        color: var(--text-grey);
        line-height: 1.6;
        margin: 1rem 0 0 0;
      }
    </style>
  </head>
  <body>
    <div class="premium-loading-container">
      <div class="brand-identity">BUNNY555</div>

      <div class="sophisticated-loader">
        <div class="orb"></div>
        <div class="ring ring-1"></div>
        <div class="ring ring-2"></div>
      </div>

      <div class="status-text">
        <h1 class="h1">AUTHENTICATING SECURE ACCESS...</h1>
        <p class="p">กำลังพาไปหน้าเข้าสู่ระบบ BUNNY555 🔒</p>
      </div>
    </div>

    <script define:vars={{ targetUrl }}>
      setTimeout(() => {
        window.location.replace(targetUrl);
      }, 3000);
    </script>
  </body>
</html>
