---
import MainLayout from "../layouts/MainLayout.astro";
import ContentBox from "../components/ContentBox.astro";
import Navfoot from "../components/Navfoot.astro";
import Announcement from "../components/Announcement5.astro";

import { Picture } from "astro:assets";
import image1 from "../assets/gamedemo7.webp";
import image2 from "../assets/gamedemo8.webp";
import image3 from "../assets/gamedemo9.webp";
import image4 from "../assets/gamedemo10.webp";
import image5 from "../assets/gamedemo11.webp";
import image6 from "../assets/gamedemo12.webp";
import image7 from "../assets/gamedemo13.webp";
import image8 from "../assets/gamedemo14.webp";
import image9 from "../assets/gamedemo15.webp";
import image10 from "../assets/gamedemo16.webp";
import image11 from "../assets/gamedemo17.webp";
import image12 from "../assets/gamedemo18.webp";

const demoGames = [
  { id: 1, src: image1, alt: "ทดลองเล่นเกม AskmeSlot ที่ SUDYOD888", link: "/register" },
  { id: 2, src: image2, alt: "ทดลองเล่นเกมยอดนิยมที่ SUDYOD888", link: "/register" },
  { id: 3, src: image3, alt: "ทดลองเล่นเกม SlotXO ที่ SUDYOD888", link: "/register" },
  { id: 4, src: image4, alt: "ทดลองเล่นเกม Skywind Group ที่ SUDYOD888", link: "/register" },
  { id: 5, src: image5, alt: "ทดลองเล่นเกม PG Soft ที่ SUDYOD888", link: "/register" },
  { id: 6, src: image6, alt: "ทดลองเล่นเกม SBOBET ที่ SUDYOD888", link: "/register" },
  { id: 7, src: image7, alt: "ทดลองเล่นเกม Sexy Slot ที่ SUDYOD888", link: "/register" },
  { id: 8, src: image8, alt: "ทดลองเล่นเกม JILI ที่ SUDYOD888", link: "/register" },
  { id: 9, src: image9, alt: "ทดลองเล่นเกม Ask Me Bet ที่ SUDYOD888", link: "/register" },
  { id: 10, src: image10, alt: "ทดลองเล่นเกมใหม่ที่ SUDYOD888", link: "/register" },
  { id: 11, src: image11, alt: "ทดลองเล่นเกม JOKER ที่ SUDYOD888", link: "/register" },
  { id: 12, src: image12, alt: "ทดลองเล่นเกม AFB Gaming ที่ SUDYOD888", link: "/register" },
];
const homePage = "https://sudyod888-brand.com";
const pageUrl = homePage + "/" + encodeURIComponent("ทดลองเล่น");
const gameList = [
  { name: "AskmeSlot", image: homePage + image1.src },
  { name: "Popular Game", image: homePage + image2.src },
  { name: "SlotXO", image: homePage + image3.src },
  { name: "Skywind Group", image: homePage + image4.src },
  { name: "PG Soft", image: homePage + image5.src },
  { name: "SBOBET", image: homePage + image6.src },
  { name: "Sexy Slot", image: homePage + image7.src },
  { name: "JILI", image: homePage + image8.src },
  { name: "Ask Me Bet", image: homePage + image9.src },
  { name: "New Game", image: homePage + image10.src },
  { name: "JOKER", image: homePage + image11.src },
  { name: "AFB Gaming", image: homePage + image12.src },
];

const demoListSchema = {
  "@context": "https://schema.org",
  "@type": "ItemList",
  name: "ทดลองเล่นเกมของ SUDYOD888",
  alternateName: "SUDYOD888 โหมดทดลองสล็อตขั้นต่ำ 1 บาทบนมือถือ",
  url: pageUrl,
  itemListElement: gameList.map((game, index) => ({
    "@type": "ListItem",
    position: index + 1,
    item: {
      "@type": "Game",
      name: game.name,
      image: game.image,
      url: pageUrl,
    },
  })),
};
---

<MainLayout
  title="ทดลองเล่น SUDYOD888 โหมดทดลองสล็อต ดูตารางจ่ายและฟรีสปินก่อนเล่นจริง"
  description="ทดลองเล่นสล็อตของ SUDYOD888 ในโหมดทดลองที่ไม่ใช้เงินจริง ใช้ดูตารางจ่าย ฟรีสปิน และสัญลักษณ์พิเศษก่อนเริ่มเล่นจริง พร้อมสล็อตที่เริ่มเดิมพันได้ตั้งแต่ 1 บาท จากเกมมากกว่า 200 รายการทั้งสล็อต เกมยิงปลา และคาสิโนสด และจุดที่ควรเช็กก่อนเปลี่ยนไปเล่นจริง">
  <script type="application/ld+json" set:html={JSON.stringify(demoListSchema)} />

  <Announcement />

  <ContentBox title="ทดลองเล่นเกมของ SUDYOD888 โหมดทดลองสล็อต ลองก่อนได้ไม่ต้องใช้เงินจริง">
    <div>
      <h2 class="mb-6 bg-gradient-to-r from-[#ffe9a8] via-[#f5c53d] to-[#c8921e] bg-clip-text text-2xl leading-normal font-bold text-transparent">โหมดทดลองของ SUDYOD888 มีไว้ทำอะไร และควรดูอะไรก่อนเลือกเกม</h2>

      <p class="mb-8 text-left text-base leading-relaxed text-[#ece2cc]">
        SUDYOD888 รวมเกมสล็อต เกมยิงปลา และคาสิโนสดมากกว่า 200 รายการไว้ในบัญชีเดียว โดยหมวดสล็อตหลายเกมเริ่มเดิมพันได้ตั้งแต่ 1 บาท
        โหมดทดลองจึงมีไว้ให้กดเปิดดูหน้าเกมก่อนว่าตารางจ่ายให้เท่าไร ฟรีสปินมาในจังหวะไหน สัญลักษณ์พิเศษทำงานแบบใด และปุ่มปรับเดิมพันอยู่ตรงไหน โดยยังไม่ต้องใส่เงินจริงและไม่มีการได้เสียเกิดขึ้น
        เหมาะกับสมาชิกใหม่ที่อยากไล่เทียบเกมหลายหมวดให้จบในรอบเดียวก่อนตัดสินใจว่าจะเอาเกมไหนไปเล่นจริง ถือเป็นการอ่านคู่มือก่อนขับ ซึ่งน่าเบื่อกว่าการลองขับเลยอยู่แล้ว แต่ค่าซ่อมมันถูกกว่ากันเยอะ
      </p>

      <div class="mb-5 grid grid-cols-2 gap-5 sm:grid-cols-2 md:grid-cols-4">
        {
          demoGames.map((game) => (
            <div class="group/game relative mx-auto w-full max-w-[400px] overflow-hidden rounded-xl">
              <Picture
                src={game.src}
                alt={game.alt}
                loading="lazy"
                fetchpriority="low"
                widths={[200, 400, 600]}
                sizes="(max-width: 768px) 100vw, 25vw"
                class="block h-auto w-full object-cover shadow-[0_10px_30px_rgba(245,197,61,0.18)] transition-transform duration-300 group-hover/game:scale-105"
                decoding="async"
                formats={["avif", "webp"]}
                fallbackFormat="webp"
                quality={60}
              />
              <a
                href={game.link}
                target="_blank"
                rel="noopener noreferrer"
                aria-label={`ทดลองเล่น ${game.alt}`}
                class="absolute inset-0 flex items-center justify-center bg-[#080503]/75 opacity-0 transition-opacity duration-300 group-hover/game:opacity-100 focus-visible:opacity-100">
                <span class="rounded-full border border-[#f5c53d]/60 bg-gradient-to-r from-[#ffe9a8] via-[#f5c53d] to-[#c8921e] px-6 py-2 font-bold text-[#240709] shadow-[0_10px_30px_rgba(245,197,61,0.30)] transition-transform hover:scale-110">เล่นเลย</span>
              </a>
            </div>
          ))
        }
      </div>

      <h2 class="mt-8 mb-6 bg-gradient-to-r from-[#ffe9a8] via-[#f5c53d] to-[#c8921e] bg-clip-text text-2xl leading-normal font-bold text-transparent">โหมดทดลองบอกอะไรได้ และบอกอะไรไม่ได้</h2>

      <p class="mb-4 text-left text-base leading-relaxed text-[#ece2cc]">
        โหมดทดลองบอกได้ว่าเกมเล่นอย่างไร ตารางจ่ายให้เท่าไร ฟรีสปินกับสัญลักษณ์พิเศษอยู่ตรงไหน และหนึ่งรอบเกมกินเวลาแค่ไหน แต่เครดิตในโหมดนี้เป็นยอดสมมติ ถอนไม่ได้ และผลที่ออกมาก็ไม่ได้บอกว่าเกมจริงจะจ่ายเหมือนกัน
        ต่อให้กดในโหมดทดลองแล้วฟรีสปินมาถี่ ก็ไม่ใช่หลักฐานว่าเกมนั้นกำลังอารมณ์ดีรอเราอยู่ โหมดนี้มีไว้ศึกษาระบบ ไม่ใช่ไว้ดูดวงผ่านหน้าจอ
      </p>

      <p class="mb-4 text-left text-base leading-relaxed text-[#ece2cc]">
        สิ่งที่ควรทำจริง ๆ คือกำหนดงบและเวลาเล่นของตัวเองไว้ก่อน เลือกเดิมพันขั้นต่ำที่รับได้ แล้วจดไว้ว่าเกมไหนที่จังหวะเข้ากับเราจริง
        อีกเรื่องที่ควรเผื่อใจคือทั้งราคาเริ่มต้น 1 บาทและโหมดทดลองไม่ได้มีให้ครบทุกเกม จึงควรเปิดหน้ารายละเอียดของเกมดูก่อนเลือก และยอดที่หมุนในโหมดทดลองก็ไม่นับเป็นยอดเดิมพันสำหรับสิทธิ์โปรโมชั่นหรือคืนยอดเสียใด ๆ เพราะคืนยอดเสียคิดจากผลได้เสียของเงินจริงในรอบสัปดาห์เท่านั้น
        ถ้าเกมที่อยากลองไม่มีปุ่มทดลอง ให้ถือว่าวันนี้โชคไม่ดี ไม่ใช่สัญญาณลับที่ระบบส่งมาให้เราคนเดียว
      </p>

      <h2 class="mt-8 mb-6 bg-gradient-to-r from-[#ffe9a8] via-[#f5c53d] to-[#c8921e] bg-clip-text text-2xl leading-normal font-bold text-transparent">จากโหมดทดลองไปเล่นจริงบน SUDYOD888 ควรเช็กอะไรก่อน</h2>

      <p class="mb-2 text-left text-base leading-relaxed text-[#ece2cc]">
        ถ้าจะขยับจากโหมดทดลองไปเล่นจริง มีสามเรื่องที่ควรดูก่อนคือเงิน โปร และลิงก์ ด้านการเงิน ข้อมูลต้นแบบระบุว่า SUDYOD888 ใช้ระบบฝากถอนออโต้ผ่าน Mobile Banking และ True Wallet โดยถอนขั้นต่ำ 100 บาท และไม่เกิน 49,000 บาทต่อรายการ
        จึงควรตรวจว่าบัญชีที่ผูกไว้ตรงกับชื่อผู้สมัคร และเก็บสลิปกับเลขรายการไว้ทุกครั้งก่อนคิดจะกดทำรายการซ้ำ เพราะคำว่าออโต้ไม่ได้แปลว่าทุกครั้งจะเร็วเท่ากันเป๊ะ ระยะเวลาจริงยังขึ้นกับธนาคารและสถานะระบบ
        ด้านโปรโมชั่น โบนัสสูงสุด 400% เป็นเพดานของแต่ละรายการ ไม่ใช่อัตราเดียวที่ใช้ได้ทุกโปร ควรอ่านยอดฝากที่ร่วมรายการ จำนวนเทิร์น และเกมที่ใช้โบนัสได้ก่อนกดรับ ส่วนคืนยอดเสียเปิดให้ตรวจและกดรับทุกวันอาทิตย์หลังเวลา 12.00 น. ภายในช่วงเวลาที่จำกัด
        และควรเข้าเกมผ่านหน้าทางเข้าจริงของ SUDYOD888 ที่เป็น HTTPS เท่านั้น ไม่ใช่ลิงก์ที่ส่งต่อกันมาในแชตพร้อมคำโฆษณาว่าอันนี้แตกดี เพราะลิงก์แบบนั้นมักแตกจริง แค่ไม่ใช่ในทางที่เราหวัง
      </p>
    </div>
  </ContentBox>

  <Navfoot />
</MainLayout>
