---
import MainLayout from "../layouts/MainLayout.astro";
import ContentBox from "../components/ContentBox.astro";
import Navfoot from "../components/Navfoot.astro";
import Announcement from "../components/AnnouncementHuay.astro";

const homePage = Astro.url.origin;

const demoMarkets = [
  { id: 1, icon: "🇹🇭", name: "หวยรัฐบาลไทย", close: "15:00 น.", reward: "บาทละ 1000", link: "/register" },
  { id: 2, icon: "🇱🇦", name: "หวยลาวพัฒนา", close: "20:00 น.", reward: "บาทละ 95", link: "/register" },
  { id: 3, icon: "🇻🇳", name: "หวยฮานอย", close: "18:00 น.", reward: "บาทละ 95", link: "/register" },
  { id: 4, icon: "⭐", name: "หวยฮานอยพิเศษ", close: "17:30 น.", reward: "บาทละ 95", link: "/register" },
  { id: 5, icon: "⏱️", name: "หวยยี่กี", close: "ทุก 15 นาที", reward: "บาทละ 95", link: "/register" },
  { id: 6, icon: "📈", name: "หวยหุ้นไทย", close: "16:40 น.", reward: "บาทละ 95", link: "/register" },
  { id: 7, icon: "🇯🇵", name: "หวยหุ้นนิเคอิ", close: "13:00 น.", reward: "บาทละ 95", link: "/register" },
  { id: 8, icon: "🇺🇸", name: "หวยหุ้นดาวโจนส์", close: "03:30 น.", reward: "บาทละ 95", link: "/register" },
  { id: 9, icon: "🇲🇾", name: "หวยมาเลย์", close: "18:00 น.", reward: "บาทละ 95", link: "/register" },
  { id: 10, icon: "🇨🇳", name: "หวยจีน", close: "14:00 น.", reward: "บาทละ 95", link: "/register" },
  { id: 11, icon: "🇬🇧", name: "หวยอังกฤษ", close: "21:30 น.", reward: "บาทละ 95", link: "/register" },
  { id: 12, icon: "🇩🇪", name: "หวยเยอรมัน", close: "22:30 น.", reward: "บาทละ 95", link: "/register" },
];

const marketListSchema = {
  "@context": "https://schema.org",
  "@type": "ItemList",
  name: "ตลาดหวยที่เปิดให้ทดลองเล่นกับ MAHORANLOTTO",
  description: "รายชื่อตลาดหวยออนไลน์ที่ MAHORANLOTTO เปิดให้สมาชิกทดลองดูรูปแบบการแทงและอัตราจ่ายก่อนส่งโพยจริง",
  numberOfItems: demoMarkets.length,
  itemListElement: demoMarkets.map((market, index) => ({
    "@type": "ListItem",
    position: index + 1,
    name: market.name,
    url: homePage + market.link,
  })),
};
---

<script type="application/ld+json" set:html={JSON.stringify(marketListSchema)} />
<MainLayout
  title="ทดลองเล่นหวย MAHORANLOTTO ครบทุกตลาด หวยรัฐบาล ลาว ฮานอย หวยหุ้น"
  description="ทดลองเล่นหวยออนไลน์กับ MAHORANLOTTO ดูรูปแบบการแทง อัตราจ่าย และรอบปิดรับของหวยรัฐบาล หวยลาว หวยฮานอย หวยยี่กี และหวยหุ้น ก่อนส่งโพยจริง พร้อมระบบฝากถอนออโต้">
  <Announcement />

  <ContentBox title="ทดลองเล่นหวย MAHORANLOTTO รวมตลาดหวยยอดนิยม">
    <div>
      <h2 class="mb-6 bg-gradient-to-r from-white via-amber-100 to-amber-400 bg-clip-text text-2xl font-bold text-transparent">ตลาดหวยยอดนิยมที่ MAHORANLOTTO เปิดให้ทดลองเล่น</h2>

      <p class="mb-8 text-left text-base leading-relaxed text-amber-50/85">
        เว็บไซต์รวบรวมหวยรัฐบาล หวยลาว หวยฮานอย หวยยี่กี หวยหุ้น และหวยต่างประเทศไว้ในหน้าเดียว พร้อมแยกหมวดตามตลาดเพื่อให้ค้นหารอบที่เปิดรับได้ง่ายขึ้น ก่อนส่งโพยควรตรวจสอบอัตราจ่าย เลขอั้น และเวลาปิดรับของแต่ละตลาด หากหน้าจอโหลดไม่สมบูรณ์ ไม่ควรกดยืนยันซ้ำทันที
        แต่ควรตรวจสอบประวัติโพยก่อน เพื่อป้องกันการส่งรายการซ้ำโดยไม่ตั้งใจ
      </p>

      <div class="mb-5 grid grid-cols-2 gap-4 md:grid-cols-3 lg:grid-cols-4">
        {
          demoMarkets.map((market) => (
            <a
              href={market.link}
              aria-label={`ทดลองซื้อ${market.name}`}
              class="group relative flex flex-col items-center gap-2 overflow-hidden rounded-2xl border border-amber-500/25 bg-[#1a0409]/70 p-5 text-center shadow-lg transition-all duration-300 hover:-translate-y-1.5 hover:border-amber-400/60 hover:bg-[#5f0914]/70 hover:shadow-[0_10px_30px_rgba(251,191,36,0.25)]">
              <span class="text-4xl drop-shadow-[0_0_15px_rgba(251,191,36,0.4)] transition-transform duration-300 group-hover:scale-110">{market.icon}</span>
              <span class="text-sm font-bold text-white transition-colors group-hover:text-amber-300">{market.name}</span>
              <span class="text-[11px] text-amber-100/60">
                ปิดรับ: <span class="font-mono text-amber-300">{market.close}</span>
              </span>
              <span class="mt-1 rounded-full bg-gradient-to-r from-amber-400 to-amber-500 px-4 py-1 text-[11px] font-bold text-[#5f0914] shadow-md transition-transform duration-300 group-hover:scale-105">{market.reward}</span>
            </a>
          ))
        }
      </div>
    </div>
  </ContentBox>

  <Navfoot />
</MainLayout>
