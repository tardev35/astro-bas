---
import MainLayout from "../layouts/MainLayout.astro";
import ContentBox from "../components/ContentBox.astro";
import Navfoot from "../components/Navfoot.astro";
import Announcement from "../components/AnnouncementPremium.astro";

import { Picture } from "astro:assets";
import { itemList, pageGraph, schemaCtx } from "../lib/schema";
import image1 from "../assets/gamedemo7.webp";
import image2 from "../assets/gamedemo8.webp";
import image3 from "../assets/gamedemo9.webp";
import image4 from "../assets/gamedemo10.webp";
import image5 from "../assets/gamedemo11.webp";
import image6 from "../assets/gamedemo12.webp";
import image7 from "../assets/gamedemo13.webp";
import image8 from "../assets/gamedemo14.webp";
import image9 from "../assets/gamedemo15.webp";
import image10 from "../assets/gamedemo16.webp";
import image11 from "../assets/gamedemo17.webp";
import image12 from "../assets/gamedemo18.webp";

// One list, two consumers: the gallery below and the ItemList in the JSON-LD.
// They used to be two hand-kept arrays that had to stay in the same order, and
// the name shown to a reader could drift from the name handed to a crawler.
const demoGames = [
  { name: "AskmeSlot", src: image1, alt: "แบนเนอร์เกมสล็อตค่าย AskmeSlot ในโหมดทดลองเล่นของ TUNJAI123" },
  { name: "Popular Game", src: image2, alt: "แบนเนอร์รวมเกมยอดนิยม Popular Game พร้อมกองชิปและเหรียญทอง" },
  { name: "SlotXO", src: image3, alt: "แบนเนอร์เกมสล็อตค่าย SlotXO ในโหมดทดลองเล่นของ TUNJAI123" },
  { name: "Skywind Group", src: image4, alt: "แบนเนอร์เกมสล็อตค่าย Skywind Group ในโหมดทดลองเล่นของ TUNJAI123" },
  { name: "PG Soft", src: image5, alt: "แบนเนอร์เกมสล็อตค่าย PG Soft ในโหมดทดลองเล่นของ TUNJAI123" },
  { name: "SBOBET", src: image6, alt: "แบนเนอร์ค่ายเกม SBOBET พร้อมตัวละครการ์ตูนถือลูกอม" },
  { name: "Sexy Slot", src: image7, alt: "แบนเนอร์เกมสล็อตค่าย Sexy Slot ในโหมดทดลองเล่นของ TUNJAI123" },
  { name: "JILI", src: image8, alt: "แบนเนอร์เกมสล็อตค่าย JILI ในโหมดทดลองเล่นของ TUNJAI123" },
  { name: "Ask Me Bet", src: image9, alt: "แบนเนอร์ค่ายเกม Ask Me Bet ในโหมดทดลองเล่นของ TUNJAI123" },
  { name: "New Game", src: image10, alt: "แบนเนอร์เกมออกใหม่ New Game พร้อมตัวการ์ตูนฟักทองและโครงกระดูก" },
  { name: "JOKER", src: image11, alt: "แบนเนอร์เกมสล็อตค่าย JOKER ในโหมดทดลองเล่นของ TUNJAI123" },
  { name: "AFB Gaming", src: image12, alt: "แบนเนอร์ค่ายเกม AFB Gaming ในโหมดทดลองเล่นของ TUNJAI123" },
];

// The URL each entry resolves to is schema.ts's problem, not this file's — an
// older version pasted a hand-built page URL onto all 12 and got the trailing
// slash and the Thai encoding wrong on every one of them.
const gameList = demoGames.map((game) => ({ name: game.name, imagePath: game.src.src }));

// 157 CHARACTERS (not bytes). The docx sentence ends at 129, under
// verify-build.mjs's 150 floor, so the trailing clause brings it into the
// window without changing what the brief says.
const pageDescription =
  "โหมดทดลองเล่นฟรีบน TUNJAI123 สัมผัสความรวดเร็วดั่งใจนึกและศึกษาระบบเกมลิขสิทธิ์แท้ได้อย่างอิสระ ไร้ขีดจำกัด ไม่มีค่าใช้จ่าย ทดลองได้ทุกค่ายทันที ไม่ต้องสมัคร";

const ctx = schemaCtx(Astro);
const graph = pageGraph(Astro, {
  type: "CollectionPage",
  name: "TUNJAI123 ทดลองเล่นฟรี รวมทุกค่ายในเว็ปเดียว ไม่ต้องฝาก",
  description: pageDescription,
  breadcrumb: [
    { name: "หน้าแรก", path: "/" },
    { name: "ทดลองเล่น", path: "/ทดลองเล่น" },
  ],
  extra: [
    itemList(ctx, {
      name: "ทดลองเล่นเกมสล็อตของ TUNJAI123",
      alternateName: "TUNJAI123 โหมดทดลองเล่นสล็อตลิขสิทธิ์แท้ทุกค่ายบนมือถือ ก่อนเล่นด้วยเงินจริง",
      itemType: "Game",
      items: gameList,
    }),
  ],
});
---

<MainLayout title="TUNJAI123 ทดลองเล่นฟรี รวมทุกค่ายในเว็ปเดียว ไม่ต้องฝาก" description={pageDescription}>
  <script type="application/ld+json" set:html={graph} />

  <Announcement />

  <ContentBox title="ทดลองเล่นฟรี TUNJAI123 รวมทุกค่ายในเว็ปเดียว ไม่ต้องฝาก" as="h1">
    <h2 class="mb-6 bg-gradient-to-r from-[#f5eb8b] via-[#dab563] to-[#dfe4e7] bg-clip-text text-2xl leading-normal font-bold text-transparent">โหมดทดลองของ TUNJAI123 มีไว้ทำอะไร และควรดูอะไรก่อนเลือกเกม</h2>

    <p class="mb-8 text-left text-base leading-relaxed text-[#ece3cf]">
      TUNJAI123 เป็นเว็บตรงอันดับ 1 ที่เชื่อมต่อ API ลิขสิทธิ์แท้ 100% จากผู้พัฒนาระดับโลกไว้ในบัญชีเดียว ทั้ง PG Soft ที่กราฟิกเหนือชั้นและแอนิเมชันสมจริงจนโบนัสแตกไว Pragmatic Play ที่ฟีเจอร์ทันสมัยและแจกรางวัลรัวไม่มีสะดุด และ JILI ที่เอฟเฟกต์อลังการ เบา เสถียร รองรับทุกอุปกรณ์
      หน้านี้จึงเป็นที่ให้กดเปิดดูหน้าเกมก่อนว่าหน้าตาระบบเป็นแบบไหน ปุ่มปรับเดิมพันอยู่ตรงไหน ฟีเจอร์โบนัสทำงานอย่างไร และหนึ่งรอบกินเวลาแค่ไหน โดยยังไม่ต้องฝาก ไม่ต้องใส่เงินจริง และไม่มีการได้เสียเกิดขึ้น
      สิ่งที่ควรดูจริงคือเดิมพันเริ่มต้นต่อรอบ ความผันผวน และรูปแบบการจ่าย มากกว่าดูว่าเกมไหนกำลังดังที่สุด เกมดังช่วยให้หารีวิวง่าย แต่ไม่ได้ช่วยเจรจากับระบบสุ่มเป็นการส่วนตัว ถือเป็นการอ่านคู่มือก่อนขับ ซึ่งน่าเบื่อกว่าการลองขับเลยอยู่แล้ว แต่ค่าซ่อมมันถูกกว่ากันเยอะ
    </p>

    <div class="mb-5 grid grid-cols-2 gap-5 sm:grid-cols-2 md:grid-cols-4">
      {
        demoGames.map((game) => (
          <div class="group/game relative mx-auto w-full max-w-[400px] overflow-hidden rounded-xl">
            <Picture
              src={game.src}
              alt={game.alt}
              loading="lazy"
              fetchpriority="low"
              widths={[200, 400, 600]}
              sizes="(max-width: 768px) 100vw, 25vw"
              class="block h-auto w-full object-cover shadow-[0_10px_30px_rgba(218,181,99,0.18)] transition-transform duration-300 group-hover/game:scale-105"
              decoding="async"
              formats={["avif", "webp"]}
              fallbackFormat="webp"
              quality={60}
            />
            <a
              href="/register"
              target="_blank"
              rel="noopener noreferrer"
              aria-label={`สมัครสมาชิกเพื่อเล่น ${game.name} ที่ TUNJAI123`}
              class="absolute inset-0 flex items-center justify-center bg-[#050403]/75 opacity-0 transition-opacity duration-300 group-hover/game:opacity-100 focus-visible:opacity-100">
              <span class="rounded-full border border-[#dab563]/60 bg-gradient-to-r from-[#f5eb8b] via-[#dab563] to-[#a97f28] px-6 py-2 font-bold text-[#120c04] shadow-[0_10px_30px_rgba(218,181,99,0.30)] transition-transform hover:scale-110">เล่นเลย</span>
            </a>
          </div>
        ))
      }
    </div>

    <h2 class="mt-8 mb-6 bg-gradient-to-r from-[#f5eb8b] via-[#dab563] to-[#dfe4e7] bg-clip-text text-2xl leading-normal font-bold text-transparent">โหมดทดลองบอกอะไรได้ และบอกอะไรไม่ได้</h2>

    <p class="mb-4 text-left text-base leading-relaxed text-[#ece3cf]">
      โหมดทดลองบอกได้ว่าเกมทำงานอย่างไร เมนูอยู่ตรงไหน ฟีเจอร์ซื้อฟรีสปินเรียกใช้ยังไง และหนึ่งรอบใช้เวลาเท่าไร แต่เครดิตในโหมดนี้เป็นยอดสมมติ ถอนไม่ได้ และผลที่ออกมาก็ไม่ได้บอกว่าเล่นจริงจะได้ผลเหมือนกัน
      ต่อให้กดในโหมดทดลองแล้วจังหวะเข้ามือ ก็ไม่ใช่หลักฐานว่าเกมนั้นกำลังอารมณ์ดีรอเราอยู่ โหมดนี้มีไว้ศึกษาระบบ ไม่ใช่ไว้ดูดวงผ่านหน้าจอ
    </p>

    <p class="mb-4 text-left text-base leading-relaxed text-[#ece3cf]">
      อีกเรื่องที่ควรเผื่อใจคือโหมดทดลองไม่ได้มีให้ครบทุกเกม จึงควรเปิดหน้ารายละเอียดของเกมดูก่อนเลือก และยอดที่หมุนในโหมดทดลองไม่นับเป็นยอดเทิร์นของบัญชีหรือของโปรโมชั่นใด
      ถ้าเกมที่อยากลองไม่มีปุ่มทดลอง ให้ถือว่าวันนี้โชคไม่ดี ไม่ใช่สัญญาณลับที่ระบบส่งมาให้เราคนเดียว และเกมที่มีฟีเจอร์ตัวคูณสูงมักเหวี่ยงแรงกว่าที่โหมดทดลองรอบสั้น ๆ จะสะท้อนออกมาได้ จึงควรอ่านตารางการจ่ายและกติกาของเกมประกอบด้วยเสมอ
    </p>

    <h2 class="mt-8 mb-6 bg-gradient-to-r from-[#f5eb8b] via-[#dab563] to-[#dfe4e7] bg-clip-text text-2xl leading-normal font-bold text-transparent">จากโหมดทดลองไปเล่นจริงบน TUNJAI123 ควรเช็กอะไรก่อน</h2>

    <p class="mb-2 text-left text-base leading-relaxed text-[#ece3cf]">
      ถ้าจะขยับจากโหมดทดลองไปเล่นด้วยเงินจริง เรื่องที่ควรดูก่อนคือบัญชี งบต่อรอบ โปรโมชั่น และลิงก์ ด้านบัญชี ควรเตรียมเบอร์โทรที่ใช้งานจริงและรับข้อความได้ ตั้งรหัสผ่านที่เดายากและไม่ใช้ซ้ำกับบัญชีอื่น แล้วตรวจชื่อบัญชีธนาคารกับข้อมูลสมาชิกให้ครบก่อนยืนยัน เพราะสมัครเร็วเป็นเรื่องดี แต่กรอกผิดแล้วตามแก้ทีหลัง ความเร็วก็หายหมด
      ด้านงบ เกมสล็อตงบน้อยอาจเริ่มที่ประมาณ 1–10 บาทต่อรอบ ตัวเลขนี้เป็นเดิมพันของเกมที่รองรับ ไม่ใช่เงื่อนไขของการฝากหรือการถอน เพราะฝั่งการเงินของ TUNJAI123 ขับเคลื่อนด้วยระบบออโต้ AI ที่ตรวจสอบและปรับยอดเครดิตให้เองภายในไม่กี่วินาที รวดเร็วดั่งใจนึก โอนไว และการันตี จ่ายจริง ไม่มีกั๊ก ทุกยอดบิล
      ถ้าจะกดรับแคมเปญคืนยอดเสียหรือโปรฝากแรก ก็ต้องอ่านยอดฝาก โบนัสที่ได้รับ จำนวนเทิร์น ค่ายเกมที่ร่วมรายการ และเพดานถอนให้จบก่อน สุดท้ายควรเข้าใช้งานผ่านทางเข้าจริงของ TUNJAI123 ที่ตรวจชื่อเว็บไซต์แล้วและเชื่อมต่อแบบ HTTPS ซึ่งเปิดแดชบอร์ดผ่าน Secure Transition Popup ให้ปลอดภัยขั้นสุด ไม่ใช่ลิงก์ที่ส่งต่อกันมาในแชตพร้อมคำโฆษณา
    </p>
  </ContentBox>

  <Navfoot />
</MainLayout>
