---
import MainLayout from "../layouts/MainLayout.astro";
import ContentBox from "../components/ContentBox.astro";
import Navfoot from "../components/Navfoot.astro";
import Announcement from "../components/Announcement3.astro";

import { Picture } from "astro:assets";
import { itemList, pageGraph, schemaCtx } from "../lib/schema";
import image1 from "../assets/gamedemo7.webp";
import image2 from "../assets/gamedemo8.webp";
import image3 from "../assets/gamedemo9.webp";
import image4 from "../assets/gamedemo10.webp";
import image5 from "../assets/gamedemo11.webp";
import image6 from "../assets/gamedemo12.webp";
import image7 from "../assets/gamedemo13.webp";
import image8 from "../assets/gamedemo14.webp";
import image9 from "../assets/gamedemo15.webp";
import image10 from "../assets/gamedemo16.webp";
import image11 from "../assets/gamedemo17.webp";
import image12 from "../assets/gamedemo18.webp";

// One list, two consumers: the gallery below and the ItemList in the JSON-LD.
// They used to be two hand-kept arrays that had to stay in the same order, and
// the name shown to a reader could drift from the name handed to a crawler.
//
// Each alt describes the artwork on that banner, not the file it came from —
// these are shared stock banners, so they carry no brand name of ours.
const demoGames = [
  { name: "AskmeSlot", src: image1, alt: "โลโก้ askmeslot รูปโพดำสีทอง คู่กับเด็กชายการ์ตูนสามมิติสวมหมวกแก๊ปสีแดงติดดาว วิ่งอยู่บนถนนเมืองเก่าที่มีกังหันลม" },
  { name: "Popular Game", src: image2, alt: "ตัวอักษร POPULAR GAME สีทอง มีกระต่ายกับแมวการ์ตูนใส่แว่นกันแดดยืนขนาบข้างหีบสมบัติ กองเหรียญและชิปคาสิโน" },
  { name: "SlotXO", src: image3, alt: "โลโก้ SlotXO รูปตู้สล็อตกับเหรียญทอง คู่กับแม่ทัพโรมันสวมมงกุฎใบลอเรลยืนหน้าโคลอสเซียม" },
  { name: "Skywind Group", src: image4, alt: "โลโก้ Skywind Group วงกลมสี่สี คู่กับแมวกวักญี่ปุ่นสีขาวห้อยกระดิ่งทอง ท่ามกลางดอกซากุระและถุงเงินมงคล" },
  { name: "PG Soft", src: image5, alt: "โลโก้ PG Pocket Games Soft แบบพิกเซลหลากสี คู่กับหญิงสาวนักรบสวมหมวกขนนกและเครื่องประดับทองแบบชนเผ่า" },
  { name: "SBOBET", src: image6, alt: "โลโก้ SBOBET สีขาวบนพื้นดำ คู่กับสาวการ์ตูนอนิเมะผมบลอนด์ในชุดกิโมโนสีชมพู ถืออมยิ้มเกลียวหลากสี" },
  { name: "Sexy Slot", src: image7, alt: "ตัวอักษร Sexy Slot สีชมพูอมม่วง คู่กับหญิงสาวการ์ตูนผมยาวสีน้ำตาลในชุดรัดรูป มีหัวใจสีชมพูลอยอยู่โดยรอบ" },
  { name: "JILI", src: image8, alt: "ตัวอักษร JILI สีทอง คู่กับนางเงือกผมสีแดงถือหอยสังข์ทอง อยู่ใต้ทะเลที่มีปลาการ์ตูนและปะการังสีสด" },
  { name: "Ask Me Bet", src: image9, alt: "โลโก้ ask me bet สีเขียวเหลือง คู่กับหัวสิงโตเชิดจีนสีขาวแดงประดับทอง ท่ามกลางโคมไฟสีแดง" },
  { name: "New Game", src: image10, alt: "ตัวอักษร New Game สีขาว มีผีฟักทองและโครงกระดูกการ์ตูนยืนสองข้าง บนพื้นดิสโก้สีนีออนที่โปรยอัญมณีและชิป" },
  { name: "JOKER", src: image11, alt: "โลโก้ JOKER สีขาวสลับทอง คู่กับนักรบโรมันสวมหมวกขนนกสีแดงยืนเคียงสิงโตกำลังคำราม ในสนามประลองกลางแจ้ง" },
  { name: "AFB Gaming", src: image12, alt: "โลโก้ AFB 777 Gaming สีทอง คู่กับเทพเจ้ากรีกเคราขาวสวมมงกุฎใบลอเรล ดวงตาเปล่งประกายหน้าวิหารเสาหินอ่อน" },
];

// The URL each entry resolves to is schema.ts's problem, not this file's — an
// older version pasted a hand-built page URL onto all 12 and got the trailing
// slash and the Thai encoding wrong on every one of them.
const gameList = demoGames.map((game) => ({ name: game.name, imagePath: game.src.src }));

// 154 CHARACTERS (not bytes). The docx sentence ends at 128, under
// verify-build.mjs's 150 floor, so the trailing clause is built from this
// brand's own vocabulary and brings it into the window without changing what
// the brief says.
const pageDescription =
  "โหมดทดลองเล่นฟรีบนแพลตฟอร์ม TT1BET สัมผัสความสนุกและเรียนรู้ฟีเจอร์เกมระดับโลกได้อย่างอิสระ ไม่มีขีดจำกัด ไม่มีค่าใช้จ่าย";

const ctx = schemaCtx(Astro);
const graph = pageGraph(Astro, {
  type: "CollectionPage",
  name: "TT1BET ทดลองเล่นฟรี รวมเกมแตกง่าย ศึกษาเทคนิคก่อนลงสนาม",
  description: pageDescription,
  breadcrumb: [
    { name: "หน้าแรก", path: "/" },
    { name: "ทดลองเล่น", path: "/ทดลองเล่น" },
  ],
  extra: [
    itemList(ctx, {
      name: "ทดลองเล่นเกมสล็อตของ GARUDA369",
      alternateName: "GARUDA369 โหมดทดลองเล่นสล็อตจากค่ายเกมลิขสิทธิ์แท้บนมือถือ ก่อนเล่นด้วยเงินจริง",
      itemType: "Game",
      items: gameList,
    }),
  ],
});
---

<MainLayout title="TT1BET ทดลองเล่นฟรี รวมเกมแตกง่าย ศึกษาเทคนิคก่อนลงสนาม" description={pageDescription}>
  <script type="application/ld+json" set:html={graph} />

  <Announcement />

  <ContentBox title="ทดลองเล่นฟรี GARUDA369 สล็อตเว็บใหญ่ ครบทุกค่ายไม่ต้องฝาก" as="h1">
    <h2 class="mb-6 bg-gradient-to-r from-[#a8e81c] via-[#7bbb0b] to-[#63a30c] bg-clip-text text-2xl leading-normal font-bold text-transparent">
      โหมดทดลองของ GARUDA369 มีไว้ทำอะไร และควรดูอะไรก่อนเลือกเกม
    </h2>

    <p class="mb-8 text-left text-base leading-relaxed text-[#dcefc2]">
      GARUDA369 เป็น สล็อตเว็บใหญ่ แบบ เว็บตรงไม่ผ่านเอเย่นต์ ที่เชื่อมต่อ เกมลิขสิทธิ์แท้ จากค่ายระดับโลกไว้ในบัญชีเดียว ทั้ง AvatarUX ที่โดดเด่นด้วยกลไก PopWins
      ซึ่งขยายกระดานให้ใหญ่ขึ้นทุกครั้งที่ชนะรางวัล Spinomenal ที่มาพร้อมภาพแอนิเมชันสุดตระการตาและฟีเจอร์ที่ปรับจูนมาให้เข้าถึงรอบแจ็กพอตได้ไว และ Relax Gaming
      ที่เน้นสถาปัตยกรรมซอฟต์แวร์แข็งแรง โหลดไว ตอบสนองฉับไวบนทุกอุปกรณ์ หน้านี้จึงเป็นที่ให้กดเปิดดูหน้าเกมก่อนว่าหน้าตาระบบเป็นแบบไหน ปุ่มปรับเดิมพันอยู่ตรงไหน
      ฟีเจอร์โบนัสทำงานอย่างไร และหนึ่งรอบกินเวลาแค่ไหน โดยยังไม่ต้องฝาก ไม่ต้องใส่เงินจริง และไม่มีการได้เสียเกิดขึ้น สิ่งที่ควรดูจริงคือเดิมพันเริ่มต้นต่อรอบ ความผันผวน
      และรูปแบบการจ่าย มากกว่าดูว่าเกมไหนกำลังดังที่สุด เกมดังช่วยให้หารีวิวง่าย แต่ไม่ได้ช่วยเจรจากับระบบสุ่มเป็นการส่วนตัว ถือเป็นการอ่านคู่มือก่อนขับ
      ซึ่งน่าเบื่อกว่าการลองขับเลยอยู่แล้ว แต่ค่าซ่อมมันถูกกว่ากันเยอะ
    </p>

    <div class="mb-5 grid grid-cols-2 gap-5 sm:grid-cols-2 md:grid-cols-4">
      {
        demoGames.map((game) => (
          <div class="group/game relative mx-auto w-full max-w-[400px] overflow-hidden rounded-xl">
            <Picture
              src={game.src}
              alt={game.alt}
              loading="lazy"
              fetchpriority="low"
              widths={[200, 400, 600]}
              sizes="(max-width: 767px) 50vw, 25vw"
              class="block h-auto w-full object-cover shadow-[0_10px_30px_rgba(123,187,11,0.18)] transition-transform duration-300 group-hover/game:scale-105"
              decoding="async"
              formats={["avif", "webp"]}
              fallbackFormat="webp"
              quality={60}
            />
            <a
              href="/register"
              target="_blank"
              rel="noopener noreferrer"
              aria-label={`สมัครสมาชิกเพื่อเล่น ${game.name} ที่ GARUDA369`}
              class="absolute inset-0 flex items-center justify-center bg-[#061405]/80 opacity-0 transition-opacity duration-300 group-hover/game:opacity-100 focus-visible:opacity-100">
              <span class="rounded-full border border-[#7bbb0b]/50 bg-gradient-to-r from-[#a8e81c] via-[#7bbb0b] to-[#3c6b07] px-6 py-2 font-bold text-[#061405] shadow-[0_10px_30px_rgba(123,187,11,0.30)] transition-transform hover:scale-110">
                เล่นเลย
              </span>
            </a>
          </div>
        ))
      }
    </div>

    <h2 class="mt-8 mb-6 bg-gradient-to-r from-[#a8e81c] via-[#7bbb0b] to-[#63a30c] bg-clip-text text-2xl leading-normal font-bold text-transparent">โหมดทดลองบอกอะไรได้ และบอกอะไรไม่ได้</h2>

    <p class="mb-4 text-left text-base leading-relaxed text-[#dcefc2]">
      โหมดทดลองบอกได้ว่าเกมทำงานอย่างไร เมนูอยู่ตรงไหน ฟีเจอร์ซื้อฟรีสปินเรียกใช้ยังไง และหนึ่งรอบใช้เวลาเท่าไร แต่เครดิตในโหมดนี้เป็นยอดสมมติ ถอนไม่ได้
      และผลที่ออกมาก็ไม่ได้บอกว่าเล่นจริงจะได้ผลเหมือนกัน ต่อให้กดในโหมดทดลองแล้วจังหวะเข้ามือ ก็ไม่ใช่หลักฐานว่าเกมนั้นกำลังอารมณ์ดีรอเราอยู่ โหมดนี้มีไว้ศึกษาระบบ ไม่ใช่ไว้ดูดวงผ่านหน้าจอ
    </p>

    <p class="mb-4 text-left text-base leading-relaxed text-[#dcefc2]">
      อีกเรื่องที่ควรเผื่อใจคือโหมดทดลองไม่ได้มีให้ครบทุกเกม จึงควรเปิดหน้ารายละเอียดของเกมดูก่อนเลือก และยอดที่หมุนในโหมดทดลองไม่นับเป็นยอดสะสมของบัญชีหรือของโปรโมชั่นใด
      ถ้าเกมที่อยากลองไม่มีปุ่มทดลอง ให้ถือว่าวันนี้โชคไม่ดี ไม่ใช่สัญญาณลับที่ระบบส่งมาให้เราคนเดียว และเกมที่ขยายเพย์ไลน์ทวีคูณอย่างฝั่ง AvatarUX มักเหวี่ยงแรงกว่าที่โหมดทดลองรอบสั้น ๆ
      จะสะท้อนออกมาได้ จึงควรอ่านตารางการจ่ายและกติกาของเกมประกอบด้วยเสมอ
    </p>

    <h2 class="mt-8 mb-6 bg-gradient-to-r from-[#a8e81c] via-[#7bbb0b] to-[#63a30c] bg-clip-text text-2xl leading-normal font-bold text-transparent">
      จากโหมดทดลองไปเล่นจริงบน GARUDA369 ควรเช็กอะไรก่อน
    </h2>

    <p class="mb-2 text-left text-base leading-relaxed text-[#dcefc2]">
      ถ้าจะขยับจากโหมดทดลองไปเล่นด้วยเงินจริง เรื่องที่ควรดูก่อนคือบัญชี งบต่อรอบ โปรโมชั่น และลิงก์ ด้านบัญชี ควรเตรียมเบอร์โทรที่ใช้งานจริงและรับข้อความได้
      ตั้งรหัสผ่านที่เดายากและไม่ใช้ซ้ำกับบัญชีอื่น แล้วตรวจชื่อบัญชีธนาคารกับข้อมูลสมาชิกให้ครบก่อนยืนยัน เพราะสมัครเร็วเป็นเรื่องดี แต่กรอกผิดแล้วตามแก้ทีหลัง ความเร็วก็หายหมด ด้านงบ
      ระบบออโต้ ที่ขับเคลื่อนด้วย AI จะประมวลผลยอดฝากและถอนให้จบภายในเสี้ยววินาที จึงเริ่มด้วยทุนเท่าไรก็บริหารได้อิสระ ส่วนเดิมพันต่อรอบของเกมสล็อตงบน้อยอาจเริ่มที่ประมาณ 1–10 บาท
      ตัวเลขนี้เป็นเดิมพันของเกมที่รองรับ ไม่ใช่เงื่อนไขของการฝากหรือการถอน และถ้าติดขัดตรงไหน ทีมงานของ GARUDA369 ก็พร้อมดูแลตลอด 24 ชั่วโมง ไม่มีวันหยุด ตั้งแต่ก้าวแรกที่สมัครสมาชิก
      ถ้าจะกดรับแคมเปญ คืนยอดเสีย 15% หรือค่าคอมมิชชั่นจากการแนะนำเพื่อน 0.8% ก็ต้องอ่านรอบการคำนวณ ยอดที่นับได้จริง ค่ายเกมที่ร่วมรายการ และเพดานการถอนให้จบก่อน
      สุดท้ายควรเข้าใช้งานผ่านทางเข้าจริงของ GARUDA369 ที่ล็อกอินผ่าน Secure Popup และเชื่อมต่อแบบ HTTPS ไม่ใช่ลิงก์ที่ส่งต่อกันมาในแชตพร้อมคำโฆษณา
    </p>
  </ContentBox>

  <Navfoot />
</MainLayout>
