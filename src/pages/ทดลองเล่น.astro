const demoGames = [
  { id: 1, src: image1, alt: "ทดลองเล่นเกม AskmeSlot ที่ LAPDEE88", link: "/register" },
  { id: 2, src: image2, alt: "ทดลองเล่นเกมยอดนิยมที่ LAPDEE88", link: "/register" },
  { id: 3, src: image3, alt: "ทดลองเล่นเกม SlotXO ที่ LAPDEE88", link: "/register" },
  { id: 4, src: image4, alt: "ทดลองเล่นเกม Skywind Group ที่ LAPDEE88", link: "/register" },
  { id: 5, src: image5, alt: "ทดลองเล่นเกม PG Soft ที่ LAPDEE88", link: "/register" },
  { id: 6, src: image6, alt: "ทดลองเล่นเกม SBOBET ที่ LAPDEE88", link: "/register" },
  { id: 7, src: image7, alt: "ทดลองเล่นเกม Sexy Slot ที่ LAPDEE88", link: "/register" },
  { id: 8, src: image8, alt: "ทดลองเล่นเกม JILI ที่ LAPDEE88", link: "/register" },
  { id: 9, src: image9, alt: "ทดลองเล่นเกม Ask Me Bet ที่ LAPDEE88", link: "/register" },
  { id: 10, src: image10, alt: "ทดลองเล่นเกมใหม่ที่ LAPDEE88", link: "/register" },
  { id: 11, src: image11, alt: "ทดลองเล่นเกม JOKER ที่ LAPDEE88", link: "/register" },
  { id: 12, src: image12, alt: "ทดลองเล่นเกม AFB Gaming ที่ LAPDEE88", link: "/register" },
];
const homePage = Astro.url.origin;
const gameList = [
  { name: "AskmeSlot", image: homePage + image1.src },
  { name: "Popular Game", image: homePage + image2.src },
  { name: "SlotXO", image: homePage + image3.src },
  { name: "Skywind Group", image: homePage + image4.src },
  { name: "PG Soft", image: homePage + image5.src },
  { name: "SBOBET", image: homePage + image6.src },
  { name: "Sexy Slot", image: homePage + image7.src },
  { name: "JILI", image: homePage + image8.src },
  { name: "Ask Me Bet", image: homePage + image9.src },
  { name: "New Game", image: homePage + image10.src },
  { name: "JOKER", image: homePage + image11.src },
  { name: "AFB Gaming", image: homePage + image12.src },
];
---

<script type="application/ld+json" set:html={JSON.stringify(gameList)} />
<MainLayout
  title="ทดลองเล่น LAPDEE88 โหมดทดลองสล็อตฟรี ไม่ใช้เงินจริง ดูเกมก่อนเล่นจริง"
  description="ทดลองเล่นเกมฟรีของ LAPDEE88 ในโหมดทดลองที่ไม่ใช้เงินจริง ใช้ดูรูปแบบเกม ฟีเจอร์ รอบโบนัส และความผันผวนของสล็อตหลายค่ายก่อนตัดสินใจเล่นจริง พร้อมวิธีอ่านค่า RTP กับ Volatility และสิ่งที่ควรรู้ก่อนข้ามไปคาสิโนสด">
  <Announcement />

  <ContentBox title="ทดลองเล่นเกมฟรีของ LAPDEE88 ลองก่อนได้ ไม่ต้องใช้เงินจริง">
    <h2 class="mb-6 bg-gradient-to-r from-white via-amber-100 to-amber-400 bg-clip-text text-2xl leading-normal font-bold text-transparent">โหมดทดลองของ LAPDEE88 มีไว้ทำอะไร และควรดูค่าอะไรของเกม</h2>

    <p class="mb-8 text-left text-base leading-relaxed text-amber-50/85">
      LAPDEE88 รวมสล็อตจากหลายค่ายและคาสิโนสดไว้ในระบบเดียว โหมดทดลองจึงมีไว้ให้กดดูรูปแบบเกมก่อนว่าหน้าตาเป็นอย่างไร มีไลน์จ่ายกี่แบบ ฟีเจอร์พิเศษทำงานตอนไหน และรอบโบนัสมาบ่อยแค่ไหน โดยไม่ต้องใช้เงินจริงและไม่มีการได้เสียใด ๆ ก่อนเลือกเกมควรดูทั้งผู้ให้บริการ ค่า RTP และ Volatility
      ควบคู่กัน เพราะ RTP ใช้อธิบายอัตราจ่ายคืนในระยะยาว ส่วน Volatility บอกความถี่และขนาดของรางวัลที่จะเจอระหว่างทาง เหมาะกับสมาชิกใหม่ที่ยังไม่คุ้นกับปุ่มปรับเดิมพันหรือระบบสปินอัตโนมัติ และอยากเทียบเกมหลายค่ายให้จบในรอบเดียวก่อนตัดสินใจว่าจะเอาเกมไหนไปเล่นจริง
    </p>

    <div class="mb-5 grid grid-cols-2 gap-5 sm:grid-cols-2 md:grid-cols-4">
      {
        demoGames.map((game) => (
          <div class="group relative flex flex-col gap-4 overflow-hidden rounded-xl">
            <Picture
              src={game.src}
              alt={game.alt}
              loading="lazy"
              fetchpriority="low"
              widths={[200, 400, 600]}
              sizes="(max-width: 768px) 100vw, 25vw"
              class="mx-auto h-auto w-full max-w-[400px] object-cover shadow-xl transition-transform duration-300 group-hover:scale-105"
              decoding="async"
              formats={["avif", "webp"]}
              fallbackFormat="webp"
              quality={60}
            />
            <a
              href={game.link}
              target="_blank"
              rel="noopener noreferrer"
              aria-label={`ทดลองเล่น ${game.alt}`}
              class="absolute inset-0 flex items-center justify-center bg-[#0b0906]/70 opacity-0 transition-opacity duration-300 group-hover:opacity-100">
              <span class="rounded-full border border-amber-200/60 bg-gradient-to-r from-[#f6e4b4] via-[#e0bd72] to-[#b1873a] px-6 py-2 font-bold text-[#140f05] shadow-[0_10px_30px_rgba(212,175,90,0.5)] transition-transform hover:scale-110">เล่นเลย</span>
            </a>
          </div>
        ))
      }
    </div>

    <h2 class="mt-8 mb-6 bg-gradient-to-r from-white via-amber-100 to-amber-400 bg-clip-text text-2xl leading-normal font-bold text-transparent">โหมดทดลองบอกอะไรได้ และบอกอะไรไม่ได้</h2>

    <p class="mb-4 text-left text-base leading-relaxed text-amber-50/85">
      โหมดทดลองบอกได้ว่าเกมเล่นอย่างไร ฟีเจอร์อยู่ตรงไหน และจังหวะเกมถูกใจหรือเปล่า แต่เครดิตในโหมดนี้เป็นยอดสมมติ ถอนไม่ได้ และไม่ได้การันตีผลตอนเล่นจริง ค่า RTP ที่สูงก็ไม่ได้แปลว่าเกมต้องจ่ายทันที ผู้ที่มีงบจำกัดควรเลือกเดิมพันต่ำและความผันผวนที่เหมาะกับทุน
      อย่าเห็นคำว่าแตกง่ายแล้วคิดว่าเครื่องกำลังรอเราอยู่ ส่วนใครที่ตั้งใจจะรับโบนัสหลังเล่นจริง ให้ตรวจยอดฝากขั้นต่ำ เทิร์นโอเวอร์ ระยะเวลา และเพดานถอนก่อน เพราะบางเกมที่สนุกในโหมดทดลอง อาจไม่ได้อยู่ในรายชื่อเกมที่ร่วมรายการและนับยอดให้
    </p>

    <p class="mb-2 text-left text-base leading-relaxed text-amber-50/85">
      ถ้าอยากขยับไปคาสิโนสดอย่างบาคาร่า รูเล็ต หรือเสือมังกร ให้เผื่อว่าเกมกลุ่มนี้เล่นตามรอบโต๊ะพร้อมภาพถ่ายทอดสด จึงควรตรวจขั้นต่ำ กติกา และความเสถียรของอินเทอร์เน็ตก่อนเข้าเล่น หากหน้าเกมโหลดไม่สมบูรณ์หรือค้างกลางคัน ไม่ควรกดยืนยันซ้ำทันที ให้ตรวจประวัติรายการก่อนเพื่อกันการเดิมพันซ้ำโดยไม่ตั้งใจ
      และควรเข้าเกมผ่านหน้าเว็บทางเข้าจริงของ LAPDEE88 เท่านั้น ไม่ใช่ลิงก์ที่ส่งต่อกันมาในข้อความส่วนตัว
    </p>
  </ContentBox>

  <Navfoot />
</MainLayout>
