---
import MainLayout from "../layouts/MainLayout.astro";
import ContentBox from "../components/ContentBox.astro";
import Navfoot from "../components/Navfoot.astro";
import Announcement from "../components/AnnouncementCyber.astro";

import { Picture } from "astro:assets";
import { itemList, pageGraph, schemaCtx } from "../lib/schema";
import image1 from "../assets/gamedemo7.webp";
import image2 from "../assets/gamedemo8.webp";
import image3 from "../assets/gamedemo9.webp";
import image4 from "../assets/gamedemo10.webp";
import image5 from "../assets/gamedemo11.webp";
import image6 from "../assets/gamedemo12.webp";
import image7 from "../assets/gamedemo13.webp";
import image8 from "../assets/gamedemo14.webp";
import image9 from "../assets/gamedemo15.webp";
import image10 from "../assets/gamedemo16.webp";
import image11 from "../assets/gamedemo17.webp";
import image12 from "../assets/gamedemo18.webp";

// One list, two consumers: the gallery below and the ItemList in the JSON-LD.
// They used to be two hand-kept arrays that had to stay in the same order, and
// the name shown to a reader could drift from the name handed to a crawler.
const demoGames = [
  { name: "AskmeSlot", src: image1, alt: "แบนเนอร์เกมสล็อตค่าย AskmeSlot ในหน้าทดลองเล่นของ PGW44" },
  { name: "Popular Game", src: image2, alt: "แบนเนอร์รวมเกมยอดนิยม Popular Game พร้อมกองชิปและเหรียญทอง" },
  { name: "SlotXO", src: image3, alt: "แบนเนอร์เกมสล็อตค่าย SlotXO ในหน้าทดลองเล่นของ PGW44" },
  { name: "Skywind Group", src: image4, alt: "แบนเนอร์เกมสล็อตค่าย Skywind Group ในหน้าทดลองเล่นของ PGW44" },
  { name: "PG Soft", src: image5, alt: "แบนเนอร์เกมสล็อตค่าย PG Soft ในหน้าทดลองเล่นของ PGW44" },
  { name: "SBOBET", src: image6, alt: "แบนเนอร์ค่ายเกม SBOBET พร้อมตัวละครการ์ตูนถือลูกอม" },
  { name: "Sexy Slot", src: image7, alt: "แบนเนอร์เกมสล็อตค่าย Sexy Slot ในหน้าทดลองเล่นของ PGW44" },
  { name: "JILI", src: image8, alt: "แบนเนอร์เกมสล็อตค่าย JILI ในหน้าทดลองเล่นของ PGW44" },
  { name: "Ask Me Bet", src: image9, alt: "แบนเนอร์ค่ายเกม Ask Me Bet ในหน้าทดลองเล่นของ PGW44" },
  { name: "New Game", src: image10, alt: "แบนเนอร์เกมออกใหม่ New Game พร้อมตัวการ์ตูนฟักทองและโครงกระดูก" },
  { name: "JOKER", src: image11, alt: "แบนเนอร์เกมสล็อตค่าย JOKER ในหน้าทดลองเล่นของ PGW44" },
  { name: "AFB Gaming", src: image12, alt: "แบนเนอร์ค่ายเกม AFB Gaming ในหน้าทดลองเล่นของ PGW44" },
];

// The URL each entry resolves to is schema.ts's problem, not this file's — an
// older version pasted a hand-built page URL onto all 12 and got the trailing
// slash and the Thai encoding wrong on every one of them.
const gameList = demoGames.map((game) => ({ name: game.name, imagePath: game.src.src }));

// The docx supplies this description; the trailing clause only brings it into
// the 150–160 character window verify-build enforces (the docx text ends at 134).
const pageDescription =
  "โหมดทดลองเล่นฟรีบนแพลตฟอร์ม PGW44 เปิดโอกาสให้คุณศึกษาระบบและฟีเจอร์เกมระดับโลกได้อย่างอิสระ ไร้ขีดจำกัด ทันทีโดยไม่ต้องเสียค่าใช้จ่าย ทดลองได้ตลอด 24 ชั่วโมง";

const ctx = schemaCtx(Astro);
const graph = pageGraph(Astro, {
  type: "CollectionPage",
  name: "ทดลองเล่นเกมของ PGW44 ลองระบบก่อนเล่นด้วยเงินจริง",
  description: pageDescription,
  breadcrumb: [
    { name: "หน้าแรก", path: "/" },
    { name: "ทดลองเล่น", path: "/ทดลองเล่น" },
  ],
  extra: [
    itemList(ctx, {
      name: "ทดลองเล่นเกมสล็อตของ PGW44",
      alternateName: "PGW44 โหมดทดลองเล่นสล็อตหลายค่ายบนมือถือก่อนเล่นด้วยเงินจริง",
      itemType: "Game",
      items: gameList,
    }),
  ],
});
---

<MainLayout title="PGW44 ทดลองเล่นฟรี สล็อตเว็บใหญ่ ลื่นไหล สัมผัสได้ก่อนใคร" description={pageDescription}>
  <script type="application/ld+json" set:html={graph} />

  <Announcement />

  <ContentBox title="ทดลองเล่นเกมของ PGW44 ลองระบบก่อนเล่นด้วยเงินจริง">
    <div>
      <h2 class="mb-6 bg-gradient-to-r from-[#ffd54a] via-[#ecab03] to-[#8fd633] bg-clip-text text-2xl leading-normal font-bold text-transparent">โหมดทดลองของ PGW44 มีไว้ทำอะไร และควรดูอะไรก่อนเลือกเกม</h2>

      <p class="mb-8 text-left text-base leading-relaxed text-[#e8efd8]">
        PGW44 รวมค่ายเกมระดับโลกไว้ในบัญชีเดียว ทั้ง PG Soft ที่โดดเด่นด้วยกราฟิก 3D และรอบโบนัสแตกไว Pragmatic Play ที่กลไกออกรางวัลโปร่งใสและตอบสนองฉับไว และ Nolimit City ที่เน้นตัวคูณมหาศาลแบบก้าวกระโดด รวมถึงค่ายอื่นอีกหลายกลุ่มที่อยู่ในเมนูเดียวกัน
        หน้านี้จึงเป็นที่ให้กดเปิดดูหน้าเกมก่อนว่าหน้าตาระบบเป็นแบบไหน ปุ่มปรับเดิมพันอยู่ตรงไหน ฟีเจอร์โบนัสทำงานอย่างไร และหนึ่งรอบกินเวลาแค่ไหน โดยยังไม่ต้องใส่เงินจริงและไม่มีการได้เสียเกิดขึ้น
        สิ่งที่ควรดูจริงคือเดิมพันเริ่มต้นต่อรอบ ความผันผวน และรูปแบบการจ่าย มากกว่าดูว่าเกมไหนกำลังดังที่สุด เกมดังช่วยให้หารีวิวง่าย แต่ไม่ได้ช่วยเจรจากับระบบสุ่มเป็นการส่วนตัว ถือเป็นการอ่านคู่มือก่อนขับ ซึ่งน่าเบื่อกว่าการลองขับเลยอยู่แล้ว แต่ค่าซ่อมมันถูกกว่ากันเยอะ
      </p>

      <div class="mb-5 grid grid-cols-2 gap-5 sm:grid-cols-2 md:grid-cols-4">
        {
          demoGames.map((game) => (
            <div class="group/game relative mx-auto w-full max-w-[400px] overflow-hidden rounded-xl">
              <Picture
                src={game.src}
                alt={game.alt}
                loading="lazy"
                fetchpriority="low"
                widths={[200, 400, 600]}
                sizes="(max-width: 768px) 100vw, 25vw"
                class="block h-auto w-full object-cover shadow-[0_10px_30px_rgba(236,171,3,0.18)] transition-transform duration-300 group-hover/game:scale-105"
                decoding="async"
                formats={["avif", "webp"]}
                fallbackFormat="webp"
                quality={60}
              />
              <a
                href="/register"
                target="_blank"
                rel="noopener noreferrer"
                aria-label={`สมัครสมาชิกเพื่อเล่น ${game.name} ที่ PGW44`}
                class="absolute inset-0 flex items-center justify-center bg-[#0a0f06]/75 opacity-0 transition-opacity duration-300 group-hover/game:opacity-100 focus-visible:opacity-100">
                <span class="rounded-full border border-[#ecab03]/60 bg-gradient-to-r from-[#ffd54a] via-[#ecab03] to-[#a9760a] px-6 py-2 font-bold text-[#0a0f06] shadow-[0_10px_30px_rgba(236,171,3,0.30)] transition-transform hover:scale-110">เล่นเลย</span>
              </a>
            </div>
          ))
        }
      </div>

      <h2 class="mt-8 mb-6 bg-gradient-to-r from-[#ffd54a] via-[#ecab03] to-[#8fd633] bg-clip-text text-2xl leading-normal font-bold text-transparent">โหมดทดลองบอกอะไรได้ และบอกอะไรไม่ได้</h2>

      <p class="mb-4 text-left text-base leading-relaxed text-[#e8efd8]">
        โหมดทดลองบอกได้ว่าเกมทำงานอย่างไร เมนูอยู่ตรงไหน ฟีเจอร์ซื้อฟรีสปินเรียกใช้ยังไง และหนึ่งรอบใช้เวลาเท่าไร แต่เครดิตในโหมดนี้เป็นยอดสมมติ ถอนไม่ได้ และผลที่ออกมาก็ไม่ได้บอกว่าเล่นจริงจะได้ผลเหมือนกัน
        ต่อให้กดในโหมดทดลองแล้วจังหวะเข้ามือ ก็ไม่ใช่หลักฐานว่าเกมนั้นกำลังอารมณ์ดีรอเราอยู่ โหมดนี้มีไว้ศึกษาระบบ ไม่ใช่ไว้ดูดวงผ่านหน้าจอ
      </p>

      <p class="mb-4 text-left text-base leading-relaxed text-[#e8efd8]">
        อีกเรื่องที่ควรเผื่อใจคือโหมดทดลองไม่ได้มีให้ครบทุกเกม จึงควรเปิดหน้ารายละเอียดของเกมดูก่อนเลือก และยอดที่หมุนในโหมดทดลองไม่นับเป็นยอดเทิร์นของบัญชีหรือของโปรโมชั่นใด
        ถ้าเกมที่อยากลองไม่มีปุ่มทดลอง ให้ถือว่าวันนี้โชคไม่ดี ไม่ใช่สัญญาณลับที่ระบบส่งมาให้เราคนเดียว และเกมที่มีฟีเจอร์ตัวคูณสูงอย่างฝั่ง Nolimit City มักเหวี่ยงแรงกว่าที่โหมดทดลองรอบสั้น ๆ จะสะท้อนออกมาได้ จึงควรอ่านตารางการจ่ายและกติกาของเกมประกอบด้วยเสมอ
      </p>

      <h2 class="mt-8 mb-6 bg-gradient-to-r from-[#ffd54a] via-[#ecab03] to-[#8fd633] bg-clip-text text-2xl leading-normal font-bold text-transparent">จากโหมดทดลองไปเล่นจริงบน PGW44 ควรเช็กอะไรก่อน</h2>

      <p class="mb-2 text-left text-base leading-relaxed text-[#e8efd8]">
        ถ้าจะขยับจากโหมดทดลองไปเล่นด้วยเงินจริง เรื่องที่ควรดูก่อนคือบัญชี งบต่อรอบ โปรโมชั่น และลิงก์ ด้านบัญชี ควรเตรียมเบอร์โทรที่ใช้งานจริงและรับข้อความได้ ตั้งรหัสผ่านที่เดายากและไม่ใช้ซ้ำกับบัญชีอื่น แล้วตรวจชื่อบัญชีธนาคารกับข้อมูลสมาชิกให้ครบก่อนยืนยัน เพราะสมัครเร็วเป็นเรื่องดี แต่กรอกผิดแล้วตามแก้ทีหลัง ความเร็วก็หายหมด
        ด้านงบ เกมสล็อตงบน้อยอาจเริ่มที่ประมาณ 1–10 บาทต่อรอบ ตัวเลขนี้เป็นเดิมพันของเกมที่รองรับ ไม่ใช่เงื่อนไขของการฝากหรือการถอน เพราะฝั่งการเงินของ PGW44 ใช้ระบบออโต้ไม่มีขั้นต่ำที่ประมวลผลเสร็จภายในไม่กี่วินาที และถ้าจะกดรับโปรลุ้นรับรางวัลเยอะหรือแคมเปญคืนยอดเสีย 15% ก็ต้องอ่านยอดฝาก โบนัสที่ได้รับ จำนวนเทิร์น เกมที่ร่วมรายการ และเพดานถอนให้จบก่อน
        สุดท้ายควรเข้าใช้งานผ่านทางเข้าจริงของ PGW44 ที่ตรวจชื่อเว็บไซต์แล้วและเชื่อมต่อแบบ HTTPS เท่านั้น ไม่ใช่ลิงก์ที่ส่งต่อกันมาในแชตพร้อมคำโฆษณา เพราะลิงก์แบบนั้นมักพาไปเจออะไรจริง แค่ไม่ใช่ในทางที่เราหวัง
      </p>
    </div>
  </ContentBox>

  <Navfoot />
</MainLayout>
