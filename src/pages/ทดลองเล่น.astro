---
import MainLayout from "../layouts/MainLayout.astro";
import ContentBox from "../components/ContentBox.astro";
import Navfoot from "../components/Navfoot.astro";
import Announcement from "../components/Announcement4.astro";

import { Picture } from "astro:assets";
import image1 from "../assets/gamedemo7.webp";
import image2 from "../assets/gamedemo8.webp";
import image3 from "../assets/gamedemo9.webp";
import image4 from "../assets/gamedemo10.webp";
import image5 from "../assets/gamedemo11.webp";
import image6 from "../assets/gamedemo12.webp";
import image7 from "../assets/gamedemo13.webp";
import image8 from "../assets/gamedemo14.webp";
import image9 from "../assets/gamedemo15.webp";
import image10 from "../assets/gamedemo16.webp";
import image11 from "../assets/gamedemo17.webp";
import image12 from "../assets/gamedemo18.webp";

const demoGames = [
  { id: 1, src: image1, alt: "ทดลองเล่นเกม AskmeSlot ที่ PAY69", link: "/register" },
  { id: 2, src: image2, alt: "ทดลองเล่นเกมยอดนิยมที่ PAY69", link: "/register" },
  { id: 3, src: image3, alt: "ทดลองเล่นเกม SlotXO ที่ PAY69", link: "/register" },
  { id: 4, src: image4, alt: "ทดลองเล่นเกม Skywind Group ที่ PAY69", link: "/register" },
  { id: 5, src: image5, alt: "ทดลองเล่นเกม PG Soft ที่ PAY69", link: "/register" },
  { id: 6, src: image6, alt: "ทดลองเล่นเกม SBOBET ที่ PAY69", link: "/register" },
  { id: 7, src: image7, alt: "ทดลองเล่นเกม Sexy Slot ที่ PAY69", link: "/register" },
  { id: 8, src: image8, alt: "ทดลองเล่นเกม JILI ที่ PAY69", link: "/register" },
  { id: 9, src: image9, alt: "ทดลองเล่นเกม Ask Me Bet ที่ PAY69", link: "/register" },
  { id: 10, src: image10, alt: "ทดลองเล่นเกมใหม่ที่ PAY69", link: "/register" },
  { id: 11, src: image11, alt: "ทดลองเล่นเกม JOKER ที่ PAY69", link: "/register" },
  { id: 12, src: image12, alt: "ทดลองเล่นเกม AFB Gaming ที่ PAY69", link: "/register" },
];
const homePage = Astro.url.origin;
const gameList = [
  { name: "AskmeSlot", image: homePage + image1.src },
  { name: "Popular Game", image: homePage + image2.src },
  { name: "SlotXO", image: homePage + image3.src },
  { name: "Skywind Group", image: homePage + image4.src },
  { name: "PG Soft", image: homePage + image5.src },
  { name: "SBOBET", image: homePage + image6.src },
  { name: "Sexy Slot", image: homePage + image7.src },
  { name: "JILI", image: homePage + image8.src },
  { name: "Ask Me Bet", image: homePage + image9.src },
  { name: "New Game", image: homePage + image10.src },
  { name: "JOKER", image: homePage + image11.src },
  { name: "AFB Gaming", image: homePage + image12.src },
];
---

<script type="application/ld+json" set:html={JSON.stringify(gameList)} />
<MainLayout
  title="ทดลองเล่นเกมฟรี PAY69 โหมดทดลองไม่ใช้เงินจริง ดูรูปแบบเกมก่อนเล่นจริง"
  description="ทดลองเล่นเกมฟรีของ PAY69 ในโหมดทดลองที่ไม่ใช้เงินจริง ใช้ดูรูปแบบเกม ฟีเจอร์ รอบโบนัส และจังหวะการเล่นของสล็อตและเกมค่ายดังก่อนตัดสินใจเล่นจริง พร้อมสิ่งที่ควรรู้ว่าโหมดทดลองบอกอะไรได้และบอกอะไรไม่ได้">
  <Announcement />

  <ContentBox title="ทดลองเล่นเกมฟรีของ PAY69 ลองก่อนได้ ไม่ต้องใช้เงินจริง">
    <h2 class="mb-6 bg-gradient-to-r from-white via-amber-100 to-amber-300 bg-clip-text text-2xl leading-normal font-bold text-transparent">โหมดทดลองของ PAY69 มีไว้ทำอะไร และเหมาะกับใคร</h2>

    <p class="mb-8 text-left text-base leading-relaxed text-amber-50/85">
      PAY69 รวมเกมไว้หลายหมวด ทั้งสล็อต กีฬา เกม Live สด และเดิมพันด้านการเงิน โหมดทดลองจึงมีไว้ให้ลองกดดูรูปแบบเกมก่อนว่าหน้าตาเป็นอย่างไร มีไลน์จ่ายกี่แบบ ฟีเจอร์พิเศษทำงานตอนไหน และรอบโบนัสมาบ่อยแค่ไหน โดยไม่ต้องใช้เงินจริงและไม่มีการได้เสียใด ๆ
      เหมาะกับสมาชิกใหม่ที่ยังไม่คุ้นกับปุ่มปรับเดิมพัน ระบบสปินอัตโนมัติ หรืออยากเทียบเกมหลายค่ายให้จบในรอบเดียว ก่อนตัดสินใจว่าจะเอาเกมไหนไปเล่นจริง
    </p>

    <div class="mb-5 grid grid-cols-2 gap-5 sm:grid-cols-2 md:grid-cols-4">
      {
        demoGames.map((game) => (
          <div class="group relative flex flex-col gap-4 overflow-hidden rounded-xl">
            <Picture
              src={game.src}
              alt={game.alt}
              loading="lazy"
              fetchpriority="low"
              widths={[200, 400, 600]}
              sizes="(max-width: 768px) 100vw, 25vw"
              class="mx-auto h-auto w-full max-w-[400px] object-cover shadow-xl transition-transform duration-300 group-hover:scale-105"
              decoding="async"
              formats={["avif", "webp"]}
              fallbackFormat="webp"
              quality={60}
            />
            <a
              href={game.link}
              target="_blank"
              rel="noopener noreferrer"
              aria-label={`ทดลองเล่น ${game.alt}`}
              class="absolute inset-0 flex items-center justify-center bg-[#0a0714]/70 opacity-0 transition-opacity duration-300 group-hover:opacity-100">
              <span class="rounded-full border border-amber-200/60 bg-gradient-to-r from-amber-300 to-amber-500 px-6 py-2 font-bold text-[#1a1130] shadow-[0_10px_30px_rgba(212,162,74,0.5)] transition-transform hover:scale-110">เล่นเลย</span>
            </a>
          </div>
        ))
      }
    </div>

    <h2 class="mt-8 mb-6 bg-gradient-to-r from-white via-amber-100 to-amber-300 bg-clip-text text-2xl leading-normal font-bold text-transparent">โหมดทดลองบอกอะไรได้ และบอกอะไรไม่ได้</h2>

    <p class="mb-4 text-left text-base leading-relaxed text-amber-50/85">
      โหมดทดลองบอกได้ว่าเกมเล่นอย่างไร ฟีเจอร์อยู่ตรงไหน และจังหวะเกมถูกใจหรือเปล่า แต่เครดิตในโหมดนี้เป็นยอดสมมติ ไม่สามารถถอนได้ และไม่ได้การันตีผลตอนเล่นจริง ก่อนสลับไปเล่นด้วยเงินจริงควรอ่านกติกา อัตราจ่าย และวงเงินเดิมพันของเกมนั้นอีกรอบ
      ส่วนใครที่ตั้งใจจะรับสิทธิ์อย่างฝากปุ๊บเพิ่ม 5% หรือเครดิตฟรีกดรับเอง ให้ตรวจยอดเทิร์น เพดานถอน วันหมดอายุ และรายชื่อเกมที่โปรนั้นรองรับก่อน เพราะบางเกมที่สนุกในโหมดทดลอง อาจไม่ได้อยู่ในลิสต์ที่นับยอดให้
    </p>

    <p class="mb-2 text-left text-base leading-relaxed text-amber-50/85">
      ถ้าหน้าเกมโหลดไม่สมบูรณ์หรือค้างกลางคัน ไม่ควรกดยืนยันซ้ำทันที ให้ตรวจประวัติรายการก่อน เพื่อกันการเดิมพันซ้ำโดยไม่ตั้งใจ และควรเข้าเกมผ่านหน้าเว็บหรือ PAY69 App ที่เป็นช่องทางจริงเท่านั้น ไม่ใช่ลิงก์ที่ส่งต่อกันมาในข้อความส่วนตัว
    </p>
  </ContentBox>

  <Navfoot />
</MainLayout>
