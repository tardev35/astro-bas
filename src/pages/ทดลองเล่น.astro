---
import MainLayout from "../layouts/MainLayout.astro";
import ContentBox from "../components/ContentBox.astro";
import Navfoot from "../components/Navfoot.astro";
import Announcement from "../components/Announcement5.astro";

import { Picture } from "astro:assets";
import image1 from "../assets/gamedemo7.webp";
import image2 from "../assets/gamedemo8.webp";
import image3 from "../assets/gamedemo9.webp";
import image4 from "../assets/gamedemo10.webp";
import image5 from "../assets/gamedemo11.webp";
import image6 from "../assets/gamedemo12.webp";
import image7 from "../assets/gamedemo13.webp";
import image8 from "../assets/gamedemo14.webp";
import image9 from "../assets/gamedemo15.webp";
import image10 from "../assets/gamedemo16.webp";
import image11 from "../assets/gamedemo17.webp";
import image12 from "../assets/gamedemo18.webp";

const demoGames = [
  { id: 1, src: image1, alt: "ทดลองเล่นเกม AskmeSlot ที่ BUNNY555", link: "/register" },
  { id: 2, src: image2, alt: "ทดลองเล่นเกมยอดนิยมที่ BUNNY555", link: "/register" },
  { id: 3, src: image3, alt: "ทดลองเล่นเกม SlotXO ที่ BUNNY555", link: "/register" },
  { id: 4, src: image4, alt: "ทดลองเล่นเกม Skywind Group ที่ BUNNY555", link: "/register" },
  { id: 5, src: image5, alt: "ทดลองเล่นเกม PG Soft ที่ BUNNY555", link: "/register" },
  { id: 6, src: image6, alt: "ทดลองเล่นเกม SBOBET ที่ BUNNY555", link: "/register" },
  { id: 7, src: image7, alt: "ทดลองเล่นเกม Sexy Slot ที่ BUNNY555", link: "/register" },
  { id: 8, src: image8, alt: "ทดลองเล่นเกม JILI ที่ BUNNY555", link: "/register" },
  { id: 9, src: image9, alt: "ทดลองเล่นเกม Ask Me Bet ที่ BUNNY555", link: "/register" },
  { id: 10, src: image10, alt: "ทดลองเล่นเกมใหม่ที่ BUNNY555", link: "/register" },
  { id: 11, src: image11, alt: "ทดลองเล่นเกม JOKER Gaming ที่ BUNNY555", link: "/register" },
  { id: 12, src: image12, alt: "ทดลองเล่นเกม AFB Gaming ที่ BUNNY555", link: "/register" },
];
const homePage = "https://bunny555-game.com";
const gameNames = ["AskmeSlot", "Popular Game", "SlotXO", "Skywind Group", "PG Soft", "SBOBET", "Sexy Slot", "JILI", "Ask Me Bet", "New Game", "JOKER Gaming", "AFB Gaming"];

const demoGameListSchema = {
  "@context": "https://schema.org",
  "@type": "ItemList",
  name: "ทดลองเล่นเกมฟรีที่ BUNNY555",
  description: "รายชื่อเกมในโหมดทดลองเล่นฟรีของ BUNNY555 เว็บตรงอันดับ 1 ระบบเสถียรขั้นสุด ลื่นไหลไม่มีสะดุด",
  url: homePage + "/ทดลองเล่น",
  numberOfItems: demoGames.length,
  itemListElement: demoGames.map((game, index) => ({
    "@type": "ListItem",
    position: index + 1,
    item: {
      "@type": "VideoGame",
      name: gameNames[index],
      image: homePage + game.src.src,
      url: homePage + "/ทดลองเล่น",
      playMode: "SinglePlayer",
      gamePlatform: ["Web Browser", "iOS", "Android"],
      publisher: {
        "@type": "Organization",
        name: "BUNNY555",
        url: homePage,
      },
    },
  })),
};
---

<script type="application/ld+json" set:html={JSON.stringify(demoGameListSchema)} />
<MainLayout
  title="BUNNY555 ทดลองเล่นฟรี ระบบเสถียร สัมผัสเกมดังระดับโลก" description="โหมดทดลองเล่นฟรีบนแพลตฟอร์ม BUNNY555 สัมผัสความรวดเร็วและ ระบบเสถียร ขั้นสุด เรียนรู้ฟีเจอร์เกมล้ำสมัยก่อนใครได้อย่างอิสระ ไม่มีค่าใช้จ่าย">
  <Announcement />

  <ContentBox title="ทดลองเล่นเกมฟรีกับ BUNNY555 สัมผัสเกมดังระดับโลกก่อนใคร">
    <div>
      <h2 class="mb-6 bg-gradient-to-r from-white via-pink-100 to-pink-300 bg-clip-text text-2xl leading-normal font-bold text-transparent">โหมดทดลองของ BUNNY555 มีไว้ทำอะไร และเหมาะกับใคร</h2>

      <p class="mb-8 text-left text-base leading-relaxed text-pink-50/85">
        BUNNY555 รวบรวมซอฟต์แวร์คุณภาพจากทั่วโลกมาไว้ในที่เดียว ทั้ง PG Soft ที่แอนิเมชันไหลลื่นและกราฟิกสดใส Pragmatic Play ที่ฟีเจอร์ทันสมัยตอบสนองฉับไว และ JOKER Gaming ที่ผสานความคลาสสิกเข้ากับเสถียรภาพของเซิร์ฟเวอร์ยุคใหม่ โหมดทดลองเปิดให้คุณกดเข้าไปสำรวจได้อย่างอิสระโดยไม่มีค่าใช้จ่าย
        เหมาะกับผู้ที่ต้องการเรียนรู้ฟีเจอร์ล้ำสมัยก่อนใคร อยากดูว่ารอบโบนัสมาบ่อยแค่ไหน หรืออยากเทียบเกมหลายค่ายให้จบในรอบเดียว โดยได้สัมผัสความเร็วในการประมวลผลจริงของแพลตฟอร์มไปพร้อมกัน
      </p>

      <div class="mb-5 grid grid-cols-2 gap-5 sm:grid-cols-2 md:grid-cols-4">
        {
          demoGames.map((game) => (
            <div class="group/game relative mx-auto w-full max-w-[400px] overflow-hidden rounded-xl">
              <Picture
                src={game.src}
                alt={game.alt}
                loading="lazy"
                fetchpriority="low"
                widths={[200, 400, 600]}
                sizes="(max-width: 768px) 100vw, 25vw"
                class="block h-auto w-full object-cover shadow-xl transition-transform duration-300 group-hover/game:scale-105"
                decoding="async"
                formats={["avif", "webp"]}
                fallbackFormat="webp"
                quality={60}
              />
              <a
                href={game.link}
                target="_blank"
                rel="noopener noreferrer"
                aria-label={`ทดลองเล่น ${game.alt}`}
                class="absolute inset-0 flex items-center justify-center bg-[#0a0305]/70 opacity-0 transition-opacity duration-300 group-hover/game:opacity-100 focus-visible:opacity-100">
                <span class="rounded-full border border-pink-200/60 bg-gradient-to-r from-pink-300 to-pink-500 px-6 py-2 font-bold text-[#241019] shadow-[0_10px_30px_rgba(236,72,153,0.5)] transition-transform hover:scale-110">เล่นเลย</span>
              </a>
            </div>
          ))
        }
      </div>

      <h2 class="mt-8 mb-6 bg-gradient-to-r from-white via-pink-100 to-pink-300 bg-clip-text text-2xl leading-normal font-bold text-transparent">โหมดทดลองบอกอะไรได้ และบอกอะไรไม่ได้</h2>

      <p class="mb-4 text-left text-base leading-relaxed text-pink-50/85">
        โหมดทดลองบอกได้ว่าเกมเล่นอย่างไร ฟีเจอร์อยู่ตรงไหน และจังหวะเกมถูกใจหรือเปล่า อีกทั้งยังเป็นบททดสอบชั้นดีของ ระบบเสถียร ขั้นสุดที่เราวางไว้บน Cloud Server เพราะคุณจะเห็นเองว่าภาพไม่ค้างและระบบไม่หน่วงแม้เปิดสลับหลายเกมติดกัน
        แต่เครดิตในโหมดนี้เป็นยอดสมมติ ถอนไม่ได้ และไม่ได้การันตีผลตอนเล่นจริง ก่อนสลับไปเล่นด้วยเงินจริงจึงควรอ่านกติกา อัตราจ่าย และวงเงินเดิมพันของเกมนั้นอีกรอบ ส่วนใครที่ตั้งใจจะกด รับโปรโมชั่นสุดคุ้ม ผ่านระบบออโต้ ให้ดูรายละเอียดของแต่ละแคมเปญให้ครบก่อนกดรับ
      </p>

      <p class="mb-2 text-left text-base leading-relaxed text-pink-50/85">
        เมื่อพร้อมเล่นจริง ขั้นตอนถัดไปก็ง่ายดายไม่แพ้กัน เพราะ BUNNY555 นำเทคโนโลยี AI มาช่วยจัดการระบบฐานข้อมูล ทำให้ สมัครง่าย ในคลิกเดียวและเข้าถึงแดชบอร์ดส่วนตัวได้ทันที ทั้งนี้ควรเข้าเกมผ่านหน้าเว็บที่เป็นช่องทางจริงเท่านั้น ไม่ใช่ลิงก์ที่ส่งต่อกันมาในข้อความส่วนตัว
      </p>
    </div>
  </ContentBox>

  <Navfoot />
</MainLayout>
