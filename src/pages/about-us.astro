---
import MainLayout from "../layouts/MainLayout.astro";
import ContentBox from "../components/ContentBox.astro";
import Navfoot from "../components/Navfoot.astro";
import Announcement from "../components/Announcement5.astro";
import { pageGraph } from "../lib/schema";

// The brief supplies no title/meta for this page, so both are written here.
// 158 CHARACTERS (Thai is 3 bytes/char — a byte count reads ~3x too long).
const pageDescription =
  "ทำความรู้จัก BUNNY555 เว็บสล็อตลิขสิทธิ์แท้ ที่รวมค่ายเกมชั้นนำ Play'n GO Red Tiger และ Blueprint Gaming ไว้ที่เดียว เล่นง่าย ได้เงินไว ดูแลด้วย บริการ 24 ชม.";

const graph = pageGraph(Astro, {
  type: "AboutPage",
  name: "เกี่ยวกับเรา BUNNY555 เว็บสล็อตลิขสิทธิ์แท้ เล่นง่าย ได้เงินไว บริการ 24 ชม.",
  description: pageDescription,
  breadcrumb: [
    { name: "หน้าแรก", path: "/" },
    { name: "เกี่ยวกับเรา", path: "/about-us" },
  ],
});
---

<MainLayout title="BUNNY555 เกี่ยวกับเรา เว็บสล็อตลิขสิทธิ์แท้ เล่นง่าย ได้เงินไว บริการ 24 ชม." description={pageDescription}>
  <script type="application/ld+json" set:html={graph} />

  <Announcement />

  <ContentBox title="เกี่ยวกับเรา BUNNY555" as="h1">
    <p class="text-left text-base leading-relaxed text-[#ffdcea]">
      <strong class="text-[#ff4d9d]">BUNNY555</strong> เกิดขึ้นจากความตั้งใจเดียว คือทำให้การเข้าถึงเกมคุณภาพระดับโลกเป็นเรื่องง่ายสำหรับคนไทยทุกกลุ่ม
      เราวางตัวเองเป็น เว็บสล็อตลิขสิทธิ์แท้ ที่รับเกมตรงจากผู้พัฒนา ไม่ผ่านตัวกลางที่ปรับค่าอะไรได้ระหว่างทาง และออกแบบหน้าเว็บทั้งหมดให้ เล่นง่าย ตั้งแต่ครั้งแรกที่เปิดเข้ามา
      สิ่งที่เราวัดผลกันจริงจึงไม่ใช่จำนวนแบนเนอร์ที่ปล่อยออกไปในแต่ละเดือน แต่เป็นความนิ่งของระบบในชั่วโมงที่คนเข้าใช้งานพร้อมกันมากที่สุด ความเร็วของการโอนที่ทำให้สมาชิก ได้เงินไว จริงตามที่บอก
      และคุณภาพของการดูแลผ่าน บริการ 24 ชม. ที่ยืนระยะได้ทุกวัน
    </p>
  </ContentBox>

  <ContentBox title="ค่ายเกมลิขสิทธิ์แท้ที่ BUNNY555 คัดมาไว้ในที่เดียว" as="h2">
    <p class="text-left text-base leading-relaxed text-[#ffdcea]">
      เราไม่ได้เปิดรับทุกค่ายที่ยื่นเข้ามา แต่คัดเฉพาะผู้พัฒนาที่มีลิขสิทธิ์ชัดเจนและได้มาตรฐานระดับสากล แกนหลักของ <strong class="text-[#ff4d9d]">BUNNY555</strong> ในวันนี้คือ Play'n GO
      ที่โดดเด่นด้วยเนื้อเรื่องน่าติดตามและกลไกการจ่ายที่หลากหลาย เปิดโอกาสทำกำไรแบบก้าวกระโดดในทุกสปิน Red Tiger ที่มาพร้อมภาพแอนิเมชันลื่นไหลตระการตา ฟีเจอร์ตัวคูณและแจ็กพอตที่แตกง่ายแตกบ่อย
      และ Blueprint Gaming เจ้าของกลไก Megaways ที่เส้นทางการจ่ายเงินมหาศาล ระบบเสถียร โหลดไว ทั้งสามค่ายเชื่อมต่อผ่าน API โดยตรง อัตราการชนะจึงเป็นค่าเดียวกับที่ค่ายกำหนดไว้ ไม่มีการปรับลดระหว่างทาง
      และทุกเกมผ่านการทดสอบเสถียรภาพบนเครือข่ายมือถือของไทยก่อนขึ้นระบบจริง เพราะกราฟิกที่สวยแต่โหลดสะดุดกลางรอบโบนัส คือสิ่งที่ทำให้ผู้เล่นเสียความรู้สึกมากกว่าผลของรอบนั้นเสียอีก
    </p>
  </ContentBox>

  <ContentBox title="ระบบที่ออกแบบมาให้ เล่นง่าย ตั้งแต่หน้าแรก" as="h2">
    <p class="text-left text-base leading-relaxed text-[#ffdcea]">
      ไม่ว่าคุณจะเป็นมือใหม่ที่เพิ่งเปิดยูสเซอร์แรกหรือมือโปรที่หมุนมาแล้วหลายปี อินเทอร์เฟซของ <strong class="text-[#ff4d9d]">BUNNY555</strong> ถูกจัดวางให้เป็นสัดส่วนและอ่านจบได้ในหน้าเดียว
      เมนูฝาก ถอน รับสิทธิ์ และประวัติรายการอยู่ห่างจากหน้าแรกไม่เกินสองคลิก ค้นหาเกมได้จากชื่อค่ายหรือชื่อเกมโดยตรง และทุกอย่างทำงานบนเบราว์เซอร์มือถือได้เท่ากับบนคอมพิวเตอร์ ไม่ต้องติดตั้งแอปเพิ่ม
      เราตัดขั้นตอนที่ไม่จำเป็นออกไปเรื่อย ๆ ทุกครั้งที่พบว่าสมาชิกต้องถามทีมงานเพื่อทำสิ่งเดิมซ้ำ เพราะคำถามที่เกิดซ้ำคือสัญญาณว่าหน้าจอยังอธิบายตัวเองได้ไม่ดีพอ ไม่ใช่ความผิดของคนถาม
    </p>
  </ContentBox>

  <ContentBox title="เทคโนโลยีออโต้ที่ทำให้ ได้เงินไว ในทุกบิล" as="h2">
    <p class="text-left text-base leading-relaxed text-[#ffdcea]">
      เราเข้าใจดีว่าเวลาคือสิ่งมีค่า ระบบประมวลผลของ <strong class="text-[#ff4d9d]">BUNNY555</strong> จึงทำงานอัตโนมัติเต็มรูปแบบ เพียงทำรายการฝากหรือถอน เครดิตจะถูกอัปเดตเข้าบัญชีทันทีโดยไม่ต้องรอ
      ไม่ต้องแนบสลิป และไม่ต้องรอรอบตรวจของทีมงาน โบนัสและเงินคืนก็เดินอยู่บนระบบเดียวกัน สมาชิกกดรับสิทธิ์เองได้จากแดชบอร์ดส่วนตัวตลอดเวลา ทุกรายการมีประวัติให้ตรวจย้อนหลังได้ทีละบิล
      เราตั้งใจให้ตัวเลขที่เห็นบนหน้าธุรกรรมตรงกับยอดในบัญชีเสมอ เพราะความเร็วจะมีความหมายก็ต่อเมื่อมันตรวจสอบได้
    </p>
  </ContentBox>

  <ContentBox title="บริการ 24 ชม. ที่ดูแลตั้งแต่ก้าวแรก" as="h2">
    <p class="text-left text-base leading-relaxed text-[#ffdcea]">
      ทีมซัพพอร์ตของ <strong class="text-[#ff4d9d]">BUNNY555</strong> ผ่านการอบรมมาอย่างดีเยี่ยม พร้อมสแตนด์บายคอยช่วยเหลือและให้คำปรึกษาตลอดเวลา ไม่ว่าจะเป็นคำถามเรื่องการใช้งาน เงื่อนไขการรับสิทธิ์
      หรือรายการที่ต้องตรวจสอบย้อนหลัง ติดต่อได้ทั้งช่องทางแชตบนหน้าเว็บและ LINE Official ไม่มีวันหยุด ตัวเลขที่เราถือเป็นตัวชี้วัดจริงคือเวลาที่ใช้ตอบกลับครั้งแรก
      และจำนวนเรื่องที่ปิดจบได้ในการติดต่อเพียงครั้งเดียว มากกว่าจำนวนข้อความที่ตอบออกไปทั้งหมด นี่คือความหมายของ บริการ 24 ชม. ที่เรามอบให้ทุกคนเท่ากัน ไม่ใช่สิทธิพิเศษที่สงวนไว้ให้สมาชิกบางกลุ่ม
    </p>
  </ContentBox>

  <ContentBox title="ความปลอดภัยของทุกการเชื่อมต่อบน BUNNY555" as="h2">
    <p class="text-left text-base leading-relaxed text-[#ffdcea]">
      ความน่าเชื่อถือเป็นสิ่งที่สร้างยากและพังง่าย เราจึงเข้ารหัสฐานข้อมูลและการเชื่อมต่อทั้งหมดด้วยมาตรฐานเดียวกับที่สถาบันการเงินใช้ และให้การเข้าสู่ระบบทำงานผ่าน Secure Transition Popup
      ที่เปิดแดชบอร์ดขึ้นบนหน้าเดิม แทนการพาเด้งข้ามหน้าเว็บไปมา วิธีนี้โหลดไว ลื่นไหล ป้องกันการรีเฟรชหน้าเว็บซ้ำซ้อน และตัดจังหวะที่ลิงก์ปลอมมักแทรกตัวเข้ามาออกไป
      ทำให้ทุกการเชื่อมต่อของคุณเป็นส่วนตัวและปลอดภัยในระดับสูงสุด อีกข้อที่อยากให้จำไว้เสมอคือทีมงานของ <strong class="text-[#ff4d9d]">BUNNY555</strong> จะไม่ขอรหัสผ่านหรือรหัส OTP
      จากสมาชิกไม่ว่ากรณีใด ใครก็ตามที่ทักมาขอสองสิ่งนี้ ไม่ใช่คนของเรา
    </p>
  </ContentBox>

  <Navfoot />
</MainLayout>
