---
import MainLayout from "../layouts/MainLayout.astro";
import ContentBox from "../components/ContentBox.astro";
import Navfoot from "../components/Navfoot.astro";
import Announcement from "../components/Announcement3.astro";
import { pageGraph } from "../lib/schema";

// The brief supplies no title/meta for this page, so both are written here.
// 152 CHARACTERS (Thai is 3 bytes/char — a byte count reads ~3x too long).
const pageDescription =
  "ทำความรู้จัก DEVA555 สล็อตเว็บตรงอันดับ 1 ที่รวมค่ายเกมระดับโลกทั้ง PG Soft Pragmatic Play และ JILI ขับเคลื่อนด้วย ฝากถอนออโต้ไว 3 วิ และ รองรับทรูวอเลท";

const graph = pageGraph(Astro, {
  type: "AboutPage",
  name: "เกี่ยวกับเรา DEVA555 สล็อตเว็บตรงอันดับ 1 ระดับทวยเทพ",
  description: pageDescription,
  breadcrumb: [
    { name: "หน้าแรก", path: "/" },
    { name: "เกี่ยวกับเรา", path: "/about-us" },
  ],
});
---

<MainLayout title="DEVA555 เกี่ยวกับเรา สล็อตเว็บตรงอันดับ 1 ระดับทวยเทพ" description={pageDescription}>
  <script type="application/ld+json" set:html={graph} />

  <Announcement />

  <ContentBox title="เกี่ยวกับเรา DEVA555" as="h1">
    <p class="text-left text-base leading-relaxed text-[#e9ddbe]">
      <strong class="text-[#fded9a]">DEVA555</strong> ถือกำเนิดขึ้นจากความตั้งใจเดียว คือทำให้ผู้เล่นไทยเข้าถึงเกมลิขสิทธิ์แท้ระดับโลกได้จากบัญชีเดียว
      โดยไม่ต้องแลกมาด้วยความยุ่งยากของระบบการเงินหรือความเสี่ยงเรื่องข้อมูลส่วนตัว เราวางตัวเองเป็น สล็อตเว็บตรงอันดับ 1 ที่ไม่ผ่านเอเย่นต์
      ทุกยอดฝากและยอดถอนวิ่งตรงเข้าระบบของเราเอง จึงตรวจสอบย้อนหลังได้ทุกบิล และไม่มีคนกลางมาถือเครดิตแทนสมาชิก
      ทีมงานเบื้องหลังแพลตฟอร์มมาจากสายพัฒนาซอฟต์แวร์และสายบริการลูกค้า ไม่ใช่สายการตลาดเพียงอย่างเดียว ตัวเลขที่เราวัดผลกันจริงจึงเป็นเวลาที่ใช้ต่อหนึ่งธุรกรรม
      จำนวนเรื่องที่ปิดจบได้ในการติดต่อครั้งเดียว และความนิ่งของระบบในชั่วโมงที่คนเข้าเล่นพร้อมกันมากที่สุด มากกว่าจำนวนแบนเนอร์ที่ปล่อยออกไปในแต่ละเดือน
    </p>
  </ContentBox>

  <ContentBox title="ค่ายเกมระดับโลกที่ DEVA555 คัดมาไว้ในบัญชีเดียว" as="h2">
    <p class="text-left text-base leading-relaxed text-[#e9ddbe]">
      เราไม่ได้เปิดรับทุกค่ายที่ยื่นเข้ามา แต่คัดเฉพาะผู้พัฒนาที่มีลิขสิทธิ์ชัดเจนและมีประวัติการจ่ายที่ตรวจสอบได้ แกนหลักของ
      <strong class="text-[#fded9a]">DEVA555</strong> ในวันนี้คือ PG Soft ที่โดดเด่นด้าน 3D แอนิเมชันและฟีเจอร์ซึ่งออกแบบมาให้แจกรางวัลอย่างต่อเนื่อง
      Pragmatic Play ที่กลไกการออกรางวัลโปร่งใส หนักหน่วง และเข้าถึงรอบแจ็กพอตได้ไว และ JILI ที่ตัวเกมเบา เสถียร เปิดบนสมาร์ทโฟนรุ่นไหนก็ยังลื่นไหล
      ทุกเกมถูกทดสอบเสถียรภาพบนเครือข่ายมือถือของไทยก่อนขึ้นระบบจริง เพราะกราฟิกที่สวยแต่โหลดสะดุดกลางรอบโบนัส
      คือสิ่งที่ทำให้ผู้เล่นเสียความรู้สึกมากกว่าผลของรอบนั้นเสียอีก
    </p>
  </ContentBox>

  <ContentBox title="เบื้องหลังระบบ ฝากถอนออโต้ไว 3 วิ ของ DEVA555" as="h2">
    <p class="text-left text-base leading-relaxed text-[#e9ddbe]">
      หัวใจของแพลตฟอร์มคือสถาปัตยกรรมทางการเงินที่ทำงานด้วย AI อัจฉริยะ ซึ่งอ่านรายการเข้าและปรับยอดเครดิตให้เองภายในสามวินาที
      โดยไม่ต้องแนบสลิปและไม่ต้องรอทีมงานกดอนุมัติทีละรายการ เราเลือกลงทุนกับส่วนนี้ก่อนส่วนอื่น เพราะมันคือจุดที่สมาชิกสัมผัสได้ทุกวัน
      ต่างจากโปรโมชั่นที่ได้ใช้เดือนละไม่กี่ครั้ง ระบบ ฝากถอนออโต้ไว 3 วิ ทำงานตลอด 24 ชั่วโมงรวมถึงวันหยุดธนาคาร และบันทึกทุกขั้นตอนไว้ให้ตรวจย้อนหลังได้
      หากรายการใดค้างผิดปกติ ระบบจะแจ้งเตือนทีมงานเองก่อนที่สมาชิกจะต้องทักเข้ามาถาม
    </p>
  </ContentBox>

  <ContentBox title="รองรับทรูวอเลท และช่องทางการเงินที่เปิดกว้าง" as="h2">
    <p class="text-left text-base leading-relaxed text-[#e9ddbe]">
      เราเปิดกว้างเรื่องช่องทางการเงินมาตั้งแต่วันแรก เพราะสมาชิกจำนวนมากไม่ได้ผูกชีวิตประจำวันไว้กับบัญชีธนาคารเพียงอย่างเดียว
      <strong class="text-[#fded9a]">DEVA555</strong> จึง รองรับทรูวอเลท อย่างเต็มรูปแบบ ควบคู่กับพร้อมเพย์และธนาคารหลักของไทย
      โอนถ่ายเครดิตได้ทุกที่ทุกเวลาแม้ไม่มีสมุดบัญชีติดตัว และทุกการเชื่อมต่อไม่มีการหักค่าธรรมเนียม โอนเข้ามาเท่าไรขึ้นเป็นเครดิตเท่านั้น
      ไม่มีส่วนต่างที่ต้องมานั่งไล่หาทีหลัง นี่คือความสะดวกที่เราตั้งใจให้เป็นเรื่องปกติของทุกบัญชี ไม่ใช่สิทธิพิเศษของสมาชิกบางกลุ่ม
    </p>
  </ContentBox>

  <ContentBox title="มาตรฐานความ ปลอดภัย 100% ผ่านระบบ Secure Popup" as="h2">
    <p class="text-left text-base leading-relaxed text-[#e9ddbe]">
      ความน่าเชื่อถือเป็นสิ่งที่สร้างยากและพังง่าย เราจึงเข้ารหัสฐานข้อมูลและการเชื่อมต่อทั้งหมดด้วยมาตรฐานเดียวกับที่สถาบันการเงินใช้
      และให้การเข้าสู่ระบบประมวลผลผ่าน Premium Secure Popup ที่เปิดแดชบอร์ดขึ้นบนหน้าเดิม แทนการพาเด้งข้ามหน้าเว็บไปมา
      วิธีนี้ตัดจังหวะที่ลิงก์ปลอมมักแทรกตัวเข้ามาออกไป และยังทำให้หน้าเว็บไม่ต้องโหลดซ้ำจนเสียเวลาของสมาชิก
      อีกข้อที่อยากให้จำไว้เสมอคือทีมงานของเราจะไม่ขอรหัสผ่านหรือรหัส OTP จากสมาชิกไม่ว่ากรณีใด ใครก็ตามที่ทักมาขอสองสิ่งนี้ ไม่ใช่คนของ
      <strong class="text-[#fded9a]">DEVA555</strong>
    </p>
  </ContentBox>

  <Navfoot />
</MainLayout>
