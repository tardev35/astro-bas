---
import MainLayout from "../layouts/MainLayout.astro";
import ContentBox from "../components/ContentBox.astro";
import Navfoot from "../components/Navfoot.astro";
import Announcement from "../components/Announcement3.astro";
import { pageGraph } from "../lib/schema";

// The brief supplies no title/meta for this page, so both are written here in
// the docx's own voice and vocabulary — no licence, founding year, member count
// or award, because the brief claims none of those.
// 159 CHARACTERS (Thai is 3 bytes/char — a byte count reads ~3x too long).
const pageDescription =
  "ทำความรู้จัก ROMAN555 ทางเข้าหลักเว็บตรง ที่รวมความบันเทิงจาก ค่ายใหญ่ลิขสิทธิ์แท้ ระดับโลกไว้ที่เดียว ระบบการเงิน รองรับทรูวอเลท ปลอดภัยด้วยการเข้ารหัสขั้นสูง";

const graph = pageGraph(Astro, {
  type: "AboutPage",
  name: "เกี่ยวกับเรา ROMAN555 ทางเข้าหลักเว็บตรง ค่ายใหญ่ลิขสิทธิ์แท้ รองรับทรูวอเลท",
  description: pageDescription,
  breadcrumb: [
    { name: "หน้าแรก", path: "/" },
    { name: "เกี่ยวกับเรา", path: "/about-us" },
  ],
});
---

<MainLayout title="ROMAN555 เกี่ยวกับเรา ทางเข้าหลักเว็บตรง ค่ายใหญ่ลิขสิทธิ์แท้ รองรับทรูวอเลท" description={pageDescription}>
  <script type="application/ld+json" set:html={graph} />

  <Announcement />

  <ContentBox title="เกี่ยวกับเรา ROMAN555" as="h1">
    <p class="text-left text-base leading-relaxed text-[#f2e4c4]">
      <strong class="text-[#f6cf6a]">ROMAN555</strong> คือ ทางเข้าหลักเว็บตรง ที่พร้อมเปิดประตูสู่ขุมทรัพย์แห่งความมั่งคั่งระดับตำนาน
      แพลตฟอร์มของเราถูกสร้างขึ้นด้วยรากฐานระบบที่แข็งแกร่ง นำเสนอความบันเทิงเหนือระดับจาก ค่ายใหญ่ลิขสิทธิ์แท้ ที่ส่งตรงถึงหน้าจอคุณ
      และมอบความสะดวกสบายสูงสุดด้วยเทคโนโลยีทางการเงินที่ รองรับทรูวอเลท อย่างเต็มรูปแบบ
      สิ่งที่เรายึดถือจึงไม่ใช่จำนวนแบนเนอร์ที่ปล่อยออกไปในแต่ละเดือน แต่เป็นความลื่นไหลของระบบ ความมั่นคงของการเงิน
      และความปลอดภัยในทุกมิติของการใช้งาน เพื่อให้ทุกการลงทุนของคุณเดินหน้าได้อย่างต่อเนื่องและกวาดผลกำไรได้อย่างอิสระ
    </p>
  </ContentBox>

  <ContentBox title="ศูนย์รวมความบันเทิงจาก ค่ายใหญ่ลิขสิทธิ์แท้ ระดับโลก" as="h2">
    <p class="text-left text-base leading-relaxed text-[#f2e4c4]">
      การเดิมพันบนแพลตฟอร์ม <strong class="text-[#f6cf6a]">ROMAN555</strong> คือการสัมผัสประสบการณ์ที่เหนือกว่า
      ด้วยการรวบรวมซอฟต์แวร์เกมมาตรฐานสากลมาไว้ในที่เดียว ทุกเกมบนอาณาจักรแห่งนี้ผ่านการรับรองความโปร่งใส
      มอบกราฟิกที่ตระการตาและอัตราการจ่ายผลตอบแทนที่ยุติธรรม ให้คุณกอบโกยรางวัลได้อย่างไร้ขีดจำกัด
      แกนหลักของเราคือ Microgaming ผู้บุกเบิกเทคโนโลยีซอฟต์แวร์ที่แข็งแกร่งที่สุด นำเสนอระบบเกมที่มีเสถียรภาพสูง
      พร้อมเครือข่ายแจ็กพอตที่พร้อมเปลี่ยนให้คุณกลายเป็นมหาเศรษฐีในชั่วข้ามคืน NetEnt ที่ให้สัมผัสความยิ่งใหญ่ผ่านแอนิเมชันระดับพรีเมียม
      กลไกการออกรางวัลถูกออกแบบมาอย่างแยบยล ช่วยให้ลุ้นรอบโบนัสได้อย่างต่อเนื่องและคุ้มค่า และ Novomatic
      ที่ส่งมอบความสนุกผ่านรูปแบบเกมเพลย์สุดคลาสสิกที่ทรงพลัง อัตราการคูณเงินรางวัลสูง โหลดไว ตอบสนองดีเยี่ยมบนทุกอุปกรณ์
    </p>
  </ContentBox>

  <ContentBox title="ระบบการเงินที่ รองรับทรูวอเลท อย่างเต็มรูปแบบ" as="h2">
    <p class="text-left text-base leading-relaxed text-[#f2e4c4]">
      เพื่อการตอบสนองที่ฉับไวเหนือใคร ระบบการเงินของ <strong class="text-[#f6cf6a]">ROMAN555</strong>
      ได้รับการพัฒนาให้เชื่อมต่อกับกระเป๋าเงินดิจิทัลโดยตรง โครงสร้างนี้ รองรับทรูวอเลท อย่างเต็มรูปแบบ
      ช่วยให้สมาชิกทำรายการฝากและถอนได้อย่างอิสระเสรี ไม่ต้องพึ่งพาบัญชีธนาคารแบบเดิมๆ ยอดเงินอัปเดตไวในเสี้ยววินาที
      มอบสภาพคล่องสูงสุดในทุกจังหวะการทำกำไร นี่คือเหตุผลที่เราให้ความสำคัญกับความเร็วของการโอนมากกว่าตัวเลขสรุปรายเดือน
      เพราะจังหวะที่สมาชิกอยากลงทุนต่อ คือจังหวะที่ยอดเงินต้องพร้อมใช้งานทันที
    </p>
  </ContentBox>

  <ContentBox title="ความปลอดภัยของ ทางเข้าหลักเว็บตรง และ Secure Transition Popup" as="h2">
    <p class="text-left text-base leading-relaxed text-[#f2e4c4]">
      ความน่าเชื่อถือคือรากฐานที่สำคัญที่สุด ผู้ใช้งาน <strong class="text-[#f6cf6a]">ROMAN555</strong>
      จึงมั่นใจได้ว่าข้อมูลส่วนบุคคลและยอดเครดิตของคุณจะได้รับการปกป้องด้วยระบบเข้ารหัสขั้นสูง
      นอกจากนี้ การเปลี่ยนหน้าเข้าสู่ระบบยังประมวลผลผ่าน Secure Transition Popup Modal ที่ป้องกันการรีเฟรชหน้าเว็บซ้ำซ้อน
      ช่วยให้ ทางเข้าหลักเว็บตรง ของเรามีความปลอดภัย มั่นคง และเป็นส่วนตัว 100%
      หน้าต่างนี้เปิดขึ้นบนหน้าเดิมแทนการพาเด้งข้ามหน้าเว็บไปมา จึงตัดจังหวะที่ลิงก์แปลกปลอมมักแทรกตัวเข้ามาระหว่างทางออกไปได้
    </p>
  </ContentBox>

  <ContentBox title="สิทธิพิเศษและโปรโมชั่นที่กดรับเองได้ผ่านระบบออโต้" as="h2">
    <p class="text-left text-base leading-relaxed text-[#f2e4c4]">
      เพื่อเป็นการเสริมสร้างความแข็งแกร่งให้กับเงินทุนของคุณ <strong class="text-[#f6cf6a]">ROMAN555</strong>
      จึงได้เตรียมแคมเปญและโบนัสสนับสนุนเอาไว้อย่างมากมาย สมาชิกสามารถกดยอมรับสิทธิพิเศษต่างๆ ได้ด้วยตนเองผ่านเมนูอัตโนมัติ
      นำไปใช้ต่อยอดความสำเร็จและเพิ่มขีดความสามารถในการเดิมพันให้กว้างไกลยิ่งขึ้น
      รายละเอียดของแต่ละแคมเปญ ทั้งยอดที่ได้รับ รอบการคำนวณ และเงื่อนไขการรับสิทธิ์ อยู่บนหน้าโปรโมชั่นครบทั้งหมด
      จึงเลือกรับเฉพาะรายการที่ตรงกับรูปแบบการเล่นของตัวเองได้อย่างอิสระ
    </p>
  </ContentBox>

  <Navfoot />
</MainLayout>
