---
import MainLayout from "../layouts/MainLayout.astro";
import ContentBox from "../components/ContentBox.astro";
import Navfoot from "../components/Navfoot.astro";
import Announcement from "../components/Announcement3.astro";
import { pageGraph } from "../lib/schema";

// The brief supplies no title/meta for this page, so both are written here in
// the docx's own voice and vocabulary.
// 156 CHARACTERS (Thai is 3 bytes/char — a byte count reads ~3x too long).
const pageDescription =
  "ทำความรู้จัก GARUDA369 สล็อตเว็บใหญ่ เว็บตรงไม่ผ่านเอเย่นต์ ที่รวมเกมลิขสิทธิ์แท้ระดับโลก ขับเคลื่อนด้วยระบบออโต้ พร้อมโปรจัดเต็ม ทำเงินได้จริง ปลอดภัย 100%";

const graph = pageGraph(Astro, {
  type: "AboutPage",
  name: "เกี่ยวกับเรา GARUDA369 สล็อตเว็บใหญ่ เว็บตรงไม่ผ่านเอเย่นต์ ระบบออโต้",
  description: pageDescription,
  breadcrumb: [
    { name: "หน้าแรก", path: "/" },
    { name: "เกี่ยวกับเรา", path: "/about-us" },
  ],
});
---

<MainLayout title="GARUDA369 เกี่ยวกับเรา สล็อตเว็บใหญ่ เว็บตรงไม่ผ่านเอเย่นต์ ระบบออโต้" description={pageDescription}>
  <script type="application/ld+json" set:html={graph} />

  <Announcement />

  <ContentBox title="เกี่ยวกับเรา GARUDA369" as="h1">
    <p class="text-left text-base leading-relaxed text-[#dcefc2]">
      <strong class="text-[#7bbb0b]">GARUDA369</strong> ถูกสร้างขึ้นมาเพื่อตอบสนองนักเดิมพันที่ต้องการความเป็นเลิศ เราวางตัวเองเป็น สล็อตเว็บใหญ่ แบบ เว็บตรงไม่ผ่านเอเย่นต์
      ที่เชื่อมต่อกับเซิร์ฟเวอร์หลักโดยตรง ไม่มีคนกลางมาคั่นระหว่างสมาชิกกับเกม และตั้งใจให้แพลตฟอร์มนี้เป็นแหล่งทำเงินที่ดีที่สุดสำหรับนักลงทุนยุคใหม่
      สามเสาหลักที่เรายึดมาตลอดคือ ระบบออโต้ ที่รวดเร็วและแม่นยำ โปรจัดเต็ม ที่กดรับเองได้โดยไม่ต้องรอใครอนุมัติ และความปลอดภัยที่ทำให้ทุกยอดถอนออกได้ครบทุกบาท
      สิ่งที่เราวัดผลกันจริงจึงไม่ใช่จำนวนแบนเนอร์ที่ปล่อยออกไปในแต่ละเดือน แต่เป็นความนิ่งของระบบในชั่วโมงที่คนเข้าใช้งานพร้อมกันมากที่สุด
      ความเร็วของการโอนที่ทำให้สมาชิกได้เงินไวจริงตามที่บอก และคุณภาพของการดูแลตลอด 24 ชั่วโมงที่ยืนระยะได้ทุกวัน
    </p>
  </ContentBox>

  <ContentBox title="เกมลิขสิทธิ์แท้ ที่ GARUDA369 คัดมาไว้ในที่เดียว" as="h2">
    <p class="text-left text-base leading-relaxed text-[#dcefc2]">
      เราไม่ได้เปิดรับทุกค่ายที่ยื่นเข้ามา แต่คัดเฉพาะผู้พัฒนาที่มีลิขสิทธิ์ชัดเจนและผ่านการตรวจสอบคุณภาพอย่างเข้มงวด แกนหลักของ <strong class="text-[#7bbb0b]">GARUDA369</strong> ในวันนี้คือ AvatarUX
      เจ้าของนวัตกรรม PopWins ที่ขยายเพย์ไลน์ให้กว้างขึ้นทุกครั้งที่ชนะรางวัล จึงมอบโอกาสทำกำไรที่ทวีคูณต่อเนื่อง Spinomenal ที่นำเสนอความบันเทิงล้ำหน้าด้วยภาพแอนิเมชันสุดตระการตา
      และฟีเจอร์ภายในเกมที่ถูกปรับจูนมาให้เข้าถึงรอบแจ็กพอตได้อย่างรวดเร็วและคุ้มค่า และ Relax Gaming ที่มุ่งเน้นสถาปัตยกรรมซอฟต์แวร์อันแข็งแกร่ง โหลดไว ตอบสนองฉับไวบนทุกอุปกรณ์
      ทุกเกมทำงานบนเซิร์ฟเวอร์หลักโดยตรง อัตราการจ่ายจึงเป็นค่าเดียวกับที่ค่ายกำหนดไว้ ไม่มีการปรับลดระหว่างทาง และทุกเกมผ่านการทดสอบเสถียรภาพบนเครือข่ายมือถือของไทยก่อนขึ้นระบบจริง
      เพราะกราฟิกที่สวยแต่โหลดสะดุดกลางรอบโบนัส คือสิ่งที่ทำให้ผู้เล่นเสียความรู้สึกมากกว่าผลของรอบนั้นเสียอีก
    </p>
  </ContentBox>

  <ContentBox title="ระบบออโต้ ที่ขับเคลื่อนด้วย AI ประมวลผลจบในเสี้ยววินาที" as="h2">
    <p class="text-left text-base leading-relaxed text-[#dcefc2]">
      เราเข้าใจดีว่าเวลาคือสิ่งมีค่า ระบบประมวลผลของ <strong class="text-[#7bbb0b]">GARUDA369</strong> จึงทำงานอัตโนมัติเต็มรูปแบบด้วย AI อัจฉริยะ สมาชิกจัดการยอดฝากและถอนได้อย่างอิสระด้วยตนเอง
      การประมวลผลเครดิตจะเสร็จสิ้นภายในเสี้ยววินาที ไม่ต้องแนบสลิป และไม่ต้องรอรอบตรวจของทีมงาน โบนัสและเงินคืนก็เดินอยู่บนระบบเดียวกัน สมาชิกกดรับสิทธิ์เองได้จากเมนูอัตโนมัติตลอดเวลา
      ทุกรายการมีประวัติให้ตรวจย้อนหลังได้ทีละบิล เราตั้งใจให้ตัวเลขที่เห็นบนหน้าธุรกรรมตรงกับยอดในบัญชีเสมอ เพราะความเร็วจะมีความหมายก็ต่อเมื่อมันตรวจสอบได้
      และการลดขั้นตอนที่ยุ่งยากออกไปคือสิ่งที่ทำให้สมาชิกเดินหน้าทำกำไรได้ต่อเนื่องโดยมีสภาพคล่องทางการเงินสูงสุด
    </p>
  </ContentBox>

  <ContentBox title="โปรจัดเต็ม ที่สมาชิกเลือกรับเองได้ทุกแคมเปญ" as="h2">
    <p class="text-left text-base leading-relaxed text-[#dcefc2]">
      เพื่อยกระดับความสำเร็จให้กับนักลงทุน ทีมงานของ <strong class="text-[#7bbb0b]">GARUDA369</strong> ได้เตรียมสิทธิพิเศษและทุนสนับสนุนเอาไว้อย่างมหาศาล ทั้งแคมเปญคืนยอดเสียสูงสุด 15% ทุกวัน
      กิจกรรมฝากลุ้นรับรางวัลใหญ่ประจำเดือน และค่าคอมมิชชั่นจากการแนะนำเพื่อน 0.8% ทุกสิทธิ์เลือกรับได้ด้วยตนเองผ่านเมนูอัตโนมัติบนแดชบอร์ด นำไปต่อยอดทุนได้ทันทีโดยไม่มีเงื่อนไขซับซ้อน
      เป็นการเพิ่มขีดความสามารถในการเดิมพันให้กว้างขึ้นและลดความเสี่ยงได้อย่างมีประสิทธิภาพ ตอบโจทย์ผู้เล่นทุกระดับทุน เราตั้งใจให้หน้าโปรโมชั่นบอกครบทั้งรอบการคำนวณ ยอดที่นับได้จริง และเพดานการถอน
      เพราะตัวเลขใหญ่บนแบนเนอร์บอกได้แค่ว่ามีอะไรให้ ส่วนบรรทัดเล็กใต้ตัวเลขคือคนที่ตัดสินว่าสมาชิกได้จริงเท่าไร
    </p>
  </ContentBox>

  <ContentBox title="ปลอดภัย 100% ด้วย Secure Popup และการดูแลตลอด 24 ชม." as="h2">
    <p class="text-left text-base leading-relaxed text-[#dcefc2]">
      รากฐานของความยิ่งใหญ่คือความน่าเชื่อถือและการรักษาความปลอดภัยระดับองค์กร ข้อมูลส่วนบุคคลและกระเป๋าเงินของสมาชิกบน <strong class="text-[#7bbb0b]">GARUDA369</strong> จะถูกเข้ารหัสอย่างแน่นหนา
      และการเข้าสู่ระบบทำงานผ่าน Secure Popup ที่เปิดแดชบอร์ดขึ้นบนหน้าเดิม แทนการพาเด้งข้ามหน้าเว็บไปมา วิธีนี้โหลดไว ลื่นไหล ทำให้ทุกการเชื่อมต่อเป็นส่วนตัว
      และตัดจังหวะที่ลิงก์ปลอมมักแทรกตัวเข้ามาออกไป ด้านการบริการ ทีมซัพพอร์ตของเราพร้อมสแตนด์บายคอยช่วยเหลือและให้คำปรึกษาตลอด 24 ชั่วโมง ไม่มีวันหยุด
      ไม่ว่าจะเป็นคำถามเรื่องการใช้งาน เงื่อนไขการรับสิทธิ์ หรือรายการที่ต้องตรวจสอบย้อนหลัง ติดต่อได้ทั้งช่องทางแชตบนหน้าเว็บและ LINE Official
      ตัวเลขที่เราถือเป็นตัวชี้วัดจริงคือเวลาที่ใช้ตอบกลับครั้งแรกและจำนวนเรื่องที่ปิดจบได้ในการติดต่อเพียงครั้งเดียว มากกว่าจำนวนข้อความที่ตอบออกไปทั้งหมด
      อีกข้อที่อยากให้จำไว้เสมอคือทีมงานของเราจะไม่ขอรหัสผ่านหรือรหัส OTP จากสมาชิกไม่ว่ากรณีใด ใครก็ตามที่ทักมาขอสองสิ่งนี้ ไม่ใช่คนของเรา
    </p>
  </ContentBox>

  <Navfoot />
</MainLayout>
