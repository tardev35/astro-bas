---
import MainLayout from "../layouts/MainLayout.astro";
import ContentBox from "../components/ContentBox.astro";
import Navfoot from "../components/Navfoot.astro";
import Announcement from "../components/AnnouncementCyber.astro";
import { pageGraph } from "../lib/schema";

// The brief supplies no title/meta for this page, so both are written here.
// 152 CHARACTERS (Thai is 3 bytes/char — a byte count reads ~3x too long).
const pageDescription =
  "ทำความรู้จัก PGW44 เว็บสล็อตใหม่ล่าสุด ที่ขับเคลื่อนด้วย ระบบออโต้ อัจฉริยะ ให้อิสระ ฝากถอนไม่มีขั้นต่ำ รวมค่ายเกม Quickspin Evoplay และ CQ9 ดูแล 24 ชม.";

const graph = pageGraph(Astro, {
  type: "AboutPage",
  name: "เกี่ยวกับเรา PGW44 เว็บสล็อตใหม่ล่าสุด ระบบออโต้ ฝากถอนไม่มีขั้นต่ำ โปรเด็ด",
  description: pageDescription,
  breadcrumb: [
    { name: "หน้าแรก", path: "/" },
    { name: "เกี่ยวกับเรา", path: "/about-us" },
  ],
});
---

<MainLayout title="PGW44 เกี่ยวกับเรา เว็บสล็อตใหม่ล่าสุด ระบบออโต้ ฝากถอนไม่มีขั้นต่ำ โปรเด็ด" description={pageDescription}>
  <script type="application/ld+json" set:html={graph} />

  <Announcement />

  <ContentBox title="เกี่ยวกับเรา PGW44" as="h1">
    <p class="text-left text-base leading-relaxed text-[#dff5c8]">
      <strong class="text-[#7fdc16]">PGW44</strong> เกิดขึ้นจากความตั้งใจเดียว คือทำให้การเข้าถึงเกมคุณภาพระดับโลกเป็นเรื่องง่ายสำหรับคนไทยทุกกลุ่ม
      เราวางตัวเองเป็น เว็บสล็อตใหม่ล่าสุด ที่ถูกสร้างขึ้นเพื่อเป็นนวัตกรรมการลงทุนแห่งยุค ด้วยสถาปัตยกรรมซอฟต์แวร์ที่ทันสมัย ขับเคลื่อนด้วย ระบบออโต้ อัจฉริยะ
      เปิดอิสระทางการเงินแบบ ฝากถอนไม่มีขั้นต่ำ อย่างแท้จริง และเตรียม โปรเด็ด ไว้ซัพพอร์ตให้สมาชิกทำกำไรได้อย่างยั่งยืน
      สิ่งที่เราวัดผลกันจริงจึงไม่ใช่จำนวนแบนเนอร์ที่ปล่อยออกไปในแต่ละเดือน แต่เป็นความนิ่งของระบบในชั่วโมงที่คนเข้าใช้งานพร้อมกันมากที่สุด ความเร็วของการโอนที่ทำให้สมาชิกได้เงินไวจริงตามที่บอก
      และคุณภาพของการดูแลตลอด 24 ชั่วโมงที่ยืนระยะได้ทุกวัน
    </p>
  </ContentBox>

  <ContentBox title="ค่ายเกมลิขสิทธิ์แท้ที่ PGW44 คัดมาไว้ในที่เดียว" as="h2">
    <p class="text-left text-base leading-relaxed text-[#dff5c8]">
      เราไม่ได้เปิดรับทุกค่ายที่ยื่นเข้ามา แต่คัดเฉพาะผู้พัฒนาที่มีลิขสิทธิ์ชัดเจนและผ่านการตรวจสอบคุณภาพอย่างเข้มงวด แกนหลักของ <strong class="text-[#7fdc16]">PGW44</strong> ในวันนี้คือ Quickspin
      ผู้พัฒนาที่มุ่งเน้นการเล่าเรื่องผ่านภาพกราฟิกสุดพรีเมียม ผสานกลไกการออกโบนัสที่แยบยลและลุ้นสนุกในทุกจังหวะการสปิน Evoplay ที่ฉีกกรอบการเดิมพันแบบเดิม ๆ ด้วยอินเทอร์เฟซ 3D
      ให้อารมณ์เหมือนเล่นวิดีโอเกมระดับโลก เข้าถึงง่ายและมีโอกาสทำกำไรสูง และ CQ9 ซอฟต์แวร์ที่ขึ้นชื่อเรื่องความเสถียร เอฟเฟกต์จัดจ้าน กับฟีเจอร์คูณเงินรางวัลที่ตอบสนองได้ดีเยี่ยมบนมือถือทุกรุ่น
      ทั้งสามค่ายเชื่อมต่อผ่าน API โดยตรง อัตราการจ่ายผลตอบแทนจึงเป็นค่าเดียวกับที่ค่ายกำหนดไว้ ไม่มีการปรับลดระหว่างทาง และทุกเกมผ่านการทดสอบเสถียรภาพบนเครือข่ายมือถือของไทยก่อนขึ้นระบบจริง
      เพราะกราฟิกที่สวยแต่โหลดสะดุดกลางรอบโบนัส คือสิ่งที่ทำให้ผู้เล่นเสียความรู้สึกมากกว่าผลของรอบนั้นเสียอีก
    </p>
  </ContentBox>

  <ContentBox title="เทคโนโลยี ระบบออโต้ ที่ประมวลผลจบในเสี้ยววินาที" as="h2">
    <p class="text-left text-base leading-relaxed text-[#dff5c8]">
      เราเข้าใจดีว่าเวลาคือสิ่งมีค่า ระบบประมวลผลของ <strong class="text-[#7fdc16]">PGW44</strong> จึงทำงานอัตโนมัติเต็มรูปแบบด้วยเทคโนโลยี AI ที่พัฒนามาเพื่อระบบของเราโดยเฉพาะ
      เพียงทำรายการฝากหรือถอน ยอดเครดิตจะถูกประมวลผลและอัปเดตเข้าสู่แดชบอร์ดส่วนตัวภายในเสี้ยววินาที ไม่ต้องแนบสลิป และไม่ต้องรอรอบตรวจของทีมงาน โบนัสและเงินคืนก็เดินอยู่บนระบบเดียวกัน
      สมาชิกกดรับสิทธิ์เองได้จากเมนูอัตโนมัติตลอดเวลา ทุกรายการมีประวัติให้ตรวจย้อนหลังได้ทีละบิล เราตั้งใจให้ตัวเลขที่เห็นบนหน้าธุรกรรมตรงกับยอดในบัญชีเสมอ เพราะความเร็วจะมีความหมายก็ต่อเมื่อมันตรวจสอบได้
    </p>
  </ContentBox>

  <ContentBox title="มอบอิสระทางการเงินด้วยนโยบาย ฝากถอนไม่มีขั้นต่ำ" as="h2">
    <p class="text-left text-base leading-relaxed text-[#dff5c8]">
      ไม่ว่าคุณจะมีงบประมาณเท่าใด ทีมงานของ <strong class="text-[#7fdc16]">PGW44</strong> พร้อมเปิดโอกาสให้ทุกคนเข้าถึงการลงทุนได้อย่างเท่าเทียม นโยบาย ฝากถอนไม่มีขั้นต่ำ
      ช่วยให้คุณบริหารจัดการเงินทุนได้อย่างอิสระเสรี ปราศจากข้อผูกมัดหรือเงื่อนไขที่น่าอึดอัด มอบความคล่องตัวในทุกการตัดสินใจ อินเทอร์เฟซทั้งหมดถูกจัดวางให้เป็นสัดส่วนและอ่านจบได้ในหน้าเดียว
      เมนูฝาก ถอน รับสิทธิ์ และประวัติรายการอยู่ห่างจากหน้าแรกไม่เกินสองคลิก ค้นหาเกมได้จากชื่อค่ายหรือชื่อเกมโดยตรง และทุกอย่างทำงานบนเบราว์เซอร์มือถือได้เท่ากับบนคอมพิวเตอร์ ไม่ต้องติดตั้งแอปเพิ่ม
      เราตัดขั้นตอนที่ไม่จำเป็นออกไปเรื่อย ๆ ทุกครั้งที่พบว่าสมาชิกต้องถามทีมงานเพื่อทำสิ่งเดิมซ้ำ เพราะคำถามที่เกิดซ้ำคือสัญญาณว่าหน้าจอยังอธิบายตัวเองได้ไม่ดีพอ ไม่ใช่ความผิดของคนถาม
    </p>
  </ContentBox>

  <ContentBox title="โปรเด็ด ที่สมาชิกกดรับเองได้ทุกแคมเปญ" as="h2">
    <p class="text-left text-base leading-relaxed text-[#dff5c8]">
      เพื่อเป็นการสนับสนุนสมาชิกทุกท่าน แพลตฟอร์ม <strong class="text-[#7fdc16]">PGW44</strong> จัดเตรียมแคมเปญและสิทธิพิเศษเอาไว้อย่างครบครัน ทั้ง คืนยอดเสีย 30% ที่คำนวณจากยอดที่เสียจริงและคืนให้ทุกวัน
      แคมเปญ แนะนำเพื่อน รับค่าคอม 0.8% ไม่อั้นทุกยอด ที่จ่ายตามยอดการเล่นของเพื่อนที่สมัครผ่านลิงก์ของคุณ และ โบนัสต้อนรับ 300% สำหรับสมาชิกที่เพิ่งเปิดยูสเซอร์แรก
      ทุกสิทธิ์เลือกรับได้ด้วยตนเองผ่านเมนูอัตโนมัติโดยไม่มีเงื่อนไขซับซ้อน นำไปต่อยอดทุนได้ทันที เราตั้งใจให้หน้าโปรโมชั่นบอกครบทั้งรอบการคำนวณ ยอดที่นับได้จริง และเพดานการถอน
      เพราะตัวเลขใหญ่บนแบนเนอร์บอกได้แค่ว่ามีอะไรให้ ส่วนบรรทัดเล็กใต้ตัวเลขคือคนที่ตัดสินว่าสมาชิกได้จริงเท่าไร
    </p>
  </ContentBox>

  <ContentBox title="บริการ 24 ชม. และความปลอดภัยของทุกการเชื่อมต่อ" as="h2">
    <p class="text-left text-base leading-relaxed text-[#dff5c8]">
      ทีมซัพพอร์ตของ <strong class="text-[#7fdc16]">PGW44</strong> ผ่านการอบรมมาอย่างดีเยี่ยม พร้อมสแตนด์บายคอยช่วยเหลือและให้คำปรึกษาตลอด 24 ชั่วโมง ไม่มีวันหยุด
      ไม่ว่าจะเป็นคำถามเรื่องการใช้งาน เงื่อนไขการรับสิทธิ์ หรือรายการที่ต้องตรวจสอบย้อนหลัง ติดต่อได้ทั้งช่องทางแชตบนหน้าเว็บและ LINE Official ตัวเลขที่เราถือเป็นตัวชี้วัดจริงคือเวลาที่ใช้ตอบกลับครั้งแรก
      และจำนวนเรื่องที่ปิดจบได้ในการติดต่อเพียงครั้งเดียว มากกว่าจำนวนข้อความที่ตอบออกไปทั้งหมด ด้านความปลอดภัย เราเข้ารหัสฐานข้อมูลและการเชื่อมต่อทั้งหมดด้วยมาตรฐานเดียวกับที่สถาบันการเงินใช้
      และให้การเข้าสู่ระบบทำงานผ่าน Secure Transition Popup ที่เปิดแดชบอร์ดขึ้นบนหน้าเดิม แทนการพาเด้งข้ามหน้าเว็บไปมา วิธีนี้โหลดไว ลื่นไหล ป้องกันการรีเฟรชหน้าเว็บซ้ำซ้อน
      และตัดจังหวะที่ลิงก์ปลอมมักแทรกตัวเข้ามาออกไป อีกข้อที่อยากให้จำไว้เสมอคือทีมงานของเราจะไม่ขอรหัสผ่านหรือรหัส OTP จากสมาชิกไม่ว่ากรณีใด ใครก็ตามที่ทักมาขอสองสิ่งนี้ ไม่ใช่คนของเรา
    </p>
  </ContentBox>

  <Navfoot />
</MainLayout>
