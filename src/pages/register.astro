---
import MainLayout from "../layouts/MainLayout.astro";
import ContentBox from "../components/ContentBox.astro";
import Navfoot from "../components/Navfoot.astro";
import Announcement from "../components/Announcement3.astro";
import CtaRedirect from "../components/CtaRedirect.astro";
import { pageGraph } from "../lib/schema";

// BUTTON PAGE, not an article, and no longer an auto-forwarding interstitial:
// one <h1> from the ContentBox title and one button to the affiliate link.
// Never add an <h2>, never write body copy here.
//
// 153 characters — this page is indexed now, so verify-build holds the
// description to the 150–160 window like any other page. Count CHARACTERS
// (`node -e "console.log([...'…'].length)"`); a byte count reads ~3x too long
// on Thai. The docx gives no Title/Meta for /register, so both are written
// here from the brief's own wording; they describe the button page this route
// is now, not the old auto-forward.
const pageDescription =
  "กดปุ่มเดียวสมัครสมาชิก ROMAN555 ทางเข้าหลักเว็บตรง เปิดบัญชีผ่านระบบออโต้ พร้อมเล่นเกมจาก ค่ายใหญ่ลิขสิทธิ์แท้ และฝากถอน รองรับทรูวอเลท ได้อย่างอิสระเสรี";

const graph = pageGraph(Astro, {
  name: "สมัครสมาชิก ROMAN555 เปิดบัญชีใหม่ผ่านระบบออโต้ ค่ายใหญ่ลิขสิทธิ์แท้",
  description: pageDescription,
  breadcrumb: [
    { name: "หน้าแรก", path: "/" },
    { name: "สมัครสมาชิก", path: "/register" },
  ],
});

// This brand's affiliate link — carried over from the interstitial this page
// replaced. Do NOT change it during a rebrand; restyle the button only.
const targetUrl = "https://tinyurl.com/pigbas";
---

<MainLayout title="สมัครสมาชิก ROMAN555 เปิดบัญชีใหม่ผ่านระบบออโต้ ค่ายใหญ่ลิขสิทธิ์แท้" description={pageDescription}>
  <script type="application/ld+json" set:html={graph} />

  <Announcement />

  <ContentBox title="สมัครสมาชิก ROMAN555" as="h1">
    <div class="flex justify-center py-8">
      <a
        href={targetUrl}
        rel="nofollow sponsored"
        data-cta-redirect
        aria-label="สมัครสมาชิก ROMAN555 ที่เว็บหลัก"
        class="group relative mx-auto flex w-full max-w-[320px] items-center justify-center gap-3 overflow-hidden rounded-xl border border-[#f6cf6a]/60 bg-gradient-to-r from-[#fbeab0] via-[#f6cf6a] to-[#7a4405] px-6 py-4 text-xl font-bold tracking-wide text-[#120a02] shadow-[0_10px_30px_rgba(246,207,106,0.20)] transition-all duration-300 hover:scale-105 hover:shadow-[0_15px_40px_rgba(246,207,106,0.32)]">
        สมัครสมาชิก
      </a>
    </div>
  </ContentBox>

  <Navfoot />

  <CtaRedirect label="สมัครสมาชิก" />
</MainLayout>
