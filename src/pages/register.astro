---
import MainLayout from "../layouts/MainLayout.astro";
import ContentBox from "../components/ContentBox.astro";
import Navfoot from "../components/Navfoot.astro";
import Announcement from "../components/Announcement5.astro";
import { pageGraph } from "../lib/schema";

// BUTTON PAGE, not an article, and no longer an auto-forwarding interstitial:
// one <h1> from the ContentBox title and one button to the affiliate link.
// Never add an <h2>, never write body copy here.
//
// 153 characters — this page is indexed now, so verify-build holds the
// description to the 150–160 window like any other page. Count characters with
// PowerShell `"...".Length`; a byte count reads ~3x too long on Thai.
// The docx gives no Title/Meta for /register, so both are written here; they
// describe the button page this route is now, not the old auto-forward.
const pageDescription =
  "หน้าสมัครสมาชิก BUNNY555 เว็บสล็อตลิขสิทธิ์แท้ กดปุ่มเดียวเข้าสู่หน้าสมัครของเว็บหลัก เปิดบัญชีใหม่ผ่านระบบออโต้ รับโปรโมชั่นและคืนยอดเสีย 15% ทุกสัปดาห์";

const graph = pageGraph(Astro, {
  name: "สมัครสมาชิก BUNNY555 เว็บหลัก เปิดบัญชีใหม่ผ่านระบบออโต้",
  description: pageDescription,
  breadcrumb: [
    { name: "หน้าแรก", path: "/" },
    { name: "สมัครสมาชิก", path: "/register" },
  ],
});

// This brand's affiliate link — carried over from the interstitial this page
// replaced. Do NOT change it during a rebrand; restyle the button only.
const targetUrl = "https://tinyurl.com/pigbas";
---

<MainLayout title="สมัครสมาชิก BUNNY555 เว็บหลัก เปิดบัญชีใหม่ผ่านระบบออโต้" description={pageDescription}>
  <script type="application/ld+json" set:html={graph} />

  <Announcement />

  <ContentBox title="สมัครสมาชิก BUNNY555" as="h1">
    <div class="flex justify-center py-8">
      <a
        href={targetUrl}
        rel="nofollow sponsored"
        aria-label="สมัครสมาชิก BUNNY555 ที่เว็บหลัก"
        class="group relative mx-auto flex w-full max-w-[320px] items-center justify-center gap-3 overflow-hidden rounded-xl border border-[#ff4d9d]/60 bg-gradient-to-r from-[#ffc2da] via-[#ff4d9d] to-[#a3134f] px-6 py-4 text-xl font-bold tracking-wide text-[#26050f] shadow-[0_10px_30px_rgba(255,77,157,0.20)] transition-all duration-300 hover:scale-105 hover:shadow-[0_15px_40px_rgba(255,77,157,0.32)]">
        สมัครสมาชิก
      </a>
    </div>
  </ContentBox>

  <Navfoot />
</MainLayout>
