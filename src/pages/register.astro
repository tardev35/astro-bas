---
import MainLayout from "../layouts/MainLayout.astro";
import ContentBox from "../components/ContentBox.astro";
import Navfoot from "../components/Navfoot.astro";
import Announcement from "../components/Announcement3.astro";
import { pageGraph } from "../lib/schema";

// BUTTON PAGE, not an article, and no longer an auto-forwarding interstitial:
// one <h1> from the ContentBox title and one button to the affiliate link.
// Never add an <h2>, never write body copy here.
//
// 157 characters — this page is indexed now, so verify-build holds the
// description to the 150–160 window like any other page. Count characters with
// PowerShell `"...".Length`; a byte count reads ~3x too long on Thai.
const pageDescription =
  "หน้าสมัครสมาชิก DEVA555 สล็อตเว็บตรงอันดับ 1 เปิดบัญชีใหม่ด้วยระบบออโต้ กดปุ่มเดียวเข้าสู่หน้าสมัครของเว็บหลัก ฝากถอนออโต้ไว 3 วิ รองรับทรูวอเลท ปลอดภัย 100%";

const graph = pageGraph(Astro, {
  name: "สมัครสมาชิก DEVA555 เว็บหลัก ฝากถอนออโต้ไว 3 วิ",
  description: pageDescription,
  breadcrumb: [
    { name: "หน้าแรก", path: "/" },
    { name: "สมัครสมาชิก", path: "/register" },
  ],
});

// This brand's affiliate link — carried over from the interstitial this page
// replaced. Do NOT change it during a rebrand; restyle the button only.
const targetUrl = "https://tinyurl.com/pigbas";
---

<MainLayout title="สมัครสมาชิก DEVA555 เว็บหลัก ฝากถอนออโต้ไว 3 วิ" description={pageDescription}>
  <script type="application/ld+json" set:html={graph} />

  <Announcement />

  <ContentBox title="สมัครสมาชิก DEVA555" as="h1">
    <div class="flex justify-center py-8">
      <a
        href={targetUrl}
        rel="nofollow sponsored"
        aria-label="สมัครสมาชิก"
        class="group relative mx-auto flex w-full max-w-[320px] items-center justify-center gap-3 overflow-hidden rounded-xl border border-[#dfb85f]/60 bg-gradient-to-r from-[#fded9a] via-[#dfb85f] to-[#a57a32] px-6 py-4 text-xl font-bold tracking-wide text-[#140d04] shadow-[0_10px_30px_rgba(223,184,95,0.20)] transition-all duration-300 hover:scale-105 hover:shadow-[0_15px_40px_rgba(223,184,95,0.32)]">
        สมัครสมาชิก
      </a>
    </div>
  </ContentBox>

  <Navfoot />
</MainLayout>
