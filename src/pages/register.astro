---
import MainLayout from "../layouts/MainLayout.astro";
import ContentBox from "../components/ContentBox.astro";
import Navfoot from "../components/Navfoot.astro";
import Announcement from "../components/AnnouncementPremium.astro";
import CtaRedirect from "../components/CtaRedirect.astro";
import { pageGraph } from "../lib/schema";

// BUTTON PAGE, not an article, and no longer an auto-forwarding interstitial:
// one <h1> from the ContentBox title and one button to the affiliate link.
// Never add an <h2>, never write body copy here.
//
// 152 characters — this page is indexed now, so verify-build holds the
// description to the 150–160 window like any other page. Count CHARACTERS
// (`node -e "console.log([...'…'].length)"`); a byte count reads ~3x too long
// on Thai. The docx gives no Title/Meta for /register, so both are written
// here from the brand's own positioning; they describe the button page this
// route is now, not the old auto-forward.
const pageDescription =
  "หน้าสมัครสมาชิก TT1BET คาสิโนออนไลน์ครบวงจร กดปุ่มเดียวเปิดบัญชีผ่านระบบ AI อัตโนมัติ สมัครง่าย ไม่ถึงนาที รวมเกมแตกง่าย การันตี จ่ายจริง ทุกยอดบิล 100%";

const graph = pageGraph(Astro, {
  name: "สมัครสมาชิก TT1BET เว็บหลัก เปิดบัญชีใหม่ผ่านระบบออโต้",
  description: pageDescription,
  breadcrumb: [
    { name: "หน้าแรก", path: "/" },
    { name: "สมัครสมาชิก", path: "/register" },
  ],
});

// This brand's affiliate link — carried over from the interstitial this page
// replaced. Do NOT change it during a rebrand; restyle the button only.
const targetUrl = "https://tinyurl.com/pigbas";
---

<MainLayout title="สมัครสมาชิก TT1BET เว็บหลัก เปิดบัญชีใหม่ผ่านระบบออโต้" description={pageDescription}>
  <script type="application/ld+json" set:html={graph} />

  <Announcement />

  <ContentBox title="สมัครสมาชิก TT1BET" as="h1">
    <div class="flex justify-center py-8">
      <a
        href={targetUrl}
        rel="nofollow sponsored"
        data-cta-redirect
        aria-label="สมัครสมาชิก TT1BET ที่เว็บหลัก"
        class="group relative mx-auto flex w-full max-w-[320px] items-center justify-center gap-3 overflow-hidden rounded-xl border border-[#ebdd65]/60 bg-gradient-to-r from-[#fcf6ab] via-[#ebdd65] to-[#a8790f] px-6 py-4 text-xl font-bold tracking-wide text-[#0a0704] shadow-[0_10px_30px_rgba(235,221,101,0.20)] transition-all duration-300 hover:scale-105 hover:shadow-[0_15px_40px_rgba(235,221,101,0.32)]">
        สมัครสมาชิก
      </a>
    </div>
  </ContentBox>

  <Navfoot />

  <CtaRedirect label="สมัครสมาชิก" />
</MainLayout>
