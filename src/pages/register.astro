---
import { fontStack, usesGoogleFonts } from "../lib/brandProfile";

const targetUrl = "https://yoalink.com/22hs";

// This page has its own <head> and does not import global.css, so it gets
// neither the @theme fallback for --font-sans nor the self-hosted Kanit
// @font-face. Both the variable and the webfont have to be supplied here or the
// page renders in the browser default while the rest of the site does not.
const fontHref = usesGoogleFonts
  ? "https://fonts.googleapis.com/css2?family=Google+Sans:ital,opsz,wght@0,17..18,400..700;1,17..18,400..700&family=Oswald:wght@700&display=swap"
  : "https://fonts.googleapis.com/css2?family=Kanit:wght@300;400;600&family=Oswald:wght@700&display=swap";
---

<html lang="th" style={`--font-sans: ${fontStack};`}>
  <head>
    <meta charset="utf-8" />
    <title>สมัครสมาชิก UFAG8 | กำลังเชื่อมต่อไปหน้าสมัครอัตโนมัติ</title>
    <meta
      name="description"
      content="หน้าเชื่อมต่อสมัครสมาชิก UFAG8 เว็บกีฬาและแทงบอลออนไลน์ ใช้เบอร์โทรศัพท์และรหัสผ่านเป็นข้อมูลหลัก สมัครได้ภายใน 5 นาที กำลังพาไปยังหน้าสมัครสมาชิกอย่างปลอดภัย"
    />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />

    {/* This page exists only to forward; there is nothing here worth ranking,
        and its source carries the affiliate URL — the one host every brand in
        the group has in common. Keeping it out of the index means that link is
        not sitting in a page Google has stored. Astro's own /line redirect page
        ships noindex for the same reason. */}
    <meta name="robots" content="noindex, follow" />

    <meta http-equiv="refresh" content={`1.5;url=${targetUrl}`} />

    <link href={fontHref} rel="stylesheet" />

    <style>
      /* UFAG8 is a DARK brand — neutral near-black surfaces, a steel-tinted
         panel, chrome/silver secondary, rich gold accents and cream text. There
         is no red or crimson in this brand. Every value below is a real colour,
         so read the value, not the variable name, before reusing one. */
      :root {
        --page-bg: #0a0a09;
        --panel-bg: rgba(21, 23, 28, 0.94);
        --brand-gold: #dcb96b;
        --brand-gold-deep: #ac893a;
        --brand-gold-light: #f2dca4;
        --brand-chrome: #b9bcc4;
        --text-body: #efeade;
        --text-muted: #bcb6a6;
      }

      body {
        margin: 0;
        font-family: var(--font-sans);
        color: var(--text-body);

        background:
          radial-gradient(circle at 50% 10%, rgba(220, 185, 107, 0.18) 0%, transparent 55%),
          radial-gradient(circle at 50% 92%, rgba(185, 188, 196, 0.22) 0%, transparent 55%), var(--page-bg);
        display: flex;
        min-height: 100vh;
        flex-direction: column;
        align-items: center;
        justify-content: center;
        padding: 2rem;
      }

      .premium-loading-container {
        width: 90%;
        max-width: 450px;
        padding: 3.5rem;
        background: var(--panel-bg);
        border: 1px solid rgba(220, 185, 107, 0.4);
        border-radius: 2rem;
        box-shadow:
          0 1rem 3rem rgba(220, 185, 107, 0.18),
          0 0 2rem rgba(220, 185, 107, 0.25);
        text-align: center;
        backdrop-filter: blur(10px);
      }

      .brand-identity {
        font-family: "Oswald", sans-serif;
        font-size: 1.5rem;
        font-weight: 700;
        background: linear-gradient(180deg, var(--brand-gold-light) 0%, #e5c375 40%, var(--brand-gold) 72%, var(--brand-gold-deep) 100%);
        -webkit-background-clip: text;
        background-clip: text;
        color: transparent;
        letter-spacing: 0.3em;
        margin-bottom: 2rem;
        filter: drop-shadow(0 1px 2px rgba(220, 185, 107, 0.35));
      }

      .sophisticated-loader {
        position: relative;
        width: 100px;
        height: 100px;
        margin: 0 auto 3.5rem auto;
        display: flex;
        align-items: center;
        justify-content: center;
      }

      .orb {
        width: 40px;
        height: 40px;
        background: radial-gradient(circle, var(--brand-gold-light) 0%, var(--brand-gold) 45%, var(--brand-gold-deep) 100%);
        border-radius: 50%;
        box-shadow: 0 0 2rem rgba(220, 185, 107, 0.35);
        animation: pulse 2s ease-in-out infinite;
      }

      .ring {
        position: absolute;
        border-radius: 50%;
        border: 3px solid rgba(220, 185, 107, 0.2);
        animation: spin linear infinite;
      }

      .ring-1 {
        width: 100%;
        height: 100%;
        border-top-color: var(--brand-gold-deep);
        animation-duration: 4s;
      }

      .ring-2 {
        width: 80%;
        height: 80%;
        border-bottom-color: var(--brand-chrome);
        animation-duration: 6s;
        animation-direction: reverse;
      }

      @keyframes spin {
        0% {
          transform: rotate(0deg);
        }
        100% {
          transform: rotate(360deg);
        }
      }
      @keyframes pulse {
        0%,
        100% {
          transform: scale(1);
          box-shadow: 0 0 2rem rgba(220, 185, 107, 0.35);
        }
        50% {
          transform: scale(1.15);
          box-shadow: 0 0 3rem rgba(220, 185, 107, 0.5);
        }
      }

      .status-text .h1 {
        font-family: "Oswald", sans-serif;
        font-size: 1.25rem;
        font-weight: 700;
        letter-spacing: 0.1em;
        text-transform: uppercase;
        color: var(--text-body);
        text-shadow: 0 1px 1px rgba(220, 185, 107, 0.25);
        margin: 0;
      }
      .status-text .p {
        font-size: 0.875rem;
        color: var(--text-muted);
        line-height: 1.6;
        margin: 1rem 0 0 0;
      }
    </style>
  </head>
  <body>
    <div class="premium-loading-container">
      <div class="brand-identity">UFAG8</div>

      <div class="sophisticated-loader">
        <div class="orb"></div>
        <div class="ring ring-1"></div>
        <div class="ring ring-2"></div>
      </div>

      <div class="status-text">
        <h1 class="h1">CREATING SECURE ACCOUNT SESSION...</h1>
        <p class="p">กำลังพาไปหน้าสมัครสมาชิก UFAG8 ด้วยเบอร์โทรศัพท์ 🔒</p>
      </div>
    </div>

    <script define:vars={{ targetUrl }}>
      setTimeout(() => {
        window.location.replace(targetUrl);
      }, 3000);
    </script>
  </body>
</html>
