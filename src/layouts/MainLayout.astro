---
import { Image } from "astro:assets";
import Bg from "../assets/bg.png";
import bgConfig from "../assets/bg.json";
import ogImage from "../assets/slide1.png";
import "../styles/global.css";
import { BRAND_NAME, brandProfile, fontStack, usesGoogleFonts } from "../lib/brandProfile";
import { canonicalFor } from "../lib/schema";
import Navbar from "../components/NavbarStyle11.astro";
import Footer from "../components/FooterStyle3.astro";

const bannerImages = import.meta.glob<{ default: ImageMetadata }>("../assets/banner*.{png,webp,jpg,jpeg}", { eager: true });
const bannerPaths = Object.keys(bannerImages);
const preferredBannerPath = bannerPaths.find((path) => /banner1\.(png|webp|jpg|jpeg)$/.test(path));
const webpBannerPath = bannerPaths.find((path) => path.endsWith(".webp"));
const mainBannerPath = preferredBannerPath ?? webpBannerPath ?? bannerPaths[0];
const mainBanner = mainBannerPath ? bannerImages[mainBannerPath].default : null;

const {
  title = "UFAG8 เว็บกีฬา แทงบอลออนไลน์ รวมตลาดบอลและเกมหลายประเภท",
  description = "รีวิว UFAG8 เว็บกีฬาและแทงบอลออนไลน์ ตั้งแต่ตลาดเดิมพัน การดูราคาบอล สมัครด้วยเบอร์โทร เข้าสู่ระบบ และจุดที่ควรเช็กก่อนยืนยันบิล",
  robots = "index, follow",
  ImageOg = ogImage.src,
} = Astro.props;

const bgMode = (bgConfig as { mode?: string }).mode ?? "image";
const bgCss = bgMode === "color" ? `background-color:${(bgConfig as { color?: string }).color};` : bgMode === "gradient" ? `background-image:${(bgConfig as { css?: string }).css};` : null;

// canonicalFor() is the same function every JSON-LD URL goes through, so the
// canonical and the structured data cannot drift apart (see src/lib/schema.ts).
// Do not replace it with new URL(Astro.url.pathname, Astro.site) — that is what
// used to be here, and it disagreed with the JSON-LD about the trailing slash
// on every page.
const canonicalURL = canonicalFor(Astro);
const ogImageURL = new URL(ImageOg, Astro.site);
const ogSiteName = BRAND_NAME;

const profile = brandProfile(Astro.site);

// <html> มี id="top" เป็นเป้าของปุ่ม "กลับขึ้นบน" ใน footer แทน onclick เดิมที่
// ฮาร์ดโค้ด behavior:'smooth' ไว้ จึงไม่ฟัง prefers-reduced-motion — ตอนนี้การ
// เลื่อนมาจาก scroll-behavior ใน global.css ซึ่งบล็อก reduced-motion ทับให้แล้ว
//
// ห้ามวาง expression `{/* ... */}` ไว้ "ก่อน" <html> ในไฟล์นี้ — Astro จะเลิก
// มองว่า <html> เป็น root ของเอกสารแล้วตัดทั้งแท็กทิ้ง (ทดสอบแล้วเมื่อ
// 2026-07-31: ผลลัพธ์คือทุกหน้าไม่มี <html lang="th"> เลย) คอมเมนต์ที่อธิบาย
// โครงหน้าเลยต้องอยู่ใน frontmatter แบบนี้เท่านั้น
//
// --font-sans ตั้งเป็น inline style บน <html> ไม่ใช่ใน CSS เพราะ @theme ของ
// Tailwind ประกาศตัวแปรนี้ที่ :root — inline style ชนะเสมอโดยไม่ต้องพึ่ง
// ลำดับของ stylesheet หรือ !important (คอมเมนต์อยู่ใน frontmatter เพราะ
// คอมเมนต์แบบ HTML จะถูกส่งออกไปที่ไฟล์ผลลัพธ์จริง)
---

<html lang="th" id="top" style={`--font-sans: ${fontStack};`}>
  <head>
    <meta charset="utf-8" />
    <meta name="robots" content={robots} />
    <meta name="googlebot" content={robots} />
    <title>{title}</title>
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />
    {
      usesGoogleFonts && (
        <Fragment>
          <link rel="preconnect" href="https://fonts.googleapis.com" />
          <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
          <link
            href="https://fonts.googleapis.com/css2?family=Google+Sans:ital,opsz,wght@0,17..18,400..700;1,17..18,400..700&display=swap"
            rel="stylesheet"
          />
        </Fragment>
      )
    }
    {profile.fontPreloads.map((href) => <link rel="preload" href={href} as="font" type="font/woff2" crossorigin={profile.crossorigin} />)}
    <link rel="canonical" href={canonicalURL} />

    {
      profile.headOrder.map((block) => (
        <Fragment>
          {block === "icons" && (
            <Fragment>
              <link rel="icon" type="image/png" href="/favicon-96x96.png" sizes="96x96" />
              <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
              {profile.showShortcutIcon && <link rel="shortcut icon" href="/favicon.ico" />}
              <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />
            </Fragment>
          )}

          {block === "appmeta" && (
            <Fragment>
              {profile.showAppTitle && <meta name="apple-mobile-web-app-title" content="ufag8" />}
              <link rel="manifest" href="/site.webmanifest" />
            </Fragment>
          )}

          {block === "og" && (
            <Fragment>
              <meta property="og:type" content="website" />
              <meta property="og:url" content={canonicalURL} />
              <meta property="og:title" content={title} />
              <meta property="og:description" content={description} />
              <meta property="og:image" content={ogImageURL} />
              <meta property="og:site_name" content={ogSiteName} />
              {profile.showOgLocale && <meta property="og:locale" content="th_TH" />}
            </Fragment>
          )}

          {block === "twitter" && (
            <Fragment>
              <meta name="twitter:card" content="summary_large_image" />
              {profile.showTwitterUrl && <meta name="twitter:url" content={canonicalURL} />}
              <meta name="twitter:title" content={title} />
              <meta name="twitter:description" content={description} />
              <meta name="twitter:image" content={ogImageURL} />
            </Fragment>
          )}
        </Fragment>
      ))
    }

    <style is:global>
      html,
      body {
        overflow-x: hidden;
        max-width: 100%;
      }
      body {
        background-size: cover;
        background-position: center;
        background-attachment: fixed;
        background-repeat: no-repeat;
        margin: 0;
        background-color: #0a0a09;
        font-weight: 400;
        font-family: var(--font-sans) !important;
      }
    </style>
  </head>

  <body class="relative flex min-h-screen w-full flex-col">
    {
      bgCss ? (
        <div class="fixed inset-0 -z-50 h-full w-full bg-cover bg-center" style={bgCss} />
      ) : (
        <Image
          src={Bg}
          alt=""
          loading="eager"
          widths={[412, 768, 1024, 1900]}
          sizes="100vw"
          format="avif"
          class="fixed inset-0 -z-50 h-full w-full object-cover"
          quality="low"
          decoding="sync"
        />
      )
    }

    <Navbar />

    <div class="mb-2.5 flex w-full items-center justify-center">
      <Image
        src={mainBanner!}
        alt="UFAG8 เว็บกีฬา แทงบอลออนไลน์ รวมตลาดเดิมพัน ราคาบอล บอลสด บิลเดี่ยวและบิลสเต็ปไว้ในบัญชีเดียว"
        loading="eager"
        fetchpriority="high"
        widths={[412, 768, 1900]}
        sizes="(max-width: 768px) 412px, 100vw"
        class="mx-auto h-auto w-full max-w-full object-contain shadow-xl"
        decoding="sync"
        format="avif"
        quality={60}
      />
    </div>

    <main class="w-full flex-1">
      <article>
        <slot />
      </article>
    </main>

    <Footer />
  </body>
</html>
