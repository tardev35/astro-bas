---
import { Image } from "astro:assets";
import Bg from "../assets/bg.png";
import bgConfig from "../assets/bg.json";
import ogImage from "../assets/slide1.png";
import "../styles/global.css";
import { brandProfile } from "../lib/brandProfile";
import Navbar from "../components/NavbarStyle5.astro";
import Footer from "../components/Footer.astro";

const bannerImages = import.meta.glob<{ default: ImageMetadata }>("../assets/banner*.{png,webp,jpg,jpeg}", { eager: true });
const bannerPaths = Object.keys(bannerImages);
const preferredBannerPath = bannerPaths.find((path) => /banner1\.(png|webp|jpg|jpeg)$/.test(path));
const webpBannerPath = bannerPaths.find((path) => path.endsWith(".webp"));
const mainBannerPath = preferredBannerPath ?? webpBannerPath ?? bannerPaths[0];
const mainBanner = mainBannerPath ? bannerImages[mainBannerPath].default : null;

const {
  title = "UFAYES เว็บพนันออนไลน์ครบทุกเกม แทงบอล คาสิโน สล็อต หวย ระบบออโต้",
  description = "UFAYES รวมข้อมูลแทงบอล คาสิโนสด สล็อต หวย เกมยอดนิยมจากค่ายดัง ระบบฝากถอนออโต้ โปรโมชั่น และช่องทางติดต่อทีมงานตลอด 24 ชั่วโมง",
  robots = "index, follow",
  ImageOg = ogImage.src,
} = Astro.props;

const bgMode = (bgConfig as { mode?: string }).mode ?? "image";
const bgCss = bgMode === "color" ? `background-color:${(bgConfig as { color?: string }).color};` : bgMode === "gradient" ? `background-image:${(bgConfig as { css?: string }).css};` : null;

const currentPath = Astro.url.pathname;
const canonicalURL = new URL(currentPath, Astro.site);
const ogImageURL = new URL(ImageOg, Astro.site);
const ogSiteName = "UFAYES";

const profile = brandProfile(Astro.site);
---

<html lang="th">
  <head>
    <meta charset="utf-8" />
    <meta name="robots" content={robots} />
    <meta name="googlebot" content={robots} />
    <title>{title}</title>
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />
    {profile.fontPreloads.map((href) => <link rel="preload" href={href} as="font" type="font/woff2" crossorigin={profile.crossorigin} />)}
    <link rel="canonical" href={canonicalURL} />

    {
      profile.headOrder.map((block) => (
        <Fragment>
          {block === "icons" && (
            <Fragment>
              <link rel="icon" type="image/png" href="/favicon-96x96.png" sizes="96x96" />
              <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
              {profile.showShortcutIcon && <link rel="shortcut icon" href="/favicon.ico" />}
              <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />
            </Fragment>
          )}

          {block === "appmeta" && (
            <Fragment>
              {profile.showAppTitle && <meta name="apple-mobile-web-app-title" content="ufayes" />}
              <link rel="manifest" href="/site.webmanifest" />
            </Fragment>
          )}

          {block === "og" && (
            <Fragment>
              <meta property="og:type" content="website" />
              <meta property="og:url" content={canonicalURL} />
              <meta property="og:title" content={title} />
              <meta property="og:description" content={description} />
              <meta property="og:image" content={ogImageURL} />
              <meta property="og:site_name" content={ogSiteName} />
              {profile.showOgLocale && <meta property="og:locale" content="th_TH" />}
            </Fragment>
          )}

          {block === "twitter" && (
            <Fragment>
              <meta name="twitter:card" content="summary_large_image" />
              {profile.showTwitterUrl && <meta name="twitter:url" content={canonicalURL} />}
              <meta name="twitter:title" content={title} />
              <meta name="twitter:description" content={description} />
              <meta name="twitter:image" content={ogImageURL} />
            </Fragment>
          )}
        </Fragment>
      ))
    }

    <style is:global>
      html,
      body {
        overflow-x: hidden;
        max-width: 100%;
      }
      body {
        background-size: cover;
        background-position: center;
        background-attachment: fixed;
        background-repeat: no-repeat;
        margin: 0;
        background-color: #ffffff;
        font-weight: 400;
        font-family: "Kanit", sans-serif !important;
      }
    </style>
  </head>

  <body class="relative flex min-h-screen w-full flex-col">
    {
      bgCss ? (
        <div class="fixed inset-0 -z-50 h-full w-full bg-cover bg-center" style={bgCss} />
      ) : (
        <Image
          src={Bg}
          alt="Website Background"
          loading="eager"
          widths={[412, 768, 1024, 1900]}
          sizes="100vw"
          format="avif"
          class="fixed inset-0 -z-50 h-full w-full object-cover"
          quality="low"
          decoding="sync"
        />
      )
    }

    <Navbar />

    <div class="mb-2.5 flex w-full items-center justify-center">
      <Image
        src={mainBanner!}
        alt="UFAYES เว็บตรง UFABET รวมแทงบอล คาสิโนสด สล็อต และหวยออนไลน์ ระบบฝากถอนออโต้"
        loading="eager"
        fetchpriority="high"
        widths={[412, 768, 1900]}
        sizes="(max-width: 768px) 412px, 100vw"
        class="mx-auto h-auto w-full max-w-full object-contain shadow-xl"
        decoding="sync"
        format="avif"
        quality={60}
      />
    </div>

    <main class="w-full flex-1">
      <article>
        <slot />
      </article>
    </main>

    <Footer />
  </body>
</html>
